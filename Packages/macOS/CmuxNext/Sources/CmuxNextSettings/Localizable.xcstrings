    "settings.workspaceHibernation.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحرر ذاكرة مساحات العمل التي لم تستخدمها منذ مدة. تستمر الطرفيات والوكلاء في العمل؛ وتعود الصفحات والمحادثات إلى حيث كانت عند فتح مساحة العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oslobađa memoriju radnih prostora koje neko vrijeme niste koristili. Terminali i agenti nastavljaju raditi; stranice i razgovori se vraćaju gdje su bili kada otvorite radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Frigør hukommelsen fra arbejdsområder, du ikke har brugt i et stykke tid. Terminaler og agenter kører videre; sider og chats kommer tilbage, hvor de var, når du åbner arbejdsområdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gibt den Speicher von Arbeitsbereichen frei, die Sie eine Weile nicht benutzt haben. Terminals und Agenten laufen weiter; Seiten und Chats sind beim Öffnen des Arbeitsbereichs wieder da, wo sie waren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees the memory of workspaces you have not used for a while. Terminals and agents keep running; pages and chats come back where they were when you open the workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libera la memoria de los espacios de trabajo que no has usado desde hace un tiempo. Los terminales y los agentes siguen en marcha; las páginas y los chats vuelven donde estaban al abrir el espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libère la mémoire des espaces de travail inutilisés depuis un moment. Les terminaux et les agents continuent de tourner ; les pages et les discussions reviennent là où elles étaient quand vous ouvrez l’espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libera la memoria degli spazi di lavoro che non usi da un po’. Terminali e agenti continuano a funzionare; pagine e chat tornano dov’erano quando apri lo spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく使っていないワークスペースのメモリを解放します。ターミナルとエージェントは動き続け、ワークスペースを開くとページとチャットは元の状態に戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដោះលែងអង្គចងចាំនៃកន្លែងធ្វើការដែលអ្នកមិនបានប្រើមួយរយៈ។ ស្ថានីយ និងភ្នាក់ងារនៅតែដំណើរការ ទំព័រ និងការជជែកត្រឡប់មកកន្លែងដើមវិញ នៅពេលអ្នកបើកកន្លែងធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "한동안 사용하지 않은 워크스페이스의 메모리를 해제합니다. 터미널과 에이전트는 계속 실행되며, 워크스페이스를 열면 페이지와 채팅이 원래 상태로 돌아옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Frigjør minnet til arbeidsområder du ikke har brukt på en stund. Terminaler og agenter fortsetter å kjøre; sider og chatter kommer tilbake der de var når du åpner arbeidsområdet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwalnia pamięć obszarów roboczych, których przez jakiś czas nie używasz. Terminale i agenci działają dalej; strony i czaty wracają tam, gdzie były, gdy otworzysz obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libera a memória dos espaços de trabalho que você não usa há algum tempo. Terminais e agentes continuam rodando; páginas e chats voltam onde estavam quando você abre o espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Освобождает память рабочих пространств, которыми вы давно не пользовались. Терминалы и агенты продолжают работать; страницы и чаты возвращаются в прежнее состояние, когда вы открываете пространство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คืนหน่วยความจำของพื้นที่ทำงานที่คุณไม่ได้ใช้มาสักพัก เทอร์มินัลและเอเจนต์ยังทำงานต่อ หน้าเว็บและแชทจะกลับมาที่เดิมเมื่อคุณเปิดพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir süredir kullanmadığınız çalışma alanlarının belleğini boşaltır. Terminaller ve ajanlar çalışmaya devam eder; çalışma alanını açtığınızda sayfalar ve sohbetler kaldıkları yerden döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звільняє пам’ять робочих просторів, якими ви давно не користувалися. Термінали й агенти працюють далі; сторінки й чати повертаються туди, де були, коли ви відкриваєте простір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giải phóng bộ nhớ của các không gian làm việc bạn đã lâu không dùng. Terminal và tác tử vẫn chạy; trang và cuộc trò chuyện trở lại như cũ khi bạn mở không gian làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "释放一段时间未使用的工作区的内存。终端和代理会继续运行；打开工作区时，页面和聊天会回到原来的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "釋放一段時間未使用的工作區的記憶體。終端機和代理會繼續執行；開啟工作區時，頁面和聊天會回到原來的位置。"
          }
        }
      }
    },
    "settings.workspaceHibernation.hiddenSpaceMinutes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إسبات المساحات المخفية بعد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiberniraj skrivene prostore nakon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt skjulte rum i dvale efter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ausgeblendete Spaces in Ruhezustand nach"
          }
        },
        "en": {
          "stringUnit": {
