    "settings.sidebar.hoverCards.groups.sections.status.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show how many members work, wait, failed or have unread items."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إظهار عدد الأعضاء الذين يعملون أو ينتظرون أو فشلوا أو لديهم عناصر غير مقروءة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikaži koliko članova radi, čeka, nije uspjelo ili ima nepročitane stavke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis hvor mange medlemmer arbejder, venter, mislykkedes eller har ulæste elementer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
