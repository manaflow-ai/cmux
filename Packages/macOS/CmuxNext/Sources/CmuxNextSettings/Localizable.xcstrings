    "settings.terminal.term.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "xterm-ghostty needs Ghostty's terminfo on every host you ssh to."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج xterm-ghostty إلى terminfo الخاص بـ Ghostty على كل مضيف تتصل به عبر ssh."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty treba Ghosttyjev terminfo na svakom hostu na koji se spajate preko ssh."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty kræver Ghosttys terminfo på hver vært, du bruger ssh til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty braucht die terminfo von Ghostty auf jedem Host, zu dem du dich per ssh verbindest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty necesita el terminfo de Ghostty en cada host al que te conectas por ssh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty nécessite le terminfo de Ghostty sur chaque hôte auquel vous vous connectez en ssh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty richiede il terminfo di Ghostty su ogni host a cui ti colleghi via ssh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty は ssh 先のすべてのホストに Ghostty の terminfo が必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty ត្រូវការ terminfo របស់ Ghostty នៅលើគ្រប់ម៉ាស៊ីនដែលអ្នក ssh ទៅ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty는 ssh로 접속하는 모든 호스트에 Ghostty의 terminfo가 있어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty trenger Ghosttys terminfo på alle verter du bruker ssh mot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty wymaga terminfo Ghostty na każdym hoście, z którym łączysz się przez ssh."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty precisa do terminfo do Ghostty em cada host em que você entra por ssh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty требует terminfo Ghostty на каждом хосте, к которому вы подключаетесь по ssh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty ต้องมี terminfo ของ Ghostty บนทุกโฮสต์ที่คุณ ssh เข้าไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty, ssh ile bağlandığınız her ana makinede Ghostty'nin terminfo'sunu gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty потребує terminfo Ghostty на кожному хості, до якого ви підключаєтеся через ssh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty cần terminfo của Ghostty trên mọi máy chủ bạn ssh tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty 需要你 ssh 连接的每台主机都装有 Ghostty 的 terminfo。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "xterm-ghostty 需要你以 ssh 連線的每台主機都裝有 Ghostty 的 terminfo。"
          }
        }
      }
    },
