    "settings.chats.deleteHistoryAfterDays.help": {
      "comment": "Settings row help for Delete Chat History After; 0 is the number zero",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحذف نهائيًا المحادثات المغلقة غير المستخدمة طوال هذا العدد من الأيام. القيمة 0 لا تحذف أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trajno briše zatvorene chatove nekorištene ovoliko dana. 0 nikad ne briše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sletter permanent lukkede chats, der ikke er brugt i så mange dage. 0 sletter aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht geschlossene Chats, die so viele Tage nicht verwendet wurden, endgültig. 0 löscht nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes closed chats unused for this many days. 0 never deletes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina de forma permanente los chats cerrados sin usar durante este número de días. 0 nunca elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime définitivement les chats fermés inutilisés depuis ce nombre de jours. 0 ne supprime jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina definitivamente le chat chiuse non usate per questo numero di giorni. 0 non elimina mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この日数のあいだ使われていない閉じたチャットを完全に削除します。0 の場合は削除しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "លុបជាអចិន្ត្រៃយ៍នូវការជជែកដែលបានបិទ ហើយមិនបានប្រើក្នុងរយៈពេលប៉ុន្មានថ្ងៃនេះ។ 0 មិនលុបទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 일수 동안 사용하지 않은 닫힌 채팅을 영구 삭제합니다. 0이면 삭제하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sletter lukkede chatter som ikke er brukt på så mange dager, permanent. 0 sletter aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trwale usuwa zamknięte czaty nieużywane przez tyle dni. 0 nigdy nie usuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exclui permanentemente chats fechados sem uso por este número de dias. 0 nunca exclui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Безвозвратно удаляет закрытые чаты, не использовавшиеся столько дней. 0 — никогда не удалять."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลบแชทที่ปิดแล้วและไม่ได้ใช้ตามจำนวนวันนี้อย่างถาวร 0 คือไม่ลบเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kadar gün kullanılmayan kapalı sohbetleri kalıcı olarak siler. 0 hiç silmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Остаточно видаляє закриті чати, якими не користувалися стільки днів. 0 — ніколи не видаляти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa vĩnh viễn các cuộc trò chuyện đã đóng không dùng trong số ngày này. 0 là không bao giờ xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "永久删除这么多天未使用的已关闭聊天。0 表示从不删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "永久刪除這麼多天未使用的已關閉聊天。0 表示永不刪除。"
          }
        }
      }
    },
    "settings.labs.bundledCodexAppServer": {
