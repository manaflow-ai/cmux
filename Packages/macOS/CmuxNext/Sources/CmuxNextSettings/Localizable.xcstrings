    "settings.agentPane.composerLook.help": {
      "comment": "Settings > Agent Chat > Composer Look: what the row does",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مكان الوضع والنموذج والجهد: أسفل المربع أو داخله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdje stoje način, model i napor: ispod polja ili u njemu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor tilstand, model og indsats står: under feltet eller i det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wo Modus, Modell und Aufwand stehen: unter dem Feld oder darin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the mode, model and effort sit: under the box or inside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dónde van el modo, el modelo y el esfuerzo: debajo del cuadro o dentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où se placent le mode, le modèle et l’effort : sous la zone ou dedans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove stanno modalità, modello e impegno: sotto la casella o al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "モード、モデル、エフォートの位置: 入力欄の下か中か。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងដាក់របៀប ម៉ូដែល និងកម្រិតខិតខំ៖ នៅក្រោមប្រអប់ ឬនៅក្នុងវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모드, 모델, 노력 수준의 위치: 입력창 아래 또는 안."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor modus, modell og innsats står: under feltet eller i det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdzie są tryb, model i wysiłek: pod polem lub w nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde ficam o modo, o modelo e o esforço: abaixo da caixa ou dentro dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Где находятся режим, модель и усилие: под полем или внутри него."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตำแหน่งของโหมด โมเดล และระดับความพยายาม: ใต้ช่องหรือในช่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mod, model ve efor nerede durur: kutunun altında ya da içinde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Де розташовані режим, модель і зусилля: під полем або в ньому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vị trí của chế độ, mô hình và mức nỗ lực: bên dưới ô hoặc bên trong ô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "模式、模型和投入程度的位置：在输入框下方或框内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "模式、模型和投入程度的位置：在輸入框下方或框內。"
          }
        }
      }
    },
