    "settings.tabs.verticalTabs.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs in a list beside the panes. A tab bar's menu changes one workspace."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "علامات التبويب في قائمة بجانب الأجزاء. تغيّر قائمة شريط علامات التبويب مساحة عمل واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice u listi pored panela. Meni trake kartica mijenja jedan radni prostor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner i en liste ved siden af ruderne. En fanelinjes menu ændrer ét arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tabs als Liste neben den Bereichen. Das Menü einer Tableiste ändert einen einzelnen Arbeitsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pestañas en una lista junto a los paneles. El menú de una barra de pestañas cambia un espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onglets en liste à côté des panneaux. Le menu d'une barre d'onglets change un seul espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schede in un elenco accanto ai riquadri. Il menu di una barra delle schede cambia una sola area di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブをペインの横にリストで表示します。タブバーのメニューで1つのワークスペースだけ変更できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងជាបញ្ជីនៅក្បែរផ្ទាំងរង។ ម៉ឺនុយរបារផ្ទាំងប្ដូរកន្លែងធ្វើការមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭을 패널 옆 목록으로 표시합니다. 탭 막대의 메뉴에서 워크스페이스 하나만 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner i en liste ved siden av rutene. Menyen i en fanelinje endrer ett arbeidsområde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty w liście obok paneli. Menu paska kart zmienia jeden obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abas em uma lista ao lado dos painéis. O menu de uma barra de abas muda um espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки списком рядом с панелями. Меню панели вкладок меняет это для одного рабочего пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บเป็นรายการข้างบานหน้าต่าง เมนูของแถบแท็บเปลี่ยนได้ทีละพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sekmeler bölmelerin yanında bir liste olarak. Sekme çubuğunun menüsü tek bir çalışma alanını değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки списком поруч із панелями. Меню панелі вкладок змінює це для одного робочого простору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tab thành danh sách bên cạnh các ngăn. Menu của thanh tab đổi cho một không gian làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标签页以列表形式显示在窗格旁。标签栏的菜单可更改单个工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標籤頁顯示為窗格旁的列表。標籤列的選單可更改單一工作區。"
          }
        }
      }
    },
    "settings.tabs.verticalTabsExpandOnHover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand Collapsed Vertical Tabs on Hover"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توسيع علامات التبويب العمودية المطوية عند التمرير"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proširi skupljene vertikalne kartice pri prelasku mišem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udvid sammenklappede lodrette faner ved hover"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeklappte vertikale Tabs beim Darüberfahren ausklappen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expandir pestañas verticales contraídas al pasar el puntero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développer les onglets verticaux réduits au survol"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espandi le schede verticali compresse al passaggio del puntatore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたんだ垂直タブをホバー時に展開"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពង្រីកផ្ទាំងបញ្ឈរដែលបានបង្រួម នៅពេលដាក់ទស្សន៍ទ្រនិចលើ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 세로 탭을 마우스를 올리면 펼치기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvid sammenslåtte loddrette faner ved peking"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwijaj zwinięte pionowe karty po najechaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expandir abas verticais recolhidas ao passar o ponteiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разворачивать свёрнутые вертикальные вкладки при наведении"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยายแท็บแนวตั้งที่ยุบไว้เมื่อวางเมาส์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daraltılmış dikey sekmeleri üzerine gelince genişlet"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розгортати згорнуті вертикальні вкладки під час наведення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở rộng tab dọc đã thu gọn khi di chuột"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停时展开已折叠的垂直标签页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸停時展開已收合的垂直標籤頁"
          }
        }
      }
    },
    "settings.tabs.verticalTabsExpandOnHover.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show titles while the pointer is over the collapsed list."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعرض العناوين أثناء وجود المؤشر فوق القائمة المطوية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikaži naslove dok je pokazivač iznad skupljene liste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis titler, mens markøren er over den sammenklappede liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titel anzeigen, solange der Zeiger über der eingeklappten Liste ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra los títulos mientras el puntero está sobre la lista contraída."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche les titres tant que le pointeur survole la liste réduite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra i titoli mentre il puntatore è sopra l'elenco compresso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "折りたたんだリストにポインタを重ねている間はタイトルを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញចំណងជើងខណៈពេលទស្សន៍ទ្រនិចនៅលើបញ្ជីដែលបានបង្រួម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "접힌 목록 위에 포인터를 올려 둔 동안 제목을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vis titler mens pekeren er over den sammenslåtte listen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuj tytuły, gdy wskaźnik jest nad zwiniętą listą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostrar os títulos enquanto o ponteiro estiver sobre a lista recolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывать названия, пока указатель над свёрнутым списком."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงชื่อขณะที่ตัวชี้อยู่เหนือรายการที่ยุบไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İşaretçi daraltılmış listenin üzerindeyken başlıkları göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показувати назви, поки вказівник над згорнутим списком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị tiêu đề khi con trỏ nằm trên danh sách đã thu gọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指针停留在折叠的列表上方时显示标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指標停留在收合的列表上方時顯示標題。"
          }
        }
      }
    },
    "settings.tabs.hideLoneChatTab": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Hide the Tab of a Chat Alone in Its Pane"}},
        "ar": {"stringUnit": {"state": "translated", "value": "إخفاء علامة تبويب المحادثة الوحيدة في جزئها"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Sakrij karticu razgovora koji je sam u svom oknu"}},
        "da": {"stringUnit": {"state": "translated", "value": "Skjul fanen for en chat, der er alene i sin rude"}},
        "de": {"stringUnit": {"state": "translated", "value": "Tab eines Chats ausblenden, der allein im Bereich ist"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ocultar la pestaña de un chat solo en su panel"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Masquer l’onglet d’une discussion seule dans son volet"}},
        "it": {"stringUnit": {"state": "translated", "value": "Nascondi la scheda di una chat da sola nel suo riquadro"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ペインに 1 つだけのチャットのタブを隠す"}},
        "km": {"stringUnit": {"state": "translated", "value": "លាក់ផ្ទាំងនៃការជជែកដែលនៅតែឯងក្នុងផ្ទាំងរបស់វា"}},
        "ko": {"stringUnit": {"state": "translated", "value": "창에 하나뿐인 채팅의 탭 숨기기"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Skjul fanen til en chat som er alene i ruten"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ukryj kartę czatu, który jest sam w panelu"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ocultar a aba de um chat sozinho no painel"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Скрывать вкладку чата, если он один в панели"}},
        "th": {"stringUnit": {"state": "translated", "value": "ซ่อนแท็บของแชตที่อยู่เดี่ยวในบานหน้าต่าง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bölmesinde tek başına olan sohbetin sekmesini gizle"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Приховувати вкладку чату, якщо він один на панелі"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Ẩn thẻ của cuộc trò chuyện duy nhất trong ngăn"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "隐藏窗格中唯一聊天的标签页"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "隱藏窗格中唯一聊天的分頁"}}
      }
    },
