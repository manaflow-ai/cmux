    "settings.browser.links.downloadHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chromium tabs, Download keeps Chrome's default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromiumタブでは、「ダウンロード」はChromeのデフォルトのままです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في علامات تبويب Chromium، يبقي «تنزيل» على الإعداد الافتراضي لـ Chrome."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U Chromium karticama, Preuzmi zadržava Chromeovo zadano ponašanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I Chromium-faner beholder Hent Chromes standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Chromium-Tabs behält „Laden“ Chromes Standard bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En las pestañas de Chromium, Descargar mantiene el valor predeterminado de Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans les onglets Chromium, Télécharger garde le comportement par défaut de Chrome."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nelle schede Chromium, Scarica mantiene il comportamento predefinito di Chrome."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅក្នុងផ្ទាំង Chromium ទាញយក រក្សាលំនាំដើមរបស់ Chrome។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium 탭에서 다운로드는 Chrome의 기본 동작을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I Chromium-faner beholder Last ned Chromes standard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W kartach Chromium opcja Pobierz zachowuje domyślne działanie Chrome."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nas abas do Chromium, Baixar mantém o padrão do Chrome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Во вкладках Chromium «Загрузить» сохраняет поведение Chrome по умолчанию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ในแท็บ Chromium ดาวน์โหลดจะใช้ค่าเริ่มต้นของ Chrome"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium sekmelerinde İndir, Chrome varsayılanını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У вкладках Chromium «Завантажити» зберігає типову поведінку Chrome."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trong tab Chromium, Tải xuống giữ mặc định của Chrome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Chromium 标签页中，“下载”保持 Chrome 的默认行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 Chromium 分頁中，「下載」維持 Chrome 的預設行為。"
          }
        }
      }
    },
