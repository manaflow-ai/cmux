    "settings.workspaceHibernation.freeingRunningCommands.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يحدث لأمر لا يزال يعمل في مساحة عمل تحرّر طرفياتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šta se dešava s naredbom koja još radi u radnom prostoru koji oslobađa svoje terminale."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad der sker med en kommando, der stadig kører i et arbejdsområde, som frigør sine terminaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was mit einem Befehl geschieht, der noch in einem Workspace läuft, der seine Terminals freigibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens to a command that still runs in a workspace that frees its terminals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué ocurre con un comando que sigue en ejecución en un espacio que libera sus terminales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui arrive à une commande encore en cours dans un espace qui libère ses terminaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa succede a un comando ancora in esecuzione in uno spazio che libera i suoi terminali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末を解放するワークスペースでまだ実行中のコマンドをどうするか。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលកើតឡើងចំពោះពាក្យបញ្ជាដែលនៅតែដំណើរការក្នុងកន្លែងធ្វើការដែលដោះលែងស្ថានីយរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널을 해제하는 워크스페이스에서 아직 실행 중인 명령을 어떻게 처리할지 정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva som skjer med en kommando som fortsatt kjører i et arbeidsområde som frigjør terminalene sine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co dzieje się z poleceniem, które nadal działa w obszarze zwalniającym swoje terminale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que acontece com um comando que ainda roda num espaço que libera seus terminais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что происходит с командой, которая ещё выполняется в пространстве, освобождающем свои терминалы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่เกิดกับคำสั่งที่ยังทำงานอยู่ในเวิร์กสเปซที่ปล่อยเทอร์มินัลของตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminallerini serbest bırakan bir çalışma alanında hâlâ çalışan bir komuta ne olacağı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що відбувається з командою, яка ще працює в просторі, що звільняє свої термінали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều gì xảy ra với lệnh vẫn đang chạy trong workspace giải phóng terminal của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在释放终端的工作区中仍在运行的命令如何处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在釋放終端機的工作區中仍在執行的指令如何處理。"
          }
        }
      }
    },
