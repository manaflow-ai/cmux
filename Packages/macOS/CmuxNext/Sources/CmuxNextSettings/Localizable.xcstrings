    "settings.browser.searchEngine.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address bar searches here and asks it for suggestions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبحث شريط العنوان هنا ويطلب منه الاقتراحات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
