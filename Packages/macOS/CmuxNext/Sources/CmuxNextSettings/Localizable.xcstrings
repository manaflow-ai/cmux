    "settings.agentPane.display.codeFont.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The font of code in the chat. Empty uses the Markdown viewer's code font, then the terminal font."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خط الشيفرة في الدردشة. إذا كان فارغًا فيُستخدم خط الشيفرة في عارض Markdown، ثم خط الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Font koda u razgovoru. Prazno koristi font koda Markdown preglednika, zatim font terminala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifttypen til kode i chatten. Tom bruger Markdown-fremviserens kodeskrifttype og derefter terminalens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schrift für Code im Chat. Leer nutzt die Code-Schrift der Markdown-Ansicht, sonst die des Terminals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente del código en el chat. Vacío usa la fuente de código del visor de Markdown y luego la del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La police du code dans le chat. Vide utilise la police du code du lecteur Markdown, puis celle du terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il font del codice nella chat. Vuoto usa il font del codice del visualizzatore Markdown, poi quello del terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット内のコードのフォント。空の場合はMarkdownビューアのコードのフォント、次にターミナルのフォントを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពុម្ពអក្សរកូដក្នុងជជែក។ ទទេ ប្រើពុម្ពអក្សរកូដរបស់កម្មវិធីមើល Markdown បន្ទាប់មកពុម្ពអក្សរស្ថានីយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅의 코드 글꼴입니다. 비워 두면 Markdown 뷰어의 코드 글꼴, 그다음 터미널 글꼴을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriften for kode i chatten. Tom bruker Markdown-visningens kodeskrift, deretter terminalens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czcionka kodu w czacie. Puste używa czcionki kodu podglądu Markdown, a potem terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte do código no chat. Vazio usa a fonte de código do visualizador de Markdown e depois a do terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифт кода в чате. Если пусто, используется шрифт кода просмотра Markdown, затем шрифт терминала."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบอักษรของโค้ดในแชท ถ้าว่างจะใช้แบบอักษรโค้ดของตัวแสดง Markdown แล้วจึงใช้ของเทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetteki kodun yazı tipi. Boş bırakılırsa Markdown Görüntüleyici'nin kod yazı tipi, sonra terminalinki kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрифт коду в чаті. Якщо порожньо, використовується шрифт коду переглядача Markdown, потім шрифт термінала."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phông chữ của mã trong trò chuyện. Để trống sẽ dùng phông mã của trình xem Markdown, rồi đến phông của terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天中代码的字体。留空则使用 Markdown 查看器的代码字体，其次是终端字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天中程式碼的字體。留空則使用 Markdown 檢視器的程式碼字體，其次是終端機字體。"
          }
        }
      }
    },
