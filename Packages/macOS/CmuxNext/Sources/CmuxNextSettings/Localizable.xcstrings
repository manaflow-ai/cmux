    "settings.appearance.colorTransition.reduceMotion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Reduce Motion"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تقليل الحركة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz smanjenje pokreta"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
