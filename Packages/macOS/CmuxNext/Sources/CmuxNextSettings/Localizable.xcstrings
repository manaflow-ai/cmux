    "settings.agentPane.remoteImages.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحمَّل صورة الويب من موقعها، فيعرف الموقع أنك قرأت الرد."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Web slika se učitava sa svoje stranice, koja tada vidi da ste pročitali odgovor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et webbillede hentes fra sit websted, som så kan se, at du har læst svaret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Webbild lädt von seiner Website, die dann sieht, dass Sie die Antwort lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A web image loads from its site, which then sees that you read the reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una imagen web se carga desde su sitio, que así sabe que leíste la respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une image web se charge depuis son site, qui voit alors que vous lisez la réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un’immagine web si carica dal suo sito, che così vede che hai letto la risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web 画像はそのサイトから読み込まれ、サイトはあなたが返信を読んだことを知ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "រូបភាពវេបផ្ទុកពីគេហទំព័ររបស់វា ដែលបន្ទាប់មកដឹងថាអ្នកបានអានការឆ្លើយតប។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "웹 이미지는 해당 사이트에서 불러오며, 사이트는 내가 답장을 읽었다는 것을 알게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et nettbilde lastes fra nettstedet sitt, som da ser at du leser svaret."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obraz z sieci wczytuje się ze swojej witryny, która wtedy widzi, że czytasz odpowiedź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma imagem da web carrega do site dela, que então vê que você leu a resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Веб-изображение загружается со своего сайта, и сайт видит, что вы прочитали ответ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "รูปภาพจากเว็บโหลดจากเว็บไซต์ของมัน ซึ่งจะรู้ว่าคุณอ่านคำตอบแล้ว"
