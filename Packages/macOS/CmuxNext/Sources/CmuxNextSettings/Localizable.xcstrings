          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкритих вкладених сеансів на сеанс"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số phiên con đang mở mỗi phiên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个会话打开的子会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工作階段開啟的子工作階段"
          }
        }
      }
    },
    "settings.agents.subsessions.maxChildren.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most live sub-sessions one session can have at the same time. Running, waiting and harness-alive children count; finished, dead and closed children do not use a slot."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى عدد من الجلسات الفرعية التي يمكن لجلسة واحدة فتحها في الوقت نفسه. يؤدي إغلاق جلسة فرعية إلى تحرير مكانها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najveći broj podsesija koje jedna sesija može imati otvorene u isto vrijeme. Zatvaranje podsesije oslobađa njeno mjesto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det største antal undersessioner, én session kan have åbne på samme tid. Når du lukker en undersession, frigøres dens plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die höchste Zahl an Untersitzungen, die eine Sitzung gleichzeitig offen haben kann. Wird eine Untersitzung geschlossen, wird ihr Platz frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número máximo de subsesiones que una sesión puede tener abiertas a la vez. Al cerrar una subsesión se libera su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre maximal de sous-sessions qu’une session peut avoir ouvertes en même temps. Fermer une sous-session libère sa place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero massimo di sottosessioni che una sessione può avere aperte contemporaneamente. Chiudere una sottosessione libera il suo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのセッションが同時に開いておけるサブセッションの最大数です。サブセッションを閉じると、その枠が空きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំនួនវគ្គរងច្រើនបំផុតដែលវគ្គមួយអាចបើកក្នុងពេលតែមួយ។ ការបិទវគ្គរងមួយធ្វើឱ្យកន្លែងរបស់វាទំនេរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 세션이 동시에 열어 둘 수 있는 하위 세션의 최대 개수입니다. 하위 세션을 닫으면 그 자리가 비워집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det høyeste antallet underøkter én økt kan ha åpne samtidig. Når du lukker en underøkt, blir plassen dens ledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największa liczba podsesji, które jedna sesja może mieć otwarte jednocześnie. Zamknięcie podsesji zwalnia jej miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número máximo de subsessões que uma sessão pode ter abertas ao mesmo tempo. Fechar uma subsessão libera o lugar dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее число вложенных сеансов, которые один сеанс может держать открытыми одновременно. Закрытие вложенного сеанса освобождает его место."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเซสชันย่อยสูงสุดที่เซสชันหนึ่งเปิดไว้ได้พร้อมกัน การปิดเซสชันย่อยจะคืนที่ว่างให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oturumun aynı anda açık tutabileceği en fazla alt oturum sayısı. Bir alt oturumu kapatmak onun yerini boşaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найбільша кількість вкладених сеансів, які один сеанс може мати відкритими одночасно. Закриття вкладеного сеансу звільняє його місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số phiên con tối đa mà một phiên có thể mở cùng lúc. Đóng một phiên con sẽ giải phóng chỗ của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个会话可同时打开的子会话的最大数量。关闭一个子会话会空出它的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個工作階段可同時開啟的子工作階段數量上限。關閉一個子工作階段會空出它的位置。"
          }
        }
      }
    },
