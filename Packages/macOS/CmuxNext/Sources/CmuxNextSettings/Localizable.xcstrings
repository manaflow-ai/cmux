    "settings.layout.splitSizing.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even gives every pane in the column the same size after a split."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمنح الخيار المتساوي كل جزء في العمود الحجم نفسه بعد التقسيم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jednako daje svakom oknu u koloni istu veličinu nakon podjele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lige giver hver rude i kolonnen samme størrelse efter en opdeling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gleichmäßig gibt nach einer Teilung jedem Bereich der Spalte dieselbe Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Igual da a cada panel de la columna el mismo tamaño tras dividir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Égal donne la même taille à chaque panneau de la colonne après une division."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uguale dà la stessa dimensione a ogni riquadro della colonna dopo una divisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "均等にすると、分割後に列内のすべてのペインが同じサイズになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្មើគ្នា ផ្តល់ទំហំដូចគ្នាដល់ផ្ទាំងនីមួយៗក្នុងជួរឈរ បន្ទាប់ពីបំបែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "균등은 분할 후 열의 모든 창을 같은 크기로 만듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jevn gir hver rute i kolonnen samme størrelse etter en deling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Równo daje każdemu panelowi w kolumnie ten sam rozmiar po podziale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Igual dá a cada painel da coluna o mesmo tamanho após dividir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поровну даёт всем панелям колонки одинаковый размер после разделения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เท่ากัน ทำให้ทุกบานในคอลัมน์มีขนาดเท่ากันหลังการแบ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eşit, bölmeden sonra sütundaki her bölmeye aynı boyutu verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Порівну дає всім панелям колонки однаковий розмір після поділу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
