    "settings.updates.showFeatureTips.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small tip now and then points at a feature an update added."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "من حين لآخر، يشير تلميح صغير إلى ميزة أضافها تحديث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povremeno mali savjet pokazuje na funkciju koju je dodalo ažuriranje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nu og da peger et lille tip på en funktion, som en opdatering har tilføjet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ab und zu weist ein kleiner Tipp auf eine Funktion hin, die ein Update hinzugefügt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vez en cuando, un pequeño consejo señala una función que añadió una actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De temps en temps, une petite astuce signale une fonctionnalité ajoutée par une mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni tanto un piccolo suggerimento indica una funzione aggiunta da un aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アップデートで追加された機能を小さなヒントでお知らせすることがあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម្ដងម្កាល គន្លឹះតូចមួយចង្អុលទៅមុខងារដែលការអាប់ដេតបានបន្ថែម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가끔 업데이트로 추가된 기능을 작은 팁으로 알려 드립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av og til peker et lite tips på en funksjon en oppdatering har lagt til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Od czasu do czasu mała wskazówka pokazuje funkcję dodaną przez aktualizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vez em quando, uma pequena dica aponta um recurso que uma atualização adicionou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Время от времени небольшая подсказка указывает на функцию, добавленную обновлением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บางครั้งจะมีเคล็ดลับเล็ก ๆ ชี้ไปที่ฟีเจอร์ที่การอัปเดตเพิ่มเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ara sıra küçük bir ipucu, bir güncellemenin eklediği bir özelliği gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Іноді невелика підказка вказує на функцію, яку додало оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thỉnh thoảng, một mẹo nhỏ chỉ vào tính năng mà bản cập nhật đã thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "偶尔会有一条小提示指向更新新增的功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "偶爾會有一則小提示指向更新新增的功能。"
          }
        }
      }
    },
