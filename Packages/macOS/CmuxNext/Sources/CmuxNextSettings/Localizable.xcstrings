    "settings.agents.autoRetry.enabled.help": {
      "comment": "Settings > Agents > Retry After Errors: toggle help",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعيد المحاولة بعد حدود المعدل أو أخطاء السعة أو انقطاع الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponovo pokušava nakon ograničenja brzine, grešaka kapaciteta ili prekinute veze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prøver igen efter hastighedsbegrænsninger, kapacitetsfejl eller en afbrudt forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiederholt nach Ratenbegrenzungen, Kapazitätsfehlern oder Verbindungsabbrüchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retries after rate limits, capacity errors or a dropped connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reintenta tras límites de uso, errores de capacidad o una conexión cortada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réessaie après une limite de débit, une saturation ou une coupure de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riprova dopo limiti di frequenza, errori di capacità o una connessione caduta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レート制限、容量エラー、接続の切断のあとに再試行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ព្យាយាមម្ដងទៀតក្រោយការកំណត់អត្រា កំហុសសមត្ថភាព ឬការតភ្ជាប់ដាច់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "속도 제한, 용량 오류 또는 연결 끊김 후 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prøver på nytt etter hastighetsbegrensninger, kapasitetsfeil eller brutt tilkobling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponawia po limitach zapytań, braku mocy lub zerwanym połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tenta de novo após limites de taxa, erros de capacidade ou queda da conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повторяет попытку после лимита запросов, нехватки мощностей или обрыва соединения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลองใหม่หลังถูกจำกัดอัตรา ความจุเต็ม หรือการเชื่อมต่อหลุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hız sınırları, kapasite hataları veya kopan bağlantıdan sonra yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повторює спробу після обмеження частоти запитів, браку потужностей або обриву з’єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thử lại sau khi bị giới hạn tốc độ, hết dung lượng hoặc mất kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在限速、容量错误或连接中断后自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在限速、容量錯誤或連線中斷後自動重試。"
          }
        }
      }
    },
