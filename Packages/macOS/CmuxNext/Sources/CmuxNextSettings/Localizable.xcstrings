    "settings.screenshots.folders.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Screenshots pane also shows the pictures and videos in these folders. Use full paths or ~/ paths."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض جزء لقطات الشاشة أيضًا الصور ومقاطع الفيديو في هذه المجلدات. استخدم مسارات كاملة أو مسارات ~/."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okno Snimci ekrana prikazuje i slike i video zapise u ovim mapama. Koristite pune putanje ili ~/ putanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skærmbilleder-panelet viser også billeder og videoer i disse mapper. Brug fulde stier eller ~/-stier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bereich „Bildschirmfotos“ zeigt auch die Bilder und Videos in diesen Ordnern. Verwende vollständige Pfade oder ~/-Pfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El panel Capturas de pantalla también muestra las imágenes y los vídeos de estas carpetas. Usa rutas completas o rutas ~/."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le panneau Captures d’écran affiche aussi les images et vidéos de ces dossiers. Utilisez des chemins complets ou des chemins ~/."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il pannello Istantanee schermo mostra anche immagini e video di queste cartelle. Usa percorsi completi o percorsi ~/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スクリーンショットペインには、これらのフォルダの画像とビデオも表示されます。フルパスまたは ~/ パスを使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងរូបថតអេក្រង់ក៏បង្ហាញរូបភាព និងវីដេអូក្នុងថតទាំងនេះផងដែរ។ ប្រើផ្លូវពេញ ឬផ្លូវ ~/។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스크린샷 패널에는 이 폴더의 사진과 비디오도 표시됩니다. 전체 경로나 ~/ 경로를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjermbilder-panelet viser også bildene og videoene i disse mappene. Bruk fullstendige stier eller ~/-stier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Panel Zrzuty ekranu pokazuje też obrazy i filmy z tych folderów. Użyj pełnych ścieżek lub ścieżek ~/."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O painel Capturas de Tela também mostra as imagens e vídeos destas pastas. Use caminhos completos ou caminhos ~/."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель «Снимки экрана» также показывает изображения и видео из этих папок. Используйте полные пути или пути ~/."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แผงภาพหน้าจอจะแสดงรูปภาพและวิดีโอในโฟลเดอร์เหล่านี้ด้วย ใช้พาธเต็มหรือพาธ ~/"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekran Görüntüleri bölmesi bu klasörlerdeki resimleri ve videoları da gösterir. Tam yollar veya ~/ yolları kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель «Знімки екрана» також показує зображення й відео з цих тек. Використовуйте повні шляхи або шляхи ~/."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngăn Ảnh chụp màn hình cũng hiển thị ảnh và video trong các thư mục này. Dùng đường dẫn đầy đủ hoặc đường dẫn ~/."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "截屏面板也会显示这些文件夹中的图片和视频。请使用完整路径或 ~/ 路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "截圖面板也會顯示這些資料夾中的圖片和影片。請使用完整路徑或 ~/ 路徑。"
          }
        }
      }
    },
