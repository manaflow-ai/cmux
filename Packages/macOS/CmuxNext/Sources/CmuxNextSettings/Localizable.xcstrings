    "settings.tabs.tabStripHeight.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height of a pane's tab bar. Its tabs grow and shrink with it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインのタブバーの高さ。タブもそれに合わせて大きさが変わります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ارتفاع شريط علامات التبويب في اللوحة. تكبر علامات التبويب وتصغر معه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visina trake kartica u panelu. Kartice rastu i smanjuju se s njom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Højden på et panels fanelinje. Fanerne bliver større og mindre med den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Höhe der Tableiste eines Bereichs. Die Tabs wachsen und schrumpfen mit ihr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altura de la barra de pestañas de un panel. Sus pestañas crecen y se reducen con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hauteur de la barre d’onglets d’un panneau. Ses onglets s’agrandissent et rétrécissent avec elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altezza della barra delle schede di un riquadro. Le schede si ingrandiscono e si riducono con essa."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្ពស់របារផ្ទាំងរបស់ផ្ទាំងក្រឡា។ ផ្ទាំងនានាធំឡើង និងតូចចុះតាមវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창의 탭 막대 높이입니다. 탭도 함께 커지고 작아집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Høyden på fanelinjen i et panel. Fanene vokser og krymper med den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysokość paska kart panelu. Karty rosną i maleją razem z nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altura da barra de abas de um painel. As abas aumentam e diminuem com ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Высота панели вкладок области. Вкладки увеличиваются и уменьшаются вместе с ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความสูงของแถบแท็บในบานหน้าต่าง แท็บจะขยายและหดตามไปด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir bölmenin sekme çubuğunun yüksekliği. Sekmeler onunla birlikte büyür ve küçülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Висота панелі вкладок області. Вкладки збільшуються та зменшуються разом із нею."
          }
        },
        "vi": {
          "stringUnit": {
