          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ferramenta e o resumo do comando de cada solicitação vão para o seu próprio feed do cmux, para que o iPhone possa responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Инструмент и сводка команды каждого запроса попадают в вашу ленту cmux, чтобы iPhone мог ответить."
          }
        },
        "th": {
          "stringUnit": {
