    "settings.appearance.colorTransition.colorSpace.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab blends with even lightness. sRGB mixes the red, green and blue channels."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏OKLab يمزج بإضاءة متساوية. sRGB يمزج القنوات الحمراء والخضراء والزرقاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab miješa uz ujednačenu svjetlinu. sRGB miješa crveni, zeleni i plavi kanal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab blander med jævn lyshed. sRGB blander den røde, grønne og blå kanal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab blendet mit gleichmäßiger Helligkeit. sRGB mischt den Rot-, Grün- und Blaukanal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab mezcla con luminosidad uniforme. sRGB mezcla los canales rojo, verde y azul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab mélange avec une luminosité régulière. sRGB mélange les canaux rouge, vert et bleu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab fonde con luminosità uniforme. sRGB mescola i canali rosso, verde e blu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab は明るさを均一に保って混ぜます。sRGB は赤・緑・青のチャンネルを混ぜます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab លាយដោយពន្លឺស្មើ។ sRGB លាយឆានែលក្រហម បៃតង និងខៀវ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab은 밝기를 고르게 유지하며 섞습니다. sRGB는 빨강, 초록, 파랑 채널을 섞습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab blander med jevn lyshet. sRGB blander rød, grønn og blå kanal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab miesza z równą jasnością. sRGB miesza kanały czerwony, zielony i niebieski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab mistura com luminosidade uniforme. sRGB mistura os canais vermelho, verde e azul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab смешивает с ровной яркостью. sRGB смешивает красный, зелёный и синий каналы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab ผสมโดยรักษาความสว่างให้สม่ำเสมอ sRGB ผสมช่องสีแดง เขียว และน้ำเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab eşit parlaklıkla karıştırır. sRGB kırmızı, yeşil ve mavi kanalları karıştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab змішує з рівною яскравістю. sRGB змішує червоний, зелений і синій канали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab trộn với độ sáng đều. sRGB trộn các kênh đỏ, lục và lam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab 以均匀亮度混合。sRGB 混合红、绿、蓝通道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OKLab 以均勻亮度混合。sRGB 混合紅、綠、藍通道。"
          }
        }
      }
    },
