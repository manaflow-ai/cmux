    "settings.appearance.focusIndicator.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيف تبرز اللوحة المحددة: حدها، أو علامات تبويب أخف في اللوحات الأخرى، أو كلاهما، أو لا شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako se fokusirani panel ističe: okvirom, blažim karticama u drugim panelima, oboje ili ništa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sådan skiller den fokuserede rude sig ud: dens kant, svagere faner i de andre ruder, begge dele eller ingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie sich der fokussierte Bereich abhebt: sein Rahmen, dezentere Tabs in den anderen Bereichen, beides oder nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the focused pane stands out: its border, subtler tabs in the other panes, both or neither."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo destaca el panel enfocado: su borde, pestañas más sutiles en los otros paneles, ambos o ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comment le volet actif se distingue : sa bordure, des onglets plus discrets dans les autres volets, les deux ou aucun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come si distingue il riquadro attivo: il bordo, schede più discrete negli altri riquadri, entrambi o nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカス中のペインの示し方: 枠線、他のペインのタブを控えめにする、両方、またはなし。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបដែលផ្ទាំងដែលបានផ្តោតលេចធ្លោ៖ ស៊ុមរបស់វា ផ្ទាំងស្លាកស្រាលជាងនៅផ្ទាំងផ្សេង ទាំងពីរ ឬគ្មាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포커스된 패널을 표시하는 방법: 테두리, 다른 패널의 탭을 은은하게, 둘 다 또는 없음."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slik skiller den aktive ruten seg ut: kanten, dempede faner i de andre rutene, begge deler eller ingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak wyróżnia się aktywny panel: obramowaniem, subtelniejszymi kartami w innych panelach, oboma lub niczym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como o painel em foco se destaca: a borda, abas mais sutis nos outros painéis, ambos ou nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как выделяется активная панель: рамкой, более тусклыми вкладками в других панелях, и тем и другим или ничем."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิธีทำให้บานที่โฟกัสเด่น: ขอบ แท็บที่จางลงในบานอื่น ทั้งสองอย่าง หรือไม่มี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaklı bölmenin nasıl öne çıktığı: kenarlığı, diğer bölmelerde daha soluk sekmeler, ikisi de veya hiçbiri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як виділяється активна панель: рамкою, тьмянішими вкладками в інших панелях, обома способами або ніяк."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách ô đang chọn nổi bật: viền, thẻ nhạt hơn ở các ô khác, cả hai hoặc không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聚焦窗格的突出方式：边框、其他窗格中更柔和的标签、两者或都不。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聚焦窗格的突出方式：邊框、其他窗格中更柔和的分頁、兩者或都不。"
          }
        }
      }
    },
