    "settings.feed.agentPermissionPrompts.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each request's tool and command summary goes to your own cmux feed, so your iPhone can answer it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リクエストのツールとコマンドの概要があなた自身の cmux フィードに送られ、iPhone から応答できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each request's tool and command summary goes to your own cmux feed, so your iPhone can answer it."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Each request's tool and command summary goes to your own cmux feed, so your iPhone can answer it."
