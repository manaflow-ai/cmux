    "settings.appearance.density.help": {
      "comment": "Help under the Density setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row height, padding, corners, icons and text size together."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع الصفوف والهوامش والزوايا والأيقونات وحجم النص معًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Visina redova, razmaci, uglovi, ikone i veličina teksta zajedno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rækkehøjde, afstand, hjørner, ikoner og tekststørrelse samlet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilenhöhe, Abstände, Ecken, Symbole und Textgröße gemeinsam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de filas, márgenes, esquinas, iconos y tamaño del texto a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur des lignes, marges, coins, icônes et taille du texte ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza delle righe, spaziature, angoli, icone e dimensione del testo insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行の高さ、余白、角、アイコン、文字サイズをまとめて変えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្ពស់ជួរ គម្លាត ជ្រុង រូបតំណាង និងទំហំអក្សរ រួមគ្នា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행 높이, 여백, 모서리, 아이콘, 텍스트 크기를 함께 바꿉니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Radhøyde, avstand, hjørner, ikoner og tekststørrelse samlet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysokość wierszy, odstępy, narożniki, ikony i rozmiar tekstu razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura das linhas, espaçamento, cantos, ícones e tamanho do texto juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота строк, отступы, углы, значки и размер текста вместе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสูงแถว ระยะห่าง มุม ไอคอน และขนาดข้อความไปพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır yüksekliği, boşluk, köşeler, simgeler ve metin boyutu birlikte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висота рядків, відступи, кути, значки й розмір тексту разом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều cao hàng, khoảng đệm, góc, biểu tượng và cỡ chữ cùng lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行高、间距、圆角、图标和文字大小一起变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列高、間距、圓角、圖示和文字大小一起變化。"
          }
        }
      }
    },
