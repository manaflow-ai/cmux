    "settings.deviceHub.url.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device hub for Mac Screen sharing. Empty uses the built-in one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مركز الأجهزة لمشاركة Mac Screen. إذا كان فارغًا فيُستخدم المركز المدمج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Centar uređaja za Mac Screen dijeljenje. Prazno koristi ugrađeni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enhedshubben til Mac Screen-deling. Tom bruger den indbyggede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Geräte-Hub für das Teilen per Mac Screen. Leer nutzt den eingebauten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El centro de dispositivos para compartir Mac Screen. Vacío usa el integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le hub d’appareils pour le partage Mac Screen. Vide utilise le hub intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’hub dispositivi per la condivisione di Mac Screen. Vuoto usa quello integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac Screen の共有に使うデバイスハブ。空にすると内蔵のハブを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មជ្ឈមណ្ឌលឧបករណ៍សម្រាប់ចែករំលែក Mac Screen។ ទទេប្រើមជ្ឈមណ្ឌលដែលភ្ជាប់មកជាមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac Screen 공유용 기기 허브입니다. 비워 두면 내장 허브를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enhetshuben for Mac Screen-deling. Tom bruker den innebygde."
