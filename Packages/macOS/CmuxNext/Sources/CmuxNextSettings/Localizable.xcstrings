      }
    },
    "settings.appearance.highlightColor.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The color of selected text everywhere: terminals, Markdown, editors, the address bar and text fields. Unset, it is the terminal theme's selection color."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لون النص المحدد في كل مكان: الطرفيات وMarkdown والمحررات وشريط العنوان وحقول النص. إن لم يُضبط، فهو لون التحديد في سمة الطرفية."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Boja odabranog teksta svuda: u terminalima, Markdownu, uređivačima, adresnoj traci i tekstualnim poljima. Ako nije postavljena, to je boja odabira teme terminala."}},
        "da": {"stringUnit": {"state": "translated", "value": "Farven på markeret tekst overalt: terminaler, Markdown, editorer, adresselinjen og tekstfelter. Uden en værdi er det terminaltemaets markeringsfarve."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Farbe markierten Textes überall: Terminals, Markdown, Editoren, Adressleiste und Textfelder. Ohne Wert ist es die Auswahlfarbe des Terminal-Themas."}},
        "es": {"stringUnit": {"state": "translated", "value": "El color del texto seleccionado en todas partes: terminales, Markdown, editores, la barra de direcciones y los campos de texto. Sin valor, es el color de selección del tema del terminal."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La couleur du texte sélectionné partout : terminaux, Markdown, éditeurs, barre d'adresse et champs de texte. Sans valeur, c'est la couleur de sélection du thème du terminal."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il colore del testo selezionato ovunque: terminali, Markdown, editor, barra degli indirizzi e campi di testo. Se non impostato, è il colore di selezione del tema del terminale."}},
        "ja": {"stringUnit": {"state": "translated", "value": "選択したテキストの色(ターミナル、Markdown、エディタ、アドレスバー、テキストフィールドのすべて)。未設定の場合はターミナルテーマの選択色です。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ពណ៌​អត្ថបទ​ដែល​បាន​ជ្រើស​គ្រប់​ទីកន្លែង៖ ទែមីណាល់ Markdown កម្មវិធី​កែ របារ​អាសយដ្ឋាន និង​វាល​អត្ថបទ។ បើ​មិន​កំណត់ វា​ជា​ពណ៌​ជ្រើស​របស់​រចនាប័ទ្ម​ទែមីណាល់។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모든 곳에서 선택한 텍스트의 색상입니다: 터미널, Markdown, 편집기, 주소 표시줄, 텍스트 필드. 설정하지 않으면 터미널 테마의 선택 색상입니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Fargen på markert tekst overalt: terminaler, Markdown, redigeringsprogrammer, adresselinjen og tekstfelt. Uten verdi er det terminaltemaets markeringsfarge."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Kolor zaznaczonego tekstu wszędzie: w terminalach, Markdownie, edytorach, pasku adresu i polach tekstowych. Bez ustawienia jest to kolor zaznaczenia motywu terminala."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A cor do texto selecionado em todo lugar: terminais, Markdown, editores, barra de endereço e campos de texto. Sem valor, é a cor de seleção do tema do terminal."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Цвет выделенного текста везде: в терминалах, Markdown, редакторах, адресной строке и текстовых полях. Если не задан, это цвет выделения темы терминала."}},
        "th": {"stringUnit": {"state": "translated", "value": "สีของข้อความที่เลือกในทุกที่: เทอร์มินัล Markdown ตัวแก้ไข แถบที่อยู่ และช่องข้อความ หากไม่ได้ตั้งค่า จะเป็นสีการเลือกของธีมเทอร์มินัล"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Her yerde seçili metnin rengi: terminaller, Markdown, düzenleyiciler, adres çubuğu ve metin alanları. Ayarlanmazsa terminal temasının seçim rengidir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Колір виділеного тексту всюди: у терміналах, Markdown, редакторах, адресному рядку й текстових полях. Якщо не задано, це колір виділення теми термінала."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Màu của văn bản được chọn ở mọi nơi: terminal, Markdown, trình soạn thảo, thanh địa chỉ và trường văn bản. Nếu không đặt, đó là màu chọn của chủ đề terminal."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "所有位置中所选文本的颜色:终端、Markdown、编辑器、地址栏和文本字段。未设置时为终端主题的选区颜色。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "所有位置中所選文字的顏色:終端機、Markdown、編輯器、網址列和文字欄位。未設定時為終端機主題的選取顏色。"}}
      }
    },
