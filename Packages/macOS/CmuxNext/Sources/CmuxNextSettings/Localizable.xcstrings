    "settings.history.closed.maxGroups.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each machine deletes its oldest closed tabs, screens, workspaces and windows past this many. 0 keeps them all."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحذف كل جهاز أقدم علامات التبويب والشاشات ومساحات العمل والنوافذ المغلقة بعد تجاوز هذا العدد. القيمة 0 تحتفظ بها كلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka mašina briše najstarije zatvorene kartice, ekrane, radne prostore i prozore preko ovog broja. 0 čuva sve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver maskine sletter de ældste lukkede faner, skærme, arbejdsområder og vinduer ud over dette antal. 0 beholder dem alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Rechner löscht die ältesten geschlossenen Tabs, Bildschirme, Arbeitsbereiche und Fenster über diese Anzahl hinaus. 0 behält alle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada máquina elimina las pestañas, pantallas, espacios de trabajo y ventanas cerrados más antiguos que superen esta cantidad. 0 los conserva todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque machine supprime les onglets, écrans, espaces de travail et fenêtres fermés les plus anciens au-delà de ce nombre. 0 les conserve tous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni macchina elimina le schede, gli schermi, gli spazi di lavoro e le finestre chiusi più vecchi oltre questo numero. 0 li conserva tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各マシンは、この数を超えた最も古い閉じたタブ、画面、ワークスペース、ウインドウを削除します。0 ですべて保持します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននីមួយៗលុបផ្ទាំង អេក្រង់ កន្លែងធ្វើការ និងបង្អួចដែលបានបិទចាស់ជាងគេ ដែលលើសពីចំនួននេះ។ 0 រក្សាទុកទាំងអស់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 기기는 이 개수를 넘는 가장 오래된 닫은 탭, 화면, 작업 공간, 윈도우를 삭제합니다. 0이면 모두 보관합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver maskin sletter de eldste lukkede fanene, skjermene, arbeidsområdene og vinduene utover dette antallet. 0 beholder alle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każda maszyna usuwa najstarsze zamknięte karty, ekrany, obszary robocze i okna ponad tę liczbę. 0 zachowuje wszystkie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada máquina apaga as abas, telas, espaços de trabalho e janelas fechados mais antigos além desse número. 0 mantém todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каждая машина удаляет самые старые закрытые вкладки, экраны, рабочие пространства и окна сверх этого числа. 0 — хранить всё."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แต่ละเครื่องจะลบแท็บ หน้าจอ พื้นที่ทำงาน และหน้าต่างที่ปิดแล้วที่เก่าที่สุดเมื่อเกินจำนวนนี้ 0 คือเก็บไว้ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her makine bu sayıyı aşan en eski kapatılmış sekmeleri, ekranları, çalışma alanlarını ve pencereleri siler. 0 hepsini tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожна машина видаляє найстаріші закриті вкладки, екрани, робочі простори й вікна понад цю кількість. 0 — зберігати все."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi máy xóa các tab, màn hình, không gian làm việc và cửa sổ đã đóng cũ nhất vượt quá số này. 0 giữ lại tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每台机器会删除超出此数量的最早关闭的标签页、屏幕、工作区和窗口。0 表示全部保留。"
          }
        },
        "zh-Hant": {
