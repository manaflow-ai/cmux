    "settings.workspaceHibernation.idleMinutes.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تدخل مساحة العمل في السبات عندما لا تفتحها ولا يتغير فيها شيء لهذا العدد من الدقائق. لا تدخل مساحات العمل المثبتة والأوامر والوكلاء قيد التشغيل ومساحات العمل المبقاة مستيقظة في السبات أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radni prostor hibernira kada ga niste otvorili i ništa se u njemu nije promijenilo ovoliko minuta. Prikačeni radni prostori, pokrenute komande i agenti te radni prostori koji se drže budnim nikada ne hiberniraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbejdsområde går i dvale, når du ikke har åbnet det, og intet i det har ændret sig i så mange minutter. Fastgjorte arbejdsområder, kørende kommandoer og agenter samt arbejdsområder, der holdes vågne, går aldrig i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Arbeitsbereich ruht, wenn Sie ihn so viele Minuten nicht geöffnet haben und sich darin nichts geändert hat. Angeheftete Arbeitsbereiche, laufende Befehle und Agenten sowie wach gehaltene Arbeitsbereiche ruhen nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace hibernates when you have not opened it and nothing in it changed for this many minutes. Pinned workspaces, running commands and agents, and workspaces kept awake never hibernate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espacio de trabajo hiberna cuando no lo has abierto y nada ha cambiado en él durante estos minutos. Los espacios fijados, los comandos y agentes en marcha y los espacios mantenidos despiertos nunca hibernan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espace de travail se met en veille si vous ne l’avez pas ouvert et que rien n’y a changé pendant ce nombre de minutes. Les espaces épinglés, les commandes et agents en cours et les espaces maintenus éveillés ne se mettent jamais en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno spazio di lavoro va in ibernazione quando non lo apri e nulla cambia al suo interno per questi minuti. Gli spazi fissati, i comandi e gli agenti in esecuzione e gli spazi tenuti attivi non vanno mai in ibernazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間（分）のあいだ開かれず、中身も変化しなかったワークスペースはハイバネートします。ピン留めしたワークスペース、実行中のコマンドやエージェント、起こしたままにしたワークスペースはハイバネートしません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការនឹងផ្អាក នៅពេលអ្នកមិនបានបើកវា ហើយគ្មានអ្វីផ្លាស់ប្តូរក្នុងរយៈពេលប៉ុន្មាននាទីនេះ។ កន្លែងធ្វើការដែលបានខ្ទាស់ ពាក្យបញ្ជា និងភ្នាក់ងារដែលកំពុងដំណើរការ និងកន្លែងធ្វើការដែលរក្សាឱ្យភ្ញាក់ មិនដែលផ្អាកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 시간(분) 동안 열지 않았고 아무것도 바뀌지 않은 워크스페이스는 최대 절전 상태가 됩니다. 고정된 워크스페이스, 실행 중인 명령과 에이전트, 깨어 있도록 한 워크스페이스는 최대 절전 상태가 되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbeidsområde går i dvale når du ikke har åpnet det og ingenting i det har endret seg på så mange minutter. Festede arbeidsområder, kjørende kommandoer og agenter, og arbeidsområder som holdes våkne, går aldri i dvale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obszar roboczy przechodzi w hibernację, gdy nie otwierasz go i nic się w nim nie zmienia przez tyle minut. Przypięte obszary, działające polecenia i agenci oraz obszary utrzymywane w aktywności nigdy nie hibernują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um espaço de trabalho hiberna quando você não o abre e nada muda nele por esses minutos. Espaços fixados, comandos e agentes em execução e espaços mantidos acordados nunca hibernam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рабочее пространство переходит в гибернацию, если вы не открывали его и в нём ничего не менялось столько минут. Закреплённые пространства, выполняемые команды и агенты, а также пространства, оставленные активными, не переходят в гибернацию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานจะพักเมื่อคุณไม่ได้เปิดและไม่มีอะไรเปลี่ยนแปลงเป็นเวลาเท่านี้นาที พื้นที่ทำงานที่ปักหมุด คำสั่งและเอเจนต์ที่กำลังทำงาน และพื้นที่ทำงานที่ตั้งให้ตื่นอยู่จะไม่พักเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir çalışma alanı, siz açmadığınızda ve içinde bu kadar dakika hiçbir şey değişmediğinde hazırda bekler. Sabitlenmiş alanlar, çalışan komutlar ve ajanlar ile uyanık tutulan alanlar hiçbir zaman hazırda beklemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочий простір переходить у гібернацію, якщо ви не відкривали його і в ньому нічого не змінювалося стільки хвилин. Закріплені простори, запущені команди й агенти та простори, залишені активними, ніколи не переходять у гібернацію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc sẽ ngủ đông khi bạn không mở và không có gì thay đổi trong số phút này. Không gian đã ghim, lệnh và tác tử đang chạy, và không gian được giữ thức không bao giờ ngủ đông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果工作区在这么多分钟内未被打开且没有任何变化，就会休眠。已固定的工作区、正在运行的命令和代理，以及保持唤醒的工作区永远不会休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果工作區在這麼多分鐘內未被開啟且沒有任何變化，就會休眠。已釘選的工作區、正在執行的指令和代理，以及保持喚醒的工作區永遠不會休眠。"
          }
        }
      }
    },
