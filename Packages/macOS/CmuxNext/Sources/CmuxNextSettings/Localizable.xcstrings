    "settings.notifications.sounds.groups.help": {
      "comment": "Settings > Notifications > Sounds > Group Sounds: help text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أصوات لكل معرّف مجموعة أو اسمها. اضبطها من قائمة المجموعة في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zvukovi po ID-u ili nazivu grupe. Postavite ih iz menija grupe u bočnoj traci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyde pr. gruppe-id eller navn. Angiv dem i gruppens menu i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Töne pro Gruppen-ID oder -Name. Im Menü der Gruppe in der Seitenleiste festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds per group id or name. Set one from the group's sidebar menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sonidos por id o nombre de grupo. Configúralos desde su menú en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sons par id ou nom de groupe. À régler depuis son menu dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suoni per id o nome del gruppo. Impostali dal suo menu nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "グループ ID または名前ごとのサウンドです。サイドバーのグループのメニューから設定します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំឡេងតាម id ឬឈ្មោះក្រុម។ កំណត់ពីម៉ឺនុយក្រុមក្នុងរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그룹 ID 또는 이름별 사운드입니다. 사이드바의 그룹 메뉴에서 설정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyder per gruppe-id eller navn. Angi fra gruppens meny i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dźwięki według id lub nazwy grupy. Ustaw w jej menu na pasku bocznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sons por id ou nome do grupo. Defina no menu dele na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звуки по id или имени группы. Задаются в её меню на боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เสียงตาม id หรือชื่อของกลุ่ม ตั้งค่าได้จากเมนูของกลุ่มในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grup kimliğine veya adına göre sesler. Kenar çubuğundaki menüsünden ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звуки за id або назвою групи. Задаються в її меню на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Âm thanh theo id hoặc tên nhóm. Đặt từ menu của nhóm trên thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按分组 ID 或名称设置的声音。在侧边栏的分组菜单中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "依群組 ID 或名稱設定的聲音。在側邊欄的群組選單中設定。"
          }
        }
      }
    },
