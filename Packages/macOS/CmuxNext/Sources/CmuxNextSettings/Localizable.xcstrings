        "uk": {"stringUnit": {"state": "needs_review", "value": "Обмеження частоти кадрів демонстрації екрана"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Giới hạn tốc độ khung hình chia sẻ màn hình"}},
