    "settings.autoArchive.style.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived workspaces stay dimmed in their group and come back when opened."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى مساحات العمل المؤرشفة باهتة في مجموعتها، وتعود عند فتحها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arhivirani radni prostori ostaju zatamnjeni u svojoj grupi i vraćaju se kad ih otvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arkiverede arbejdsområder bliver nedtonet i deres gruppe og kommer tilbage, når de åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Archivierte Arbeitsbereiche bleiben abgeblendet in ihrer Gruppe und kommen beim Öffnen zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los espacios de trabajo archivados quedan atenuados en su grupo y vuelven al abrirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les espaces archivés restent estompés dans leur groupe et reviennent quand vous les ouvrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli spazi di lavoro archiviati restano attenuati nel loro gruppo e tornano quando li apri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アーカイブしたワークスペースはグループ内に淡く表示され、開くと元に戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការក្នុងប័ណ្ណសារនៅក្នុងក្រុមរបស់វាដោយស្រអាប់ ហើយត្រឡប់មកវិញពេលបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보관된 워크스페이스는 그룹 안에 흐리게 남고, 열면 돌아옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arkiverte arbeidsområder blir dempet i gruppen sin og kommer tilbake når de åpnes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zarchiwizowane obszary robocze zostają przygaszone w swojej grupie i wracają po otwarciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os espaços arquivados ficam esmaecidos no grupo e voltam quando abertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Архивные рабочие пространства остаются приглушёнными в своей группе и возвращаются при открытии."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เวิร์กสเปซที่เก็บถาวรจะแสดงจางในกลุ่มเดิม และกลับมาเมื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arşivlenen çalışma alanları gruplarında soluk kalır ve açıldığında geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Архівні робочі простори лишаються приглушеними у своїй групі й повертаються, коли ви їх відкриваєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian đã lưu trữ vẫn mờ đi trong nhóm và trở lại khi được mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "归档的工作区在原组中变暗，打开时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "封存的工作區會在原群組中變暗，開啟時恢復。"
          }
        }
      }
    },
