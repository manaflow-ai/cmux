    "settings.notifications.quietHours.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No banners or sounds between these times."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この時間帯はバナーもサウンドも出しません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا لافتات ولا أصوات بين هذين الوقتين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bez banera i zvukova između ovih vremena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen bannere eller lyde mellem disse tidspunkter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Banner oder Töne zwischen diesen Zeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin avisos ni sonidos entre estas horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune bannière ni aucun son entre ces heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun banner o suono tra questi orari."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានបដា ឬសំឡេងនៅចន្លោះម៉ោងទាំងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 시간 사이에는 배너나 사운드가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen bannere eller lyder mellom disse tidspunktene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bez banerów i dźwięków w tych godzinach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sem faixas nem sons entre esses horários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без баннеров и звуков в это время."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีแบนเนอร์หรือเสียงในช่วงเวลานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu saatler arasında afiş veya ses yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без банерів і звуків у цей час."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có biểu ngữ hay âm thanh trong khoảng thời gian này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
