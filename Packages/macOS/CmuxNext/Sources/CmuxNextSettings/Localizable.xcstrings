    "settings.appearance.terminalCellBackgrounds": {
      "comment": "Settings row title: how program-painted terminal cell backgrounds draw over a translucent window.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Terminal Cell Backgrounds"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "خلفيات خلايا الطرفية"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Pozadine ćelija terminala"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Baggrunde i terminalceller"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Hintergründe von Terminalzellen"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Fondos de celdas del terminal"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Arrière-plans des cellules du terminal"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Sfondi delle celle del terminale"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "ターミナルのセル背景"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ផ្ទៃខាងក្រោយក្រឡាស្ថានីយ"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "터미널 셀 배경"}},
