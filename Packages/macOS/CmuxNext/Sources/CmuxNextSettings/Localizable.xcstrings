    "settings.layout.stripScrollbar.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A thin bar under the columns that shows and moves the visible range."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شريط رفيع أسفل الأعمدة يعرض النطاق المرئي ويحركه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanka traka ispod kolona koja prikazuje i pomiče vidljivi raspon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En tynd bjælke under kolonnerne, der viser og flytter det synlige område."
