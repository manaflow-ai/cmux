    "notifications.sound.choose.message": {
      "comment": "Open panel message when choosing a notification sound file; keep ~/Library/Sounds as is",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر صوتًا للإشعارات. ينسخه cmux إلى ~/Library/Sounds."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite zvuk za obavještenja. cmux ga kopira u ~/Library/Sounds."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en lyd til notifikationer. cmux kopierer den til ~/Library/Sounds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle einen Ton für Mitteilungen. cmux kopiert ihn nach ~/Library/Sounds."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a sound for notifications. cmux copies it to ~/Library/Sounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige un sonido para las notificaciones. cmux lo copia a ~/Library/Sounds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un son pour les notifications. cmux le copie dans ~/Library/Sounds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli un suono per le notifiche. cmux lo copia in ~/Library/Sounds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通知のサウンドを選択してください。cmux が ~/Library/Sounds にコピーします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសរើសសំឡេងសម្រាប់ការជូនដំណឹង។ cmux ចម្លងវាទៅ ~/Library/Sounds។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "알림 사운드를 선택하세요. cmux가 ~/Library/Sounds에 복사합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en lyd for varsler. cmux kopierer den til ~/Library/Sounds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz dźwięk powiadomień. cmux skopiuje go do ~/Library/Sounds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um som para as notificações. O cmux o copia para ~/Library/Sounds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите звук для уведомлений. cmux скопирует его в ~/Library/Sounds."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกเสียงสำหรับการแจ้งเตือน cmux จะคัดลอกไปที่ ~/Library/Sounds"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bildirimler için bir ses seçin. cmux onu ~/Library/Sounds konumuna kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть звук для сповіщень. cmux скопіює його до ~/Library/Sounds."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn âm thanh cho thông báo. cmux sẽ sao chép vào ~/Library/Sounds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
