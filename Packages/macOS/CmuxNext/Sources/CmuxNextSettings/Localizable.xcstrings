    "settings.agentPane.display.minimap.help": {
      "comment": "Settings > Appearance > Agent Chat > Chat Minimap: help for the choice of the rail, the full map or nothing",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما يظهر على حافة المحادثة: الشريط، بعلامة لكل طلب؛ أو الخريطة الكاملة، كل رسالة في مكانها مع مربع لما يظهر على الشاشة؛ أو لا شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta ide uz ivicu razgovora: traka, jedna crtica po upitu; puna mapa, svaka poruka na svom mjestu s okvirom za ono što je na ekranu; ili ništa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad der løber langs chattens kant: skinnen med én streg pr. prompt; det fulde kort med hver besked på sin plads og en boks for det, der er på skærmen; eller intet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was am Rand des Chats verläuft: die Leiste mit einem Strich pro Prompt; die vollständige Karte mit jeder Nachricht an ihrer Stelle und einem Rahmen für das, was zu sehen ist; oder nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What runs down the chat's edge: the rail, one tick per prompt; the full map, every message at its place with a box for what is on screen; or nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que recorre el borde del chat: la barra, una marca por prompt; el mapa completo, cada mensaje en su lugar con un recuadro para lo que está en pantalla; o nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce qui longe le bord du chat : la barre, un trait par prompt ; la carte complète, chaque message à sa place avec un cadre pour ce qui est à l'écran ; ou rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa scorre lungo il bordo della chat: la barra, una tacca per prompt; la mappa completa, ogni messaggio al suo posto con un riquadro per ciò che è sullo schermo; oppure niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャットの端に表示するもの：プロンプトごとに目盛りを1つ置くレール、すべてのメッセージをその位置に並べて画面に見えている範囲を枠で示す全体マップ、または何も表示しない。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែលបង្ហាញតាមគែមនៃការជជែក៖ របារ ដែលមានសញ្ញាមួយសម្រាប់សំណួរនីមួយៗ; ផែនទីពេញ ដែលសារនីមួយៗនៅកន្លែងរបស់វា ជាមួយប្រអប់សម្រាប់អ្វីដែលនៅលើអេក្រង់; ឬគ្មានអ្វីទាំងអស់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅 가장자리에 표시할 항목: 프롬프트마다 눈금이 하나씩 있는 레일, 모든 메시지를 제자리에 두고 화면에 보이는 부분을 상자로 표시하는 전체 맵, 또는 표시 안 함."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva som går langs kanten av chatten: skinnen med én strek per prompt; det fulle kartet med hver melding på sin plass og en boks for det som er på skjermen; eller ingenting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co biegnie wzdłuż krawędzi czatu: pasek z jedną kreską na każdy prompt; pełna mapa z każdą wiadomością na swoim miejscu i ramką dla tego, co widać na ekranie; albo nic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que corre pela borda do chat: o trilho, com uma marca por prompt; o mapa completo, cada mensagem no seu lugar com uma caixa para o que está na tela; ou nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что идёт вдоль края чата: полоса с одной отметкой на каждый запрос; полная карта, где каждое сообщение на своём месте, а видимая часть обведена рамкой; или ничего."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่แสดงตามขอบของแชต: แถบที่มีขีดหนึ่งขีดต่อหนึ่งพรอมต์ แผนที่เต็มที่แสดงทุกข้อความในตำแหน่งของมันพร้อมกรอบสำหรับส่วนที่อยู่บนหน้าจอ หรือไม่แสดงอะไรเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbetin kenarı boyunca ne görünür: her istem için bir çentik bulunan şerit; her mesajın kendi yerinde olduğu ve ekranda görüneni bir kutuyla gösteren tam harita; ya da hiçbir şey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що йде вздовж краю чату: смуга з однією позначкою на кожен запит; повна мапа, де кожне повідомлення на своєму місці, а видиму частину обведено рамкою; або нічого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những gì chạy dọc cạnh cuộc trò chuyện: thanh với một vạch cho mỗi lời nhắc; bản đồ đầy đủ với mọi tin nhắn ở đúng vị trí và một khung cho phần đang hiển thị trên màn hình; hoặc không có gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聊天边缘显示的内容：标记条，每条提示一个刻度；完整地图，每条消息都在其位置，并用方框标出屏幕上可见的部分；或不显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聊天邊緣顯示的內容：標記條，每則提示一個刻度；完整地圖，每則訊息都在其位置，並以方框標出螢幕上可見的部分；或不顯示。"
          }
        }
      }
    },
