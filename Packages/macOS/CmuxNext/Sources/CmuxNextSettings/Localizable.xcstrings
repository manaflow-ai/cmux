        "th": {"stringUnit": {"state": "needs_review", "value": "สองโทน"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "İki ton"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Двоколірний"}},
