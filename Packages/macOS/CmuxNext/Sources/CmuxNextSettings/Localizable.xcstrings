    "settings.tabs.newTabWidgets.weatherCity.help": {
      "comment": "Settings: help for the Weather City text field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدينة لأداة الطقس. إذا تُركت فارغة تُستخدم مدينة منطقتك الزمنية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Grad za widget vremena. Prazno koristi grad vaše vremenske zone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En by til vejr-widgetten. Tom bruger din tidszones by."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stadt für das Wetter-Widget. Leer verwendet die Stadt deiner Zeitzone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A city for the weather widget. Empty uses your time zone's city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ciudad para el widget del tiempo. Vacío usa la ciudad de tu zona horaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ville pour le widget météo. Vide utilise la ville de votre fuseau horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una città per il widget meteo. Vuoto usa la città del tuo fuso orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気ウィジェットの都市。空欄ならタイムゾーンの都市を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទីក្រុង​សម្រាប់​វិដជិត​អាកាសធាតុ។ ទទេ​ប្រើ​ទីក្រុង​នៃ​តំបន់​ម៉ោង​របស់​អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 위젯의 도시입니다. 비워 두면 시간대 도시를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En by for vær-widgeten. Tom bruker byen i tidssonen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miasto dla widżetu pogody. Puste pole używa miasta Twojej strefy czasowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cidade para o widget do tempo. Vazio usa a cidade do seu fuso horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Город для виджета погоды. Если пусто, используется город вашего часового пояса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมืองสำหรับวิดเจ็ตสภาพอากาศ หากว่างจะใช้เมืองในเขตเวลาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu widget'ı için bir şehir. Boş bırakılırsa saat diliminizin şehri kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місто для віджета погоди. Якщо порожньо, використовується місто вашого часового поясу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thành phố cho tiện ích thời tiết. Để trống sẽ dùng thành phố theo múi giờ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天气小组件的城市。留空则使用你所在时区的城市。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天氣小工具的城市。留空則使用你所在時區的城市。"
          }
        }
      }
    },
