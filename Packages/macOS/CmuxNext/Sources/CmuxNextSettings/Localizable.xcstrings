    "settings.browser.omnibar.calculator.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the answer to arithmetic you type. Return copies it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض ناتج العملية الحسابية التي تكتبها. يؤدي Return إلى نسخه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje rezultat računa koji upišete. Return ga kopira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser resultatet af det regnestykke, du skriver. Retur kopierer det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt das Ergebnis eingetippter Rechnungen. Der Zeilenschalter kopiert es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra el resultado de las operaciones que escribes. Retorno lo copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche le résultat du calcul saisi. Retour le copie."
