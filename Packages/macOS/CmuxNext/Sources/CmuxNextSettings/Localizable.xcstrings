    "settings.freeModel.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can use the free cmux model while signed out. cmux checks this is a real Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن للوكلاء استخدام نموذج cmux المجاني أثناء تسجيل الخروج. يتحقق cmux من أن هذا جهاز Mac حقيقي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenten können das kostenlose cmux-Modell auch abgemeldet nutzen. cmux prüft, dass dies ein echter Mac ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los agentes pueden usar el modelo gratuito de cmux sin iniciar sesión. cmux comprueba que este es un Mac real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les agents peuvent utiliser le modèle gratuit de cmux sans connexion. cmux vérifie qu’il s’agit d’un vrai Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サインアウト中でもエージェントが cmux の無料モデルを使えます。cmux はこの Mac が本物であることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로그아웃 상태에서도 에이전트가 cmux 무료 모델을 사용할 수 있습니다. cmux가 실제 Mac인지 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理在未登录时可使用 cmux 免费模型。cmux 会验证这是一台真正的 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理可以在未登入時使用 cmux 免費模型。cmux 會驗證這是一台真正的 Mac。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenti mogu koristiti besplatni cmux model dok ste odjavljeni. cmux provjerava da je ovo pravi Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenter kan bruge den gratis cmux-model, mens du er logget ud. cmux tjekker, at dette er en rigtig Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli agenti possono usare il modello gratuito di cmux senza accesso. cmux verifica che sia un vero Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារអាចប្រើគំរូឥតគិតថ្លៃរបស់ cmux ពេលអ្នកចាកចេញពីគណនី។ cmux ពិនិត្យថានេះជា Mac ពិតប្រាកដ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenter kan bruke den gratis cmux-modellen mens du er logget ut. cmux sjekker at dette er en ekte Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenci mogą używać darmowego modelu cmux bez logowania. cmux sprawdza, czy to prawdziwy Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os agentes podem usar o modelo gratuito do cmux sem login. O cmux verifica que este é um Mac real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенты могут использовать бесплатную модель cmux без входа. cmux проверяет, что это настоящий Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอเจนต์ใช้โมเดลฟรีของ cmux ได้ขณะออกจากระบบ cmux จะตรวจว่านี่คือ Mac จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlar oturum kapalıyken ücretsiz cmux modelini kullanabilir. cmux bunun gerçek bir Mac olduğunu doğrular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенти можуть користуватися безплатною моделлю cmux, коли ви не ввійшли. cmux перевіряє, що це справжній Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác nhân có thể dùng mô hình miễn phí của cmux khi bạn chưa đăng nhập. cmux kiểm tra đây là một chiếc Mac thật."
          }
        }
      }
    },
