    "settings.app.language.help": {
      "comment": "Settings row help for the Language row.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The language of cmux's menus, pages and messages."}},
        "ar": {"stringUnit": {"state": "translated", "value": "لغة قوائم cmux وصفحاته ورسائله."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Jezik menija, stranica i poruka u cmuxu."}},
        "da": {"stringUnit": {"state": "translated", "value": "Sproget i cmux' menuer, sider og beskeder."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Sprache von cmux-Menüs, -Seiten und -Meldungen."}},
        "es": {"stringUnit": {"state": "translated", "value": "El idioma de los menús, páginas y mensajes de cmux."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La langue des menus, pages et messages de cmux."}},
        "it": {"stringUnit": {"state": "translated", "value": "La lingua di menu, pagine e messaggi di cmux."}},
        "ja": {"stringUnit": {"state": "translated", "value": "cmux のメニュー、ページ、メッセージの言語。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ភាសានៃម៉ឺនុយ ទំព័រ និងសាររបស់ cmux។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "cmux 메뉴, 페이지, 메시지의 언어입니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Språket i menyene, sidene og meldingene i cmux."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Język menu, stron i komunikatów cmux."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O idioma dos menus, páginas e mensagens do cmux."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Язык меню, страниц и сообщений cmux."}},
        "th": {"stringUnit": {"state": "translated", "value": "ภาษาของเมนู หน้า และข้อความใน cmux"}},
        "tr": {"stringUnit": {"state": "translated", "value": "cmux menülerinin, sayfalarının ve iletilerinin dili."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Мова меню, сторінок і повідомлень cmux."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Ngôn ngữ của menu, trang và thông báo trong cmux."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "cmux 菜单、页面和消息使用的语言。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "cmux 選單、頁面和訊息使用的語言。"}}
      }
    },
