    "settings.chats.coldSegments.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضغط الأجزاء الأقدم من الدردشات الطويلة. شغّل cmux chats warm للتراجع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sažima starije dijelove dugih razgovora. Pokrenite cmux chats warm da poništite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimerer de ældre dele af lange chats. Kør cmux chats warm for at fortryde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimiert die älteren Teile langer Chats. Zum Rückgängigmachen cmux chats warm ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresses the older parts of long chats. Run cmux chats warm to undo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprime las partes más antiguas de los chats largos. Ejecuta cmux chats warm para deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresse les parties les plus anciennes des longues discussions. Exécutez cmux chats warm pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprime le parti più vecchie delle chat lunghe. Esegui cmux chats warm per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いチャットの古い部分を圧縮します。元に戻すには cmux chats warm を実行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាប់ផ្នែកចាស់ៗនៃការជជែកវែងៗ។ ដំណើរការ cmux chats warm ដើម្បីត្រឡប់វិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 채팅의 오래된 부분을 압축합니다. 되돌리려면 cmux chats warm을 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimerer de eldre delene av lange chatter. Kjør cmux chats warm for å angre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompresuje starsze części długich czatów. Uruchom cmux chats warm, aby cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprime as partes mais antigas de chats longos. Execute cmux chats warm para desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжимает старые части длинных чатов. Чтобы отменить, выполните cmux chats warm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บีบอัดส่วนที่เก่ากว่าของแชทที่ยาว เรียกใช้ cmux chats warm เพื่อเลิกทำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun sohbetlerin eski bölümlerini sıkıştırır. Geri almak için cmux chats warm komutunu çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стискає старіші частини довгих чатів. Щоб скасувати, виконайте cmux chats warm."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nén các phần cũ của những cuộc trò chuyện dài. Chạy cmux chats warm để hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩长聊天中较早的部分。运行 cmux chats warm 可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮長聊天中較早的部分。執行 cmux chats warm 可復原。"
          }
        }
      }
    },
