    "settings.agentPane.display.thinking.jumpButton.help": {
      "comment": "Settings > Chat > Transcript > Jump to Latest While Working: help; Jump to latest is the chat's button that scrolls to the newest message",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "What the Jump to latest button shows while the agent works."}},
