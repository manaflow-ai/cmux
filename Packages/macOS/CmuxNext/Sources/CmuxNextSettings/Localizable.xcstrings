    "settings.layout.paneSeparation.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How panes are told apart. None draws no border or divider at all; dragging between panes still resizes them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペインの区切り方。「なし」では境界線も区切り線も描きません。ペインの間をドラッグするとサイズは変更できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيفية التمييز بين الأجزاء. «لا شيء» لا يرسم أي حد أو فاصل؛ ويظل السحب بين الأجزاء يغيّر حجمها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako se okna razlikuju. Ništa ne crta ni obrub ni razdjelnik; povlačenje između okana i dalje mijenja njihovu veličinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan ruder skelnes fra hinanden. Ingen tegner hverken kant eller skillelinje; træk mellem ruder ændrer stadig deres størrelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie Bereiche voneinander getrennt werden. Keine zeichnet weder Rahmen noch Trennlinie; Ziehen zwischen Bereichen ändert weiterhin ihre Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo se distinguen los paneles. Ninguno no dibuja bordes ni divisores; arrastrar entre paneles sigue cambiando su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comment les panneaux se distinguent. Aucune ne dessine ni bordure ni séparateur ; glisser entre les panneaux les redimensionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come si distinguono i riquadri. Nessuna non disegna bordi né divisori; trascinare tra i riquadri li ridimensiona comunque."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបបែងចែកផ្ទាំង។ គ្មាន មិនគូរស៊ុម ឬបន្ទាត់ខណ្ឌទាល់តែសោះ; ការអូសរវាងផ្ទាំងនៅតែប្ដូរទំហំបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창을 구분하는 방식입니다. 없음은 테두리나 구분선을 그리지 않으며, 창 사이를 드래그하면 여전히 크기가 조절됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan ruter skilles fra hverandre. Ingen tegner verken kant eller skillelinje; dra mellom ruter endrer fortsatt størrelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposób oddzielania paneli. Brak nie rysuje ramek ani linii podziału; przeciąganie między panelami nadal zmienia ich rozmiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como os painéis se distinguem. Nenhuma não desenha bordas nem divisores; arrastar entre painéis ainda os redimensiona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как разделяются панели. «Нет» не рисует ни рамок, ни разделителей; перетаскивание между панелями по-прежнему меняет их размер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิธีแยกแต่ละบาน ไม่มี จะไม่วาดเส้นขอบหรือเส้นแบ่งเลย การลากระหว่างบานยังปรับขนาดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bölmelerin nasıl ayrıldığı. Hiçbiri kenarlık veya ayırıcı çizmez; bölmeler arasında sürüklemek yine de boyutlarını değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як розділяються панелі. «Немає» не малює ні рамок, ні розділювачів; перетягування між панелями все одно змінює їхній розмір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách phân biệt các ngăn. Không có sẽ không vẽ viền hay đường chia; kéo giữa các ngăn vẫn đổi kích thước được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗格之间如何区分。“无”不绘制任何边框或分隔线；在窗格之间拖动仍可调整大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗格之間如何區分。「無」不繪製任何邊框或分隔線；在窗格之間拖曳仍可調整大小。"
          }
        }
      }
    },
