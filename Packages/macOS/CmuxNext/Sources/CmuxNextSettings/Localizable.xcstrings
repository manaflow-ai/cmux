          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold nabofaner våkne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utrzymuj sąsiednie karty w gotowości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Manter abas vizinhas ativas"
          }
        },
        "ru": {
