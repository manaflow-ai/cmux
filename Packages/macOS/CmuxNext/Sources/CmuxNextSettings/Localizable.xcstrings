    "settings.macScreen.systemShortcuts.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts like ⌘Tab and ⌘Space go to the other Mac. Needs Accessibility."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنتقل اختصارات مثل ⌘Tab و⌘Space إلى الـMac الآخر. يتطلب تسهيلات الاستخدام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prečice poput ⌘Tab i ⌘Space idu na drugi Mac. Potrebna je pristupačnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Genveje som ⌘Tab og ⌘Space går til den anden Mac. Kræver tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurzbefehle wie ⌘Tab und ⌘Space gehen an den anderen Mac. Erfordert Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atajos como ⌘Tab y ⌘Space van al otro Mac. Requiere accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les raccourcis comme ⌘Tab et ⌘Space vont à l’autre Mac. Nécessite l’accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abbreviazioni come ⌘Tab e ⌘Space vanno all’altro Mac. Richiede l’accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Tab や ⌘Space などのショートカットをもう一方のMacに送ります。アクセシビリティが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្លូវកាត់ដូចជា ⌘Tab និង ⌘Space ទៅ Mac ផ្សេងទៀត។ ត្រូវការភាពងាយស្រួល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Tab, ⌘Space 같은 단축키가 다른 Mac으로 갑니다. 손쉬운 사용이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snarveier som ⌘Tab og ⌘Space går til den andre Macen. Krever tilgjengelighet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skróty takie jak ⌘Tab i ⌘Space trafiają do drugiego Maca. Wymaga dostępności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atalhos como ⌘Tab e ⌘Space vão para o outro Mac. Requer acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сочетания вроде ⌘Tab и ⌘Space уходят на другой Mac. Нужен универсальный доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปุ่มลัดอย่าง ⌘Tab และ ⌘Space จะไปที่ Mac อีกเครื่อง ต้องใช้การช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Tab ve ⌘Space gibi kısayollar diğer Mac’e gider. Erişilebilirlik gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сполучення на кшталт ⌘Tab і ⌘Space ідуть на інший Mac. Потрібна доступність."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các phím tắt như ⌘Tab và ⌘Space sẽ đến máy Mac kia. Cần Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Tab 和 ⌘Space 等快捷键会发送到另一台 Mac。需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘Tab 和 ⌘Space 等快速鍵會傳送到另一台 Mac。需要輔助使用權限。"
          }
        }
      }
    },
