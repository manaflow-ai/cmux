    "settings.sidebar.groupHeader.memberCount.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A collapsed group shows how many workspaces it holds after its name. Off, it shows only its loading spinner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض المجموعة المطوية عدد مساحات العمل التي تضمها بعد اسمها. عند الإيقاف، تعرض مؤشر التحميل فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skupljena grupa nakon naziva prikazuje koliko radnih prostora sadrži. Isključeno: prikazuje samo indikator učitavanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sammenklappet gruppe viser efter navnet, hvor mange arbejdsområder den har. Fra: Den viser kun sin indlæsningsindikator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine eingeklappte Gruppe zeigt nach ihrem Namen, wie viele Arbeitsbereiche sie enthält. Aus: Sie zeigt nur ihren Ladeindikator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un grupo contraído muestra cuántos espacios de trabajo contiene después de su nombre. Desactivado, solo muestra su indicador de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un groupe replié affiche le nombre de ses espaces de travail après son nom. Désactivé, il n’affiche que son indicateur de chargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un gruppo compresso mostra quanti spazi di lavoro contiene dopo il nome. Disattivato, mostra solo l’indicatore di caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "折りたたんだグループの名前の後に、含まれるワークスペースの数を表示します。オフの場合は読み込み中のスピナーのみを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្រុមដែលបានបង្រួមបង្ហាញចំនួនកន្លែងធ្វើការបន្ទាប់ពីឈ្មោះ។ ពេលបិទ វាបង្ហាញតែសញ្ញាកំពុងផ្ទុកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "접힌 그룹은 이름 뒤에 포함된 워크스페이스 수를 표시합니다. 끄면 로딩 표시기만 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sammenslått gruppe viser etter navnet hvor mange arbeidsområder den har. Av: Den viser bare innlastingsindikatoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwinięta grupa pokazuje po nazwie, ile zawiera obszarów roboczych. Wyłączone: pokazuje tylko wskaźnik ładowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um grupo recolhido mostra quantos espaços de trabalho contém após o nome. Desativado, mostra apenas o indicador de carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свёрнутая группа показывает после названия, сколько в ней рабочих пространств. Если выключено, показывается только индикатор загрузки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กลุ่มที่ยุบอยู่จะแสดงจำนวนพื้นที่ทำงานต่อจากชื่อ เมื่อปิด จะแสดงเฉพาะตัวบอกการโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daraltılmış bir grup, adından sonra kaç çalışma alanı içerdiğini gösterir. Kapalıyken yalnızca yükleme göstergesini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Згорнута група показує після назви, скільки в ній робочих просторів. Якщо вимкнено, показується лише індикатор завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhóm thu gọn hiện số không gian làm việc sau tên. Khi tắt, chỉ hiện biểu tượng đang tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "折叠的分组在名称后显示其包含的工作区数量。关闭时只显示加载指示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "收合的群組會在名稱後顯示其包含的工作區數量。關閉時只顯示載入指示器。"
          }
        }
      }
    },
