    "settings.updates.downloadAutomatically.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: cmux checks for updates and asks before it downloads one. On: updates download by themselves. Either way, cmux asks before it restarts into an update."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف: يبحث cmux عن التحديثات ويسأل قبل تنزيل أي تحديث. تشغيل: تُنزَّل التحديثات تلقائيًا. وفي الحالتين، يسأل cmux قبل إعادة التشغيل إلى التحديث."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno: cmux provjerava ažuriranja i pita prije nego što preuzme ažuriranje. Uključeno: ažuriranja se sama preuzimaju. U oba slučaja cmux pita prije ponovnog pokretanja u ažuriranje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra: cmux søger efter opdateringer og spørger, før den henter en. Til: opdateringer hentes automatisk. Uanset hvad spørger cmux, før den genstarter med en opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: cmux sucht nach Updates und fragt, bevor es eines lädt. An: Updates werden automatisch geladen. In beiden Fällen fragt cmux, bevor es mit einem Update neu startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: cmux busca actualizaciones y pregunta antes de descargar una. Activado: las actualizaciones se descargan solas. En ambos casos, cmux pregunta antes de reiniciarse con una actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : cmux recherche les mises à jour et demande avant d’en télécharger une. Activé : les mises à jour se téléchargent d’elles-mêmes. Dans les deux cas, cmux demande avant de redémarrer avec une mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato: cmux controlla gli aggiornamenti e chiede prima di scaricarne uno. Attivato: gli aggiornamenti si scaricano da soli. In entrambi i casi, cmux chiede prima di riavviarsi con un aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ：cmux はアップデートを確認し、ダウンロードする前に確認します。オン：アップデートは自動でダウンロードされます。どちらの場合も、アップデートを適用して再起動する前に確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ៖ cmux ពិនិត្យរកបច្ចុប្បន្នភាព ហើយសួរមុនពេលទាញយក។ បើក៖ បច្ចុប្បន្នភាពទាញយកដោយខ្លួនឯង។ ទោះយ៉ាងណាក៏ដោយ cmux សួរមុនពេលចាប់ផ្ដើមឡើងវិញទៅកាន់បច្ចុប្បន្នភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 cmux는 업데이트를 확인하고 다운로드하기 전에 묻습니다. 켜면 업데이트가 자동으로 다운로드됩니다. 어느 쪽이든 cmux는 업데이트로 다시 시작하기 전에 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av: cmux ser etter oppdateringer og spør før den laster ned en. På: oppdateringer lastes ned automatisk. Uansett spør cmux før den starter på nytt med en oppdatering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wył.: cmux sprawdza aktualizacje i pyta przed pobraniem aktualizacji. Wł.: aktualizacje pobierają się same. W obu przypadkach cmux pyta przed ponownym uruchomieniem z aktualizacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado: o cmux procura atualizações e pergunta antes de baixar uma. Ativado: as atualizações são baixadas sozinhas. Em ambos os casos, o cmux pergunta antes de reiniciar com uma atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выкл.: cmux проверяет обновления и спрашивает, прежде чем загрузить обновление. Вкл.: обновления загружаются сами. В обоих случаях cmux спрашивает, прежде чем перезапуститься с обновлением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิด: cmux ตรวจหาอัปเดตและถามก่อนดาวน์โหลด เปิด: อัปเดตจะดาวน์โหลดเอง ไม่ว่าแบบใด cmux จะถามก่อนรีสตาร์ทเพื่อใช้อัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı: cmux güncellemeleri denetler ve bir güncellemeyi indirmeden önce sorar. Açık: güncellemeler kendiliğinden indirilir. Her iki durumda da cmux bir güncellemeyle yeniden başlamadan önce sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимк.: cmux перевіряє оновлення й питає, перш ніж завантажити оновлення. Увімк.: оновлення завантажуються самі. В обох випадках cmux питає, перш ніж перезапуститися з оновленням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt: cmux kiểm tra bản cập nhật và hỏi trước khi tải xuống. Bật: bản cập nhật tự tải xuống. Dù thế nào, cmux cũng hỏi trước khi khởi động lại vào bản cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：cmux 会检查更新，并在下载更新之前询问。打开：更新会自动下载。无论哪种方式，cmux 都会在重新启动以应用更新之前询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉：cmux 會檢查更新，並在下載更新之前詢問。開啟：更新會自動下載。無論哪種方式，cmux 都會在重新啟動以套用更新之前詢問。"
          }
        }
      }
    },
