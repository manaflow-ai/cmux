    "settings.computerUse.menus": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Menus in Background Apps"}},
        "ar": {"stringUnit": {"state": "translated", "value": "القوائم في التطبيقات الخلفية"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Meniji u aplikacijama u pozadini"}},
        "da": {"stringUnit": {"state": "translated", "value": "Menuer i baggrundsapps"}},
        "de": {"stringUnit": {"state": "translated", "value": "Menüs in Hintergrund-Apps"}},
        "es": {"stringUnit": {"state": "translated", "value": "Menús en apps en segundo plano"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Menus dans les apps en arrière-plan"}},
        "it": {"stringUnit": {"state": "translated", "value": "Menu nelle app in background"}},
        "ja": {"stringUnit": {"state": "translated", "value": "バックグラウンドのアプリのメニュー"}},
        "km": {"stringUnit": {"state": "translated", "value": "ម៉ឺនុយក្នុងកម្មវិធីផ្ទៃខាងក្រោយ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "백그라운드 앱의 메뉴"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Menyer i bakgrunnsapper"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Menu w aplikacjach w tle"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Menus em apps em segundo plano"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Меню в фоновых приложениях"}},
        "th": {"stringUnit": {"state": "translated", "value": "เมนูในแอปเบื้องหลัง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Arka plandaki uygulamalarda menüler"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Меню у фонових застосунках"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Menu trong ứng dụng chạy nền"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "后台 App 中的菜单"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "背景 App 中的選單"}}
      }
    },
    "settings.computerUse.menus.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agents may open pop-up and context menus of apps in the background to choose an item. Menu bar menus never open in the background."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكن للوكلاء فتح القوائم المنبثقة وقوائم السياق في التطبيقات الخلفية لاختيار عنصر. لا تُفتح قوائم شريط القوائم في الخلفية أبدًا."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Agenti mogu otvarati iskačuće i kontekstne menije aplikacija u pozadini da izaberu stavku. Meniji trake menija se nikad ne otvaraju u pozadini."}},
        "da": {"stringUnit": {"state": "translated", "value": "Agenter kan åbne pop op- og genvejsmenuer i apps i baggrunden for at vælge et emne. Menuer på menulinjen åbnes aldrig i baggrunden."}},
        "de": {"stringUnit": {"state": "translated", "value": "Agenten dürfen Einblend- und Kontextmenüs von Apps im Hintergrund öffnen, um ein Objekt auszuwählen. Menüs der Menüleiste öffnen sich nie im Hintergrund."}},
        "es": {"stringUnit": {"state": "translated", "value": "Los agentes pueden abrir menús desplegables y contextuales de apps en segundo plano para elegir un elemento. Los menús de la barra de menús nunca se abren en segundo plano."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les agents peuvent ouvrir les menus contextuels et locaux des apps en arrière-plan pour choisir un élément. Les menus de la barre des menus ne s’ouvrent jamais en arrière-plan."}},
        "it": {"stringUnit": {"state": "translated", "value": "Gli agenti possono aprire i menu a comparsa e contestuali delle app in background per scegliere un elemento. I menu della barra dei menu non si aprono mai in background."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントは、バックグラウンドのアプリのポップアップメニューやコンテキストメニューを開いて項目を選択できます。メニューバーのメニューはバックグラウンドでは開きません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ភ្នាក់ងារអាចបើកម៉ឺនុយលេចឡើង និងម៉ឺនុយបរិបទរបស់កម្មវិធីនៅផ្ទៃខាងក្រោយ ដើម្បីជ្រើសរើសធាតុ។ ម៉ឺនុយរបារម៉ឺនុយមិនដែលបើកនៅផ្ទៃខាងក្រោយទេ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트가 백그라운드 앱의 팝업 메뉴와 컨텍스트 메뉴를 열어 항목을 선택할 수 있습니다. 메뉴 막대의 메뉴는 백그라운드에서 열리지 않습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Agenter kan åpne lokalmenyer og kontekstmenyer i apper i bakgrunnen for å velge et element. Menyer på menylinjen åpnes aldri i bakgrunnen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Agenci mogą otwierać menu podręczne i kontekstowe aplikacji w tle, aby wybrać element. Menu z paska menu nigdy nie otwierają się w tle."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Os agentes podem abrir menus pop-up e de contexto de apps em segundo plano para escolher um item. Os menus da barra de menus nunca abrem em segundo plano."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Агенты могут открывать всплывающие и контекстные меню фоновых приложений, чтобы выбрать пункт. Меню строки меню никогда не открываются в фоне."}},
        "th": {"stringUnit": {"state": "translated", "value": "เอเจนต์สามารถเปิดเมนูป๊อปอัปและเมนูบริบทของแอปในเบื้องหลังเพื่อเลือกรายการได้ เมนูในแถบเมนูจะไม่เปิดในเบื้องหลัง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajanlar bir öğe seçmek için arka plandaki uygulamaların açılır ve bağlam menülerini açabilir. Menü çubuğu menüleri arka planda asla açılmaz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Агенти можуть відкривати спливні та контекстні меню фонових застосунків, щоб вибрати пункт. Меню смуги меню ніколи не відкриваються у фоні."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tác tử có thể mở menu bật lên và menu ngữ cảnh của ứng dụng chạy nền để chọn một mục. Menu trên thanh menu không bao giờ mở ở chế độ nền."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理可以打开后台 App 的弹出式菜单和上下文菜单来选择项目。菜单栏中的菜单永远不会在后台打开。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理程式可以打開背景 App 的彈出式選單和內容選單來選擇項目。選單列的選單絕不會在背景打開。"}}
      }
    },
