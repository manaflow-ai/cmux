    "settings.appearance.background.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a bundled public-domain painting or a macOS system wallpaper behind the window material."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein gemeinfreies Gemälde oder ein macOS-Systembild hinter dem Fenstermaterial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une peinture libre de droits ou un fond d’écran macOS derrière le matériau de la fenêtre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
