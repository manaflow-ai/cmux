    "settings.appearance.appTheme.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors for the window, sidebar, tabs and cmux's pages. Terminals keep the Terminal Theme. Every color meets WCAG AA contrast."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ألوان النافذة والشريط الجانبي وعلامات التبويب وصفحات cmux. تحتفظ الطرفيات بسمة الطرفية. كل لون يحقق تباين WCAG AA."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boje prozora, bočne trake, kartica i cmux stranica. Terminali zadržavaju temu terminala. Svaka boja ispunjava WCAG AA kontrast."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farver til vinduet, sidepanelet, fanerne og cmux' sider. Terminaler beholder terminaltemaet. Alle farver opfylder WCAG AA-kontrast."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farben für Fenster, Seitenleiste, Tabs und die Seiten von cmux. Terminals behalten das Terminal-Theme. Jede Farbe erfüllt den WCAG-AA-Kontrast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colores de la ventana, la barra lateral, las pestañas y las páginas de cmux. Los terminales conservan el tema del terminal. Cada color cumple el contraste WCAG AA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Couleurs de la fenêtre, de la barre latérale, des onglets et des pages de cmux. Les terminaux gardent le thème du terminal. Chaque couleur respecte le contraste WCAG AA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colori di finestra, barra laterale, schede e pagine di cmux. I terminali mantengono il tema del terminale. Ogni colore rispetta il contrasto WCAG AA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウインドウ、サイドバー、タブ、cmux のページの色です。ターミナルはターミナルテーマのままです。どの色も WCAG AA のコントラストを満たします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពណ៌សម្រាប់បង្អួច របារចំហៀង ផ្ទាំង និងទំព័ររបស់ cmux។ ទែមីណាល់រក្សាស្បែកទែមីណាល់។ ពណ៌នីមួយៗបំពេញកម្រិតពន្លឺប្រៀបធៀប WCAG AA។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창, 사이드바, 탭, cmux 페이지의 색상입니다. 터미널은 터미널 테마를 유지합니다. 모든 색상이 WCAG AA 대비를 충족합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farger for vinduet, sidefeltet, fanene og cmux-sidene. Terminaler beholder terminaltemaet. Alle farger oppfyller WCAG AA-kontrast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolory okna, paska bocznego, kart i stron cmux. Terminale zachowują motyw terminala. Każdy kolor spełnia kontrast WCAG AA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cores da janela, barra lateral, abas e páginas do cmux. Os terminais mantêm o tema do terminal. Cada cor atende ao contraste WCAG AA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цвета окна, боковой панели, вкладок и страниц cmux. Терминалы сохраняют тему терминала. Каждый цвет соответствует контрасту WCAG AA."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สีของหน้าต่าง แถบด้านข้าง แท็บ และหน้าของ cmux เทอร์มินัลยังใช้ธีมเทอร์มินัล ทุกสีผ่านคอนทราสต์ WCAG AA"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pencere, kenar çubuğu, sekmeler ve cmux sayfalarının renkleri. Terminaller terminal temasını korur. Her renk WCAG AA kontrastını karşılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кольори вікна, бічної панелі, вкладок і сторінок cmux. Термінали зберігають тему термінала. Кожен колір відповідає контрасту WCAG AA."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màu cho cửa sổ, thanh bên, các tab và trang của cmux. Terminal giữ chủ đề terminal. Mọi màu đều đạt độ tương phản WCAG AA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗口、侧边栏、标签页和 cmux 页面的颜色。终端保留终端主题。每种颜色都符合 WCAG AA 对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "視窗、側邊欄、分頁和 cmux 頁面的顏色。終端機保留終端機主題。每種顏色都符合 WCAG AA 對比度。"
          }
        }
      }
    },
