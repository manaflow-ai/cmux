    "settings.markdown.width.help": {
      "comment": "Settings help for Text Width",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widest a line of text gets, in characters (30 to 1000). On a wider window the text stays centered with margins. Wide tables and code scroll sideways in their own box."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى عرض لسطر النص، بالأحرف (من 30 إلى 1000). في النافذة الأعرض يبقى النص في المنتصف مع هوامش. الجداول والتعليمات البرمجية العريضة تُمرَّر أفقيًا داخل مربعها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najveća širina reda teksta, u znakovima (30 do 1000). U širem prozoru tekst ostaje centriran s marginama. Široke tabele i kod pomjeraju se vodoravno u svom okviru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den største bredde en tekstlinje får, i tegn (30 til 1000). I et bredere vindue forbliver teksten centreret med margener. Brede tabeller og kode ruller sidelæns i deres egen boks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maximale Breite einer Textzeile in Zeichen (30 bis 1000). In einem breiteren Fenster bleibt der Text mit Rändern zentriert. Breite Tabellen und Code scrollen seitlich in ihrem eigenen Feld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancho máximo de una línea de texto, en caracteres (de 30 a 1000). En una ventana más ancha, el texto queda centrado con márgenes. Las tablas y el código anchos se desplazan en horizontal dentro de su propio cuadro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La largeur maximale d’une ligne de texte, en caractères (de 30 à 1000). Dans une fenêtre plus large, le texte reste centré avec des marges. Les tableaux et le code larges défilent horizontalement dans leur propre cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La larghezza massima di una riga di testo, in caratteri (da 30 a 1000). In una finestra più larga il testo resta centrato con i margini. Tabelle e codice larghi scorrono in orizzontale nel proprio riquadro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト1行の最大幅（文字数、30〜1000）。ウインドウのほうが広いときは、テキストは余白を残して中央に表示されます。幅の広い表やコードは、それぞれの枠内で横にスクロールします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទទឹងធំបំផុតនៃបន្ទាត់អត្ថបទ គិតជាតួអក្សរ (30 ដល់ 1000)។ នៅលើបង្អួចធំជាងនេះ អត្ថបទនៅកណ្ដាល ដោយមានគែម។ តារាង និងកូដធំៗ រំកិលទៅចំហៀងក្នុងប្រអប់ផ្ទាល់ខ្លួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 한 줄의 최대 너비(문자 수, 30~1000)입니다. 창이 더 넓으면 텍스트는 여백을 두고 가운데에 놓입니다. 넓은 표와 코드는 각자의 상자 안에서 가로로 스크롤됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den største bredden en tekstlinje får, i tegn (30 til 1000). I et bredere vindu holder teksten seg midtstilt med marger. Brede tabeller og kode ruller sidelengs i sin egen boks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największa szerokość wiersza tekstu w znakach (od 30 do 1000). W szerszym oknie tekst pozostaje wyśrodkowany z marginesami. Szerokie tabele i kod przewijają się w poziomie we własnym polu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A largura máxima de uma linha de texto, em caracteres (de 30 a 1000). Em uma janela mais larga, o texto fica centralizado com margens. Tabelas e códigos largos rolam na horizontal na própria caixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшая ширина строки текста в символах (от 30 до 1000). В более широком окне текст остаётся по центру с полями. Широкие таблицы и код прокручиваются по горизонтали в своём блоке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความกว้างสูงสุดของบรรทัดข้อความ เป็นจำนวนอักขระ (30 ถึง 1000) ในหน้าต่างที่กว้างกว่า ข้อความจะอยู่ตรงกลางโดยมีระยะขอบ ตารางและโค้ดที่กว้างจะเลื่อนในแนวนอนภายในกรอบของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir metin satırının en fazla genişliği, karakter cinsinden (30 ile 1000 arası). Daha geniş bir pencerede metin kenar boşluklarıyla ortada kalır. Geniş tablolar ve kod kendi kutularında yatay kaydırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найбільша ширина рядка тексту в символах (від 30 до 1000). У ширшому вікні текст залишається по центру з полями. Широкі таблиці й код прокручуються горизонтально у власному блоці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ rộng tối đa của một dòng văn bản, tính bằng ký tự (30 đến 1000). Trên cửa sổ rộng hơn, văn bản vẫn ở giữa với lề hai bên. Bảng và mã rộng cuộn ngang trong khung riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一行文本的最大宽度，以字符计（30 到 1000）。窗口更宽时，文本保持居中并留出边距。较宽的表格和代码在各自的框内横向滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行文字的最大寬度，以字元計（30 到 1000）。視窗更寬時，文字保持置中並留有邊界。較寬的表格與程式碼會在各自的框內橫向捲動。"
          }
        }
      }
    },
