        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anchos que recorre una columna, como fracciones del ancho visible de la tira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Largeurs parcourues par une colonne, en fractions de la largeur visible de la bande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Larghezze tra cui una colonna alterna, come frazioni della larghezza visibile della striscia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列が切り替える幅です。表示中のストリップ幅に対する割合で指定します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទទឹងដែលជួរឈរប្ដូរវិលជុំ ជាប្រភាគនៃទទឹងបន្ទះដែលមើលឃើញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "열이 순환하는 너비로, 보이는 스트립 너비에 대한 비율입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bredder en kolonne veksler mellom, som brøkdeler av den synlige bredden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szerokości, między którymi przełącza się kolumna, jako ułamki widocznej szerokości paska."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Larguras pelas quais uma coluna alterna, como frações da largura visível da faixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ширины, между которыми переключается столбец, в долях видимой ширины ленты."
          }
        },
        "th": {
          "stringUnit": {
