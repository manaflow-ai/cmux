    "settings.remote.ultra.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستهلك بيانات أكثر ليبقى سريعًا على الشبكات غير المستقرة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Troši više podataka da ostane brz na mrežama s gubicima"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger mere data for at forblive hurtig på ustabile netværk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbraucht mehr Daten, bleibt bei Paketverlust schnell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses more data to stay fast on lossy networks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa más datos para seguir rápido en redes con pérdidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise plus de données, reste rapide sur réseau instable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa più dati per restare veloce sulle reti con perdite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを多く使い、不安定なネットワークでも速さを保ちます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើទិន្នន័យច្រើនជាងមុន ដើម្បីនៅតែលឿននៅលើបណ្ដាញដែលបាត់កញ្ចប់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 더 사용해 손실이 많은 네트워크에서도 빠르게 유지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker mer data for å holde seg rask på ustabile nettverk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zużywa więcej danych, by działać szybko mimo utraty pakietów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa mais dados para continuar rápido em redes instáveis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходует больше данных ради скорости в сетях с потерями"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อมูลมากขึ้นเพื่อให้ยังเร็วบนเครือข่ายที่สัญญาณไม่เสถียร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıplı ağlarda hızlı kalmak için daha fazla veri kullanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрачає більше даних ради швидкості в мережах із втратами"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nhiều dữ liệu hơn để vẫn nhanh trên mạng chập chờn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用更多数据，在丢包的网络上保持快速"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用更多資料，在會掉封包的網路上保持快速"
          }
        }
      }
    },
