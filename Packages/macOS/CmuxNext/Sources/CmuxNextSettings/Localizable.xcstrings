    "settings.palette.aliases.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A word that names a command by its action id (\"vs\": \"splitRight\"). Typing the whole word in the command palette puts that command first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة تسمّي أمرًا بمعرّف إجرائه (\"vs\": \"splitRight\"). كتابة الكلمة كاملة في لوحة الأوامر تضع ذلك الأمر أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Riječ koja imenuje naredbu po ID-u njene radnje (\"vs\": \"splitRight\"). Kucanje cijele riječi u paleti naredbi stavlja tu naredbu na prvo mjesto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ord, der navngiver en kommando ud fra dens handlings-id (\"vs\": \"splitRight\"). Når hele ordet skrives i kommandopaletten, kommer den kommando først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wort, das einen Befehl über seine Aktions-ID benennt (\"vs\": \"splitRight\"). Wird das ganze Wort in der Befehlspalette eingegeben, steht dieser Befehl ganz oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palabra que nombra un comando por su ID de acción (\"vs\": \"splitRight\"). Al escribir la palabra completa en la paleta de comandos, ese comando aparece primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot qui désigne une commande par son identifiant d’action (\"vs\": \"splitRight\"). Taper le mot entier dans la palette de commandes place cette commande en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola che indica un comando tramite il suo ID azione (\"vs\": \"splitRight\"). Digitando la parola intera nella palette dei comandi, quel comando appare per primo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションIDでコマンドを指す単語です（\"vs\": \"splitRight\"）。コマンドパレットで単語全体を入力すると、そのコマンドが先頭に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យដែលដាក់ឈ្មោះពាក្យបញ្ជាតាមលេខសម្គាល់សកម្មភាពរបស់វា (\"vs\": \"splitRight\")។ ការវាយពាក្យទាំងមូលក្នុងផ្ទាំងពាក្យបញ្ជា ដាក់ពាក្យបញ្ជានោះនៅខាងដើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 ID로 명령을 가리키는 단어입니다(\"vs\": \"splitRight\"). 명령 팔레트에 단어 전체를 입력하면 그 명령이 맨 위에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ord som navngir en kommando etter handlings-ID-en (\"vs\": \"splitRight\"). Skriver du hele ordet i kommandopaletten, kommer den kommandoen først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowo, które nazywa polecenie przez identyfikator jego akcji (\"vs\": \"splitRight\"). Wpisanie całego słowa w palecie poleceń stawia to polecenie na początku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palavra que nomeia um comando pelo ID da ação (\"vs\": \"splitRight\"). Digitar a palavra inteira na paleta de comandos coloca esse comando em primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слово, которое называет команду по идентификатору её действия (\"vs\": \"splitRight\"). Если ввести слово целиком в палитре команд, эта команда окажется первой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำที่ใช้เรียกคำสั่งตามรหัสการทำงาน (\"vs\": \"splitRight\") การพิมพ์คำนั้นเต็มคำในแผงคำสั่งจะทำให้คำสั่งนั้นขึ้นเป็นอันดับแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komutu eylem kimliğiyle adlandıran sözcük (\"vs\": \"splitRight\"). Sözcüğün tamamını komut paletine yazmak o komutu en üste getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слово, що називає команду за ідентифікатором її дії (\"vs\": \"splitRight\"). Якщо ввести слово повністю в палітрі команд, ця команда буде першою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một từ đặt tên cho lệnh theo ID hành động của nó (\"vs\": \"splitRight\"). Gõ toàn bộ từ trong bảng lệnh sẽ đưa lệnh đó lên đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过操作 ID 指代命令的词（\"vs\": \"splitRight\"）。在命令面板中输入完整的词会将该命令排在最前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以動作 ID 指稱指令的詞（\"vs\": \"splitRight\"）。在指令面板中輸入完整的詞，會將該指令排在最前面。"
          }
        }
      }
    },
