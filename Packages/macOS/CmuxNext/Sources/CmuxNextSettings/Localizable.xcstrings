    "settings.tabs.overflow.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink narrows every tab to the minimum width before the strip scrolls. Scroll keeps tabs wide and scrolls sooner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التقليص يضيّق كل علامات التبويب إلى الحد الأدنى للعرض قبل أن يتمرر الشريط. التمرير يبقي علامات التبويب عريضة ويتمرر أبكر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sužavanje sužava sve kartice do minimalne širine prije nego što se traka počne pomicati. Pomicanje drži kartice širokima i pomiče se ranije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Formindsk gør alle faner smallere ned til minimumsbredden, før bjælken ruller. Rul holder fanerne brede og ruller tidligere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verkleinern macht alle Tabs bis zur Mindestbreite schmaler, bevor die Leiste scrollt. Scrollen hält Tabs breit und scrollt früher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reducir estrecha todas las pestañas hasta el ancho mínimo antes de que la barra se desplace. Desplazar mantiene las pestañas anchas y se desplaza antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réduire rétrécit chaque onglet jusqu’à la largeur minimale avant que la barre ne défile. Défiler garde les onglets larges et défile plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restringi riduce ogni scheda fino alla larghezza minima prima che la barra scorra. Scorri mantiene le schede larghe e scorre prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「縮小」では、タブバーがスクロールする前にすべてのタブが最小幅まで縮みます。「スクロール」ではタブの幅を保ち、早めにスクロールします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្រួម ធ្វើឲ្យផ្ទាំងទាំងអស់តូចដល់ទទឹងអប្បបរមា មុនពេលរបាររមូរ។ រមូរ រក្សាផ្ទាំងឲ្យធំ ហើយរមូរលឿនជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "축소는 탭 바가 스크롤되기 전에 모든 탭을 최소 너비까지 줄입니다. 스크롤은 탭 너비를 유지하고 더 일찍 스크롤합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krymp gjør alle faner smalere ned til minstebredden før linjen ruller. Rull holder fanene brede og ruller tidligere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmniejszanie zwęża każdą kartę do minimalnej szerokości, zanim pasek zacznie się przewijać. Przewijanie zachowuje szerokie karty i przewija wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encolher estreita todas as abas até a largura mínima antes de a barra rolar. Rolar mantém as abas largas e rola mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сжатие сужает все вкладки до минимальной ширины, прежде чем панель начнёт прокручиваться. Прокрутка сохраняет вкладки широкими и прокручивает раньше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ย่อ จะทำให้ทุกแท็บแคบลงจนถึงความกว้างต่ำสุดก่อนแถบจะเลื่อน เลื่อน จะคงแท็บให้กว้างและเลื่อนเร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daralt, şerit kaymadan önce her sekmeyi en küçük genişliğe kadar daraltır. Kaydır, sekmeleri geniş tutar ve daha erken kayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стискання звужує всі вкладки до мінімальної ширини, перш ніж панель почне прокручуватися. Прокручування зберігає вкладки широкими й прокручує раніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thu nhỏ làm mọi thẻ hẹp lại đến độ rộng tối thiểu trước khi thanh cuộn. Cuộn giữ thẻ rộng và cuộn sớm hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“缩小”会先把每个标签页缩到最小宽度，然后标签栏才滚动。“滚动”让标签页保持宽度，并更早开始滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「縮小」會先把每個分頁縮到最小寬度，然後分頁列才捲動。「捲動」讓分頁保持寬度，並更早開始捲動。"
          }
        }
      }
    },
