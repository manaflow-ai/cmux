          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutter uten seere før en agents deling slås av"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuty bez widzów do wyłączenia udostępniania agenta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos sem público até desligar o que o agente compartilhou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минуты без зрителей до выключения доступа от агента"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนนาทีที่ไม่มีผู้ดูก่อนการแชร์ของเอเจนต์จะปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ajanın paylaşımı kapanmadan önce izleyensiz dakika"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвилини без глядачів до вимкнення доступу від агента"
