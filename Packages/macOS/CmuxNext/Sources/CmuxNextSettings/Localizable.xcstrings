    "settings.agentPane.display.promptCoach.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a chat with many corrections, shows a better first prompt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بعد محادثة احتاجت إلى تصحيحات كثيرة، يعرض طلبًا أولًا أفضل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nakon razgovora s mnogo ispravki, pokazuje bolji prvi upit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Efter en chat med mange rettelser vises en bedre første prompt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt nach einem Chat mit vielen Korrekturen einen besseren ersten Prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tras un chat con muchas correcciones, muestra un primer prompt mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après une discussion avec beaucoup de corrections, montre un meilleur premier prompt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopo una chat con molte correzioni, mostra un primo prompt migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "何度も修正が必要だったチャットのあとに、より良い最初のプロンプトを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ទាប់ពីការជជែកដែលមានការកែតម្រូវច្រើន បង្ហាញប្រអប់បញ្ចូលដំបូងដែលល្អជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여러 번 고쳐야 했던 채팅이 끝나면 더 나은 첫 프롬프트를 보여줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etter en chat med mange rettelser vises en bedre første ledetekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po czacie z wieloma poprawkami pokazuje lepszy pierwszy prompt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois de um chat com muitas correções, mostra um primeiro prompt melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "После чата с множеством исправлений показывает более удачный первый запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หลังจากแชตที่ต้องแก้ไขหลายครั้ง จะแสดงพรอมต์แรกที่ดีกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çok sayıda düzeltme gerektiren bir sohbetten sonra daha iyi bir ilk istem gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Після чату з багатьма виправленнями показує кращий перший запит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sau một cuộc trò chuyện cần sửa nhiều lần, cho thấy một lời nhắc đầu tiên tốt hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在需要多次修正的对话之后，显示更好的第一条提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在需要多次修正的對話之後，顯示更好的第一則提示詞。"
          }
        }
      }
    },
