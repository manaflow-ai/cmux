    "settings.markdown.fullWidth.help": {
      "comment": "Settings help for Full Width",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text fills the whole pane instead of the text width."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يملأ النص اللوحة كلها بدلًا من عرض النص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst ispunjava cijelo okno umjesto širine teksta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten fylder hele ruden i stedet for tekstbredden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text füllt den ganzen Bereich statt der Textbreite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto ocupa todo el panel en lugar del ancho del texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte remplit toute la sous-fenêtre au lieu de la largeur du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo riempie l’intero riquadro invece della larghezza del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの幅ではなく、ペイン全体に表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទពេញផ្ទាំងទាំងមូល ជំនួសឱ្យទទឹងអត្ថបទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 너비 대신 창 전체를 채웁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten fyller hele ruten i stedet for tekstbredden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst wypełnia cały panel zamiast szerokości tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto preenche todo o painel em vez da largura do texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст занимает всю панель, а не ширину текста."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความเต็มแผงทั้งหมดแทนความกว้างข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin, metin genişliği yerine tüm bölmeyi doldurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст займає всю панель, а не ширину тексту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản lấp đầy toàn bộ ô thay vì độ rộng văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本填满整个面板，而不是使用文本宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字填滿整個面板，而非使用文字寬度。"
          }
        }
      }
    },
