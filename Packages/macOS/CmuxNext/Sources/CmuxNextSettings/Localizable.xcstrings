    "settings.tabs.newTabWidgets.greeting": {
      "comment": "Settings: toggle that shows a headline over the New Tab page's composer asking what to work on, with the project as an inline picker.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السؤال عمّا نعمل عليه في علامة التبويب الجديدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitaj na čemu radimo na novoj kartici"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg, hvad vi skal arbejde på, på ny fane"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im neuen Tab fragen, woran wir arbeiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask What to Work On on New Tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar en qué trabajar en la nueva pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander sur quoi travailler dans le nouvel onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi su cosa lavorare nella nuova scheda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブで取り組む内容を尋ねる"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរថាត្រូវធ្វើការលើអ្វីនៅលើផ្ទាំងថ្មី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 탭에서 무엇을 작업할지 묻기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør hva vi skal jobbe med på ny fane"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj, nad czym pracujemy, na nowej karcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar no que trabalhar na nova aba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивать, над чем работаем, на новой вкладке"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามว่าจะทำงานอะไรบนแท็บใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sekmede ne üzerinde çalışacağımızı sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Питати, над чим працюємо, на новій вкладці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi sẽ làm gì trên thẻ mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签页询问要做什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁詢問要做什麼"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.greeting.help": {
      "comment": "Settings: help for the toggle that shows a headline over the New Tab page's composer asking what to work on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان فوق محرر الرسائل يسأل عمّا نعمل عليه، مع المشروع كأداة اختيار."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov iznad polja za unos koji pita na čemu radimo, s projektom kao biračem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En overskrift over skrivefeltet, der spørger, hvad vi skal arbejde på, med projektet som vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Überschrift über dem Eingabefeld, die fragt, woran wir arbeiten, mit dem Projekt als Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A headline over the composer that asks what to work on, with the project as a picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titular sobre el editor que pregunta en qué trabajar, con el proyecto como selector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titre au-dessus de la zone de saisie qui demande sur quoi travailler, avec le projet comme sélecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titolo sopra il campo di composizione che chiede su cosa lavorare, con il progetto come selettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーザーの上に、何に取り組むかを尋ねる見出しを表示します。プロジェクトはその場で選べます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងនៅពីលើប្រអប់សរសេរ ដែលសួរថាត្រូវធ្វើការលើអ្វី ដោយមានគម្រោងជាអ្នកជ្រើសរើស។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성기 위에 무엇을 작업할지 묻는 제목을 표시하며, 프로젝트를 바로 고를 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En overskrift over skrivefeltet som spør hva vi skal jobbe med, med prosjektet som velger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagłówek nad polem tekstowym, który pyta, nad czym pracujemy, z projektem do wybrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um título acima do editor que pergunta no que trabalhar, com o projeto como seletor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок над полем ввода, который спрашивает, над чем работаем, с выбором проекта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หัวข้อเหนือช่องเขียนข้อความที่ถามว่าจะทำงานอะไร พร้อมตัวเลือกโปรเจกต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturucunun üstünde ne üzerinde çalışacağımızı soran bir başlık; proje bir seçici olarak gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок над полем введення, який питає, над чим працюємо, з вибором проєкту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tiêu đề phía trên ô soạn thảo hỏi sẽ làm gì, với dự án là một bộ chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框上方显示询问要做什么的标题，项目可直接选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框上方顯示詢問要做什麼的標題，專案可直接選擇。"
          }
        }
      }
    },
