    "settings.sidebar.density.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى الصفوف المريحة في سطر واحد، لكنها أطول وحولها مساحة أكبر. تعرض الصفوف الموسَّعة حالة كل مساحة عمل أو مجلدها تحت اسمها، ومتى تغيّرت آخر مرة، وطلب السحب والكمبيوتر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prostrani redovi ostaju u jednom redu, ali su viši i imaju više prostora oko sebe. Prošireni redovi prikazuju status ili mapu svakog radnog prostora ispod naziva, prije koliko vremena se promijenio te pull request i računar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luftige rækker holder sig på én linje, men er højere og har mere plads omkring sig. Udvidede rækker viser hvert arbejdsområdes status eller mappe under navnet, hvor længe siden det blev ændret, samt pull request og computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Großzügige Zeilen bleiben einzeilig, sind aber höher und haben mehr Abstand. Erweiterte Zeilen zeigen unter dem Namen den Status oder Ordner jedes Arbeitsbereichs, wie lange die letzte Änderung her ist, sowie Pull Request und Computer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfortable rows keep one line on taller rows with more space around them. Expanded rows show each workspace's status or folder under its name, how long ago it changed, and its pull request and computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las filas cómodas siguen en una línea, pero son más altas y tienen más espacio alrededor. Las filas ampliadas muestran bajo el nombre el estado o la carpeta de cada espacio de trabajo, cuánto hace que cambió, y su pull request y ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les lignes confortables restent sur une ligne, mais sont plus hautes et plus aérées. Les lignes étendues affichent sous le nom l’état ou le dossier de chaque espace de travail, depuis quand il a changé, ainsi que sa pull request et son ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le righe comode restano su una riga, ma sono più alte e con più spazio intorno. Le righe estese mostrano sotto il nome lo stato o la cartella di ogni area di lavoro, da quanto tempo è cambiata, la pull request e il computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ゆったり表示では、1 行のまま行の高さと余白を広げます。拡張表示では、各ワークスペースの名前の下にステータスまたはフォルダ、最終変更からの経過時間、プルリクエストとコンピュータを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជួរធូរនៅតែមួយបន្ទាត់ ប៉ុន្តែខ្ពស់ជាង និងមានចន្លោះច្រើនជាងនៅជុំវិញ។ ជួរដែលពង្រីកបង្ហាញស្ថានភាព ឬថតនៃកន្លែងធ្វើការនីមួយៗនៅក្រោមឈ្មោះ រយៈពេលតាំងពីវាផ្លាស់ប្តូរ និង pull request និងកុំព្យូទ័រ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "넉넉한 행은 한 줄을 유지하면서 높이와 주변 여백이 더 큽니다. 확장 행은 각 작업 공간의 이름 아래에 상태 또는 폴더, 마지막 변경 이후 경과 시간, 풀 리퀘스트와 컴퓨터를 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luftige rader holder seg på én linje, men er høyere og har mer plass rundt seg. Utvidede rader viser status eller mappe for hvert arbeidsområde under navnet, hvor lenge siden det ble endret, og pull request og datamaskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przestronne wiersze zostają w jednej linii, ale są wyższe i mają więcej miejsca wokół. Rozszerzone wiersze pokazują pod nazwą stan lub folder każdego obszaru roboczego, jak dawno się zmienił oraz pull request i komputer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linhas confortáveis continuam em uma linha, mas são mais altas e têm mais espaço ao redor. Linhas expandidas mostram abaixo do nome o status ou a pasta de cada espaço de trabalho, há quanto tempo mudou, e o pull request e o computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свободные строки остаются в одну строку, но они выше и с большими отступами. Развёрнутые строки показывают под названием статус или папку каждого рабочего пространства, как давно оно менялось, а также pull request и компьютер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถวแบบกว้างขวางยังคงเป็นบรรทัดเดียว แต่สูงขึ้นและมีระยะห่างรอบๆ มากขึ้น แถวแบบขยายจะแสดงสถานะหรือโฟลเดอร์ของแต่ละพื้นที่ทำงานใต้ชื่อ เวลาที่เปลี่ยนแปลงล่าสุด รวมถึงพูลรีเควสต์และคอมพิวเตอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rahat satırlar tek satırda kalır, ancak daha yüksektir ve çevrelerinde daha fazla boşluk vardır. Genişletilmiş satırlar, her çalışma alanının adının altında durumunu veya klasörünü, ne kadar önce değiştiğini, pull request'ini ve bilgisayarını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Просторі рядки залишаються в один рядок, але вищі й мають більше місця навколо. Розгорнуті рядки показують під назвою стан або теку кожного робочого простору, як давно він змінювався, а також pull request і комп’ютер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hàng thoáng vẫn giữ một dòng nhưng cao hơn và có nhiều khoảng trống xung quanh hơn. Hàng mở rộng hiển thị dưới tên trạng thái hoặc thư mục của mỗi không gian làm việc, thời gian kể từ lần thay đổi gần nhất, cùng pull request và máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "宽松的行仍为单行，但行高更高、四周留白更多。展开的行会在名称下方显示每个工作区的状态或文件夹、距上次更改的时间，以及拉取请求和电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "寬鬆的列仍為單行，但列高更高、四周留白更多。展開的列會在名稱下方顯示每個工作區的狀態或資料夾、距上次變更的時間，以及提取要求和電腦。"
          }
        }
      }
    },
