    "settings.browser.passwords.allowExport.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Passwords page can export every password to a plain-text CSV, after Touch ID."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لصفحة كلمات السر تصدير كل كلمات السر إلى ملف CSV بنص عادي، بعد Touch ID."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranica Lozinke može izvesti sve lozinke u CSV s običnim tekstom, nakon potvrde putem Touch ID."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden Adgangskoder kan eksportere alle adgangskoder til en CSV i almindelig tekst efter Touch ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Seite „Passwörter“ kann nach Touch ID alle Passwörter in eine CSV-Datei im Klartext exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La página Contraseñas puede exportar todas las contraseñas a un CSV de texto sin formato, tras Touch ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La page Mots de passe peut exporter tous les mots de passe dans un CSV en texte brut, après Touch ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pagina Password può esportare tutte le password in un CSV in testo semplice, dopo Touch ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touch ID で確認した後、パスワードページがすべてのパスワードをプレーンテキストの CSV に書き出せます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រពាក្យសម្ងាត់អាចនាំចេញពាក្យសម្ងាត់ទាំងអស់ទៅ CSV អត្ថបទធម្មតា បន្ទាប់ពី Touch ID។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touch ID로 확인한 후 비밀번호 페이지에서 모든 비밀번호를 일반 텍스트 CSV로 내보낼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passord-siden kan eksportere alle passord til en CSV i ren tekst, etter Touch ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strona Hasła może wyeksportować wszystkie hasła do pliku CSV jako zwykły tekst, po Touch ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A página Senhas pode exportar todas as senhas para um CSV de texto simples, após o Touch ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страница «Пароли» может экспортировать все пароли в CSV-файл открытым текстом после Touch ID."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้ารหัสผ่านส่งออกรหัสผ่านทั้งหมดเป็นไฟล์ CSV แบบข้อความธรรมดาได้ หลังยืนยันด้วย Touch ID"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parolalar sayfası, Touch ID sonrasında tüm parolaları düz metin bir CSV dosyasına aktarabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
