    "settings.appearance.accent.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color of selection, focus and the Send button. Theme Color takes the theme's own hue, such as Rose Pine's iris."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون التحديد والتركيز وزر الإرسال. يأخذ «لون السمة» تدرّج السمة نفسها، مثل لون السوسن في Rose Pine."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Boja odabira, fokusa i dugmeta Pošalji. Boja teme koristi nijansu same teme, poput perunike u temi Rose Pine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farven på markering, fokus og knappen Send. Temafarve bruger temaets egen farvetone, som Rose Pines iris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe von Auswahl, Fokus und der Schaltfläche „Senden“. „Themenfarbe“ übernimmt den eigenen Farbton des Themas, etwa das Iris von Rose Pine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de la selección, el foco y el botón Enviar. Color del tema usa el tono propio del tema, como el iris de Rose Pine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur de la sélection, du focus et du bouton Envoyer. Couleur du thème reprend la teinte propre au thème, comme l'iris de Rose Pine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore di selezione, focus e pulsante Invia. Colore del tema usa la tonalità propria del tema, come l'iris di Rose Pine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択、フォーカス、送信ボタンの色です。「テーマカラー」は Rose Pine のアイリスのように、テーマ固有の色相を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពណ៌នៃការជ្រើសរើស ការផ្ដោត និងប៊ូតុងផ្ញើ។ ពណ៌រចនាប័ទ្មយកពណ៌ផ្ទាល់របស់រចនាប័ទ្ម ដូចជាពណ៌ iris របស់ Rose Pine។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택, 포커스, 보내기 버튼의 색상입니다. 테마 색상은 Rose Pine의 아이리스처럼 테마 고유의 색조를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fargen på markering, fokus og Send-knappen. Temafarge bruker temaets egen fargetone, som irisfargen i Rose Pine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor zaznaczenia, fokusu i przycisku Wyślij. Kolor motywu używa własnego odcienia motywu, np. irysowego z Rose Pine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor da seleção, do foco e do botão Enviar. Cor do Tema usa o tom próprio do tema, como o íris do Rose Pine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет выделения, фокуса и кнопки «Отправить». «Цвет темы» берёт собственный оттенок темы, например ирисовый в Rose Pine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีของการเลือก โฟกัส และปุ่มส่ง สีธีมใช้เฉดสีของธีมเอง เช่น สีไอริสของ Rose Pine"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim, odak ve Gönder düğmesinin rengi. Tema Rengi, Rose Pine'ın iris rengi gibi temanın kendi tonunu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колір виділення, фокуса й кнопки «Надіслати». «Колір теми» бере власний відтінок теми, як-от ірисовий у Rose Pine."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu của vùng chọn, tiêu điểm và nút Gửi. Màu chủ đề dùng sắc độ riêng của chủ đề, như màu diên vĩ của Rose Pine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中、焦点和发送按钮的颜色。“主题色”使用主题自身的色调，例如 Rose Pine 的鸢尾紫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取、焦點與傳送按鈕的顏色。「主題色」使用主題本身的色調，例如 Rose Pine 的鳶尾紫。"
          }
        }
      }
    },
