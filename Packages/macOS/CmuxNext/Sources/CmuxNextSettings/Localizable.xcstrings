            "value": "រំកិលទៅបាតពេលខ្ញុំផ្ញើ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rull til bunnen når jeg sender"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przewiń na dół podczas wysyłania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rolar para o fim ao enviar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прокручивать вниз при отправке"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลื่อนไปด้านล่างเมื่อส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderdiğimde alta kaydır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прокручувати донизу під час надсилання"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuộn xuống cuối khi tôi gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发送时滚动到底部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "傳送時捲動到底部"
          }
        }
      }
    },
    "settings.agentPane.scrollToBottomOnSend.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند إيقافه، يحافظ الإرسال على موضعك أثناء القراءة إلى الأعلى ويعرض الرسائل الجديدة أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn deaktiviert, bleibt beim Senden beim Lesen weiter oben deine Position erhalten und neue Nachrichten erscheinen darunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When off, sending while you are reading up keeps your place and shows new messages below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado, al enviar se conserva tu posición mientras lees más arriba y se muestran debajo los mensajes nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé, l’envoi conserve votre position quand vous lisez plus haut et affiche les nouveaux messages en dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフにすると、上を読んでいる間に送信しても位置を維持し、新しいメッセージを下に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끄면 위쪽을 읽는 동안 메시지를 보내도 현재 위치가 유지되고 새 메시지가 아래에 표시됩니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada je isključeno, slanje dok čitate iznad zadržava vaš položaj i prikazuje nove poruke ispod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når den er slået fra, bevarer afsendelse din placering, mens du læser oppe, og viser nye beskeder nedenunder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se disattivato, l'invio mentre leggi più in alto mantiene la tua posizione e mostra i nuovi messaggi sotto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅពេលបិទ ការផ្ញើពេលអ្នកកំពុងអានខាងលើនឹងរក្សាទីតាំងរបស់អ្នក ហើយបង្ហាញសារថ្មីខាងក្រោម។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når den er av, beholder sending plasseringen mens du leser oppover, og nye meldinger vises nedenfor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po wyłączeniu wysłanie wiadomości podczas czytania wyżej zachowuje pozycję i pokazuje nowe wiadomości poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando desativado, enviar enquanto você lê acima mantém sua posição e mostra novas mensagens abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если выключено, отправка во время чтения выше сохраняет позицию и показывает новые сообщения ниже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อปิด การส่งข้อความขณะอ่านด้านบนจะรักษาตำแหน่งของคุณและแสดงข้อความใหม่ด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalıyken, yukarıda okurken gönderim konumunuzu korur ve yeni mesajları aşağıda gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо вимкнено, надсилання під час читання вище зберігає позицію та показує нові повідомлення нижче."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi tắt, gửi tin nhắn khi đang đọc ở trên sẽ giữ nguyên vị trí và hiển thị tin nhắn mới bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭时，在向上阅读时发送消息会保留当前位置，并在下方显示新消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉時，在向上閱讀期間傳送訊息會保留目前位置，並在下方顯示新訊息。"
          }
        }
      }
    },
