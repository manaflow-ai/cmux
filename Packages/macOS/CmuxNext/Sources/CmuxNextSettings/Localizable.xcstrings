    "settings.agentPane.display.finishSound.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft sound when a long turn ends, its checks pass or its pull request merges."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صوت هادئ عند انتهاء دور طويل، أو نجاح فحوصاته، أو دمج طلب السحب الخاص به."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tihi zvuk kad se završi dug potez, kad njegove provjere prođu ili kad se njegov pull request spoji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En blød lyd, når en lang tur slutter, dens tjek består, eller dens pull request bliver flettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein leiser Ton, wenn ein langer Durchgang endet, seine Checks bestehen oder sein Pull Request gemergt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un sonido suave cuando termina un turno largo, pasan sus comprobaciones o se fusiona su pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un son discret quand un long tour se termine, que ses vérifications réussissent ou que sa pull request est fusionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un suono leggero quando finisce un turno lungo, i suoi controlli passano o la sua pull request viene unita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "長いターンが終わったとき、チェックが通ったとき、プルリクエストがマージされたときに控えめな音を鳴らします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំឡេងស្រាលពេលវេនវែងបញ្ចប់ ការត្រួតពិនិត្យរបស់វាឆ្លងកាត់ ឬ pull request របស់វាត្រូវបានបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "긴 턴이 끝나거나, 검사가 통과하거나, 풀 리퀘스트가 병합되면 부드러운 소리를 냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En myk lyd når en lang runde slutter, sjekkene består eller pull requesten flettes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cichy dźwięk, gdy kończy się długa tura, jej testy przechodzą lub jej pull request zostaje scalony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um som suave quando um turno longo termina, as verificações passam ou o pull request é mesclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тихий звук, когда заканчивается долгий ход, проходят его проверки или сливается его pull request."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เสียงเบา ๆ เมื่อรอบที่ยาวจบลง การตรวจสอบผ่าน หรือ pull request ถูกรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzun bir tur bittiğinde, denetimleri geçtiğinde veya pull request'i birleştirildiğinde yumuşak bir ses."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тихий звук, коли закінчується довгий хід, проходять перевірки або зливається його pull request."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một âm thanh nhẹ khi một lượt dài kết thúc, các kiểm tra đạt hoặc pull request được hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "长回合结束、检查通过或拉取请求合并时，播放一声轻柔的提示音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "長回合結束、檢查通過或提取要求合併時，播放一聲輕柔的提示音。"
          }
        }
      }
    },
