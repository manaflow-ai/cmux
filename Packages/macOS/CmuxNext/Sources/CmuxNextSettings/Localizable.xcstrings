    "settings.markdown.paragraphSpacing.help": {
      "comment": "Settings help for Paragraph Spacing",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gap after each paragraph, as a share of the text size."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسافة بعد كل فقرة، كنسبة من حجم النص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razmak nakon svakog pasusa, kao udio veličine teksta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afstanden efter hvert afsnit som en andel af tekststørrelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abstand nach jedem Absatz als Anteil der Textgröße."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio tras cada párrafo, como proporción del tamaño del texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace après chaque paragraphe, en proportion de la taille du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio dopo ogni paragrafo, in proporzione alla dimensione del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各段落の後の間隔（文字サイズに対する割合）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គម្លាតបន្ទាប់ពីកថាខណ្ឌនីមួយៗ ជាចំណែកនៃទំហំអត្ថបទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단락 뒤의 간격으로, 텍스트 크기에 대한 비율입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstanden etter hvert avsnitt som en andel av tekststørrelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstęp po każdym akapicie jako część rozmiaru tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço após cada parágrafo, como proporção do tamanho do texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отступ после каждого абзаца в долях размера текста."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะห่างหลังแต่ละย่อหน้า เป็นสัดส่วนของขนาดข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her paragraftan sonraki boşluk, metin boyutunun oranı olarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відступ після кожного абзацу в частках розміру тексту."
