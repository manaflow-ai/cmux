    "settings.appearance.colorTransition.springResponse.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seconds a spring color change takes to reach its new colors."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الثواني التي يستغرقها تغيير الألوان بالنابض للوصول إلى الألوان الجديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekunde koje promjeni boja s oprugom trebaju da dođe do novih boja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekunder et fjederfarveskift tager om at nå de nye farver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekunden, die ein Feder-Farbwechsel bis zu den neuen Farben braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundos que tarda un cambio de color con resorte en llegar a los colores nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondes qu’un changement de couleur à ressort met pour atteindre les nouvelles couleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondi che un cambio di colore a molla impiega per arrivare ai nuovi colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スプリングでの色の変化が新しい色に届くまでの秒数。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំនួនវិនាទីដែលការប្ដូរពណ៌បែបរ៉ឺស័រត្រូវការដើម្បីដល់ពណ៌ថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프링 색상 변경이 새 색에 도달하는 데 걸리는 초입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekunder en fjærfargeendring bruker på å nå de nye fargene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekundy, w których zmiana kolorów ze sprężyną dochodzi do nowych kolorów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundos que uma mudança de cor com mola leva para chegar às novas cores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секунды, за которые смена цветов с пружиной доходит до новых цветов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนวินาทีที่การเปลี่ยนสีแบบสปริงใช้เพื่อไปถึงสีใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaylı renk değişikliğinin yeni renklere ulaşma süresi (saniye)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секунди, за які зміна кольорів із пружиною доходить до нових кольорів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số giây để lần đổi màu kiểu lò xo đạt tới màu mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹簧式颜色变化到达新颜色所需的秒数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈簧式顏色變化到達新顏色所需的秒數。"
          }
        }
      }
    },
