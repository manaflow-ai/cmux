    "settings.layout.pagesHandleCommandScroll.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages like Figma keep Command + Scroll. Off, it always moves columns."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحتفظ صفحات مثل Figma بـ Command + Scroll. عند الإيقاف، ينقل الأعمدة دائمًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranice poput Figme zadržavaju Command + Scroll. Isključeno: uvijek pomiče kolone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sider som Figma beholder Command + Scroll. Slået fra flytter det altid kolonner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seiten wie Figma behalten Command + Scroll. Aus: Es verschiebt immer die Spalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Páginas como Figma conservan Command + Scroll. Desactivado, siempre mueve las columnas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les pages comme Figma gardent Command + Scroll. Désactivé, il déplace toujours les colonnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pagine come Figma mantengono Command + Scroll. Se disattivato, sposta sempre le colonne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Figma などのページは Command + Scroll を受け取ります。オフにすると、常に列を移動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រដូចជា Figma រក្សា Command + Scroll។ ពេលបិទ វាតែងតែផ្លាស់ទីជួរឈរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Figma 같은 페이지는 Command + Scroll을 유지합니다. 끄면 항상 열을 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sider som Figma beholder Command + Scroll. Av: det flytter alltid kolonner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strony takie jak Figma zachowują Command + przewijanie. Wyłączone: zawsze przesuwa kolumny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Páginas como o Figma mantêm Command + Scroll. Desativado, ele sempre move as colunas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страницы вроде Figma сохраняют Command + Scroll. Если выключено, Command + Scroll всегда перемещает колонки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าอย่าง Figma จะได้รับ Command + Scroll ไว้ เมื่อปิด จะย้ายคอลัมน์เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Figma gibi sayfalar Command + kaydırmayı korur. Kapalıyken her zaman sütunları taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сторінки на кшталт Figma зберігають Command + прокручування. Якщо вимкнено, воно завжди переміщує колонки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trang như Figma giữ Command + Scroll. Khi tắt, thao tác này luôn di chuyển các cột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Figma 等网页会保留 Command + Scroll。关闭后始终移动列。"
