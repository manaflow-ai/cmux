          "stringUnit": {
            "state": "needs_review",
            "value": "Si la barra de pestañas va sobre o bajo la barra de direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si la barre d’onglets se trouve au-dessus ou en dessous de la barre d’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se la barra delle schede sta sopra o sotto la barra degli indirizzi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ថាតើរបារផ្ទាំងនៅលើ ឬនៅក្រោមរបារអាសយដ្ឋាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 막대를 주소 막대 위 또는 아래에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om fanelinjen står over eller under adresselinjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czy pasek kart jest nad paskiem adresu, czy pod nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se a barra de abas fica acima ou abaixo da barra de endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Где панель вкладок: над адресной строкой или под ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบแท็บอยู่เหนือหรือใต้แถบที่อยู่"
          }
        },
        "tr": {
          "stringUnit": {
