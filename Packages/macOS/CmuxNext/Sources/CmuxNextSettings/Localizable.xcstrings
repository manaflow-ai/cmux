        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងដែលទទួលការផ្ដោត នៅពេលផ្ទាំងដែលកំពុងផ្ដោតត្រូវបានបិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포커스된 패널이 닫힐 때 포커스를 받을 패널입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvilken rute som får fokus når den fokuserte ruten lukkes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Który panel otrzymuje fokus po zamknięciu aktywnego panelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qual painel recebe o foco quando o painel em foco é fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Какая панель получает фокус, когда закрывается активная."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บานหน้าต่างที่จะได้รับโฟกัสเมื่อบานที่โฟกัสอยู่ถูกปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
