    "settings.palette.pins.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands shown first when the command palette opens, in this order, by action id."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأوامر التي تظهر أولًا عند فتح لوحة الأوامر، بهذا الترتيب، حسب معرّف الإجراء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naredbe prikazane prve kada se otvori paleta naredbi, ovim redom, po ID-u radnje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoer, der vises først, når kommandopaletten åbnes, i denne rækkefølge, efter handlings-id."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle, die beim Öffnen der Befehlspalette zuerst erscheinen, in dieser Reihenfolge, nach Aktions-ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos que aparecen primero al abrir la paleta de comandos, en este orden, por ID de acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandes affichées en premier à l’ouverture de la palette de commandes, dans cet ordre, par identifiant d’action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandi mostrati per primi all’apertura della palette dei comandi, in quest’ordine, per ID azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドパレットを開いたときに最初に表示するコマンド（この順序、アクションIDで指定）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យបញ្ជាដែលបង្ហាញមុនគេនៅពេលបើកផ្ទាំងពាក្យបញ្ជា តាមលំដាប់នេះ តាមលេខសម្គាល់សកម្មភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 팔레트를 열 때 이 순서대로 먼저 표시할 명령(작업 ID)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoer som vises først når kommandopaletten åpnes, i denne rekkefølgen, etter handlings-ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenia wyświetlane jako pierwsze po otwarciu palety poleceń, w tej kolejności, według identyfikatora akcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos mostrados primeiro quando a paleta de comandos abre, nesta ordem, por ID da ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды, которые показываются первыми при открытии палитры команд, в этом порядке, по идентификатору действия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งที่แสดงก่อนเมื่อเปิดแผงคำสั่ง ตามลำดับนี้ ตามรหัสการทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut paleti açıldığında ilk gösterilen komutlar, bu sırayla, eylem kimliğine göre."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команди, які показуються першими під час відкриття палітри команд, у цьому порядку, за ідентифікатором дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lệnh hiển thị đầu tiên khi mở bảng lệnh, theo thứ tự này, theo ID hành động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开命令面板时最先显示的命令，按此顺序，以操作 ID 指定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟指令面板時最先顯示的指令，依此順序，以動作 ID 指定。"
          }
        }
      }
    },
