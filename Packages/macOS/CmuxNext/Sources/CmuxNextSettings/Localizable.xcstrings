          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un archivo de tema en ~/.config/cmux/themes, como \"tokyo\" para tokyo.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
