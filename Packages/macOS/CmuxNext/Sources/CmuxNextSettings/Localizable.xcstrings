          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds per workspace id. Set one from the workspace's sidebar menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sonidos por id de espacio de trabajo. Configúralos desde su menú en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
