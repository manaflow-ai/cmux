        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าแท็บใหม่แบบเนทีฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel Yeni Sekme Sayfası"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативна сторінка нової вкладки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang thẻ mới gốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生新标签页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生新分頁頁面"
          }
        }
      }
    },
    "settings.tabs.nativeNewTabPage.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T and the + button open the native New Tab page instead of the web one. It opens faster and lists every command palette action as you type. Recent chats and widgets are only on the web page for now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Cmd-T وزر + صفحة علامة التبويب الجديدة الأصلية بدلاً من صفحة الويب. تفتح أسرع وتعرض كل إجراءات لوحة الأوامر أثناء الكتابة. المحادثات الأخيرة والأدوات متاحة في صفحة الويب فقط حالياً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T i dugme + otvaraju izvornu stranicu nove kartice umjesto web stranice. Otvara se brže i dok kucate prikazuje sve radnje palete naredbi. Nedavni razgovori i widgeti zasad su samo na web stranici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T og knappen + åbner den indbyggede ny fane-side i stedet for websiden. Den åbner hurtigere og viser alle handlinger fra kommandopaletten, mens du skriver. Seneste chats og widgets findes indtil videre kun på websiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T und die Taste + öffnen die native Seite „Neuer Tab“ statt der Webseite. Sie öffnet schneller und zeigt beim Tippen jede Aktion der Befehlspalette. Letzte Chats und Widgets gibt es vorerst nur auf der Webseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T y el botón + abren la página nativa de nueva pestaña en lugar de la web. Se abre más rápido y muestra todas las acciones de la paleta de comandos mientras escribes. Los chats recientes y los widgets solo están en la página web por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T et le bouton + ouvrent la page Nouvel onglet native au lieu de la page web. Elle s’ouvre plus vite et liste toutes les actions de la palette de commandes pendant la saisie. Les discussions récentes et les widgets restent pour l’instant sur la page web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T e il pulsante + aprono la pagina Nuova scheda nativa invece di quella web. Si apre più velocemente e mostra ogni azione della palette dei comandi mentre scrivi. Chat recenti e widget sono per ora solo nella pagina web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T と + ボタンで、Web 版の代わりにネイティブの新規タブページを開きます。より速く開き、入力中にコマンドパレットのすべてのアクションを表示します。最近のチャットとウィジェットは現在 Web 版のみです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T និងប៊ូតុង + បើកទំព័រផ្ទាំងថ្មីដើម ជំនួសទំព័រវេប។ វាបើកលឿនជាង ហើយបង្ហាញសកម្មភាពទាំងអស់នៃផ្ទាំងពាក្យបញ្ជា ពេលអ្នកវាយ។ ការជជែកថ្មីៗ និងធាតុក្រាហ្វិកមាននៅលើទំព័រវេបតែប៉ុណ្ណោះសម្រាប់ពេលនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T와 + 버튼이 웹 페이지 대신 네이티브 새 탭 페이지를 엽니다. 더 빨리 열리고 입력하는 동안 명령 팔레트의 모든 동작을 보여 줍니다. 최근 채팅과 위젯은 당분간 웹 페이지에만 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T og +-knappen åpner den innebygde ny fane-siden i stedet for nettsiden. Den åpner raskere og viser alle handlinger i kommandopaletten mens du skriver. Nylige chatter og widgeter finnes foreløpig bare på nettsiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T i przycisk + otwierają natywną stronę nowej karty zamiast strony WWW. Otwiera się szybciej i podczas pisania pokazuje wszystkie akcje palety poleceń. Ostatnie czaty i widżety są na razie tylko na stronie WWW."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T e o botão + abrem a página nativa de nova aba em vez da web. Ela abre mais rápido e mostra todas as ações da paleta de comandos enquanto você digita. Conversas recentes e widgets ficam só na página web por enquanto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T и кнопка + открывают нативную страницу новой вкладки вместо веб-страницы. Она открывается быстрее и при вводе показывает все действия палитры команд. Недавние чаты и виджеты пока есть только на веб-странице."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T และปุ่ม + จะเปิดหน้าแท็บใหม่แบบเนทีฟแทนหน้าเว็บ เปิดได้เร็วกว่าและแสดงทุกการทำงานในจานคำสั่งขณะพิมพ์ แชทล่าสุดและวิดเจ็ตยังมีเฉพาะในหน้าเว็บในตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T ve + düğmesi web sayfası yerine yerel Yeni Sekme sayfasını açar. Daha hızlı açılır ve yazarken komut paletindeki her eylemi listeler. Son sohbetler ve widget'lar şimdilik yalnızca web sayfasında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T і кнопка + відкривають нативну сторінку нової вкладки замість вебсторінки. Вона відкривається швидше й під час введення показує всі дії палітри команд. Нещодавні чати й віджети поки є лише на вебсторінці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T và nút + mở trang thẻ mới gốc thay cho trang web. Trang mở nhanh hơn và liệt kê mọi thao tác của bảng lệnh khi bạn gõ. Các cuộc trò chuyện gần đây và tiện ích hiện chỉ có trên trang web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T 和 + 按钮打开原生新标签页，而不是网页版。它打开更快，并在输入时列出命令面板中的所有操作。最近的聊天和小组件目前仅在网页版中提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T 和 + 按鈕會開啟原生新分頁頁面，而非網頁版。它開啟更快，並在輸入時列出指令面板中的所有動作。最近的聊天與小工具目前僅在網頁版提供。"
          }
        }
      }
    },
    "settings.labs.machineJoin.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض «إضافة جهاز» سطرًا للصقه على أي جهاز Mac أو Linux؛ فينضم إلى أجهزة فريقك. تبقى مشاركة الشاشة والتحكم متوقفة حتى يسمح بهما ذلك الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj uređaj prikazuje liniju koju zalijepite na bilo koji Mac ili Linux računar; on se pridružuje računarima vašeg tima. Dijeljenje ekrana i kontrola ostaju isključeni dok ih taj računar ne dozvoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilføj enhed viser en linje, du kan indsætte på enhver Mac- eller Linux-computer; den slutter sig til dit teams maskiner. Skærmdeling og styring forbliver slået fra, indtil maskinen tillader dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Gerät hinzufügen“ zeigt eine Zeile, die du auf einem beliebigen Mac oder Linux-Rechner einfügst; er tritt den Rechnern deines Teams bei. Bildschirmfreigabe und Steuerung bleiben aus, bis dieser Rechner sie erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Device shows a line to paste on any Mac or Linux computer; it joins your team's machines. Screen sharing and control stay off until that machine allows them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añadir dispositivo muestra una línea para pegar en cualquier Mac u ordenador Linux; se une a los equipos de tu equipo de trabajo. Compartir pantalla y el control siguen desactivados hasta que ese equipo los permita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajouter un appareil affiche une ligne à coller sur n’importe quel Mac ou ordinateur Linux ; il rejoint les machines de votre équipe. Le partage d’écran et le contrôle restent désactivés jusqu’à ce que cette machine les autorise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiungi dispositivo mostra una riga da incollare su qualsiasi Mac o computer Linux, che si unisce ai computer del tuo team. La condivisione dello schermo e il controllo restano disattivati finché quel computer non li consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「デバイスを追加」に、任意の Mac または Linux コンピュータに貼り付ける行が表示され、チームのマシンに参加します。画面共有と操作は、そのマシンが許可するまでオフのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«បន្ថែមឧបករណ៍» បង្ហាញបន្ទាត់សម្រាប់បិទភ្ជាប់លើកុំព្យូទ័រ Mac ឬ Linux ណាមួយ ហើយវាចូលរួមជាមួយម៉ាស៊ីនរបស់ក្រុមអ្នក។ ការចែករំលែកអេក្រង់ និងការគ្រប់គ្រងនៅតែបិទ រហូតដល់ម៉ាស៊ីននោះអនុញ្ញាត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기 추가에 아무 Mac 또는 Linux 컴퓨터에 붙여 넣을 줄이 표시되며, 그 컴퓨터가 팀의 컴퓨터에 참여합니다. 화면 공유와 제어는 그 컴퓨터가 허용할 때까지 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legg til enhet viser en linje du limer inn på en hvilken som helst Mac- eller Linux-datamaskin; den blir med i teamets maskiner. Skjermdeling og styring er av til maskinen tillater dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj urządzenie pokazuje wiersz do wklejenia na dowolnym komputerze Mac lub z Linuksem; komputer dołącza do komputerów Twojego zespołu. Udostępnianie ekranu i sterowanie pozostają wyłączone, dopóki ten komputer na nie nie zezwoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicionar dispositivo mostra uma linha para colar em qualquer computador Mac ou Linux; ele entra nas máquinas da sua equipe. O compartilhamento de tela e o controle ficam desativados até que essa máquina os permita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Добавить устройство» показывает строку, которую нужно вставить на любом компьютере Mac или Linux; он подключается к компьютерам вашей команды. Демонстрация экрана и управление выключены, пока этот компьютер их не разрешит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่มอุปกรณ์จะแสดงบรรทัดสำหรับวางบนคอมพิวเตอร์ Mac หรือ Linux เครื่องใดก็ได้ แล้วเครื่องนั้นจะเข้าร่วมกับเครื่องของทีมคุณ การแชร์หน้าจอและการควบคุมจะปิดอยู่จนกว่าเครื่องนั้นจะอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aygıt Ekle, herhangi bir Mac veya Linux bilgisayara yapıştırılacak bir satır gösterir; bilgisayar ekibinizin makinelerine katılır. Ekran paylaşımı ve denetim, o makine izin verene kadar kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Додати пристрій» показує рядок, який треба вставити на будь-якому комп’ютері Mac або Linux; він підключається до комп’ютерів вашої команди. Демонстрація екрана й керування вимкнені, доки цей комп’ютер їх не дозволить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thêm thiết bị hiện một dòng lệnh để dán trên bất kỳ máy Mac hoặc Linux nào; máy đó sẽ tham gia các máy của nhóm bạn. Chia sẻ màn hình và điều khiển vẫn tắt cho đến khi máy đó cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“添加设备”会显示一行命令，可粘贴到任意 Mac 或 Linux 电脑上；它会加入你团队的机器。在该机器允许之前，屏幕共享和控制保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「新增裝置」會顯示一行指令，可貼到任何 Mac 或 Linux 電腦上；它會加入你團隊的機器。在該機器允許之前，螢幕分享和控制保持關閉。"
          }
        }
      }
    },
