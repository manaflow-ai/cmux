    "settings.agentPane.showDictation.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الميكروفون بجانب زر الإرسال في كل محرر، بما في ذلك صفحة علامة التبويب الجديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikrofon pored dugmeta Pošalji u svakom polju za unos, uključujući stranicu nove kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikrofonen ved siden af Send i alle skrivefelter, også på siden Ny fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Mikrofon neben „Senden“ in jedem Eingabefeld, auch auf der Seite „Neuer Tab“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone beside Send in every composer, including the New Tab page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El micrófono junto a Enviar en cada redactor, incluida la página de nueva pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le micro à côté d’Envoyer dans chaque zone de saisie, y compris la page Nouvel onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il microfono accanto a Invia in ogni compositore, inclusa la pagina Nuova scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新規タブページを含む、すべての入力欄の送信ボタンの横にあるマイク。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មីក្រូហ្វូននៅជាប់ប៊ូតុងផ្ញើ ក្នុងប្រអប់សរសេរទាំងអស់ រួមទាំងទំព័រផ្ទាំងថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 탭 페이지를 포함한 모든 입력창에서 보내기 옆에 있는 마이크."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikrofonen ved siden av Send i alle skrivefelt, også på siden Ny fane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikrofon obok przycisku Wyślij w każdym polu tworzenia, także na stronie nowej karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O microfone ao lado de Enviar em cada editor, incluindo a página de nova aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Микрофон рядом с кнопкой «Отправить» в каждом поле ввода, включая страницу новой вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไมโครโฟนข้างปุ่มส่งในทุกช่องเขียน รวมถึงหน้าแท็บใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni Sekme sayfası dahil her yazma alanında Gönder'in yanındaki mikrofon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Мікрофон поруч із кнопкою «Надіслати» в кожному полі введення, зокрема на сторінці нової вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Micrô bên cạnh nút Gửi trong mọi khung soạn, kể cả trang Tab mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个输入框（包括新标签页）中“发送”旁边的麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
