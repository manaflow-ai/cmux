        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In eine leere Suche getippt, öffnet dieses Zeichen den Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escrito en una búsqueda vacía, este carácter entra en el ámbito."
          }
