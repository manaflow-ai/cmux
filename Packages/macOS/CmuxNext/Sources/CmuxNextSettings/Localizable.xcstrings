    "settings.sidebar.style.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail shrinks the sidebar to a strip; point at it to open the full sidebar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leiste verkleinert die Seitenleiste auf einen Streifen; zeige darauf, um die ganze Seitenleiste zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bande réduit la barre latérale à une bande ; pointez dessus pour ouvrir la barre latérale complète."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقلّص الشريط الرفيع الشريط الجانبي إلى شريط ضيق؛ أشر إليه لفتح الشريط الجانبي كاملًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riel reduce la barra lateral a una franja; apunta a ella para abrir la barra lateral completa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "細條會把側邊欄縮成窄條；把指標移到上面即可開啟完整側邊欄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "细条会把边栏缩成一条窄条；将指针移到上面即可打开完整边栏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "레일은 사이드바를 얇은 띠로 줄입니다. 띠를 가리키면 전체 사이드바가 열립니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レールはサイドバーを細い帯に縮めます。帯にポインタを置くとサイドバー全体が開きます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traka smanjuje bočnu traku na usku traku; pokažite na nju da otvorite cijelu bočnu traku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skinne gør sidepanelet til en stribe; peg på den for at åbne hele sidepanelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barra riduce la barra laterale a una striscia; puntala per aprire la barra laterale completa."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របារបង្រួមរបារចំហៀងទៅជាបន្ទះស្តើង; ចង្អុលទៅវាដើម្បីបើករបារចំហៀងពេញ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skinne gjør sidefeltet til en stripe; pek på den for å åpne hele sidefeltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasek zwęża pasek boczny do wąskiego paska; wskaż go, aby otworzyć pełny pasek boczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trilho reduz a barra lateral a uma faixa; aponte para ela para abrir a barra lateral completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Полоса сжимает боковую панель до узкой полосы; наведите на неё, чтобы открыть полную боковую панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบจะย่อแถบด้านข้างเป็นแถบแคบ ชี้ที่แถบเพื่อเปิดแถบด้านข้างแบบเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şerit, kenar çubuğunu bir şeride küçültür; tamamını açmak için şeridin üzerine gelin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Смуга зменшує бічну панель до вузької смуги; наведіть на неї, щоб відкрити повну бічну панель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thanh mảnh thu thanh bên thành một dải; trỏ vào dải để mở toàn bộ thanh bên."
          }
        }
      }
    },
