        "km": {"stringUnit": {"state": "translated", "value": "អ្វីដែលភ្នាក់ងារអាចធ្វើជាមួយកម្មវិធីរបស់អ្នក"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트가 앱으로 할 수 있는 일"}},
