    "settings.sidebar.hoverCards.groups.workspaceGroups.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summary card opens when the pointer rests on a workspace group's header."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تفتح بطاقة ملخص عندما يستقر المؤشر على رأس مجموعة مساحات عمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartica sa sažetkom otvara se kada pokazivač miruje na zaglavlju grupe radnih prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et oversigtskort åbnes, når markøren hviler på en arbejdsområdegruppes overskrift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Übersichtskarte öffnet sich, wenn der Zeiger auf dem Kopf einer Workspace-Gruppe ruht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se abre una tarjeta de resumen cuando el puntero se detiene en el encabezado de un grupo de espacios."
          }
        },
        "fr": {
