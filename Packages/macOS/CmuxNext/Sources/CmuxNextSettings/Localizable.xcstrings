    "settings.layout.paneCornerRadius.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One radius for panes, tabs, panels, popovers and cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペイン、タブ、パネル、ポップオーバー、カードに共通の半径です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نصف قطر واحد للأجزاء وعلامات التبويب واللوحات والنوافذ المنبثقة والبطاقات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedan radijus za panele, kartice, ploče, iskačuće prozore i kartone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Én radius for ruder, faner, paneler, popovere og kort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Radius für Bereiche, Tabs, Panels, Popover und Karten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un radio para paneles, pestañas, paneles flotantes, ventanas emergentes y tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un seul rayon pour les volets, onglets, panneaux, popovers et cartes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un raggio per riquadri, schede, pannelli, popover e card."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កាំតែមួយសម្រាប់ផ្ទាំង ផ្ទាំងរង បន្ទះ ផ្ទាំងលេចឡើង និងកាត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창, 탭, 패널, 팝오버, 카드에 쓰는 하나의 반경입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Én radius for ruter, faner, paneler, popovere og kort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeden promień dla paneli, kart, okien, dymków i kafelków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um raio para painéis, abas, painéis flutuantes, popovers e cartões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Один радиус для панелей, вкладок, плавающих панелей, всплывающих окон и карточек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รัศมีเดียวสำหรับบานหน้าต่าง แท็บ แผง ป๊อปโอเวอร์ และการ์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bölmeler, sekmeler, paneller, açılır pencereler ve kartlar için tek yarıçap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Один радіус для панелей, вкладок, плаваючих панелей, спливних вікон і карток."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một bán kính cho ô, thẻ, bảng, cửa sổ bật lên và thẻ nội dung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗格、标签页、面板、弹出框和卡片共用一个半径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "窗格、分頁、面板、彈出框與卡片共用一個半徑。"
          }
        }
      }
    },
    "settings.layout.cornerPadding.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Space between a pane's edge and its tabs. Inner corners use the corner radius minus this."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "ペインの端とタブの間隔です。内側の角は角丸の半径からこの値を引いたものです。"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "المسافة بين حافة الجزء وعلامات التبويب. تستخدم الزوايا الداخلية نصف قطر الزاوية مطروحًا منه هذه القيمة."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Razmak između ruba panela i kartica. Unutrašnji uglovi koriste radijus uglova umanjen za ovo."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Afstand mellem en rudes kant og dens faner. Indre hjørner bruger hjørneradius minus denne."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Abstand zwischen dem Rand eines Bereichs und seinen Tabs. Innere Ecken nutzen den Eckradius minus diesen Wert."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Espacio entre el borde de un panel y sus pestañas. Las esquinas internas usan el radio de esquina menos este valor."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Espace entre le bord d'un volet et ses onglets. Les coins intérieurs utilisent le rayon des coins moins cette valeur."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Spazio tra il bordo di un pannello e le sue schede. Gli angoli interni usano il raggio meno questo valore."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គម្លាតរវាងគែមផ្ទាំង និងផ្ទាំងរងរបស់វា។ ជ្រុងខាងក្នុងប្រើកាំជ្រុងដកតម្លៃនេះ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "창 가장자리와 탭 사이의 간격입니다. 안쪽 모서리는 모서리 반경에서 이 값을 뺍니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Avstand mellom kanten av en rute og fanene. Indre hjørner bruker hjørneradius minus denne."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Odstęp między krawędzią panelu a jego kartami. Wewnętrzne narożniki używają promienia minus ta wartość."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Espaço entre a borda de um painel e suas abas. Os cantos internos usam o raio do canto menos este valor."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Расстояние между краем панели и её вкладками. Внутренние углы используют радиус углов минус это значение."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระยะห่างระหว่างขอบบานหน้าต่างกับแท็บ มุมด้านในใช้รัศมีมุมลบค่านี้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bölme kenarı ile sekmeleri arasındaki boşluk. İç köşeler köşe yarıçapından bunu çıkarır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Відстань між краєм панелі та її вкладками. Внутрішні кути використовують радіус кутів мінус це значення."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Khoảng cách giữa cạnh ô và các thẻ của nó. Góc bên trong dùng bán kính góc trừ giá trị này."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "窗格边缘与其标签页之间的间距。内侧圆角使用圆角半径减去此值。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "窗格邊緣與其分頁之間的間距。內側圓角使用圓角半徑減去此值。"}}
      }
    },
