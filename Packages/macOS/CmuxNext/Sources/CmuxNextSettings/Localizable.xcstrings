    "settings.agents.modelRouter.model.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النموذج الذي تبدأ به محادثة جديدة على موجّه نماذج cmux. النموذج الذي تختاره في محادثة ينطبق على تلك المحادثة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model s kojim počinje novi chat na cmux usmjerivaču modela. Model koji odaberete u chatu važi samo za taj chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den model, en ny chat på cmux-modelrouteren starter med. En model, du vælger i en chat, gælder kun den chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell, mit dem ein neuer Chat über den cmux-Modellrouter startet. Ein in einem Chat gewähltes Modell gilt nur für diesen Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model a new chat on the cmux model router starts on. A model you pick in a chat applies to that chat only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo con el que empieza un chat nuevo en el enrutador de modelos de cmux. Un modelo que elijas en un chat solo se aplica a ese chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sur lequel démarre une nouvelle discussion via le routeur de modèles cmux. Un modèle choisi dans une discussion ne s’applique qu’à celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello con cui inizia una nuova chat sul router di modelli cmux. Un modello scelto in una chat vale solo per quella chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux モデルルーターで新しいチャットを始めるときのモデルです。チャット内で選んだモデルはそのチャットにだけ適用されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ូដែលដែលការជជែកថ្មីនៅលើកម្មវិធីបញ្ជូនម៉ូដែល cmux ចាប់ផ្ដើមប្រើ។ ម៉ូដែលដែលអ្នកជ្រើសក្នុងការជជែកមួយ អនុវត្តចំពោះការជជែកនោះប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 모델 라우터에서 새 채팅을 시작할 때 쓰는 모델입니다. 채팅에서 고른 모델은 그 채팅에만 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen en ny chat på cmux-modellruteren starter med. En modell du velger i en chat, gjelder bare den chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, na którym startuje nowy czat w routerze modeli cmux. Model wybrany w czacie dotyczy tylko tego czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo com que um novo chat no roteador de modelos do cmux começa. Um modelo escolhido em um chat vale só para esse chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель, с которой начинается новый чат через маршрутизатор моделей cmux. Модель, выбранная в чате, действует только в этом чате."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลที่แชตใหม่บนตัวกำหนดเส้นทางโมเดล cmux เริ่มใช้ โมเดลที่คุณเลือกในแชตใช้กับแชตนั้นเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux model yönlendiricisinde yeni bir sohbetin başladığı model. Bir sohbette seçtiğiniz model yalnızca o sohbete uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель, з якою починається новий чат через маршрутизатор моделей cmux. Модель, вибрана в чаті, діє лише в цьому чаті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình mà một cuộc trò chuyện mới trên bộ định tuyến mô hình cmux bắt đầu dùng. Mô hình bạn chọn trong một cuộc trò chuyện chỉ áp dụng cho cuộc trò chuyện đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 模型路由器上开始新聊天时使用的模型。在聊天中选择的模型只适用于该聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 cmux 模型路由器上開始新聊天時使用的模型。在聊天中選擇的模型只套用於該聊天。"
          }
        }
      }
    },
