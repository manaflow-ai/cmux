          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стиль всплывающих уведомлений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบการแจ้งเตือนแบบโทสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
