    "settings.workspaceRow.progress.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "needs_review", "value": "شريط تقدم تحت الصف وعلامة الانشغال للعمل الجاري." } },
        "bs": { "stringUnit": { "state": "needs_review", "value": "Traka napretka ispod reda i oznaka zauzetosti za rad u toku." } },
        "da": { "stringUnit": { "state": "needs_review", "value": "En statuslinje under rækken og optaget-mærket for igangværende arbejde." } },
        "de": { "stringUnit": { "state": "needs_review", "value": "Ein Fortschrittsbalken unter der Zeile und die Beschäftigt-Markierung laufender Arbeit." } },
        "en": { "stringUnit": { "state": "translated", "value": "A progress bar under the row and the busy mark of running work." } },
        "es": { "stringUnit": { "state": "needs_review", "value": "Una barra de progreso bajo la fila y la marca de ocupado del trabajo en curso." } },
        "fr": { "stringUnit": { "state": "needs_review", "value": "Une barre de progression sous la ligne et la marque d'activité du travail en cours." } },
        "it": { "stringUnit": { "state": "needs_review", "value": "Una barra di avanzamento sotto la riga e il segno di occupato del lavoro in corso." } },
        "ja": { "stringUnit": { "state": "translated", "value": "行の下の進行状況バーと、実行中の作業のビジーマーク。" } },
        "km": { "stringUnit": { "state": "needs_review", "value": "របារវឌ្ឍនភាពក្រោមជួរ និងសញ្ញារវល់នៃការងារកំពុងដំណើរការ។" } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "행 아래의 진행률 막대와 실행 중인 작업의 사용 중 표시." } },
