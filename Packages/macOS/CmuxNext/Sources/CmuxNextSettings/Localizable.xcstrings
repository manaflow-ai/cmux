    "settings.browser.keepNeighborTabsAwake.help": {
      "comment": "Settings row in Browser > Memory: browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى علامات التبويب بجانب المعروضة محمّلة فيكون التبديل إليها فوريًا. القيمة 0 توقفه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice pored prikazane ostaju učitane, pa je prelazak trenutan. 0 isključuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner ved siden af den viste forbliver indlæst, så skift sker med det samme. 0 slår det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tabs neben dem angezeigten bleiben geladen, sodass der Wechsel sofort erfolgt. 0 schaltet es aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs beside the shown one stay loaded so switching is instant. 0 turns it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pestañas junto a la visible siguen cargadas para cambiar al instante. 0 lo desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les onglets voisins de l’onglet affiché restent chargés : y passer est instantané. 0 désactive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le schede accanto a quella mostrata restano caricate, così passarci è immediato. 0 lo disattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "表示中のタブの隣のタブを読み込んだままにし、すぐに切り替えられるようにします。0でオフ。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនៅក្បែរផ្ទាំងដែលកំពុងបង្ហាញ នៅតែផ្ទុក ដូច្នេះការប្ដូរគឺភ្លាមៗ។ 0 បិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "표시 중인 탭 옆의 탭이 로드된 채로 유지되어 즉시 전환할 수 있습니다. 0이면 끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner ved siden av den viste forblir lastet, så bytte skjer umiddelbart. 0 slår det av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty obok wyświetlanej pozostają wczytane, więc przełączanie jest natychmiastowe. 0 wyłącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As abas ao lado da exibida continuam carregadas, então alternar é instantâneo. 0 desativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки рядом с показанной остаются загруженными, поэтому переход мгновенный. 0 выключает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บข้างแท็บที่แสดงอยู่จะยังโหลดอยู่ จึงสลับไปได้ทันที 0 คือปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gösterilen sekmenin yanındaki sekmeler yüklü kalır, böylece geçiş anında olur. 0 kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки поруч із показаною лишаються завантаженими, тож перехід миттєвий. 0 вимикає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tab bên cạnh tab đang hiển thị vẫn được tải để chuyển tức thì. 0 để tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当前标签页两侧的标签页保持加载，切换即刻完成。0 为关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前分頁旁的分頁保持載入，切換即刻完成。0 為關閉。"
          }
        }
      }
    },
