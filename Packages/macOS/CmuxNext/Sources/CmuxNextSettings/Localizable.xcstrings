        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទៃខាងក្រោយមួយនៅពីក្រោយបង្អួច ឬច្បាប់ចម្លងមួយក្នុងផ្ទាំងនីមួយៗ។"
