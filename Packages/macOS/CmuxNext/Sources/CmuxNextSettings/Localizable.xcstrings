    "settings.sessions.keepAwake.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops idle sleep while an agent works. Closing the lid still sleeps the Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمنع السكون عند الخمول أثناء عمل وكيل. إغلاق الغطاء لا يزال يُدخل الـ Mac في وضع السكون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprječava mirovanje dok agent radi. Zatvaranje poklopca i dalje uspavljuje Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forhindrer dvale ved inaktivitet, mens en agent arbejder. Når du lukker låget, går Mac'en stadig i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verhindert den Ruhezustand, solange ein Agent arbeitet. Beim Zuklappen schläft der Mac trotzdem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Evita el reposo por inactividad mientras trabaja un agente. Al cerrar la tapa, el Mac sigue entrando en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empêche la suspension d’activité pendant qu’un agent travaille. Fermer le couvercle met toujours le Mac en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impedisce lo stop per inattività mentre un agente lavora. Chiudendo il coperchio il Mac va comunque in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントの作業中はアイドル時のスリープを止めます。蓋を閉じると Mac はスリープします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ឈប់ការដេកពេលទំនេរ ខណៈភ្នាក់ងារកំពុងធ្វើការ។ ការបិទគម្របនៅតែធ្វើឱ្យ Mac ដេក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 작업하는 동안 유휴 잠자기를 막습니다. 덮개를 닫으면 Mac은 여전히 잠자기 상태가 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hindrer dvale ved inaktivitet mens en agent arbeider. Når du lukker lokket, går Macen fortsatt i dvale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wstrzymuje usypianie przy bezczynności, gdy agent pracuje. Zamknięcie pokrywy nadal usypia Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impede o repouso por inatividade enquanto um agente trabalha. Fechar a tampa ainda coloca o Mac em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не даёт Mac уйти в сон при бездействии, пока работает агент. Закрытие крышки всё равно переводит Mac в сон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ให้เครื่องพักเมื่อไม่มีการใช้งานขณะที่เอเจนต์ทำงาน การปิดฝาก็ยังทำให้ Mac พักเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir ajan çalışırken boşta uykuyu engeller. Kapağı kapatmak Mac'i yine uyutur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не дає Mac засинати під час бездіяльності, поки працює агент. Закриття кришки так само присипляє Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngăn máy ngủ khi không hoạt động trong lúc tác tử làm việc. Gập nắp vẫn đưa máy Mac vào chế độ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "智能体工作时阻止闲置睡眠。合上盖子仍会让 Mac 进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理程式工作時防止閒置睡眠。闔上螢幕仍會讓 Mac 進入睡眠。"
          }
        }
      }
    },
    "settings.sessions.resumeAgents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Agents After Restart"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استئناف الوكلاء بعد إعادة التشغيل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi agente nakon ponovnog pokretanja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptag agenter efter genstart"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten nach Neustart fortsetzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar agentes tras reiniciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre les agents après un redémarrage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi gli agenti dopo il riavvio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後にエージェントを再開"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្តភ្នាក់ងារបន្ទាប់ពីចាប់ផ្ដើមឡើងវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 에이전트 재개"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppta agenter etter omstart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznawiaj agentów po ponownym uruchomieniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomar agentes após reiniciar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновлять агентов после перезапуска"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานเอเจนต์ต่อหลังรีสตาร์ท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden başlatmadan sonra ajanları sürdür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлювати агентів після перезапуску"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục tác tử sau khi khởi động lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启后恢复智能体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動後恢復代理程式"
          }
        }
      }
    },
    "settings.sessions.resumeAgents.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal agents reopen their session after a crash or restart."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد وكلاء الطرفية فتح جلستها بعد تعطل أو إعادة تشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti u terminalu ponovo otvaraju svoju sesiju nakon pada ili ponovnog pokretanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalagenter genåbner deres session efter et nedbrud eller en genstart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal-Agenten öffnen ihre Sitzung nach einem Absturz oder Neustart wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes de terminal reabren su sesión tras un fallo o reinicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents du terminal rouvrent leur session après un plantage ou un redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti nel terminale riaprono la loro sessione dopo un arresto anomalo o un riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュや再起動のあと、ターミナルのエージェントが同じセッションを再開します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារក្នុងទែមីណាល់បើកវគ្គរបស់វាឡើងវិញ បន្ទាប់ពីគាំង ឬចាប់ផ្ដើមឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌이나 재시작 후 터미널 에이전트가 세션을 다시 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalagenter åpner økten sin igjen etter et krasj eller en omstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci w terminalu ponownie otwierają swoją sesję po awarii lub ponownym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes do terminal reabrem a sessão após uma falha ou reinício."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты в терминале снова открывают свой сеанс после сбоя или перезапуска."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ในเทอร์มินัลจะเปิดเซสชันเดิมอีกครั้งหลังแครชหรือรีสตาร์ท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal ajanları bir çökme veya yeniden başlatmadan sonra oturumlarını yeniden açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти в терміналі знову відкривають свій сеанс після збою або перезапуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử trong terminal mở lại phiên của mình sau sự cố hoặc khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃或重启后，终端中的智能体会重新打开其会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當機或重新啟動後，終端機中的代理程式會重新開啟其工作階段。"
          }
        }
      }
    },
