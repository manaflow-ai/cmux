    "settings.agents.autoRetry.attempts.help": {
      "comment": "Settings > Agents > Retry After Errors: attempts help",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد مرات إعادة المحادثة للمحاولة قبل أن تتوقف وتنتظرك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko puta chat pokuša ponovo prije nego što stane i sačeka vas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange gange chatten prøver igen, før den stopper og venter på dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft der Chat es erneut versucht, bevor er anhält und auf dich wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many times the chat tries again before it stops and waits for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántas veces vuelve a intentarlo el chat antes de detenerse y esperarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de nouvelles tentatives avant que la discussion s’arrête et vous attende."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante volte la chat riprova prima di fermarsi e aspettarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止してあなたを待つまでに、チャットが再試行する回数。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំនួនដងដែលការជជែកព្យាយាមម្ដងទៀត មុនពេលវាឈប់ ហើយរង់ចាំអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅이 멈추고 사용자를 기다리기 전까지 다시 시도하는 횟수입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange ganger chatten prøver på nytt før den stopper og venter på deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile razy czat spróbuje ponownie, zanim się zatrzyma i zaczeka na Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas vezes o chat tenta de novo antes de parar e esperar por você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько раз чат повторит попытку, прежде чем остановится и подождёт вас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนครั้งที่แชตลองใหม่ก่อนจะหยุดและรอคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetin durup sizi beklemeden önce kaç kez yeniden deneyeceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки разів чат повторить спробу, перш ніж зупиниться й чекатиме на вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lần cuộc trò chuyện thử lại trước khi dừng và chờ bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话在停止并等待你之前重试的次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話在停止並等待你之前重試的次數。"
          }
        }
      }
    },
    "settings.cloud.agentMemory.follow": {
      "comment": "Settings > Machines: toggle that carries the person's agent memory files to their Cloud machines.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry Your Agent Memory to Cloud Machines"
          }
        }
      }
    },
    "settings.cloud.agentMemory.follow.help": {
      "comment": "Help for the agent memory toggle: names what travels and who controls it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your CLAUDE.md, AGENTS.md, agents, commands, skills and Claude's memory notes follow you to Cloud machines. Never credentials or settings files. Agents' changes wait for you in Session Info; only you can change this. Off deletes your copy in the cloud and stops every push."
          }
        }
      }
    },
    "settings.cloud.agentsStartWithoutAsking": {
      "comment": "Settings > Machines: toggle that lets agents, the cmux CLI and scripts create Cloud machines, move chats to Cloud and start sessions there with no card asking first.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Let Agents Use Cloud Without Asking"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "السماح للوكلاء باستخدام السحابة دون سؤال"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Dozvoli agentima da koriste Cloud bez pitanja"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Lad agenter bruge Cloud uden at spørge"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Agents die Cloud ohne Nachfrage nutzen lassen"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Permitir que los agentes usen la nube sin preguntar"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Laisser les agents utiliser le Cloud sans demander"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Consenti agli agenti di usare il Cloud senza chiedere"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "確認なしでエージェントにクラウドを使わせる"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "អនុញ្ញាតឱ្យភ្នាក់ងារប្រើ Cloud ដោយមិនសួរ"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "묻지 않고 에이전트가 클라우드 사용"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "La agenter bruke Cloud uten å spørre"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pozwól agentom korzystać z chmury bez pytania"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Permitir que agentes usem a nuvem sem perguntar"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Разрешить агентам использовать облако без вопроса"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ให้เอเจนต์ใช้คลาวด์โดยไม่ต้องถาม"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajanların sormadan bulutu kullanmasına izin ver"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Дозволити агентам користуватися хмарою без запиту"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Cho phép tác tử dùng đám mây mà không cần hỏi"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "允许智能体无需询问即使用云端"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "允許代理程式不經詢問即使用雲端"}}
      }
    },
    "settings.cloud.agentsStartWithoutAsking.help": {
      "comment": "Settings > Machines: help for the Let Agents Use Cloud Without Asking toggle (keep the command in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agents, `cmux cloud` in a terminal and scripts create Cloud machines, move chats to Cloud and start sessions there with no card asking you first. Your plan's limits still apply. Only you can change this."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "ينشئ الوكلاء و`cmux cloud` في الطرفية والبرامج النصية أجهزة سحابية، وينقلون المحادثات إلى السحابة ويبدؤون الجلسات هناك دون بطاقة تسألك أولًا. تظل حدود خطتك سارية. أنت وحدك من يمكنه تغيير هذا."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Agenti, `cmux cloud` u terminalu i skripte kreiraju Cloud mašine, premještaju četove u Cloud i tamo pokreću sesije bez kartice koja te prvo pita. Ograničenja tvog plana i dalje važe. Samo ti ovo možeš promijeniti."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Agenter, `cmux cloud` i en terminal og scripts opretter Cloud-maskiner, flytter chats til Cloud og starter sessioner der uden et kort, der spørger dig først. Din plans grænser gælder stadig. Kun du kan ændre dette."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Agents, `cmux cloud` im Terminal und Skripte erstellen Cloud-Maschinen, verschieben Chats in die Cloud und starten dort Sitzungen, ohne dich zuerst mit einer Karte zu fragen. Die Grenzen deines Plans gelten weiterhin. Nur du kannst das ändern."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Los agentes, `cmux cloud` en una terminal y los scripts crean máquinas en la nube, mueven chats a la nube e inician sesiones allí sin una tarjeta que te pregunte antes. Los límites de tu plan siguen aplicándose. Solo tú puedes cambiarlo."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Les agents, `cmux cloud` dans un terminal et les scripts créent des machines Cloud, déplacent des chats vers le Cloud et y démarrent des sessions sans carte qui vous demande d'abord. Les limites de votre forfait s'appliquent toujours. Vous seul pouvez modifier ce réglage."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Gli agenti, `cmux cloud` in un terminale e gli script creano macchine Cloud, spostano le chat nel Cloud e vi avviano sessioni senza una scheda che ti chieda prima. I limiti del tuo piano restano validi. Solo tu puoi cambiarlo."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "エージェント、ターミナルの `cmux cloud`、スクリプトが、先に確認するカードを出さずにクラウドマシンを作成し、チャットをクラウドに移動し、そこでセッションを開始します。プランの上限は引き続き適用されます。これを変更できるのはあなただけです。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ភ្នាក់ងារ `cmux cloud` នៅក្នុងទែមីណាល់ និងស្គ្រីប បង្កើតម៉ាស៊ីន Cloud ផ្លាស់ទីការជជែកទៅ Cloud ហើយចាប់ផ្ដើមវគ្គនៅទីនោះ ដោយគ្មានកាតសួរអ្នកជាមុន។ ដែនកំណត់គម្រោងរបស់អ្នកនៅតែអនុវត្ត។ មានតែអ្នកទេដែលអាចប្ដូរវាបាន។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트, 터미널의 `cmux cloud`, 스크립트가 먼저 묻는 카드 없이 클라우드 머신을 만들고, 채팅을 클라우드로 옮기고, 그곳에서 세션을 시작합니다. 요금제 한도는 계속 적용됩니다. 이 설정은 본인만 바꿀 수 있습니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Agenter, `cmux cloud` i en terminal og skript oppretter Cloud-maskiner, flytter chatter til Cloud og starter økter der uten et kort som spør deg først. Grensene i planen din gjelder fortsatt. Bare du kan endre dette."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Agenci, `cmux cloud` w terminalu i skrypty tworzą maszyny w chmurze, przenoszą czaty do chmury i uruchamiają tam sesje bez karty, która najpierw Cię pyta. Limity Twojego planu nadal obowiązują. Tylko Ty możesz to zmienić."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Agentes, `cmux cloud` em um terminal e scripts criam máquinas na nuvem, movem chats para a nuvem e iniciam sessões lá sem um cartão perguntando antes. Os limites do seu plano continuam valendo. Só você pode mudar isso."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Агенты, `cmux cloud` в терминале и скрипты создают облачные машины, переносят чаты в облако и запускают там сеансы без карточки с вопросом. Ограничения вашего тарифа по-прежнему действуют. Изменить это можете только вы."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เอเจนต์ `cmux cloud` ในเทอร์มินัล และสคริปต์ จะสร้างเครื่องคลาวด์ ย้ายแชทไปยังคลาวด์ และเริ่มเซสชันที่นั่นโดยไม่มีการ์ดถามคุณก่อน ขีดจำกัดของแผนยังคงมีผล มีเพียงคุณเท่านั้นที่เปลี่ยนตัวเลือกนี้ได้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajanlar, terminaldeki `cmux cloud` ve betikler, önce size soran bir kart olmadan bulut makineleri oluşturur, sohbetleri buluta taşır ve orada oturum başlatır. Planınızın sınırları yine geçerlidir. Bunu yalnızca siz değiştirebilirsiniz."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Агенти, `cmux cloud` у терміналі та скрипти створюють хмарні машини, переносять чати в хмару й запускають там сеанси без картки із запитом. Обмеження вашого тарифу й далі діють. Змінити це можете лише ви."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tác tử, `cmux cloud` trong terminal và script sẽ tạo máy đám mây, chuyển cuộc trò chuyện lên đám mây và khởi động phiên ở đó mà không có thẻ hỏi bạn trước. Giới hạn gói của bạn vẫn áp dụng. Chỉ bạn mới có thể thay đổi tùy chọn này."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "智能体、终端中的 `cmux cloud` 和脚本会创建云端机器、将聊天移到云端并在那里启动会话，不会先显示卡片询问你。你的方案限制仍然适用。只有你可以更改此项。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理程式、終端機中的 `cmux cloud` 和指令碼會建立雲端機器、將聊天移到雲端並在那裡啟動工作階段，不會先顯示卡片詢問你。你的方案限制仍然適用。只有你可以變更此項。"}}
      }
    },
