    "settings.chief.subagentSidebarMinWords.help": {
      "comment": "Chief subagent sidebar choice (a1018, 2026-11-05).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks with at least this many words go in the sidebar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この語数以上のタスクはサイドバーに入ります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تذهب المهام التي تحتوي على هذا العدد من الكلمات على الأقل إلى الشريط الجانبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aufgaben mit mindestens so vielen Wörtern kommen in die Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las tareas con al menos esta cantidad de palabras van a la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les tâches d'au moins ce nombre de mots vont dans la barre latérale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 단어 수 이상인 작업은 사이드바에 둡니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "至少包含这么多词的任务放在边栏中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "至少有這麼多字的任務會放在側邊欄。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadaci s najmanje ovoliko riječi idu na bočnu traku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opgaver med mindst så mange ord havner i sidepanelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le attività con almeno questo numero di parole vanno nella barra laterale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កិច្ចការដែលមានពាក្យយ៉ាងហោចណាស់ចំនួននេះ ទៅក្នុងរបារចំហៀង។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oppgaver med minst så mange ord havner i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadania mające co najmniej tyle słów trafiają na pasek boczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarefas com pelo menos esse número de palavras vão para a barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Задачи хотя бы из стольких слов попадают на боковую панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "งานที่มีคำอย่างน้อยเท่านี้จะไปอยู่ในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En az bu kadar sözcük içeren görevler kenar çubuğuna gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завдання щонайменше з такою кількістю слів потрапляють на бічну панель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác vụ có ít nhất ngần này từ sẽ vào thanh bên."
          }
        }
      }
    },
    "settings.palette.searchHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Remember Palette Searches"}},
        "ar": {"stringUnit": {"state": "translated", "value": "تذكّر عمليات البحث في اللوحة"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Pamti pretrage u paleti"}},
        "da": {"stringUnit": {"state": "translated", "value": "Husk paletsøgninger"}},
        "de": {"stringUnit": {"state": "translated", "value": "Palettensuchen merken"}},
        "es": {"stringUnit": {"state": "translated", "value": "Recordar búsquedas de la paleta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mémoriser les recherches de la palette"}},
        "it": {"stringUnit": {"state": "translated", "value": "Ricorda le ricerche della palette"}},
        "ja": {"stringUnit": {"state": "translated", "value": "パレットの検索を記憶"}},
        "km": {"stringUnit": {"state": "translated", "value": "ចងចាំ​ការ​ស្វែងរក​ក្នុង​ផ្ទាំង​ពាក្យ​បញ្ជា"}},
        "ko": {"stringUnit": {"state": "translated", "value": "팔레트 검색 기억"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Husk palettsøk"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zapamiętuj wyszukiwania w palecie"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Lembrar pesquisas da paleta"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Запоминать поиск в палитре"}},
        "th": {"stringUnit": {"state": "translated", "value": "จดจำการค้นหาในพาเลต"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Palet aramalarını hatırla"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Запам’ятовувати пошук у палітрі"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Ghi nhớ tìm kiếm trong bảng lệnh"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "记住面板搜索"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "記住面板搜尋"}}
      }
    },
    "settings.palette.searchHistory.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows you pick and use often rank higher. Off records nothing."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الصفوف التي تختارها وتستخدمها كثيرًا ترتفع في الترتيب. عند الإيقاف لا يُسجَّل شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redovi koje biraš i često koristiš rangiraju se više. Isključeno ne bilježi ništa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rækker, du vælger og bruger ofte, rangeres højere. Fra gemmer intet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ausgewählte und oft genutzte Zeilen stehen weiter oben. Aus speichert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las filas que eliges y usas a menudo suben. Desactivado no registra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les lignes choisies et utilisées souvent montent. Désactivé n’enregistre rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le righe che scegli e usi spesso salgono. Disattivato non registra nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選んだ行やよく使う行は上位に表示されます。オフにすると何も記録しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជួរ​ដែល​អ្នក​ជ្រើស និង​ប្រើ​ញឹកញាប់​ឡើង​ខ្ពស់។ ពេល​បិទ មិន​កត់ត្រា​អ្វី​ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고른 행과 자주 쓰는 행이 더 위로 올라갑니다. 끄면 아무것도 기록하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rader du velger og bruker ofte, rangeres høyere. Av lagrer ingenting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierane i często używane wiersze są wyżej. Wyłączone: nic nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linhas que você escolhe e usa com frequência sobem. Desativado não registra nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выбранные и часто используемые строки поднимаются выше. Если выключено, ничего не запоминается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถวที่คุณเลือกและใช้บ่อยจะอยู่สูงขึ้น เมื่อปิดจะไม่บันทึกอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçtiğin ve sık kullandığın satırlar üste çıkar. Kapalıyken hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Обрані й часто вживані рядки піднімаються вище. Якщо вимкнено, нічого не запам’ятовується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các hàng bạn chọn và dùng thường xuyên được xếp cao hơn. Khi tắt, không ghi lại gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你选中和常用的行会排得更靠前。关闭后不记录任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你選取和常用的列會排得更前面。關閉後不記錄任何內容。"
          }
        }
      }
    },
