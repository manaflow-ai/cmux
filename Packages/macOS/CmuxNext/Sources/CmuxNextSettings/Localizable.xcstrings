    "settings.browser.passwords.allowExport.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the Passwords page write every saved password to a plain-text CSV file, after you confirm with Touch ID or your password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح لصفحة كلمات السر كتابة كل كلمات السر المحفوظة في ملف CSV بنص عادي، بعد تأكيدك باستخدام Touch ID أو كلمة السر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omogućava stranici Lozinke da upiše sve sačuvane lozinke u CSV datoteku s običnim tekstom, nakon potvrde putem Touch ID-a ili lozinke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lader siden Adgangskoder skrive alle gemte adgangskoder til en CSV-fil i almindelig tekst, når du har bekræftet med Touch ID eller din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt der Seite „Passwörter“, alle gespeicherten Passwörter in eine CSV-Datei im Klartext zu schreiben, nachdem du mit Touch ID oder deinem Passwort bestätigt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que la página Contraseñas escriba todas las contraseñas guardadas en un archivo CSV de texto sin formato, después de confirmar con Touch ID o tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à la page Mots de passe d’écrire tous les mots de passe enregistrés dans un fichier CSV en texte brut, après confirmation avec Touch ID ou votre mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente alla pagina Password di scrivere tutte le password salvate in un file CSV in testo semplice, dopo la conferma con Touch ID o la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touch ID またはパスワードで確認した後、パスワードページが保存済みのすべてのパスワードをプレーンテキストの CSV ファイルに書き出せるようにします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យទំព័រពាក្យសម្ងាត់សរសេរពាក្យសម្ងាត់ដែលបានរក្សាទុកទាំងអស់ទៅឯកសារ CSV អត្ថបទធម្មតា បន្ទាប់ពីអ្នកបញ្ជាក់ដោយ Touch ID ឬពាក្យសម្ងាត់របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touch ID나 암호로 확인한 후 비밀번호 페이지가 저장된 모든 비밀번호를 일반 텍스트 CSV 파일로 쓸 수 있게 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lar Passord-siden skrive alle lagrede passord til en CSV-fil i ren tekst etter at du har bekreftet med Touch ID eller passordet ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozwala stronie Hasła zapisać wszystkie zapisane hasła w pliku CSV jako zwykły tekst po potwierdzeniu Touch ID lub hasłem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que a página Senhas grave todas as senhas salvas em um arquivo CSV de texto simples, depois que você confirmar com Touch ID ou sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет странице «Пароли» записать все сохранённые пароли в CSV-файл открытым текстом после подтверждения с помощью Touch ID или пароля."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้หน้ารหัสผ่านเขียนรหัสผ่านที่บันทึกไว้ทั้งหมดลงในไฟล์ CSV แบบข้อความธรรมดา หลังจากคุณยืนยันด้วย Touch ID หรือรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touch ID veya parolanızla onayladıktan sonra Parolalar sayfasının kayıtlı tüm parolaları düz metin bir CSV dosyasına yazmasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволяє сторінці «Паролі» записати всі збережені паролі у CSV-файл відкритим текстом після підтвердження за допомогою Touch ID або пароля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép trang Mật khẩu ghi mọi mật khẩu đã lưu ra tệp CSV văn bản thuần, sau khi bạn xác nhận bằng Touch ID hoặc mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你用触控 ID 或密码确认后，允许“密码”页面将所有已存储的密码写入纯文本 CSV 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在你以 Touch ID 或密碼確認後，允許「密碼」頁面將所有已儲存的密碼寫入純文字 CSV 檔案。"
          }
        }
      }
    },
