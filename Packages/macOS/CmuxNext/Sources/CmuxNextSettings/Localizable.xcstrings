    "settings.tabs.nativeNewTabPage.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T opens the faster native New Tab page. Recent chats and widgets are web only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفتح Cmd-T صفحة علامة التبويب الجديدة الأصلية الأسرع. المحادثات الأخيرة والأدوات في صفحة الويب فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T otvara bržu izvornu stranicu nove kartice. Nedavni razgovori i widgeti su samo na web stranici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T åbner den hurtigere indbyggede ny fane-side. Seneste chats og widgets findes kun på websiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T öffnet die schnellere native Seite „Neuer Tab“. Letzte Chats und Widgets gibt es nur auf der Webseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T abre la página nativa de nueva pestaña, más rápida. Los chats recientes y los widgets solo están en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T ouvre la page Nouvel onglet native, plus rapide. Les discussions récentes et les widgets sont seulement sur la page web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T apre la pagina Nuova scheda nativa, più veloce. Chat recenti e widget sono solo nella pagina web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T でより速いネイティブの新規タブページを開きます。最近のチャットとウィジェットは Web 版のみです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T បើកទំព័រផ្ទាំងថ្មីដើមដែលលឿនជាង។ ការជជែកថ្មីៗ និងធាតុក្រាហ្វិកមានតែលើទំព័រវេបប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T가 더 빠른 네이티브 새 탭 페이지를 엽니다. 최근 채팅과 위젯은 웹 페이지에만 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T åpner den raskere innebygde ny fane-siden. Nylige chatter og widgeter finnes bare på nettsiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T otwiera szybszą natywną stronę nowej karty. Ostatnie czaty i widżety są tylko na stronie WWW."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T abre a página nativa de nova aba, mais rápida. Conversas recentes e widgets ficam só na web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T открывает более быструю нативную страницу новой вкладки. Недавние чаты и виджеты есть только на веб-странице."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T เปิดหน้าแท็บใหม่แบบเนทีฟที่เร็วกว่า แชทล่าสุดและวิดเจ็ตมีเฉพาะในหน้าเว็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T daha hızlı yerel Yeni Sekme sayfasını açar. Son sohbetler ve widget'lar yalnızca web sayfasında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T відкриває швидшу нативну сторінку нової вкладки. Нещодавні чати й віджети є лише на вебсторінці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T mở trang thẻ mới gốc nhanh hơn. Cuộc trò chuyện gần đây và tiện ích chỉ có trên trang web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T 打开更快的原生新标签页。最近的聊天和小组件仅在网页版中提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T 會開啟更快的原生新分頁頁面。最近的聊天與小工具僅在網頁版提供。"
          }
        }
      }
    },
    "settings.labs.machineJoin.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض مشاركة الشاشة والتحكم في الإعدادات > الأجهزة بعد انضمام هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
