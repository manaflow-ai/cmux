    "settings.appearance.themeFile.help": {
      "comment": "Settings > Theme > App Theme: the theme file (appearance.themeFile) row",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A theme file in ~/.config/cmux/themes, such as \"tokyo\" for tokyo.json."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ملف سمة في ~/.config/cmux/themes، مثل \"tokyo\" للملف tokyo.json."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datoteka teme u ~/.config/cmux/themes, npr. \"tokyo\" za tokyo.json."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
