    "settings.macScreen.systemShortcuts.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a Mac Screen tab has the keyboard, shortcuts like ⌘Tab, ⌘Space, Mission Control and ⌘Q go to the other Mac. Needs Accessibility."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عندما تكون لوحة المفاتيح لعلامة تبويب شاشة Mac، تنتقل اختصارات مثل ⌘Tab و⌘مسافة وMission Control و⌘Q إلى الـMac الآخر. يتطلب تسهيلات الاستخدام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dok kartica Ekran Maca ima tastaturu, prečice poput ⌘Tab, ⌘Razmak, Mission Control i ⌘Q idu na drugi Mac. Potrebna je pristupačnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mens en Mac-skærm-fane har tastaturet, går genveje som ⌘Tab, ⌘Mellemrum, Mission Control og ⌘Q til den anden Mac. Kræver tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solange ein Mac-Bildschirm-Tab die Tastatur hat, gehen Kurzbefehle wie ⌘Tab, ⌘Leertaste, Mission Control und ⌘Q an den anderen Mac. Erfordert Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mientras una pestaña de Pantalla del Mac tiene el teclado, atajos como ⌘Tab, ⌘Espacio, Mission Control y ⌘Q van al otro Mac. Requiere accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tant qu’un onglet Écran Mac a le clavier, les raccourcis comme ⌘Tab, ⌘Espace, Mission Control et ⌘Q vont à l’autre Mac. Nécessite l’accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mentre una scheda Schermo Mac ha la tastiera, abbreviazioni come ⌘Tab, ⌘Spazio, Mission Control e ⌘Q vanno all’altro Mac. Richiede l’accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Macの画面タブがキーボードを使用している間、⌘Tab、⌘スペース、Mission Control、⌘Qなどのショートカットはもう一方のMacに送られます。アクセシビリティが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពេលផ្ទាំងអេក្រង់ Mac មានក្ដារចុច ផ្លូវកាត់ដូចជា ⌘Tab, ⌘ដកឃ្លា, Mission Control និង ⌘Q ទៅ Mac ផ្សេងទៀត។ ត្រូវការភាពងាយស្រួល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac 화면 탭이 키보드를 사용하는 동안 ⌘Tab, ⌘스페이스, Mission Control, ⌘Q 같은 단축키가 다른 Mac으로 갑니다. 손쉬운 사용이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mens en Mac-skjerm-fane har tastaturet, går snarveier som ⌘Tab, ⌘Mellomrom, Mission Control og ⌘Q til den andre Macen. Krever tilgjengelighet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy karta Ekran Maca ma klawiaturę, skróty takie jak ⌘Tab, ⌘Spacja, Mission Control i ⌘Q trafiają do drugiego Maca. Wymaga dostępności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enquanto uma aba Tela do Mac tem o teclado, atalhos como ⌘Tab, ⌘Espaço, Mission Control e ⌘Q vão para o outro Mac. Requer acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пока вкладка «Экран Mac» владеет клавиатурой, сочетания вроде ⌘Tab, ⌘Пробел, Mission Control и ⌘Q уходят на другой Mac. Нужен универсальный доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขณะที่แท็บหน้าจอ Mac ใช้แป้นพิมพ์อยู่ ปุ่มลัดอย่าง ⌘Tab, ⌘แป้นเว้นวรรค, Mission Control และ ⌘Q จะไปที่ Mac อีกเครื่อง ต้องใช้การช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir Mac Ekranı sekmesi klavyeye sahipken ⌘Tab, ⌘Boşluk, Mission Control ve ⌘Q gibi kısayollar diğer Mac’e gider. Erişilebilirlik gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поки вкладка «Екран Mac» має клавіатуру, сполучення на кшталт ⌘Tab, ⌘Пробіл, Mission Control і ⌘Q ідуть на інший Mac. Потрібна доступність."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi một tab Màn hình Mac đang giữ bàn phím, các phím tắt như ⌘Tab, ⌘Phím cách, Mission Control và ⌘Q sẽ đến máy Mac kia. Cần Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当 Mac 屏幕标签页占用键盘时，⌘Tab、⌘空格、调度中心和 ⌘Q 等快捷键会发送到另一台 Mac。需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當 Mac 螢幕標籤頁佔用鍵盤時，⌘Tab、⌘空白鍵、指揮中心和 ⌘Q 等快速鍵會傳送到另一台 Mac。需要輔助使用權限。"
          }
        }
      }
    },
