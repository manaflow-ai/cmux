    "settings.appearance.titleAreaTone.help": {
      "comment": "Help under the Title Area setting; 'Two Tones' and 'One Color' are its two choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title bar, tab bar and sidebar in the content's color, or shaded apart."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شريط العنوان وشريط علامات التبويب والشريط الجانبي بلون المحتوى، أو مظللة لتتميز عنه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naslovna traka, traka s karticama i bočna traka u boji sadržaja ili zasebno zasjenjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titellinjen, fanelinjen og sidepanelet i indholdets farve eller skygget fra det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titelleiste, Tableiste und Seitenleiste in der Farbe des Inhalts oder davon abgesetzt schattiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La barra de título, la barra de pestañas y la barra lateral con el color del contenido, o sombreadas aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La barre de titre, la barre d’onglets et la barre latérale dans la couleur du contenu, ou ombrées à part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barra del titolo, barra delle schede e barra laterale nel colore del contenuto, o ombreggiate a parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タイトルバー、タブバー、サイドバーをコンテンツと同じ色で描くか、陰影で区別するか。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របារចំណងជើង របារផ្ទាំង និងរបារចំហៀង ជាពណ៌នៃខ្លឹមសារ ឬងងឹតដាច់ពីខ្លឹមសារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "제목 막대, 탭 막대, 사이드바를 콘텐츠와 같은 색으로 그리거나 다른 음영으로 구분합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tittellinjen, fanelinjen og sidefeltet i innholdets farge, eller skyggelagt fra det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasek tytułu, pasek kart i pasek boczny w kolorze treści lub lekko przyciemnione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A barra de título, a barra de abas e a barra lateral na cor do conteúdo ou sombreadas à parte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заголовок, панель вкладок и боковая панель цветом содержимого или слегка затенённые."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบชื่อเรื่อง แถบแท็บ และแถบด้านข้างใช้สีของเนื้อหา หรือแรเงาให้ต่างออกไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başlık çubuğu, sekme çubuğu ve kenar çubuğu içeriğin renginde ya da ondan farklı gölgede."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заголовок, панель вкладок і бічна панель кольором вмісту або затінені окремо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thanh tiêu đề, thanh tab và thanh bên cùng màu với nội dung, hoặc tô bóng tách biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标题栏、标签栏和侧边栏使用内容的颜色，或与内容略有明暗区别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "標題列、分頁列和側邊欄使用內容的顏色，或以明暗區分。"
          }
        }
      }
    },
    "settings.appearance.titleAreaTone.summary": {
      "comment": "One-line summary of the Title Area setting in search results.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One color or a subtle tone for the title area"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون واحد أو درجة لونية خفيفة لمنطقة العنوان"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna boja ili blaga nijansa za područje naslova"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én farve eller en diskret tone til titelområdet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Farbe oder ein dezenter Farbton für den Titelbereich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un color o un tono sutil para el área de título"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couleur ou une teinte subtile pour la zone de titre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colore o un tono tenue per l’area del titolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル領域を単色または控えめなトーンに"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពណ៌តែមួយ ឬពណ៌ស្រាលៗ សម្រាប់តំបន់ចំណងជើង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 영역을 단색 또는 은은한 톤으로"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én farge eller en diskret tone for tittelområdet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden kolor lub subtelny odcień obszaru tytułu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cor ou um tom sutil para a área de título"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один цвет или мягкий тон для области заголовка"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีเดียวหรือโทนอ่อนๆ สำหรับพื้นที่ชื่อเรื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık alanı için tek renk veya hafif ton"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один колір або м'який тон для області заголовка"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một màu hoặc tông nhẹ cho vùng tiêu đề"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题区域使用单色或柔和色调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題區域使用單色或柔和色調"
          }
        }
      }
    },
