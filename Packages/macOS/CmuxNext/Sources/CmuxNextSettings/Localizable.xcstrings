        "en": {"stringUnit": {"state": "translated", "value": "Screenshot at once (OpenAI)"}},
        "ar": {"stringUnit": {"state": "translated", "value": "لقطة شاشة فورًا (OpenAI)"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Snimak ekrana odmah (OpenAI)"}},
        "da": {"stringUnit": {"state": "translated", "value": "Skærmbillede med det samme (OpenAI)"}},
        "de": {"stringUnit": {"state": "translated", "value": "Sofort Bildschirmfoto (OpenAI)"}},
        "es": {"stringUnit": {"state": "translated", "value": "Captura al instante (OpenAI)"}},
