    "settings.layout.newPanePlacement.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a Tab adds a tab to the focused pane. Split Automatically splits the largest pane, like New Pane (Auto Layout)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف خيار فتح علامة تبويب علامة تبويب إلى الجزء المحدد. ويقسم خيار التقسيم تلقائيًا أكبر جزء، مثل جزء جديد (تخطيط تلقائي)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori karticu dodaje karticu u fokusirano okno. Automatski podijeli dijeli najveće okno, kao Novo okno (automatski raspored)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn en fane tilføjer en fane i den fokuserede rude. Opdel automatisk opdeler den største rude, som Ny rude (automatisk layout)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Tab öffnen“ fügt dem fokussierten Bereich einen Tab hinzu. „Automatisch teilen“ teilt den größten Bereich, wie „Neuer Bereich (automatisches Layout)“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir una pestaña añade una pestaña al panel enfocado. Dividir automáticamente divide el panel más grande, como Nuevo panel (diseño automático)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un onglet ajoute un onglet au volet actif. Diviser automatiquement divise le plus grand volet, comme Nouveau volet (disposition automatique)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una scheda aggiunge una scheda al riquadro attivo. Dividi automaticamente divide il riquadro più grande, come Nuovo riquadro (layout automatico)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「タブを開く」はフォーカス中のペインにタブを追加します。「自動で分割」は「新規ペイン（自動レイアウト）」と同じく、最も大きいペインを分割します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកផ្ទាំង បន្ថែមផ្ទាំងមួយទៅផ្ទាំងដែលកំពុងផ្តោត។ បំបែកដោយស្វ័យប្រវត្តិ បំបែកផ្ទាំងធំបំផុត ដូចជា ផ្ទាំងថ្មី (ប្លង់ស្វ័យប្រវត្តិ)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 열기는 포커스된 패널에 탭을 추가합니다. 자동으로 분할은 새 패널(자동 레이아웃)처럼 가장 큰 패널을 분할합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne en fane legger til en fane i ruten med fokus. Del automatisk deler den største ruten, som Ny rute (automatisk oppsett)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz kartę dodaje kartę do aktywnego panelu. Dziel automatycznie dzieli największy panel, jak Nowy panel (układ automatyczny)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir uma aba adiciona uma aba ao painel em foco. Dividir automaticamente divide o maior painel, como Novo painel (layout automático)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Открыть вкладку» добавляет вкладку в активную панель. «Разделять автоматически» делит самую большую панель, как «Новая панель (автомакет)»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแท็บจะเพิ่มแท็บในบานที่โฟกัสอยู่ แยกโดยอัตโนมัติจะแยกบานที่ใหญ่ที่สุด เหมือนบานใหม่ (เลย์เอาต์อัตโนมัติ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekme aç, odaktaki bölmeye bir sekme ekler. Otomatik böl, Yeni Bölme (Otomatik Düzen) gibi en büyük bölmeyi böler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Відкрити вкладку» додає вкладку до активної панелі. «Ділити автоматично» ділить найбільшу панель, як «Нова панель (автомакет)»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một tab thêm một tab vào ngăn đang được chọn. Tự động chia sẽ chia ngăn lớn nhất, giống Ngăn mới (Bố cục tự động)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“打开标签页”会在当前聚焦的窗格中添加标签页。“自动拆分”会拆分最大的窗格，与“新建窗格（自动布局）”相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「開啟分頁」會在目前聚焦的窗格中新增分頁。「自動分割」會分割最大的窗格，與「新增窗格（自動版面配置）」相同。"
          }
        }
      }
    },
