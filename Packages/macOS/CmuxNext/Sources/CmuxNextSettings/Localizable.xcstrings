        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada máquina elimina los comandos registrados más antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque machine supprime les commandes enregistrées plus anciennes."
          }
