    "settings.agents.subsessions.maxDepth.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 means sub-sessions cannot start their own."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "القيمة 1 تعني أن الجلسات الفرعية لا يمكنها بدء جلسات خاصة بها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 znači da podsesije ne mogu pokretati vlastite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 betyder, at undersessioner ikke kan starte deres egne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei 1 können Untersitzungen keine eigenen starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con 1, las subsesiones no pueden iniciar las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 signifie que les sous-sessions ne peuvent pas en démarrer elles-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con 1 le sottosessioni non possono avviarne di proprie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 にすると、サブセッションは自身のサブセッションを開始できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 មានន័យថាវគ្គរងមិនអាចចាប់ផ្ដើមវគ្គរងផ្ទាល់ខ្លួនបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1이면 하위 세션이 자체 하위 세션을 시작할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 betyr at underøkter ikke kan starte sine egne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 oznacza, że podsesje nie mogą uruchamiać własnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com 1, as subsessões não podem iniciar as próprias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 — вложенные сеансы не могут запускать свои."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค่า 1 หมายถึงเซสชันย่อยเริ่มของตัวเองไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1, alt oturumların kendi alt oturumlarını başlatamayacağı anlamına gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 означає, що вкладені сеанси не можуть запускати власних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 nghĩa là phiên con không thể bắt đầu phiên con của riêng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设为 1 时，子会话不能再启动自己的子会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設為 1 時，子工作階段不能再啟動自己的子工作階段。"
          }
        }
      }
    },
