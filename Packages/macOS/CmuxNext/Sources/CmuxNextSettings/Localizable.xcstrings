    "settings.editor.lineHeight.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 computes it from the font size. A value under 8 multiplies the font size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 にするとフォントサイズから計算します。8 未満の値はフォントサイズの倍率です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‏0 يحسبه من حجم الخط. القيمة الأقل من 8 تضرب حجم الخط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 je računa iz veličine fonta. Vrijednost ispod 8 množi veličinu fonta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 beregner den ud fra skriftstørrelsen. En værdi under 8 ganger skriftstørrelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 berechnet sie aus der Schriftgröße. Ein Wert unter 8 multipliziert die Schriftgröße."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 la calcula a partir del tamaño de fuente. Un valor menor que 8 multiplica el tamaño de fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 la calcule depuis la taille de police. Une valeur inférieure à 8 multiplie la taille de police."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 la calcola dalla dimensione del carattere. Un valore sotto 8 moltiplica la dimensione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 គណនាវាពីទំហំពុម្ពអក្សរ។ តម្លៃតិចជាង 8 គុណទំហំពុម្ពអក្សរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0이면 글꼴 크기에서 계산합니다. 8 미만의 값은 글꼴 크기에 곱합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 regner den ut fra skriftstørrelsen. En verdi under 8 ganger skriftstørrelsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 oblicza ją z rozmiaru czcionki. Wartość poniżej 8 mnoży rozmiar czcionki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "0 a calcula pelo tamanho da fonte. Um valor abaixo de 8 multiplica o tamanho da fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
