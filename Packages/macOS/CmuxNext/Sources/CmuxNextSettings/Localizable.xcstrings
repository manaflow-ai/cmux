            "state": "translated",
            "value": "เก็บถาวรแชทที่ไม่มีความเคลื่อนไหว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin olmayan sohbetleri arşivle"
          }
        },
        "uk": {
