    "settings.tabs.newTabTemplate.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تخطيط صفحة علامة التبويب الجديدة. يفتح خيار الطرفية طرفية بدلًا منها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raspored stranice nove kartice. Terminal umjesto toga otvara terminal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layoutet af siden Ny fane. Terminal åbner i stedet en terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Layout der Seite „Neuer Tab“. Terminal öffnet stattdessen ein Terminal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout of the New Tab page. Terminal opens a terminal instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El diseño de la página Nueva pestaña. Terminal abre una terminal en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La disposition de la page Nouvel onglet. Terminal ouvre plutôt un terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il layout della pagina Nuova scheda. Terminale apre invece un terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新規タブページのレイアウトです。「ターミナル」は代わりにターミナルを開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្លង់នៃទំព័រផ្ទាំងថ្មី។ ទែមីណាល់បើកទែមីណាល់ជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
