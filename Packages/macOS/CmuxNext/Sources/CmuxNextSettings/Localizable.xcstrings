    "settings.sidebar.hoverCards.groups.maxMembers.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most members a group's card lists by name."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أكبر عدد من الأعضاء تذكرهم بطاقة المجموعة بالاسم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
