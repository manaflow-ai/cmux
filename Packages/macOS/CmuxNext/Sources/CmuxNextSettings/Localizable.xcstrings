    "settings.sidebar.sections.order.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar sections to show first in their part of the sidebar, in this order, by id."
          }
        },
        "ar": {
          "stringUnit": {
