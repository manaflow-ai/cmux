    "settings.browser.hibernation.summary": {
      "comment": "Settings row summary: one short line under the setting's title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees memory; history and scroll are kept"
          }
        },
        "ar": {
          "stringUnit": {
