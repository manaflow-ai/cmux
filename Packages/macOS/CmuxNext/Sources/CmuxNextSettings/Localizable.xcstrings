    "settings.labs.hostsSidebar.help": {
      "comment": "Settings > Advanced > Labs: help under the Hosts Sidebar toggle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your machines in the sidebar with Add Host and per-host terminal actions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أجهزتك في الشريط الجانبي مع «إضافة مضيف» وإجراءات الطرفية لكل مضيف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje vaše mašine u bočnoj traci, s opcijom Dodaj host i radnjama terminala za svaki host."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser dine maskiner i sidepanelet med Tilføj vært og terminalhandlinger for hver vært."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt deine Rechner in der Seitenleiste, mit „Host hinzufügen“ und Terminal-Aktionen für jeden Host."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus máquinas en la barra lateral, con Añadir host y acciones de terminal para cada host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos machines dans la barre latérale, avec Ajouter un hôte et des actions de terminal pour chaque hôte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le tue macchine nella barra laterale, con Aggiungi host e azioni del terminale per ogni host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンをサイドバーに表示し、ホストの追加とホストごとのターミナル操作を使えるようにします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញ​ម៉ាស៊ីន​របស់​អ្នក​ក្នុង​របារ​ចំហៀង ជាមួយ​បន្ថែម​ម៉ាស៊ីន​មេ និង​សកម្មភាព​ទែមីណាល់​សម្រាប់​ម៉ាស៊ីន​មេ​នីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에 컴퓨터를 표시하고 호스트 추가와 호스트별 터미널 동작을 제공합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser maskinene dine i sidefeltet med Legg til vert og terminalhandlinger for hver vert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje Twoje maszyny na pasku bocznym, z opcją Dodaj host i działaniami terminala dla każdego hosta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra suas máquinas na barra lateral, com Adicionar host e ações de terminal para cada host."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ваши компьютеры на боковой панели с кнопкой «Добавить хост» и действиями терминала для каждого хоста."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเครื่องของคุณในแถบด้านข้าง พร้อมเพิ่มโฮสต์และการทำงานเทอร์มินัลของแต่ละโฮสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinelerinizi kenar çubuğunda, Ana Bilgisayar Ekle ve her ana bilgisayar için terminal eylemleriyle gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує ваші комп'ютери на бічній панелі з кнопкою «Додати хост» і діями термінала для кожного хоста."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các máy của bạn trên thanh bên, có Thêm máy chủ và thao tác terminal cho từng máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边栏中显示你的机器，并提供添加主机和每台主机的终端操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄中顯示你的機器，並提供新增主機和每台主機的終端機操作。"
          }
        }
      }
    },
    "settings.notifications.delivery.blocked": {
      "comment": "Settings > Notifications > Delivery: row title for how cmux notifies when an agent's status turns Blocked",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agent Blocked"}},
        "ar": {"stringUnit": {"state": "translated", "value": "الوكيل محظور"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Agent blokiran"}},
        "da": {"stringUnit": {"state": "translated", "value": "Agent blokeret"}},
        "de": {"stringUnit": {"state": "translated", "value": "Agent blockiert"}},
        "es": {"stringUnit": {"state": "translated", "value": "Agente bloqueado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Agent bloqué"}},
        "it": {"stringUnit": {"state": "translated", "value": "Agente bloccato"}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントがブロック中"}},
        "km": {"stringUnit": {"state": "translated", "value": "ភ្នាក់ងារត្រូវបានរារាំង"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트 차단됨"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Agent blokkert"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Agent zablokowany"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Agente bloqueado"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Агент заблокирован"}},
        "th": {"stringUnit": {"state": "translated", "value": "เอเจนต์ถูกบล็อก"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajan engellendi"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Агент заблоковано"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tác tử bị chặn"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "智能体被阻塞"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理程式被阻擋"}}
      }
    },
    "settings.notifications.delivery.blocked.help": {
      "comment": "Settings > Notifications > Delivery: help under the Agent Blocked row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "When an agent's status turns Blocked without its own approval or question alert, as screen detection and plugins report it."}},
        "ar": {"stringUnit": {"state": "translated", "value": "عندما تصبح حالة الوكيل محظورة دون تنبيه موافقة أو سؤال خاص به، كما يبلغ عنها اكتشاف الشاشة والإضافات."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Kada status agenta postane Blokiran bez vlastitog upozorenja o odobrenju ili pitanju, kako to javljaju detekcija ekrana i dodaci."}},
        "da": {"stringUnit": {"state": "translated", "value": "Når en agents status bliver Blokeret uden sin egen godkendelses- eller spørgsmålsadvarsel, som skærmgenkendelse og plugins rapporterer det."}},
        "de": {"stringUnit": {"state": "translated", "value": "Wenn der Status eines Agenten ohne eigene Freigabe- oder Fragemeldung zu „Blockiert“ wechselt, wie Bildschirmerkennung und Plugins es melden."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuando el estado de un agente pasa a Bloqueado sin su propia alerta de aprobación o pregunta, según lo informan la detección de pantalla y los plugins."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Quand le statut d’un agent passe à Bloqué sans sa propre alerte d’approbation ou de question, tel que le signalent la détection d’écran et les plugins."}},
        "it": {"stringUnit": {"state": "translated", "value": "Quando lo stato di un agente diventa Bloccato senza un proprio avviso di approvazione o domanda, come lo segnalano il rilevamento dello schermo e i plugin."}},
        "ja": {"stringUnit": {"state": "translated", "value": "承認や質問の通知を伴わずにエージェントの状態がブロック中になったとき（画面検出やプラグインが報告するもの）。"}},
        "km": {"stringUnit": {"state": "translated", "value": "នៅពេលស្ថានភាពភ្នាក់ងារប្តូរទៅជាត្រូវបានរារាំង ដោយគ្មានការជូនដំណឹងអនុម័ត ឬសំណួររបស់វាផ្ទាល់ ដូចដែលការរកឃើញអេក្រង់ និងកម្មវិធីជំនួយរាយការណ៍។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "승인이나 질문 알림 없이 에이전트 상태가 차단됨으로 바뀔 때(화면 감지와 플러그인이 보고하는 경우)."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Når en agents status blir Blokkert uten egen godkjennings- eller spørsmålsvarsel, slik skjermgjenkjenning og programtillegg rapporterer det."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Gdy stan agenta zmienia się na Zablokowany bez własnego alertu o zatwierdzeniu lub pytaniu, tak jak zgłaszają to wykrywanie ekranu i wtyczki."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando o status de um agente muda para Bloqueado sem o próprio alerta de aprovação ou pergunta, como a detecção de tela e os plugins informam."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Когда статус агента становится «Заблокирован» без собственного уведомления об одобрении или вопросе, как сообщают распознавание экрана и плагины."}},
        "th": {"stringUnit": {"state": "translated", "value": "เมื่อสถานะของเอเจนต์เปลี่ยนเป็นถูกบล็อกโดยไม่มีการแจ้งเตือนการอนุมัติหรือคำถามของตัวเอง ตามที่การตรวจจับหน้าจอและปลั๊กอินรายงาน"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bir ajanın durumu kendi onay veya soru uyarısı olmadan Engellendi olduğunda; ekran algılama ve eklentilerin bildirdiği şekilde."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Коли статус агента стає «Заблоковано» без власного сповіщення про схвалення чи запитання, як повідомляють розпізнавання екрана й плагіни."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Khi trạng thái của tác tử chuyển sang Bị chặn mà không có cảnh báo phê duyệt hoặc câu hỏi riêng, như phát hiện màn hình và plugin báo cáo."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "当智能体状态变为被阻塞且没有自身的批准或提问提醒时（由屏幕检测和插件报告）。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "當代理程式狀態變為被阻擋且沒有其自身的核准或提問提醒時（由螢幕偵測與外掛程式回報）。"}}
      }
    },
