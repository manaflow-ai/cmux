    "settings.sidebar.chromeGroups.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنضم شارة اسم المجموعة الملونة إلى شريط أسمك بزاوية مقصوصة، وينتهي الشريط بطرف مستدير، مثل مجموعات علامات التبويب في Chrome."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obojena oznaka imena grupe spaja se s debljom šinom s isječenim uglom, a šina završava zaobljenim krajem, kao grupe kartica u Chromeu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En gruppes farvede navnemærke går sammen med en tykkere skinne med et afskåret hjørne, og skinnen ender i en afrundet kant, som Chromes fanegrupper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das farbige Namensschild einer Gruppe geht in eine dickere Leiste mit abgeschnittener Ecke über, die in einer abgerundeten Kappe endet, wie bei den Tab-Gruppen in Chrome."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group's colored name chip joins a thicker rail with a clipped corner, and the rail ends in a rounded cap, like Chrome's tab groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La etiqueta de color con el nombre del grupo se une a un riel más grueso con una esquina recortada, y el riel termina en un extremo redondeado, como los grupos de pestañas de Chrome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pastille colorée du nom d’un groupe rejoint un rail plus épais à coin coupé, et le rail se termine par un bout arrondi, comme les groupes d’onglets de Chrome."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’etichetta colorata con il nome del gruppo si unisce a una barra più spessa con un angolo tagliato, che termina con un’estremità arrotondata, come i gruppi di schede di Chrome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "グループの色付きの名前チップが、角を切り落とした太めのレールにつながり、レールの端は丸いキャップで終わります。Chromeのタブグループと同じ見た目です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្លាកឈ្មោះពណ៌របស់ក្រុមភ្ជាប់ទៅផ្លូវរថភ្លើងដែលក្រាស់ជាង មានជ្រុងកាត់ ហើយចុងផ្លូវមានមួករាងមូល ដូចក្រុមផ្ទាំងរបស់ Chrome។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그룹의 색상 이름 칩이 모서리가 잘린 더 두꺼운 레일과 이어지고, 레일 끝은 둥근 캡으로 마무리됩니다. Chrome의 탭 그룹과 같은 모양입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En gruppes fargede navnebrikke går over i en tykkere skinne med et avkuttet hjørne, og skinnen ender i en avrundet hette, som fanegruppene i Chrome."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolorowa plakietka z nazwą grupy łączy się z grubszą szyną z ściętym rogiem, a szyna kończy się zaokrąglonym zakończeniem, jak w grupach kart w Chrome."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A etiqueta colorida com o nome do grupo se junta a um trilho mais grosso com um canto cortado, e o trilho termina em uma ponta arredondada, como os grupos de abas do Chrome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цветной ярлык с названием группы соединяется с более толстой направляющей со срезанным углом, а направляющая заканчивается скруглённым краем, как у групп вкладок в Chrome."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ป้ายชื่อสีของกลุ่มเชื่อมกับแถบที่หนากว่าซึ่งมีมุมตัด และปลายแถบมน เหมือนกลุ่มแท็บของ Chrome"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grubun renkli ad etiketi, köşesi kesik daha kalın bir rayla birleşir ve ray yuvarlak bir uçla biter; tıpkı Chrome’un sekme grupları gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кольоровий ярлик з назвою групи з’єднується з товщою напрямною зі зрізаним кутом, а напрямна закінчується заокругленим краєм, як у групах вкладок Chrome."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhãn tên có màu của nhóm nối với một thanh dày hơn có góc bị cắt, và thanh kết thúc bằng đầu bo tròn, giống nhóm thẻ của Chrome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分组的彩色名称标签与带切角的较粗导轨相连，导轨末端为圆角，就像 Chrome 的标签页分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "群組的彩色名稱標籤與帶切角的較粗導軌相連，導軌末端為圓角，就像 Chrome 的標籤頁群組。"
          }
        }
      }
    },
