            "state": "translated",
            "value": "cmux web sayfalarını canlandır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімувати вебсторінки cmux"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo hoạt ảnh cho trang web của cmux"
          }
