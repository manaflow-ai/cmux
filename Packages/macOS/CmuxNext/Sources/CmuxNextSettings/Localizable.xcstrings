    "settings.agentPane.spellChecking": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التدقيق الإملائي أثناء الكتابة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeravaj pravopis tokom kucanja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér stavning under skrivning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtschreibung während der Eingabe prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Spelling While Typing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar la ortografía mientras se escribe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier l’orthographe lors de la frappe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’ortografia durante la digitazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中にスペルをチェック"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពិនិត្យអក្ខរាវិរុទ្ធពេលវាយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하는 동안 맞춤법 검사"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller stavemåte mens du skriver"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzaj pisownię podczas pisania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar ortografia ao digitar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять правописание при вводе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจการสะกดขณะพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazarken yazımı denetle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряти правопис під час введення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra chính tả khi nhập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键入时检查拼写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入時檢查拼字"
          }
        }
      }
    },
    "settings.agentPane.spellChecking.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع خطًا تحت الأخطاء الإملائية ويعرض اقتراحات النظام في محرر الرسائل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podvlači pravopisne greške i nudi sistemske prijedloge u polju za unos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Understreger stavefejl og viser systemets forslag i skrivefeltet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstreicht Rechtschreibfehler und zeigt Vorschläge des Systems im Eingabefeld an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Underlines misspellings and offers system suggestions in the composer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subraya los errores ortográficos y ofrece sugerencias del sistema en el redactor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souligne les fautes d’orthographe et propose les suggestions du système dans la zone de saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottolinea gli errori di ortografia e offre i suggerimenti di sistema nel compositore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄でスペルミスに下線を引き、システムの候補を表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គូសបន្ទាត់ពីក្រោមពាក្យសរសេរខុស ហើយផ្ដល់ការណែនាំពីប្រព័ន្ធក្នុងប្រអប់សរសេរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력창에서 맞춤법 오류에 밑줄을 긋고 시스템 제안을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Understreker stavefeil og viser systemets forslag i skrivefeltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podkreśla błędy pisowni i podpowiada sugestie systemowe w polu tworzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublinha erros de ortografia e oferece sugestões do sistema no editor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подчёркивает орфографические ошибки и предлагает системные варианты в поле ввода."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขีดเส้นใต้คำที่สะกดผิดและแสดงคำแนะนำของระบบในช่องเขียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma alanında yazım hatalarının altını çizer ve sistem önerileri sunar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підкреслює орфографічні помилки та пропонує системні варіанти в полі введення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gạch chân lỗi chính tả và đưa ra gợi ý của hệ thống trong khung soạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框中为拼写错误添加下划线，并提供系统建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框中為拼字錯誤加上底線，並提供系統建議。"
          }
        }
      }
    },
