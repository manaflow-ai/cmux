    "settings.notifications.sounds.workspaces.help": {
      "comment": "Settings > Notifications > Sounds > Workspace Sounds: help text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أصوات لكل معرّف مساحة عمل. اضبطها من قائمة مساحة العمل في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zvukovi po ID-u radnog prostora. Postavite ih iz menija radnog prostora u bočnoj traci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyde pr. arbejdsområde-id. Angiv dem i arbejdsområdets menu i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Töne pro Arbeitsbereich-ID. Im Menü des Arbeitsbereichs in der Seitenleiste festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds per workspace id. Set one from the workspace's sidebar menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sonidos por id de espacio de trabajo. Configúralos desde su menú en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sons par id d'espace de travail. À régler depuis son menu dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suoni per id dello spazio di lavoro. Impostali dal suo menu nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペース ID ごとのサウンドです。サイドバーのワークスペースのメニューから設定します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំឡេងតាម id តំបន់ការងារ។ កំណត់ពីម៉ឺនុយតំបន់ការងារក្នុងរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "워크스페이스 ID별 사운드입니다. 사이드바의 워크스페이스 메뉴에서 설정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyder per arbeidsområde-id. Angi fra arbeidsområdets meny i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dźwięki według id obszaru roboczego. Ustaw w jego menu na pasku bocznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sons por id de espaço de trabalho. Defina no menu dele na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звуки по id рабочей области. Задаются в её меню на боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เสียงตาม id ของเวิร์กสเปซ ตั้งค่าได้จากเมนูของเวิร์กสเปซในแถบด้านข้าง"
          }
        },
        "tr": {
