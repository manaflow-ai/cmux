        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របារអាសយដ្ឋានស្វែងរកនៅទីនេះ ហើយសុំការណែនាំពីវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "주소 표시줄은 여기에서 검색하고 추천 검색어를 받습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adresselinjen søker her og henter forslag herfra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasek adresu wyszukuje tutaj i pobiera stąd podpowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A barra de endereços pesquisa aqui e pede sugestões a ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Адресная строка ищет здесь и получает отсюда подсказки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบที่อยู่จะค้นหาที่นี่และขอคำแนะนำจากที่นี่"
