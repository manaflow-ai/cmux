    "settings.sidebar.workspaceIcons.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An icon for each workspace title. \"*\" sets the icon of every other workspace; an empty icon hides it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أيقونة لكل عنوان مساحة عمل. \"*\" يحدد أيقونة كل مساحة عمل أخرى؛ والأيقونة الفارغة تخفيها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikona za svaki naslov radnog prostora. \"*\" postavlja ikonu svih ostalih radnih prostora; prazna ikona je skriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et ikon for hver arbejdsområdetitel. \"*\" angiver ikonet for alle andre arbejdsområder; et tomt ikon skjuler det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Symbol pro Arbeitsbereichstitel. \"*\" legt das Symbol aller anderen Arbeitsbereiche fest; ein leeres Symbol blendet es aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un icono por cada título de espacio de trabajo. \"*\" define el icono de los demás espacios; un icono vacío lo oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une icône par titre d’espace de travail. \"*\" définit l’icône de tous les autres espaces ; une icône vide la masque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un’icona per ogni titolo di area di lavoro. \"*\" imposta l’icona di tutte le altre aree; un’icona vuota la nasconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのタイトルごとのアイコンです。\"*\" はその他すべてのワークスペースのアイコンを設定し、空のアイコンは非表示にします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបតំណាងសម្រាប់ចំណងជើងកន្លែងធ្វើការនីមួយៗ។ \"*\" កំណត់រូបតំណាងនៃកន្លែងធ្វើការផ្សេងទៀតទាំងអស់ ហើយរូបតំណាងទទេនឹងលាក់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간 제목마다 지정하는 아이콘입니다. \"*\"는 나머지 모든 작업 공간의 아이콘을 지정하며, 빈 아이콘은 아이콘을 숨깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et ikon for hver arbeidsområdetittel. \"*\" angir ikonet for alle andre arbeidsområder; et tomt ikon skjuler det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikona dla każdego tytułu obszaru roboczego. \"*\" ustawia ikonę wszystkich pozostałych obszarów; pusta ikona ją ukrywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um ícone para cada título de espaço de trabalho. \"*\" define o ícone de todos os outros; um ícone vazio o oculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Значок для каждого названия рабочего пространства. \"*\" задаёт значок всех остальных; пустой значок скрывает его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไอคอนสำหรับชื่อพื้นที่ทำงานแต่ละชื่อ \"*\" กำหนดไอคอนของพื้นที่ทำงานอื่นทั้งหมด ไอคอนว่างจะซ่อนไอคอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her çalışma alanı başlığı için bir simge. \"*\" diğer tüm çalışma alanlarının simgesini belirler; boş simge onu gizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Значок для кожної назви робочого простору. \"*\" задає значок усіх інших; порожній значок приховує його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một biểu tượng cho mỗi tiêu đề không gian làm việc. \"*\" đặt biểu tượng cho mọi không gian khác; biểu tượng trống sẽ ẩn nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个工作区标题对应一个图标。\"*\" 设置其他所有工作区的图标；空图标会将其隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
