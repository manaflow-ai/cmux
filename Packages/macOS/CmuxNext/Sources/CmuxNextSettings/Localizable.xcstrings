    "settings.labs.voiceRoom.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "غرفة غير رسمية تتحدث فيها مع الآخرين ومع Chief. أثناء فتح الغرفة، يحوّل cmux صوت الميكروفون إلى نص ويقرأ نص شاشتك على هذا الـMac، ثم يرسل ذلك النص إلى الغرفة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neslužbena soba u kojoj razgovarate s ljudima i Chiefom. Dok je soba otvorena, cmux na ovom Macu pretvara vaš mikrofon u tekst i čita tekst s ekrana, zatim taj tekst šalje u sobu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et uofficielt rum, hvor du taler med folk og Chief. Mens et rum er åbent, transskriberer cmux din mikrofon og læser skærmens tekst på denne Mac og sender teksten til rummet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein inoffizieller Raum, in dem du mit Menschen und Chief sprichst. Solange ein Raum offen ist, transkribiert cmux dein Mikrofon und liest den Text deines Bildschirms auf diesem Mac und sendet diesen Text an den Raum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unofficial room where you talk with people and Chief. While a room is open, cmux transcribes your mic and reads your screen's text on this Mac, then sends that text to the room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una sala no oficial donde hablas con personas y con Chief. Mientras la sala está abierta, cmux transcribe tu micrófono y lee el texto de tu pantalla en este Mac, y envía ese texto a la sala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une salle non officielle où vous parlez avec des personnes et avec Chief. Tant qu’une salle est ouverte, cmux transcrit votre micro et lit le texte de votre écran sur ce Mac, puis envoie ce texte à la salle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una stanza non ufficiale dove parli con le persone e con Chief. Mentre una stanza è aperta, cmux trascrive il microfono e legge il testo dello schermo su questo Mac, poi invia quel testo alla stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "人や Chief と話す非公式のルームです。ルームを開いている間、cmux はこの Mac 上でマイクを文字に起こし、画面のテキストを読み取って、そのテキストをルームに送ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ទប់មិនផ្លូវការដែលអ្នកនិយាយជាមួយមនុស្ស និង Chief។ ពេលបន្ទប់បើក cmux បំលែងសំឡេងមីក្រូហ្វូនជាអត្ថបទ និងអានអត្ថបទលើអេក្រង់នៅលើ Mac នេះ រួចផ្ញើអត្ថបទនោះទៅបន្ទប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사람들, Chief와 대화하는 비공식 룸입니다. 룸이 열려 있는 동안 cmux는 이 Mac에서 마이크를 받아쓰고 화면의 텍스트를 읽은 다음 그 텍스트를 룸으로 보냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et uoffisielt rom der du snakker med folk og Chief. Mens et rom er åpent, transkriberer cmux mikrofonen din og leser skjermteksten på denne Macen, og sender teksten til rommet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nieoficjalny pokój, w którym rozmawiasz z ludźmi i z Chiefem. Gdy pokój jest otwarty, cmux na tym Macu transkrybuje mikrofon i odczytuje tekst z ekranu, a potem wysyła ten tekst do pokoju."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma sala não oficial onde você conversa com pessoas e com o Chief. Enquanto a sala está aberta, o cmux transcreve seu microfone e lê o texto da sua tela neste Mac, depois envia esse texto para a sala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Неофициальная комната, где вы говорите с людьми и с Chief. Пока комната открыта, cmux на этом Mac расшифровывает микрофон и читает текст с экрана, а затем отправляет этот текст в комнату."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ห้องที่ไม่เป็นทางการสำหรับคุยกับผู้คนและ Chief ขณะที่ห้องเปิดอยู่ cmux จะถอดเสียงจากไมค์และอ่านข้อความบนหน้าจอใน Mac เครื่องนี้ แล้วส่งข้อความนั้นไปยังห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İnsanlarla ve Chief ile konuştuğunuz resmî olmayan bir oda. Oda açıkken cmux bu Mac'te mikrofonunuzu yazıya döker ve ekranınızdaki metni okur, sonra bu metni odaya gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Неофіційна кімната, де ви розмовляєте з людьми та з Chief. Поки кімната відкрита, cmux на цьому Mac розшифровує мікрофон і читає текст з екрана, а потім надсилає цей текст у кімнату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một phòng không chính thức để bạn nói chuyện với mọi người và Chief. Khi phòng đang mở, cmux chép lời micrô và đọc chữ trên màn hình của bạn ngay trên máy Mac này, rồi gửi văn bản đó vào phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一个非官方房间，你可以在其中与他人和 Chief 交谈。房间打开期间，cmux 会在这台 Mac 上转写你的麦克风并读取屏幕上的文字，然后把这些文字发送到房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一個非官方房間，你可以在其中與他人和 Chief 交談。房間開啟期間，cmux 會在這台 Mac 上轉寫你的麥克風並讀取螢幕上的文字，然後把這些文字傳送到房間。"
          }
        }
      }
    },
