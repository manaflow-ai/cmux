          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La larghezza massima di una scheda quando la barra ha spazio."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទទឹងធំបំផុតរបស់ផ្ទាំង នៅពេលរបារមានកន្លែង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 바에 공간이 있을 때 탭이 넓어질 수 있는 최대 너비입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den største bredden en fane får når linjen har plass."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Największa szerokość karty, gdy pasek ma miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A largura máxima de uma aba quando a barra tem espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наибольшая ширина вкладки, когда на панели есть место."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความกว้างสูงสุดของแท็บเมื่อแถบมีพื้นที่เหลือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şeritte yer olduğunda bir sekmenin alabileceği en büyük genişlik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
