    "settings.computerUse.mode.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "What agents may do with the apps on this Mac. Denied apps are never used, in any mode."}},
        "ar": {"stringUnit": {"state": "translated", "value": "ما يمكن للوكلاء فعله بالتطبيقات على هذا الـ Mac. لا تُستخدم التطبيقات المرفوضة أبدًا في أي وضع."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Šta agenti smiju raditi s aplikacijama na ovom Macu. Odbijene aplikacije se nikad ne koriste, ni u jednom načinu."}},
        "da": {"stringUnit": {"state": "translated", "value": "Hvad agenter må gøre med apps på denne Mac. Afviste apps bruges aldrig, uanset tilstand."}},
        "de": {"stringUnit": {"state": "translated", "value": "Was Agenten mit den Apps auf diesem Mac tun dürfen. Gesperrte Apps werden in keinem Modus verwendet."}},
        "es": {"stringUnit": {"state": "translated", "value": "Lo que los agentes pueden hacer con las apps de este Mac. Las apps denegadas nunca se usan, en ningún modo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce que les agents peuvent faire avec les apps de ce Mac. Les apps refusées ne sont jamais utilisées, quel que soit le mode."}},
        "it": {"stringUnit": {"state": "translated", "value": "Cosa possono fare gli agenti con le app di questo Mac. Le app negate non vengono mai usate, in nessuna modalità."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このMacのアプリでエージェントができること。拒否したアプリはどのモードでも使われません。"}},
        "km": {"stringUnit": {"state": "translated", "value": "អ្វីដែលភ្នាក់ងារអាចធ្វើជាមួយកម្មវិធីនៅលើ Mac នេះ។ កម្មវិធីដែលបានបដិសេធមិនត្រូវបានប្រើទេ ក្នុងរបៀបណាក៏ដោយ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트가 이 Mac의 앱으로 할 수 있는 일입니다. 거부된 앱은 어떤 모드에서도 사용되지 않습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Hva agenter kan gjøre med appene på denne Macen. Avviste apper brukes aldri, uansett modus."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Co agenci mogą robić z aplikacjami na tym Macu. Odrzucone aplikacje nigdy nie są używane, w żadnym trybie."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O que os agentes podem fazer com os apps deste Mac. Apps negados nunca são usados, em nenhum modo."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Что агенты могут делать с приложениями на этом Mac. Запрещённые приложения не используются ни в одном режиме."}},
        "th": {"stringUnit": {"state": "translated", "value": "สิ่งที่เอเจนต์ทำได้กับแอปบน Mac เครื่องนี้ แอปที่ปฏิเสธจะไม่ถูกใช้ไม่ว่าในโหมดใด"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajanların bu Mac'teki uygulamalarla neler yapabileceği. Reddedilen uygulamalar hiçbir modda kullanılmaz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Що агенти можуть робити з програмами на цьому Mac. Заборонені програми не використовуються в жодному режимі."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Những gì tác nhân được làm với các ứng dụng trên máy Mac này. Ứng dụng bị từ chối không bao giờ được dùng, ở bất kỳ chế độ nào."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "智能体可对这台 Mac 上的应用执行的操作。被拒绝的应用在任何模式下都不会被使用。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理程式可對這台 Mac 上的 App 進行的操作。被拒絕的 App 在任何模式下都不會被使用。"}}
      }
    },
