    "settings.sidebar.noFade": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "إظهار الشريط الجانبي كاملا دون تلاشٍ"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Prikaži cijelu bočnu traku bez prelaza"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Vis hele sidepanelet uden udtoning"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gesamte Seitenleiste ohne Verblassen zeigen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Show Whole Sidebar Without Fade"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Mostrar toda la barra lateral sin desvanecimiento"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Afficher toute la barre latérale sans fondu"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Mostra tutta la barra laterale senza sfumatura"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーを全体表示（フェードなし）"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញរបារចំហៀងទាំងមូលដោយគ្មានការស្រអាប់"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "페이드 없이 사이드바 전체 표시"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Vis hele sidepanelet uten uttoning"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pokaż cały pasek boczny bez zanikania"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostrar a barra lateral inteira sem desvanecimento"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Показывать всю боковую панель без затемнения"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงแถบด้านข้างทั้งหมดโดยไม่มีการจางหาย"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğunu solma olmadan tam göster"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Показувати всю бічну панель без затухання"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hiển thị toàn bộ thanh bên, không mờ dần"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无渐隐显示整个侧边栏"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無漸隱顯示整個側邊欄"}}
      }
    },
    "settings.sidebar.noFade.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوقف تلاشي حواف الشريط الجانبي ويُخفي شريط الملف الشخصي والبحث في الأسفل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ivice bočne trake prestaju da blijede, a donja traka profila i pretrage se skriva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stopper udtoningen af sidepanelets kanter og skjuler den nederste profil- og søgelinje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kanten der Seitenleiste verblassen nicht mehr, und die untere Profil- und Suchleiste wird ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the sidebar's edges fading and hides the bottom profile and search bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los bordes de la barra lateral dejan de desvanecerse y se oculta la barra inferior de perfil y búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les bords de la barre latérale ne s'estompent plus et la barre inférieure du profil et de la recherche est masquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toglie la sfumatura ai bordi della barra laterale e nasconde la barra inferiore di profilo e ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーの端のフェードをなくし、下部のプロフィールと検索バーを非表示にします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ឈប់ការស្រអាប់គែមរបារចំហៀង ហើយលាក់របារប្រវត្តិរូប និងស្វែងរកនៅខាងក្រោម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바 가장자리가 흐려지지 않고 아래쪽 프로필 및 검색 막대를 숨깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kantene på sidepanelet slutter å tones ut, og den nederste profil- og søkelinjen skjules."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krawędzie paska bocznego przestają zanikać, a dolny pasek profilu i wyszukiwania znika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impede que as bordas da barra lateral desvaneçam e oculta a barra inferior de perfil e busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Края боковой панели перестают затемняться, а нижняя панель профиля и поиска скрывается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอบแถบด้านข้างจะไม่จางหาย และซ่อนแถบโปรไฟล์และค้นหาด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğunun kenarlarının solmasını durdurur ve alttaki profil ve arama çubuğunu gizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимикає затухання країв бічної панелі й приховує нижню панель профілю і пошуку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mép thanh bên không còn mờ dần, và thanh hồ sơ và tìm kiếm ở dưới bị ẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "侧边栏边缘不再渐隐，并隐藏底部的个人资料和搜索栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄邊緣不再漸隱，並隱藏底部的個人資料和搜尋列。"
          }
        }
      }
    },
