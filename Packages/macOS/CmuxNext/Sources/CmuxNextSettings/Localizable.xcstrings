          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um arquivo de tema em ~/.config/cmux/themes, como \"tokyo\" para tokyo.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл темы в ~/.config/cmux/themes, например \"tokyo\" для tokyo.json."
          }
        },
        "th": {
          "stringUnit": {
