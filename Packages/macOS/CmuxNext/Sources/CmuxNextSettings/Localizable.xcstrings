            "value": "អនុញ្ញាតឱ្យភ្នាក់ងារចាប់ផ្ដើមវគ្គរង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 하위 세션을 시작하도록 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La agenter starte underøkter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwalaj agentom uruchamiać podsesje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que agentes iniciem subsessões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить агентам запускать вложенные сеансы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เอเจนต์เริ่มเซสชันย่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanların alt oturum başlatmasına izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити агентам запускати вкладені сеанси"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác tử bắt đầu phiên con"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许智能体启动子会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許代理程式啟動子工作階段"
          }
        }
      }
    },
    "settings.agents.subsessions.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent can start other agent sessions to work on parts of a task in parallel. They show under its session in the sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للوكيل بدء جلسات وكلاء أخرى للعمل على أجزاء من مهمة بالتوازي. تظهر تحت جلسته في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent može pokrenuti druge sesije agenata da paralelno rade na dijelovima zadatka. Prikazuju se ispod njegove sesije na bočnoj traci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent kan starte andre agentsessioner, der arbejder på dele af en opgave parallelt. De vises under dens session i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent kann weitere Agentensitzungen starten, die parallel an Teilen einer Aufgabe arbeiten. Sie erscheinen in der Seitenleiste unter seiner Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente puede iniciar otras sesiones de agentes para trabajar en partes de una tarea en paralelo. Aparecen bajo su sesión en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent peut démarrer d’autres sessions d’agents pour travailler en parallèle sur des parties d’une tâche. Elles s’affichent sous sa session dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente può avviare altre sessioni di agenti per lavorare in parallelo su parti di un’attività. Vengono mostrate sotto la sua sessione nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは別のエージェントセッションを開始して、タスクの一部を並行して進められます。それらはサイドバーで元のセッションの下に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារអាចចាប់ផ្ដើមវគ្គភ្នាក់ងារផ្សេងទៀត ដើម្បីធ្វើការលើផ្នែកនៃកិច្ចការស្របគ្នា។ ពួកវាបង្ហាញនៅក្រោមវគ្គរបស់វានៅក្នុងរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 다른 에이전트 세션을 시작해 작업의 일부를 병렬로 처리할 수 있습니다. 이 세션은 사이드바에서 해당 세션 아래에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent kan starte andre agentøkter som arbeider parallelt med deler av en oppgave. De vises under økten dens i sidefeltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent może uruchamiać inne sesje agentów, które równolegle pracują nad częściami zadania. Pojawiają się pod jego sesją na pasku bocznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente pode iniciar outras sessões de agentes para trabalhar em partes de uma tarefa em paralelo. Elas aparecem sob a sessão dele na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент может запускать другие сеансы агентов, чтобы параллельно работать над частями задачи. Они отображаются под его сеансом в боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์สามารถเริ่มเซสชันเอเจนต์อื่นเพื่อทำส่วนต่างๆ ของงานไปพร้อมกัน เซสชันเหล่านั้นจะแสดงใต้เซสชันของเอเจนต์ในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ajan, bir görevin parçaları üzerinde paralel çalışmak için başka ajan oturumları başlatabilir. Bunlar kenar çubuğunda onun oturumunun altında görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент може запускати інші сеанси агентів, щоб паралельно працювати над частинами завдання. Вони показуються під його сеансом на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác tử có thể bắt đầu các phiên tác tử khác để làm song song từng phần của một tác vụ. Các phiên này hiện bên dưới phiên của nó trong thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可以启动其他智能体会话，并行处理任务的各个部分。它们显示在边栏中该会话的下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式可以啟動其他代理程式工作階段，平行處理工作的各個部分。它們會顯示在側邊欄中該工作階段的下方。"
          }
        }
      }
    },
    "settings.agents.subsessions.maxChildren": {
      "extractionState": "manual",
      "localizations": {
