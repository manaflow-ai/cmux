    "settings.browser.hibernation.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees memory; history and position are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メモリを解放します。履歴と位置は保持されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحرر الذاكرة؛ ويُحتفظ بالسجل والموضع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oslobađa memoriju; historija i položaj ostaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Frigør hukommelse; historik og position bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gibt Speicher frei; Verlauf und Position bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libera memoria; se conservan el historial y la posición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libère de la mémoire ; l’historique et la position sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libera memoria; cronologia e posizione restano."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បញ្ចេញអង្គចងចាំ; ប្រវត្តិ និងទីតាំងត្រូវបានរក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메모리를 확보하며 기록과 위치는 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Frigjør minne; historikk og posisjon beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwalnia pamięć; historia i pozycja zostają zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Libera memória; histórico e posição são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Освобождает память; история и позиция сохраняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คืนหน่วยความจำ โดยยังเก็บประวัติและตำแหน่งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belleği boşaltır; geçmiş ve konum korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звільняє пам’ять; історія та позиція зберігаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giải phóng bộ nhớ; lịch sử và vị trí được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "释放内存；保留历史记录和位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "釋放記憶體；保留瀏覽記錄與位置。"
          }
        }
      }
    },
