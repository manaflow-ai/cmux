    "settings.computerUse.settle.anthropic": {
      "comment": "Settings > Computer Use > After Each Action: Anthropic's reference loop, a fixed 2 s wait",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Fixed 2 s, then screenshot (Anthropic)"}},
        "ar": {"stringUnit": {"state": "translated", "value": "ثانيتان ثابتتان ثم لقطة شاشة (Anthropic)"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Fiksne 2 s, zatim snimak ekrana (Anthropic)"}},
        "da": {"stringUnit": {"state": "translated", "value": "Faste 2 s, derefter skærmbillede (Anthropic)"}},
        "de": {"stringUnit": {"state": "translated", "value": "Feste 2 s, dann Bildschirmfoto (Anthropic)"}},
        "es": {"stringUnit": {"state": "translated", "value": "2 s fijos y luego captura (Anthropic)"}},
        "fr": {"stringUnit": {"state": "translated", "value": "2 s fixes, puis capture d’écran (Anthropic)"}},
        "it": {"stringUnit": {"state": "translated", "value": "2 s fissi, poi screenshot (Anthropic)"}},
        "ja": {"stringUnit": {"state": "translated", "value": "固定2秒後にスクリーンショット（Anthropic）"}},
        "km": {"stringUnit": {"state": "translated", "value": "២ វិនាទីថេរ បន្ទាប់មកថតអេក្រង់ (Anthropic)"}},
        "ko": {"stringUnit": {"state": "translated", "value": "고정 2초 후 스크린샷(Anthropic)"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Faste 2 s, deretter skjermbilde (Anthropic)"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Stałe 2 s, potem zrzut ekranu (Anthropic)"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "2 s fixos, depois captura de tela (Anthropic)"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Фиксированные 2 с, затем снимок экрана (Anthropic)"}},
        "th": {"stringUnit": {"state": "translated", "value": "2 วินาทีคงที่ แล้วจับภาพหน้าจอ (Anthropic)"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Sabit 2 sn, sonra ekran görüntüsü (Anthropic)"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Фіксовані 2 с, потім знімок екрана (Anthropic)"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Cố định 2 giây, rồi chụp màn hình (Anthropic)"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "固定 2 秒后截图（Anthropic）"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "固定 2 秒後截圖（Anthropic）"}}
      }
    },
    "settings.computerUse.settle.openai": {
      "comment": "Settings > Computer Use > After Each Action: OpenAI's reference loop, no wait",
      "extractionState": "manual",
