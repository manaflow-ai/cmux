            "value": "Biten ve kapatılan alt oturumlar sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершені й закриті вкладені сеанси не враховуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
