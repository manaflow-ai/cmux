    "settings.labs.appStore.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفّح تطبيقات cmux وثبّتها وحدّثها. لا يزال قيد التطوير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledajte, instalirajte i ažurirajte aplikacije za cmux. Još se oblikuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemse, installer og opdater apps til cmux. Stadig under udformning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps für cmux durchsuchen, installieren und aktualisieren. Noch in Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse, install and update apps for cmux. Still being shaped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora, instala y actualiza apps para cmux. Aún en desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez, installez et mettez à jour des apps pour cmux. Encore en cours de conception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia, installa e aggiorna le app per cmux. Ancora in lavorazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 用のアプリを探して、インストール・アップデートします。まだ開発中です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រុករក ដំឡើង និងធ្វើបច្ចុប្បន្នភាពកម្មវិធីសម្រាប់ cmux។ នៅកំពុងរៀបចំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux용 앱을 둘러보고 설치하고 업데이트합니다. 아직 다듬는 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bla gjennom, installer og oppdater apper for cmux. Fortsatt under utforming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj, instaluj i aktualizuj aplikacje dla cmux. Wciąż w przygotowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore, instale e atualize apps para o cmux. Ainda em desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр, установка и обновление приложений для cmux. Ещё в разработке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกดู ติดตั้ง และอัปเดตแอปสำหรับ cmux ยังอยู่ระหว่างพัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux için uygulamalara göz atın, yükleyin ve güncelleyin. Hâlâ geliştiriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд, встановлення та оновлення застосунків для cmux. Ще в розробці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt, cài đặt và cập nhật ứng dụng cho cmux. Vẫn đang hoàn thiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览、安装和更新 cmux 的应用。仍在完善中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽、安裝和更新 cmux 的 App。仍在完善中。"
          }
        }
      }
    },
