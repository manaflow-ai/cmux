        "tr": {"stringUnit": {"state": "needs_review", "value": "Yönlendir"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Спрямувати"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Điều hướng"}},
