    "settings.browser.enabled.help": {
      "comment": "Help text of the Enable cmux Browser settings row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: every link opens in your default browser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند الإيقاف: يُفتح كل رابط في متصفحك الافتراضي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno: svaki link se otvara u vašem zadanom pregledniku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra: alle links åbnes i din standardbrowser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus: Jeder Link öffnet sich in deinem Standardbrowser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado: cada enlace se abre en tu navegador predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé : chaque lien s’ouvre dans votre navigateur par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato: ogni link si apre nel browser predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフにすると、すべてのリンクがデフォルトのブラウザで開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ៖ តំណនីមួយៗបើកក្នុងកម្មវិធីរុករកលំនាំដើមរបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끄면 모든 링크가 기본 브라우저에서 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av: alle lenker åpnes i standardnettleseren din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączone: każdy link otwiera się w domyślnej przeglądarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado: todo link abre no seu navegador padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выкл.: каждая ссылка открывается в браузере по умолчанию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิด: ทุกลิงก์จะเปิดในเบราว์เซอร์เริ่มต้นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı: her bağlantı varsayılan tarayıcınızda açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо вимкнено, кожне посилання відкривається у браузері за замовчуванням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt: mọi liên kết mở trong trình duyệt mặc định của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭：所有链接都会在默认浏览器中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉：所有連結都會在你的預設瀏覽器中開啟。"
          }
        }
      }
    },
