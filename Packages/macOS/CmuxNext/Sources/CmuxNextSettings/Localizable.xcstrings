          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis faner for arbeidsområde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż karty przestrzeni roboczych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar abas das áreas de trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать вкладки рабочих пространств"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงแท็บเวิร์กสเปซ"
          }
        },
        "tr": {
          "stringUnit": {
