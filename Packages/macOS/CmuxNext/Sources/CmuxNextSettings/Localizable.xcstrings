    "settings.agents.guidance.claude.help": {
      "comment": "Settings > Agents > Guidance and Skills: toggle help",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells new Claude Code chats how cmux shows plans, side sessions and recaps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُعرّف محادثات Claude Code الجديدة بكيفية عرض cmux للخطط والجلسات الجانبية والملخصات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Govori novim Claude Code razgovorima kako cmux prikazuje planove, sporedne sesije i sažetke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortæller nye Claude Code-chats, hvordan cmux viser planer, sidesessioner og opsummeringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erklärt neuen Claude-Code-Chats, wie cmux Pläne, Nebensitzungen und Zusammenfassungen zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indica a los chats nuevos de Claude Code cómo muestra cmux los planes, las sesiones paralelas y los resúmenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indique aux nouvelles discussions Claude Code comment cmux affiche les plans, les sessions annexes et les récapitulatifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indica alle nuove chat di Claude Code come cmux mostra piani, sessioni laterali e riepiloghi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい Claude Code チャットに、cmux が計画、サイドセッション、まとめをどう表示するかを伝えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រាប់ការជជែក Claude Code ថ្មីពីរបៀបដែល cmux បង្ហាញផែនការ វគ្គចំហៀង និងសេចក្តីសង្ខេប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 Claude Code 채팅에 cmux가 계획, 보조 세션, 요약을 보여 주는 방식을 안내합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forteller nye Claude Code-chatter hvordan cmux viser planer, sidesesjoner og oppsummeringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mówi nowym czatom Claude Code, jak cmux pokazuje plany, sesje poboczne i podsumowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Informa aos novos chats do Claude Code como o cmux mostra planos, sessões paralelas e resumos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сообщает новым чатам Claude Code, как cmux показывает планы, побочные сессии и сводки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แจ้งแชท Claude Code ใหม่ว่า cmux แสดงแผน เซสชันข้างเคียง และสรุปอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni Claude Code sohbetlerine cmux'un planları, yan oturumları ve özetleri nasıl gösterdiğini anlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пояснює новим чатам Claude Code, як cmux показує плани, бокові сесії та підсумки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho các cuộc trò chuyện Claude Code mới biết cmux hiển thị kế hoạch, phiên phụ và phần tóm tắt như thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "告诉新的 Claude Code 聊天 cmux 如何呈现计划、旁支会话和摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "告訴新的 Claude Code 聊天 cmux 如何呈現計畫、旁支工作階段與摘要。"
          }
        }
      }
    },
