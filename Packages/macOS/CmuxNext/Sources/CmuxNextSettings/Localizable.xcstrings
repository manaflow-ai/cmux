    "settings.updates.idleInstallQuiet.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the keyboard and mouse must be idle before a downloaded nightly installs by itself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يجب أن تبقى فيها لوحة المفاتيح والماوس دون استخدام قبل أن يُثبَّت إصدار nightly الذي تم تنزيله تلقائيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko dugo tastatura i miš moraju mirovati prije nego što se preuzeti nightly sam instalira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor længe tastatur og mus skal være uberørt, før en hentet nightly installeres af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange Tastatur und Maus unbenutzt sein müssen, bevor sich ein heruntergeladenes Nightly selbst installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo deben estar inactivos el teclado y el ratón antes de que una nightly descargada se instale sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle le clavier et la souris doivent rester inactifs avant qu'une nightly téléchargée s'installe d'elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo tastiera e mouse devono restare inattivi prima che una nightly scaricata si installi da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みの nightly が自動でインストールされる前に、キーボードとマウスが操作されていない必要がある時間。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រយៈពេលដែលក្ដារចុច និងកណ្ដុរត្រូវតែនៅទំនេរ មុនពេលកំណែ nightly ដែលបានទាញយកដំឡើងដោយខ្លួនឯង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드된 nightly가 스스로 설치되기 전에 키보드와 마우스가 사용되지 않아야 하는 시간입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lenge tastatur og mus må være uvirksomme før en nedlastet nightly installeres av seg selv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo klawiatura i mysz muszą być bezczynne, zanim pobrana wersja nightly zainstaluje się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo o teclado e o mouse devem ficar ociosos antes que uma nightly baixada se instale sozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько времени клавиатура и мышь должны бездействовать, прежде чем загруженная nightly-сборка установится сама."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาที่คีย์บอร์ดและเมาส์ต้องไม่ถูกใช้งาน ก่อนที่ nightly ที่ดาวน์โหลดแล้วจะติดตั้งเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen nightly kendiliğinden yüklenmeden önce klavye ve farenin ne kadar süre boşta kalması gerektiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки часу клавіатура й миша мають бездіяти, перш ніж завантажена nightly-збірка встановиться сама."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím và chuột phải không được dùng trong bao lâu trước khi bản nightly đã tải xuống tự cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的 nightly 自动安装前，键盘和鼠标需要保持空闲的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載的 nightly 自動安裝前，鍵盤和滑鼠需要保持閒置的時長。"
          }
        }
      }
    },
