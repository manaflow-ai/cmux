    "settings.agents.modelRouter.model": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج موجّه نماذج cmux"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model cmux usmjerivača modela"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Model for cmux-modelrouteren"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell des cmux-Modellrouters"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Model Router Model"
          }
        },
