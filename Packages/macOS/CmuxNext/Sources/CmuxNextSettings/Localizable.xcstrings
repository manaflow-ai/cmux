    "settings.agentPane.outsideRoots.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما يفعله رابط إلى ملف خارج مجلدات الدردشة. لا تُفتح المفاتيح وملفات ‎.env أبدًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šta radi link na datoteku izvan foldera chata. Ključevi i .env datoteke se nikad ne otvaraju."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvad et link til en fil uden for chattens mapper gør. Nøgler og .env-filer åbnes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was ein Link zu einer Datei außerhalb der Ordner des Chats tut. Schlüssel und .env-Dateien öffnen sich nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a link to a file outside the chat's folders does. Keys and .env files never open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qué hace un enlace a un archivo fuera de las carpetas del chat. Las claves y los archivos .env nunca se abren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce que fait un lien vers un fichier hors des dossiers du chat. Les clés et les fichiers .env ne s’ouvrent jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cosa fa un link a un file fuori dalle cartelle della chat. Chiavi e file .env non si aprono mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チャットのフォルダ外のファイルへのリンクの動作です。鍵と .env ファイルは開きません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "អ្វីដែលតំណទៅឯកសារនៅក្រៅថតនៃការជជែកធ្វើ។ កូនសោ និងឯកសារ .env មិនដែលបើកទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "채팅 폴더 밖의 파일을 가리키는 링크의 동작입니다. 키와 .env 파일은 열리지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hva en lenke til en fil utenfor chattens mapper gjør. Nøkler og .env-filer åpnes aldri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Co robi link do pliku spoza folderów czatu. Klucze i pliki .env nigdy się nie otwierają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O que um link para um arquivo fora das pastas do chat faz. Chaves e arquivos .env nunca abrem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Что делает ссылка на файл вне папок чата. Ключи и файлы .env никогда не открываются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สิ่งที่ลิงก์ไปยังไฟล์นอกโฟลเดอร์ของแชตทำ คีย์และไฟล์ .env จะไม่เปิดเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sohbetin klasörleri dışındaki bir dosyaya giden bağlantının ne yaptığı. Anahtarlar ve .env dosyaları asla açılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Що робить посилання на файл поза папками чату. Ключі та файли .env ніколи не відкриваються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Liên kết đến tệp nằm ngoài các thư mục của cuộc trò chuyện làm gì. Khóa và tệp .env không bao giờ mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "指向聊天文件夹以外文件的链接的行为。密钥和 .env 文件永远不会打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "指向聊天資料夾以外檔案的連結的行為。金鑰和 .env 檔案永遠不會開啟。"
          }
        }
      }
    },
