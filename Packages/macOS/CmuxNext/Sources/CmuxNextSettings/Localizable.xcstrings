    "settings.computerUse.livePreview.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small live view of the app an agent uses. Click it for Agent Activity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントが使っているアプリの小さなライブビュー。クリックするとエージェントのアクティビティが開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عرض مباشر صغير للتطبيق الذي يستخدمه الوكيل. انقر عليه لفتح نشاط الوكيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mali prikaz uživo aplikacije koju agent koristi. Kliknite ga za Aktivnost agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En lille livevisning af den app, en agent bruger. Klik på den for Agentaktivitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine kleine Live-Ansicht der App, die ein Agent verwendet. Klicke darauf für die Agentenaktivität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una pequeña vista en directo de la app que usa un agente. Haz clic en ella para abrir Actividad de agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un petit aperçu en direct de l'app qu'utilise un agent. Cliquez dessus pour Activité des agents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una piccola vista dal vivo dell'app usata da un agente. Fai clic per aprire Attività degli agenti."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទិដ្ឋភាពផ្ទាល់តូចមួយនៃកម្មវិធីដែលភ្នាក់ងារប្រើ។ ចុចវាដើម្បីបើកសកម្មភាពភ្នាក់ងារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 사용하는 앱의 작은 실시간 보기입니다. 클릭하면 에이전트 활동이 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En liten direktevisning av appen en agent bruker. Klikk på den for Agentaktivitet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mały podgląd na żywo aplikacji, której używa agent. Kliknij go, aby otworzyć Aktywność agentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma pequena visualização ao vivo do app que um agente usa. Clique nela para abrir Atividade de agentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Небольшой живой вид приложения, с которым работает агент. Нажмите на него, чтобы открыть Активность агентов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มุมมองสดขนาดเล็กของแอปที่เอเจนต์ใช้ คลิกเพื่อเปิดกิจกรรมของเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir ajanın kullandığı uygulamanın küçük bir canlı görünümü. Ajan etkinliği için tıkla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невеликий живий вигляд застосунку, з яким працює агент. Натисніть на нього, щоб відкрити Активність агентів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khung xem trực tiếp nhỏ của ứng dụng mà tác tử đang dùng. Nhấp vào để mở Hoạt động của tác tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理所用应用的小型实时视图。点按可打开代理活动。"
          }
