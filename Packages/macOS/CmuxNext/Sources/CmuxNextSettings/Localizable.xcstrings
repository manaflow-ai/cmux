    "settings.sidebar.controlsOnHover": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "إظهار عناصر تحكم الشريط الجانبي عند التمرير فقط"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Prikaži kontrole bočne trake samo pri prelasku"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Vis kun sidepanelets knapper ved markør"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Seitenleisten-Steuerelemente nur beim Überfahren zeigen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Show Sidebar Controls Only on Hover"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Mostrar los controles de la barra lateral solo al pasar el puntero"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Afficher les commandes de la barre latérale uniquement au survol"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Mostra i controlli della barra laterale solo al passaggio"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーのコントロールをポインタを置いたときだけ表示"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញការគ្រប់គ្រងរបារចំហៀងតែពេលដាក់ទស្សន៍ទ្រនិច"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "호버할 때만 사이드바 컨트롤 표시"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Vis sidepanelkontroller bare ved peker"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pokazuj elementy paska bocznego tylko po najechaniu"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostrar os controles da barra lateral só ao passar o ponteiro"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Показывать элементы боковой панели только при наведении"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงตัวควบคุมแถบด้านข้างเฉพาะเมื่อวางเมาส์"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğu denetimlerini yalnızca üzerine gelince göster"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Показувати елементи бічної панелі лише при наведенні"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chỉ hiện điều khiển thanh bên khi di chuột"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "仅在悬停时显示侧边栏控件"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "僅在懸停時顯示側邊欄控制項"}}
      }
    },
    "settings.sidebar.controlsOnHover.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر أزرار الشريط الجانبي فقط عندما يكون المؤشر فوقه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dugmad bočne trake prikazuju se samo dok je pokazivač iznad nje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sidepanelets knapper vises kun, mens markøren er over det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Tasten der Seitenleiste erscheinen nur, solange der Zeiger darüber ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sidebar's buttons show only while the pointer is over it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los botones de la barra lateral solo se muestran mientras el puntero está sobre ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les boutons de la barre latérale ne s’affichent que lorsque le pointeur la survole."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I pulsanti della barra laterale si vedono solo mentre il puntatore è sopra di essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーのボタンは、ポインタがサイドバー上にあるときだけ表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប៊ូតុងរបស់របារចំហៀងបង្ហាញតែនៅពេលទស្សន៍ទ្រនិចនៅលើវាប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바의 버튼은 포인터가 사이드바 위에 있을 때만 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sidefeltets knapper vises bare mens pekeren er over det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przyciski paska bocznego są widoczne tylko, gdy wskaźnik jest nad nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os botões da barra lateral aparecem só enquanto o ponteiro está sobre ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кнопки боковой панели видны, только пока указатель над ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปุ่มของแถบด้านข้างจะแสดงเฉพาะเมื่อตัวชี้อยู่เหนือแถบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğunun düğmeleri yalnızca işaretçi üzerindeyken görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кнопки бічної панелі видні, лише поки вказівник над нею."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các nút của thanh bên chỉ hiện khi con trỏ ở trên thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "边栏的按钮仅在指针位于其上方时显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄的按鈕僅在指標位於其上方時顯示。"
          }
        }
      }
    },
