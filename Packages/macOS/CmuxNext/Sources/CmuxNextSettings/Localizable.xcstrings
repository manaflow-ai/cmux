    "settings.appearance.tabShape.help": {
      "comment": "Help under the Tab Shape setting; Block and Rounded are its two choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tabs and the sidebar's rows: blocks with the tab's corner, or rounded capsules."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامات التبويب وصفوف الشريط الجانبي: كتل بزاوية علامة التبويب، أو كبسولات مستديرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice i redovi bočne trake: blokovi s uglom kartice ili zaobljene kapsule."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanerne og sidepanelets rækker: blokke med fanens hjørne eller afrundede kapsler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabs und die Zeilen der Seitenleiste: Blöcke mit der Ecke des Tabs oder runde Kapseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas y las filas de la barra lateral: bloques con la esquina de la pestaña o cápsulas redondeadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets et les lignes de la barre latérale : des blocs avec le coin de l'onglet, ou des capsules arrondies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede e le righe della barra laterale: blocchi con l'angolo della scheda o capsule arrotondate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブとサイドバーの行：タブの角を持つブロック、または丸いカプセル。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំង និងជួររបស់របារចំហៀង៖ ប្លុកដែលមានជ្រុងផ្ទាំង ឬកន្សោមមូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭과 사이드바 행: 탭의 모서리를 가진 블록 또는 둥근 캡슐."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanene og sidepanelets rader: blokker med fanens hjørne eller avrundede kapsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty i wiersze paska bocznego: bloki z narożnikiem karty albo zaokrąglone kapsułki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abas e as linhas da barra lateral: blocos com o canto da aba ou cápsulas arredondadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки и строки боковой панели: блоки с углом вкладки или скруглённые капсулы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บและแถวของแถบด้านข้าง: บล็อกที่มีมุมของแท็บ หรือแคปซูลโค้งมน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmeler ve kenar çubuğunun satırları: sekmenin köşesiyle bloklar ya da yuvarlak kapsüller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки й рядки бічної панелі: блоки з кутом вкладки або заокруглені капсули."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tab và hàng của thanh bên: khối với góc của tab, hoặc viên nang bo tròn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页和边栏行：带标签页圆角的方块，或圆角胶囊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分頁與側邊欄列：帶分頁圓角的方塊，或圓角膠囊。"
          }
        }
      }
    },
