          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho các cuộc trò chuyện Codex mới biết cmux hiển thị kế hoạch, phiên phụ và phần tóm tắt như thế nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
