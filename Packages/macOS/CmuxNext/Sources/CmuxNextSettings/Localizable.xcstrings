    "settings.chief.reactionsCanWake.help": {
      "comment": "Chief reaction classifier (a416).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reaction on a Chief message can start a turn, such as ? on a question."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiefのメッセージへのリアクションでターンを開始できます(質問への ? など)。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لتفاعل على رسالة من Chief أن يبدأ دورًا، مثل ? على سؤال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reakcija na Chiefovu poruku može pokrenuti potez, npr. ? na pitanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En reaktion på en Chief-besked kan starte en tur, fx ? på et spørgsmål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Reaktion auf eine Chief-Nachricht kann einen Zug starten, etwa ? auf eine Frage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una reacción en un mensaje del Chief puede iniciar un turno, como ? en una pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une réaction sur un message du Chief peut lancer un tour, par exemple ? sur une question."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una reazione a un messaggio del Chief può avviare un turno, come ? su una domanda."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រតិកម្មលើសារ Chief អាចចាប់ផ្ដើមវេនមួយ ដូចជា ? លើសំណួរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 메시지에 남긴 반응이 턴을 시작할 수 있습니다(예: 질문에 ?)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En reaksjon på en Chief-melding kan starte en tur, for eksempel ? på et spørsmål."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reakcja na wiadomość Chiefa może rozpocząć turę, np. ? przy pytaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma reação em uma mensagem do Chief pode iniciar um turno, como ? em uma pergunta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Реакция на сообщение Chief может начать ход, например ? на вопрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รีแอคชันบนข้อความของ Chief เริ่มรอบได้ เช่น ? บนคำถาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir Chief mesajına bırakılan tepki bir tur başlatabilir; örneğin bir soruya ?."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Реакція на повідомлення Chief може почати хід, наприклад ? на питання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cảm xúc trên tin nhắn của Chief có thể bắt đầu một lượt, như ? trên một câu hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 消息上的回应可以开始一轮，例如在问题上加 ?。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 訊息上的回應可以開始一輪，例如在問題上加 ?。"
          }
        }
      }
    },
