    "settings.agentPane.display.fullWidth.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat fills the whole pane instead of the text width."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تملأ الدردشة الجزء كله بدلًا من عرض النص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razgovor ispunjava cijeli panel umjesto širine teksta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten fylder hele ruden i stedet for tekstbredden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chat füllt den ganzen Bereich statt der Textbreite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat ocupa todo el panel en lugar del ancho del texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat occupe tout le panneau au lieu de la largeur du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat riempie l'intero riquadro invece della larghezza del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットがテキスト幅ではなくペイン全体に広がります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកពេញផ្ទាំងទាំងមូល ជំនួសឱ្យទទឹងអត្ថបទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅이 텍스트 너비 대신 창 전체를 채웁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten fyller hele ruten i stedet for tekstbredden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat wypełnia cały panel zamiast szerokości tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat ocupa todo o painel em vez da largura do texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат занимает всю панель вместо ширины текста."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชทเต็มทั้งบานแทนความกว้างข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet, metin genişliği yerine bölmenin tamamını kaplar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат займає всю панель замість ширини тексту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện lấp đầy cả khung thay vì độ rộng văn bản."
