    "settings.sidebar.nowPlaying.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A player for what is playing, at the bottom of the sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشغّل لما يتم تشغيله الآن، أسفل الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plejer za ono što se reproducira, na dnu bočne trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afspiller til det, der afspilles, nederst i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Player für die aktuelle Wiedergabe, unten in der Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reproductor de lo que está sonando, en la parte inferior de la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur pour ce qui est en cours de lecture, en bas de la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un player per ciò che è in riproduzione, in fondo alla barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中のメディアのプレーヤー。サイドバーの下部に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្មវិធី​ចាក់​សម្រាប់​អ្វី​ដែល​កំពុង​ចាក់ នៅ​ផ្នែក​ខាង​ក្រោម​របារ​ចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 항목의 플레이어로, 사이드바 하단에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En spiller for det som spilles, nederst i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzacz tego, co gra, na dole paska bocznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um player do que está tocando, na parte inferior da barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеер для того, что сейчас играет, внизу боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องเล่นสำหรับสิ่งที่กำลังเล่น ที่ด้านล่างของแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalan içerik için bir oynatıcı; kenar çubuğunun altında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеєр для того, що зараз грає, унизу бічної панелі."
          }
        },
        "vi": {
