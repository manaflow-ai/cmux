            "value": "Se gli agenti avviati in cmux ricevono gli strumenti cmux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux で起動したエージェントが cmux のツールを使うかどうか"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថាតើភ្នាក់ងារដែលអ្នកចាប់ផ្ដើមក្នុង cmux ទទួលបានឧបករណ៍ cmux ឬអត់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux에서 시작한 에이전트가 cmux 도구를 받을지 여부"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om agenter du starter i cmux, får cmux-verktøyene"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy agenci uruchamiani w cmux dostają narzędzia cmux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agentes iniciados no cmux recebem as ferramentas do cmux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получают ли агенты, запущенные в cmux, инструменты cmux"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ที่คุณเริ่มใน cmux จะได้เครื่องมือของ cmux หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
