            "value": "재생 중인 항목의 플레이어로, 사이드바 하단에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En spiller for det som spilles, nederst i sidepanelet."
          }
        },
        "pl": {
