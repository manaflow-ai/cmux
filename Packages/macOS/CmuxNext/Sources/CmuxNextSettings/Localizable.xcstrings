        "it": {"stringUnit": {"state": "needs_review", "value": "Riattiva le schede al passaggio del puntatore"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "ホバーでタブを起こす"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ដាស់ផ្ទាំងពេលដាក់ទស្សន៍ទ្រនិចលើ"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "마우스를 올리면 탭 깨우기"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Vekk faner ved peker over"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Wybudzaj karty po najechaniu"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Despertar abas ao passar o ponteiro"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Пробуждать вкладки при наведении"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ปลุกแท็บเมื่อชี้เมาส์"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Üzerine gelince sekmeleri uyandır"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Пробуджувати вкладки під час наведення"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đánh thức tab khi di chuột"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "悬停时唤醒标签页"}},
