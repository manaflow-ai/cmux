    "settings.agentPane.display.vscodeMinimap.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small picture of the whole chat at its right edge. Click or drag it to scroll."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صورة صغيرة للدردشة كاملة عند حافتها اليمنى. انقر عليها أو اسحبها للتمرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mala slika cijelog razgovora uz njegovu desnu ivicu. Kliknite ili je povucite za pomicanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et lille billede af hele chatten ved dens højre kant. Klik eller træk i det for at rulle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein kleines Bild des ganzen Chats an seinem rechten Rand. Zum Scrollen klicken oder ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una imagen pequeña de todo el chat en su borde derecho. Haz clic o arrástrala para desplazarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une petite image de tout le chat sur son bord droit. Cliquez ou faites-la glisser pour défiler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una piccola immagine dell’intera chat sul suo bordo destro. Fai clic o trascinala per scorrere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャット全体の小さな図を右端に表示します。クリックまたはドラッグしてスクロールします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបភាពតូចនៃការជជែកទាំងមូលនៅគែមខាងស្ដាំ។ ចុច ឬអូសវាដើម្បីរំកិល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅 전체를 오른쪽 가장자리에 작게 보여 줍니다. 클릭하거나 드래그해 스크롤합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et lite bilde av hele chatten ved høyre kant. Klikk eller dra i det for å rulle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mały obraz całego czatu przy jego prawej krawędzi. Kliknij lub przeciągnij, aby przewinąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma pequena imagem de todo o chat na borda direita. Clique ou arraste para rolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Небольшое изображение всего чата у его правого края. Нажмите или перетащите, чтобы прокрутить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ภาพย่อของแชตทั้งหมดที่ขอบขวา คลิกหรือลากเพื่อเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbetin tamamının sağ kenarında küçük bir resmi. Kaydırmak için tıklayın veya sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невелике зображення всього чату біля його правого краю. Клацніть або перетягніть, щоб прокрутити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hình thu nhỏ của toàn bộ cuộc trò chuyện ở cạnh phải. Nhấp hoặc kéo để cuộn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在聊天右侧显示整个聊天的小图。点按或拖移即可滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在聊天右側顯示整個聊天的小圖。按一下或拖移即可捲動。"
          }
        }
      }
    },
