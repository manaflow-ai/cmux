        "nb": {"stringUnit": {"state": "translated", "value": "Gjennomsiktig dokk"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Przezroczysty dok"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dock transparente"}},
