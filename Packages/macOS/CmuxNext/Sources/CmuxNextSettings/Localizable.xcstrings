    "settings.developerTools.appPages.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«فحص العنصر» و⌥⌘I في المحادثات والصفحة الرئيسية وMarkdown والإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pregledaj element i ⌥⌘I u chatovima, na Početnoj, u Markdownu i Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Undersøg element og ⌥⌘I i chats, Hjem, Markdown og Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Element untersuchen“ und ⌥⌘I in Chats, Home, Markdown und Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect Element and ⌥⌘I in chats, Home, Markdown and Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inspeccionar elemento y ⌥⌘I en chats, Inicio, Markdown y Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inspecter l’élément et ⌥⌘I dans les discussions, l’Accueil, Markdown et les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ispeziona elemento e ⌥⌘I nelle chat, in Home, Markdown e Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャット、ホーム、Markdown、設定で「要素を検証」と ⌥⌘I を使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពិនិត្យធាតុ និង ⌥⌘I ក្នុងការជជែក ទំព័រដើម Markdown និងការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅, 홈, Markdown, 설정에서 요소 검사와 ⌥⌘I를 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inspiser element og ⌥⌘I i chatter, Hjem, Markdown og Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zbadaj element i ⌥⌘I w czatach, na stronie głównej, w Markdownie i Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inspecionar elemento e ⌥⌘I em chats, Início, Markdown e Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Просмотреть элемент» и ⌥⌘I в чатах, на главной, в Markdown и в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจสอบองค์ประกอบและ ⌥⌘I ในแชท หน้าหลัก Markdown และการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbetlerde, Ana Sayfa'da, Markdown'da ve Ayarlar'da Öğeyi incele ve ⌥⌘I."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Переглянути елемент» і ⌥⌘I у чатах, на головній, у Markdown і в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiểm tra phần tử và ⌥⌘I trong chat, Trang chủ, Markdown và Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在智能体聊天、主页、Markdown 和设置中使用“检查元素”和 ⌥⌘I。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在聊天、首頁、Markdown 和設定中使用「檢查元素」和 ⌥⌘I。"
          }
        }
      }
    },
