    "settings.updates.idleInstallMaxWait.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nightly installs when you are idle, and never waits longer than this."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُثبَّت إصدار nightly عندما تكون خاملًا، ولا ينتظر أبدًا أطول من هذه المدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly se instalira kada ste neaktivni i nikad ne čeka duže od ovoga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En nightly installeres, når du er inaktiv, og venter aldrig længere end dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Nightly installiert sich, wenn du inaktiv bist, und wartet nie länger als diese Zeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una nightly se instala cuando estás inactivo y nunca espera más que esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une nightly s'installe quand vous êtes inactif, sans jamais attendre plus longtemps que ce délai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una nightly si installa quando sei inattivo e non aspetta mai più di questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nightly は操作していないときにインストールされ、この時間より長くは待ちません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណែ nightly ដំឡើងនៅពេលអ្នកទំនេរ ហើយមិនដែលរង់ចាំយូរជាងនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nightly는 사용하지 않을 때 설치되며, 이 시간보다 오래 기다리지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En nightly installeres når du er inaktiv, og venter aldri lenger enn dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wersja nightly instaluje się, gdy jesteś bezczynny, i nigdy nie czeka dłużej niż tyle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma nightly se instala quando você está ocioso e nunca espera mais do que isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly-сборка устанавливается, когда вы бездействуете, и никогда не ждёт дольше этого времени."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nightly จะติดตั้งเมื่อคุณไม่ได้ใช้งาน และจะไม่รอนานกว่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir nightly, siz boştayken yüklenir ve asla bundan uzun beklemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly-збірка встановлюється, коли ви бездієте, і ніколи не чекає довше за цей час."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản nightly cài đặt khi bạn không hoạt động, và không bao giờ chờ lâu hơn khoảng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nightly 会在你空闲时安装，等待不会超过此时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nightly 會在你閒置時安裝，且等待不會超過此時長。"
          }
        }
      }
    },
