        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องของคุณและสถานะออนไลน์ของแต่ละเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makineleriniz ve her birinin çevrimiçi olup olmadığı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші комп’ютери та чи кожен у мережі."
          }
        },
        "vi": {
          "stringUnit": {
