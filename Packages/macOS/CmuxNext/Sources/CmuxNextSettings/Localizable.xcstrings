    "settings.sidebar.hoverCards.maxRows.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most prompts, waits and finished turns a workspace's card lists. The list scrolls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースカードに表示するプロンプト、待機、完了したターンの最大数。リストはスクロールします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أقصى عدد من الطلبات وأوقات الانتظار والأدوار المنتهية في بطاقة مساحة العمل. القائمة قابلة للتمرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najveći broj upita, čekanja i završenih redova na kartici. Lista se pomiče."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det største antal prompts, ventetider og færdige ture et kort viser. Listen kan rulles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Höchstzahl an Prompts, Wartezeiten und beendeten Zügen auf der Karte. Die Liste scrollt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El máximo de instrucciones, esperas y turnos terminados que muestra la tarjeta. La lista se desplaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le nombre maximal de prompts, d'attentes et de tours terminés listés. La liste défile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il numero massimo di prompt, attese e turni completati nella scheda. L'elenco scorre."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចំនួនអតិបរមានៃសំណើ ការរង់ចាំ និងវេនដែលបានបញ្ចប់ក្នុងកាត។ បញ្ជីអាចរំកិលបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카드에 표시할 프롬프트, 대기, 완료된 차례의 최대 수. 목록은 스크롤됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det største antallet prompts, ventinger og ferdige runder kortet viser. Listen ruller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maksymalna liczba promptów, oczekiwań i zakończonych tur na karcie. Lista się przewija."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O máximo de prompts, esperas e vezes concluídas no cartão. A lista rola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Максимум запросов, ожиданий и завершённых ходов в карточке. Список прокручивается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จำนวนสูงสุดของพรอมต์ การรอ และรอบที่เสร็จในการ์ด รายการเลื่อนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartın listelediği en fazla istem, bekleme ve biten sıra. Liste kaydırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Максимум запитів, очікувань і завершених ходів у картці. Список прокручується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Số lời nhắc, lần chờ và lượt đã xong tối đa trong thẻ. Danh sách cuộn được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作区卡片列出的提示、等待和已完成回合的最大数量。列表可滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
