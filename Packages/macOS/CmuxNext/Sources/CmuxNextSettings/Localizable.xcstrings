    "settings.diagnostics.hangReports.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترسل إصدارات Nightly تقريرًا يوميًا عن حالات التجمّد والإطارات البطيئة: مكدسات الاستدعاء لشيفرة cmux وmacOS، والتوقيتات، وإصداري التطبيق وmacOS، وشريحة جهاز Mac وحجم ذاكرته، وأعدادًا تقريبية للنوافذ وعلامات التبويب المفتوحة. لا يتضمن أبدًا أسماء ملفات أو عناوين ويب أو نص الطرفية أو أسماء أو أي شيء تكتبه. يعرض «عرض تقرير التجمّد» ما يُرسل بالضبط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly verzije šalju dnevni izvještaj o zastojima i sporim kadrovima: stekove poziva koda cmuxa i macOS-a, vremena, verzije aplikacije i macOS-a, čip i veličinu memorije vašeg Maca te zaokružen broj otvorenih prozora i kartica. Nikada ne sadrži imena datoteka, web adrese, tekst terminala, imena ni bilo šta što kucate. Prikaži izvještaj o zastoju pokazuje tačno šta se šalje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly-builds sender en daglig rapport om hængninger og langsomme billeder: kaldestakke fra cmux- og macOS-kode, tider, app- og macOS-version, din Macs chip og hukommelsesstørrelse samt afrundede antal åbne vinduer og faner. Den indeholder aldrig filnavne, webadresser, terminaltekst, navne eller noget, du skriver. Vis hængningsrapport viser præcis, hvad der sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly-Builds senden täglich einen Bericht über Hänger und langsame Frames: Aufrufstapel aus cmux- und macOS-Code, Zeiten, App- und macOS-Version, Chip und Arbeitsspeichergröße deines Mac sowie gerundete Anzahlen offener Fenster und Tabs. Er enthält nie Dateinamen, Webadressen, Terminaltext, Namen oder etwas, das du tippst. „Hänger-Bericht anzeigen“ zeigt genau, was gesendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly builds send a daily report of hangs and slow frames: call stacks of cmux and macOS code, timings, your app and macOS versions, your Mac's chip and memory size, and rounded counts of open windows and tabs. It never includes file names, web addresses, terminal text, names or anything you type. View Hang Report shows exactly what is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones Nightly envían un informe diario de bloqueos y fotogramas lentos: pilas de llamadas del código de cmux y macOS, tiempos, las versiones de la app y de macOS, el chip y la memoria de tu Mac, y recuentos redondeados de ventanas y pestañas abiertas. Nunca incluye nombres de archivo, direcciones web, texto del terminal, nombres ni nada de lo que escribes. Ver informe de bloqueos muestra exactamente lo que se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions Nightly envoient chaque jour un rapport sur les blocages et les images lentes : piles d’appels du code de cmux et de macOS, durées, versions de l’app et de macOS, puce et taille de mémoire de votre Mac, et nombres arrondis de fenêtres et d’onglets ouverts. Il ne contient jamais de noms de fichiers, d’adresses web, de texte du terminal, de noms ni rien de ce que vous tapez. Afficher le rapport de blocages montre exactement ce qui est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le build Nightly inviano ogni giorno un rapporto su blocchi e fotogrammi lenti: stack di chiamate del codice di cmux e macOS, tempi, versioni dell’app e di macOS, chip e memoria del tuo Mac e numeri arrotondati di finestre e schede aperte. Non include mai nomi di file, indirizzi web, testo del terminale, nomi o qualsiasi cosa tu digiti. Mostra rapporto sui blocchi mostra esattamente cosa viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightlyビルドは、ハングと遅いフレームのレポートを1日1回送信します。内容は、cmuxとmacOSのコードのコールスタック、所要時間、アプリとmacOSのバージョン、Macのチップとメモリ容量、開いているウインドウとタブのおおよその数です。ファイル名、Webアドレス、ターミナルのテキスト、名前、入力した内容は一切含みません。「ハングレポートを表示」で送信内容をそのまま確認できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែ Nightly ផ្ញើ​របាយការណ៍​ប្រចាំថ្ងៃ​អំពី​ការ​គាំង និង​ស៊ុម​យឺត៖ ជង់​ការ​ហៅ​នៃ​កូដ cmux និង macOS ពេលវេលា កំណែ​កម្មវិធី និង macOS បន្ទះ​សៀគ្វី និង​ទំហំ​អង្គចងចាំ​នៃ Mac របស់​អ្នក និង​ចំនួន​ប្រហាក់ប្រហែល​នៃ​បង្អួច និង​ផ្ទាំង​ដែល​បើក។ វា​មិន​ដែល​រួម​បញ្ចូល​ឈ្មោះ​ឯកសារ អាសយដ្ឋាន​បណ្ដាញ អត្ថបទ​ក្នុង​ទែមីណាល់ ឈ្មោះ ឬ​អ្វី​ដែល​អ្នក​វាយ​ឡើយ។ «មើល​របាយការណ៍​គាំង» បង្ហាញ​យ៉ាង​ពិតប្រាកដ​នូវ​អ្វី​ដែល​ត្រូវ​ផ្ញើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly 빌드는 멈춤과 느린 프레임에 대한 보고서를 하루에 한 번 보냅니다. cmux와 macOS 코드의 호출 스택, 소요 시간, 앱과 macOS 버전, Mac의 칩과 메모리 크기, 열려 있는 윈도우와 탭의 대략적인 수가 포함됩니다. 파일 이름, 웹 주소, 터미널 텍스트, 이름, 입력한 내용은 절대 포함하지 않습니다. 멈춤 보고서 보기에서 보내는 내용을 그대로 확인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly-bygg sender en daglig rapport om henginger og trege bilder: kallstabler fra cmux- og macOS-kode, tider, app- og macOS-versjon, Mac-ens brikke og minnestørrelse og avrundede antall åpne vinduer og faner. Den inneholder aldri filnavn, nettadresser, terminaltekst, navn eller noe du skriver. Vis hengerapport viser nøyaktig hva som sendes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersje Nightly wysyłają codzienny raport o zawieszeniach i wolnych klatkach: stosy wywołań kodu cmux i macOS, czasy, wersje aplikacji i macOS, układ i ilość pamięci Twojego Maca oraz zaokrągloną liczbę otwartych okien i kart. Nigdy nie zawiera nazw plików, adresów stron, tekstu terminala, nazwisk ani niczego, co wpisujesz. Pokaż raport o zawieszeniu pokazuje dokładnie, co jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões Nightly enviam um relatório diário de travamentos e quadros lentos: pilhas de chamadas do código do cmux e do macOS, tempos, versões do app e do macOS, chip e memória do seu Mac e contagens arredondadas de janelas e abas abertas. Nunca inclui nomes de arquivos, endereços web, texto do terminal, nomes ou qualquer coisa que você digite. Ver relatório de travamentos mostra exatamente o que é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборки Nightly раз в день отправляют отчёт о зависаниях и медленных кадрах: стеки вызовов кода cmux и macOS, длительности, версии приложения и macOS, чип и объём памяти вашего Mac и округлённое число открытых окон и вкладок. В нём никогда нет имён файлов, веб-адресов, текста терминала, имён и того, что вы вводите. «Показать отчёт о зависаниях» показывает, что именно отправляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รุ่น Nightly จะส่งรายงานการค้างและเฟรมที่ช้าวันละครั้ง ได้แก่ call stack ของโค้ด cmux และ macOS เวลาที่ใช้ เวอร์ชันของแอปและ macOS ชิปและขนาดหน่วยความจำของ Mac และจำนวนหน้าต่างกับแท็บที่เปิดอยู่แบบปัดเศษ รายงานไม่มีชื่อไฟล์ ที่อยู่เว็บ ข้อความในเทอร์มินัล ชื่อ หรือสิ่งที่คุณพิมพ์เลย \"ดูรายงานการค้าง\" จะแสดงสิ่งที่ส่งอย่างตรงตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly sürümleri her gün donmalar ve yavaş kareler hakkında bir rapor gönderir: cmux ve macOS kodunun çağrı yığınları, süreler, uygulama ve macOS sürümleri, Mac’inizin yongası ve bellek boyutu ile açık pencere ve sekmelerin yuvarlanmış sayıları. Asla dosya adı, web adresi, terminal metni, ad veya yazdığınız herhangi bir şey içermez. Donma raporunu görüntüle, tam olarak neyin gönderildiğini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збірки Nightly щодня надсилають звіт про зависання й повільні кадри: стеки викликів коду cmux і macOS, тривалості, версії застосунку й macOS, чип і обсяг пам’яті вашого Mac та округлену кількість відкритих вікон і вкладок. Він ніколи не містить назв файлів, вебадрес, тексту термінала, імен чи будь-чого, що ви вводите. «Показати звіт про зависання» показує, що саме надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản Nightly gửi báo cáo hằng ngày về các lần treo và khung hình chậm: ngăn xếp lệnh gọi của mã cmux và macOS, thời gian, phiên bản ứng dụng và macOS, chip và dung lượng bộ nhớ của máy Mac, cùng số cửa sổ và tab đang mở đã làm tròn. Báo cáo không bao giờ chứa tên tệp, địa chỉ web, văn bản terminal, tên hay bất kỳ nội dung nào bạn gõ. Xem báo cáo treo cho thấy chính xác nội dung được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly 版本每天发送一份卡顿与慢帧报告：cmux 和 macOS 代码的调用栈、耗时、App 与 macOS 版本、Mac 的芯片和内存大小，以及打开的窗口和标签页的大致数量。报告绝不包含文件名、网址、终端文本、姓名或你输入的任何内容。“查看卡顿报告”会显示实际发送的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly 版本每天傳送一份卡頓與慢影格報告：cmux 和 macOS 程式碼的呼叫堆疊、耗時、App 與 macOS 版本、Mac 的晶片和記憶體大小，以及開啟中視窗和分頁的大約數量。報告絕不包含檔案名稱、網址、終端機文字、姓名或你輸入的任何內容。「檢視卡頓報告」會顯示實際傳送的內容。"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.weather": {
      "comment": "Settings: toggle that shows the weather widget on the New Tab page.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار الطقس في علامة التبويب الجديدة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži vrijeme na novoj kartici"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis vejret på ny fane"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetter im neuen Tab anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Weather on New Tab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el tiempo en la nueva pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la météo dans le nouvel onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il meteo nella nuova scheda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブに天気を表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញ​អាកាសធាតុ​នៅ​លើ​ផ្ទាំង​ថ្មី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 탭에 날씨 보기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis været på ny fane"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż pogodę na nowej karcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o tempo na nova aba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать погоду в новой вкладке"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสภาพอากาศในแท็บใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sekmede hava durumunu göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати погоду в новій вкладці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện thời tiết trên thẻ mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签页上显示天气"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁上顯示天氣"
          }
        }
      }
    },
    "settings.tabs.newTabWidgets.weather.help": {
      "comment": "Settings: help for the New Tab weather widget toggle. 'The city below' is the Weather City setting.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطقس الحالي وأعلى وأدنى درجة اليوم، للمدينة أدناه أو لمدينة منطقتك الزمنية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutno vrijeme i današnja najviša i najniža temperatura, za grad ispod ili grad vaše vremenske zone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det aktuelle vejr og dagens høje og lave temperatur for byen nedenfor eller din tidszones by."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Wetter und die heutige Höchst- und Tiefsttemperatur für die Stadt unten oder die Stadt deiner Zeitzone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current weather and today's high and low, for the city below or your time zone's city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo actual y la máxima y mínima de hoy, para la ciudad de abajo o la ciudad de tu zona horaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La météo actuelle et les températures maximale et minimale du jour, pour la ville ci-dessous ou celle de votre fuseau horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il meteo attuale e la massima e minima di oggi, per la città qui sotto o la città del tuo fuso orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の都市、またはタイムゾーンの都市の現在の天気と今日の最高・最低気温。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាកាសធាតុ​បច្ចុប្បន្ន និង​សីតុណ្ហភាព​ខ្ពស់​និង​ទាប​ថ្ងៃ​នេះ សម្រាប់​ទីក្រុង​ខាង​ក្រោម ឬ​ទីក្រុង​នៃ​តំបន់​ម៉ោង​របស់​អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 도시 또는 시간대 도시의 현재 날씨와 오늘의 최고·최저 기온입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Været nå og dagens høyeste og laveste temperatur for byen nedenfor eller byen i tidssonen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżąca pogoda oraz dzisiejsza najwyższa i najniższa temperatura dla miasta poniżej lub miasta Twojej strefy czasowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo atual e a máxima e mínima de hoje, para a cidade abaixo ou a cidade do seu fuso horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая погода и сегодняшние максимум и минимум для города ниже или города вашего часового пояса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สภาพอากาศปัจจุบันและอุณหภูมิสูงสุดต่ำสุดของวันนี้ สำหรับเมืองด้านล่างหรือเมืองในเขตเวลาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki şehir veya saat diliminizin şehri için şu anki hava durumu ve bugünün en yüksek ve en düşük sıcaklığı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна погода й сьогоднішні максимум і мінімум для міста нижче або міста вашого часового поясу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời tiết hiện tại và nhiệt độ cao nhất, thấp nhất hôm nay cho thành phố bên dưới hoặc thành phố theo múi giờ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下方城市或你所在时区城市的当前天气及今日最高和最低气温。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下方城市或你所在時區城市的目前天氣及今日最高和最低氣溫。"
          }
        }
      }
    },
