    "settings.diagnostics.hangReports.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ترسل إصدارات Nightly يوميًا مكدسات التجمّد والتوقيتات، ولا ترسل أبدًا ملفاتك أو عناوين URL أو نصوصك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly verzije šalju dnevne stekove i vremena zastoja, nikad vaše datoteke, URL-ove ni tekst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly-builds sender daglige hængningsstakke og tider, aldrig dine filer, URL'er eller tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly-Builds senden täglich Aufrufstapel und Zeiten von Hängern, nie deine Dateien, URLs oder Texte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightly builds send daily hang stacks and timings, never your files, URLs or text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las versiones Nightly envían a diario pilas y tiempos de bloqueos, nunca tus archivos, URL ni texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les versions Nightly envoient chaque jour les piles d’appels et durées des blocages, jamais vos fichiers, URL ni texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le build Nightly inviano ogni giorno stack e tempi dei blocchi, mai i tuoi file, URL o testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightlyビルドはハングのスタックと所要時間を毎日送信します。ファイル、URL、テキストは送りません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណែ Nightly ផ្ញើ​ជង់​ការ​ហៅ និង​ពេលវេលា​នៃ​ការ​គាំង​ប្រចាំថ្ងៃ មិន​ដែល​ផ្ញើ​ឯកសារ URL ឬ​អត្ថបទ​របស់​អ្នក​ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly 빌드는 매일 멈춤 스택과 소요 시간을 보내며, 파일, URL, 텍스트는 보내지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly-bygg sender daglige kallstabler og tider for henginger, aldri filene, URL-ene eller teksten din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wersje Nightly wysyłają codziennie stosy i czasy zawieszeń, nigdy Twoich plików, adresów URL ani tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As versões Nightly enviam diariamente pilhas e tempos de travamentos, nunca seus arquivos, URLs ou textos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сборки Nightly раз в день отправляют стеки зависаний и длительности, но никогда — ваши файлы, URL или текст."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รุ่น Nightly จะส่ง call stack และเวลาของการค้างทุกวัน ไม่ส่งไฟล์ URL หรือข้อความของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly sürümleri her gün donma yığınlarını ve süreleri gönderir; asla dosyalarınızı, URL'lerinizi veya metninizi göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збірки Nightly щодня надсилають стеки зависань і тривалості, але ніколи не ваші файли, URL чи текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bản Nightly gửi hằng ngày ngăn xếp lần treo và thời gian, không bao giờ gửi tệp, URL hay văn bản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly 版本每天发送卡顿调用栈和耗时，绝不包含你的文件、URL 或文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nightly 版本每天傳送卡頓堆疊與耗時，絕不包含你的檔案、網址或文字。"
          }
        }
      }
    },
