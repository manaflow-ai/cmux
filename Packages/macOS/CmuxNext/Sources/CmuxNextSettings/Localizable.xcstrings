    "settings.agentPane.display.fullWidth.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat fills the whole pane instead of the text width."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تملأ الدردشة الجزء كله بدلًا من عرض النص."
          }
        },
        "bs": {
