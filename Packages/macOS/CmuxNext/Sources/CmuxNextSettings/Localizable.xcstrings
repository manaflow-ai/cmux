    "settings.sidebar.topBandMaxShare.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share of the sidebar the top sections fill before they scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上部セクションがスクロールする前に占めるサイドバーの割合。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الجزء من الشريط الجانبي الذي تملؤه الأقسام العلوية قبل التمرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dio bočne trake koji gornji odjeljci zauzmu prije pomicanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den del af sidepanelet, de øverste sektioner fylder, før de ruller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Anteil der Seitenleiste, den die oberen Abschnitte füllen, bevor sie scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La parte de la barra lateral que ocupan las secciones superiores antes de desplazarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La part de la barre latérale occupée par les sections du haut avant défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La parte della barra laterale occupata dalle sezioni in alto prima di scorrere."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចំណែករបារចំហៀងដែលផ្នែកខាងលើបំពេញមុនរមូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위쪽 섹션이 스크롤되기 전 차지하는 사이드바 비율입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Andelen av sidepanelet de øverste seksjonene fyller før de ruller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Część paska bocznego zajmowana przez górne sekcje przed przewijaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A parte da barra lateral que as seções superiores ocupam antes de rolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доля боковой панели, которую занимают верхние разделы до прокрутки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สัดส่วนของแถบด้านข้างที่ส่วนด้านบนใช้ก่อนเลื่อน"
