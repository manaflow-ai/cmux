          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ mới liệt kê mọi cuộc trò chuyện với tác nhân trên máy tính này, không chỉ các cuộc gần đây."
          }
        },
        "zh-Hans": {
