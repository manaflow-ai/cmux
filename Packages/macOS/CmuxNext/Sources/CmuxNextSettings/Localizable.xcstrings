            "value": "Sans valeur, la fenêtre suit background-opacity et background-blur de Ghostty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se non impostato, la finestra segue background-opacity e background-blur di Ghostty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定の場合、ウインドウはGhosttyのbackground-opacityとbackground-blurに従います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពេលមិនបានកំណត់ បង្អួចធ្វើតាម background-opacity និង background-blur របស់ Ghostty។"
