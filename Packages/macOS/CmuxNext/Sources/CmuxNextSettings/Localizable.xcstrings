    "settings.tabs.newTabPosition.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where Cmd-T and the + button put the new tab. New Tab to the Right in a tab's menu always puts it after that tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-T と + ボタンで開く新規タブの位置です。タブのメニューの「右に新規タブ」は、常にそのタブの後ろに開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المكان الذي يضع فيه Cmd-T وزر + علامة التبويب الجديدة. يضعها الأمر «علامة تبويب جديدة إلى اليمين» في قائمة علامة التبويب دائمًا بعد تلك العلامة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdje Cmd-T i dugme + stavljaju novu karticu. Novi tab desno u meniju kartice uvijek je stavlja iza te kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor Cmd-T og knappen + placerer den nye fane. Ny fane til højre i en fanes menu placerer den altid efter den fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wo Cmd-T und die Taste + den neuen Tab einfügen. „Neuer Tab rechts“ im Menü eines Tabs fügt ihn immer hinter diesem Tab ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dónde colocan Cmd-T y el botón + la nueva pestaña. «Nueva pestaña a la derecha» en el menú de una pestaña siempre la coloca después de esa pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où Cmd-T et le bouton + placent le nouvel onglet. « Nouvel onglet à droite » dans le menu d’un onglet le place toujours après cet onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove Cmd-T e il pulsante + mettono la nuova scheda. «Nuova scheda a destra» nel menu di una scheda la mette sempre dopo quella scheda."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងដែល Cmd-T និងប៊ូតុង + ដាក់ផ្ទាំងថ្មី។ «ផ្ទាំងថ្មីនៅខាងស្ដាំ» ក្នុងម៉ឺនុយផ្ទាំង តែងតែដាក់វានៅបន្ទាប់ពីផ្ទាំងនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T와 + 버튼이 새 탭을 두는 위치입니다. 탭 메뉴의 오른쪽에 새 탭은 항상 그 탭 뒤에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor Cmd-T og +-knappen plasserer den nye fanen. Ny fane til høyre i en fanes meny plasserer den alltid etter den fanen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdzie Cmd-T i przycisk + umieszczają nową kartę. Polecenie „Nowa karta po prawej” w menu karty zawsze umieszcza ją za tą kartą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde Cmd-T e o botão + colocam a nova aba. Nova aba à direita, no menu de uma aba, sempre a coloca depois dessa aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куда Cmd-T и кнопка + ставят новую вкладку. «Новая вкладка справа» в меню вкладки всегда ставит её после этой вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตำแหน่งที่ Cmd-T และปุ่ม + วางแท็บใหม่ แท็บใหม่ทางขวาในเมนูของแท็บจะวางไว้หลังแท็บนั้นเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T ve + düğmesinin yeni sekmeyi koyduğu yer. Bir sekmenin menüsündeki Sağa yeni sekme onu her zaman o sekmeden sonra koyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Куди Cmd-T і кнопка + ставлять нову вкладку. «Нова вкладка праворуч» у меню вкладки завжди ставить її після цієї вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nơi Cmd-T và nút + đặt thẻ mới. Tab mới bên phải trong menu của một thẻ luôn đặt nó sau thẻ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T 和 + 按钮放置新标签页的位置。标签页菜单中的“在右侧新建标签页”总是放在该标签页之后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cmd-T 和 + 按鈕放置新標籤頁的位置。標籤頁選單中的「在右側新增分頁」一律放在該標籤頁之後。"
          }
        }
      }
    },
