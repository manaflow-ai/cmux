    "settings.browser.wakeTabsOnHover.help": {
      "comment": "Help under the Wake Tabs on Hover setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleeping pages start loading when the pointer rests on their tab. Uses more memory."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبدأ الصفحات النائمة في التحميل عندما يستقر المؤشر على علامة تبويبها. يستخدم ذاكرة أكثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uspavane stranice počinju se učitavati kada pokazivač miruje na njihovoj kartici. Koristi više memorije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sovende sider begynder at indlæse, når markøren hviler på deres fane. Bruger mere hukommelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlafende Seiten laden, wenn der Zeiger auf ihrem Tab ruht. Braucht mehr Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las páginas en reposo empiezan a cargarse cuando el puntero se detiene en su pestaña. Usa más memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les pages en veille commencent à se charger quand le pointeur s’arrête sur leur onglet. Utilise plus de mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le pagine sospese iniziano a caricarsi quando il puntatore si ferma sulla loro scheda. Usa più memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ポインタがタブの上で止まると、スリープ中のページが読み込みを始めます。メモリを多く使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រដែលកំពុងដេកចាប់ផ្ដើមផ្ទុក ពេលទស្សន៍ទ្រនិចឈប់លើផ្ទាំងរបស់វា។ ប្រើអង្គចងចាំច្រើនជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포인터가 탭 위에 머무르면 잠든 페이지가 로드를 시작합니다. 메모리를 더 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sovende sider begynner å laste når pekeren hviler på fanen. Bruker mer minne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uśpione strony zaczynają się wczytywać, gdy wskaźnik zatrzyma się na ich karcie. Zużywa więcej pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Páginas em repouso começam a carregar quando o ponteiro para sobre a aba. Usa mais memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спящие страницы начинают загружаться, когда указатель задерживается на их вкладке. Использует больше памяти."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าที่หลับอยู่จะเริ่มโหลดเมื่อตัวชี้หยุดอยู่บนแท็บ ใช้หน่วยความจำมากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İşaretçi bir sekmenin üzerinde durduğunda uyuyan sayfaları yüklenmeye başlar. Daha fazla bellek kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сплячі сторінки починають завантажуватися, коли вказівник зупиняється на їхній вкладці. Використовує більше пам’яті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trang đang ngủ bắt đầu tải khi con trỏ dừng trên tab của nó. Dùng nhiều bộ nhớ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指针停在标签页上时，休眠页面开始加载。会占用更多内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指標停在分頁上時，其休眠頁面會開始載入。會使用更多記憶體。"
          }
        }
      }
    },
