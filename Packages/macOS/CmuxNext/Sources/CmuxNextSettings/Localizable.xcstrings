    "settings.files.textEditor.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app Open in Text Editor uses for a path: an app name, a bundle ID or the path of an app. Empty uses the app that opens source code."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التطبيق الذي يستخدمه «فتح في محرر النصوص» لمسار: اسم تطبيق أو معرّف حزمة أو مسار تطبيق. الفارغ يستخدم التطبيق الذي يفتح الشفرة المصدرية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikacija koju Otvori u uređivaču teksta koristi za putanju: naziv aplikacije, ID paketa ili putanja aplikacije. Prazno koristi aplikaciju koja otvara izvorni kod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appen, som Åbn i teksteditor bruger til en sti: et appnavn, et bundle-id eller stien til en app. Tom bruger den app, der åbner kildekode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die App, die „Im Texteditor öffnen“ für einen Pfad verwendet: ein App-Name, eine Bundle-ID oder der Pfad einer App. Leer verwendet die App, die Quellcode öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La app que usa Abrir en el editor de texto para una ruta: un nombre de app, un ID de paquete o la ruta de una app. Vacío usa la app que abre código fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'app qu'utilise Ouvrir dans l'éditeur de texte pour un chemin : un nom d'app, un identifiant de bundle ou le chemin d'une app. Vide utilise l'app qui ouvre le code source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'app che Apri nell'editor di testo usa per un percorso: un nome di app, un ID bundle o il percorso di un'app. Vuoto usa l'app che apre il codice sorgente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスの「テキストエディタで開く」に使うアプリ: アプリ名、バンドル ID、またはアプリのパス。空の場合はソースコードを開くアプリを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែល «បើកក្នុងកម្មវិធីកែអត្ថបទ» ប្រើសម្រាប់ផ្លូវ៖ ឈ្មោះកម្មវិធី លេខសម្គាល់បណ្ដុំ ឬផ្លូវរបស់កម្មវិធី។ ទទេប្រើកម្មវិធីដែលបើកកូដប្រភព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "경로의 텍스트 편집기에서 열기가 사용하는 앱: 앱 이름, 번들 ID 또는 앱 경로. 비워 두면 소스 코드를 여는 앱을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appen Åpne i tekstredigerer bruker for en bane: et appnavn, en pakke-ID eller banen til en app. Tom bruker appen som åpner kildekode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikacja, której używa Otwórz w edytorze tekstu dla ścieżki: nazwa aplikacji, identyfikator pakietu lub ścieżka aplikacji. Puste używa aplikacji otwierającej kod źródłowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O app que Abrir no editor de texto usa para um caminho: um nome de app, um ID de pacote ou o caminho de um app. Vazio usa o app que abre código-fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Приложение, которое «Открыть в текстовом редакторе» использует для пути: имя приложения, идентификатор пакета или путь к приложению. Пусто — приложение, открывающее исходный код."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แอปที่ «เปิดในโปรแกรมแก้ไขข้อความ» ใช้กับพาธ: ชื่อแอป Bundle ID หรือพาธของแอป ว่างไว้จะใช้แอปที่เปิดซอร์สโค้ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metin Düzenleyicide Aç'ın bir yol için kullandığı uygulama: bir uygulama adı, paket kimliği veya bir uygulamanın yolu. Boş bırakılırsa kaynak kodu açan uygulama kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програма, яку «Відкрити в текстовому редакторі» використовує для шляху: назва програми, ідентифікатор пакета або шлях до програми. Порожньо — програма, що відкриває вихідний код."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ứng dụng mà Mở trong trình soạn thảo văn bản dùng cho một đường dẫn: tên ứng dụng, ID gói hoặc đường dẫn của ứng dụng. Để trống sẽ dùng ứng dụng mở mã nguồn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“在文本编辑器中打开”用于路径的 App：App 名称、Bundle ID 或 App 的路径。留空则使用打开源代码的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「在文字編輯器中打開」用於路徑的 App：App 名稱、Bundle ID 或 App 的路徑。留空則使用開啟原始碼的 App。"
          }
        }
      }
    },
