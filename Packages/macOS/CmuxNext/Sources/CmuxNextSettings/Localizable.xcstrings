        "pl": {"stringUnit": {"state": "needs_review", "value": "Szybkość połysku"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Velocidade do brilho"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Скорость мерцания"}},
