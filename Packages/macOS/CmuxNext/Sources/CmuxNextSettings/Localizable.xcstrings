        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "行に最後に変わった時刻を表示します（例: 3d）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជួរដេកបង្ហាញពេលដែលវាបានផ្លាស់ប្តូរចុងក្រោយ ដូចជា 3d។"
