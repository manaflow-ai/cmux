            "value": "Sizi bekliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекає на вас"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你处理"
          }
        },
        "zh-Hant": {
