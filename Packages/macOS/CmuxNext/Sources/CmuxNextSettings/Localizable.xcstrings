    "settings.ui.animations.enabled.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإيقاف يوقف كل الرسوم المتحركة. عند التشغيل، تختار المفاتيح أدناه حسب المنطقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno gasi sve animacije. Uključeno, prekidači ispod biraju po području."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra slår alle animationer fra. Til vælger kontakterne nedenfor område for område."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus schaltet alle Animationen ab. An wählen die Schalter darunter nach Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off turns every animation off. On, the switches below pick by area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado apaga todas las animaciones. Activado, los interruptores de abajo eligen por área."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé coupe toutes les animations. Activé, les commutateurs ci-dessous choisissent par zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato spegne tutte le animazioni. Attivato, gli interruttori sotto scelgono area per area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフにするとすべてのアニメーションが止まります。オンのときは下のスイッチで領域ごとに選べます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ នឹងបិទចលនាទាំងអស់។ បើក កុងតាក់ខាងក្រោមជ្រើសរើសតាមតំបន់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끄면 모든 애니메이션이 꺼집니다. 켜면 아래 스위치로 영역별로 고를 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av slår av alle animasjoner. På velger bryterne nedenfor område for område."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączone wyłącza wszystkie animacje. Włączone — przełączniki poniżej wybierają obszar po obszarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado desliga todas as animações. Ativado, as chaves abaixo escolhem por área."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выключено отключает все анимации. Включено — переключатели ниже выбирают по областям."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดจะหยุดภาพเคลื่อนไหวทั้งหมด เปิดอยู่ สวิตช์ด้านล่างเลือกได้ทีละส่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı, tüm animasyonları kapatır. Açıkken aşağıdaki anahtarlar alan alan seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкнено вимикає всі анімації. Увімкнено — перемикачі нижче вибирають область за областю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt sẽ tắt mọi hoạt ảnh. Bật thì các công tắc bên dưới chọn theo từng khu vực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭会停止所有动画。开启时，可用下方开关按区域选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉會停止所有動畫。開啟時，可用下方開關依區域選擇。"
          }
        }
      }
    },
    "settings.ui.animations.sidebar.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنزلق الصفوف والمجموعات والشريط الجانبي نفسه عند تغيّرها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redovi, grupe i sama bočna traka klize dok se mijenjaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rækker, grupper og selve sidepanelet glider, når de ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeilen, Gruppen und die Seitenleiste selbst gleiten, wenn sie sich ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows, groups and the sidebar itself slide as they change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las filas, los grupos y la propia barra lateral se deslizan al cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les lignes, les groupes et la barre latérale elle-même glissent quand ils changent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Righe, gruppi e la barra laterale stessa scorrono quando cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "行、グループ、サイドバー自体が変化するときにスライドします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជួរ ក្រុម និងរបារចំហៀងខ្លួនឯង រំកិលនៅពេលផ្លាស់ប្ដូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "행, 그룹, 사이드바가 바뀔 때 미끄러지듯 움직입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rader, grupper og selve sidefeltet glir når de endres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiersze, grupy i sam pasek boczny przesuwają się przy zmianach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linhas, grupos e a própria barra lateral deslizam ao mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строки, группы и сама боковая панель скользят при изменении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถว กลุ่ม และแถบด้านข้างจะเลื่อนเมื่อเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Satırlar, gruplar ve kenar çubuğunun kendisi değişirken kayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рядки, групи й сама бічна панель ковзають під час змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hàng, nhóm và chính thanh bên trượt khi thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "行、分组和侧边栏本身在变化时滑动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "列、群組與側邊欄本身在變化時滑動。"
          }
        }
      }
    },
    "settings.ui.animations.tabs.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تكبر علامات التبويب وتصغر وتنزلق عند فتحها وإغلاقها ونقلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice rastu, smanjuju se i klize kad se otvore, zatvore i pomaknu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner vokser, krymper og glider, når de åbnes, lukkes og flyttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tabs wachsen, schrumpfen und gleiten beim Öffnen, Schließen und Verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs grow, shrink and slide as they open, close and move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pestañas crecen, se encogen y se deslizan al abrirse, cerrarse y moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les onglets grandissent, rétrécissent et glissent quand ils s’ouvrent, se ferment et bougent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le schede crescono, si restringono e scorrono quando si aprono, si chiudono e si spostano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブを開く、閉じる、移動するときに、伸縮やスライドで表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងរីក រួម និងរំកិលនៅពេលបើក បិទ និងផ្លាស់ទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭을 열고, 닫고, 옮길 때 커지고 줄어들며 미끄러집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner vokser, krymper og glir når de åpnes, lukkes og flyttes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty rosną, kurczą się i przesuwają przy otwieraniu, zamykaniu i przenoszeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As abas crescem, encolhem e deslizam ao abrir, fechar e mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки растут, сжимаются и скользят при открытии, закрытии и перемещении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บจะขยาย หด และเลื่อนเมื่อเปิด ปิด และย้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sekmeler açılırken, kapanırken ve taşınırken büyür, küçülür ve kayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки ростуть, стискаються й ковзають під час відкриття, закриття й переміщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ phóng to, thu nhỏ và trượt khi mở, đóng và di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标签页在打开、关闭和移动时伸缩并滑动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分頁在開啟、關閉和移動時伸縮並滑動。"
          }
        }
      }
    },
    "settings.ui.animations.panes.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتحرك التقسيمات والإغلاقات والتكبير والفواصل والنوافذ بحركة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podjele, zatvaranja, zumiranja, razdjelnici i prozori pomiču se uz pokret."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opdelinger, lukninger, zoom, skillelinjer og vinduer bevæger sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teilungen, Schließen, Zoomen, Trennlinien und Fenster bewegen sich animiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits, closes, zooms, dividers and windows move with motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisiones, cierres, zoom, divisores y ventanas se mueven con animación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisions, fermetures, zooms, séparateurs et fenêtres bougent avec du mouvement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisioni, chiusure, zoom, divisori e finestre si spostano con movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割、閉じる、ズーム、仕切り、ウインドウに動きを付けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបំបែក ការបិទ ការពង្រីក បន្ទាត់ខណ្ឌ និងបង្អួច ផ្លាស់ទីដោយមានចលនា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "분할, 닫기, 확대, 구분선, 윈도우에 움직임이 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Delinger, lukkinger, zoom, skillelinjer og vinduer beveger seg med animasjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podziały, zamknięcia, powiększenia, separatory i okna poruszają się płynnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisões, fechamentos, zoom, divisores e janelas se movem com animação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разделения, закрытия, масштабирование, разделители и окна двигаются с анимацией."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแบ่ง การปิด การซูม เส้นแบ่ง และหน้าต่าง จะเคลื่อนที่อย่างมีการเคลื่อนไหว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bölmeler, kapanışlar, yakınlaştırmalar, ayırıcılar ve pencereler hareketle değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поділи, закриття, масштабування, роздільники й вікна рухаються з анімацією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chia khung, đóng, phóng to, đường chia và cửa sổ di chuyển có chuyển động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拆分、关闭、缩放、分隔线和窗口都带有动效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割、關閉、縮放、分隔線與視窗都帶有動態效果。"
          }
        }
      }
    },
    "settings.ui.animations.overlays.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتلاشى القوائم والنوافذ المنبثقة ولوحة الأوامر والأوراق والإشعارات العابرة والبطاقات وتنزلق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meniji, skočni prozori, paleta, listovi, obavijesti i kartice blijede i klize."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menuer, popovere, paletten, ark, toasts og kort toner og glider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menüs, Popover, die Palette, Sheets, Toasts und Karten blenden und gleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, popovers, the palette, sheets, toasts and cards fade and slide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menús, ventanas emergentes, la paleta, hojas, avisos y tarjetas aparecen con fundido y deslizamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menus, popovers, palette, feuilles, toasts et cartes apparaissent en fondu et en glissant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menu, popover, la palette, fogli, avvisi e schede informative entrano ed escono con dissolvenza e scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メニュー、ポップオーバー、パレット、シート、トースト、カードをフェードやスライドで表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ឺនុយ ផ្ទាំងលេចឡើង ផ្ទាំងបញ្ជា សន្លឹក ការជូនដំណឹង និងកាត ស្រអាប់ និងរំកិល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메뉴, 팝오버, 팔레트, 시트, 토스트, 카드가 페이드와 슬라이드로 나타나고 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyer, popovere, paletten, ark, varsler og kort tones og glir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menu, wyskakujące okna, paleta, arkusze, powiadomienia i karty przenikają i przesuwają się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menus, popovers, a paleta, folhas, avisos e cartões entram e saem com esmaecimento e deslize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Меню, всплывающие окна, палитра, листы, уведомления и карточки появляются с затуханием и скольжением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมนู ป็อปโอเวอร์ จานคำสั่ง ชีต การแจ้งเตือน และการ์ด จะค่อย ๆ ปรากฏและเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menüler, açılır pencereler, palet, sayfalar, bildirimler ve kartlar solarak ve kayarak girip çıkar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Меню, спливні вікна, палітра, аркуші, сповіщення й картки з’являються із затуханням і ковзанням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menu, cửa sổ bật lên, bảng lệnh, trang tính, thông báo và thẻ thông tin mờ dần và trượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "菜单、弹出框、命令面板、表单、提示和卡片以淡入淡出和滑动方式出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選單、彈出框、指令面板、表單、提示與卡片以淡入淡出和滑動方式出現。"
          }
        }
      }
    },
    "settings.ui.animations.hoverCards.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلاشى بطاقات التمرير والتلميحات وتنزلق عند ظهورها. عند الإيقاف تظهر وتختفي فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice pri prelasku i opisi alata blijede i klize unutra. Isključeno: prikazuju se i skrivaju odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svævekort og værktøjstip toner og glider ind. Fra: de vises og skjules med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover-Karten und Tooltips blenden und gleiten ein. Aus: sie erscheinen und verschwinden sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover cards and tooltips fade and slide in. Off: they show and hide at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas al pasar el cursor y las descripciones aparecen con fundido y deslizamiento. Desactivado: se muestran y ocultan al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes de survol et les infobulles apparaissent en fondu et en glissant. Désactivé : elles s’affichent et se masquent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede al passaggio e i suggerimenti entrano con dissolvenza e scorrimento. Disattivato: appaiono e spariscono subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホバーカードとツールチップをフェードとスライドで表示します。オフにすると即座に表示・非表示になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កាតពេលដាក់ទស្សន៍ទ្រនិច និងព័ត៌មានជំនួយ ស្រអាប់ និងរំកិលចូល។ បិទ៖ បង្ហាញ និងលាក់ភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호버 카드와 도움말이 페이드와 슬라이드로 나타납니다. 끄면 즉시 나타나고 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svevekort og verktøytips tones og glir inn. Av: de vises og skjules med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty podglądu i podpowiedzi pojawiają się z przenikaniem i przesunięciem. Wyłączone: pojawiają się i znikają od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões ao passar o cursor e dicas entram com esmaecimento e deslize. Desativado: aparecem e somem na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающие карточки и подсказки появляются с затуханием и скольжением. Выключено: появляются и скрываются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดเมื่อชี้และคำแนะนำจะค่อย ๆ ปรากฏและเลื่อนเข้า ปิด: แสดงและซ่อนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerine gelme kartları ve ipuçları solarak ve kayarak girer. Kapalı: anında gösterilir ve gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливні картки й підказки з’являються із затуханням і ковзанням. Вимкнено: з’являються й ховаються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ khi di chuột và chú giải công cụ mờ dần và trượt vào. Tắt: hiện và ẩn ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停卡片和工具提示以淡入和滑动方式出现。关闭：立即显示和隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸停卡片與工具提示以淡入和滑動方式出現。關閉：立即顯示與隱藏。"
          }
        }
      }
    },
    "settings.ui.animations.home.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتحرك محادثة Chief وفقاعاتها وحقل الكتابة وقائمة الرئيسية وتتلاشى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief razgovor, njegovi oblačići, polje za pisanje i lista Početne pomiču se i blijede."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief-chatten, dens bobler, skrivefeltet og Hjem-listen bevæger sig og toner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Chief-Chat, seine Blasen, das Eingabefeld und die Startliste bewegen sich und blenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief chat, its bubbles, the composer and the Home list move and fade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El chat de Chief, sus burbujas, el campo de redacción y la lista de Inicio se mueven y se desvanecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La discussion Chief, ses bulles, la zone de saisie et la liste d’accueil bougent et s’estompent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chat di Chief, le sue bolle, il campo di scrittura e l’elenco Home si muovono e sfumano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief チャット、吹き出し、入力欄、ホームのリストに動きとフェードを付けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែក Chief ពពុះរបស់វា ប្រអប់សរសេរ និងបញ្ជីទំព័រដើម ផ្លាស់ទី និងស្រអាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 채팅, 말풍선, 입력란, 홈 목록이 움직이고 페이드됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief-chatten, boblene, skrivefeltet og Hjem-listen beveger seg og tones."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czat Chief, jego dymki, pole pisania i lista strony głównej poruszają się i przenikają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O chat do Chief, seus balões, o campo de escrita e a lista do Início se movem e esmaecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чат Chief, его пузыри, поле ввода и список главной двигаются и затухают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แชท Chief ฟองข้อความ ช่องพิมพ์ และรายการหน้าหลักจะเคลื่อนที่และค่อย ๆ จางลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief sohbeti, baloncukları, yazma alanı ve ana sayfa listesi hareket eder ve solar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чат Chief, його бульбашки, поле введення та список головної рухаються й затухають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuộc trò chuyện Chief, bong bóng, ô soạn và danh sách Trang chủ di chuyển và mờ dần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 聊天、气泡、输入框和主页列表带有移动和淡入淡出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 聊天、對話泡泡、輸入框與首頁列表帶有移動與淡入淡出。"
          }
        }
      }
    },
    "settings.ui.animations.cursor.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينزلق مؤشر الوكيل ويعرض تموجات النقر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kursor agenta klizi i prikazuje talase klika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentmarkøren glider og viser klikbølger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Agent-Cursor gleitet und zeigt Klickwellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent cursor glides and shows click ripples."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El cursor del agente se desliza y muestra ondas al hacer clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le curseur de l’agent glisse et affiche des ondes de clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il cursore dell’agente scivola e mostra onde al clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントカーソルが滑らかに移動し、クリックの波紋を表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទស្សន៍ទ្រនិចភ្នាក់ងាររំកិល និងបង្ហាញរលកចុច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 커서가 미끄러지듯 이동하고 클릭 물결을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentmarkøren glir og viser klikkbølger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kursor agenta płynie i pokazuje fale kliknięć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cursor do agente desliza e mostra ondas de clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Курсор агента плавно движется и показывает волны щелчков."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เคอร์เซอร์เอเจนต์จะเลื่อนอย่างนุ่มนวลและแสดงระลอกเมื่อคลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aracı imleci kayar ve tıklama dalgaları gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Курсор агента плавно рухається й показує хвилі клацань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con trỏ tác tử lướt đi và hiện gợn sóng khi nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理光标平滑移动并显示点击涟漪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理游標平滑移動並顯示點按漣漪。"
          }
        }
      }
    },
    "settings.ui.animations.indicators.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تدور مؤشرات الانتظار وتنبض نقاط الحالة وتومض تنبيهات الانتباه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indikatori učitavanja se okreću, tačke statusa pulsiraju, a upozorenja trepere."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spinnere drejer, statusprikker pulserer og opmærksomhedsblink blinker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ladeanzeigen drehen sich, Statuspunkte pulsieren und Hinweisblitze blinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinners turn, status dots pulse and attention flashes blink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los indicadores de carga giran, los puntos de estado laten y los avisos parpadean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les indicateurs de chargement tournent, les points d’état pulsent et les alertes clignotent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli indicatori di caricamento ruotano, i punti di stato pulsano e gli avvisi lampeggiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スピナーが回転し、状態ドットが脈打ち、注意の点滅が光ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សញ្ញាផ្ទុកបង្វិល ចំណុចស្ថានភាពលោតញ័រ និងការព្រមានភ្លឹបភ្លែត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스피너가 회전하고 상태 점이 깜박이며 주의 표시가 반짝입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spinnere snurrer, statusprikker pulserer og varselblink blinker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wskaźniki ładowania się obracają, kropki stanu pulsują, a alerty migają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indicadores de carregamento giram, pontos de status pulsam e alertas piscam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Индикаторы загрузки вращаются, точки состояния пульсируют, а предупреждения мигают."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตัวหมุนจะหมุน จุดสถานะจะกะพริบเป็นจังหวะ และการแจ้งเตือนจะกะพริบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yükleme göstergeleri döner, durum noktaları atar ve uyarılar yanıp söner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Індикатори завантаження обертаються, точки стану пульсують, а попередження блимають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vòng xoay quay, chấm trạng thái nhấp nháy theo nhịp và cảnh báo chớp sáng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "加载指示器旋转，状态点脉动，提醒闪烁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "載入指示器旋轉，狀態點脈動，提醒閃爍。"
          }
        }
      }
    },
    "settings.ui.animations.feedback.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر تغييرات التمرير والضغط والتركيز وألوان السمة بسلاسة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prelazak, pritisak, fokus i promjene boja teme pojavljuju se postepeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farveskift ved svæv, tryk, fokus og tema glider ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hover, Klick, Fokus und Farbwechsel des Themas blenden weich ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover, press, focus and theme color changes ease in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los resaltados al pasar y pulsar, el foco y los cambios de color del tema aparecen suavemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les changements de survol, d’appui, de focus et de couleur du thème apparaissent en douceur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passaggio, pressione, focus e cambi di colore del tema compaiono gradualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホバー、押下、フォーカス、テーマの色の変化をなめらかに表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការប្ដូរពេលដាក់ទស្សន៍ទ្រនិច ចុច ផ្ដោត និងពណ៌រចនាប័ទ្ម លេចឡើងបន្តិចម្ដងៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호버, 누르기, 포커스, 테마 색상 변경이 부드럽게 나타납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Endringer ved sveving, trykk, fokus og temafarger tones inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zmiany przy najechaniu, naciśnięciu, fokusie i kolorach motywu pojawiają się płynnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Realces ao passar e pressionar, foco e mudanças de cor do tema surgem suavemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подсветка при наведении и нажатии, фокус и смена цветов темы появляются плавно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การชี้ การกด โฟกัส และการเปลี่ยนสีธีม จะค่อย ๆ ปรากฏ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Üzerine gelme, basma, odak ve tema renk değişiklikleri yumuşakça belirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Підсвічування під час наведення й натискання, фокус і зміни кольорів теми з’являються плавно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thay đổi khi di chuột, nhấn, tiêu điểm và màu chủ đề hiện dần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "悬停、按下、焦点和主题颜色变化都会平滑出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "懸停、按下、焦點與主題顏色變化都會平滑出現。"
          }
        }
      }
    },
    "settings.ui.animations.web.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الرسوم المتحركة في صفحات cmux نفسها، مثل المحادثات وعلامة التبويب الجديدة. لا تتغير المواقع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animacije na cmuxovim stranicama, poput razgovora i Nove kartice. Druge web stranice se ne mijenjaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animationer på cmux' egne sider, som chats og Ny fane. Websteder ændres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animationen auf cmux-eigenen Seiten wie Chats und Neuer Tab. Websites bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animations in cmux's own pages, such as chats and New Tab. Websites are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animaciones en las páginas propias de cmux, como chats y Nueva pestaña. Los sitios web no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animations des pages propres à cmux, comme les discussions et Nouvel onglet. Les sites web ne changent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animazioni nelle pagine di cmux, come chat e Nuova scheda. I siti web non cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャットや新規タブなど cmux 独自のページのアニメーションです。Web サイトは変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចលនានៅក្នុងទំព័រផ្ទាល់របស់ cmux ដូចជាការជជែក និងផ្ទាំងថ្មី។ គេហទំព័រមិនផ្លាស់ប្ដូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅, 새 탭 같은 cmux 자체 페이지의 애니메이션입니다. 다른 웹사이트는 바뀌지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animasjoner på cmux sine egne sider, som chatter og Ny fane. Nettsteder endres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animacje na stronach cmux, takich jak czaty i Nowa karta. Inne witryny się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Animações nas páginas do próprio cmux, como chats e Nova aba. Outros sites não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Анимации на собственных страницах cmux, например в чатах и на новой вкладке. Сайты не меняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ภาพเคลื่อนไหวในหน้าของ cmux เอง เช่น แชทและแท็บใหม่ เว็บไซต์อื่นไม่เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbetler ve Yeni Sekme gibi cmux'un kendi sayfalarındaki animasyonlar. Web siteleri değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Анімації на власних сторінках cmux, як-от у чатах і на новій вкладці. Інші сайти не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoạt ảnh trong các trang của chính cmux, như trò chuyện và Thẻ mới. Các trang web không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 自有页面（如聊天和新标签页）中的动画。其他网站不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 自有頁面（如聊天與新分頁）中的動畫。其他網站不受影響。"
          }
        }
      }
    },
