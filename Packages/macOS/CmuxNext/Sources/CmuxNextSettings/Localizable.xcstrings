    "settings.phone.keepAwake.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the lid still puts the Mac to sleep."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إغلاق الغطاء لا يزال يُدخل الـ Mac في وضع السكون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatvaranje poklopca i dalje uspavljuje Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du lukker låget, går Mac'en stadig i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Zuklappen geht der Mac weiterhin in den Ruhezustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al cerrar la tapa, el Mac sigue entrando en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermer le couvercle met toujours le Mac en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiudendo il coperchio il Mac va comunque in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓋を閉じると Mac はスリープします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបិទគម្របនៅតែធ្វើឱ្យ Mac ដេក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "덮개를 닫으면 Mac은 여전히 잠자기 상태가 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du lukker lokket, går Macen fortsatt i dvale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamknięcie pokrywy nadal usypia Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fechar a tampa ainda coloca o Mac em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закрытие крышки по-прежнему переводит Mac в сон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การปิดฝายังทำให้ Mac พักเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapağı kapatmak Mac'i yine uyutur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закриття кришки так само переводить Mac у режим сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gập nắp vẫn đưa máy Mac vào chế độ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "合上盖子仍会让 Mac 进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "闔上螢幕仍會讓 Mac 進入睡眠。"
          }
        }
      }
    },
