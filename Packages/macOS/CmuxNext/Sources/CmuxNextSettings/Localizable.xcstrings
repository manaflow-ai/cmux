    "settings.phone.cloudReplica.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux stores this Mac's workspace names, colors and unread counts so your phone can show them while the Mac is off. A workspace name can be a folder's name. No paths, tab titles or terminal output. Turning this off deletes the copy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخزّن cmux أسماء مساحات عمل هذا الـ Mac وألوانها وأعداد غير المقروء حتى يتمكن هاتفك من عرضها أثناء إيقاف تشغيل الـ Mac. قد يكون اسم مساحة العمل اسم مجلد. لا يتم تخزين المسارات أو عناوين علامات التبويب أو مخرجات الطرفية. يؤدي إيقاف هذا الخيار إلى حذف النسخة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux čuva nazive, boje i broj nepročitanih stavki radnih prostora ovog Maca kako bi ih telefon mogao prikazati dok je Mac isključen. Naziv radnog prostora može biti naziv mape. Bez putanja, naslova kartica ili izlaza terminala. Isključivanjem ove opcije kopija se briše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux gemmer navne, farver og antal ulæste for denne Macs arbejdsområder, så din telefon kan vise dem, mens Mac'en er slukket. Et arbejdsområdes navn kan være en mappes navn. Ingen stier, fanetitler eller terminaloutput. Når du slår dette fra, slettes kopien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux speichert Namen, Farben und Anzahl ungelesener Einträge der Arbeitsbereiche dieses Macs, damit dein Telefon sie anzeigen kann, während der Mac aus ist. Der Name eines Arbeitsbereichs kann ein Ordnername sein. Keine Pfade, Tab-Titel oder Terminalausgaben. Beim Ausschalten wird die Kopie gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux guarda los nombres, colores y recuentos de no leídos de los espacios de trabajo de este Mac para que tu teléfono pueda mostrarlos mientras el Mac está apagado. El nombre de un espacio de trabajo puede ser el de una carpeta. Sin rutas, títulos de pestañas ni salida de terminal. Al desactivarlo se elimina la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux conserve les noms, couleurs et nombres de non-lus des espaces de travail de ce Mac pour que votre téléphone puisse les afficher lorsque le Mac est éteint. Le nom d'un espace de travail peut être celui d'un dossier. Aucun chemin, titre d'onglet ni sortie de terminal. Désactiver cette option supprime la copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux memorizza nomi, colori e conteggi dei non letti degli spazi di lavoro di questo Mac, così il telefono può mostrarli quando il Mac è spento. Il nome di uno spazio di lavoro può essere il nome di una cartella. Nessun percorso, titolo di pannello o output del terminale. Disattivando l'opzione la copia viene eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがオフのときもスマートフォンに表示できるよう、cmuxはこのMacのワークスペース名、色、未読数を保存します。ワークスペース名がフォルダ名の場合があります。パス、タブのタイトル、ターミナル出力は保存しません。オフにするとコピーは削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux រក្សាទុកឈ្មោះ ពណ៌ និងចំនួនមិនទាន់អានរបស់កន្លែងធ្វើការលើ Mac នេះ ដើម្បីឱ្យទូរសព្ទរបស់អ្នកអាចបង្ហាញពួកវា ពេល Mac បិទ។ ឈ្មោះកន្លែងធ្វើការអាចជាឈ្មោះថត។ គ្មានផ្លូវ ចំណងជើងផ្ទាំង ឬលទ្ធផលស្ថានីយទេ។ ការបិទជម្រើសនេះនឹងលុបច្បាប់ចម្លង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 꺼져 있을 때도 휴대폰에 표시할 수 있도록 cmux가 이 Mac의 작업 공간 이름, 색상, 읽지 않은 개수를 저장합니다. 작업 공간 이름이 폴더 이름일 수 있습니다. 경로, 탭 제목, 터미널 출력은 저장하지 않습니다. 끄면 사본이 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux lagrer navn, farger og antall uleste for denne Macens arbeidsområder slik at telefonen kan vise dem mens Macen er av. Navnet på et arbeidsområde kan være navnet på en mappe. Ingen stier, fanetitler eller terminalutdata. Når du slår dette av, slettes kopien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux przechowuje nazwy, kolory i liczby nieprzeczytanych obszarów roboczych tego Maca, aby telefon mógł je wyświetlać, gdy Mac jest wyłączony. Nazwa obszaru roboczego może być nazwą folderu. Bez ścieżek, tytułów kart ani danych wyjściowych terminala. Wyłączenie tej opcji usuwa kopię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux armazena os nomes, as cores e as contagens de não lidos dos espaços de trabalho deste Mac para que o celular possa mostrá-los enquanto o Mac estiver desligado. O nome de um espaço de trabalho pode ser o nome de uma pasta. Sem caminhos, títulos de abas ou saída do terminal. Desativar esta opção apaga a cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux хранит названия, цвета и число непрочитанных рабочих пространств этого Mac, чтобы телефон мог показывать их, когда Mac выключен. Название рабочего пространства может совпадать с названием папки. Без путей, заголовков вкладок и вывода терминала. При выключении параметра копия удаляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux จัดเก็บชื่อ สี และจำนวนที่ยังไม่ได้อ่านของพื้นที่ทำงานบน Mac เครื่องนี้ เพื่อให้โทรศัพท์แสดงได้ขณะที่ Mac ปิดอยู่ ชื่อพื้นที่ทำงานอาจเป็นชื่อโฟลเดอร์ ไม่มีพาธ ชื่อแท็บ หรือเอาต์พุตเทอร์มินัล การปิดตัวเลือกนี้จะลบสำเนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux, Mac kapalıyken telefonunun gösterebilmesi için bu Mac'in çalışma alanı adlarını, renklerini ve okunmamış sayılarını saklar. Bir çalışma alanının adı bir klasörün adı olabilir. Yol, sekme başlığı veya terminal çıktısı saklanmaz. Bunu kapatmak kopyayı siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux зберігає назви, кольори й кількість непрочитаних робочих просторів цього Mac, щоб телефон міг показувати їх, коли Mac вимкнений. Назва робочого простору може бути назвою папки. Без шляхів, заголовків вкладок і виводу термінала. Вимкнення параметра видаляє копію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux lưu tên, màu và số mục chưa đọc của các không gian làm việc trên máy Mac này để điện thoại có thể hiển thị khi máy Mac tắt. Tên không gian làm việc có thể là tên thư mục. Không lưu đường dẫn, tiêu đề tab hay đầu ra terminal. Tắt tùy chọn này sẽ xóa bản sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 会存储此 Mac 的工作区名称、颜色和未读数，以便在 Mac 关机时手机仍可显示。工作区名称可能是文件夹名称。不包含路径、标签页标题或终端输出。关闭此选项会删除该副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 會儲存此 Mac 的工作區名稱、顏色和未讀數，以便在 Mac 關機時手機仍可顯示。工作區名稱可能是檔案夾名稱。不包含路徑、標籤頁標題或終端機輸出。關閉此選項會刪除該副本。"
          }
        }
      }
    },
    "settings.phone.keepAwake": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Mac Awake for Your Phone"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء Mac مستيقظًا لهاتفك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži Mac budnim za telefon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Mac vågen til din telefon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac für dein Telefon wach halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el Mac activo para tu teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le Mac éveillé pour votre téléphone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il Mac attivo per il telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのために Mac をスリープさせない"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សា Mac ឱ្យភ្ញាក់សម្រាប់ទូរសព្ទរបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 위해 Mac 깨어 있게 유지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Mac våken for telefonen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usypiaj Maca dla telefonu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter o Mac ativo para o celular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давать Mac засыпать ради телефона"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ให้ Mac พักเครื่องเพื่อโทรศัพท์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz için Mac'i uyanık tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не давати Mac засинати для телефона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Mac thức cho điện thoại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为手机让 Mac 保持唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為手機讓 Mac 保持喚醒"
          }
        }
      }
    },
    "settings.phone.keepAwake.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sleeping Mac can't be reached from your phone until it wakes. Closing the lid still puts the Mac to sleep."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى Mac في وضع السكون من هاتفك حتى يستيقظ. إغلاق الغطاء لا يزال يُدخل الـ Mac في وضع السكون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac u stanju mirovanja nije dostupan s telefona dok se ne probudi. Zatvaranje poklopca i dalje uspavljuje Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Mac i dvale kan ikke nås fra din telefon, før den vågner. Når du lukker låget, går Mac'en stadig i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schlafender Mac ist vom Telefon aus erst wieder erreichbar, wenn er aufwacht. Beim Zuklappen geht der Mac weiterhin in den Ruhezustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes acceder a un Mac en reposo desde el teléfono hasta que se active. Al cerrar la tapa, el Mac sigue entrando en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac en veille est injoignable depuis votre téléphone jusqu’à son réveil. Fermer le couvercle met toujours le Mac en veille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac in stop non è raggiungibile dal telefono finché non si riattiva. Chiudendo il coperchio il Mac va comunque in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ中の Mac には、スリープが解除されるまでスマートフォンから接続できません。蓋を閉じると Mac はスリープします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ដែលកំពុងដេក មិនអាចចូលប្រើពីទូរសព្ទបានទេ រហូតដល់វាភ្ញាក់។ ការបិទគម្របនៅតែធ្វើឱ្យ Mac ដេក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 상태인 Mac은 깨어날 때까지 휴대폰에서 연결할 수 없습니다. 덮개를 닫으면 Mac은 여전히 잠자기 상태가 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En Mac i dvale kan ikke nås fra telefonen før den våkner. Når du lukker lokket, går Macen fortsatt i dvale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uśpiony Mac jest niedostępny z telefonu, dopóki się nie obudzi. Zamknięcie pokrywy nadal usypia Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Mac em repouso não pode ser acessado pelo celular até ser despertado. Fechar a tampa ainda coloca o Mac em repouso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спящий Mac недоступен с телефона, пока не проснётся. Закрытие крышки по-прежнему переводит Mac в сон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ที่พักเครื่องอยู่จะเข้าถึงจากโทรศัพท์ไม่ได้จนกว่าจะตื่น การปิดฝายังทำให้ Mac พักเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyuyan bir Mac'e uyanana kadar telefonunuzdan ulaşılamaz. Kapağı kapatmak Mac'i yine uyutur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До Mac у режимі сну не можна підключитися з телефона, доки він не прокинеться. Закриття кришки так само переводить Mac у режим сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập máy Mac đang ngủ từ điện thoại cho đến khi máy thức dậy. Gập nắp vẫn đưa máy Mac vào chế độ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠中的 Mac 在唤醒前无法从手机访问。合上盖子仍会让 Mac 进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠中的 Mac 在喚醒前無法從手機存取。闔上螢幕仍會讓 Mac 進入睡眠。"
          }
        }
      }
    },
