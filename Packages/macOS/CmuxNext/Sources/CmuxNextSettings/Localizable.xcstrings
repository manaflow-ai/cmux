    "settings.sidebar.workspacesAsTabs.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل مساحة عمل في سطر واحد، مثل الشريط الجانبي في Claude، وينتقل Command-Shift-[ و ] إلى مساحة العمل السابقة أو التالية بدلاً من علامة التبويب السابقة أو التالية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki radni prostor je jedan red, kao Claudeov bočni panel, a Command-Shift-[ i ] idu na prethodni ili sljedeći radni prostor umjesto na prethodnu ili sljedeću karticu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert arbejdsområde er én linje, som Claudes sidebjælke, og Command-Shift-[ og ] går til forrige eller næste arbejdsområde i stedet for forrige eller næste fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Arbeitsbereich belegt eine Zeile, wie die Seitenleiste von Claude, und Command-Umschalt-[ und ] wechseln zum vorherigen oder nächsten Arbeitsbereich statt zum vorherigen oder nächsten Tab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each workspace is one line, like Claude's sidebar, and Command-Shift-[ and ] go to the previous or next workspace instead of the previous or next tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada espacio de trabajo ocupa una línea, como la barra lateral de Claude, y Command-Shift-[ y ] van al espacio de trabajo anterior o siguiente en lugar de la pestaña anterior o siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque espace de travail tient sur une ligne, comme la barre latérale de Claude, et Command-Maj-[ et ] passent à l’espace de travail précédent ou suivant au lieu de l’onglet précédent ou suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni workspace occupa una riga, come la barra laterale di Claude, e Command-Maiusc-[ e ] passano al workspace precedente o successivo invece che alla scheda precedente o successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claudeのサイドバーのように、各ワークスペースを1行で表示します。Command-Shift-[ と ] は、前後のタブではなく前後のワークスペースに移動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការនីមួយៗជាមួយបន្ទាត់ ដូចរបារចំហៀងរបស់ Claude ហើយ Command-Shift-[ និង ] ទៅកន្លែងធ្វើការមុន ឬបន្ទាប់ ជំនួសឱ្យផ្ទាំងមុន ឬបន្ទាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Claude의 사이드바처럼 워크스페이스마다 한 줄로 표시되며, Command-Shift-[ 와 ]는 이전/다음 탭 대신 이전/다음 워크스페이스로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert arbeidsområde er én linje, som sidepanelet i Claude, og Command-Shift-[ og ] går til forrige eller neste arbeidsområde i stedet for forrige eller neste fane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy obszar roboczy zajmuje jeden wiersz, jak na pasku bocznym Claude, a Command-Shift-[ i ] przechodzą do poprzedniego lub następnego obszaru roboczego zamiast do poprzedniej lub następnej karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada espaço de trabalho ocupa uma linha, como a barra lateral do Claude, e Command-Shift-[ e ] vão para o espaço de trabalho anterior ou seguinte em vez da aba anterior ou seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каждое рабочее пространство занимает одну строку, как на боковой панели Claude, а Command-Shift-[ и ] переходят к предыдущему или следующему рабочему пространству вместо предыдущей или следующей вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แต่ละเวิร์กสเปซเป็นหนึ่งบรรทัด เหมือนแถบข้างของ Claude และ Command-Shift-[ กับ ] จะไปยังเวิร์กสเปซก่อนหน้าหรือถัดไปแทนแท็บก่อนหน้าหรือถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her çalışma alanı Claude’un kenar çubuğundaki gibi tek satırdır; Command-Shift-[ ve ] önceki veya sonraki sekme yerine önceki veya sonraki çalışma alanına geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожен робочий простір займає один рядок, як на бічній панелі Claude, а Command-Shift-[ і ] переходять до попереднього або наступного робочого простору замість попередньої чи наступної вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi không gian làm việc là một dòng, như thanh bên của Claude, và Command-Shift-[ và ] chuyển đến không gian làm việc trước hoặc sau thay vì thẻ trước hoặc sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个工作区占一行，就像 Claude 的侧边栏；Command-Shift-[ 和 ] 会切换到上一个或下一个工作区，而不是上一个或下一个标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個工作區佔一行，就像 Claude 的側邊欄；Command-Shift-[ 和 ] 會切換到上一個或下一個工作區，而不是上一個或下一個標籤頁。"
          }
        }
      }
    },
