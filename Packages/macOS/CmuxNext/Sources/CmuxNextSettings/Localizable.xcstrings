    "settings.appearance.colorTransition.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace, theme and color changes blend from the old colors to the new ones. Off: they change at once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمتزج تغييرات مساحة العمل والسمة والألوان من الألوان القديمة إلى الجديدة. عند الإيقاف: تتغير فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene radnog prostora, teme i boja prelaze iz starih boja u nove. Isključeno: mijenjaju se odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift af arbejdsområde, tema og farver glider fra de gamle farver til de nye. Fra: de skifter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsel von Arbeitsbereich, Design und Farben blenden von den alten in die neuen Farben über. Aus: Sie wechseln sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de espacio de trabajo, tema y color pasan suavemente de los colores anteriores a los nuevos. Desactivado: cambian al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements d’espace de travail, de thème et de couleur passent en fondu des anciennes couleurs aux nouvelles. Désactivé : ils sont immédiats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cambi di area di lavoro, tema e colore sfumano dai vecchi colori ai nuovi. Disattivato: cambiano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース、テーマ、色の変更が古い色から新しい色へなめらかに変わります。オフ：すぐに切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប្ដូរកន្លែងធ្វើការ ស្បែក និងពណ៌ លាយពីពណ៌ចាស់ទៅពណ៌ថ្មី។ បិទ៖ ប្ដូរភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간, 테마, 색상 변경이 이전 색에서 새 색으로 부드럽게 바뀝니다. 끄면 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer av arbeidsområde, tema og farger glir fra de gamle fargene til de nye. Av: de endres med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany obszaru roboczego, motywu i kolorów płynnie przechodzą od starych kolorów do nowych. Wyłączone: zmieniają się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudanças de espaço de trabalho, tema e cor passam suavemente das cores antigas para as novas. Desativado: mudam na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена рабочего пространства, темы и цветов плавно переходит от старых цветов к новым. Выкл.: меняются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนพื้นที่ทำงาน ธีม และสี จะค่อย ๆ ผสมจากสีเดิมไปเป็นสีใหม่ ปิด: เปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanı, tema ve renk değişiklikleri eski renklerden yenilerine yumuşakça geçer. Kapalı: hemen değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна робочого простору, теми та кольорів плавно переходить від старих кольорів до нових. Вимк.: змінюються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đổi không gian làm việc, chủ đề và màu, màu cũ chuyển dần sang màu mới. Tắt: đổi ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换工作区、主题和颜色时，旧颜色会平滑过渡到新颜色。关闭：立即切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換工作區、主題和顏色時，舊顏色會平順過渡到新顏色。關閉：立即切換。"
          }
        }
      }
    },
