    "settings.browser.toolbarPosition.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the address bar row of browser and Markdown panes sits. At the bottom, its suggestions and menus open upward."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مكان صف شريط العنوان في أجزاء المتصفح و Markdown. في الأسفل، تُفتح اقتراحاته وقوائمه إلى الأعلى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdje se nalazi red adresne trake u oknima preglednika i Markdowna. Na dnu se njeni prijedlozi i meniji otvaraju prema gore."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor adresselinjens række sidder i browser- og Markdown-ruder. Nederst åbner dens forslag og menuer opad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wo die Zeile mit der Adressleiste in Browser- und Markdown-Bereichen sitzt. Unten öffnen sich ihre Vorschläge und Menüs nach oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dónde se sitúa la fila de la barra de direcciones en los paneles de navegador y de Markdown. Abajo, sus sugerencias y menús se abren hacia arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’emplacement de la rangée de la barre d’adresse dans les sous-fenêtres de navigateur et Markdown. En bas, ses suggestions et menus s’ouvrent vers le haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove si trova la riga della barra degli indirizzi nei riquadri del browser e Markdown. In basso, i suggerimenti e i menu si aprono verso l’alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザと Markdown のペインでアドレスバーの行を置く位置。下に置くと、候補とメニューは上向きに開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងដែលជួររបារអាសយដ្ឋាននៃផ្ទាំងកម្មវិធីរុករក និង Markdown ស្ថិតនៅ។ នៅខាងក្រោម សំណើ និងម៉ឺនុយរបស់វាបើកឡើងលើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 및 Markdown 패널에서 주소 막대 행의 위치입니다. 아래에 두면 제안과 메뉴가 위쪽으로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor adresselinjeraden står i nettleser- og Markdown-ruter. Nederst åpnes forslagene og menyene oppover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdzie znajduje się wiersz paska adresu w panelach przeglądarki i Markdown. Na dole jego podpowiedzi i menu otwierają się w górę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde fica a linha da barra de endereço nos painéis de navegador e Markdown. Embaixo, as sugestões e os menus abrem para cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Где находится строка адресной строки в панелях браузера и Markdown. Внизу её подсказки и меню открываются вверх."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตำแหน่งของแถวแถบที่อยู่ในบานหน้าต่างเบราว์เซอร์และ Markdown เมื่ออยู่ด้านล่าง คำแนะนำและเมนูจะเปิดขึ้นด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarayıcı ve Markdown bölmelerinde adres çubuğu satırının yeri. Altta olduğunda öneriler ve menüler yukarı doğru açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Де розташований рядок адресного рядка в панелях браузера й Markdown. Унизу його підказки та меню відкриваються вгору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vị trí hàng thanh địa chỉ trong các ngăn trình duyệt và Markdown. Khi ở dưới cùng, gợi ý và menu của nó mở lên trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浏览器和 Markdown 窗格中地址栏一行的位置。放在底部时，其建议和菜单向上打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "瀏覽器和 Markdown 窗格中網址列一行的位置。放在底部時，其建議和選單會向上開啟。"
          }
        }
      }
    },
