    "settings.chief.reactionClassifier.model.help": {
      "comment": "Chief reaction classifier (a416).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model that decides whether a reaction starts a turn. Claude Haiku by default: it is fast and cheap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアクションでターンを開始するかを判断するモデル。既定はClaude Haikuです(高速で安価)。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النموذج الذي يقرر ما إذا كان التفاعل يبدأ دورًا. Claude Haiku افتراضيًا: سريع ورخيص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Model koji odlučuje pokreće li reakcija potez. Zadano Claude Haiku: brz je i jeftin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modellen der afgør, om en reaktion starter en tur. Claude Haiku som standard: hurtig og billig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Modell, das entscheidet, ob eine Reaktion einen Zug startet. Standard ist Claude Haiku: schnell und günstig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El modelo que decide si una reacción inicia un turno. Claude Haiku por defecto: es rápido y barato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modèle qui décide si une réaction lance un tour. Claude Haiku par défaut : rapide et bon marché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il modello che decide se una reazione avvia un turno. Claude Haiku di default: è veloce ed economico."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ូដែលដែលសម្រេចថាប្រតិកម្មចាប់ផ្ដើមវេនឬអត់។ លំនាំដើម Claude Haiku៖ លឿន និងថោក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "반응이 턴을 시작할지 판단하는 모델. 기본값은 빠르고 저렴한 Claude Haiku입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modellen som avgjør om en reaksjon starter en tur. Claude Haiku som standard: rask og billig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Model, który decyduje, czy reakcja rozpoczyna turę. Domyślnie Claude Haiku: szybki i tani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O modelo que decide se uma reação inicia um turno. Claude Haiku por padrão: é rápido e barato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Модель, которая решает, начинает ли реакция ход. По умолчанию Claude Haiku: быстрая и недорогая."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โมเดลที่ตัดสินว่ารีแอคชันเริ่มรอบหรือไม่ ค่าเริ่มต้นคือ Claude Haiku ซึ่งเร็วและถูก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir tepkinin tur başlatıp başlatmayacağına karar veren model. Varsayılan Claude Haiku: hızlı ve ucuz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Модель, що вирішує, чи починає реакція хід. Типово Claude Haiku: швидка й недорога."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mô hình quyết định một cảm xúc có bắt đầu lượt hay không. Mặc định là Claude Haiku: nhanh và rẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "判断回应是否开始一轮的模型。默认使用 Claude Haiku:快速且便宜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "判斷回應是否開始一輪的模型。預設使用 Claude Haiku:快速且便宜。"
          }
        }
      }
    },
