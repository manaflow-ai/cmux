        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب الأدوات في علامة التبويب الجديدة. انقر بزر الماوس الأيمن على علامة التبويب الجديدة واختر \"تعديل علامة التبويب الجديدة\" لسحبها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Redoslijed vidžeta na novoj kartici. Desnom tipkom kliknite novu karticu i odaberite Uredi novu karticu da ih prevučete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rækkefølgen af widgets på ny fane. Højreklik på ny fane, og vælg Rediger ny fane for at trække dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge der Widgets im neuen Tab. Klicke mit der rechten Maustaste auf den neuen Tab und wähle „Neuen Tab bearbeiten“, um sie zu ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order of the widgets on New Tab. Right-click New Tab and choose Edit New Tab to drag them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden de los widgets en la nueva pestaña. Haz clic derecho en la nueva pestaña y elige Editar nueva pestaña para arrastrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre des widgets du nouvel onglet. Cliquez avec le bouton droit sur le nouvel onglet et choisissez Modifier le nouvel onglet pour les faire glisser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordine dei widget nella nuova scheda. Fai clic con il pulsante destro sulla nuova scheda e scegli Modifica nuova scheda per trascinarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブのウィジェットの順序です。新規タブを右クリックして「新規タブを編集」を選ぶと、ドラッグで並べ替えられます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លំដាប់ធាតុក្រាហ្វិកនៅលើផ្ទាំងថ្មី។ ចុចខាងស្ដាំលើផ្ទាំងថ្មី ហើយជ្រើស កែផ្ទាំងថ្មី ដើម្បីអូសពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 탭에 있는 위젯의 순서입니다. 새 탭을 오른쪽 클릭하고 새 탭 편집을 선택하면 드래그해서 옮길 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekkefølgen på widgetene på ny fane. Høyreklikk på ny fane og velg Rediger ny fane for å dra dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejność widżetów na nowej karcie. Kliknij nową kartę prawym przyciskiem i wybierz Edytuj nową kartę, aby je przeciągać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ordem dos widgets na nova aba. Clique com o botão direito na nova aba e escolha Editar nova aba para arrastá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок виджетов в новой вкладке. Нажмите на новую вкладку правой кнопкой и выберите «Изменить новую вкладку», чтобы перетаскивать их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลำดับของวิดเจ็ตในแท็บใหม่ คลิกขวาที่แท็บใหม่แล้วเลือก แก้ไขแท็บใหม่ เพื่อลากจัดเรียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Sekme'deki widget'ların sırası. Sürüklemek için Yeni Sekme'ye sağ tıklayıp Yeni Sekmeyi Düzenle'yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок віджетів у новій вкладці. Клацніть нову вкладку правою кнопкою й виберіть «Редагувати нову вкладку», щоб перетягувати їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thứ tự các tiện ích trên thẻ mới. Bấm chuột phải vào thẻ mới và chọn Sửa thẻ mới để kéo chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新标签页上小组件的顺序。右键点按新标签页并选择“编辑新标签页”即可拖移它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新分頁上小工具的順序。在新分頁上按右鍵並選擇「編輯新分頁」即可拖移它們。"
          }
        }
      }
    },
