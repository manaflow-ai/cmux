    "settings.newTerminal.opensWorkspace.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط مع الاستمرار على Option لعكس ذلك لنقرة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Držite Option da to obrnete za jedan klik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold Option nede for at vende det om for ét klik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halte Option gedrückt, um dies für einen Klick umzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Option to reverse it for one click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén pulsada Option para invertirlo durante un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maintenez Option pour inverser ce réglage le temps d’un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni premuto Option per invertirlo per un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Option を押しながらクリックすると、その1回だけ逆になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សង្កត់ Option ដើម្បីបញ្ច្រាសវាសម្រាប់ការចុចមួយដង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Option을 누른 채 클릭하면 한 번만 반대로 동작합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold inne Option for å snu det for ett klikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przytrzymaj Option, aby odwrócić to dla jednego kliknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha Option pressionada para inverter isso em um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удерживайте Option, чтобы изменить это для одного щелчка."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กด Option ค้างไว้เพื่อสลับการทำงานนี้สำหรับการคลิกครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
