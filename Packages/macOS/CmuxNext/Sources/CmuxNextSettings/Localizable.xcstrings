    "settings.sidebar.showSearchButton.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A magnifying glass after the profile button searches workspaces, tabs, history, agent chats, settings and commands. Off, Search stays in the command palette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールボタンの隣の虫眼鏡で、ワークスペース、タブ、履歴、エージェントチャット、設定、コマンドを検索します。オフにしても、検索はコマンドパレットから使えます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عدسة مكبرة بعد زر الملف الشخصي تبحث في مساحات العمل وعلامات التبويب والسجل ومحادثات الوكلاء والإعدادات والأوامر. عند الإيقاف يبقى البحث في لوحة الأوامر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lupa nakon dugmeta profila pretražuje radne prostore, kartice, historiju, razgovore s agentima, postavke i komande. Kad je isključeno, pretraga ostaje u paleti komandi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et forstørrelsesglas efter profilknappen søger i arbejdsområder, faner, historik, agentchats, indstillinger og kommandoer. Slået fra findes Søg stadig i kommandopaletten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Lupe neben der Profiltaste durchsucht Arbeitsbereiche, Tabs, Verlauf, Agent-Chats, Einstellungen und Befehle. Aus: Die Suche bleibt in der Befehlspalette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una lupa junto al botón de perfil busca en espacios de trabajo, pestañas, historial, chats de agentes, ajustes y comandos. Desactivado, la búsqueda sigue en la paleta de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une loupe après le bouton de profil recherche espaces de travail, onglets, historique, discussions d’agents, réglages et commandes. Désactivé, la recherche reste dans la palette de commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una lente dopo il pulsante del profilo cerca spazi di lavoro, schede, cronologia, chat degli agenti, impostazioni e comandi. Se disattivato, la ricerca resta nella palette dei comandi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កែវពង្រីកនៅក្រោយប៊ូតុងប្រវត្តិរូប ស្វែងរកកន្លែងធ្វើការ ផ្ទាំង ប្រវត្តិ ការជជែកជាមួយភ្នាក់ងារ ការកំណត់ និងពាក្យបញ្ជា។ បើបិទ ការស្វែងរកនៅតែមាននៅក្នុងផ្ទាំងពាក្យបញ្ជា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로필 버튼 옆의 돋보기로 워크스페이스, 탭, 기록, 에이전트 채팅, 설정, 명령을 검색합니다. 끄면 검색은 명령 팔레트에 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et forstørrelsesglass etter profilknappen søker i arbeidsområder, faner, logg, agentchatter, innstillinger og kommandoer. Av: Søk finnes fortsatt i kommandopaletten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lupa za przyciskiem profilu przeszukuje obszary robocze, karty, historię, czaty z agentami, ustawienia i polecenia. Po wyłączeniu wyszukiwanie zostaje w palecie poleceń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma lupa após o botão de perfil pesquisa espaços de trabalho, abas, histórico, chats de agentes, ajustes e comandos. Desativado, a pesquisa continua na paleta de comandos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лупа после кнопки профиля ищет по рабочим пространствам, вкладкам, истории, чатам агентов, настройкам и командам. Если выключено, поиск остаётся в палитре команд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แว่นขยายถัดจากปุ่มโปรไฟล์ค้นหาพื้นที่ทำงาน แท็บ ประวัติ แชทเอเจนต์ การตั้งค่า และคำสั่ง เมื่อปิด การค้นหายังอยู่ในพาเลตคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil düğmesinin yanındaki büyüteç çalışma alanlarında, sekmelerde, geçmişte, ajan sohbetlerinde, ayarlarda ve komutlarda arar. Kapalıyken arama komut paletinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лупа після кнопки профілю шукає робочі простори, вкладки, історію, чати агентів, налаштування й команди. Вимкнено — пошук лишається в палітрі команд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kính lúp sau nút hồ sơ tìm không gian làm việc, tab, lịch sử, trò chuyện với tác tử, cài đặt và lệnh. Khi tắt, tìm kiếm vẫn có trong bảng lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "个人资料按钮旁的放大镜可搜索工作区、标签页、历史记录、代理聊天、设置和命令。关闭后，搜索仍在命令面板中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "個人資料按鈕旁的放大鏡可搜尋工作區、分頁、歷史記錄、代理聊天、設定和指令。關閉後，搜尋仍在指令面板中。"
          }
        }
      }
    },
    "settings.sidebar.showNewWorkspaceChooser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
