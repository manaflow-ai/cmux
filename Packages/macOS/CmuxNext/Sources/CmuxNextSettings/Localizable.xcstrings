        "pl": {"stringUnit": {"state": "translated", "value": "Czekaj na zmianę (adaptacyjnie)"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esperar a mudança (adaptativo)"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ждать изменения (адаптивно)"}},
        "th": {"stringUnit": {"state": "translated", "value": "รอการเปลี่ยนแปลง (ปรับตัว)"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Değişikliği bekle (uyarlanabilir)"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Чекати на зміну (адаптивно)"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chờ thay đổi (thích ứng)"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "等待变化（自适应）"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "等待變化（自適應）"}}
