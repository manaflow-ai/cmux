    "settings.appearance.background.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a public-domain painting, your desktop wallpaper, or a macOS system wallpaper behind the window material."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein gemeinfreies Gemälde, dein Schreibtischbild oder ein macOS-Systembild hinter dem Fenstermaterial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une peinture libre de droits, votre fond d’écran de bureau ou un fond d’écran macOS derrière le matériau de la fenêtre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لوحة متاحة للملكية العامة، أو خلفية سطح مكتبك، أو خلفية نظام macOS خلف مادة النافذة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una pintura de dominio público, tu fondo de escritorio o un fondo de macOS detrás del material de la ventana."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇公版畫作、你的桌面背景，或 macOS 系統桌布顯示在視窗材質後方。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择公版画作、你的桌面墙纸，或 macOS 系统墙纸显示在窗口材质后方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 재질 뒤에 퍼블릭 도메인 그림, 데스크탑 배경화면 또는 macOS 시스템 배경화면을 선택합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ素材の背後に、パブリックドメインの絵画、デスクトップ壁紙、または macOS システム壁紙を選びます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose a public-domain painting, your desktop wallpaper, or a macOS system wallpaper behind the window material."
          }
        },
        "da": {
