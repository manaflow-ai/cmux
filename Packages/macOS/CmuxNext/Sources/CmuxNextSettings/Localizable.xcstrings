    "settings.appearance.highlightColor.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color of selected text everywhere. Unset uses the terminal theme's."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لون النص المحدد في كل مكان. إن لم يُضبط، يُستخدم لون سمة الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boja odabranog teksta svuda. Ako nije postavljena, koristi se boja teme terminala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farven på markeret tekst overalt. Uden værdi bruges terminaltemaets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Farbe markierten Textes überall. Ohne Wert gilt die des Terminal-Themas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El color del texto seleccionado en todas partes. Sin valor, usa el del tema del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La couleur du texte sélectionné partout. Sans valeur, celle du thème du terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il colore del testo selezionato ovunque. Se non impostato, usa quello del tema del terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての場所で選択したテキストの色です。未設定の場合はターミナルテーマの選択色です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពណ៌​អត្ថបទ​ដែល​បាន​ជ្រើស​គ្រប់​ទីកន្លែង។ បើ​មិន​កំណត់ ប្រើ​ពណ៌​របស់​រចនាប័ទ្ម​ទែមីណាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 곳에서 선택한 텍스트의 색상입니다. 설정하지 않으면 터미널 테마의 색상을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fargen på markert tekst overalt. Uten verdi brukes terminaltemaets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolor zaznaczonego tekstu wszędzie. Bez ustawienia używa koloru motywu terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A cor do texto selecionado em todo lugar. Sem valor, usa a do tema do terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цвет выделенного текста везде. Если не задан — цвет выделения темы терминала."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สีของข้อความที่เลือกในทุกที่ หากไม่ได้ตั้งค่า จะใช้สีของธีมเทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her yerde seçili metnin rengi. Ayarlanmazsa terminal temasınınki kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колір виділеного тексту всюди. Якщо не задано, береться колір теми термінала."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màu của văn bản được chọn ở mọi nơi. Nếu không đặt, dùng màu của chủ đề terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有位置中所选文本的颜色。未设置时使用终端主题的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有位置中所選文字的顏色。未設定時使用終端機主題的顏色。"
          }
        }
      }
    },
