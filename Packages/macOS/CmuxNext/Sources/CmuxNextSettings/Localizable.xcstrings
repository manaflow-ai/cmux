            "value": "모든 항목: 홈이 Command-1입니다. 작업 공간만: 첫 작업 공간이 Command-1입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle elementer: Hjem er Command-1. Bare arbeidsområder: det første arbeidsområdet er Command-1."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
