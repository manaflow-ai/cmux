    "settings.agentPane.display.inspector.help": {
      "comment": "Settings > Appearance > Agent Chat > Inspector: help for the Push / Overlay choice",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكان فتح لوحة معلومات الجلسة على يمين المحادثة. «دفع» يضيّق المحادثة بجانبها، و«تراكب» يعرضها فوق المحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdje se ploča Informacije o sesiji otvara desno od razgovora. Guranje sužava razgovor pored nje; Preklapanje je prikazuje preko razgovora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor panelet Sessionsinfo åbner til højre for chatten. Skub gør chatten smallere ved siden af det; Overlejring lægger det over chatten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo sich das Sitzungsinfo-Panel rechts vom Chat öffnet. „Verschieben“ macht den Chat daneben schmaler, „Überlagern“ legt es über den Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the Session Info panel opens at the right of the chat. Push narrows the chat beside it; Overlay lies over the chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se abre el panel Información de la sesión a la derecha del chat. Desplazar estrecha el chat a su lado; Superponer lo coloca encima del chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où le panneau Infos de la session s’ouvre à droite du chat. Pousser rétrécit le chat à côté ; Superposer le place par-dessus le chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si apre il pannello Info sessione a destra della chat. Sposta restringe la chat accanto; Sovrapponi lo mostra sopra la chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットの右側にセッション情報パネルを開く方法。「押し出す」はチャットを狭めて横に並べ、「重ねる」はチャットの上に表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កន្លែងដែលផ្ទាំងព័ត៌មានវគ្គបើកនៅខាងស្ដាំការជជែក។ រុញ ធ្វើឱ្យការជជែកតូចនៅក្បែរវា; ត្រួតលើ បង្ហាញវានៅលើការជជែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 오른쪽에 세션 정보 패널을 여는 방식입니다. 밀어내기는 채팅을 옆으로 좁히고, 겹치기는 채팅 위에 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor panelet Øktinfo åpnes til høyre for chatten. Skyv gjør chatten smalere ved siden av; Overlegg legger det over chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie panel Informacje o sesji otwiera się po prawej stronie czatu. Przesuń zwęża czat obok niego; Nakładka wyświetla go nad czatem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o painel Informações da sessão abre à direita do chat. Empurrar estreita o chat ao lado; Sobrepor o coloca sobre o chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как панель «Сведения о сеансе» открывается справа от чата. «Сдвиг» сужает чат рядом с ней, «Поверх» показывает её над чатом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งที่แผงข้อมูลเซสชันเปิดทางขวาของแชท ดัน จะทำให้แชทแคบลงข้างๆ ส่วน ซ้อนทับ จะแสดงทับแชท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum bilgileri panelinin sohbetin sağında nasıl açılacağı. İt, sohbeti yanında daraltır; Üstte, sohbetin üzerinde açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як панель «Відомості про сеанс» відкривається праворуч від чату. «Зсув» звужує чат поруч, «Поверх» показує її над чатом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi bảng Thông tin phiên mở ở bên phải cuộc trò chuyện. Đẩy thu hẹp cuộc trò chuyện bên cạnh; Phủ lên hiển thị trên cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话信息面板在对话右侧的打开方式。“推开”会让对话变窄并排显示；“叠放”会盖在对话上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段資訊面板在對話右側的開啟方式。「推開」會讓對話變窄並排顯示；「疊放」會蓋在對話上方。"
          }
        }
      }
    },
