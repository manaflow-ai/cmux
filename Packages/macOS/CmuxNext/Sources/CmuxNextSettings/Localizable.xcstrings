    "settings.cloud.newWorkspaceFolder.help": {
      "comment": "Settings > Machines: help for the New Cloud Workspaces Start In choice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Folder copies your git working copy to the new machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقوم «المجلد الحالي» بنسخ نسخة git العاملة إلى الجهاز الجديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trenutni folder kopira tvoju git radnu kopiju na novu mašinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktuel mappe kopierer din git-arbejdskopi til den nye maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktueller Ordner kopiert deine Git-Arbeitskopie auf die neue Maschine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carpeta actual copia tu copia de trabajo de git a la nueva máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dossier actuel copie votre copie de travail git sur la nouvelle machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cartella attuale copia la tua copia di lavoro git sulla nuova macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「現在のフォルダ」は git の作業コピーを新しいマシンにコピーします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ថតបច្ចុប្បន្ន ចម្លងច្បាប់ចម្លងការងារ git របស់អ្នកទៅម៉ាស៊ីនថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 폴더는 git 작업 사본을 새 머신에 복사합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gjeldende mappe kopierer git-arbeidskopien din til den nye maskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bieżący folder kopiuje Twoją kopię roboczą git na nową maszynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasta atual copia sua cópia de trabalho do git para a nova máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Текущая папка» копирует вашу рабочую копию git на новую машину."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฟลเดอร์ปัจจุบันจะคัดลอกสำเนาการทำงาน git ของคุณไปยังเครื่องใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geçerli Klasör, git çalışma kopyanızı yeni makineye kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Поточна папка» копіює вашу робочу копію git на нову машину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thư mục hiện tại sao chép bản sao làm việc git của bạn sang máy mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“当前文件夹”会将你的 git 工作副本复制到新机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「目前資料夾」會將你的 git 工作副本複製到新機器。"
          }
        }
      }
    },
    "settings.cloud.newWorkspacesInCloud": {
      "comment": "Settings > Machines: title of the toggle that sends each new workspace to its own new Cloud machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Run New Workspaces in Cloud"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تشغيل مساحات العمل الجديدة في السحابة"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Pokreni nove radne prostore u Cloudu"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kør nye arbejdsområder i Cloud"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Neue Arbeitsbereiche in der Cloud ausführen"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ejecutar nuevos espacios de trabajo en la nube"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Exécuter les nouveaux espaces de travail dans le Cloud"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Esegui i nuovi workspace nel Cloud"}},
        "ja": {"stringUnit": {"state": "translated", "value": "新しいワークスペースをクラウドで実行"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ដំណើរការកន្លែងធ្វើការថ្មីនៅលើ Cloud"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "새 워크스페이스를 클라우드에서 실행"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kjør nye arbeidsområder i Cloud"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Uruchamiaj nowe obszary robocze w chmurze"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Executar novos espaços de trabalho na nuvem"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Запускать новые рабочие области в облаке"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เรียกใช้เวิร์กสเปซใหม่บนคลาวด์"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Yeni çalışma alanlarını bulutta çalıştır"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Запускати нові робочі області в хмарі"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chạy không gian làm việc mới trên đám mây"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "在云端运行新工作区"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "在雲端執行新工作區"}}
      }
    },
    "settings.cloud.newWorkspacesInCloud.help": {
      "comment": "Settings > Machines: help for the Run New Workspaces in Cloud toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each new workspace gets its own Cloud machine, and its chats run there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحصل كل مساحة عمل جديدة على جهاز سحابي خاص بها، وتعمل محادثاتها عليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaki novi radni prostor dobija svoju Cloud mašinu, a njegovi četovi rade na njoj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert nyt arbejdsområde får sin egen Cloud-maskine, og dets chats kører der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder neue Arbeitsbereich erhält eine eigene Cloud-Maschine, und seine Chats laufen dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada nuevo espacio de trabajo obtiene su propia máquina en la nube, y sus chats se ejecutan allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque nouvel espace de travail obtient sa propre machine Cloud, et ses chats s'y exécutent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogni nuovo workspace ottiene una propria macchina Cloud e le sue chat vengono eseguite lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しいワークスペースごとにクラウドマシンが作られ、そのチャットはそこで実行されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការថ្មីនីមួយៗទទួលបានម៉ាស៊ីន Cloud ផ្ទាល់ខ្លួន ហើយការជជែករបស់វាដំណើរការនៅទីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 워크스페이스마다 자체 클라우드 머신이 생기고, 그 안의 채팅은 해당 머신에서 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvert nytt arbeidsområde får sin egen Cloud-maskin, og chattene kjører der."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy nowy obszar roboczy dostaje własną maszynę w chmurze, a jego czaty działają na niej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada novo espaço de trabalho ganha sua própria máquina na nuvem, e os chats dele rodam nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каждая новая рабочая область получает собственную облачную машину, и её чаты работают там."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เวิร์กสเปซใหม่แต่ละอันจะได้เครื่องคลาวด์ของตัวเอง และแชทในนั้นจะทำงานบนเครื่องนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her yeni çalışma alanı kendi bulut makinesini alır ve sohbetleri orada çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кожна нова робоча область отримує власну хмарну машину, і її чати працюють там."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi không gian làm việc mới có máy đám mây riêng, và các cuộc trò chuyện của nó chạy trên máy đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个新工作区都会获得一台自己的云端机器，其中的聊天在该机器上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個新工作區都會取得自己的雲端機器，其中的聊天在該機器上執行。"
          }
        }
      }
    },
