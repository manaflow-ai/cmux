    "settings.focus.inactiveTabStyle.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيف تظهر علامات تبويب الأجزاء الأخرى أخفت عندما يميّز «الجزء النشط» علامات التبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako kartice ostalih okna izgledaju blaže kada Fokusirano okno označava kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan andre ruders faner bliver mere afdæmpede, når Fokuseret rude markerer faner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie die Tabs anderer Bereiche dezenter erscheinen, wenn „Fokussierter Bereich“ Tabs markiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How other panes' tabs look subtler when Focused Pane marks tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo se atenúan las pestañas de los demás paneles cuando Panel con foco marca pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comment les onglets des autres volets s’atténuent quand Volet actif marque les onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come le schede degli altri riquadri appaiono più tenui quando Riquadro attivo segna le schede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「フォーカス中のペイン」がタブで示すとき、他のペインのタブを控えめに表示する方法。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបដែលផ្ទាំងនៃផ្ទាំងរងផ្សេងទៀតបង្ហាញស្រាលជាង នៅពេល «ផ្ទាំងរងដែលផ្តោត» សម្គាល់ផ្ទាំង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포커스된 창 설정이 탭으로 표시할 때 다른 창의 탭을 흐리게 그리는 방식입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan fanene i andre ruter dempes når Fokusert rute markerer faner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak karty innych paneli są przyciemnione, gdy Aktywny panel oznacza karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como as abas dos outros painéis ficam mais discretas quando Painel em foco marca as abas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как вкладки других панелей выглядят приглушённее, когда «Активная панель» отмечает вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิธีที่แท็บของบานอื่นแสดงจางลงเมื่อ บานที่โฟกัส ทำเครื่องหมายด้วยแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaklanan bölme sekmeleri işaretlediğinde diğer bölmelerin sekmelerinin nasıl daha sönük görüneceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як вкладки інших панелей виглядають приглушеніше, коли «Активна панель» позначає вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách các thẻ của những ngăn khác hiển thị nhạt hơn khi Ngăn đang chọn đánh dấu bằng thẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当“聚焦窗格”用标签页标记时，其他窗格的标签页如何变淡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
