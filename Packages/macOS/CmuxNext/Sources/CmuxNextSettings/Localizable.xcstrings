    "settings.picker.pinned.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed under Locations. Use full or ~/ paths."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر ضمن المواقع. استخدم مسارات كاملة أو مسارات ~/."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazane pod Lokacijama. Koristite pune ili ~/ putanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vises under Placeringer. Brug fulde stier eller ~/-stier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erscheinen unter Orte. Verwende vollständige oder ~/-Pfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aparecen en Ubicaciones. Usa rutas completas o rutas ~/."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affichés sous Emplacements. Utilisez des chemins complets ou ~/."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elencate in Posizioni. Usa percorsi completi o ~/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「場所」に表示されます。フルパスか ~/ パスを使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញនៅក្រោមទីតាំង។ ប្រើផ្លូវពេញ ឬផ្លូវ ~/។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위치 아래에 표시됩니다. 전체 경로나 ~/ 경로를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vises under Steder. Bruk fullstendige baner eller ~/-baner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyświetlane w Lokalizacjach. Użyj pełnych ścieżek lub ścieżek ~/."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Listadas em Locais. Use caminhos completos ou ~/."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показываются в разделе «Места». Используйте полные пути или пути ~/."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงในตำแหน่ง ใช้พาธเต็มหรือพาธ ~/"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konumlar altında listelenir. Tam yollar veya ~/ yolları kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показуються в розділі «Розташування». Використовуйте повні шляхи або шляхи ~/."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liệt kê trong Vị trí. Dùng đường dẫn đầy đủ hoặc đường dẫn ~/."
          }
        },
        "zh-Hans": {
          "stringUnit": {
