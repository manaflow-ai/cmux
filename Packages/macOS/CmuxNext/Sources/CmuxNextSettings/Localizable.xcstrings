        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "행에 마지막으로 바뀐 때를 표시합니다(예: 3d)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radene viser når de sist endret seg, for eksempel 3d."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiersze pokazują, kiedy ostatnio się zmieniły, np. 3d."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As linhas mostram quando mudaram pela última vez, como 3d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строки показывают, когда они менялись в последний раз, например 3d."
          }
        },
        "th": {
