    "settings.sidebar.hoverCards.groups.workspaceGroups.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summary card opens when the pointer rests on a workspace group's header."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تفتح بطاقة ملخص عندما يستقر المؤشر على رأس مجموعة مساحات عمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartica sa sažetkom otvara se kada pokazivač miruje na zaglavlju grupe radnih prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et oversigtskort åbnes, når markøren hviler på en arbejdsområdegruppes overskrift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Übersichtskarte öffnet sich, wenn der Zeiger auf dem Kopf einer Workspace-Gruppe ruht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se abre una tarjeta de resumen cuando el puntero se detiene en el encabezado de un grupo de espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une carte de résumé s'ouvre quand le pointeur reste sur l'en-tête d'un groupe d'espaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si apre una scheda di riepilogo quando il puntatore resta sull'intestazione di un gruppo di spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタをワークスペースグループの見出しに置くと、概要カードが開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កាតសង្ខេបបើកនៅពេលទស្សន៍ទ្រនិចឈប់លើក្បាលក្រុមកន្លែងធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포인터를 워크스페이스 그룹 머리글에 올려 두면 요약 카드가 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et sammendragskort åpnes når pekeren hviler på overskriften til en arbeidsområdegruppe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karta podsumowania otwiera się, gdy wskaźnik spocznie na nagłówku grupy obszarów roboczych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um cartão de resumo abre quando o ponteiro repousa no cabeçalho de um grupo de espaços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Карточка сводки открывается, когда указатель задерживается на заголовке группы пространств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การ์ดสรุปจะเปิดเมื่อตัวชี้ค้างบนหัวกลุ่มพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İşaretçi bir çalışma alanı grubunun başlığında durduğunda özet kartı açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Картка підсумку відкривається, коли вказівник затримується на заголовку групи просторів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ tóm tắt mở khi con trỏ dừng trên tiêu đề nhóm không gian làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指针停在工作区组标题上时，打开摘要卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "指標停在工作區群組標題上時，開啟摘要卡片。"
          }
        }
      }
    },
