        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lyder per arbeidsområde-id. Angi fra arbeidsområdets meny i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dźwięki według id obszaru roboczego. Ustaw w jego menu na pasku bocznym."
