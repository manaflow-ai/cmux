    "settings.updates.web.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Merge: changes to the web UI arrive minutes after they land, without waiting for the next app update. Off: the web UI this app shipped with."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند كل دمج: تصل تغييرات واجهة الويب بعد دقائق من اعتمادها، دون انتظار التحديث التالي للتطبيق. إيقاف: واجهة الويب التي جاء بها هذا التطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri svakom spajanju: promjene web sučelja stižu nekoliko minuta nakon što budu spojene, bez čekanja na sljedeće ažuriranje aplikacije. Isključeno: web sučelje s kojim je ova aplikacija isporučena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved hver fletning: ændringer i webbrugerfladen kommer få minutter efter, at de er flettet ind, uden at vente på næste appopdatering. Fra: den webbrugerflade, appen blev leveret med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Merge: Änderungen an der Web-UI kommen Minuten nach dem Merge an, ohne auf das nächste App-Update zu warten. Aus: die Web-UI, mit der diese App ausgeliefert wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cada fusión: los cambios de la interfaz web llegan minutos después de fusionarse, sin esperar a la próxima actualización de la app. Desactivado: la interfaz web con la que se distribuyó esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque fusion : les modifications de l’interface web arrivent quelques minutes après leur fusion, sans attendre la prochaine mise à jour de l’app. Désactivé : l’interface web livrée avec cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni merge: le modifiche all’interfaccia web arrivano pochi minuti dopo il merge, senza attendere il prossimo aggiornamento dell’app. Disattivato: l’interfaccia web fornita con questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージごと: Web UI の変更は、アプリの次のアップデートを待たずに、マージから数分で届きます。オフ: このアプリに同梱された Web UI を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាល់ការបញ្ចូល៖ ការផ្លាស់ប្ដូរចំណុចប្រទាក់វេបមកដល់ប៉ុន្មាននាទីបន្ទាប់ពីបញ្ចូល ដោយមិនចាំការធ្វើបច្ចុប្បន្នភាពកម្មវិធីបន្ទាប់។ បិទ៖ ចំណុចប្រទាក់វេបដែលភ្ជាប់មកជាមួយកម្មវិធីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합할 때마다: 웹 UI 변경 사항이 다음 앱 업데이트를 기다리지 않고 병합 후 몇 분 안에 적용됩니다. 끔: 이 앱에 포함된 웹 UI를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved hver sammenslåing: endringer i nettgrensesnittet kommer noen minutter etter at de er slått sammen, uten å vente på neste appoppdatering. Av: nettgrensesnittet appen ble levert med."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy każdym scaleniu: zmiany interfejsu webowego docierają kilka minut po scaleniu, bez czekania na kolejną aktualizację aplikacji. Wyłączone: interfejs webowy dostarczony z tą aplikacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada merge: as mudanças na interface web chegam minutos depois do merge, sem esperar a próxima atualização do app. Desativado: a interface web que veio com este app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При каждом слиянии: изменения веб-интерфейса приходят через несколько минут после слияния, без ожидания следующего обновления приложения. Выкл.: веб-интерфейс, поставляемый с этим приложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการผสาน: การเปลี่ยนแปลง UI เว็บจะมาถึงภายในไม่กี่นาทีหลังผสาน โดยไม่ต้องรอการอัปเดตแอปครั้งถัดไป ปิด: ใช้ UI เว็บที่มากับแอปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her birleştirmede: web arayüzü değişiklikleri, sonraki uygulama güncellemesini beklemeden birleştirildikten dakikalar sonra gelir. Kapalı: bu uygulamayla gelen web arayüzü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після кожного злиття: зміни вебінтерфейсу надходять за кілька хвилин після злиття, без очікування наступного оновлення застосунку. Вимк.: вебінтерфейс, з яким постачається цей застосунок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần hợp nhất: thay đổi giao diện web đến vài phút sau khi được hợp nhất, không cần chờ bản cập nhật ứng dụng tiếp theo. Tắt: giao diện web đi kèm ứng dụng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次合并：网页界面的更改会在合并后几分钟内送达，无需等待下一次应用更新。关闭：使用此应用自带的网页界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次合併：網頁介面的變更會在合併後幾分鐘內送達，不必等待下一次 App 更新。關閉：使用此 App 隨附的網頁介面。"
          }
        }
      }
    },
