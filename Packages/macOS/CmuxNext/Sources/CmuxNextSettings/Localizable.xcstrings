    "settings.agentPane.display.statusVerbs.custom.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated -ing verbs for the live status line."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Kommas getrennte Tätigkeitswörter für die Statuszeile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbes d’action séparés par des virgules pour la ligne de statut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفعال عمل مفصولة بفواصل لسطر الحالة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbos en gerundio separados por comas para la línea de estado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號分隔的進行式動詞，用於狀態列。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗号分隔的进行时动词，用于状态行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 표시줄에 사용할 진행형 동사를 쉼표로 구분하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータス行に表示する動作の言葉をコンマで区切って入力します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Glagoli radnje odvojeni zarezima za red statusa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingsverber adskilt af kommaer til statuslinjen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbi al gerundio separati da virgole per la riga di stato."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កិរិយាសព្ទសកម្មភាពដែលបំបែកដោយសញ្ញាក្បៀសសម្រាប់បន្ទាត់ស្ថានភាព។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingsverb atskilt med komma for statuslinjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czasowniki czynności oddzielone przecinkami do wiersza stanu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbos no gerúndio separados por vírgulas para a linha de status."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глаголы действий для строки состояния, разделённые запятыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำกริยาแสดงการกระทำที่คั่นด้วยจุลภาคสำหรับบรรทัดสถานะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum satırı için virgülle ayrılmış şimdiki zaman fiilleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дієслова дій для рядка стану, розділені комами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các động từ hành động phân cách bằng dấu phẩy cho dòng trạng thái."
          }
        }
      }
    },
    "settings.agentPane.display.statusVerbs.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the live status line rotates through verbs or stays on Thinking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, ob die Statuszeile wechselnde Verben oder immer „Nachdenken“ anzeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si la ligne de statut alterne les verbes ou affiche toujours « Réflexion »."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان سطر الحالة يتناوب بين الأفعال أو يعرض «يفكر» دائمًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la línea de estado alterna entre verbos o muestra siempre «Pensando»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇狀態列輪流顯示不同動詞，或始終顯示「思考中」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择状态行轮流显示不同动词，或始终显示“思考中”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 표시줄에 동사를 번갈아 표시할지, 항상 “생각 중”을 표시할지 선택합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータス行の動詞を順に切り替えるか、「思考中」のみを表示するかを選びます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite da li se glagoli u statusu smjenjuju ili uvijek piše „Razmišljam“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, om statuslinjen skifter mellem verber eller altid viser „Tænker“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se la riga di stato alterna i verbi o mostra sempre «Sto pensando»."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសថាតើបន្ទាត់ស្ថានភាពប្តូរកិរិយាសព្ទ ឬបង្ហាញ «កំពុងគិត» ជានិច្ច។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg om statuslinjen veksler mellom verb eller alltid viser «Tenker»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy wiersz stanu zmienia czasowniki, czy zawsze pokazuje „Myślenie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a linha de status alterna entre verbos ou sempre mostra “Pensando”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, сменяются ли глаголы в строке состояния или всегда отображается «Думаю»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าจะสลับคำกริยาในบรรทัดสถานะหรือแสดง “กำลังคิด” เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum satırının fiilleri dönüşümlü göstermesini veya hep “Düşünüyor” yazmasını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, чи змінюються дієслова в рядку стану, чи завжди відображається «Думаю»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn để dòng trạng thái luân phiên các động từ hoặc luôn hiển thị “Đang suy nghĩ”."
          }
        }
      }
    },
