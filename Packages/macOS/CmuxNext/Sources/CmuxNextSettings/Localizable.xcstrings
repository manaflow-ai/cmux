    "settings.tabs.commandDigits.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces: Command-1 to 9 go to sidebar items and Control-1 to 9 to tabs. Tabs: Command-1 to 9 go to the focused pane's tabs and Control-1 to 9 to workspaces."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحات العمل: ينتقل Command-1 إلى 9 إلى عناصر الشريط الجانبي وControl-1 إلى 9 إلى علامات التبويب. علامات التبويب: ينتقل Command-1 إلى 9 إلى علامات تبويب اللوحة المحددة وControl-1 إلى 9 إلى مساحات العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Radni prostori: Command-1 do 9 otvaraju stavke bočne trake, a Control-1 do 9 kartice. Kartice: Command-1 do 9 otvaraju kartice fokusiranog panela, a Control-1 do 9 radne prostore."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejdsområder: Command-1 til 9 går til elementer i sidepanelet og Control-1 til 9 til faner. Faner: Command-1 til 9 går til fanerne i den fokuserede rude og Control-1 til 9 til arbejdsområder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereiche: Befehl-1 bis 9 öffnen Einträge der Seitenleiste und Control-1 bis 9 Tabs. Tabs: Befehl-1 bis 9 öffnen die Tabs des fokussierten Bereichs und Control-1 bis 9 Arbeitsbereiche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacios de trabajo: Comando-1 a 9 van a los elementos de la barra lateral y Control-1 a 9 a las pestañas. Pestañas: Comando-1 a 9 van a las pestañas del panel enfocado y Control-1 a 9 a los espacios de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaces de travail : Commande-1 à 9 ouvrent les éléments de la barre latérale et Contrôle-1 à 9 les onglets. Onglets : Commande-1 à 9 ouvrent les onglets du volet actif et Contrôle-1 à 9 les espaces de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazi di lavoro: Comando-1 a 9 aprono gli elementi della barra laterale e Control-1 a 9 le schede. Schede: Comando-1 a 9 aprono le schede del riquadro attivo e Control-1 a 9 gli spazi di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース: Command-1〜9 でサイドバーの項目、Control-1〜9 でタブに移動します。タブ: Command-1〜9 でフォーカス中のペインのタブ、Control-1〜9 でワークスペースに移動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កន្លែងធ្វើការ៖ Command-1 ដល់ 9 ទៅធាតុរបារចំហៀង ហើយ Control-1 ដល់ 9 ទៅផ្ទាំង។ ផ្ទាំង៖ Command-1 ដល់ 9 ទៅផ្ទាំងនៃផ្ទាំងដែលបានផ្តោត ហើយ Control-1 ដល់ 9 ទៅកន្លែងធ្វើការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간: Command-1~9는 사이드바 항목으로, Control-1~9는 탭으로 이동합니다. 탭: Command-1~9는 포커스된 패널의 탭으로, Control-1~9는 작업 공간으로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeidsområder: Kommando-1 til 9 går til elementer i sidepanelet og Control-1 til 9 til faner. Faner: Kommando-1 til 9 går til fanene i den aktive ruten og Control-1 til 9 til arbeidsområder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obszary robocze: Command-1 do 9 przechodzą do elementów paska bocznego, a Control-1 do 9 do kart. Karty: Command-1 do 9 przechodzą do kart aktywnego panelu, a Control-1 do 9 do obszarów roboczych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaços de trabalho: Command-1 a 9 vão para os itens da barra lateral e Control-1 a 9 para as abas. Abas: Command-1 a 9 vão para as abas do painel em foco e Control-1 a 9 para os espaços de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочие пространства: Command-1…9 открывают элементы боковой панели, а Control-1…9 вкладки. Вкладки: Command-1…9 открывают вкладки активной панели, а Control-1…9 рабочие пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ทำงาน: Command-1 ถึง 9 ไปยังรายการในแถบด้านข้าง และ Control-1 ถึง 9 ไปยังแท็บ แท็บ: Command-1 ถึง 9 ไปยังแท็บของบานที่โฟกัส และ Control-1 ถึง 9 ไปยังพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanları: Command-1 ile 9 arası kenar çubuğu öğelerine, Control-1 ile 9 arası sekmelere gider. Sekmeler: Command-1 ile 9 arası odaklı bölmenin sekmelerine, Control-1 ile 9 arası çalışma alanlarına gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робочі простори: Command-1…9 відкривають елементи бічної панелі, а Control-1…9 вкладки. Вкладки: Command-1…9 відкривають вкладки активної панелі, а Control-1…9 робочі простори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian làm việc: Command-1 đến 9 chuyển đến các mục thanh bên và Control-1 đến 9 chuyển đến thẻ. Thẻ: Command-1 đến 9 chuyển đến các thẻ của ô đang chọn và Control-1 đến 9 chuyển đến không gian làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区：Command-1 至 9 前往边栏项目，Control-1 至 9 前往标签页。标签页：Command-1 至 9 前往聚焦窗格的标签页，Control-1 至 9 前往工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區：Command-1 至 9 前往側邊欄項目，Control-1 至 9 前往標籤頁。標籤頁：Command-1 至 9 前往聚焦窗格的標籤頁，Control-1 至 9 前往工作區。"
          }
        }
      }
    },
