    "settings.appearance.fontSmoothing.help": {
      "comment": "Help under Text Smoothing. Auto, Thin and Smooth are the choice names; translate them as in settings.choice.fontSmoothingAuto, settings.choice.fontSmoothingThin and settings.choice.fontSmoothingSmooth.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيفية رسم النص. يتغير بعض النص بعد إعادة تشغيل cmux؛ وتحتفظ الطرفيات بإعدادها الخاص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako se tekst crta. Dio teksta se mijenja nakon ponovnog pokretanja cmuxa; terminali zadržavaju svoju postavku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan tekst tegnes. Noget tekst skifter, når cmux genstartes; terminaler beholder deres egen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie Text gezeichnet wird. Mancher Text ändert sich erst nach einem Neustart von cmux; Terminals behalten ihre eigene Einstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How text draws. Some text changes after cmux restarts; terminals keep their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo se dibuja el texto. Parte del texto cambia al reiniciar cmux; las terminales conservan su propio ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comment le texte est dessiné. Une partie du texte change au redémarrage de cmux ; les terminaux gardent leur propre réglage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come viene disegnato il testo. Parte del testo cambia dopo il riavvio di cmux; i terminali mantengono la propria impostazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文字の描画方法です。一部の文字は cmux の再起動後に変わり、ターミナルは独自の設定のままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបគូរអក្សរ។ អត្ថបទខ្លះផ្លាស់ប្តូរបន្ទាប់ពីចាប់ផ្តើម cmux ឡើងវិញ; ទែមីណាល់រក្សាការកំណត់ផ្ទាល់ខ្លួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "텍스트를 그리는 방식입니다. 일부 텍스트는 cmux를 다시 시작하면 바뀌며, 터미널은 자체 설정을 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan tekst tegnes. Noe tekst endres når cmux startes på nytt; terminaler beholder sin egen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposób rysowania tekstu. Część tekstu zmienia się po ponownym uruchomieniu cmux; terminale mają własne ustawienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como o texto é desenhado. Parte do texto muda após reiniciar o cmux; os terminais mantêm o seu ajuste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как рисуется текст. Часть текста меняется после перезапуска cmux; у терминалов своя настройка."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิธีวาดข้อความ ข้อความบางส่วนเปลี่ยนหลังจากเริ่ม cmux ใหม่ เทอร์มินัลใช้การตั้งค่าของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metnin nasıl çizileceği. Bazı metinler cmux yeniden başlatıldıktan sonra değişir; terminaller kendi ayarını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як малюється текст. Частина тексту змінюється після перезапуску cmux; термінали мають власне налаштування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách vẽ chữ. Một số chữ thay đổi sau khi khởi động lại cmux; terminal giữ cài đặt riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文字的绘制方式。部分文字在重新启动 cmux 后变化；终端保留其自身设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "文字的繪製方式。部分文字在重新啟動 cmux 後變更；終端機保留其本身設定。"
          }
        }
      }
    },
