    "settings.shortcuts.showModifierHoldHints.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Command or Control for 0.30 seconds to show shortcut hints."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Command oder Control 0,30 Sekunden halten, um Tastenkürzel-Hinweise anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Command ou Control pendant 0,30 seconde pour afficher les indications des raccourcis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً على Command أو Control لمدة 0.30 ثانية لإظهار تلميحات الاختصارات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Command o Control durante 0,30 segundos para mostrar las indicaciones de atajos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 或 Control 0.30 秒以顯示快速鍵提示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 或 Control 0.30 秒以显示快捷键提示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 또는 Control을 0.30초 동안 누르면 단축키 힌트가 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command または Control を0.30秒押し続けるとショートカットのヒントが表示されます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite Command ili Control 0,30 sekundi da prikažete savjete za prečice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Command eller Control nede i 0,30 sekunder for at vise genvejstip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Command o Control per 0,30 secondi per mostrare i suggerimenti delle scorciatoie."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សង្កត់ Command ឬ Control រយៈពេល 0.30 វិនាទី ដើម្បីបង្ហាញព័ត៌មានជំនួយផ្លូវកាត់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Command eller Control inne i 0,30 sekunder for å vise snarveistips."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj Command lub Control przez 0,30 sekundy, aby wyświetlić podpowiedzi skrótów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure Command ou Control por 0,30 segundos para mostrar dicas de atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте Command или Control в течение 0,30 секунды, чтобы увидеть подсказки сочетаний клавиш."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด Command หรือ Control ค้างไว้ 0.30 วินาทีเพื่อแสดงคำแนะนำปุ่มลัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol ipuçlarını göstermek için Command veya Control tuşunu 0,30 saniye basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте Command або Control протягом 0,30 секунди, щоб побачити підказки сполучень клавіш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Command hoặc Control trong 0,30 giây để hiển thị gợi ý phím tắt."
          }
        }
      }
    },
