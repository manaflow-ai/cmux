    "settings.terminal.linkOpener.rules.help": {
      "comment": "Help for Terminal > Program Link Rules. Keep the rule syntax (<match> -> <target>, caller:aws, re:, the example) untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<match> -> <target>, first match wins. Example: caller:gh github.com -> safari"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>، وأول تطابق يفوز. مثال: caller:gh github.com -> safari"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, prvo poklapanje pobjeđuje. Primjer: caller:gh github.com -> safari"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, første match vinder. Eksempel: caller:gh github.com -> safari"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, der erste Treffer gewinnt. Beispiel: caller:gh github.com -> safari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, gana la primera coincidencia. Ejemplo: caller:gh github.com -> safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, la première correspondance l’emporte. Exemple : caller:gh github.com -> safari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, vince la prima corrispondenza. Esempio: caller:gh github.com -> safari"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target> と書き、最初に一致したものが使われます。例: caller:gh github.com -> safari"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target> ការផ្គូផ្គងដំបូងឈ្នះ។ ឧទាហរណ៍៖ caller:gh github.com -> safari"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target> 형식이며, 처음 일치한 규칙이 적용됩니다. 예: caller:gh github.com -> safari"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, første treff vinner. Eksempel: caller:gh github.com -> safari"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, wygrywa pierwsze dopasowanie. Przykład: caller:gh github.com -> safari"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, a primeira correspondência vence. Exemplo: caller:gh github.com -> safari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, побеждает первое совпадение. Пример: caller:gh github.com -> safari"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target> กฎแรกที่ตรงจะถูกใช้ ตัวอย่าง: caller:gh github.com -> safari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, ilk eşleşme kazanır. Örnek: caller:gh github.com -> safari"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, перемагає перший збіг. Приклад: caller:gh github.com -> safari"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>, quy tắc khớp đầu tiên được dùng. Ví dụ: caller:gh github.com -> safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "<match> -> <target>，第一个匹配的规则生效。示例：caller:gh github.com -> safari"
          }
