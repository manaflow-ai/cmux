    "settings.editor.importFrom.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux reads that editor's settings and keybindings files and never changes them. A setting you make here wins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はそのエディタの設定ファイルとキー割り当てファイルを読み込みますが、変更はしません。ここで設定した値が優先されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقرأ cmux ملفات الإعدادات واختصارات المفاتيح لذلك المحرر ولا يغيّرها أبدًا. الإعداد الذي تضبطه هنا هو الذي يُطبَّق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux čita datoteke postavki i prečica tog uređivača i nikad ih ne mijenja. Postavka koju ovdje odredite ima prednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux læser editorens indstillings- og tastaturgenvejsfiler og ændrer dem aldrig. En indstilling, du vælger her, vinder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux liest die Einstellungs- und Tastenkürzeldateien dieses Editors und ändert sie nie. Eine Einstellung, die Sie hier vornehmen, hat Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lee los archivos de ajustes y atajos de ese editor y nunca los cambia. Un ajuste que haga aquí tiene prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lit les fichiers de réglages et de raccourcis de cet éditeur et ne les modifie jamais. Un réglage fait ici l'emporte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux legge i file di impostazioni e scorciatoie di quell'editor e non li modifica mai. Un'impostazione scelta qui ha la precedenza."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux អានឯកសារការកំណត់ និងផ្លូវកាត់របស់កម្មវិធីកែនោះ ហើយមិនដែលប្ដូរវាឡើយ។ ការកំណត់ដែលអ្នកធ្វើនៅទីនេះឈ្នះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 해당 편집기의 설정 및 키 바인딩 파일을 읽기만 하고 절대 바꾸지 않습니다. 여기서 정한 설정이 우선합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux leser innstillings- og hurtigtastfilene til redigeringsprogrammet og endrer dem aldri. En innstilling du gjør her, vinner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux czyta pliki ustawień i skrótów tego edytora i nigdy ich nie zmienia. Ustawienie wybrane tutaj ma pierwszeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux lê os arquivos de ajustes e atalhos desse editor e nunca os altera. Um ajuste feito aqui prevalece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux читает файлы настроек и сочетаний клавиш этого редактора и никогда их не меняет. Настройка, заданная здесь, важнее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux อ่านไฟล์การตั้งค่าและปุ่มลัดของตัวแก้ไขนั้นและไม่เปลี่ยนไฟล์เหล่านั้น การตั้งค่าที่คุณทำที่นี่มีผลเหนือกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux o düzenleyicinin ayar ve kısayol dosyalarını okur, asla değiştirmez. Burada yaptığınız ayar önceliklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux читає файли налаштувань і сполучень клавіш цього редактора й ніколи їх не змінює. Налаштування, задане тут, має перевагу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux đọc tệp cài đặt và phím tắt của trình soạn thảo đó và không bao giờ thay đổi chúng. Cài đặt bạn chọn ở đây sẽ được ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 读取该编辑器的设置和键绑定文件，从不修改它们。你在这里的设置优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 讀取該編輯器的設定與按鍵綁定檔案，從不修改它們。你在這裡的設定優先。"
          }
        }
      }
    },
