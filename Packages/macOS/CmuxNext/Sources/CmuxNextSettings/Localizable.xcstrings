    "settings.appearance.favoriteThemes.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Themes starred in a theme picker. The picker lists them first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السمات التي ميّزتها بنجمة في منتقي السمات. يعرضها المنتقي أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teme označene zvjezdicom u biraču tema. Birač ih prikazuje prve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer, der er stjernemarkeret i en temavælger. Vælgeren viser dem først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Designauswahl mit Stern markierte Designs. Die Auswahl zeigt sie zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas marcados con estrella en un selector de temas. El selector los muestra primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thèmes marqués d’une étoile dans un sélecteur de thème. Le sélecteur les affiche en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Temi contrassegnati con una stella in un selettore di temi. Il selettore li mostra per primi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマピッカーでスターを付けたテーマ。ピッカーの先頭に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រចនាប័ទ្មដែលបានដាក់ផ្កាយក្នុងកម្មវិធីជ្រើសរចនាប័ទ្ម។ កម្មវិធីជ្រើសបង្ហាញពួកវាមុនគេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 선택기에서 별표한 테마입니다. 선택기에서 맨 위에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer som er stjernemerket i en temavelger. Velgeren viser dem først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywy oznaczone gwiazdką w selektorze motywów. Selektor pokazuje je na początku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas marcados com estrela em um seletor de temas. O seletor os mostra primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы, отмеченные звездой в списке выбора темы. Они показываются первыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธีมที่ติดดาวในตัวเลือกธีม ตัวเลือกจะแสดงธีมเหล่านี้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tema seçicide yıldızlanan temalar. Seçici bunları en üstte gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теми, позначені зірочкою у виборі теми. Вони показуються першими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chủ đề được gắn sao trong bộ chọn chủ đề. Bộ chọn hiển thị chúng trước tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主题选择器中加星标的主题。选择器会将它们列在最前面。"
          }
