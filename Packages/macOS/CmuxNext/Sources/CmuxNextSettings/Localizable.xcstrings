    "settings.agentPane.newChatsIn.help": {
      "comment": "Settings > Agent Chat > Start New Chats In: what the row does",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مكان تشغيل المحادثة الجديدة. يبدؤها السحاب على جهازك السحابي، مع نسخ مشروعك إليه. يمكن لمحرر المحادثة الجديدة تغيير ذلك لتلك المحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdje se novi chat pokreće. Cloud ga pokreće na vašoj Cloud mašini, s kopijom vašeg projekta. Polje za pisanje novog chata to može promijeniti za taj chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor en ny chat kører. Cloud starter den på din egen Cloud-maskine med dit projekt kopieret derhen. Den nye chats skrivefelt kan ændre det for den chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wo ein neuer Chat läuft. Cloud startet ihn auf deiner eigenen Cloud-Maschine und kopiert dein Projekt dorthin. Das Eingabefeld des neuen Chats kann das für diesen Chat ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where a new chat runs. Cloud starts it on your own Cloud machine, with your project copied there. The new chat's composer can change it for that chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dónde se ejecuta un chat nuevo. Cloud lo inicia en tu propia máquina Cloud, con tu proyecto copiado allí. El editor del chat nuevo puede cambiarlo para ese chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où s'exécute une nouvelle discussion. Cloud la démarre sur ta propre machine Cloud, avec ton projet copié dessus. Le champ de saisie de la nouvelle discussion peut le changer pour cette discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove viene eseguita una nuova chat. Cloud la avvia sulla tua macchina Cloud, con il progetto copiato lì. Il compositore della nuova chat può cambiarlo per quella chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しいチャットを実行する場所。Cloud を選ぶと、プロジェクトをコピーした自分の Cloud マシンで開始します。新しいチャットの入力欄でそのチャットだけ変更できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងដែលការជជែកថ្មីដំណើរការ។ Cloud ចាប់ផ្តើមវានៅលើម៉ាស៊ីន Cloud របស់អ្នក ដោយចម្លងគម្រោងរបស់អ្នកទៅទីនោះ។ ប្រអប់សរសេររបស់ការជជែកថ្មីអាចប្តូរវាសម្រាប់ការជជែកនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 채팅이 실행되는 곳입니다. Cloud는 프로젝트를 복사한 내 Cloud 머신에서 시작합니다. 새 채팅의 입력창에서 해당 채팅만 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor en ny chat kjører. Cloud starter den på din egen Cloud-maskin, med prosjektet ditt kopiert dit. Skrivefeltet i den nye chatten kan endre det for den chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdzie działa nowy czat. Cloud uruchamia go na Twojej maszynie Cloud, z kopią projektu. Pole tworzenia nowego czatu może to zmienić dla tego czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde um novo chat é executado. Cloud o inicia na sua própria máquina Cloud, com seu projeto copiado para lá. O editor do novo chat pode mudar isso para aquele chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Где запускается новый чат. Cloud запускает его на вашей машине Cloud и копирует туда проект. В поле ввода нового чата это можно изменить для этого чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตำแหน่งที่แชตใหม่ทำงาน Cloud จะเริ่มแชตบนเครื่อง Cloud ของคุณพร้อมคัดลอกโปรเจกต์ไปที่นั่น ช่องพิมพ์ของแชตใหม่เปลี่ยนค่านี้ได้สำหรับแชตนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni bir sohbetin çalıştığı yer. Cloud, projeni kopyalayarak sohbeti kendi Cloud makinende başlatır. Yeni sohbetin yazma alanı bunu o sohbet için değiştirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Де працює новий чат. Cloud запускає його на вашій машині Cloud і копіює туди проєкт. Поле введення нового чату може змінити це для цього чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nơi cuộc trò chuyện mới chạy. Cloud khởi động nó trên máy Cloud của bạn, với dự án được sao chép sang đó. Ô soạn của cuộc trò chuyện mới có thể đổi điều này cho cuộc trò chuyện đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新聊天的运行位置。Cloud 会在你自己的 Cloud 机器上启动它，并把项目复制过去。新聊天的输入框可以为该聊天更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新聊天的執行位置。Cloud 會在你自己的 Cloud 機器上啟動它，並把專案複製過去。新聊天的輸入框可以為該聊天更改。"
          }
        }
      }
    },
