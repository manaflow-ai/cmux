    "settings.appearance.colorTransition.curve.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How a color change moves over its duration. Spring uses Spring Response and Spring Damping; Custom uses the four Bezier values."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يتقدم تغيير الألوان خلال مدته. يستخدم النابض استجابة النابض وتخميده؛ ويستخدم المخصص قيم بيزييه الأربع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako promjena boja napreduje tokom trajanja. Opruga koristi odziv i prigušenje opruge; Prilagođeno koristi četiri Bezier vrijednosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan et farveskift forløber over sin varighed. Fjeder bruger fjederrespons og fjederdæmpning; Tilpasset bruger de fire Bezier-værdier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie ein Farbwechsel über seine Dauer verläuft. Feder nutzt Federreaktion und Federdämpfung; Eigene nutzt die vier Bezier-Werte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo avanza un cambio de color durante su duración. Resorte usa la respuesta y la amortiguación del resorte; Personalizada usa los cuatro valores Bezier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment un changement de couleur progresse sur sa durée. Ressort utilise la réponse et l’amortissement du ressort ; Personnalisée utilise les quatre valeurs de Bézier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come procede un cambio di colore nel tempo. Molla usa risposta e smorzamento della molla; Personalizzata usa i quattro valori Bezier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色の変化が時間とともにどう進むか。スプリングは応答と減衰を、カスタムは 4 つのベジェ値を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របៀបដែលការប្ដូរពណ៌ដំណើរការក្នុងរយៈពេលរបស់វា។ រ៉ឺស័រប្រើការឆ្លើយតប និងការបន្ថយ ហើយផ្ទាល់ខ្លួនប្រើតម្លៃ Bezier ទាំងបួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상 변경이 시간에 따라 진행되는 방식입니다. 스프링은 스프링 응답과 감쇠를, 사용자 지정은 네 개의 베지어 값을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan en fargeendring forløper over varigheten. Fjær bruker fjærrespons og fjærdemping; Egendefinert bruker de fire Bezier-verdiene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak przebiega zmiana kolorów w czasie. Sprężyna używa odpowiedzi i tłumienia sprężyny; Własna używa czterech wartości Béziera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como uma mudança de cor avança ao longo da duração. Mola usa a resposta e o amortecimento da mola; Personalizada usa os quatro valores Bezier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как смена цветов идёт во времени. Пружина использует отклик и затухание пружины; Своя использует четыре значения Безье."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนสีดำเนินไปอย่างไรตลอดระยะเวลา สปริงใช้การตอบสนองและการหน่วงของสปริง ส่วนกำหนดเองใช้ค่า Bezier ทั้งสี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renk değişikliğinin süresi boyunca nasıl ilerlediği. Yay, yay tepkisini ve sönümünü; Özel, dört Bezier değerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як зміна кольорів іде в часі. Пружина використовує відгук і згасання пружини; Власна використовує чотири значення Безьє."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách một lần đổi màu diễn ra theo thời gian. Lò xo dùng độ phản hồi và độ giảm chấn; Tùy chỉnh dùng bốn giá trị Bezier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色变化在时长内的推进方式。弹簧使用弹簧响应和弹簧阻尼；自定义使用四个贝塞尔值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏色變化在時長內的推進方式。彈簧使用彈簧回應和彈簧阻尼；自訂使用四個貝茲值。"
          }
        }
      }
    },
