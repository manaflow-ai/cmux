            "value": "Reaction Classifier Model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアクション分類のモデル"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نموذج مصنِّف التفاعلات"
          }
        },
        "bs": {
