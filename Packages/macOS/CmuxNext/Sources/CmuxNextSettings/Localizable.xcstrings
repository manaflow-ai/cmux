          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرشفة الدردشات غير النشطة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhiviraj neaktivne razgovore"
          }
        },
        "da": {
          "stringUnit": {
