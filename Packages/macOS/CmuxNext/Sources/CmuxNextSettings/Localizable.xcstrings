    "settings.navigation.historySteps.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«الكل» ينتقل أيضًا بين علامات التبويب والأجزاء داخل مساحة العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve prolazi i kroz kartice i okna unutar radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt går også gennem faner og ruder i et arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles durchläuft auch Tabs und Bereiche innerhalb eines Arbeitsbereichs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything also steps through tabs and panes inside a workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo también recorre las pestañas y paneles dentro de un espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout parcourt aussi les onglets et panneaux d’un espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutto: scorrono anche schede e riquadri dentro uno spazio di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「すべて」では、ワークスペース内のタブやペインも順に移動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទាំងអស់ ក៏ឆ្លងកាត់ផ្ទាំង និងផ្ទាំងរងក្នុងកន្លែងធ្វើការផងដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전체는 작업 공간 안의 탭과 패널도 순서대로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt går også gjennom faner og ruter i et arbeidsområde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystko: przechodzą też przez karty i panele w obszarze roboczym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo também percorre abas e painéis dentro de um espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Всё» также переходит по вкладкам и панелям внутри рабочего пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทั้งหมด: เลื่อนผ่านแท็บและบานหน้าต่างภายในพื้นที่ทำงานด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her şey: bir çalışma alanındaki sekmeler ve bölmeler arasında da gezer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Усе» також переходить вкладками й панелями всередині робочого простору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi thứ cũng đi qua các thẻ và ngăn trong một không gian làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“全部”还会在工作区内的标签页和窗格之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "全部：也會在工作區內的分頁和窗格之間切換。"
          }
        }
      }
    },
