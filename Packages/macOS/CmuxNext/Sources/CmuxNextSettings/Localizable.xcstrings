    "settings.browser.freezeHiddenTabs.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden Chromium tab stops running until you show it, to save power."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "電力を節約するため、非表示の Chromium タブは表示するまで停止します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتوقف علامة تبويب Chromium المخفية عن العمل حتى تعرضها، لتوفير الطاقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrivena Chromium kartica prestaje raditi dok je ne prikažete, radi uštede energije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En skjult Chromium-fane stopper, indtil du viser den, for at spare strøm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein ausgeblendeter Chromium-Tab läuft erst weiter, wenn du ihn zeigst, um Energie zu sparen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una pestaña oculta de Chromium deja de ejecutarse hasta que la muestres, para ahorrar energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un onglet Chromium masqué s'arrête jusqu'à ce que vous l'affichiez, pour économiser l'énergie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una scheda Chromium nascosta si ferma finché non la mostri, per risparmiare energia."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំង Chromium ដែលលាក់ឈប់ដំណើរការរហូតដល់អ្នកបង្ហាញវា ដើម្បីសន្សំថាមពល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전력을 절약하기 위해 숨겨진 Chromium 탭은 다시 표시할 때까지 실행을 멈춥니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En skjult Chromium-fane stopper til du viser den, for å spare strøm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukryta karta Chromium przestaje działać, dopóki jej nie pokażesz, aby oszczędzać energię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma aba oculta do Chromium para até você mostrá-la, para economizar energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скрытая вкладка Chromium не работает, пока вы её не покажете, чтобы экономить энергию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บ Chromium ที่ซ่อนอยู่จะหยุดทำงานจนกว่าคุณจะแสดงแท็บนั้น เพื่อประหยัดพลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Güç tasarrufu için gizli bir Chromium sekmesi siz gösterene kadar durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прихована вкладка Chromium не працює, доки ви її не покажете, щоб заощадити енергію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tab Chromium bị ẩn sẽ ngừng chạy cho đến khi bạn hiển thị nó, để tiết kiệm điện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隐藏的 Chromium 标签页会停止运行，直到你显示它，以节省电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隱藏的 Chromium 分頁會停止執行直到你顯示它，以節省電力。"
          }
        }
      }
    },
