    "settings.feed.mirrorTerminal.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications that programs send through the terminal can contain secrets. Off sends nothing to your cmux account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムがターミナル経由で送る通知には秘密情報が含まれることがあります。オフにすると cmux アカウントには何も送りません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قد تحتوي الإشعارات التي ترسلها البرامج عبر الطرفية على أسرار. عند الإيقاف لا يُرسل شيء إلى حساب cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obavijesti koje programi šalju kroz terminal mogu sadržavati tajne. Isključeno ne šalje ništa na vaš cmux račun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifikationer, som programmer sender via terminalen, kan indeholde hemmeligheder. Fra sender intet til din cmux-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mitteilungen, die Programme über das Terminal senden, können Geheimnisse enthalten. Aus sendet nichts an dein cmux-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las notificaciones que los programas envían por el terminal pueden contener secretos. Desactivado no envía nada a tu cuenta de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les notifications envoyées par des programmes via le terminal peuvent contenir des secrets. Désactivé n’envoie rien à votre compte cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le notifiche che i programmi inviano tramite il terminale possono contenere segreti. Disattivato non invia nulla al tuo account cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជូនដំណឹងដែលកម្មវិធីផ្ញើតាមទែមីណាល់អាចមានព័ត៌មានសម្ងាត់។ បិទ មិនផ្ញើអ្វីទៅគណនី cmux របស់អ្នកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로그램이 터미널을 통해 보내는 알림에는 비밀 정보가 포함될 수 있습니다. 끔으로 설정하면 cmux 계정에 아무것도 보내지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varsler som programmer sender gjennom terminalen kan inneholde hemmeligheter. Av sender ingenting til cmux-kontoen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powiadomienia wysyłane przez programy w terminalu mogą zawierać sekrety. Wyłączone nie wysyła niczego na Twoje konto cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notificações que programas enviam pelo terminal podem conter segredos. Desativado não envia nada para sua conta cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уведомления, которые программы отправляют через терминал, могут содержать секреты. «Выкл.» ничего не отправляет в учётную запись cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแจ้งเตือนที่โปรแกรมส่งผ่านเทอร์มินัลอาจมีข้อมูลลับ ปิดจะไม่ส่งอะไรไปยังบัญชี cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Programların terminal üzerinden gönderdiği bildirimler gizli bilgiler içerebilir. Kapalı, cmux hesabınıza hiçbir şey göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сповіщення, які програми надсилають через термінал, можуть містити секрети. «Вимк.» нічого не надсилає до облікового запису cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thông báo mà chương trình gửi qua terminal có thể chứa bí mật. Tắt sẽ không gửi gì đến tài khoản cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "程序通过终端发送的通知可能包含机密。关闭时不会向你的 cmux 账户发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "程式透過終端機傳送的通知可能包含機密。關閉時不會向你的 cmux 帳號傳送任何內容。"
          }
        }
      }
    },
