    "settings.contextMenus.showCustomizeItem": {
      "comment": "Settings > Menus: switch that adds the Customize Menu… row to every right-click menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Customize Menu…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار «تخصيص القائمة…»"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži „Prilagodi meni…“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis “Tilpas menu…”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Menü anpassen…“ anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar «Personalizar menú…»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher « Personnaliser le menu… »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra «Personalizza menu…»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メニューをカスタマイズ…」を表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញ «ប្ដូរម៉ឺនុយតាមបំណង…»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“메뉴 사용자화…” 표시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis «Tilpass meny…»"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż „Dostosuj menu…”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar “Personalizar Menu…”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать «Настроить меню…»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง “ปรับแต่งเมนู…”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Menüyü Özelleştir…” Öğesini Göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати «Налаштувати меню…»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện “Tùy chỉnh menu…”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示“自定义菜单…”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示「自訂選單…」"
          }
        }
      }
    },
    "settings.contextMenus.showCustomizeItem.help": {
      "comment": "Settings > Menus: line under the Show Customize Menu… switch; 'it' is the Customize Menu… row. At most 60 characters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds Customize Menu… to the end of every right-click menu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف «تخصيص القائمة…» إلى نهاية كل قائمة للنقر بزر الماوس الأيمن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje „Prilagodi meni…“ na kraj svakog menija desnog klika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer “Tilpas menu…” nederst i hver højrekliksmenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt „Menü anpassen…“ am Ende jedes Kontextmenüs hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade «Personalizar menú…» al final de cada menú contextual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute « Personnaliser le menu… » à la fin de chaque menu contextuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge «Personalizza menu…» alla fine di ogni menu contestuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての右クリックメニューの末尾に「メニューをカスタマイズ…」を追加します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែម «ប្ដូរម៉ឺនុយតាមបំណង…» ទៅចុងម៉ឺនុយចុចខាងស្តាំនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 오른쪽 클릭 메뉴의 끝에 ‘메뉴 사용자화…’를 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til «Tilpass meny…» nederst i hver høyreklikkmeny."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje „Dostosuj menu…” na końcu każdego menu kontekstowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona “Personalizar Menu…” ao final de cada menu de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет «Настроить меню…» в конец каждого контекстного меню."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม “ปรับแต่งเมนู…” ไว้ท้ายเมนูคลิกขวาทุกเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sağ tık menüsünün sonuna “Menüyü Özelleştir…” ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає «Налаштувати меню…» в кінець кожного контекстного меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm “Tùy chỉnh menu…” vào cuối mọi menu chuột phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个右键菜单的末尾添加“自定义菜单…”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個右鍵選單的末尾加入「自訂選單…」。"
          }
        }
      }
    },
