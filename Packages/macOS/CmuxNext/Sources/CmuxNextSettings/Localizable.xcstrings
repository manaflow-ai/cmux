          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រាប់របៀបដែលអ្នកប្រើ cmux នៅលើ Mac នេះ។ គ្មានអ្វីដែលអ្នកវាយត្រូវបានកត់ត្រា ហើយគ្មានអ្វីត្រូវបានផ្ញើទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teller hvordan du bruker cmux på denne Macen. Ingenting du skriver registreres; ingenting sendes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zlicza, jak używasz cmux na tym Macu. Nic, co wpisujesz, nie jest rejestrowane; nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conta como você usa o cmux neste Mac. Nada que você digita é registrado; nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Считает, как вы используете cmux на этом Mac. Вводимое не записывается; ничего не отправляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นับวิธีที่คุณใช้ cmux บน Mac เครื่องนี้ ไม่บันทึกสิ่งที่คุณพิมพ์ และไม่ส่งข้อมูลไปที่ใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac'te cmux'u nasıl kullandığınızı sayar. Yazdığınız hiçbir şey kaydedilmez; hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рахує, як ви використовуєте cmux на цьому Mac. Введене не записується; нічого не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đếm cách bạn dùng cmux trên máy Mac này. Không ghi lại gì bạn gõ; không gửi gì đi."
          }
        }
      }
