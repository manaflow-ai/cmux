    "settings.browser.omnibar.showFullURLs.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the whole address, with https:// and www., when you are not editing it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض العنوان كاملًا، مع https:// وwww.، عندما لا تحرره."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje cijelu adresu, s https:// i www., kada je ne uređujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser hele adressen med https:// og www., når du ikke redigerer den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt die ganze Adresse mit https:// und www., wenn Sie sie nicht bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra la dirección completa, con https:// y www., cuando no la estás editando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche l’adresse complète, avec https:// et www., quand vous ne la modifiez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra l’indirizzo completo, con https:// e www., quando non lo stai modificando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集していないときに、https:// と www. を含むアドレス全体を表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញអាសយដ្ឋានទាំងមូល រួមទាំង https:// និង www. នៅពេលអ្នកមិនកំពុងកែវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "편집하지 않을 때 https:// 및 www.를 포함한 전체 주소를 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser hele adressen, med https:// og www., når du ikke redigerer den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje cały adres, z https:// i www., gdy go nie edytujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra o endereço inteiro, com https:// e www., quando você não está editando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывает адрес целиком, с https:// и www., когда вы его не редактируете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงที่อยู่ทั้งหมด พร้อม https:// และ www. เมื่อคุณไม่ได้แก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Düzenlemediğinizde adresin tamamını https:// ve www. ile gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показує адресу повністю, з https:// і www., коли ви її не редагуєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị toàn bộ địa chỉ, gồm https:// và www., khi bạn không chỉnh sửa."
          }
        },
        "zh-Hans": {
