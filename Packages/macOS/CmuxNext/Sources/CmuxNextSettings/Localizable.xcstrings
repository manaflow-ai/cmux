          "stringUnit": {
            "state": "translated",
            "value": "Con Riduci movimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「視差効果を減らす」のとき"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលបន្ថយចលនា"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작 줄이기 사용 시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Reduser bevegelse"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy ograniczeniu ruchu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Reduzir movimento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При «Уменьшении движения»"
          }
        },
