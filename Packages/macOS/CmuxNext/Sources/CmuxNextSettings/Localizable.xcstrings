    "settings.contextMenus.showCustomizeItem": {
      "comment": "Settings > Menus: switch that adds the Customize Menu… row to every right-click menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Customize Menu…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار «تخصيص القائمة…»"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži „Prilagodi meni…“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis “Tilpas menu…”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Menü anpassen…“ anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar «Personalizar menú…»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher « Personnaliser le menu… »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra «Personalizza menu…»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「メニューをカスタマイズ…」を表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញ «ប្ដូរម៉ឺនុយតាមបំណង…»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“메뉴 사용자화…” 표시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis «Tilpass meny…»"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż „Dostosuj menu…”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar “Personalizar Menu…”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать «Настроить меню…»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง “ปรับแต่งเมนู…”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Menüyü Özelleştir…” Öğesini Göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати «Налаштувати меню…»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện “Tùy chỉnh menu…”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示“自定义菜单…”"
          }
        },
