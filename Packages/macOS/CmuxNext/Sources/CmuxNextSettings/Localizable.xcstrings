    "settings.sidebar.nowPlaying.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A player for what is playing, at the bottom of the sidebar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشغّل لما يتم تشغيله الآن، أسفل الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plejer za ono što se reproducira, na dnu bočne trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afspiller til det, der afspilles, nederst i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Player für die aktuelle Wiedergabe, unten in der Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reproductor de lo que está sonando, en la parte inferior de la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur pour ce qui est en cours de lecture, en bas de la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un player per ciò che è in riproduzione, in fondo alla barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中のメディアのプレーヤー。サイドバーの下部に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្មវិធី​ចាក់​សម្រាប់​អ្វី​ដែល​កំពុង​ចាក់ នៅ​ផ្នែក​ខាង​ក្រោម​របារ​ចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
