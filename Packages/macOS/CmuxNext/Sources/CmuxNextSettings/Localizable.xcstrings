    "settings.notifications.sounds.workspaces.help": {
      "comment": "Settings > Notifications > Sounds > Workspace Sounds: help text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أصوات لكل معرّف مساحة عمل. اضبطها من قائمة مساحة العمل في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
