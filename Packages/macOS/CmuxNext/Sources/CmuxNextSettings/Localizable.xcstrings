    "settings.agentPane.outsideRoots.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما يفعله رابط ملف في الرد عندما يكون الملف خارج مجلدات الدردشة. لا تُفتح المفاتيح وملفات ‎.env أبدًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Šta link na datoteku u odgovoru radi kada je datoteka izvan foldera chata. Ključevi i .env datoteke se nikad ne otvaraju."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvad et fillink i et svar gør, når filen ligger uden for chattens mapper. Nøgler og .env-filer åbnes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was ein Dateilink in einer Antwort tut, wenn die Datei außerhalb der Ordner des Chats liegt. Schlüssel und .env-Dateien öffnen sich nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a file link in a reply does when the file is outside the chat's folders. Keys and .env files never open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qué hace un enlace a un archivo en una respuesta cuando el archivo está fuera de las carpetas del chat. Las claves y los archivos .env nunca se abren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce que fait un lien vers un fichier dans une réponse lorsque le fichier est hors des dossiers du chat. Les clés et les fichiers .env ne s’ouvrent jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cosa fa un link a un file in una risposta quando il file è fuori dalle cartelle della chat. Chiavi e file .env non si aprono mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信内のファイルリンクが、チャットのフォルダ外のファイルを指すときの動作です。鍵と .env ファイルは開きません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
