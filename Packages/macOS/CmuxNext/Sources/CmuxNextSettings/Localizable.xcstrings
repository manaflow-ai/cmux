            "value": "Çalışma alanı sekmelerini göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати вкладки робочих областей"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện các tab không gian làm việc"
          }
        },
