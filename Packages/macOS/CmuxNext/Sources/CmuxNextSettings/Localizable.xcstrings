    "settings.labs.liveCode.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُطبَّق تغييرات Swift التي تجمعها على التطبيق أثناء تشغيله. يسري بعد إعادة تشغيل cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swift izmjene koje kompajlirate primjenjuju se na pokrenutu aplikaciju. Primjenjuje se nakon ponovnog pokretanja cmuxa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swift-ændringer, du kompilerer, anvendes på den kørende app. Træder i kraft, når cmux genstarter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompilierte Swift-Änderungen werden in der laufenden App übernommen. Wirkt nach einem Neustart von cmux."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift changes you compile apply to the running app. Takes effect after cmux restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios de Swift que compilas se aplican a la app en ejecución. Surte efecto al reiniciar cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les modifications Swift que vous compilez s’appliquent à l’app en cours d’exécution. Prend effet au redémarrage de cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le modifiche Swift che compili si applicano all’app in esecuzione. Ha effetto dopo il riavvio di cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コンパイルした Swift の変更が実行中のアプリに反映されます。cmux の再起動後に有効になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្លាស់ប្ដូរ Swift ដែលអ្នក compile អនុវត្តលើកម្មវិធីដែលកំពុងដំណើរការ។ មានប្រសិទ្ធភាពបន្ទាប់ពី cmux ចាប់ផ្ដើមឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "컴파일한 Swift 변경 사항이 실행 중인 앱에 적용됩니다. cmux를 다시 시작한 후 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Swift-endringer du kompilerer, brukes i appen som kjører. Trer i kraft når cmux startes på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skompilowane zmiany w Swift trafiają do działającej aplikacji. Działa po ponownym uruchomieniu cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As alterações em Swift que você compila são aplicadas ao app em execução. Entra em vigor após reiniciar o cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Компилируемые вами изменения Swift применяются к работающему приложению. Вступает в силу после перезапуска cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเปลี่ยนแปลง Swift ที่คุณคอมไพล์จะมีผลกับแอปที่กำลังทำงาน มีผลหลังจากรีสตาร์ท cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Derlediğiniz Swift değişiklikleri çalışan uygulamaya uygulanır. cmux yeniden başladıktan sonra geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зміни Swift, які ви компілюєте, застосовуються до запущеного застосунку. Діє після перезапуску cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các thay đổi Swift bạn biên dịch được áp dụng vào ứng dụng đang chạy. Có hiệu lực sau khi cmux khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你编译的 Swift 更改会应用到正在运行的应用。cmux 重启后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你編譯的 Swift 變更會套用到執行中的 App。cmux 重新啟動後生效。"
          }
        }
      }
    },
