        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理聊天中的已存伺服器"}}
      }
    },
    "settings.agents.mcpServers.enabled.help": {
      "comment": "Settings > MCP Servers: toggle help",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "New chats can use the servers listed above."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكن للمحادثات الجديدة استخدام الخوادم المدرجة أعلاه."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Novi chatovi mogu koristiti servere navedene gore."}},
        "da": {"stringUnit": {"state": "translated", "value": "Nye chats kan bruge serverne ovenfor."}},
        "de": {"stringUnit": {"state": "translated", "value": "Neue Chats können die oben genannten Server nutzen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Los chats nuevos pueden usar los servidores de arriba."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les nouvelles discussions utilisent les serveurs ci-dessus."}},
        "it": {"stringUnit": {"state": "translated", "value": "Le nuove chat possono usare i server elencati sopra."}},
        "ja": {"stringUnit": {"state": "translated", "value": "新しいチャットで上のサーバーを使えます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ការជជែកថ្មីអាចប្រើម៉ាស៊ីនមេខាងលើ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "새 채팅에서 위에 나열된 서버를 사용할 수 있습니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Nye chatter kan bruke serverne ovenfor."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nowe czaty mogą używać serwerów wymienionych wyżej."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Novos chats podem usar os servidores listados acima."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Новые чаты могут использовать серверы выше."}},
        "th": {"stringUnit": {"state": "translated", "value": "แชทใหม่ใช้เซิร์ฟเวอร์ที่แสดงด้านบนได้"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yeni sohbetler yukarıdaki sunucuları kullanabilir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Нові чати можуть використовувати сервери вище."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Cuộc trò chuyện mới có thể dùng các máy chủ ở trên."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "新聊天可以使用上方列出的服务器。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "新聊天可以使用上方列出的伺服器。"}}
      }
    },
