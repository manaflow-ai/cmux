    "settings.sidebar.showWorkspaceTabs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Workspace Tabs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのタブを表示"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار علامات تبويب مساحات العمل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži kartice radnih prostora"
          }
        },
        "da": {
