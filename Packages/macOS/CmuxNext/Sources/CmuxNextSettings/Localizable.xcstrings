    "settings.browser.keepNeighborTabsAwake.help": {
      "comment": "Settings row in Browser > Memory: browser.keepNeighborTabsAwake.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى علامات التبويب على جانبي علامة التبويب المعروضة محمّلة وتعمل، فيكون التبديل إليها فوريًا. القيمة 0 توقفه. ضغط الذاكرة ووضع الطاقة المنخفضة يوقفانه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice sa svake strane prikazane kartice ostaju učitane i rade, pa je prelazak na njih trenutan. 0 isključuje. Nedostatak memorije i način niske potrošnje ga isključuju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner på hver side af den viste fane forbliver indlæst og kørende, så skift til dem sker med det samme. 0 slår det fra. Hukommelsespres og strømbesparelse slår det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tabs links und rechts vom angezeigten Tab bleiben geladen und aktiv, sodass der Wechsel sofort erfolgt. 0 schaltet es aus. Speicherdruck und Stromsparmodus schalten es aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs on each side of the shown tab stay loaded and running, so switching to them is instant. 0 turns it off. Memory pressure and Low Power Mode turn it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pestañas a cada lado de la pestaña visible siguen cargadas y en marcha, así cambiar a ellas es instantáneo. 0 lo desactiva. La presión de memoria y el modo de bajo consumo lo desactivan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les onglets de chaque côté de l’onglet affiché restent chargés et actifs : y passer est instantané. 0 désactive. La pression mémoire et le mode Économie d’énergie le désactivent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le schede ai lati della scheda mostrata restano caricate e attive, così passarci è immediato. 0 lo disattiva. La pressione sulla memoria e la modalità di risparmio energetico lo disattivano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "表示中のタブの両側にあるタブを読み込んだまま動かし続けるので、すぐに切り替えられます。0でオフ。メモリ不足時と低電力モードではオフになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនៅសងខាងផ្ទាំងដែលកំពុងបង្ហាញ នៅតែផ្ទុក និងដំណើរការ ដូច្នេះការប្ដូរទៅវាគឺភ្លាមៗ។ 0 បិទវា។ សម្ពាធអង្គចងចាំ និងរបៀបថាមពលទាបបិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "표시 중인 탭 양쪽의 탭이 로드된 채로 실행되므로 즉시 전환할 수 있습니다. 0이면 끕니다. 메모리 부족과 저전력 모드에서는 꺼집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner på hver side av den viste fanen forblir lastet og kjører, så bytte til dem skjer umiddelbart. 0 slår det av. Minnepress og strømsparingsmodus slår det av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty po obu stronach wyświetlanej karty pozostają wczytane i działają, więc przełączanie na nie jest natychmiastowe. 0 wyłącza. Brak pamięci i tryb niskiego zużycia energii wyłączają tę funkcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As abas de cada lado da aba exibida continuam carregadas e em execução, então alternar para elas é instantâneo. 0 desativa. Pressão de memória e o Modo de Pouca Energia desativam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки по обе стороны от показанной остаются загруженными и работают, поэтому переход на них мгновенный. 0 выключает. При нехватке памяти и в режиме энергосбережения выключается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บทั้งสองข้างของแท็บที่แสดงอยู่จะยังโหลดและทำงานอยู่ จึงสลับไปได้ทันที 0 คือปิด แรงกดดันหน่วยความจำและโหมดพลังงานต่ำจะปิดฟีเจอร์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gösterilen sekmenin iki yanındaki sekmeler yüklü ve çalışır kalır, böylece onlara geçiş anında olur. 0 kapatır. Bellek baskısı ve Düşük Güç Modu bunu kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки з обох боків від показаної лишаються завантаженими й працюють, тож перехід на них миттєвий. 0 вимикає. Брак пам’яті та режим енергозбереження вимикають це."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tab ở hai bên tab đang hiển thị vẫn được tải và chạy, nên chuyển sang chúng diễn ra tức thì. 0 để tắt. Áp lực bộ nhớ và Chế độ nguồn điện thấp sẽ tắt tính năng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当前标签页两侧的标签页保持加载并运行，切换过去即刻完成。0 为关闭。内存压力和低电量模式下会关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前分頁兩側的分頁保持載入並執行，切換過去即刻完成。0 為關閉。記憶體壓力與低耗電模式下會關閉。"
          }
        }
      }
    },
