    "settings.appearance.selection": {"comment":"Settings row title: what the selection fill takes (the accent's tint or neutral gray).","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Selection"}},"ar":{"stringUnit":{"state":"needs_review","value":"التحديد"}},"bs":{"stringUnit":{"state":"needs_review","value":"Odabir"}},"da":{"stringUnit":{"state":"needs_review","value":"Markering"}},"de":{"stringUnit":{"state":"needs_review","value":"Auswahl"}},"es":{"stringUnit":{"state":"needs_review","value":"Selección"}},"fr":{"stringUnit":{"state":"needs_review","value":"Sélection"}},"it":{"stringUnit":{"state":"needs_review","value":"Selezione"}},"ja":{"stringUnit":{"state":"translated","value":"選択"}},"km":{"stringUnit":{"state":"needs_review","value":"ការជ្រើសរើស"}},"ko":{"stringUnit":{"state":"needs_review","value":"선택"}},"nb":{"stringUnit":{"state":"needs_review","value":"Markering"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaznaczenie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Seleção"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выделение"}},"th":{"stringUnit":{"state":"needs_review","value":"การเลือก"}},"tr":{"stringUnit":{"state":"needs_review","value":"Seçim"}},"uk":{"stringUnit":{"state":"needs_review","value":"Виділення"}},"vi":{"stringUnit":{"state":"needs_review","value":"Vùng chọn"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选中"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選取"}}}},
    "settings.appearance.selection.help": {"comment":"Settings row help for Selection.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Accent tints the selected row and tab with the accent. Neutral keeps them gray."}},"ar":{"stringUnit":{"state":"needs_review","value":"يلوّن خيار لون التمييز الصف وعلامة التبويب المحددين بلون التمييز. ويبقيهما الخيار المحايد رماديين."}},"bs":{"stringUnit":{"state":"needs_review","value":"Akcent boji odabrani red i karticu bojom akcenta. Neutralno ih ostavlja sivim."}},"da":{"stringUnit":{"state":"needs_review","value":"Accent farver den valgte række og fane med accentfarven. Neutral holder dem grå."}},"de":{"stringUnit":{"state":"needs_review","value":"Akzent tönt die ausgewählte Zeile und den Tab in der Akzentfarbe. Neutral lässt sie grau."}},"es":{"stringUnit":{"state":"needs_review","value":"Acento tiñe la fila y la pestaña seleccionadas con el color de acento. Neutro las deja grises."}},"fr":{"stringUnit":{"state":"needs_review","value":"Accent teinte la ligne et l'onglet sélectionnés de la couleur d'accent. Neutre les garde gris."}},"it":{"stringUnit":{"state":"needs_review","value":"Accento colora la riga e la scheda selezionate con il colore di accento. Neutro le lascia grigie."}},"ja":{"stringUnit":{"state":"translated","value":"アクセントでは、選択中の行とタブをアクセントカラーで色付けします。ニュートラルではグレーのままにします。"}},"km":{"stringUnit":{"state":"needs_review","value":"ពណ៌សង្កត់ លាបពណ៌ជួរ និងផ្ទាំងដែលបានជ្រើសដោយពណ៌សង្កត់។ អព្យាក្រឹត ទុកវាជាពណ៌ប្រផេះ។"}},"ko":{"stringUnit":{"state":"needs_review","value":"강조 색상은 선택한 행과 탭을 강조 색상으로 칠합니다. 중립은 회색으로 둡니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Aksent farger valgt rad og fane med aksentfargen. Nøytral holder dem grå."}},"pl":{"stringUnit":{"state":"needs_review","value":"Akcent barwi zaznaczony wiersz i kartę kolorem akcentu. Neutralny pozostawia je szare."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Destaque tinge a linha e a aba selecionadas com a cor de destaque. Neutro as mantém cinza."}},"ru":{"stringUnit":{"state":"needs_review","value":"Акцент окрашивает выбранную строку и вкладку цветом акцента. Нейтральный оставляет их серыми."}},"th":{"stringUnit":{"state":"needs_review","value":"สีเน้นจะแต้มแถวและแท็บที่เลือกด้วยสีเน้น ส่วนเป็นกลางจะคงเป็นสีเทา"}},"tr":{"stringUnit":{"state":"needs_review","value":"Vurgu, seçili satırı ve sekmeyi vurgu rengiyle boyar. Nötr onları gri tutar."}},"uk":{"stringUnit":{"state":"needs_review","value":"Акцент забарвлює вибраний рядок і вкладку кольором акценту. Нейтральний залишає їх сірими."}},"vi":{"stringUnit":{"state":"needs_review","value":"Màu nhấn tô hàng và thẻ đang chọn bằng màu nhấn. Trung tính giữ chúng màu xám."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"强调色会用强调色为选中的行和标签页着色。中性则保持灰色。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"強調色會以強調色為選取的列與分頁著色。中性則維持灰色。"}}}},
    "settings.appearance.selection.summary": {"comment":"Settings row summary for Selection.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Color of the selected row and tab"}},"ar":{"stringUnit":{"state":"needs_review","value":"لون الصف وعلامة التبويب المحددين"}},"bs":{"stringUnit":{"state":"needs_review","value":"Boja odabranog reda i kartice"}},"da":{"stringUnit":{"state":"needs_review","value":"Farven på den valgte række og fane"}},"de":{"stringUnit":{"state":"needs_review","value":"Farbe der ausgewählten Zeile und des Tabs"}},"es":{"stringUnit":{"state":"needs_review","value":"Color de la fila y la pestaña seleccionadas"}},"fr":{"stringUnit":{"state":"needs_review","value":"Couleur de la ligne et de l'onglet sélectionnés"}},"it":{"stringUnit":{"state":"needs_review","value":"Colore della riga e della scheda selezionate"}},"ja":{"stringUnit":{"state":"translated","value":"選択中の行とタブの色"}},"km":{"stringUnit":{"state":"needs_review","value":"ពណ៌នៃជួរ និងផ្ទាំងដែលបានជ្រើស"}},"ko":{"stringUnit":{"state":"needs_review","value":"선택한 행과 탭의 색상"}},"nb":{"stringUnit":{"state":"needs_review","value":"Fargen på valgt rad og fane"}},"pl":{"stringUnit":{"state":"needs_review","value":"Kolor zaznaczonego wiersza i karty"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Cor da linha e da aba selecionadas"}},"ru":{"stringUnit":{"state":"needs_review","value":"Цвет выбранной строки и вкладки"}},"th":{"stringUnit":{"state":"needs_review","value":"สีของแถวและแท็บที่เลือก"}},"tr":{"stringUnit":{"state":"needs_review","value":"Seçili satır ve sekmenin rengi"}},"uk":{"stringUnit":{"state":"needs_review","value":"Колір вибраного рядка й вкладки"}},"vi":{"stringUnit":{"state":"needs_review","value":"Màu của hàng và thẻ đang chọn"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选中行与标签页的颜色"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選取列與分頁的顏色"}}}},
