        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra cuántos miembros trabajan, esperan, fallaron o tienen elementos sin leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
