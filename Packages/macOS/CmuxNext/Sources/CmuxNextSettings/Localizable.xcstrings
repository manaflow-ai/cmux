    "settings.sidebar.showLocalMachine.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With more than one computer, this Mac's workspaces show its icon too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مع أكثر من حاسوب، تعرض مساحات عمل هذا الـ Mac أيقونته أيضًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S više računara i radni prostori ovog Maca prikazuju njegovu ikonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med mere end én computer viser denne Macs arbejdsområder også dens ikon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei mehr als einem Computer zeigen auch die Arbeitsbereiche dieses Macs sein Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con más de un ordenador, los espacios de trabajo de este Mac también muestran su icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avec plusieurs ordinateurs, les espaces de travail de ce Mac affichent aussi son icône."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con più di un computer, anche gli spazi di lavoro di questo Mac mostrano la sua icona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "複数のコンピュータがあるとき、この Mac のワークスペースにもアイコンを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅពេលមានកុំព្យូទ័រច្រើនជាងមួយ កន្លែងធ្វើការរបស់ Mac នេះក៏បង្ហាញរូបតំណាងរបស់វាដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "컴퓨터가 여러 대일 때 이 Mac의 작업 공간에도 아이콘이 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med mer enn én datamaskin viser også denne Macens arbeidsområder ikonet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przy więcej niż jednym komputerze obszary robocze tego Maca też pokazują jego ikonę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com mais de um computador, os espaços de trabalho deste Mac também mostram o ícone dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если компьютеров несколько, рабочие пространства этого Mac тоже показывают его значок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อมีคอมพิวเตอร์มากกว่าหนึ่งเครื่อง พื้นที่ทำงานของ Mac เครื่องนี้จะแสดงไอคอนของมันด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Birden fazla bilgisayar varken bu Mac'in çalışma alanları da simgesini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли комп'ютерів кілька, робочі простори цього Mac теж показують його значок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi có nhiều máy tính, không gian làm việc của máy Mac này cũng hiển thị biểu tượng của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有多台电脑时，这台 Mac 的工作区也会显示它的图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有多台電腦時，這台 Mac 的工作區也會顯示它的圖示。"
          }
        }
      }
