    "settings.sidebar.minimal.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر أزرار الشريط الجانبي وشريط علامات التبويب فقط أثناء وجود المؤشر فوقها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dugmad bočne trake i traka kartica prikazuju se samo dok je pokazivač iznad njih."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knapperne i sidepanelet og fanelinjen vises kun, mens markøren er over dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tasten der Seitenleiste und Tableiste erscheinen nur, solange der Zeiger darüber ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar and tab bar buttons show only while the pointer is over them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los botones de la barra lateral y de las barras de pestañas solo se muestran mientras el puntero está sobre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les boutons de la barre latérale et des barres d’onglets ne s’affichent que lorsque le pointeur les survole."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I pulsanti della barra laterale e delle barre delle schede si vedono solo mentre il puntatore è sopra di essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーとタブバーのボタンは、ポインタを置いている間だけ表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប៊ូតុងរបារចំហៀង និងរបារផ្ទាំង បង្ហាញតែពេលទស្សន៍ទ្រនិចនៅលើពួកវាប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바와 탭 막대의 버튼은 포인터가 그 위에 있을 때만 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Knappene i sidefeltet og fanelinjene vises bare mens pekeren er over dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przyciski paska bocznego i pasków kart są widoczne tylko, gdy wskaźnik jest nad nimi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os botões da barra lateral e da barra de abas aparecem só enquanto o ponteiro está sobre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кнопки боковой панели и панелей вкладок видны, только пока указатель над ними."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปุ่มของแถบด้านข้างและแถบแท็บจะแสดงเฉพาะเมื่อตัวชี้อยู่เหนือสิ่งเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğu ve sekme çubuğu düğmeleri yalnızca işaretçi üzerlerindeyken görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кнопки бічної панелі й панелей вкладок видні, лише поки вказівник над ними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các nút của thanh bên và thanh thẻ chỉ hiện khi con trỏ ở trên chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "边栏和标签栏的按钮仅在指针位于其上方时显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄和分頁列的按鈕僅在指標位於其上方時顯示。"
          }
        }
      }
