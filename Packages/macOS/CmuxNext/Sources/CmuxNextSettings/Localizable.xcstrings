        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่วงแหวนท้ายช่องเขียนแสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yazma alanının sonundaki halkanın gösterdiği."
          }
        },
        "uk": {
