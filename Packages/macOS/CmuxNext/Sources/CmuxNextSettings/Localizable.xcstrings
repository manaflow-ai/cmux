    "settings.choice.link.linkPlacement": {
      "comment": "Settings choice for a browser link click (the Command-click default): open the link where the Open Links and Files setting (layout.linkPlacement) puts links: by default the pane right of the page, or a new split there.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as Open Links and Files"
          }
        },
        "ar": {
          "stringUnit": {
