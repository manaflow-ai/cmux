    "settings.appearance.backgroundSchedule.help": {
      "comment": "Settings row help for the time-of-day schedule. Keep 07:00, sunrise, sunset, dawn, dusk, noon and sunset-30m as written: they are the values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A time (07:00) or sun event (sunset-30m) for each picture."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وقت (07:00) أو حدث شمسي (sunset-30m) لكل صورة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrijeme (07:00) ili događaj sunca (sunset-30m) za svaku sliku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et klokkeslæt (07:00) eller en solbegivenhed (sunset-30m) for hvert billede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Uhrzeit (07:00) oder ein Sonnenereignis (sunset-30m) für jedes Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una hora (07:00) o un evento solar (sunset-30m) para cada imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une heure (07:00) ou un événement solaire (sunset-30m) pour chaque image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un orario (07:00) o un evento solare (sunset-30m) per ogni immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各画像の時刻（07:00）または太陽のイベント（sunset-30m）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ោង (07:00) ឬព្រឹត្តិការណ៍ព្រះអាទិត្យ (sunset-30m) សម្រាប់រូបភាពនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 사진에 시각(07:00)이나 해의 움직임(sunset-30m)을 지정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et klokkeslett (07:00) eller en solhendelse (sunset-30m) for hvert bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godzina (07:00) lub zdarzenie słoneczne (sunset-30m) dla każdego obrazu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um horário (07:00) ou evento solar (sunset-30m) para cada imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Время (07:00) или событие солнца (sunset-30m) для каждого изображения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เวลา (07:00) หรือเหตุการณ์ดวงอาทิตย์ (sunset-30m) สำหรับแต่ละภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her resim için bir saat (07:00) veya güneş olayı (sunset-30m)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Час (07:00) або подія сонця (sunset-30m) для кожного зображення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một giờ (07:00) hoặc sự kiện mặt trời (sunset-30m) cho mỗi ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为每张图片设置时间（07:00）或太阳事件（sunset-30m）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
