    "settings.layout.columnWidthPresets.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widths a column cycles through, as fractions of the visible strip width."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "العروض التي يتنقل بينها العمود، ككسور من عرض الشريط المرئي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Širine kroz koje kolona kruži, kao dijelovi vidljive širine trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bredder, en kolonne skifter mellem, som brøkdele af den synlige bredde."
