    "settings.mobile.terminalSizingOrder.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The devices whose size a shared terminal takes first, highest first, when Terminal Size When Shared is Priority Order."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الأجهزة التي تأخذ الطرفية المشتركة حجمها أولًا، الأعلى أولًا، عندما يكون حجم الطرفية عند المشاركة هو ترتيب الأولوية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uređaji čiju veličinu dijeljeni terminal prvo preuzima, najviši prvi, kada je Veličina terminala pri dijeljenju postavljena na Redoslijed prioriteta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De enheder, hvis størrelse en delt terminal tager først, højeste først, når Terminalstørrelse ved deling er Prioritetsrækkefølge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Geräte, deren Größe ein geteiltes Terminal zuerst übernimmt, höchste zuerst, wenn „Terminalgröße beim Teilen“ auf „Prioritätsreihenfolge“ steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los dispositivos cuyo tamaño toma primero un terminal compartido, de mayor a menor, cuando Tamaño del terminal al compartir es Orden de prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les appareils dont un terminal partagé prend la taille en premier, du plus prioritaire au moins prioritaire, quand Taille du terminal partagé est Ordre de priorité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I dispositivi di cui un terminale condiviso prende per prima la dimensione, dal più alto, quando Dimensione del terminale condiviso è Ordine di priorità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "共有時のターミナルサイズが優先順位のとき、共有ターミナルが先にサイズを採用するデバイス（上から順）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឧបករណ៍ដែល Terminal ដែលបានចែករំលែកយកទំហំមុនគេ ខ្ពស់បំផុតមុន ពេលទំហំ Terminal ពេលចែករំលែកជាលំដាប់អាទិភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "공유 시 터미널 크기가 우선순위일 때 공유 터미널이 먼저 따르는 기기의 크기(높은 순서부터)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enhetene hvis størrelse en delt terminal tar først, høyeste først, når Terminalstørrelse ved deling er Prioritetsrekkefølge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Urządzenia, których rozmiar udostępniony terminal przyjmuje najpierw, od najwyższego, gdy Rozmiar terminala przy udostępnianiu to Kolejność priorytetów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dispositivos cujo tamanho um terminal compartilhado adota primeiro, do mais alto ao mais baixo, quando Tamanho do terminal ao compartilhar é Ordem de prioridade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Устройства, размер которых общий терминал берёт в первую очередь, начиная с высшего, когда для размера терминала при совместном просмотре выбран порядок приоритета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อุปกรณ์ที่เทอร์มินัลที่แชร์จะใช้ขนาดก่อน เรียงจากสูงสุด เมื่อขนาดเทอร์มินัลเมื่อแชร์เป็นลำดับความสำคัญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Paylaşılan terminal boyutu Öncelik sırası olduğunda, paylaşılan bir terminalin boyutunu ilk aldığı cihazlar, en yüksekten başlayarak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пристрої, розмір яких спільний термінал бере першим, від найвищого, коли для розміру термінала під час спільного перегляду вибрано порядок пріоритету."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các thiết bị mà terminal được chia sẻ lấy kích thước trước, cao nhất trước, khi Kích thước terminal khi chia sẻ là Thứ tự ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当“共享时的终端大小”为“优先顺序”时，共享终端优先采用其大小的设备，按从高到低排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當「共享時的終端機大小」為「優先順序」時，共享終端機優先採用其大小的裝置，由高到低排列。"
          }
        }
      }
    },
