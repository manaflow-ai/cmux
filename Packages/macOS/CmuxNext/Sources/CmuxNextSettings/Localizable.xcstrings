    "settings.notifications.showPreviews.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يعرض الإشعار ما قاله الوكيل، أم المكان والحالة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Da li obavještenje prikazuje šta je agent rekao ili samo gdje i u kojem je stanju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om et banner viser, hvad agenten sagde, eller kun hvor og hvilken tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob ein Banner zeigt, was der Agent gesagt hat, oder nur wo und welcher Zustand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether a banner shows what the agent said, or only where and what state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un aviso muestra lo que dijo el agente o solo dónde y en qué estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une bannière affiche ce que l’agent a dit, ou seulement où et dans quel état."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un banner mostra cosa ha detto l’agente o solo dove e in quale stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バナーにエージェントの発言を表示するか、場所と状態だけを表示するか。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថាតើបដាបង្ហាញអ្វីដែលភ្នាក់ងារបាននិយាយ ឬតែទីកន្លែង និងស្ថានភាពប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배너에 에이전트가 한 말을 표시할지, 위치와 상태만 표시할지 정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om et banner viser hva agenten sa, eller bare hvor og hvilken tilstand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy baner pokazuje, co powiedział agent, czy tylko gdzie i w jakim stanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um banner mostra o que o agente disse ou apenas onde e em que estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать ли в баннере слова агента или только где и в каком состоянии."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบนเนอร์จะแสดงสิ่งที่เอเจนต์พูด หรือแสดงเพียงตำแหน่งและสถานะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimin ajanın söylediğini mi yoksa yalnızca yeri ve durumu mu göstereceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи показує банер слова агента, чи лише де й у якому стані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu ngữ hiện điều tác tử đã nói, hay chỉ vị trí và trạng thái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅是显示代理说的内容，还是只显示位置和状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫幅是顯示代理說的內容，還是只顯示位置和狀態。"
          }
        }
      }
    },
