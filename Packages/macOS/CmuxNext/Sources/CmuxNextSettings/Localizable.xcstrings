    "settings.attention.moveToTop.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification moves its workspace to the top of the unpinned rows, unless you are looking at its pane."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينقل الإشعار مساحة العمل الخاصة به إلى أعلى الصفوف غير المثبتة، ما لم تكن تنظر إلى جزئها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obavijest premješta svoj radni prostor na vrh nepričvršćenih redova, osim ako gledate njegovo okno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En notifikation flytter sit arbejdsområde øverst blandt de ikke-fastgjorte rækker, medmindre du kigger på dets rude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Mitteilung verschiebt ihren Arbeitsbereich an den Anfang der nicht angehefteten Zeilen, außer du siehst dir seinen Bereich gerade an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una notificación mueve su espacio de trabajo arriba de las filas no fijadas, salvo que estés mirando su panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une notification place son espace de travail en haut des lignes non épinglées, sauf si vous regardez son panneau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una notifica sposta il suo spazio di lavoro in cima alle righe non fissate, a meno che tu non stia guardando il suo riquadro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通知を受け取ったワークスペースは、そのペインを見ている場合を除き、固定されていない行の先頭に移動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជូនដំណឹងផ្លាស់ទីកន្លែងធ្វើការរបស់វាទៅខាងលើជួរដែលមិនបានខ្ទាស់ លុះត្រាតែអ្នកកំពុងមើលផ្ទាំងរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "알림이 오면 해당 창을 보고 있지 않는 한 그 워크스페이스가 고정되지 않은 행의 맨 위로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et varsel flytter arbeidsområdet sitt øverst blant radene som ikke er festet, med mindre du ser på ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powiadomienie przenosi swój obszar roboczy na górę nieprzypiętych wierszy, chyba że patrzysz na jego panel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma notificação move seu espaço de trabalho para o topo das linhas não fixadas, a menos que você esteja olhando o painel dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уведомление перемещает своё рабочее пространство наверх незакреплённых строк, если только вы не смотрите на его панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแจ้งเตือนจะย้ายพื้นที่ทำงานของมันไปไว้บนสุดของแถวที่ไม่ได้ปักหมุด เว้นแต่คุณกำลังดูบานหน้าต่างนั้นอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir bildirim, bölmesine bakmıyorsanız çalışma alanını sabitlenmemiş satırların en üstüne taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сповіщення переміщує свій робочий простір угору незакріплених рядків, якщо ви не дивитеся на його панель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
