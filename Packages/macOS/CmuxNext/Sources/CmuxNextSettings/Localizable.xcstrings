          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar os espaços de trabalho deste Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечать рабочие пространства этого Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายพื้นที่ทำงานของ Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in çalışma alanlarını işaretle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначати робочі простори цього Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu không gian làm việc của máy Mac này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记这台 Mac 的工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記這台 Mac 的工作區"
          }
        }
