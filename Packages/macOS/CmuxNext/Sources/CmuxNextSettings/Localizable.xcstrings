            "value": "Sohbet, metin genişliği yerine bölmenin tamamını kaplar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат займає всю панель замість ширини тексту."
          }
        },
        "vi": {
          "stringUnit": {
