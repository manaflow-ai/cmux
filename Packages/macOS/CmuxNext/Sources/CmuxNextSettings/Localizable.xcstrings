    "settings.remoteDesktop.maxBitrateMbps.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The most megabits per second a new Screen Sharing session may use. Auto lets the host decide."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أقصى عدد من الميغابت في الثانية يمكن أن تستخدمه جلسة مشاركة شاشة جديدة. يترك الوضع التلقائي القرار للمضيف."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Najviše megabita u sekundi koje nova sesija dijeljenja ekrana smije koristiti. Automatski prepušta odluku domaćinu."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Det højeste antal megabit pr. sekund, en ny skærmdelingssession må bruge. Auto lader værten bestemme."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die meisten Megabit pro Sekunde, die eine neue Bildschirmfreigabe nutzen darf. Automatisch überlässt es dem Host."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El máximo de megabits por segundo que puede usar una nueva sesión de pantalla compartida. Automático deja que decida el host."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le nombre maximal de mégabits par seconde qu’une nouvelle session de partage d’écran peut utiliser. Auto laisse l’hôte décider."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il numero massimo di megabit al secondo che una nuova sessione di condivisione schermo può usare. Automatico lascia decidere all’host."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "新しい画面共有セッションが使える1秒あたりの最大メガビット数です。自動はホストに任せます。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ចំនួនមេហ្គាប៊ីតច្រើនបំផុតក្នុងមួយវិនាទីដែលវគ្គចែករំលែកអេក្រង់ថ្មីអាចប្រើ។ ស្វ័យប្រវត្តិឱ្យម៉ាស៊ីនសម្រេច។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "새 화면 공유 세션이 사용할 수 있는 초당 최대 메가비트입니다. 자동은 호스트가 결정합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Det høyeste antallet megabit per sekund en ny skjermdelingsøkt kan bruke. Auto lar verten bestemme."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Największa liczba megabitów na sekundę, jakiej może użyć nowa sesja udostępniania ekranu. Automatycznie decyduje host."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O máximo de megabits por segundo que uma nova sessão de compartilhamento de tela pode usar. Automático deixa o host decidir."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Наибольшее число мегабит в секунду, которое может использовать новый сеанс демонстрации экрана. «Авто» оставляет решение хосту."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "จำนวนเมกะบิตต่อวินาทีสูงสุดที่เซสชันการแชร์หน้าจอใหม่ใช้ได้ อัตโนมัติให้โฮสต์เป็นผู้ตัดสิน"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Yeni bir ekran paylaşımı oturumunun kullanabileceği en fazla saniyedeki megabit. Otomatik kararı ana makineye bırakır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Найбільша кількість мегабіт за секунду, яку може використати новий сеанс демонстрації екрана. «Авто» залишає рішення хосту."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Số megabit mỗi giây tối đa mà một phiên chia sẻ màn hình mới được dùng. Tự động để máy chủ quyết định."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "新的屏幕共享会话最多可用的每秒兆比特数。自动由主机决定。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "新的螢幕共享工作階段最多可用的每秒百萬位元數。自動由主機決定。"}}
      }
    },
