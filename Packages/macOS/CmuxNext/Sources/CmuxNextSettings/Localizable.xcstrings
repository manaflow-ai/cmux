    "settings.sidebar.spacesPosition.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the spaces dots sit in the sidebar: under the window buttons or above the Settings row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバー内でスペースのドットを置く場所：ウインドウのボタンの下、または設定の行の上。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مكان نقاط المساحات في الشريط الجانبي: أسفل أزرار النافذة أو فوق صف الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdje su tačke prostora u bočnoj traci: ispod dugmadi prozora ili iznad reda Postavke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor rummenes prikker sidder i sidepanelet: under vinduesknapperne eller over rækken Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wo die Punkte der Bereiche in der Seitenleiste sitzen: unter den Fenstertasten oder über der Zeile „Einstellungen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dónde están los puntos de los espacios en la barra lateral: bajo los botones de la ventana o sobre la fila de Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Emplacement des points des espaces dans la barre latérale : sous les boutons de la fenêtre ou au-dessus de la ligne Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dove si trovano i punti degli spazi nella barra laterale: sotto i pulsanti della finestra o sopra la riga Impostazioni."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងដែលចំណុចលំហស្ថិតនៅក្នុងរបារចំហៀង៖ ក្រោមប៊ូតុងបង្អួច ឬលើជួរការកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바에서 스페이스 점이 놓이는 곳: 윈도우 버튼 아래 또는 설정 행 위."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor områdeprikkene ligger i sidefeltet: under vindusknappene eller over Innstillinger-raden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miejsce kropek przestrzeni na pasku bocznym: pod przyciskami okna lub nad wierszem Ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde ficam os pontos dos espaços na barra lateral: abaixo dos botões da janela ou acima da linha de Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Где находятся точки пространств на боковой панели: под кнопками окна или над строкой «Настройки»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตำแหน่งของจุดสเปซในแถบด้านข้าง: ใต้ปุ่มหน้าต่าง หรือเหนือแถวการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alan noktalarının kenar çubuğundaki yeri: pencere düğmelerinin altında veya Ayarlar satırının üstünde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Де розташовані точки просторів на бічній панелі: під кнопками вікна або над рядком «Налаштування»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vị trí các chấm không gian trong thanh bên: dưới các nút cửa sổ hoặc phía trên hàng Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "空间圆点在侧边栏中的位置：窗口按钮下方或设置行上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "空間圓點在側邊欄中的位置：視窗按鈕下方或設定列上方。"
          }
        }
      }
    },
