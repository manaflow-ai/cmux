          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mala štoperica proteklog vremena pored polja za pisanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lille stopur for forløbet tid ved siden af skrivefeltet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Stoppuhr für die verstrichene Zeit neben dem Eingabefeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small elapsed-time stopwatch beside the composer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño cronómetro de tiempo transcurrido junto al editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit chronomètre du temps écoulé à côté du champ de saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo cronometro del tempo trascorso accanto al compositore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄の横に表示される小さな経過時間ストップウォッチ。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាឡិកា​បញ្ឈប់​តូច​សម្រាប់​រយៈពេល​កន្លង​ទៅ​នៅ​ក្បែរ​ប្រអប់​សរសេរ។"
