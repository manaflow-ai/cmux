    "settings.agents.promptSuggestions.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggests your next prompt in grey; Tab takes it. Each one is an extra model call."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقترح طلبك التالي بنص رمادي؛ يقبله Tab. كل اقتراح استدعاء إضافي للنموذج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Predlaže vaš sljedeći upit sivim tekstom; Tab ga prihvata. Svaki je dodatni poziv modela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foreslår din næste prompt med gråt; Tab tager den. Hvert forslag er et ekstra modelkald."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schlägt deinen nächsten Prompt in Grau vor; Tab übernimmt ihn. Jeder Vorschlag ist ein zusätzlicher Modellaufruf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sugiere tu siguiente instrucción en gris; Tab la acepta. Cada una es una llamada adicional al modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suggère votre prochaine instruction en gris ; Tab l’accepte. Chacune est un appel supplémentaire au modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suggerisce il tuo prossimo prompt in grigio; Tab lo accetta. Ognuno è una chiamata in più al modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "次のプロンプトをグレーで提案し、Tab で採用できます。提案ごとにモデル呼び出しが 1 回追加されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ណែនាំសំណើបន្ទាប់របស់អ្នកជាអក្សរពណ៌ប្រផេះ ហើយ Tab ទទួលយកវា។ ការណែនាំនីមួយៗគឺជាការហៅម៉ូដែលបន្ថែម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다음 프롬프트를 회색으로 제안하며 Tab으로 받아들입니다. 제안마다 모델 호출이 한 번 더 발생합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foreslår din neste ledetekst i grått; Tab tar den. Hvert forslag er ett ekstra modellkall."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proponuje Twój następny prompt na szaro; Tab go przyjmuje. Każda propozycja to dodatkowe wywołanie modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sugere seu próximo prompt em cinza; Tab o aceita. Cada sugestão é uma chamada extra ao modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Предлагает следующий запрос серым текстом; Tab принимает его. Каждое предложение — ещё один вызов модели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แนะนำพรอมต์ถัดไปของคุณเป็นสีเทา กด Tab เพื่อใช้ การแนะนำแต่ละครั้งคือการเรียกโมเดลเพิ่มหนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sonraki isteminizi gri olarak önerir; Tab onu alır. Her öneri fazladan bir model çağrısıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пропонує ваш наступний запит сірим текстом; Tab приймає його. Кожна пропозиція — ще один виклик моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gợi ý lời nhắc tiếp theo bằng chữ xám; nhấn Tab để dùng. Mỗi gợi ý là một lần gọi mô hình thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以灰色文字建议你的下一条提示；按 Tab 即可采用。每条建议都是一次额外的模型调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以灰色文字建議你的下一則提示；按 Tab 即可採用。每則建議都是一次額外的模型呼叫。"
          }
        }
      }
    },
    "settings.sidebar.floatOnHover": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "إظهار الشريط الجانبي المخفي عائمًا عند التمرير"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Plutajuća skrivena bočna traka pri prelasku"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Vis skjult sidepanel svævende ved markør"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ausgeblendete Seitenleiste beim Überfahren schwebend zeigen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Float Hidden Sidebar on Hover"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Mostrar la barra lateral oculta flotando al pasar el puntero"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Afficher la barre latérale masquée en survol"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Mostra la barra laterale nascosta fluttuante al passaggio"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "非表示のサイドバーをポインタでフロート表示"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញរបារចំហៀងដែលលាក់ជាអណ្ដែតពេលដាក់ទស្សន៍ទ្រនិច"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "호버 시 숨긴 사이드바를 떠 있게 표시"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Vis skjult sidepanel flytende ved peker"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pokazuj ukryty pasek boczny jako pływający po najechaniu"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostrar a barra lateral oculta flutuando ao passar o ponteiro"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Показывать скрытую боковую панель поверх при наведении"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงแถบด้านข้างที่ซ่อนแบบลอยเมื่อวางเมาส์"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Gizli kenar çubuğunu üzerine gelince yüzer göster"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Показувати приховану бічну панель поверх при наведенні"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hiện thanh bên đã ẩn dạng nổi khi di chuột"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "悬停时浮动显示隐藏的侧边栏"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "懸停時浮動顯示隱藏的側邊欄"}}
      }
    },
    "settings.sidebar.floatOnHover.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عندما يكون الشريط الجانبي مخفيًا، أشر إلى حافة النافذة لإظهاره فوق عملك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dok je bočna traka skrivena, pokažite na rub prozora da se prikaže iznad vašeg rada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når sidepanelet er skjult, så peg på vinduets kant for at vise det over dit arbejde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ist die Seitenleiste ausgeblendet, zeige auf den Fensterrand, um sie über deiner Arbeit einzublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the sidebar hidden, point at the window's edge to show it over your work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con la barra lateral oculta, apunta al borde de la ventana para mostrarla sobre tu trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barre latérale masquée, pointez sur le bord de la fenêtre pour l’afficher par-dessus votre travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con la barra laterale nascosta, punta il bordo della finestra per mostrarla sopra il tuo lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーが非表示のとき、ウインドウの端にポインタを置くと作業の上にサイドバーが表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពេលរបារចំហៀងត្រូវបានលាក់ ចង្អុលទៅគែមបង្អួច ដើម្បីបង្ហាញវាលើការងាររបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바가 숨겨져 있을 때 창 가장자리를 가리키면 작업 위에 사이드바가 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når sidepanelet er skjult, pek på vinduets kant for å vise det over arbeidet ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy pasek boczny jest ukryty, wskaż krawędź okna, aby pokazać go nad pracą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com a barra lateral oculta, aponte para a borda da janela para mostrá-la sobre o seu trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когда боковая панель скрыта, наведите указатель на край окна, чтобы показать её поверх работы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อซ่อนแถบด้านข้าง ให้ชี้ที่ขอบหน้าต่างเพื่อแสดงแถบเหนืองานของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğu gizliyken, işinizin üzerinde göstermek için pencerenin kenarına gelin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли бічну панель приховано, наведіть вказівник на край вікна, щоб показати її поверх роботи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi thanh bên bị ẩn, trỏ vào cạnh cửa sổ để hiện thanh bên trên công việc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "侧边栏隐藏时，将指针移到窗口边缘即可让它浮在内容上方显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄隱藏時，將指標移到視窗邊緣，側邊欄會浮在你的工作上方顯示。"
          }
        }
      }
    },
