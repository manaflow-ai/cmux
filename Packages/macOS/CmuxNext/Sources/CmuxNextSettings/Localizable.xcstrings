          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сообщает новым чатам Codex, как cmux показывает планы, побочные сессии и сводки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แจ้งแชท Codex ใหม่ว่า cmux แสดงแผน เซสชันข้างเคียง และสรุปอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
