    "settings.updates.web.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Merge gets web UI changes minutes after they land."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مع «عند كل دمج» تصل تغييرات واجهة الويب بعد دقائق من اعتمادها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri svakom spajanju: promjene web sučelja stižu nekoliko minuta nakon što budu spojene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ved hver fletning: ændringer i webbrugerfladen kommer få minutter efter, at de er flettet ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei jedem Merge erhältst du Änderungen an der Web-UI Minuten nach dem Merge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En cada fusión: los cambios de la interfaz web llegan minutos después de fusionarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À chaque fusion reçoit les modifications de l’interface web quelques minutes après leur fusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A ogni merge: le modifiche all’interfaccia web arrivano pochi minuti dopo il merge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「マージごと」では、Web UI の変更がマージから数分で届きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រាល់ការបញ្ចូល ទទួលបានការផ្លាស់ប្ដូរចំណុចប្រទាក់វេបប៉ុន្មាននាទីបន្ទាប់ពីបញ្ចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "병합할 때마다는 웹 UI 변경 사항을 병합 후 몇 분 안에 받습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ved hver sammenslåing: endringer i nettgrensesnittet kommer noen minutter etter at de er slått sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przy każdym scaleniu zmiany interfejsu webowego docierają kilka minut po scaleniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A cada merge recebe as mudanças da interface web minutos depois de entrarem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«При каждом слиянии»: изменения веб-интерфейса приходят через несколько минут после слияния."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกการผสาน: การเปลี่ยนแปลง UI เว็บจะมาถึงภายในไม่กี่นาทีหลังผสาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her birleştirmede: web arayüzü değişiklikleri birleştirildikten dakikalar sonra gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Після кожного злиття: зміни вебінтерфейсу надходять за кілька хвилин після злиття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi lần hợp nhất nhận thay đổi giao diện web vài phút sau khi được hợp nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每次合并：网页界面的更改会在合并后几分钟内送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每次合併：網頁介面的變更會在合併後幾分鐘內送達。"
          }
        }
      }
    },
