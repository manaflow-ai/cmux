    "settings.navigation.historyScope.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Go Back and Go Forward walk: places in this workspace, in this window, or the focused page's own history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「戻る」と「進む」の移動範囲：このワークスペース内、このウインドウ内、またはフォーカス中のページ自体の履歴。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما يتنقل فيه الرجوع والتقدم: الأماكن في مساحة العمل هذه، أو في هذه النافذة، أو سجل الصفحة المحددة نفسها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kroz šta prolaze Idi nazad i Idi naprijed: mjesta u ovom radnom prostoru, u ovom prozoru ili vlastita historija fokusirane stranice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad Gå tilbage og Gå frem gennemløber: steder i dette arbejdsområde, i dette vindue eller den fokuserede sides egen historik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was Zurück und Vorwärts durchlaufen: Orte in diesem Arbeitsbereich, in diesem Fenster oder den eigenen Verlauf der fokussierten Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qué recorren Ir atrás e Ir adelante: lugares de este espacio de trabajo, de esta ventana o el historial propio de la página enfocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce que parcourent Précédent et Suivant : les lieux de cet espace de travail, de cette fenêtre ou l’historique propre de la page active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa percorrono Vai indietro e Vai avanti: luoghi in questo spazio di lavoro, in questa finestra o la cronologia della pagina attiva."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែល ថយក្រោយ និង ទៅមុខ ឆ្លងកាត់៖ ទីតាំងក្នុងកន្លែងធ្វើការនេះ ក្នុងបង្អួចនេះ ឬប្រវត្តិផ្ទាល់របស់ទំព័រដែលបានផ្ដោត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "뒤로 가기와 앞으로 가기의 이동 범위: 이 작업 공간의 위치, 이 창의 위치 또는 포커스된 페이지 자체의 기록."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva Gå tilbake og Gå frem går gjennom: steder i dette arbeidsområdet, i dette vinduet eller den fokuserte sidens egen logg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co przechodzą Wstecz i Dalej: miejsca w tym obszarze roboczym, w tym oknie lub własną historię aktywnej strony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que Voltar e Avançar percorrem: lugares deste espaço de trabalho, desta janela ou o histórico da própria página em foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "По чему ходят «Назад» и «Вперёд»: места в этом рабочем пространстве, в этом окне или собственная история страницы в фокусе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่ ย้อนกลับ และ ไปข้างหน้า เดินผ่าน: ตำแหน่งในพื้นที่ทำงานนี้ ในหน้าต่างนี้ หรือประวัติของหน้าที่โฟกัสอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geri Git ve İleri Git'in dolaştığı yerler: bu çalışma alanındaki yerler, bu penceredeki yerler veya odaktaki sayfanın kendi geçmişi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чим ходять «Назад» і «Вперед»: місця в цьому робочому просторі, у цьому вікні або власна історія сторінки у фокусі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lùi và Tiến đi qua đâu: các vị trí trong không gian làm việc này, trong cửa sổ này hoặc lịch sử riêng của trang đang được chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“后退”和“前进”的范围：此工作区内的位置、此窗口内的位置，或当前页面自身的历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「上一頁」和「下一頁」的範圍：此工作區內的位置、此視窗內的位置，或目前頁面本身的歷史記錄。"
          }
        }
      }
    },
