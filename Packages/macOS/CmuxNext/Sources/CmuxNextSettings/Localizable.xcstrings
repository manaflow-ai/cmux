    "settings.ui.calm.help": {
      "comment": "Settings > Appearance > Motion: help text of Calm Mode; Calm and Still are its two on values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm: nothing slides, springs or spins, hover cards stay closed and the pointer leaves no highlight on tabs, rows and buttons. Still: Calm, and every animation is instant. Your other motion and hover card settings come back when it is off."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هادئ: لا شيء ينزلق أو يرتد أو يدور، وتبقى بطاقات التمرير مغلقة، ولا يترك المؤشر أي تمييز على علامات التبويب والصفوف والأزرار. ثابت: مثل هادئ، وكل حركة فورية. تعود إعدادات الحركة وبطاقات التمرير الأخرى عند إيقافه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mirno: ništa ne klizi, ne odskače i ne vrti se, kartice pri prelasku ostaju zatvorene, a pokazivač ne ostavlja isticanje na karticama, redovima i dugmadima. Mirovanje: kao Mirno, i svaka animacija je trenutna. Ostale postavke pokreta i kartica vraćaju se kada je isključeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rolig: intet glider, fjedrer eller drejer, svævekort forbliver lukkede, og markøren efterlader ingen fremhævning på faner, rækker og knapper. Stille: Rolig, og alle animationer sker med det samme. Dine andre bevægelses- og svævekortindstillinger vender tilbage, når den er slået fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruhig: Nichts gleitet, federt oder dreht sich, Hover-Karten bleiben geschlossen und der Zeiger hebt Tabs, Zeilen und Tasten nicht hervor. Still: wie Ruhig, und jede Animation erfolgt sofort. Deine anderen Bewegungs- und Hover-Karten-Einstellungen gelten wieder, wenn er aus ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Calma: nada se desliza, rebota ni gira, las tarjetas emergentes no se abren y el puntero no resalta pestañas, filas ni botones. Inmóvil: como Calma, y todas las animaciones son instantáneas. Tus otros ajustes de movimiento y tarjetas vuelven al desactivarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Calme : rien ne glisse, ne rebondit ni ne tourne, les cartes de survol restent fermées et le pointeur ne met en évidence ni onglets, ni lignes, ni boutons. Immobile : comme Calme, et chaque animation est instantanée. Vos autres réglages de mouvement et de cartes reviennent quand il est désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Calma: niente scorre, rimbalza o ruota, le schede al passaggio restano chiuse e il puntatore non evidenzia schede, righe e pulsanti. Immobile: come Calma, e ogni animazione è istantanea. Le altre impostazioni di movimento e delle schede tornano quando è disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "落ち着き: スライド、弾み、回転がなくなり、ホバーカードは開かず、ポインタを重ねてもタブ、行、ボタンが強調表示されません。静止: 落ち着きに加えて、すべてのアニメーションが即座に完了します。オフにすると、ほかのモーションとホバーカードの設定が元に戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្ងប់៖ គ្មានអ្វីរអិល លោត ឬបង្វិលទេ កាតដាក់ទស្សន៍ទ្រនិចនៅតែបិទ ហើយទស្សន៍ទ្រនិចមិនបន្លិចផ្ទាំង ជួរ និងប៊ូតុងទេ។ នៅស្ងៀម៖ ដូចស្ងប់ ហើយចលនាទាំងអស់កើតឡើងភ្លាមៗ។ ការកំណត់ចលនា និងកាតផ្សេងទៀតរបស់អ្នកត្រឡប់មកវិញនៅពេលបិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "차분하게: 미끄러지거나 튀거나 회전하는 움직임이 없고, 호버 카드가 열리지 않으며, 포인터를 올려도 탭, 행, 버튼이 강조되지 않습니다. 정지: 차분하게에 더해 모든 애니메이션이 즉시 끝납니다. 끄면 다른 모션 및 호버 카드 설정이 다시 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rolig: ingenting glir, spretter eller snurrer, svevekort forblir lukket, og pekeren uthever ikke faner, rader og knapper. Stille: Rolig, og alle animasjoner skjer umiddelbart. De andre bevegelses- og svevekortinnstillingene dine kommer tilbake når den er av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spokojny: nic się nie przesuwa, nie odbija ani nie obraca, karty po najechaniu pozostają zamknięte, a wskaźnik nie podświetla kart, wierszy ani przycisków. Bez ruchu: jak Spokojny, a każda animacja jest natychmiastowa. Pozostałe ustawienia ruchu i kart wracają po wyłączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Calmo: nada desliza, quica ou gira, os cartões de passagem ficam fechados e o ponteiro não destaca abas, linhas e botões. Imóvel: como Calmo, e toda animação é instantânea. Seus outros ajustes de movimento e de cartões voltam quando ele é desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спокойно: ничего не скользит, не пружинит и не вращается, карточки при наведении не открываются, а указатель не подсвечивает вкладки, строки и кнопки. Без движения: как Спокойно, и все анимации мгновенные. Остальные настройки движения и карточек вернутся, когда режим выключен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สงบ: ไม่มีสิ่งใดเลื่อน เด้ง หรือหมุน การ์ดเมื่อชี้จะไม่เปิด และตัวชี้จะไม่ไฮไลต์แท็บ แถว และปุ่ม นิ่ง: เหมือนสงบ และทุกแอนิเมชันจะเกิดขึ้นทันที การตั้งค่าการเคลื่อนไหวและการ์ดอื่นๆ ของคุณจะกลับมาเมื่อปิดโหมดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sakin: hiçbir şey kaymaz, sekmez veya dönmez, üzerine gelme kartları açılmaz ve işaretçi sekmeleri, satırları ve düğmeleri vurgulamaz. Durgun: Sakin gibi, ayrıca her animasyon anında gerçekleşir. Diğer hareket ve kart ayarlarınız kapatıldığında geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спокійно: ніщо не ковзає, не пружинить і не обертається, картки при наведенні не відкриваються, а вказівник не підсвічує вкладки, рядки й кнопки. Без руху: як Спокійно, і всі анімації миттєві. Інші налаштування руху й карток повернуться, коли режим вимкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tĩnh: không có gì trượt, nảy hay xoay, thẻ khi di chuột không mở và con trỏ không làm nổi bật tab, hàng và nút. Đứng yên: như Tĩnh, và mọi hoạt ảnh diễn ra ngay lập tức. Các cài đặt chuyển động và thẻ khác của bạn sẽ trở lại khi tắt chế độ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "平静：不再滑动、弹跳或旋转，悬停卡片不会打开，指针也不会高亮标签页、行和按钮。静止：在平静的基础上，所有动画立即完成。关闭后，你的其他动效和悬停卡片设置会恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "平靜：不再滑動、彈跳或旋轉，懸停卡片不會打開，指標也不會醒目標示分頁、列和按鈕。靜止：在平靜的基礎上，所有動畫立即完成。關閉後，你的其他動態效果和懸停卡片設定會恢復。"
          }
        }
      }
    },
    "settings.agents.subsessions.answerQuestions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Sessions Answer Their Sub-sessions' Questions"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح للجلسات بالإجابة عن أسئلة جلساتها الفرعية"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli sesijama da odgovaraju na pitanja svojih podsesija"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad sessioner besvare deres undersessioners spørgsmål"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen dürfen Fragen ihrer Untersitzungen beantworten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que las sesiones respondan las preguntas de sus subsesiones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les sessions à répondre aux questions de leurs sous-sessions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti alle sessioni di rispondere alle domande delle loro sottosessioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションがサブセッションの質問に答えることを許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យវគ្គឆ្លើយសំណួររបស់វគ្គរងរបស់វា"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 하위 세션의 질문에 답하도록 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La økter svare på spørsmålene fra underøktene sine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwalaj sesjom odpowiadać na pytania swoich podsesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que sessões respondam às perguntas de suas subsessões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить сеансам отвечать на вопросы своих вложенных сеансов"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เซสชันตอบคำถามของเซสชันย่อยของตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumların alt oturumlarının sorularını yanıtlamasına izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити сеансам відповідати на запитання своїх вкладених сеансів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép phiên trả lời câu hỏi của các phiên con"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许会话回答其子会话的问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許工作階段回答其子工作階段的問題"
          }
        }
      }
    },
    "settings.agents.subsessions.answerQuestions.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an agent in a sub-session asks a question, the session that started it can answer, and the answer shows who gave it. Permission requests always wait for you. Off: only you answer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يطرح وكيل في جلسة فرعية سؤالًا، يمكن للجلسة التي بدأتها أن تجيب، وتُظهر الإجابة من قدّمها. طلبات الأذونات تنتظرك دائمًا. عند الإيقاف: أنت وحدك من يجيب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada agent u podsesiji postavi pitanje, sesija koja ju je pokrenula može odgovoriti, a odgovor pokazuje ko ga je dao. Zahtjevi za dozvole uvijek čekaju na vas. Isključeno: odgovarate samo vi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en agent i en undersession stiller et spørgsmål, kan den session, der startede den, svare, og svaret viser, hvem der gav det. Anmodninger om tilladelse venter altid på dig. Fra: kun du svarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt ein Agent in einer Untersitzung eine Frage, kann die Sitzung antworten, die sie gestartet hat, und die Antwort zeigt, von wem sie kommt. Berechtigungsanfragen warten immer auf dich. Aus: Nur du antwortest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un agente de una subsesión hace una pregunta, la sesión que la inició puede responder, y la respuesta muestra quién la dio. Las solicitudes de permiso siempre te esperan. Desactivado: solo respondes tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un agent d'une sous-session pose une question, la session qui l'a démarrée peut répondre, et la réponse indique qui l'a donnée. Les demandes d'autorisation vous attendent toujours. Désactivé : vous seul répondez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un agente in una sottosessione fa una domanda, la sessione che l'ha avviata può rispondere e la risposta mostra chi l'ha data. Le richieste di autorizzazione aspettano sempre te. Disattivato: rispondi solo tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブセッションのエージェントが質問すると、そのサブセッションを開始したセッションが答えられ、回答には誰が答えたかが表示されます。権限のリクエストは常にあなたを待ちます。オフ:あなただけが答えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលភ្នាក់ងារក្នុងវគ្គរងសួរសំណួរ វគ្គដែលបានចាប់ផ្ដើមវាអាចឆ្លើយបាន ហើយចម្លើយបង្ហាញថាអ្នកណាជាអ្នកឆ្លើយ។ សំណើសិទ្ធិតែងតែរង់ចាំអ្នក។ បិទ៖ មានតែអ្នកទេដែលឆ្លើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 세션의 에이전트가 질문하면 그 하위 세션을 시작한 세션이 답할 수 있고, 답변에는 누가 답했는지 표시됩니다. 권한 요청은 항상 사용자를 기다립니다. 끄면 사용자만 답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en agent i en underøkt stiller et spørsmål, kan økten som startet den svare, og svaret viser hvem som ga det. Tillatelsesforespørsler venter alltid på deg. Av: bare du svarer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy agent w podsesji zada pytanie, sesja, która ją uruchomiła, może odpowiedzieć, a odpowiedź pokazuje, kto jej udzielił. Prośby o uprawnienia zawsze czekają na ciebie. Wyłączone: odpowiadasz tylko ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um agente em uma subsessão faz uma pergunta, a sessão que a iniciou pode responder, e a resposta mostra quem a deu. Pedidos de permissão sempre esperam por você. Desativado: só você responde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда агент во вложенном сеансе задаёт вопрос, ответить может сеанс, который его запустил, и в ответе видно, кто его дал. Запросы разрешений всегда ждут вас. Выкл.: отвечаете только вы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเอเจนต์ในเซสชันย่อยถามคำถาม เซสชันที่เริ่มเซสชันย่อยนั้นตอบได้ และคำตอบจะแสดงว่าใครเป็นผู้ตอบ คำขอสิทธิ์จะรอคุณเสมอ ปิด: มีเพียงคุณที่ตอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alt oturumdaki ajan soru sorduğunda, onu başlatan oturum yanıtlayabilir ve yanıt kimin verdiğini gösterir. İzin istekleri her zaman sizi bekler. Kapalı: yalnızca siz yanıtlarsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли агент у вкладеному сеансі ставить запитання, відповісти може сеанс, що його запустив, і у відповіді видно, хто її дав. Запити дозволів завжди чекають на вас. Вимк.: відповідаєте лише ви."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tác tử trong phiên con đặt câu hỏi, phiên đã bắt đầu nó có thể trả lời và câu trả lời cho biết ai đã trả lời. Yêu cầu quyền luôn chờ bạn. Tắt: chỉ bạn trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子会话中的智能体提问时，启动它的会话可以回答，回答会显示是谁给出的。权限请求始终等待你处理。关闭：只有你回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子工作階段中的代理程式提問時，啟動它的工作階段可以回答，回答會顯示是誰給的。權限要求一律等你處理。關閉：只有你回答。"
          }
        }
      }
    },
