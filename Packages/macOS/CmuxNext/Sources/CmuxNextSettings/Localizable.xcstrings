        "ko": {"stringUnit": {"state": "needs_review", "value": "화면 공유 품질"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Skjermdelingskvalitet"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Jakość udostępniania ekranu"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Qualidade do compartilhamento de tela"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Качество демонстрации экрана"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "คุณภาพการแชร์หน้าจอ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ekran paylaşımı kalitesi"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Якість демонстрації екрана"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chất lượng chia sẻ màn hình"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "屏幕共享画质"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "螢幕共享畫質"}}
      }
    },
    "settings.remoteDesktop.quality.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The quality a new Screen Sharing session starts at. The session's toolbar can still change it."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "الجودة التي تبدأ بها جلسة مشاركة الشاشة الجديدة. يمكن لشريط أدوات الجلسة تغييرها."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Kvalitet s kojim počinje nova sesija dijeljenja ekrana. Traka s alatima sesije ga i dalje može promijeniti."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Den kvalitet, en ny skærmdelingssession starter med. Sessionens værktøjslinje kan stadig ændre den."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Qualität, mit der eine neue Bildschirmfreigabe beginnt. Die Symbolleiste der Sitzung kann sie weiterhin ändern."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La calidad con la que empieza una nueva sesión de pantalla compartida. La barra de herramientas de la sesión aún puede cambiarla."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La qualité de départ d’une nouvelle session de partage d’écran. La barre d’outils de la session peut toujours la modifier."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La qualità con cui inizia una nuova sessione di condivisione schermo. La barra degli strumenti della sessione può ancora cambiarla."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "新しい画面共有セッションの開始時の画質です。セッションのツールバーで変更することもできます。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គុណភាពដែលវគ្គចែករំលែកអេក្រង់ថ្មីចាប់ផ្តើម។ របារឧបករណ៍របស់វគ្គនៅតែអាចប្តូរវាបាន។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "새 화면 공유 세션이 시작될 때의 품질입니다. 세션 도구 막대에서 계속 변경할 수 있습니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kvaliteten en ny skjermdelingsøkt starter med. Øktens verktøylinje kan fortsatt endre den."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Jakość, z jaką zaczyna się nowa sesja udostępniania ekranu. Pasek narzędzi sesji nadal może ją zmienić."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A qualidade com que uma nova sessão de compartilhamento de tela começa. A barra de ferramentas da sessão ainda pode alterá-la."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Качество, с которым начинается новый сеанс демонстрации экрана. Панель инструментов сеанса всё равно может его изменить."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "คุณภาพที่เซสชันการแชร์หน้าจอใหม่เริ่มต้น แถบเครื่องมือของเซสชันยังเปลี่ยนได้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Yeni bir ekran paylaşımı oturumunun başladığı kalite. Oturumun araç çubuğu bunu yine de değiştirebilir."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Якість, з якою починається новий сеанс демонстрації екрана. Панель інструментів сеансу все одно може її змінити."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chất lượng khi một phiên chia sẻ màn hình mới bắt đầu. Thanh công cụ của phiên vẫn có thể thay đổi nó."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "新的屏幕共享会话开始时的画质。会话的工具栏仍可更改。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "新的螢幕共享工作階段開始時的畫質。工作階段的工具列仍可更改。"}}
      }
    },
