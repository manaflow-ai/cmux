    "settings.chats.root.home": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a harness data folder, not your home folder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلد بيانات أداة وكيل، وليس مجلدك الرئيسي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite fasciklu podataka alata za agente, a ne svoju početnu fasciklu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en datamappe for et agentværktøj, ikke din hjemmemappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Datenordner des Agentenwerkzeugs statt Ihres Benutzerordners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta de datos de la herramienta de agente, no tu carpeta de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de données d’outil d’agent, pas votre dossier personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella dati dello strumento agente, non la cartella Inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダではなく、エージェントツールのデータフォルダを選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសថតទិន្នន័យឧបករណ៍ភ្នាក់ងារ មិនមែនថតផ្ទះរបស់អ្នកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 폴더가 아닌 에이전트 도구의 데이터 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg agentverktøyets datamappe, ikke hjemmemappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder danych narzędzia agentowego, a nie folder domowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta de dados da ferramenta de agente, não sua pasta pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку данных инструмента агента, а не домашнюю папку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์ข้อมูลของเครื่องมือเอเจนต์ ไม่ใช่โฟลเดอร์โฮม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana klasörünüz yerine ajan aracının veri klasörünü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку даних інструмента агента, а не домашню папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục dữ liệu công cụ tác tử, không phải thư mục nhà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择代理工具的数据文件夹，而不是主文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇代理工具的資料夾，而非個人專屬資料夾。"
          }
        }
      }
    },
    "settings.chats.root.protected": {
