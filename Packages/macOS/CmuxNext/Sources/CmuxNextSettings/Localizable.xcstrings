    "settings.workspaceRow.lines.default": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "needs_review", "value": "مفاتيح العناصر" } },
        "bs": { "stringUnit": { "state": "needs_review", "value": "Prekidači stavki" } },
        "da": { "stringUnit": { "state": "needs_review", "value": "Elementkontakter" } },
        "de": { "stringUnit": { "state": "needs_review", "value": "Element-Schalter" } },
        "en": { "stringUnit": { "state": "translated", "value": "Item switches" } },
        "es": { "stringUnit": { "state": "needs_review", "value": "Interruptores de elementos" } },
        "fr": { "stringUnit": { "state": "needs_review", "value": "Interrupteurs des éléments" } },
        "it": { "stringUnit": { "state": "needs_review", "value": "Interruttori degli elementi" } },
        "ja": { "stringUnit": { "state": "translated", "value": "項目のスイッチ" } },
        "km": { "stringUnit": { "state": "needs_review", "value": "កុងតាក់ធាតុ" } },
        "ko": { "stringUnit": { "state": "needs_review", "value": "항목 스위치" } },
        "nb": { "stringUnit": { "state": "needs_review", "value": "Elementbrytere" } },
        "pl": { "stringUnit": { "state": "needs_review", "value": "Przełączniki elementów" } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Chaves dos itens" } },
        "ru": { "stringUnit": { "state": "needs_review", "value": "Переключатели элементов" } },
