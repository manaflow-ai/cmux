        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カラムの下にある細いバー。表示範囲を示し、移動できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របារស្តើងនៅក្រោមជួរឈរ ដែលបង្ហាញ និងផ្លាស់ទីផ្នែកដែលមើលឃើញ។"
