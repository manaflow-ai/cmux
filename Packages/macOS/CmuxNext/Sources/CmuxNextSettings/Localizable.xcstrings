    "settings.browser.passwords.generate.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers a generated password when a site asks for a new one, and saves it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقترح كلمة سر مولّدة عندما يطلب موقع كلمة سر جديدة، ويحفظها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nudi generisanu lozinku kada stranica traži novu i čuva je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foreslår en genereret adgangskode, når et websted beder om en ny, og gemmer den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bietet ein generiertes Passwort an, wenn eine Website ein neues verlangt, und speichert es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ofrece una contraseña generada cuando un sitio pide una nueva y la guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Propose un mot de passe généré quand un site en demande un nouveau, et l’enregistre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Propone una password generata quando un sito ne chiede una nuova e la salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイトが新しいパスワードを求めたときに生成したパスワードを提案し、保存します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ដល់ពាក្យសម្ងាត់ដែលបានបង្កើត ពេលគេហទំព័រសុំពាក្យសម្ងាត់ថ្មី ហើយរក្សាទុកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이트에서 새 비밀번호를 요구하면 생성된 비밀번호를 제안하고 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foreslår et generert passord når et nettsted ber om et nytt, og lagrer det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proponuje wygenerowane hasło, gdy witryna prosi o nowe, i je zapisuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oferece uma senha gerada quando um site pede uma nova e a salva."
          }
