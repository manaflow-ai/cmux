            "value": "Шрифт відповідей агента. Якщо задано, замінює шрифт чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phông chữ cho câu trả lời của tác tử. Khi được đặt, nó thay thế phông chữ trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
