    "settings.sidebar.showLocalMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark This Mac's Workspaces"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمييز مساحات عمل هذا الـ Mac"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi radne prostore ovog Maca"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker denne Macs arbejdsområder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereiche dieses Macs kennzeichnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar los espacios de trabajo de este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler les espaces de travail de ce Mac"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna gli spazi di lavoro di questo Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のワークスペースにも印を付ける"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សម្គាល់កន្លែងធ្វើការរបស់ Mac នេះ"
          }
        },
        "ko": {
