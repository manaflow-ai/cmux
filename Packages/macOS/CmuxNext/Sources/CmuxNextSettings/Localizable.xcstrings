    "settings.sidebar.pinnedBandsScroll.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: the top and bottom sections never scroll and the workspace list gets smaller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフ：上部と下部のセクションはスクロールせず、ワークスペース一覧が小さくなります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إيقاف: لا تتمرر الأقسام العلوية والسفلية وتصغر قائمة مساحات العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno: gornji i donji odjeljci se nikad ne pomiču, a lista radnih prostora se smanjuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra: de øverste og nederste sektioner ruller aldrig, og listen over arbejdsområder bliver mindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus: Obere und untere Abschnitte scrollen nie, die Arbeitsbereichsliste wird kleiner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado: las secciones superior e inferior nunca se desplazan y la lista de espacios de trabajo se reduce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé : les sections du haut et du bas ne défilent jamais et la liste des espaces de travail rétrécit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato: le sezioni in alto e in basso non scorrono mai e l'elenco delle aree di lavoro si riduce."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ៖ ផ្នែកខាងលើ និងខាងក្រោមមិនរមូរ ហើយបញ្ជីកន្លែងធ្វើការតូចជាងមុន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끔: 위쪽과 아래쪽 섹션은 스크롤되지 않고 작업 공간 목록이 작아집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av: øverste og nederste seksjoner ruller aldri, og listen over arbeidsområder blir mindre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączone: górne i dolne sekcje nigdy się nie przewijają, a lista przestrzeni roboczych się zmniejsza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desligado: as seções superior e inferior nunca rolam e a lista de áreas de trabalho diminui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выкл.: верхние и нижние разделы не прокручиваются, а список рабочих пространств уменьшается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิด: ส่วนด้านบนและด้านล่างไม่เลื่อน และรายการเวิร์กสเปซจะเล็กลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalı: üst ve alt bölümler hiç kaymaz, çalışma alanı listesi küçülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимк.: верхні й нижні розділи не прокручуються, а список робочих областей зменшується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt: các mục trên và dưới không cuộn, danh sách không gian làm việc nhỏ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭：顶部和底部分区从不滚动，工作区列表变小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉：頂部與底部區段永不捲動，工作區列表變小。"
          }
        }
      }
    },
