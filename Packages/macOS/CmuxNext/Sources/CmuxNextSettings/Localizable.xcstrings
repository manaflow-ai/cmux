    "settings.appearance.twoTone.help": {
      "comment": "Settings > Theme > Two-Tone: help",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The sidebar and tab bar in one tone, the panes in another. Works with every window style and theme."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "الشريط الجانبي وشريط الألسنة بلون، واللوحات بلون آخر. يعمل مع كل نمط نافذة وكل سمة."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Bočna traka i traka kartica u jednom tonu, okna u drugom. Radi sa svakim stilom prozora i temom."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Sidepanelet og fanebjælken i én tone, ruderne i en anden. Virker med alle vinduesstile og temaer."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Seitenleiste und Tableiste in einem Ton, die Bereiche in einem anderen. Funktioniert mit jedem Fensterstil und Theme."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La barra lateral y la barra de pestañas en un tono, los paneles en otro. Funciona con cualquier estilo de ventana y tema."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La barre latérale et la barre d'onglets dans un ton, les panneaux dans un autre. Fonctionne avec tous les styles de fenêtre et thèmes."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La barra laterale e la barra delle schede in un tono, i riquadri in un altro. Funziona con ogni stile di finestra e tema."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーとタブバーを一つのトーン、ペインを別のトーンにします。すべてのウインドウスタイルとテーマで使えます。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "របារចំហៀង និងរបារផ្ទាំងក្នុងពណ៌មួយ ផ្ទាំងក្នុងពណ៌មួយទៀត។ ដំណើរការជាមួយរចនាបថបង្អួច និងស្បែកទាំងអស់។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사이드바와 탭 막대는 한 가지 톤으로, 패널은 다른 톤으로 표시합니다. 모든 윈도우 스타일과 테마에서 작동합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Sidepanelet og fanelinjen i én tone, rutene i en annen. Fungerer med alle vindusstiler og temaer."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pasek boczny i pasek kart w jednym tonie, panele w innym. Działa z każdym stylem okna i motywem."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A barra lateral e a barra de abas em um tom, os painéis em outro. Funciona com qualquer estilo de janela e tema."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Боковая панель и панель вкладок в одном тоне, панели — в другом. Работает с любым стилем окна и темой."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แถบด้านข้างและแถบแท็บเป็นโทนหนึ่ง แผงเป็นอีกโทนหนึ่ง ใช้ได้กับทุกสไตล์หน้าต่างและธีม"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğu ve sekme çubuğu bir tonda, bölmeler başka bir tonda. Her pencere stili ve temayla çalışır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Бічна панель і панель вкладок в одному тоні, панелі — в іншому. Працює з будь-яким стилем вікна й темою."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Thanh bên và thanh thẻ một tông màu, các khung một tông khác. Dùng được với mọi kiểu cửa sổ và chủ đề."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "侧边栏和标签栏用一种色调，窗格用另一种。适用于所有窗口样式和主题。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "側邊欄和標籤列用一種色調，窗格用另一種。適用於所有視窗樣式和主題。"}}
      }
    },
    "settings.appearance.twoTone.summary": {
      "comment": "Settings > Theme > Two-Tone: one-line summary",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A second tone for the sidebar and tab bar"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لون ثانٍ للشريط الجانبي وشريط الألسنة"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Drugi ton za bočnu traku i traku kartica"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "En anden tone til sidepanelet og fanebjælken"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ein zweiter Ton für Seitenleiste und Tableiste"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Un segundo tono para la barra lateral y la barra de pestañas"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Un second ton pour la barre latérale et la barre d'onglets"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Un secondo tono per la barra laterale e la barra delle schede"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーとタブバーに別のトーン"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ពណ៌ទីពីរសម្រាប់របារចំហៀង និងរបារផ្ទាំង"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사이드바와 탭 막대용 두 번째 톤"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "En annen tone for sidepanelet og fanelinjen"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Drugi ton dla paska bocznego i paska kart"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Um segundo tom para a barra lateral e a barra de abas"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Второй тон для боковой панели и панели вкладок"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "โทนที่สองสำหรับแถบด้านข้างและแถบแท็บ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğu ve sekme çubuğu için ikinci bir ton"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Другий тон для бічної панелі й панелі вкладок"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tông màu thứ hai cho thanh bên và thanh thẻ"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "为侧边栏和标签栏使用第二种色调"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "為側邊欄和標籤列使用第二種色調"}}
      }
    },
