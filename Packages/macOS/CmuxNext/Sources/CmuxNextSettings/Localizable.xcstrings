          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den minste bredden de andre fanene får før linjen ruller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najmniejsza szerokość pozostałych kart, zanim pasek zacznie się przewijać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
