    "settings.customize.doctorNotice.summary": {
      "comment": "Settings > Personalization: summary of the Customization notices toggle",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Tell me when a file or layer changes my setup"}},
        "ar": {"stringUnit": {"state": "translated", "value": "أخبرني عندما يغيّر ملف أو طبقة إعداداتي"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Obavijesti me kada datoteka ili sloj promijeni moje postavke"}},
        "da": {"stringUnit": {"state": "translated", "value": "Fortæl mig, når en fil eller et lag ændrer min opsætning"}},
        "de": {"stringUnit": {"state": "translated", "value": "Mich informieren, wenn eine Datei oder Ebene meine Einrichtung ändert"}},
        "es": {"stringUnit": {"state": "translated", "value": "Avisarme cuando un archivo o una capa cambie mi configuración"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Me prévenir quand un fichier ou une couche modifie ma configuration"}},
        "it": {"stringUnit": {"state": "translated", "value": "Avvisami quando un file o un livello modifica la mia configurazione"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ファイルやレイヤーが設定を変えたときに知らせる"}},
        "km": {"stringUnit": {"state": "translated", "value": "ប្រាប់ខ្ញុំនៅពេលឯកសារ ឬស្រទាប់ផ្លាស់ប្ដូរការរៀបចំរបស់ខ្ញុំ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "파일이나 레이어가 내 설정을 바꾸면 알림"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Si fra når en fil eller et lag endrer oppsettet mitt"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Powiadamiaj, gdy plik lub warstwa zmienia moją konfigurację"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Avisar quando um arquivo ou camada mudar minha configuração"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сообщать, когда файл или слой меняет мою настройку"}},
        "th": {"stringUnit": {"state": "translated", "value": "แจ้งฉันเมื่อไฟล์หรือเลเยอร์เปลี่ยนการตั้งค่าของฉัน"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bir dosya veya katman düzenimi değiştirdiğinde bana haber ver"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Повідомляти, коли файл або шар змінює моє налаштування"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Báo cho tôi khi một tệp hoặc lớp thay đổi thiết lập của tôi"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "当文件或图层更改我的设置时通知我"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "當檔案或圖層變更我的設定時通知我"}}
      }
    },
    "settings.appearance.liquidGlass": {
      "comment": "Settings > Appearance toggle: whether the composer, menus, popovers and cards draw liquid glass (blur and a lit rim).",
