    "settings.history.commandRetentionDays.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each machine deletes recorded commands that are older."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحذف كل جهاز الأوامر المسجلة الأقدم من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka mašina briše snimljene komande koje su starije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver maskine sletter registrerede kommandoer, der er ældre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder Rechner löscht aufgezeichnete Befehle, die älter sind."
