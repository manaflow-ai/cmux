    "settings.app.quitBehavior.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals run in cmux-tui and keep running after cmux quits unless you end them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعمل الطرفيات في cmux-tui وتستمر في العمل بعد إنهاء cmux ما لم تُنهِها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminali rade u cmux-tui i nastavljaju raditi nakon izlaska iz cmux ako ih ne završite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaler kører i cmux-tui og fortsætter efter cmux afsluttes, medmindre du afslutter dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminals laufen in cmux-tui und laufen nach dem Beenden von cmux weiter, sofern du sie nicht beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los terminales se ejecutan en cmux-tui y siguen en marcha al salir de cmux, salvo que los finalices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les terminaux s'exécutent dans cmux-tui et continuent après la fermeture de cmux, sauf si vous les terminez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I terminali girano in cmux-tui e continuano dopo l'uscita da cmux, a meno che tu non li termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルは cmux-tui で動作し、終了しない限り cmux を終了しても動き続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទែមីណាល់ដំណើរការក្នុង cmux-tui ហើយបន្តដំណើរការបន្ទាប់ពី cmux ចាកចេញ លុះត្រាតែអ្នកបញ្ចប់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널은 cmux-tui에서 실행되며, 끝내지 않으면 cmux를 종료한 뒤에도 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaler kjører i cmux-tui og fortsetter etter at cmux avsluttes, med mindre du avslutter dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminale działają w cmux-tui i działają dalej po zamknięciu cmux, chyba że je zamkniesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os terminais rodam no cmux-tui e continuam após sair do cmux, a menos que você os encerre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Терминалы работают в cmux-tui и продолжают работать после выхода из cmux, если их не завершить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัลทำงานใน cmux-tui และทำงานต่อหลังจากออกจาก cmux เว้นแต่คุณจะจบมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaller cmux-tui içinde çalışır ve siz sonlandırmadıkça cmux kapandıktan sonra da çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Термінали працюють у cmux-tui і працюють далі після виходу з cmux, якщо їх не завершити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các terminal chạy trong cmux-tui và tiếp tục chạy sau khi thoát cmux trừ khi bạn kết thúc chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "终端在 cmux-tui 中运行，除非你结束它们，否则退出 cmux 后仍会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終端機在 cmux-tui 中執行，除非你終止它們，否則結束 cmux 後仍會繼續執行。"
          }
        }
      }
    },
    "settings.app.hideDockIconWithoutWindows": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء أيقونة Dock عند عدم وجود نوافذ مفتوحة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrij ikonu u Docku kada nema otvorenih prozora"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul Dock-symbol, når ingen vinduer er åbne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Symbol ausblenden, wenn keine Fenster geöffnet sind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Dock Icon When No Windows Are Open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el icono del Dock cuando no haya ventanas abiertas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’icône du Dock quand aucune fenêtre n’est ouverte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi l’icona nel Dock quando non ci sono finestre aperte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが開いていないときは Dock アイコンを隠す"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លាក់រូបតំណាង Dock នៅពេលគ្មានវីនដូបើក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 윈도우가 없을 때 Dock 아이콘 숨기기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul Dock-symbolet når ingen vinduer er åpne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj ikonę w Docku, gdy żadne okno nie jest otwarte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar ícone do Dock quando não houver janelas abertas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать значок в Dock, когда нет открытых окон"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนไอคอนใน Dock เมื่อไม่มีหน้าต่างเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık pencere yokken Dock simgesini gizle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ховати значок у Dock, коли немає відкритих вікон"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn biểu tượng Dock khi không có cửa sổ nào mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开的窗口时隐藏程序坞图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開啟的視窗時隱藏 Dock 圖像"
          }
        }
      }
    },
    "settings.app.hideDockIconWithoutWindows.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل cmux العمل في شريط القائمة، خارج Dock ومبدّل التطبيقات، حتى تُفتح نافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nastavlja raditi u traci menija, izvan Docka i prebacivača aplikacija, dok se ne otvori prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kører videre i menulinjen, uden for Dock og appskifteren, indtil et vindue åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux läuft in der Menüleiste weiter, außerhalb von Dock und App-Umschalter, bis sich ein Fenster öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux keeps running in the menu bar, out of the Dock and the app switcher, until a window opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux sigue ejecutándose en la barra de menús, fuera del Dock y del selector de apps, hasta que se abra una ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux continue de tourner dans la barre des menus, hors du Dock et du sélecteur d’apps, jusqu’à l’ouverture d’une fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux resta attivo nella barra dei menu, fuori dal Dock e dal selettore di app, finché non si apre una finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウが開くまで、cmux は Dock とアプリスイッチャーに表示されず、メニューバーで動作し続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux បន្តដំណើរការនៅក្នុងរបារម៉ឺនុយ ក្រៅ Dock និងកម្មវិធីប្ដូរកម្មវិធី រហូតដល់មានវីនដូបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 열릴 때까지 cmux는 Dock과 앱 전환기에 표시되지 않고 메뉴 막대에서 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux fortsetter å kjøre i menylinjen, utenfor Dock og appveksleren, til et vindu åpnes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux działa dalej na pasku menu, poza Dockiem i przełącznikiem aplikacji, dopóki nie otworzy się okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux continua em execução na barra de menus, fora do Dock e do alternador de apps, até que uma janela seja aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux продолжает работать в строке меню, вне Dock и переключателя приложений, пока не откроется окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ยังทำงานต่อในแถบเมนู โดยไม่อยู่ใน Dock และตัวสลับแอป จนกว่าจะมีหน้าต่างเปิดขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux, bir pencere açılana kadar Dock ve uygulama değiştiricinin dışında, menü çubuğunda çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux і далі працює в рядку меню, поза Dock і перемикачем програм, доки не відкриється вікно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux tiếp tục chạy trên thanh menu, không có trong Dock và trình chuyển ứng dụng, cho đến khi một cửa sổ mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打开窗口之前，cmux 会在菜单栏中继续运行，不显示在程序坞和应用切换器中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開啟視窗之前，cmux 會在選單列中繼續執行，不顯示在 Dock 和 App 切換器中。"
          }
        }
      }
    },
