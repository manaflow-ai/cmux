    "settings.sidebar.groupHeader.unreadCount.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A collapsed group shows how many unread notifications its workspaces have. Off, it shows only its loading spinner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض المجموعة المطوية عدد الإشعارات غير المقروءة في مساحات عملها. عند الإيقاف، تعرض مؤشر التحميل فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skupljena grupa prikazuje koliko nepročitanih obavještenja imaju njeni radni prostori. Isključeno: prikazuje samo indikator učitavanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sammenklappet gruppe viser, hvor mange ulæste notifikationer dens arbejdsområder har. Fra: Den viser kun sin indlæsningsindikator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine eingeklappte Gruppe zeigt, wie viele ungelesene Mitteilungen ihre Arbeitsbereiche haben. Aus: Sie zeigt nur ihren Ladeindikator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un grupo contraído muestra cuántas notificaciones sin leer tienen sus espacios de trabajo. Desactivado, solo muestra su indicador de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un groupe replié affiche le nombre de notifications non lues de ses espaces de travail. Désactivé, il n’affiche que son indicateur de chargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un gruppo compresso mostra quante notifiche non lette hanno i suoi spazi di lavoro. Disattivato, mostra solo l’indicatore di caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "折りたたんだグループに、ワークスペースの未読通知の数を表示します。オフの場合は読み込み中のスピナーのみを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្រុមដែលបានបង្រួមបង្ហាញចំនួនការជូនដំណឹងមិនទាន់អានរបស់កន្លែងធ្វើការ។ ពេលបិទ វាបង្ហាញតែសញ្ញាកំពុងផ្ទុកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "접힌 그룹은 워크스페이스의 읽지 않은 알림 수를 표시합니다. 끄면 로딩 표시기만 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sammenslått gruppe viser hvor mange uleste varsler arbeidsområdene har. Av: Den viser bare innlastingsindikatoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwinięta grupa pokazuje, ile nieprzeczytanych powiadomień mają jej obszary robocze. Wyłączone: pokazuje tylko wskaźnik ładowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um grupo recolhido mostra quantas notificações não lidas seus espaços de trabalho têm. Desativado, mostra apenas o indicador de carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Свёрнутая группа показывает число непрочитанных уведомлений её рабочих пространств. Если выключено, показывается только индикатор загрузки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กลุ่มที่ยุบอยู่จะแสดงจำนวนการแจ้งเตือนที่ยังไม่อ่านของพื้นที่ทำงาน เมื่อปิด จะแสดงเฉพาะตัวบอกการโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daraltılmış bir grup, çalışma alanlarındaki okunmamış bildirim sayısını gösterir. Kapalıyken yalnızca yükleme göstergesini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Згорнута група показує кількість непрочитаних сповіщень її робочих просторів. Якщо вимкнено, показується лише індикатор завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhóm thu gọn hiện số thông báo chưa đọc của các không gian làm việc. Khi tắt, chỉ hiện biểu tượng đang tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "折叠的分组显示其工作区的未读通知数。关闭时只显示加载指示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "收合的群組會顯示其工作區的未讀通知數。關閉時只顯示載入指示器。"
          }
        }
      }
    },
