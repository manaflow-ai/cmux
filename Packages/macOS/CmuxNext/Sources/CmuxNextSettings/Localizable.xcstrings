    "settings.sidebar.steppingWraps.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بعد العنصر الأخير، يكون العنصر التالي هو الأول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nakon posljednje stavke, sljedeća je ponovo prva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Efter det sidste element er det næste igen det første."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach dem letzten Eintrag folgt wieder der erste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past the last item, the next item is the first again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Después del último elemento, el siguiente vuelve a ser el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Après le dernier élément, le suivant est de nouveau le premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopo l’ultimo elemento, il successivo è di nuovo il primo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最後の項目の次は、再び最初の項目になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្រោយធាតុចុងក្រោយ ធាតុបន្ទាប់គឺជាធាតុដំបូងម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "마지막 항목 다음은 다시 첫 항목입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etter det siste elementet er det neste igjen det første."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po ostatnim elemencie następny jest znowu pierwszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois do último item, o próximo volta a ser o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "После последнего элемента следующим снова будет первый."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หลังจากรายการสุดท้าย รายการถัดไปจะเป็นรายการแรกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son öğeden sonra sonraki öğe yine ilk öğedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Після останнього елемента наступним знову буде перший."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sau mục cuối cùng, mục tiếp theo lại là mục đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在最后一项之后，下一项又是第一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在最後一項之後，下一項又是第一項。"
          }
        }
      }
    },
    "settings.navigation.historySteps": {
