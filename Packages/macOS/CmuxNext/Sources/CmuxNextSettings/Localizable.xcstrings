    "settings.sidebar.showChats.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في صفحة علامة التبويب الجديدة، يعرض نمطا Threads وConsole كل محادثات وكلاء البرمجة على هذا الكمبيوتر، الأحدث أولًا. عند إيقافه، يعرضان المحادثات الأخيرة فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stranici nove kartice stilovi Threads i Console prikazuju svaki razgovor s agentom za kodiranje na ovom računaru, najnovije prvo. Kad je isključeno, prikazuju samo nedavne razgovore."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På siden Ny fane viser stilene Threads og Console alle chats med kodeagenter på denne computer, nyeste først. Når den er slået fra, vises kun de seneste chats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Seite „Neuer Tab“ listen die Stile Threads und Console jeden Chat von Coding-Agenten auf diesem Computer auf, die neuesten zuerst. Aus zeigen sie nur die letzten Chats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the New Tab page, the Threads and Console styles list every coding agent chat on this computer, newest first. Off, they show the recent chats only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la página Nueva pestaña, los estilos Threads y Console muestran todos los chats de agentes de código de este ordenador, primero los más recientes. Desactivado, muestran solo los chats recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la page Nouvel onglet, les styles Threads et Console listent tous les chats d’agents de code de cet ordinateur, du plus récent au plus ancien. Désactivé, ils n’affichent que les chats récents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella pagina Nuova scheda, gli stili Threads e Console elencano tutte le chat degli agenti di programmazione su questo computer, dalla più recente. Se disattivato, mostrano solo le chat recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブページの Threads と Console スタイルで、このコンピュータのすべてのコーディングエージェントのチャットを新しい順に一覧表示します。オフにすると最近のチャットだけを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅលើទំព័រផ្ទាំងថ្មី រចនាប័ទ្ម Threads និង Console បង្ហាញការជជែកភ្នាក់ងារសរសេរកូដទាំងអស់នៅលើកុំព្យូទ័រនេះ ថ្មីបំផុតមុន។ ពេលបិទ វាបង្ហាញតែការជជែកថ្មីៗប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 탭 페이지에서 Threads 및 Console 스타일은 이 컴퓨터의 모든 코딩 에이전트 채팅을 최신순으로 나열합니다. 끄면 최근 채팅만 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På siden Ny fane viser stilene Threads og Console alle chatter med kodeagenter på denne datamaskinen, nyeste først. Når den er av, vises bare de siste chattene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stronie nowej karty style Threads i Console wyświetlają wszystkie czaty agentów programistycznych na tym komputerze, od najnowszych. Po wyłączeniu pokazują tylko ostatnie czaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na página Nova aba, os estilos Threads e Console listam todos os chats de agentes de código deste computador, do mais recente ao mais antigo. Desativado, mostram apenas os chats recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На странице новой вкладки стили Threads и Console показывают все чаты агентов программирования на этом компьютере, сначала новые. Если выключено, показываются только недавние чаты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในหน้าแท็บใหม่ รูปแบบ Threads และ Console จะแสดงแชทของเอเจนต์เขียนโค้ดทั้งหมดในคอมพิวเตอร์เครื่องนี้ โดยเรียงจากใหม่สุด เมื่อปิด จะแสดงเฉพาะแชทล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Sekme sayfasında Threads ve Console stilleri bu bilgisayardaki tüm kodlama ajanı sohbetlerini en yeniden başlayarak listeler. Kapalıyken yalnızca son sohbetleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На сторінці нової вкладки стилі Threads і Console показують усі чати агентів програмування на цьому комп’ютері, спочатку нові. Якщо вимкнено, показуються лише нещодавні чати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên trang Thẻ mới, kiểu Threads và Console liệt kê mọi cuộc trò chuyện với tác nhân lập trình trên máy tính này, mới nhất trước. Khi tắt, chỉ hiện các cuộc trò chuyện gần đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新标签页上，Threads 和 Console 样式会列出这台电脑上所有编程代理的聊天，最新的在前。关闭后只显示最近的聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新分頁上，Threads 和 Console 樣式會列出這台電腦上所有程式設計代理的聊天，最新的在前。關閉後只顯示最近的聊天。"
          }
        }
      }
    },
