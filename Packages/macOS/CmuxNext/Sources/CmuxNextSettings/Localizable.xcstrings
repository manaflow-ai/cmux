        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que tu teléfono inicie espacios de trabajo nuevos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser votre téléphone à créer des espaces de travail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti al telefono di avviare nuovi spazi di lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンから新しいワークスペースを開始できるようにする"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតឱ្យទូរសព្ទរបស់អ្នកចាប់ផ្ដើមកន្លែងធ្វើការថ្មី"
          }
