    "settings.tabs.newTabWidgets.projects.help": {
      "comment": "Settings: help for the toggle that shows the projects card on the New Tab page.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطاقة لهذا الـ Mac ومشاريعه الأخيرة فوق مربع الكتابة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica ovog Maca i njegovih nedavnih projekata iznad polja za pisanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kort med denne Mac og dens seneste projekter over skrivefeltet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte mit diesem Mac und seinen letzten Projekten über dem Eingabefeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card of this Mac and its recent projects over the composer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta con este Mac y sus proyectos recientes sobre el compositor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte de ce Mac et de ses projets récents au-dessus du champ de saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda con questo Mac e i suoi progetti recenti sopra il compositore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄の上に、この Mac と最近のプロジェクトのカードを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កាត​របស់ Mac នេះ និង​គម្រោង​ថ្មីៗ​របស់​វា​នៅ​ពី​លើ​ប្រអប់​សរសេរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력창 위에 이 Mac과 최근 프로젝트 카드를 보여 줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
