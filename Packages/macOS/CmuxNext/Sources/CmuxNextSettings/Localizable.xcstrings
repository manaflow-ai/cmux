    "settings.home.chiefEngine.help": {
      "comment": "Help of the Engine row (home.chiefEngine). Chief is a product name, keep it untranslated; Home is the app's Home page.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أي Chief تفتحه الصفحة الرئيسية. يستخدم الوضع التلقائي Chief جهاز Mac هذا أثناء تشغيله هنا، وإلا فـ Chief المستضاف في السحابة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koji Chief otvara početna. Automatski koristi Chief ovog Maca dok radi ovdje, inače hostovani Chief u oblaku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvilken Chief Hjem åbner. Auto bruger denne Macs Chief, mens den kører her, ellers den hostede Chief i skyen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Welchen Chief Start öffnet. Automatisch nutzt den Chief dieses Macs, solange er hier läuft, sonst den gehosteten Chief in der Cloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which Chief Home opens. Auto uses this Mac's Chief while it runs here, else the Hosted Chief in the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qué Chief abre Inicio. Automático usa el Chief de este Mac mientras se ejecuta aquí; si no, el Chief alojado en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Chief qu'ouvre Accueil. Automatique utilise le Chief de ce Mac tant qu'il s'y exécute, sinon le Chief hébergé dans le cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quale Chief apre Home. Automatico usa il Chief di questo Mac mentre è in esecuzione qui, altrimenti il Chief ospitato nel cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホームで開く Chief。自動では、この Mac の Chief が動作中ならそれを、そうでなければクラウドのホスト型 Chief を使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ដែលទំព័រដើមបើក។ ស្វ័យប្រវត្តិប្រើ Chief របស់ Mac នេះពេលវាកំពុងដំណើរការនៅទីនេះ បើមិនដូច្នោះទេប្រើ Chief ដែលបង្ហោះក្នុងពពក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "홈에서 여는 Chief입니다. 자동은 이 Mac의 Chief가 여기서 실행 중이면 그것을, 아니면 클라우드의 호스팅 Chief를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvilken Chief Hjem åpner. Automatisk bruker denne Mac-ens Chief mens den kjører her, ellers den driftede Chief i skyen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Który Chief otwiera Start. Tryb automatyczny używa Chiefa tego Maca, gdy tu działa, a w przeciwnym razie hostowanego Chiefa w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qual Chief o Início abre. Automático usa o Chief deste Mac enquanto ele roda aqui; caso contrário, o Chief hospedado na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Какой Chief открывает главная. Автоматический режим использует Chief этого Mac, пока он здесь работает, иначе размещённый Chief в облаке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ที่หน้าแรกเปิด อัตโนมัติจะใช้ Chief ของ Mac เครื่องนี้ขณะที่ทำงานอยู่ที่นี่ หากไม่ใช่จะใช้ Chief ที่โฮสต์บนคลาวด์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ana Sayfa'nın açtığı Chief. Otomatik, burada çalışırken bu Mac'in Chief'ini, aksi halde buluttaki barındırılan Chief'i kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Який Chief відкриває головна. Автоматичний режим використовує Chief цього Mac, поки він тут працює, інакше розміщений Chief у хмарі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief mà Trang chủ mở. Tự động dùng Chief của máy Mac này khi nó đang chạy ở đây, nếu không thì dùng Chief được lưu trữ trên đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "主页打开哪个 Chief。自动：这台 Mac 的 Chief 在此运行时使用它，否则使用云端托管的 Chief。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "首頁開啟哪個 Chief。自動：這台 Mac 的 Chief 在此執行時使用它，否則使用雲端託管的 Chief。"
          }
        }
      }
    },
