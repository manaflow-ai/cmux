{
  "sourceLanguage": "en",
  "strings": {
    "settings.agentPane.followUpMode": {
      "comment": "Settings > Agent Chat: title of the row that picks what Return does with a message sent while the agent is working (steer it into the running turn or queue it for after)",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Follow-Up Messages"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "رسائل المتابعة"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Naknadne poruke"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Opfølgende beskeder"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Folgenachrichten"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Mensajes de seguimiento"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Messages de suivi"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Messaggi di follow-up"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "フォローアップメッセージ"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "សារតាមដាន"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "후속 메시지"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Oppfølgingsmeldinger"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Wiadomości uzupełniające"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mensagens de acompanhamento"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Дополнительные сообщения"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ข้อความติดตามผล"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Takip mesajları"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Додаткові повідомлення"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tin nhắn tiếp theo"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "后续消息"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "後續訊息"}}
      }
    },
    "settings.agentPane.followUpMode.help": {
      "comment": "Settings > Agent Chat > Follow-Up Messages: what the row does. Command-Return is the Command key with Return.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "What Return does with a message sent while the agent is working. Command-Return does the other."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "ما يفعله مفتاح Return برسالة تُرسل أثناء عمل الوكيل. ويفعل Command-Return الخيار الآخر."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Šta Return radi s porukom poslanom dok agent radi. Command-Return radi suprotno."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Hvad Return gør med en besked, der sendes, mens agenten arbejder. Command-Return gør det modsatte."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Was Return mit einer Nachricht macht, die gesendet wird, während der Agent arbeitet. Command-Return macht das andere."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Qué hace Return con un mensaje enviado mientras el agente trabaja. Command-Return hace lo otro."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Ce que fait Retour d’un message envoyé pendant que l’agent travaille. Commande-Retour fait l’autre."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Cosa fa Invio con un messaggio inviato mentre l’agente lavora. Comando-Invio fa l’altro."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "エージェントの作業中に送ったメッセージを Return でどう扱うか。Command-Return はもう一方の動作になります。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "អ្វីដែល Return ធ្វើជាមួយសារដែលផ្ញើពេលភ្នាក់ងារកំពុងធ្វើការ។ Command-Return ធ្វើមួយទៀត។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 작업 중일 때 보낸 메시지를 Return이 어떻게 처리할지 정합니다. Command-Return은 다른 쪽으로 동작합니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Hva Return gjør med en melding som sendes mens agenten jobber. Command-Return gjør det motsatte."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Co robi Return z wiadomością wysłaną, gdy agent pracuje. Command-Return robi to drugie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O que Return faz com uma mensagem enviada enquanto o agente trabalha. Command-Return faz o outro."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Что делает Return с сообщением, отправленным во время работы агента. Command-Return делает другое."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "สิ่งที่ Return ทำกับข้อความที่ส่งขณะเอเจนต์กำลังทำงาน Command-Return จะทำอีกแบบ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajan çalışırken gönderilen bir mesajla Return'ün ne yaptığı. Command-Return diğerini yapar."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Що робить Return із повідомленням, надісланим під час роботи агента. Command-Return робить інше."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Return làm gì với tin nhắn gửi khi tác tử đang làm việc. Command-Return làm điều còn lại."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理工作时发送的消息按 Return 后如何处理。Command-Return 执行另一种。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理工作時傳送的訊息按 Return 後如何處理。Command-Return 執行另一種。"}}
      }
    },
    "settings.choice.followUpModeSteer": {
      "comment": "Settings > Agent Chat > Follow-Up Messages: choice that takes a message sent mid-turn into the running turn (the agent reads it when its current step ends)",
