    "settings.tabs.tabMinActiveWidth.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the strip is crowded, every tab shrinks evenly to this width, and the selected tab stays at least this wide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーが混み合うと、すべてのタブがこの幅まで均等に縮み、選択中のタブは少なくともこの幅を保ちます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عندما يزدحم الشريط، تتقلص كل علامات التبويب بالتساوي إلى هذا العرض، وتبقى علامة التبويب المحددة بهذا العرض على الأقل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kada je traka pretrpana, sve kartice se ravnomjerno sužavaju do ove širine, a odabrana kartica ostaje najmanje ovoliko široka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når bjælken er fuld, krymper alle faner ligeligt til denne bredde, og den valgte fane forbliver mindst så bred."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn die Leiste voll ist, schrumpfen alle Tabs gleichmäßig auf diese Breite, und der ausgewählte Tab bleibt mindestens so breit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando la barra está llena, todas las pestañas se reducen por igual hasta este ancho, y la pestaña seleccionada mantiene al menos este ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand la barre est pleine, tous les onglets rétrécissent de façon égale jusqu’à cette largeur, et l’onglet sélectionné garde au moins cette largeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando la barra è piena, tutte le schede si restringono in modo uniforme fino a questa larghezza e la scheda selezionata resta larga almeno così."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅពេលរបារពេញ ផ្ទាំងទាំងអស់រួមតូចស្មើៗគ្នាដល់ទទឹងនេះ ហើយផ្ទាំងដែលបានជ្រើសនៅតែមានទទឹងយ៉ាងហោចណាស់ប៉ុណ្ណេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 바가 꽉 차면 모든 탭이 이 너비까지 고르게 줄어들고, 선택한 탭은 최소 이 너비를 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når linjen er full, krymper alle faner jevnt til denne bredden, og den valgte fanen beholder minst denne bredden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy pasek jest pełny, wszystkie karty zwężają się równo do tej szerokości, a wybrana karta pozostaje co najmniej tak szeroka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando a barra está cheia, todas as abas encolhem por igual até esta largura, e a aba selecionada mantém pelo menos esta largura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когда панель заполнена, все вкладки равномерно сужаются до этой ширины, а выбранная вкладка остаётся не уже неё."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อแถบเต็ม แท็บทั้งหมดจะหดลงเท่ากันจนถึงความกว้างนี้ และแท็บที่เลือกจะกว้างอย่างน้อยเท่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şerit dolduğunda tüm sekmeler bu genişliğe kadar eşit olarak daralır ve seçili sekme en az bu genişlikte kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли панель заповнена, усі вкладки рівномірно звужуються до цієї ширини, а вибрана вкладка лишається не вужчою за неї."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi thanh đầy, mọi tab thu hẹp đều đến độ rộng này, và tab đang chọn luôn rộng ít nhất bằng chừng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "标签栏拥挤时，所有标签页均匀缩小到此宽度，所选标签页至少保持此宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分頁列擁擠時，所有分頁平均縮小到此寬度，所選分頁至少保持此寬度。"
          }
        }
      }
    },
