          "stringUnit": {
            "state": "needs_review",
            "value": "Espace laissé libre pour les boutons de fermeture, de réduction et de zoom de la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spazio lasciato libero per i pulsanti di chiusura, riduzione e zoom della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの閉じる、しまう、拡大ボタンのために空けておく余白です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចន្លោះទុកទំនេរសម្រាប់ប៊ូតុងបិទ បង្រួម និងពង្រីកបង្អួច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창의 닫기, 최소화, 확대 버튼을 위해 비워 두는 공간입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plass som holdes fri til vinduets lukk-, minimer- og zoomknapper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miejsce pozostawione dla przycisków zamykania, minimalizowania i powiększania okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espaço mantido livre para os botões de fechar, minimizar e ampliar da janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Место, оставленное для кнопок закрытия, сворачивания и масштабирования окна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ที่เว้นไว้สำหรับปุ่มปิด ย่อ และซูมของหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pencerenin kapat, küçült ve yakınlaştır düğmeleri için boş bırakılan alan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Місце, залишене для кнопок закриття, згортання та масштабування вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khoảng trống dành cho các nút đóng, thu nhỏ và phóng to của cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为窗口的关闭、最小化和缩放按钮留出的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "為視窗的關閉、縮到最小和縮放按鈕留出的空間。"
          }
        }
      }
    },
