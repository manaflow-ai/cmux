    "settings.appearance.theme.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors for terminals. A space, workspace or terminal theme overrides it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルの色です。スペース、ワークスペース、ターミナルのテーマが優先されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ألوان الطرفيات. تتجاوزها سمة المساحة أو مساحة العمل أو الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boje terminala. Tema prostora, radnog prostora ili terminala ima prednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farver til terminaler. Et tema for et rum, et arbejdsområde eller en terminal går forud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farben für Terminals. Ein Space-, Workspace- oder Terminal-Theme hat Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colores de los terminales. Un tema de espacio, área de trabajo o terminal lo reemplaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Couleurs des terminaux. Un thème d’espace, d’espace de travail ou de terminal le remplace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colori dei terminali. Un tema di spazio, area di lavoro o terminale lo sostituisce."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពណ៌សម្រាប់ទែមីណាល់។ ស្បែកលំហ កន្លែងធ្វើការ ឬទែមីណាល់ មានអាទិភាពជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널의 색상입니다. 스페이스, 워크스페이스 또는 터미널 테마가 우선합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farger for terminaler. Et tema for et rom, arbeidsområde eller en terminal går foran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolory terminali. Motyw przestrzeni, obszaru roboczego lub terminala ma pierwszeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cores dos terminais. Um tema de espaço, área de trabalho ou terminal o substitui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цвета терминалов. Тема пространства, рабочей области или терминала имеет приоритет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สีของเทอร์มินัล ธีมของสเปซ เวิร์กสเปซ หรือเทอร์มินัลจะมีผลก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminallerin renkleri. Alan, çalışma alanı veya terminal teması önceliklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кольори терміналів. Тема простору, робочої області чи термінала має пріоритет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màu cho terminal. Chủ đề của không gian, workspace hoặc terminal sẽ được ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "终端的颜色。空间、工作区或终端主题优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終端機的顏色。空間、工作區或終端機主題優先。"
          }
        }
      }
    },
