    "settings.agentPane.editedFiles.show.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "البطاقة التي تسرد الملفات المعدّلة في الدور، مع التراجع وعرض التغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartica s datotekama izmijenjenim u potezu, s Poništi i Prikaži promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kortet, der viser en turs redigerede filer, med Fortryd og Vis ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Karte mit den in einem Durchgang bearbeiteten Dateien, mit Rückgängig und Änderungen anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card that lists a turn's edited files, with Undo and View changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La tarjeta con los archivos editados en un turno, con Deshacer y Ver cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La carte qui liste les fichiers modifiés d’un tour, avec Annuler et Voir les modifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scheda con i file modificati in un turno, con Annulla e Mostra modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンで編集したファイルを一覧にするカード。元に戻すと変更を表示があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កាតដែលរាយឯកសារដែលបានកែក្នុងវេនមួយ ជាមួយ មិនធ្វើវិញ និង មើលការផ្លាស់ប្ដូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "턴에서 편집한 파일 목록 카드로, 실행 취소와 변경 사항 보기가 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kortet som viser filene som ble redigert i en runde, med Angre og Vis endringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karta z plikami edytowanymi w turze, z Cofnij i Pokaż zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cartão com os arquivos editados em um turno, com Desfazer e Ver alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Карточка со списком файлов, изменённых за ход, с кнопками «Отменить» и «Показать изменения»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การ์ดที่แสดงไฟล์ที่แก้ไขในรอบหนึ่ง พร้อมเลิกทำและดูการเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir turda düzenlenen dosyaları listeleyen kart; Geri Al ve Değişiklikleri Göster ile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Картка з файлами, зміненими за хід, з кнопками «Скасувати» та «Показати зміни»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ liệt kê các tệp đã chỉnh sửa trong một lượt, có Hoàn tác và Xem thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "列出一轮中所编辑文件的卡片，带有撤销和查看更改。"
