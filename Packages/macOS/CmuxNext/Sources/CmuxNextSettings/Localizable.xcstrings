    "settings.experiments.toastsV2.help": {
      "comment": "Settings > Experimental > Toasts v2 help: a notice with a spinner turns into its result, and closing a tab or workspace or archiving a chat offers Undo.",
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "إشعارات بمؤشر انتظار تتحول إلى نتيجتها في مكانها، وزر تراجع بعد إغلاق علامة تبويب أو مساحة عمل أو أرشفة محادثة."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Obavijesti s indikatorom učitavanja koje se na istom mjestu pretvaraju u svoj rezultat, i Poništi nakon zatvaranja kartice ili radnog prostora ili arhiviranja chata."}},
        "da": {"stringUnit": {"state": "translated", "value": "Meddelelser med en indlæsningsindikator, der bliver til deres resultat på stedet, og Fortryd efter at have lukket en fane eller et arbejdsområde eller arkiveret en chat."}},
        "de": {"stringUnit": {"state": "translated", "value": "Hinweise mit Ladeanzeige, die an derselben Stelle zu ihrem Ergebnis werden, und Widerrufen nach dem Schließen eines Tabs oder Arbeitsbereichs oder dem Archivieren eines Chats."}},
        "en": {"stringUnit": {"state": "translated", "value": "Spinner toasts that turn into their result in place, and an Undo after closing a tab or workspace or archiving a chat."}},
        "es": {"stringUnit": {"state": "translated", "value": "Avisos con indicador de carga que se convierten en su resultado en el mismo lugar, y Deshacer después de cerrar una pestaña o un espacio de trabajo o archivar un chat."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des notifications avec indicateur de chargement qui deviennent leur résultat sur place, et Annuler après la fermeture d’un onglet ou d’un espace de travail ou l’archivage d’une discussion."}},
        "it": {"stringUnit": {"state": "translated", "value": "Avvisi con indicatore di caricamento che diventano il loro risultato sul posto, e Annulla dopo aver chiuso una scheda o uno spazio di lavoro o archiviato una chat."}},
        "ja": {"stringUnit": {"state": "translated", "value": "スピナー付きのトーストがその場で結果に変わり、タブやワークスペースを閉じたりチャットをアーカイブしたりした後に「取り消す」が表示されます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ការជូនដំណឹងដែលមានសញ្ញាកំពុងដំណើរការ ប្ដូរទៅជាលទ្ធផលរបស់វានៅកន្លែងដដែល ហើយមាន មិនធ្វើវិញ បន្ទាប់ពីបិទផ្ទាំង ឬកន្លែងធ្វើការ ឬទុកការជជែកក្នុងបណ្ណសារ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "스피너가 있는 토스트가 그 자리에서 결과로 바뀌고, 탭이나 워크스페이스를 닫거나 채팅을 보관한 뒤에는 실행 취소가 표시됩니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Varsler med lasteindikator som blir til resultatet sitt på stedet, og Angre etter at du lukker en fane eller et arbeidsområde eller arkiverer en chat."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Powiadomienia ze wskaźnikiem ładowania, które w tym samym miejscu zmieniają się w swój wynik, oraz Cofnij po zamknięciu karty lub obszaru roboczego albo zarchiwizowaniu czatu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Avisos com indicador de carregamento que viram o próprio resultado no mesmo lugar, e Desfazer depois de fechar uma aba ou um espaço de trabalho ou arquivar um chat."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Уведомления с индикатором загрузки, которые на месте превращаются в результат, и «Отменить» после закрытия вкладки или рабочего пространства или архивации чата."}},
        "th": {"stringUnit": {"state": "translated", "value": "การแจ้งเตือนที่มีตัวหมุนจะเปลี่ยนเป็นผลลัพธ์ในที่เดิม และมี เลิกทำ หลังจากปิดแท็บหรือพื้นที่ทำงาน หรือเก็บแชทถาวร"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yükleme göstergeli bildirimler yerinde sonuçlarına dönüşür; bir sekmeyi veya çalışma alanını kapattıktan ya da bir sohbeti arşivledikten sonra Geri Al görünür."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Сповіщення з індикатором завантаження, які на місці перетворюються на результат, і «Скасувати» після закриття вкладки чи робочого простору або архівування чату."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Thông báo có biểu tượng đang tải sẽ biến thành kết quả ngay tại chỗ, và có Hoàn tác sau khi đóng một tab hoặc không gian làm việc hay lưu trữ một cuộc trò chuyện."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "带加载指示的提示条会在原处变成结果；关闭标签页或工作区、归档聊天后会出现“撤销”。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "帶載入指示的提示條會在原處變成結果；關閉分頁或工作區、封存聊天後會出現「還原」。"}}
      }
    },
    "settings.experiments.composerButtonsVisible": {
      "comment": "Settings > Advanced > Experiments: the Always Show Composer Buttons taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Always Show Composer Buttons"}},
        "ar": {"stringUnit": {"state": "translated", "value": "إظهار أزرار مُنشئ الرسائل دائمًا"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Uvijek prikaži dugmad sastavljača poruka"}},
        "da": {"stringUnit": {"state": "translated", "value": "Vis altid skrivefeltsknapper"}},
        "de": {"stringUnit": {"state": "translated", "value": "Composer-Schaltflächen immer anzeigen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mostrar siempre los botones del compositor"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Toujours afficher les boutons du compositeur"}},
        "it": {"stringUnit": {"state": "translated", "value": "Mostra sempre i pulsanti del compositore"}},
        "ja": {"stringUnit": {"state": "translated", "value": "コンポーザーのボタンを常に表示"}},
        "km": {"stringUnit": {"state": "translated", "value": "បង្ហាញប៊ូតុងអ្នកសរសេរសារជានិច្ច"}},
        "ko": {"stringUnit": {"state": "translated", "value": "작성기 버튼 항상 표시"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Vis alltid knapper i skrivefeltet"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zawsze pokazuj przyciski kompozytora"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sempre mostrar os botões do compositor"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Всегда показывать кнопки редактора"}},
        "th": {"stringUnit": {"state": "translated", "value": "แสดงปุ่มตัวเขียนข้อความเสมอ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Oluşturucu düğmelerini her zaman göster"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Завжди показувати кнопки редактора"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Luôn hiển thị các nút trình soạn thảo"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "始终显示编辑器按钮"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "永遠顯示編輯器按鈕"}}
      }
    },
    "settings.experiments.composerButtonsVisible.help": {
      "comment": "Settings > Advanced > Experiments: the Always Show Composer Buttons taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Keep Send, attachment removal, and queued message actions visible in agent chats."}},
        "ar": {"stringUnit": {"state": "translated", "value": "أبقِ الإرسال وإزالة المرفقات وإجراءات الرسائل في قائمة الانتظار ظاهرة في محادثات الوكلاء."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Zadrži slanje, uklanjanje priloga i radnje za poruke u redu vidljivima u razgovorima s agentima."}},
        "da": {"stringUnit": {"state": "translated", "value": "Hold Send, fjernelse af vedhæftede filer og handlinger for køede beskeder synlige i agentchats."}},
        "de": {"stringUnit": {"state": "translated", "value": "Senden, das Entfernen von Anhängen und Aktionen für wartende Nachrichten in Agent-Chats sichtbar halten."}},
        "es": {"stringUnit": {"state": "translated", "value": "Mantén visibles Enviar, quitar adjuntos y las acciones de mensajes en cola en los chats de agentes."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gardez visibles l’envoi, la suppression des pièces jointes et les actions des messages en file dans les chats d’agents."}},
        "it": {"stringUnit": {"state": "translated", "value": "Mantieni visibili l’invio, la rimozione degli allegati e le azioni dei messaggi in coda nelle chat degli agenti."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントチャットで、送信、添付ファイルの削除、キュー内メッセージの操作を常に表示します。"}},
        "km": {"stringUnit": {"state": "translated", "value": "រក្សាការផ្ញើ ការលុបឯកសារភ្ជាប់ និងសកម្មភាពសារដែលនៅក្នុងជួររង់ចាំឱ្យមើលឃើញក្នុងការជជែកជាមួយភ្នាក់ងារ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트 채팅에서 보내기, 첨부 파일 제거 및 대기 중인 메시지 작업을 항상 표시합니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Hold Send, fjerning av vedlegg og handlinger for meldinger i kø synlige i agentchatter."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zachowaj widoczność wysyłania, usuwania załączników i działań dotyczących wiadomości w kolejce na czatach agentów."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mantenha visíveis o envio, a remoção de anexos e as ações de mensagens na fila nos chats de agentes."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Показывать отправку, удаление вложений и действия с сообщениями в очереди в чатах агентов."}},
        "th": {"stringUnit": {"state": "translated", "value": "แสดงการส่ง การลบไฟล์แนบ และการดำเนินการกับข้อความในคิวในแชตของเอเจนต์เสมอ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajan sohbetlerinde Gönder, ek kaldırma ve sıradaki mesaj işlemlerini görünür tut."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Залишайте видимими надсилання, видалення вкладень і дії з повідомленнями в черзі в чатах агентів."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Giữ hiển thị nút Gửi, xóa tệp đính kèm và thao tác với tin nhắn đang chờ trong các cuộc trò chuyện với tác nhân."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在代理聊天中始终显示发送、移除附件和队列消息操作。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在代理聊天中永遠顯示傳送、移除附件和佇列訊息操作。"}}
      }
    },
    "settings.experiments.hoverLook": {
      "comment": "Settings > Experiments: the Tooltip Refresh taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Tooltip Refresh"}},
        "ar": {"stringUnit": {"state": "translated", "value": "تحديث التلميحات"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Osvježeni opisi alata"}},
        "da": {"stringUnit": {"state": "translated", "value": "Fornyede værktøjstip"}},
        "de": {"stringUnit": {"state": "translated", "value": "Neue Tooltips"}},
        "es": {"stringUnit": {"state": "translated", "value": "Información sobre herramientas renovada"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Info-bulles repensées"}},
        "it": {"stringUnit": {"state": "translated", "value": "Tooltip rinnovati"}},
        "ja": {"stringUnit": {"state": "translated", "value": "新しいツールチップ"}},
        "km": {"stringUnit": {"state": "translated", "value": "ព័ត៌មានជំនួយថ្មី"}},
        "ko": {"stringUnit": {"state": "translated", "value": "새 도구 설명"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Fornyede verktøytips"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Odświeżone podpowiedzi"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dicas renovadas"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Обновлённые подсказки"}},
        "th": {"stringUnit": {"state": "translated", "value": "คำแนะนำเครื่องมือแบบใหม่"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yenilenen ipuçları"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Оновлені підказки"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chú giải công cụ mới"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "新版工具提示"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "新版工具提示"}}
      }
    },
    "settings.experiments.hoverLook.help": {
      "comment": "Settings > Experiments: the Tooltip Refresh taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Tooltips and hover cards get a crisper glass, a sharper edge and a softer shadow."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تحصل التلميحات وبطاقات التمرير على زجاج أوضح وحافة أحدّ وظل أنعم."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Opisi alata i kartice pri prelasku dobijaju jasnije staklo, oštriju ivicu i mekšu sjenu."}},
        "da": {"stringUnit": {"state": "translated", "value": "Værktøjstip og svævekort får et klarere glas, en skarpere kant og en blødere skygge."}},
        "de": {"stringUnit": {"state": "translated", "value": "Tooltips und Hover-Karten erhalten klareres Glas, eine schärfere Kante und einen weicheren Schatten."}},
        "es": {"stringUnit": {"state": "translated", "value": "La información sobre herramientas y las tarjetas flotantes tienen un cristal más nítido, un borde más definido y una sombra más suave."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les info-bulles et les cartes de survol ont un verre plus net, un bord plus précis et une ombre plus douce."}},
        "it": {"stringUnit": {"state": "translated", "value": "I tooltip e le schede al passaggio del mouse hanno un vetro più nitido, un bordo più definito e un'ombra più morbida."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ツールチップとホバーカードのガラスがより鮮明になり、縁がくっきりし、影がやわらかくなります。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ព័ត៌មានជំនួយ និងកាតពេលដាក់ព្រួញលើ មានកញ្ចក់ច្បាស់ជាង គែមមុតជាង និងស្រមោលទន់ជាង។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "도구 설명과 호버 카드의 유리가 더 선명해지고 테두리가 또렷해지며 그림자가 부드러워집니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Verktøytips og svevekort får klarere glass, en skarpere kant og en mykere skygge."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Podpowiedzi i karty po najechaniu mają wyraźniejsze szkło, ostrzejszą krawędź i łagodniejszy cień."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Dicas e cartões flutuantes ganham um vidro mais nítido, uma borda mais definida e uma sombra mais suave."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Подсказки и всплывающие карточки получают более чёткое стекло, резкий край и мягкую тень."}},
        "th": {"stringUnit": {"state": "translated", "value": "คำแนะนำเครื่องมือและการ์ดเมื่อชี้เมาส์จะมีกระจกที่คมชัดขึ้น ขอบที่ชัดขึ้น และเงาที่นุ่มขึ้น"}},
        "tr": {"stringUnit": {"state": "translated", "value": "İpuçları ve üzerine gelme kartları daha net bir cam, daha keskin bir kenar ve daha yumuşak bir gölge alır."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Підказки та спливні картки отримують чіткіше скло, різкіший край і м'якшу тінь."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chú giải công cụ và thẻ khi di chuột có kính rõ hơn, viền sắc hơn và bóng mềm hơn."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "工具提示和悬停卡片的玻璃更清晰，边缘更锐利，阴影更柔和。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "工具提示和懸停卡片的玻璃更清晰，邊緣更銳利，陰影更柔和。"}}
      }
    },
    "settings.experiments.seeThroughDock": {
      "comment": "Settings > Experiments: the See-Through Dock taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "See-Through Dock"}},
        "ar": {"stringUnit": {"state": "translated", "value": "شريط سفلي شفاف"}},
