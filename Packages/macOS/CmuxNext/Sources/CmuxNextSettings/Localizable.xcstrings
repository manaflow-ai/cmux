        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зі «Зменшенням руху»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Giảm chuyển động"
          }
        },
