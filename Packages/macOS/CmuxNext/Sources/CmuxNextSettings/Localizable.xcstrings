        "km": {"stringUnit": {"state": "translated", "value": "រង់ចាំការផ្លាស់ប្ដូរ (បត់បែន)"}},
        "ko": {"stringUnit": {"state": "translated", "value": "변화를 기다림(적응형)"}},
