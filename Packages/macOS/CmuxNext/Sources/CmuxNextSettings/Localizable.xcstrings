    "settings.editor.stickyScroll.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lines that open the scopes around the top line stay at the top while you scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール中、先頭行を囲むスコープの開始行を上部に固定します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى الأسطر التي تفتح النطاقات حول السطر العلوي في الأعلى أثناء التمرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redovi koji otvaraju opsege oko gornjeg reda ostaju na vrhu dok pomičete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linjerne, der åbner omfangene omkring den øverste linje, bliver øverst, mens du ruller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Zeilen, die die Bereiche um die oberste Zeile öffnen, bleiben beim Scrollen oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las líneas que abren los ámbitos alrededor de la línea superior se quedan arriba al desplazarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les lignes qui ouvrent les portées autour de la première ligne restent en haut pendant le défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le righe che aprono gli ambiti intorno alla prima riga restano in alto durante lo scorrimento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ទាត់ដែលបើកវិសាលភាពជុំវិញបន្ទាត់កំពូល នៅជាប់ខាងលើពេលអ្នករំកិល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스크롤하는 동안 맨 위 줄을 둘러싼 범위의 시작 줄이 위에 고정됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linjene som åpner områdene rundt øverste linje blir værende øverst mens du ruller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiersze otwierające zakresy wokół górnego wiersza zostają na górze podczas przewijania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As linhas que abrem os escopos ao redor da linha superior ficam no topo durante a rolagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строки, открывающие области вокруг верхней строки, остаются наверху при прокрутке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บรรทัดที่เปิดขอบเขตรอบบรรทัดบนสุดจะตรึงอยู่ด้านบนขณะเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaydırırken en üst satırı saran kapsamları açan satırlar üstte kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рядки, що відкривають області навколо верхнього рядка, лишаються вгорі під час прокручування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các dòng mở phạm vi quanh dòng trên cùng được giữ ở trên khi cuộn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "滚动时，包围顶部行的作用域的起始行固定在顶部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "捲動時，包住頂端行的範圍起始行會固定在頂端。"
          }
        }
      }
    },
