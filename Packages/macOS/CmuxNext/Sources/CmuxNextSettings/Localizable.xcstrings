    "settings.feed.github.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your gh login to read notifications and review requests on this Mac. Sign in with gh auth login first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet deine gh-Anmeldung, um Benachrichtigungen und Review-Anfragen auf diesem Mac zu lesen. Melde dich zuerst mit gh auth login an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise ta connexion gh pour lire les notifications et demandes de revue sur ce Mac. Connecte-toi d’abord avec gh auth login."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تسجيل دخول gh لقراءة الإشعارات وطلبات المراجعة على هذا الـ Mac. سجّل الدخول أولاً باستخدام gh auth login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu inicio de sesión de gh para leer notificaciones y solicitudes de revisión en este Mac. Inicia sesión primero con gh auth login."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 gh 登入來讀取此 Mac 上的通知和審查要求。請先使用 gh auth login 登入。"
          }
        },
