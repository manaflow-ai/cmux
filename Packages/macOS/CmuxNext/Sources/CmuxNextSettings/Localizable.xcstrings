    "settings.appearance.experimentalControls.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies Hue and Saturation to the window's tint. Off, they have no effect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet Farbton und Sättigung auf die Tönung des Fensters an. Wenn aus, haben sie keine Wirkung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique la teinte et la saturation à la coloration de la fenêtre. Désactivé, elles n’ont aucun effet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطبّق درجة اللون والتشبع على صبغة النافذة. عند إيقافه لا يكون لهما أي تأثير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica el tono y la saturación al tinte de la ventana. Desactivado, no tienen efecto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將色相與飽和度套用到視窗的色調。關閉時，它們沒有作用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将色相和饱和度应用到窗口的色调。关闭时，它们不起作用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색조와 채도를 창의 틴트에 적용합니다. 끄면 아무 효과가 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色相と彩度をウインドウの色合いに適用します。オフのときは効果がありません。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjenjuje nijansu i zasićenost na ton prozora. Kada je isključeno, nemaju učinka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvender nuance og mætning på vinduets toning. Når den er slået fra, har de ingen virkning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica tonalità e saturazione alla tinta della finestra. Se disattivato, non hanno effetto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុវត្ត Hue និង Saturation ទៅលើពណ៌លាំរបស់បង្អួច។ ពេលបិទ វាគ្មានឥទ្ធិពលទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker fargetone og metning på vinduets fargetoning. Når den er av, har de ingen virkning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosuje odcień i nasycenie do zabarwienia okna. Gdy wyłączone, nie mają żadnego efektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica matiz e saturação à tonalidade da janela. Desativado, eles não têm efeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяет оттенок и насыщенность к тонированию окна. Когда выключено, они не действуют."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ฮิวและความอิ่มตัวของสีกับโทนสีของหน้าต่าง เมื่อปิด ค่าเหล่านี้จะไม่มีผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton ve doygunluğu pencerenin renk tonuna uygular. Kapalıyken etkileri olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовує відтінок і насиченість до тонування вікна. Коли вимкнено, вони не діють."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng Sắc độ và Độ bão hòa cho tông màu của cửa sổ. Khi tắt, chúng không có tác dụng."
          }
        }
      }
    },
