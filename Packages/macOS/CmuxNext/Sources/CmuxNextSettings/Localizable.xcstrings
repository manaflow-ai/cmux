    "settings.agentPane.display.width.help": {
      "comment": "Settings: the agent chat's and Markdown viewer's display rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widest the chat's column gets. On a wider pane the chat stays centered."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى عرض لعمود الدردشة. في جزء أعرض تبقى الدردشة في المنتصف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najveća širina kolone razgovora. U širem panelu razgovor ostaje centriran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den største bredde chattens kolonne får. I en bredere rude forbliver chatten centreret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größte Breite der Chat-Spalte. In einem breiteren Bereich bleibt der Chat zentriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancho máximo de la columna del chat. En un panel más ancho, el chat queda centrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La largeur maximale de la colonne du chat. Dans un panneau plus large, le chat reste centré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La larghezza massima della colonna della chat. In un riquadro più largo la chat resta centrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット列の最大幅。ペインがこれより広いと、チャットは中央に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទទឹងធំបំផុតនៃជួរឈរជជែក។ នៅលើផ្ទាំងធំជាងនេះ ការជជែកនៅកណ្តាល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 열의 최대 너비입니다. 창이 더 넓으면 채팅이 가운데에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den største bredden chattekolonnen får. I en bredere rute holdes chatten midtstilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największa szerokość kolumny czatu. W szerszym panelu czat pozostaje wyśrodkowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A largura máxima da coluna do chat. Em um painel mais largo, o chat fica centralizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшая ширина колонки чата. На более широкой панели чат остаётся по центру."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความกว้างสูงสุดของคอลัมน์แชท ในบานที่กว้างกว่า แชทจะอยู่ตรงกลาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet sütununun en fazla genişliği. Daha geniş bir bölmede sohbet ortada kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найбільша ширина колонки чату. На ширшій панелі чат залишається по центру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ rộng tối đa của cột trò chuyện. Trên khung rộng hơn, trò chuyện được căn giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天栏的最大宽度。窗格更宽时，聊天保持居中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天欄的最大寬度。窗格更寬時，聊天保持置中。"
          }
        }
      }
    },
