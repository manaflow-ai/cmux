    "settings.chats.roots.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add absolute paths to harness data folders. Protected folders are refused. Your organization can add locked folders."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مسارات مطلقة لمجلدات بيانات أدوات الوكلاء. تُرفض المجلدات المحمية. يمكن لمؤسستك إضافة مجلدات مقفلة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte apsolutne putanje do fascikli podataka alata za agente. Zaštićene fascikle se odbijaju. Organizacija može dodati zaključane fascikle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj absolutte stier til agentværktøjers datamapper. Beskyttede mapper afvises. Din organisation kan tilføje låste mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolute Pfade zu Datenordnern von Agentenwerkzeugen hinzufügen. Geschützte Ordner werden abgelehnt. Ihre Organisation kann gesperrte Ordner hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade rutas absolutas a carpetas de datos de herramientas de agentes. Se rechazan las carpetas protegidas. Tu organización puede añadir carpetas bloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des chemins absolus vers les dossiers de données des outils d’agent. Les dossiers protégés sont refusés. Votre organisation peut ajouter des dossiers verrouillés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi percorsi assoluti alle cartelle dati degli strumenti agente. Le cartelle protette vengono rifiutate. La tua organizzazione può aggiungere cartelle bloccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントツールのデータフォルダを絶対パスで追加します。保護されたフォルダは拒否されます。組織は削除できないフォルダを追加できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែមផ្លូវពេញទៅថតទិន្នន័យឧបករណ៍ភ្នាក់ងារ។ ថតដែលការពារត្រូវបានបដិសេធ។ អង្គការអាចបន្ថែមថតដែលចាក់សោ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 도구 데이터 폴더의 절대 경로를 추가합니다. 보호된 폴더는 거부됩니다. 조직에서 잠긴 폴더를 추가할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til absolutte stier til agentverktøyenes datamapper. Beskyttede mapper avvises. Organisasjonen kan legge til låste mapper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj ścieżki bezwzględne do folderów danych narzędzi agentowych. Chronione foldery są odrzucane. Organizacja może dodać zablokowane foldery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione caminhos absolutos para pastas de dados de ferramentas de agentes. Pastas protegidas são recusadas. Sua organização pode adicionar pastas bloqueadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте абсолютные пути к папкам данных инструментов агентов. Защищённые папки не допускаются. Организация может добавлять заблокированные папки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเส้นทางแบบเต็มไปยังโฟลเดอร์ข้อมูลของเครื่องมือเอเจนต์ โฟลเดอร์ที่ได้รับการป้องกันจะถูกปฏิเสธ องค์กรของคุณสามารถเพิ่มโฟลเดอร์ที่ล็อกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan araçlarının veri klasörlerine mutlak yollar ekleyin. Korumalı klasörler reddedilir. Kuruluşunuz kilitli klasörler ekleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте абсолютні шляхи до папок даних інструментів агентів. Захищені папки не допускаються. Організація може додавати заблоковані папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm đường dẫn tuyệt đối đến thư mục dữ liệu công cụ tác tử. Thư mục được bảo vệ sẽ bị từ chối. Tổ chức có thể thêm thư mục bị khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加代理工具数据文件夹的绝对路径。受保护的文件夹会被拒绝。组织可以添加锁定的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增代理工具資料夾的絕對路徑。受保護的資料夾會被拒絕。組織可以新增鎖定的資料夾。"
          }
        }
      }
    },
