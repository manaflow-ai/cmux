        "ar": {"stringUnit": {"state": "needs_review", "value": "اتباع الفاتح والداكن أو الشمس"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Prati svijetlo i tamno ili sunce"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Følg lys og mørk eller solen"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Hell und Dunkel oder der Sonne folgen"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Seguir claro y oscuro, o el sol"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Suivre clair et sombre, ou le soleil"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Segui chiaro e scuro, o il sole"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "ライトとダーク、または太陽に合わせる"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "តាមភ្លឺ និងងងឹត ឬព្រះអាទិត្យ"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "라이트와 다크 또는 해를 따르기"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Følg lys og mørk, eller solen"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podążaj za jasnym i ciemnym lub słońcem"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Seguir claro e escuro, ou o sol"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Следовать светлому и тёмному или солнцу"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ตามสว่างและมืด หรือดวงอาทิตย์"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Açık ve koyuyu ya da güneşi izle"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Стежити за світлим і темним або сонцем"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Theo sáng và tối, hoặc mặt trời"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "跟随浅色和深色，或太阳"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "跟隨淺色和深色，或太陽"}}
      }
    },
    "settings.appearance.backgroundLocation": {
      "comment": "Settings row title: where sunrise and sunset are computed for.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Sun Location"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "موقع الشمس"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Lokacija za sunce"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Sted for solen"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ort für die Sonne"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ubicación para el sol"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Lieu pour le soleil"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Posizione per il sole"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "太陽の位置の基準地"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ទីតាំងសម្រាប់ព្រះអាទិត្យ"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "해 위치 기준"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Sted for solen"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Lokalizacja dla słońca"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Local para o sol"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Местоположение для солнца"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ตำแหน่งสำหรับดวงอาทิตย์"}},
