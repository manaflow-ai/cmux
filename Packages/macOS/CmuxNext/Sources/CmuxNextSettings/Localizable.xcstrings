    "settings.notifications.sounds.cooldown.help": {
      "comment": "Settings > Notifications > Sounds > Burst Cooldown: help text",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تصدر الإشعارات الكثيرة في وقت واحد صوتًا واحدًا. يصدر الوكيل الذي يطلب إدخالًا صوتًا دائمًا. القيمة 0 توقف ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mnogo obavještenja odjednom oglasi se jednom. Agent koji traži unos se i dalje oglašava. 0 isključuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mange notifikationer på én gang lyder én gang. En agent, der beder om input, lyder stadig. 0 slår det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viele Mitteilungen auf einmal ertönen einmal. Ein Agent, der eine Eingabe braucht, ertönt trotzdem. 0 schaltet es aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many notifications at once sound once. An agent asking for input still sounds. 0 turns it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muchas notificaciones a la vez suenan una vez. Un agente que pide una respuesta sigue sonando. 0 lo desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plusieurs notifications simultanées sonnent une seule fois. Un agent qui attend une réponse sonne quand même. 0 désactive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Molte notifiche insieme suonano una volta. Un agente che chiede input suona comunque. 0 lo disattiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同時に届いた多数の通知は1回だけ鳴ります。入力を求めるエージェントは常に鳴ります。0 でオフになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជូនដំណឹងច្រើនក្នុងពេលតែមួយបន្លឺសំឡេងតែម្ដង។ ភ្នាក់ងារដែលសុំការបញ្ចូលនៅតែបន្លឺសំឡេង។ 0 បិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동시에 온 여러 알림은 한 번만 울립니다. 입력을 요청하는 에이전트는 계속 울립니다. 0이면 끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mange varsler samtidig lyder én gang. En agent som ber om svar lyder fortsatt. 0 slår det av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiele powiadomień naraz odtwarza dźwięk raz. Agent proszący o odpowiedź nadal wydaje dźwięk. 0 wyłącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muitas notificações ao mesmo tempo tocam uma vez. Um agente pedindo resposta ainda toca. 0 desativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Много уведомлений сразу звучат один раз. Агент, которому нужен ответ, всё равно звучит. 0 отключает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแจ้งเตือนหลายรายการพร้อมกันจะดังครั้งเดียว เอเจนต์ที่ขอคำตอบยังคงดัง 0 คือปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aynı anda gelen çok sayıda bildirim bir kez ses çıkarır. Yanıt isteyen bir ajan yine ses çıkarır. 0 kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Багато сповіщень одночасно звучать один раз. Агент, якому потрібна відповідь, однаково звучить. 0 вимикає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhiều thông báo cùng lúc chỉ phát âm thanh một lần. Agent cần phản hồi vẫn phát âm thanh. 0 để tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同时到达的多条通知只响一次。请求输入的智能体仍会响。0 表示关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同時到達的多則通知只響一次。要求輸入的代理仍會響。0 表示關閉。"
          }
        }
      }
    },
