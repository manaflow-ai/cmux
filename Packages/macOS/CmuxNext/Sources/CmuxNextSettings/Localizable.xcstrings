    "settings.tabs.barOrder.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a browser pane with the tab bar and the address bar on the same edge: the tab bar above the address bar, or below it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブバーとアドレスバーが同じ端にあるブラウザのペインで、タブバーをアドレスバーの上に置くか、下に置くか。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في جزء متصفح يكون فيه شريط علامات التبويب وشريط العنوان على الحافة نفسها: شريط علامات التبويب فوق شريط العنوان أو تحته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U oknu preglednika s trakom kartica i adresnom trakom na istoj ivici: traka kartica iznad adresne trake ili ispod nje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I en browserrude med fanebjælken og adresselinjen i samme kant: fanebjælken over adresselinjen eller under den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In einem Browserbereich mit Tableiste und Adressleiste am selben Rand: die Tableiste über der Adressleiste oder darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En un panel de navegador con la barra de pestañas y la barra de direcciones en el mismo borde: la barra de pestañas sobre la barra de direcciones o debajo de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans une sous-fenêtre de navigateur avec la barre d’onglets et la barre d’adresse sur le même bord : la barre d’onglets au-dessus de la barre d’adresse ou en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In un riquadro del browser con la barra delle schede e la barra degli indirizzi sullo stesso bordo: la barra delle schede sopra la barra degli indirizzi o sotto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ក្នុងផ្ទាំងកម្មវិធីរុករកដែលរបារផ្ទាំង និងរបារអាសយដ្ឋាននៅគែមតែមួយ៖ របារផ្ទាំងនៅលើរបារអាសយដ្ឋាន ឬនៅក្រោមវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 막대와 주소 막대가 같은 가장자리에 있는 브라우저 패널에서 탭 막대를 주소 막대 위 또는 아래에 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I en nettleserrute med fanelinjen og adresselinjen på samme kant: fanelinjen over adresselinjen eller under den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W panelu przeglądarki z paskiem kart i paskiem adresu przy tej samej krawędzi: pasek kart nad paskiem adresu lub pod nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Em um painel de navegador com a barra de abas e a barra de endereço na mesma borda: a barra de abas acima da barra de endereço ou abaixo dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В панели браузера, где панель вкладок и адресная строка у одного края: панель вкладок над адресной строкой или под ней."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ในบานหน้าต่างเบราว์เซอร์ที่แถบแท็บและแถบที่อยู่อยู่ขอบเดียวกัน: แถบแท็บอยู่เหนือแถบที่อยู่ หรืออยู่ใต้แถบนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sekme çubuğu ile adres çubuğunun aynı kenarda olduğu bir tarayıcı bölmesinde: sekme çubuğu adres çubuğunun üstünde veya altında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У панелі браузера, де панель вкладок і адресний рядок біля одного краю: панель вкладок над адресним рядком або під ним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trong ngăn trình duyệt có thanh tab và thanh địa chỉ ở cùng một cạnh: thanh tab nằm trên thanh địa chỉ hoặc dưới nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在标签栏和地址栏位于同一边缘的浏览器窗格中，标签栏位于地址栏上方或下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在分頁列和網址列位於同一邊緣的瀏覽器窗格中，分頁列位於網址列上方或下方。"
          }
        }
      }
    },
