          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne underøkter per økt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarte podsesje na sesję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Subsessões abertas por sessão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытых вложенных сеансов на сеанс"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันย่อยที่เปิดอยู่ต่อเซสชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
