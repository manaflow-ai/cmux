    "settings.sidebar.showWorkspaceTabs.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists tabs beneath each workspace in the sidebar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーの各ワークスペースの下にタブを一覧表示します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد علامات التبويب أسفل كل مساحة عمل في الشريط الجانبي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navodi kartice ispod svakog radnog prostora na bočnoj traci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser faner under hvert arbejdsområde i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Tabs unter jedem Arbeitsbereich in der Seitenleiste auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las pestañas debajo de cada espacio de trabajo en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répertorie les onglets sous chaque espace de travail dans la barre latérale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le schede sotto ogni area di lavoro nella barra laterale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាយផ្ទាំងនៅក្រោមកន្លែងធ្វើការនីមួយៗក្នុងរបារចំហៀង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 각 작업 공간 아래에 탭을 나열합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister faner under hvert arbeidsområde i sidepanelet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla karty pod każdą przestrzenią roboczą na pasku bocznym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista as abas abaixo de cada área de trabalho na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает вкладки под каждым рабочим пространством на боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงแท็บใต้เวิร์กสเปซแต่ละรายการในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğunda her çalışma alanının altında sekmeleri listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує вкладки під кожною робочою областю на бічній панелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liệt kê các tab bên dưới mỗi không gian làm việc trong thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中列出每个工作区下的标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在側邊欄中列出每個工作區下的分頁。"
          }
        }
      }
    },
