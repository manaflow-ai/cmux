    "settings.palette.prefix.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed into an empty query, this character enters the scope. A prefix you assign moves from any other scope."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のクエリに入力すると、この文字でスコープに入ります。割り当てた接頭辞は他のスコープから移動します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند كتابته في استعلام فارغ، يدخل هذا الحرف إلى النطاق. البادئة التي تعيّنها تنتقل من أي نطاق آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upisan u prazan upit, ovaj znak ulazi u opseg. Prefiks koji dodijelite premješta se iz drugog opsega."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrevet i en tom søgning åbner tegnet området. Et præfiks, du tildeler, flyttes fra andre områder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In eine leere Suche getippt, öffnet dieses Zeichen den Bereich. Ein zugewiesenes Präfix wechselt von jedem anderen Bereich hierher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escrito en una búsqueda vacía, este carácter entra en el ámbito. Un prefijo que asignes se quita de cualquier otro ámbito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisi dans une recherche vide, ce caractère ouvre la portée. Un préfixe que vous attribuez quitte toute autre portée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digitato in una ricerca vuota, questo carattere entra nell’ambito. Un prefisso assegnato viene tolto agli altri ambiti."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅពេលវាយក្នុងសំណួរទទេ តួអក្សរនេះចូលទៅវិសាលភាព។ បុព្វបទដែលអ្នកកំណត់ផ្លាស់ចេញពីវិសាលភាពផ្សេង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "빈 검색어에 입력하면 이 문자로 범위에 들어갑니다. 지정한 접두사는 다른 범위에서 옮겨집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrevet i et tomt søk åpner tegnet omfanget. Et prefiks du tildeler, flyttes fra andre omfang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wpisany w puste zapytanie znak otwiera zakres. Przypisany prefiks zostaje usunięty z innych zakresów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digitado em uma busca vazia, este caractere entra no escopo. Um prefixo que você atribuir sai de qualquer outro escopo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введённый в пустой запрос, этот символ открывает область. Назначенный префикс снимается с других областей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อพิมพ์ในคำค้นที่ว่าง อักขระนี้จะเข้าสู่ขอบเขต คำนำหน้าที่คุณกำหนดจะย้ายออกจากขอบเขตอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boş bir aramaya yazıldığında bu karakter kapsama girer. Atadığınız önek diğer kapsamlardan kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Введений у порожній запит, цей символ відкриває область. Призначений префікс знімається з інших областей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi gõ vào truy vấn trống, ký tự này vào phạm vi. Tiền tố bạn gán sẽ chuyển khỏi phạm vi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在空查询中输入此字符即可进入该范围。您分配的前缀会从其他范围移走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在空查詢中輸入此字元即可進入該範圍。您指派的前綴會從其他範圍移走。"
          }
        }
      }
    },
