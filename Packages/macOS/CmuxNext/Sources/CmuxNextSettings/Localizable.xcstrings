    "settings.sidebar.priorityView.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرس أعلى الشريط الجانبي يعرض كل محادثة وكيل على كل جهاز: التي تنتظرك أولًا، ثم المنتهية والفاشلة والعاملة والخاملة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvono na vrhu bočne trake prikazuje svaki razgovor s agentom na svakom računaru: prvo one koji čekaju tebe, zatim završene, neuspjele, aktivne i neaktivne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En klokke øverst i sidepanelet viser alle agentchats på alle maskiner: først dem, der venter på dig, derefter færdige, mislykkede, aktive og inaktive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Glocke oben in der Seitenleiste zeigt jeden Agent-Chat auf jedem Gerät: zuerst die, die auf dich warten, dann fertige, fehlgeschlagene, arbeitende und inaktive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bell at the top of the sidebar shows every agent chat on every machine, the ones waiting on you first, then finished, failed, working and idle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una campana en la parte superior de la barra lateral muestra todos los chats de agentes en cada máquina: primero los que te esperan, luego los terminados, fallidos, en curso e inactivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une cloche en haut de la barre latérale affiche toutes les conversations d’agents sur chaque machine : d’abord celles qui vous attendent, puis terminées, en échec, en cours et inactives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una campanella in cima alla barra laterale mostra tutte le chat degli agenti su ogni macchina: prima quelle che ti aspettano, poi completate, non riuscite, in corso e inattive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバー上部のベルで、すべてのマシンのエージェントチャットを表示します。対応待ちを先頭に、完了、失敗、作業中、待機中の順に並びます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កណ្ដឹងនៅខាងលើរបារចំហៀងបង្ហាញការជជែកភ្នាក់ងារទាំងអស់នៅលើម៉ាស៊ីននីមួយៗ៖ ដែលរង់ចាំអ្នកមុនគេ បន្ទាប់មករួចរាល់ បរាជ័យ កំពុងដំណើរការ និងទំនេរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바 상단의 종 아이콘이 모든 기기의 에이전트 채팅을 보여 줍니다. 확인이 필요한 채팅이 먼저, 그다음 완료, 실패, 작업 중, 유휴 순입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En bjelle øverst i sidepanelet viser alle agentchatter på alle maskiner: først de som venter på deg, deretter ferdige, mislykkede, aktive og inaktive."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzwonek u góry paska bocznego pokazuje wszystkie czaty agentów na każdym komputerze: najpierw te, które czekają na ciebie, potem zakończone, nieudane, pracujące i bezczynne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sino no topo da barra lateral mostra todos os chats de agentes em cada máquina: primeiro os que esperam por você, depois os concluídos, com falha, em andamento e ociosos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колокольчик вверху боковой панели показывает все чаты агентов на всех компьютерах: сначала ждущие вас, затем завершённые, с ошибкой, работающие и простаивающие."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระดิ่งที่ด้านบนของแถบด้านข้างจะแสดงแชตเอเจนต์ทุกรายการในทุกเครื่อง โดยแสดงรายการที่รอคุณก่อน แล้วตามด้วยที่เสร็จแล้ว ล้มเหลว กำลังทำงาน และว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğunun üstündeki zil her makinedeki tüm ajan sohbetlerini gösterir: önce seni bekleyenler, sonra bitenler, başarısız olanlar, çalışanlar ve boştakiler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзвоник угорі бічної панелі показує всі чати агентів на кожному комп’ютері: спершу ті, що чекають на вас, потім завершені, з помилкою, активні та в простої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuông ở đầu thanh bên hiển thị mọi cuộc trò chuyện tác tử trên mọi máy: những cuộc đang chờ bạn trước, sau đó là đã xong, thất bại, đang làm và rảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏顶部的铃铛会显示每台机器上的所有代理聊天：先列出等你处理的，再列出已完成、失败、处理中和空闲的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側邊欄頂端的鈴鐺會顯示每台機器上的所有代理聊天：先列出等你處理的，再列出已完成、失敗、處理中和閒置的。"
          }
        }
      }
    },
    "settings.sidebar.priorityView.enabled.summary": {
