        "ko": { "stringUnit": { "state": "needs_review", "value": "종류별 행 레이아웃" } },
        "nb": { "stringUnit": { "state": "needs_review", "value": "Radoppsett etter type" } },
        "pl": { "stringUnit": { "state": "needs_review", "value": "Układ wiersza według rodzaju" } },
        "pt-BR": { "stringUnit": { "state": "needs_review", "value": "Layout da linha por tipo" } },
        "ru": { "stringUnit": { "state": "needs_review", "value": "Макет строки по типу" } },
        "th": { "stringUnit": { "state": "needs_review", "value": "เลย์เอาต์แถวตามชนิด" } },
