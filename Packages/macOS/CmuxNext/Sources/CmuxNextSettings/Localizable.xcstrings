            "value": "각 머신은 이보다 오래된 기록된 명령을 삭제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hver maskin sletter registrerte kommandoer som er eldre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każda maszyna usuwa starsze zapisane polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada máquina exclui os comandos registrados mais antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Каждая машина удаляет записанные команды старше этого срока."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แต่ละเครื่องจะลบคำสั่งที่บันทึกไว้ที่เก่ากว่านี้"
          }
        },
        "tr": {
