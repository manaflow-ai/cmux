        "uk": {"stringUnit": {"state": "needs_review", "value": "Розташування для сонця"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Vị trí tính mặt trời"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "太阳位置"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "太陽位置"}}
