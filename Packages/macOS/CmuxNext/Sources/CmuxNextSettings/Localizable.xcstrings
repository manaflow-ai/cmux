    "settings.tabs.barOrder.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the tab bar sits above or below the address bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブバーをアドレスバーの上に置くか、下に置くか。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل يكون شريط علامات التبويب فوق شريط العنوان أم تحته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da li je traka kartica iznad ili ispod adresne trake."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om fanebjælken sidder over eller under adresselinjen."
          }
        },
