    "settings.computerUse.cursorTag": {
      "comment": "Settings > Computer Use: when an agent cursor shows its tag (the agent's workspace name or a tag it set)",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agent Cursor Tag"}},
        "ar": {"stringUnit": {"state": "translated", "value": "وسم مؤشر الوكيل"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Oznaka kursora agenta"}},
        "da": {"stringUnit": {"state": "translated", "value": "Mærkat på agentmarkør"}},
        "de": {"stringUnit": {"state": "translated", "value": "Markierung am Agent-Cursor"}},
        "es": {"stringUnit": {"state": "translated", "value": "Etiqueta del cursor del agente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Étiquette du curseur de l’agent"}},
        "it": {"stringUnit": {"state": "translated", "value": "Etichetta del cursore dell’agente"}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントカーソルのタグ"}},
        "km": {"stringUnit": {"state": "translated", "value": "ស្លាកទស្សន៍ទ្រនិចភ្នាក់ងារ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트 커서 태그"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Etikett på agentmarkør"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Etykieta kursora agenta"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Etiqueta do cursor do agente"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Метка курсора агента"}},
        "th": {"stringUnit": {"state": "translated", "value": "ป้ายกำกับเคอร์เซอร์เอเจนต์"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajan imleci etiketi"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Мітка курсора агента"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Nhãn con trỏ tác nhân"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理光标标签"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "代理程式游標標籤"}}
      }
    },
    "settings.computerUse.cursorTag.help": {
      "comment": "Settings > Computer Use: help for the agent cursor tag row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Each agent cursor can carry a tag: the agent's workspace name, or a tag the agent sets. Show it when your pointer is over the cursor, always, or never."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يمكن أن يحمل كل مؤشر وكيل وسمًا: اسم مساحة عمل الوكيل، أو وسمًا يحدده الوكيل. اعرضه عندما يكون مؤشرك فوق المؤشر، أو دائمًا، أو أبدًا."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Svaki kursor agenta može imati oznaku: naziv radnog prostora agenta ili oznaku koju agent postavi. Prikaži je kada je vaš pokazivač iznad kursora, uvijek ili nikad."}},
        "da": {"stringUnit": {"state": "translated", "value": "Hver agentmarkør kan have en mærkat: agentens arbejdsområdenavn eller en mærkat, som agenten angiver. Vis den, når din markør er over agentmarkøren, altid eller aldrig."}},
        "de": {"stringUnit": {"state": "translated", "value": "Jeder Agent-Cursor kann eine Markierung tragen: den Namen des Arbeitsbereichs des Agenten oder eine Markierung, die der Agent setzt. Zeige sie, wenn dein Zeiger über dem Cursor ist, immer oder nie."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada cursor de agente puede llevar una etiqueta: el nombre del espacio de trabajo del agente o una etiqueta que el agente defina. Muéstrala cuando tu puntero esté sobre el cursor, siempre o nunca."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque curseur d’agent peut porter une étiquette : le nom de l’espace de travail de l’agent ou une étiquette que l’agent définit. Affichez-la quand votre pointeur survole le curseur, toujours ou jamais."}},
        "it": {"stringUnit": {"state": "translated", "value": "Ogni cursore dell’agente può avere un’etichetta: il nome dello spazio di lavoro dell’agente o un’etichetta impostata dall’agente. Mostrala quando il puntatore è sopra il cursore, sempre o mai."}},
        "ja": {"stringUnit": {"state": "translated", "value": "各エージェントカーソルにはタグを付けられます。エージェントのワークスペース名、またはエージェントが設定したタグです。ポインタがカーソル上にあるとき、常に、または表示しないを選べます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ទស្សន៍ទ្រនិចភ្នាក់ងារនីមួយៗអាចមានស្លាក៖ ឈ្មោះកន្លែងធ្វើការរបស់ភ្នាក់ងារ ឬស្លាកដែលភ្នាក់ងារកំណត់។ បង្ហាញវានៅពេលទស្សន៍ទ្រនិចរបស់អ្នកនៅលើវា ជានិច្ច ឬមិនដែល។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "각 에이전트 커서에는 태그를 붙일 수 있습니다. 에이전트의 작업 공간 이름이나 에이전트가 정한 태그입니다. 포인터가 커서 위에 있을 때, 항상 또는 표시 안 함 중에서 고르세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Hver agentmarkør kan ha et etikett: agentens arbeidsområdenavn eller et etikett agenten setter. Vis det når pekeren er over markøren, alltid eller aldri."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Każdy kursor agenta może mieć etykietę: nazwę obszaru roboczego agenta lub etykietę ustawioną przez agenta. Pokazuj ją, gdy wskaźnik jest nad kursorem, zawsze lub nigdy."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada cursor de agente pode ter uma etiqueta: o nome do espaço de trabalho do agente ou uma etiqueta definida pelo agente. Mostre-a quando o ponteiro estiver sobre o cursor, sempre ou nunca."}},
        "ru": {"stringUnit": {"state": "translated", "value": "У каждого курсора агента может быть метка: имя рабочей области агента или метка, заданная агентом. Показывайте её, когда указатель над курсором, всегда или никогда."}},
        "th": {"stringUnit": {"state": "translated", "value": "เคอร์เซอร์เอเจนต์แต่ละตัวมีป้ายกำกับได้: ชื่อพื้นที่ทำงานของเอเจนต์ หรือป้ายกำกับที่เอเจนต์ตั้ง แสดงเมื่อตัวชี้ของคุณอยู่เหนือเคอร์เซอร์ แสดงเสมอ หรือไม่แสดง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Her ajan imleci bir etiket taşıyabilir: ajanın çalışma alanı adı veya ajanın belirlediği bir etiket. İşaretçiniz imlecin üzerindeyken, her zaman veya hiçbir zaman gösterin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Кожен курсор агента може мати мітку: назву робочого простору агента або мітку, яку задає агент. Показуйте її, коли вказівник над курсором, завжди або ніколи."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Mỗi con trỏ tác nhân có thể mang một nhãn: tên không gian làm việc của tác nhân hoặc nhãn do tác nhân đặt. Hiển thị khi con trỏ của bạn ở trên nó, luôn luôn hoặc không bao giờ."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "每个代理光标都可以带一个标签：代理的工作区名称，或代理设置的标签。可在指针悬停在光标上时显示、始终显示或从不显示。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "每個代理程式游標都可以帶一個標籤：代理程式的工作區名稱，或代理程式設定的標籤。可在指標停在游標上時顯示、一律顯示或永不顯示。"}}
      }
    },
    "settings.computerUse.cursorTag.summary": {
      "comment": "Settings > Computer Use: summary of the agent cursor tag row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "When the agent cursor shows its tag"}},
        "ar": {"stringUnit": {"state": "translated", "value": "متى يعرض مؤشر الوكيل وسمه"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Kada kursor agenta prikazuje oznaku"}},
        "da": {"stringUnit": {"state": "translated", "value": "Hvornår agentmarkøren viser sin mærkat"}},
        "de": {"stringUnit": {"state": "translated", "value": "Wann der Agent-Cursor seine Markierung zeigt"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuándo muestra su etiqueta el cursor del agente"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Quand le curseur de l’agent affiche son étiquette"}},
        "it": {"stringUnit": {"state": "translated", "value": "Quando il cursore dell’agente mostra l’etichetta"}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントカーソルがタグを表示するタイミング"}},
        "km": {"stringUnit": {"state": "translated", "value": "ពេលទស្សន៍ទ្រនិចភ្នាក់ងារបង្ហាញស្លាក"}},
        "ko": {"stringUnit": {"state": "translated", "value": "에이전트 커서가 태그를 표시하는 시점"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Når agentmarkøren viser etiketten"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Kiedy kursor agenta pokazuje etykietę"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Quando o cursor do agente mostra a etiqueta"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Когда курсор агента показывает метку"}},
        "th": {"stringUnit": {"state": "translated", "value": "เวลาที่เคอร์เซอร์เอเจนต์แสดงป้ายกำกับ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ajan imlecinin etiketini ne zaman gösterdiği"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Коли курсор агента показує мітку"}},
