          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt „Bildschirmfreigabe“ und „Steuerung“ unter Einstellungen > Geräte, sobald dieser Mac beigetreten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Screen sharing and Control in Settings > Devices once this Mac joins."
          }
        },
        "es": {
