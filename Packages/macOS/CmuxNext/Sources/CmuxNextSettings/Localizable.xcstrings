    "settings.agents.promptCache.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One hour keeps replies after a pause cheap; its cache writes cost a little more."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ساعة واحدة تُبقي الردود بعد التوقف رخيصة، لكن كتابة الذاكرة المؤقتة تكلف أكثر قليلًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedan sat čini odgovore nakon pauze jeftinim; njegovi upisi u keš koštaju malo više."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En time holder svar efter en pause billige; cacheskrivninger koster lidt mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Stunde hält Antworten nach einer Pause günstig; ihre Cache-Schreibvorgänge kosten etwas mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una hora mantiene baratas las respuestas tras una pausa; sus escrituras en caché cuestan un poco más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une heure garde les réponses après une pause bon marché ; ses écritures en cache coûtent un peu plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un'ora mantiene economiche le risposte dopo una pausa; le sue scritture in cache costano un po' di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 時間にすると休憩後の返信も安く済みますが、キャッシュへの書き込みは少し高くなります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មួយម៉ោងធ្វើឱ្យការឆ្លើយតបក្រោយការផ្អាកមានតម្លៃថោក ប៉ុន្តែការសរសេរទៅឃ្លាំងសម្ងាត់ថ្លៃជាងបន្តិច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1시간이면 잠시 쉰 뒤의 답변도 저렴하지만, 캐시 쓰기 비용이 조금 더 듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En time holder svar etter en pause billige; skriving til hurtigbufferen koster litt mer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godzina sprawia, że odpowiedzi po przerwie są tanie; jej zapisy do pamięci podręcznej kosztują nieco więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma hora mantém as respostas após uma pausa baratas; as gravações em cache custam um pouco mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Час делает ответы после паузы дешёвыми; запись в кэш стоит немного дороже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หนึ่งชั่วโมงทำให้การตอบหลังพักยังถูกอยู่ แต่การเขียนแคชมีค่าใช้จ่ายสูงขึ้นเล็กน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir saat, aradan sonra gelen yanıtları ucuz tutar; önbelleğe yazmak biraz daha pahalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Година робить відповіді після паузи дешевими; запис у кеш коштує трохи більше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một giờ giúp các câu trả lời sau khi tạm dừng vẫn rẻ; việc ghi vào bộ nhớ đệm tốn hơn một chút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 小时可让暂停后的回复依然便宜，但写入缓存的费用稍高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 小時可讓暫停後的回覆依然便宜，但寫入快取的費用稍高。"
          }
        }
      }
    },
