    "settings.feed.mirrorAgents.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications from agents and cmux notify go to your cmux account's feed and can reach your iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントと cmux notify の通知が cmux アカウントのフィードに送られ、iPhone に届くことがあります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُرسل إشعارات الوكلاء و cmux notify إلى موجز حساب cmux وقد تصل إلى iPhone."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obavijesti agenata i cmux notify idu u feed vašeg cmux računa i mogu stići na vaš iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifikationer fra agenter og cmux notify sendes til din cmux-kontos feed og kan nå din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mitteilungen von Agents und cmux notify gehen in den Feed deines cmux-Kontos und können dein iPhone erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las notificaciones de agentes y de cmux notify van al feed de tu cuenta de cmux y pueden llegar a tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les notifications des agents et de cmux notify vont dans le flux de votre compte cmux et peuvent atteindre votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le notifiche degli agenti e di cmux notify vanno nel feed del tuo account cmux e possono arrivare al tuo iPhone."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជូនដំណឹងពីភ្នាក់ងារ និង cmux notify ទៅកាន់ព័ត៌មាននៃគណនី cmux របស់អ្នក ហើយអាចទៅដល់ iPhone របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트와 cmux notify의 알림이 cmux 계정의 피드로 전송되며 iPhone에 도착할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varsler fra agenter og cmux notify går til feeden i cmux-kontoen din og kan nå iPhonen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powiadomienia agentów i cmux notify trafiają do kanału Twojego konta cmux i mogą dotrzeć do iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notificações de agentes e do cmux notify vão para o feed da sua conta cmux e podem chegar ao seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уведомления агентов и cmux notify попадают в ленту вашей учётной записи cmux и могут прийти на iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแจ้งเตือนจากเอเจนต์และ cmux notify จะไปที่ฟีดของบัญชี cmux และอาจส่งถึง iPhone ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlardan ve cmux notify'dan gelen bildirimler cmux hesabınızın akışına gider ve iPhone'unuza ulaşabilir."
