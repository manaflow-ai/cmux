    "notifications.sound.refusal.silent": {
      "comment": "Preview Notification Sound refused: the workspace's notifications are muted at some level",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تصدر الإشعارات هنا صوتًا: مستوى أعلى يكتمها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obavještenja ovdje nemaju zvuk: viši nivo ih utišava."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notifikationer her har ingen lyd: et niveau over slår dem fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mitteilungen hier spielen keinen Ton: eine höhere Ebene schaltet sie stumm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications here play no sound: a level above mutes them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las notificaciones aquí no suenan: un nivel superior las silencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les notifications ici ne jouent aucun son : un niveau supérieur les coupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le notifiche qui non hanno suono: un livello superiore le silenzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここでの通知はサウンドを鳴らしません。上位のレベルでミュートされています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជូនដំណឹងនៅទីនេះមិនបន្លឺសំឡេងទេ៖ កម្រិតខាងលើបិទសំឡេងវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기의 알림은 사운드가 없습니다. 상위 수준에서 음소거되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varsler her spiller ingen lyd: et nivå over demper dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powiadomienia tutaj nie odtwarzają dźwięku: wyższy poziom je wycisza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As notificações aqui não tocam som: um nível acima as silencia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Уведомления здесь без звука: его отключает уровень выше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแจ้งเตือนที่นี่ไม่มีเสียง: ระดับที่สูงกว่าปิดเสียงไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buradaki bildirimler ses çalmıyor: üst bir düzey onları sessize alıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сповіщення тут без звуку: його вимикає рівень вище."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thông báo ở đây không phát âm thanh: một cấp phía trên đã tắt tiếng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处的通知不播放声音：上层级已将其静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此處的通知不播放聲音：上層級已將其靜音。"
          }
        }
      }
    },
    "notifications.sound.refusal.unsupported": {
      "comment": "Refusal when importing a notification sound: %@ is the file name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ليس ملف صوت يمكن لـ cmux تشغيله (AIFF أو CAF أو WAV أو MP3 أو M4A)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nije zvučna datoteka koju cmux može reproducirati (AIFF, CAF, WAV, MP3 ili M4A)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ er ikke en lydfil, cmux kan afspille (AIFF, CAF, WAV, MP3 eller M4A)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist keine Audiodatei, die cmux abspielen kann (AIFF, CAF, WAV, MP3 oder M4A)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a sound file cmux can play (AIFF, CAF, WAV, MP3 or M4A)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no es un archivo de sonido que cmux pueda reproducir (AIFF, CAF, WAV, MP3 o M4A)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n'est pas un fichier son que cmux peut lire (AIFF, CAF, WAV, MP3 ou M4A)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non è un file audio che cmux può riprodurre (AIFF, CAF, WAV, MP3 o M4A)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ は cmux で再生できるサウンドファイルではありません (AIFF、CAF、WAV、MP3、M4A)。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ មិនមែនជាឯកសារសំឡេងដែល cmux អាចចាក់បានទេ (AIFF, CAF, WAV, MP3 ឬ M4A)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) cmux가 재생할 수 있는 사운드 파일이 아닙니다(AIFF, CAF, WAV, MP3, M4A)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ er ikke en lydfil cmux kan spille av (AIFF, CAF, WAV, MP3 eller M4A)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie jest plikiem dźwiękowym, który cmux może odtworzyć (AIFF, CAF, WAV, MP3 lub M4A)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não é um arquivo de som que o cmux possa tocar (AIFF, CAF, WAV, MP3 ou M4A)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — не звуковой файл, который cmux может воспроизвести (AIFF, CAF, WAV, MP3 или M4A)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่ใช่ไฟล์เสียงที่ cmux เล่นได้ (AIFF, CAF, WAV, MP3 หรือ M4A)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, cmux'ın çalabileceği bir ses dosyası değil (AIFF, CAF, WAV, MP3 veya M4A)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — не звуковий файл, який cmux може відтворити (AIFF, CAF, WAV, MP3 або M4A)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không phải tệp âm thanh cmux phát được (AIFF, CAF, WAV, MP3 hoặc M4A)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不是 cmux 能播放的声音文件（AIFF、CAF、WAV、MP3 或 M4A）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不是 cmux 能播放的聲音檔案（AIFF、CAF、WAV、MP3 或 M4A）。"
          }
        }
      }
    },
    "settings.sidebar.noFade": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "إظهار الشريط الجانبي كاملا دون تلاشٍ"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Prikaži cijelu bočnu traku bez prelaza"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Vis hele sidepanelet uden udtoning"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gesamte Seitenleiste ohne Verblassen zeigen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Show Whole Sidebar Without Fade"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Mostrar toda la barra lateral sin desvanecimiento"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Afficher toute la barre latérale sans fondu"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Mostra tutta la barra laterale senza sfumatura"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーを全体表示（フェードなし）"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញរបារចំហៀងទាំងមូលដោយគ្មានការស្រអាប់"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "페이드 없이 사이드바 전체 표시"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Vis hele sidepanelet uten uttoning"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pokaż cały pasek boczny bez zanikania"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostrar a barra lateral inteira sem desvanecimento"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Показывать всю боковую панель без затемнения"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงแถบด้านข้างทั้งหมดโดยไม่มีการจางหาย"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğunu solma olmadan tam göster"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Показувати всю бічну панель без затухання"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hiển thị toàn bộ thanh bên, không mờ dần"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无渐隐显示整个侧边栏"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無漸隱顯示整個側邊欄"}}
      }
    },
    "settings.sidebar.noFade.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "تتوقف حواف الشريط الجانبي عن التلاشي ويظهر القائمة كاملة. كما يُخفي شريط الملف الشخصي والبحث في الأسفل. عند الإيقاف، تتلاشى الحواف ويظهر الشريط."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ivice bočne trake prestaju da blijede i cijela lista se prikazuje. Takođe skriva donju traku profila i pretrage. Isključeno: ivice blijede, a traka se prikazuje."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Sidepanelets kanter holder op med at tone ud, og hele listen vises. Den skjuler også den nederste profil- og søgelinje. Fra: kanterne toner ud, og linjen vises."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Kanten der Seitenleiste verblassen nicht mehr, und die ganze Liste wird angezeigt. Außerdem wird die untere Profil- und Suchleiste ausgeblendet. Aus: Die Kanten verblassen, und die Leiste wird angezeigt."}},
        "en": {"stringUnit": {"state": "translated", "value": "The sidebar's edges stop fading and the whole list shows. It also hides the bottom profile and search bar. Off, the edges fade and the bar shows."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Los bordes de la barra lateral dejan de desvanecerse y se muestra toda la lista. También oculta la barra inferior de perfil y búsqueda. Desactivado: los bordes se desvanecen y la barra se muestra."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Les bords de la barre latérale ne s'estompent plus et toute la liste s'affiche. La barre inférieure du profil et de la recherche est masquée. Désactivé : les bords s'estompent et la barre s'affiche."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "I bordi della barra laterale non sfumano più e appare tutta la lista. Nasconde anche la barra inferiore di profilo e ricerca. Disattivato: i bordi sfumano e la barra è visibile."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーの端がフェードせず、リスト全体が表示されます。下部のプロフィールと検索バーも非表示になります。オフの場合は端がフェードし、バーが表示されます。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គែមរបារចំហៀងឈប់ស្រអាប់ ហើយបញ្ជីទាំងមូលត្រូវបានបង្ហាញ។ វាក៏លាក់របារប្រវត្តិរូប និងស្វែងរកនៅខាងក្រោមផងដែរ។ បិទ៖ គែមស្រអាប់ ហើយរបារត្រូវបានបង្ហាញ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사이드바 가장자리가 흐려지지 않고 목록 전체가 표시됩니다. 아래쪽 프로필 및 검색 막대도 숨겨집니다. 끄면 가장자리가 흐려지고 막대가 표시됩니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kantene på sidepanelet slutter å tones ut, og hele listen vises. Den skjuler også den nederste profil- og søkelinjen. Av: kantene tones ut, og linjen vises."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Krawędzie paska bocznego przestają zanikać i widać całą listę. Ukrywa też dolny pasek profilu i wyszukiwania. Wyłączone: krawędzie zanikają, a pasek jest widoczny."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "As bordas da barra lateral deixam de desvanecer e a lista inteira aparece. Também oculta a barra inferior de perfil e busca. Desligado: as bordas desvanecem e a barra aparece."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Края боковой панели перестают затемняться, и весь список отображается. Также скрывается нижняя панель профиля и поиска. Выключено: края затемняются, панель видна."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ขอบแถบด้านข้างจะไม่จางหายและแสดงรายการทั้งหมด ยังซ่อนแถบโปรไฟล์และค้นหาด้านล่างด้วย ปิดอยู่: ขอบจะจางและแถบจะแสดง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğunun kenarları solmaz ve listenin tamamı görünür. Alttaki profil ve arama çubuğunu da gizler. Kapalıyken kenarlar solar ve çubuk görünür."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Краї бічної панелі перестають затухати, і показується весь список. Також приховується нижня панель профілю і пошуку. Вимкнено: краї затухають, панель видно."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Mép thanh bên không còn mờ dần và toàn bộ danh sách hiển thị. Thanh hồ sơ và tìm kiếm ở dưới cũng bị ẩn. Tắt: mép mờ dần và thanh hiển thị."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "侧边栏边缘不再渐隐，整个列表全部显示。同时隐藏底部的个人资料和搜索栏。关闭时边缘渐隐，并显示该栏。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "側邊欄邊緣不再漸隱，整個列表全部顯示。同時隱藏底部的個人資料和搜尋列。關閉時邊緣漸隱，並顯示該列。"}}
      }
    },
    "settings.sidebar.controlsOnHover": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "إظهار عناصر تحكم الشريط الجانبي عند التمرير فقط"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Prikaži kontrole bočne trake samo pri prelasku"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Vis kun sidepanelets knapper ved markør"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Seitenleisten-Steuerelemente nur beim Überfahren zeigen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Show Sidebar Controls Only on Hover"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Mostrar los controles de la barra lateral solo al pasar el puntero"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Afficher les commandes de la barre latérale uniquement au survol"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Mostra i controlli della barra laterale solo al passaggio"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーのコントロールをポインタを置いたときだけ表示"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញការគ្រប់គ្រងរបារចំហៀងតែពេលដាក់ទស្សន៍ទ្រនិច"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "호버할 때만 사이드바 컨트롤 표시"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Vis sidepanelkontroller bare ved peker"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Pokazuj elementy paska bocznego tylko po najechaniu"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostrar os controles da barra lateral só ao passar o ponteiro"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Показывать элементы боковой панели только при наведении"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงตัวควบคุมแถบด้านข้างเฉพาะเมื่อวางเมาส์"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğu denetimlerini yalnızca üzerine gelince göster"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Показувати елементи бічної панелі лише при наведенні"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Chỉ hiện điều khiển thanh bên khi di chuột"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "仅在悬停时显示侧边栏控件"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "僅在懸停時顯示側邊欄控制項"}}
      }
    },
    "settings.sidebar.controlsOnHover.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "يظهر زر مساحة عمل جديدة والمساحات وزر الملف الشخصي وزر البحث في الشريط الجانبي، وزر الشريط الجانبي وزرّا الرجوع والتقدم فوقه، فقط عندما يكون المؤشر فوق الشريط الجانبي. عند الإيقاف، تظهر دائمًا."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Dugme Novi radni prostor, prostori, dugme profila i dugme Pretraga na bočnoj traci, te dugme bočne trake, Nazad i Naprijed iznad nje, prikazuju se samo dok je pokazivač iznad bočne trake. Isključeno: uvijek se prikazuju."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Sidepanelets knap Nyt arbejdsområde, rum, profilknap og søgeknap samt sidepanelknappen, Tilbage og Frem over det vises kun, mens markøren er over sidepanelet. Slået fra vises de altid."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Taste „Neuer Arbeitsbereich“, die Bereiche, die Profiltaste und die Suchtaste der Seitenleiste sowie die Seitenleistentaste, Zurück und Vorwärts darüber erscheinen nur, solange der Zeiger über der Seitenleiste ist. Aus: Sie werden immer angezeigt."}},
        "en": {"stringUnit": {"state": "translated", "value": "The sidebar's New Workspace button, spaces, profile button and Search button, and the sidebar button, Back and Forward above it, show only while the pointer is over the sidebar. Off, they always show."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El botón Nuevo espacio de trabajo, los espacios, el botón de perfil y el botón Buscar de la barra lateral, y el botón de la barra lateral, Atrás y Adelante encima, solo se muestran mientras el puntero está sobre la barra lateral. Desactivado, se muestran siempre."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le bouton Nouvel espace de travail, les espaces, le bouton de profil et le bouton Rechercher de la barre latérale, ainsi que le bouton de la barre latérale, Précédent et Suivant au-dessus, ne s’affichent que lorsque le pointeur est sur la barre latérale. Désactivé, ils s’affichent toujours."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il pulsante Nuovo workspace, gli spazi, il pulsante del profilo e il pulsante Cerca della barra laterale, e il pulsante della barra laterale, Indietro e Avanti sopra di essa, si vedono solo mentre il puntatore è sulla barra laterale. Disattivato, sono sempre visibili."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーの新規ワークスペースボタン、スペース、プロフィールボタン、検索ボタン、およびその上のサイドバーボタン、「戻る」と「進む」は、ポインタがサイドバー上にあるときだけ表示されます。オフのときは常に表示されます。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ប៊ូតុងកន្លែងធ្វើការថ្មី ចន្លោះ ប៊ូតុងប្រវត្តិរូប និងប៊ូតុងស្វែងរកនៃរបារចំហៀង ព្រមទាំងប៊ូតុងរបារចំហៀង ថយក្រោយ និងទៅមុខខាងលើវា បង្ហាញតែនៅពេលព្រួញនៅលើរបារចំហៀងប៉ុណ្ណោះ។ បិទ៖ ពួកវាតែងតែបង្ហាញ។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사이드바의 새 워크스페이스 버튼, 스페이스, 프로필 버튼, 검색 버튼과 그 위의 사이드바 버튼, 뒤로, 앞으로는 포인터가 사이드바 위에 있을 때만 표시됩니다. 끄면 항상 표시됩니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Sidefeltets knapp Nytt arbeidsområde, rom, profilknappen og søkeknappen, og sidefeltknappen, Tilbake og Frem over det, vises bare mens pekeren er over sidefeltet. Av: de vises alltid."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Przycisk Nowa przestrzeń robocza, przestrzenie, przycisk profilu i przycisk Szukaj paska bocznego oraz przycisk paska bocznego, Wstecz i Dalej nad nim są widoczne tylko, gdy wskaźnik jest nad paskiem bocznym. Wyłączone: są zawsze widoczne."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O botão Novo espaço de trabalho, os espaços, o botão de perfil e o botão Buscar da barra lateral, e o botão da barra lateral, Voltar e Avançar acima dela, aparecem só enquanto o ponteiro está sobre a barra lateral. Desativado, eles sempre aparecem."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Кнопка «Новое рабочее пространство», пространства, кнопка профиля и кнопка поиска боковой панели, а также кнопка боковой панели, «Назад» и «Вперёд» над ней видны, только пока указатель над боковой панелью. Выключено: видны всегда."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ปุ่มพื้นที่ทำงานใหม่ สเปซ ปุ่มโปรไฟล์ และปุ่มค้นหาของแถบด้านข้าง รวมถึงปุ่มแถบด้านข้าง ย้อนกลับ และไปข้างหน้าด้านบน จะแสดงเฉพาะเมื่อตัวชี้อยู่เหนือแถบด้านข้าง เมื่อปิด จะแสดงเสมอ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğunun Yeni Çalışma Alanı düğmesi, alanları, profil düğmesi ve Ara düğmesi ile üstündeki kenar çubuğu düğmesi, Geri ve İleri yalnızca işaretçi kenar çubuğunun üzerindeyken görünür. Kapalıyken her zaman görünürler."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Кнопка «Новий робочий простір», простори, кнопка профілю та кнопка пошуку бічної панелі, а також кнопка бічної панелі, «Назад» і «Вперед» над нею видні, лише поки вказівник над бічною панеллю. Вимкнено: видні завжди."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Nút Không gian làm việc mới, các không gian, nút hồ sơ và nút Tìm kiếm của thanh bên, cùng nút thanh bên, Quay lại và Tiếp tới phía trên, chỉ hiện khi con trỏ ở trên thanh bên. Khi tắt, chúng luôn hiển thị."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "边栏的“新建工作区”按钮、空间、个人资料按钮和“搜索”按钮，以及其上方的边栏按钮、“后退”和“前进”，仅在指针位于边栏上方时显示。关闭时始终显示。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "側邊欄的「新增工作區」按鈕、空間、個人檔案按鈕和「搜尋」按鈕，以及其上方的側邊欄按鈕、「上一頁」和「下一頁」，僅在指標位於側邊欄上方時顯示。關閉時一律顯示。"}}
      }
    },
    "settings.agentPane.showMachineLoadWarnings": {
        "comment": "Agent Chat setting: whether the Computer menu warns about remote machine CPU or memory pressure.",
        "extractionState": "manual",
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Show Machine Load Warnings"
            }
          },
          "de": {
            "stringUnit": {
              "state": "needs_review",
              "value": "Warnungen zur Maschinenlast anzeigen"
            }
          },
          "fr": {
            "stringUnit": {
              "state": "needs_review",
              "value": "Afficher les avertissements de charge de la machine"
            }
          },
          "ar": {
            "stringUnit": {
              "state": "needs_review",
              "value": "إظهار تحذيرات حمل الجهاز"
            }
          },
          "es": {
            "stringUnit": {
              "state": "needs_review",
              "value": "Mostrar advertencias de carga de la máquina"
            }
          },
          "zh-Hant": {
            "stringUnit": {
              "state": "needs_review",
              "value": "顯示機器負載警告"
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "needs_review",
              "value": "显示机器负载警告"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "needs_review",
              "value": "컴퓨터 부하 경고 표시"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "needs_review",
              "value": "マシン負荷の警告を表示"
            }
          },
          "bs": {"stringUnit": {"state": "needs_review", "value": "Prikaži upozorenja o opterećenju mašine"}},
          "da": {"stringUnit": {"state": "needs_review", "value": "Vis advarsler om maskinbelastning"}},
          "it": {"stringUnit": {"state": "needs_review", "value": "Mostra avvisi sul carico della macchina"}},
          "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញការព្រមានអំពីបន្ទុកម៉ាស៊ីន"}},
          "nb": {"stringUnit": {"state": "needs_review", "value": "Vis advarsler om maskinbelastning"}},
          "pl": {"stringUnit": {"state": "needs_review", "value": "Pokazuj ostrzeżenia o obciążeniu maszyny"}},
          "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostrar avisos de carga da máquina"}},
          "ru": {"stringUnit": {"state": "needs_review", "value": "Показывать предупреждения о нагрузке на машину"}},
          "th": {"stringUnit": {"state": "needs_review", "value": "แสดงคำเตือนการใช้งานเครื่องสูง"}},
          "tr": {"stringUnit": {"state": "needs_review", "value": "Makine yükü uyarılarını göster"}},
          "uk": {"stringUnit": {"state": "needs_review", "value": "Показувати попередження про навантаження на машину"}},
          "vi": {"stringUnit": {"state": "needs_review", "value": "Hiển thị cảnh báo tải máy"}}
        }
      },
    "settings.agentPane.showMachineLoadWarnings.help": {
        "comment": "Agent Chat setting help: explains the Computer menu machine-load warning.",
        "extractionState": "manual",
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Shows a warning when a remote machine is at its CPU or memory budget in the Computer menu."
            }
          },
          "de": {
            "stringUnit": {
              "state": "needs_review",
              "value": "Zeigt im Computermenü eine Warnung an, wenn ein entfernter Rechner sein CPU- oder Speicherlimit erreicht."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "needs_review",
              "value": "Affiche un avertissement dans le menu Ordinateur lorsqu’une machine distante atteint sa limite de processeur ou de mémoire."
            }
          },
          "ar": {
            "stringUnit": {
              "state": "needs_review",
              "value": "يعرض تحذيرًا في قائمة الكمبيوتر عندما يصل جهاز بعيد إلى حد المعالج أو الذاكرة."
            }
          },
          "es": {
            "stringUnit": {
              "state": "needs_review",
              "value": "Muestra una advertencia en el menú Ordenador cuando una máquina remota alcanza su límite de CPU o memoria."
            }
          },
          "zh-Hant": {
            "stringUnit": {
              "state": "needs_review",
              "value": "遠端機器達到 CPU 或記憶體上限時，在「電腦」選單中顯示警告。"
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "needs_review",
              "value": "远程机器达到 CPU 或内存上限时，在“电脑”菜单中显示警告。"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "needs_review",
              "value": "원격 컴퓨터가 CPU 또는 메모리 한도에 도달하면 컴퓨터 메뉴에 경고를 표시합니다."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "needs_review",
              "value": "リモートマシンが CPU またはメモリの上限に達したとき、「コンピュータ」メニューに警告を表示します。"
            }
          },
          "bs": {"stringUnit": {"state": "needs_review", "value": "Prikazuje upozorenje u meniju Računar kada udaljena mašina dostigne ograničenje procesora ili memorije."}},
          "da": {"stringUnit": {"state": "needs_review", "value": "Viser en advarsel i menuen Computer, når en fjernmaskine når sin CPU- eller hukommelsesgrænse."}},
          "it": {"stringUnit": {"state": "needs_review", "value": "Mostra un avviso nel menu Computer quando una macchina remota raggiunge il limite di CPU o memoria."}},
          "km": {"stringUnit": {"state": "needs_review", "value": "បង្ហាញការព្រមានក្នុងម៉ឺនុយកុំព្យូទ័រ នៅពេលម៉ាស៊ីនពីចម្ងាយឈានដល់កម្រិត CPU ឬអង្គចងចាំ។"}},
          "nb": {"stringUnit": {"state": "needs_review", "value": "Viser en advarsel i Datamaskin-menyen når en ekstern maskin når CPU- eller minnegrensen."}},
          "pl": {"stringUnit": {"state": "needs_review", "value": "Pokazuje ostrzeżenie w menu Komputer, gdy zdalna maszyna osiągnie limit procesora lub pamięci."}},
          "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Mostra um aviso no menu Computador quando uma máquina remota atinge seu limite de CPU ou memória."}},
          "ru": {"stringUnit": {"state": "needs_review", "value": "Показывает предупреждение в меню «Компьютер», когда удалённая машина достигает лимита ЦП или памяти."}},
          "th": {"stringUnit": {"state": "needs_review", "value": "แสดงคำเตือนในเมนูคอมพิวเตอร์เมื่อเครื่องระยะไกลใช้ CPU หรือหน่วยความจำถึงขีดจำกัด"}},
          "tr": {"stringUnit": {"state": "needs_review", "value": "Uzak bir makine CPU veya bellek sınırına ulaştığında Bilgisayar menüsünde uyarı gösterir."}},
          "uk": {"stringUnit": {"state": "needs_review", "value": "Показує попередження в меню «Комп’ютер», коли віддалена машина досягає обмеження ЦП або пам’яті."}},
          "vi": {"stringUnit": {"state": "needs_review", "value": "Hiển thị cảnh báo trong menu Máy tính khi máy từ xa đạt đến giới hạn CPU hoặc bộ nhớ."}}
        }
      },
    "settings.category.menus": {
      "comment": "Settings sidebar: category for customizing right-click (context) menus.",
      "extractionState": "manual",
      "localizations": {
