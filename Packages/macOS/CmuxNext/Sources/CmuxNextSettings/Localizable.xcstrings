        "ko": { "stringUnit": { "state": "needs_review", "value": "에이전트가 작업 공간에서 작업하는 동안의 표시." } },
        "nb": { "stringUnit": { "state": "needs_review", "value": "Et merke mens en agent arbeider i arbeidsområdet." } },
