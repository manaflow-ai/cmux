        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠겨 있어도 에이전트가 앱 윈도우를 사용할 수 있음"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti koriste prozore aplikacija dok je Mac zaključan"
          }
        },
        "da": {
          "stringUnit": {
