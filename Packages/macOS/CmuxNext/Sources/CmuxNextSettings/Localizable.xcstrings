          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ cuộc trò chuyện không hoạt động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档不活跃的聊天"
          }
        },
