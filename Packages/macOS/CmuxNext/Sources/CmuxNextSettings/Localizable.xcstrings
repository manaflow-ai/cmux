          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペース ID ごとのサウンドです。サイドバーのワークスペースのメニューから設定します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំឡេងតាម id តំបន់ការងារ។ កំណត់ពីម៉ឺនុយតំបន់ការងារក្នុងរបារចំហៀង។"
