        "ja": {"stringUnit": {"state": "needs_review", "value": "不透明"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ស្រអាប់"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "불투명"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ugjennomsiktig"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nieprzezroczyste"}},
