    "settings.experiments.seeThroughDock.help": {
      "comment": "Settings > Experiments: the See-Through Dock taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The conversation stays visible behind the notices and the Needs your input row above the composer."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تبقى المحادثة مرئية خلف الإشعارات وصف «يحتاج إلى إدخالك» فوق مربع الكتابة."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Razgovor ostaje vidljiv iza obavještenja i reda „Potreban je vaš unos“ iznad polja za pisanje."}},
        "da": {"stringUnit": {"state": "translated", "value": "Samtalen forbliver synlig bag meddelelserne og rækken “Kræver dit input” over skrivefeltet."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Unterhaltung bleibt hinter den Hinweisen und der Zeile „Deine Eingabe ist nötig“ über dem Eingabefeld sichtbar."}},
        "es": {"stringUnit": {"state": "translated", "value": "La conversación sigue visible detrás de los avisos y de la fila «Necesita tu respuesta» sobre el editor."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La conversation reste visible derrière les avis et la ligne « Votre réponse est requise » au-dessus de la zone de saisie."}},
        "it": {"stringUnit": {"state": "translated", "value": "La conversazione resta visibile dietro gli avvisi e la riga «Serve il tuo input» sopra il compositore."}},
        "ja": {"stringUnit": {"state": "translated", "value": "入力欄の上にある通知と「入力が必要です」の行の後ろでも会話が見えたままになります。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ការសន្ទនានៅតែមើលឃើញនៅពីក្រោយសេចក្តីជូនដំណឹង និងជួរ «ត្រូវការការបញ្ចូលរបស់អ្នក» ខាងលើប្រអប់សរសេរ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력창 위의 알림과 “입력이 필요합니다” 행 뒤에서도 대화가 계속 보입니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Samtalen forblir synlig bak varslene og raden «Trenger dine innspill» over skrivefeltet."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Rozmowa pozostaje widoczna za powiadomieniami i wierszem „Potrzebna Twoja odpowiedź” nad polem pisania."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A conversa continua visível atrás dos avisos e da linha “Precisa da sua resposta” acima do editor."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Разговор остаётся виден за уведомлениями и строкой «Нужен ваш ответ» над полем ввода."}},
        "th": {"stringUnit": {"state": "translated", "value": "บทสนทนายังมองเห็นได้อยู่หลังการแจ้งเตือนและแถว “ต้องการข้อมูลจากคุณ” เหนือช่องเขียนข้อความ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Konuşma, yazma alanının üstündeki bildirimlerin ve “Girdiniz gerekiyor” satırının arkasında görünür kalır."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Розмова залишається видимою за сповіщеннями та рядком «Потрібна ваша відповідь» над полем введення."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Cuộc trò chuyện vẫn hiển thị phía sau các thông báo và hàng “Cần bạn nhập” phía trên ô soạn thảo."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在输入框上方的通知和“需要你的输入”行后面，对话依然可见。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在輸入框上方的通知和「需要你的輸入」列後面，對話依然可見。"}}
      }
    },
    "settings.experiments.attachmentTypeIcons": {
      "comment": "Settings > Experiments: the Attachment Type Icons taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Attachment Type Icons"}},
        "ar": {"stringUnit": {"state": "translated", "value": "أيقونات نوع المرفق"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ikone vrste priloga"}},
        "da": {"stringUnit": {"state": "translated", "value": "Ikoner for vedhæftningstype"}},
        "de": {"stringUnit": {"state": "translated", "value": "Symbole für Anhangstyp"}},
        "es": {"stringUnit": {"state": "translated", "value": "Iconos de tipo de adjunto"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Icônes de type de pièce jointe"}},
        "it": {"stringUnit": {"state": "translated", "value": "Icone del tipo di allegato"}},
        "ja": {"stringUnit": {"state": "translated", "value": "添付ファイルの種類アイコン"}},
        "km": {"stringUnit": {"state": "translated", "value": "រូបតំណាងប្រភេទឯកសារភ្ជាប់"}},
        "ko": {"stringUnit": {"state": "translated", "value": "첨부 파일 유형 아이콘"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Ikoner for vedleggstype"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ikony typu załącznika"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ícones de tipo de anexo"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Значки типа вложения"}},
        "th": {"stringUnit": {"state": "translated", "value": "ไอคอนประเภทไฟล์แนบ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ek türü simgeleri"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Значки типу вкладення"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Biểu tượng loại tệp đính kèm"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "附件类型图标"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "附件類型圖示"}}
      }
    },
    "settings.experiments.attachmentTypeIcons.help": {
      "comment": "Settings > Experiments: the Attachment Type Icons taste prototype row",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "While an attachment loads, its chip shows a file or image icon instead of the loading mark."}},
        "ar": {"stringUnit": {"state": "translated", "value": "أثناء تحميل مرفق، تعرض شريحته أيقونة ملف أو صورة بدلاً من علامة التحميل."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Dok se prilog učitava, njegov čip prikazuje ikonu datoteke ili slike umjesto oznake učitavanja."}},
        "da": {"stringUnit": {"state": "translated", "value": "Mens en vedhæftning indlæses, viser dens chip et fil- eller billedikon i stedet for indlæsningsmærket."}},
        "de": {"stringUnit": {"state": "translated", "value": "Während ein Anhang lädt, zeigt sein Chip ein Datei- oder Bildsymbol statt der Ladeanzeige."}},
        "es": {"stringUnit": {"state": "translated", "value": "Mientras se carga un adjunto, su chip muestra un icono de archivo o de imagen en lugar del indicador de carga."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pendant le chargement d'une pièce jointe, sa puce affiche une icône de fichier ou d'image au lieu de l'indicateur de chargement."}},
        "it": {"stringUnit": {"state": "translated", "value": "Durante il caricamento di un allegato, il suo chip mostra un'icona di file o di immagine al posto dell'indicatore di caricamento."}},
        "ja": {"stringUnit": {"state": "translated", "value": "添付ファイルの読み込み中、チップに読み込みマークの代わりにファイルまたは画像のアイコンを表示します。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ពេលឯកសារភ្ជាប់កំពុងផ្ទុក បន្ទះរបស់វាបង្ហាញរូបតំណាងឯកសារ ឬរូបភាព ជំនួសឱ្យសញ្ញាកំពុងផ្ទុក។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "첨부 파일을 불러오는 동안 칩에 로딩 표시 대신 파일 또는 이미지 아이콘이 표시됩니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Mens et vedlegg lastes inn, viser brikken et fil- eller bildeikon i stedet for lastemerket."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Podczas wczytywania załącznika jego kafelek pokazuje ikonę pliku lub obrazu zamiast wskaźnika wczytywania."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enquanto um anexo carrega, o chip mostra um ícone de arquivo ou de imagem em vez do indicador de carregamento."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Пока вложение загружается, на его плашке показан значок файла или изображения вместо индикатора загрузки."}},
        "th": {"stringUnit": {"state": "translated", "value": "ขณะที่ไฟล์แนบกำลังโหลด ชิปจะแสดงไอคอนไฟล์หรือรูปภาพแทนเครื่องหมายกำลังโหลด"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bir ek yüklenirken, çipi yükleme işareti yerine bir dosya veya görsel simgesi gösterir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Поки вкладення завантажується, на його плашці показано значок файлу або зображення замість індикатора завантаження."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Trong khi tệp đính kèm đang tải, chip của nó hiển thị biểu tượng tệp hoặc hình ảnh thay cho dấu đang tải."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "附件加载时，其标签显示文件或图片图标，而不是加载标记。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "附件載入時，其標籤顯示檔案或圖片圖示，而不是載入標記。"}}
      }
    },
