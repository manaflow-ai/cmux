    "settings.sidebar.groupHeader.background.help": {
      "comment": "Settings help: the group background choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How a group draws. Folders shows plain folders; Sections shows plain headings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طريقة رسم المجموعة. تعرض المجلدات مجلدات بسيطة، وتعرض الأقسام عناوين بسيطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako se grupa crta. Mape prikazuju obične mape; Odjeljci prikazuju obične naslove."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan en gruppe tegnes. Mapper viser enkle mapper; Sektioner viser enkle overskrifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie eine Gruppe gezeichnet wird. Ordner zeigt schlichte Ordner, Abschnitte zeigt schlichte Überschriften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo se dibuja un grupo. Carpetas muestra carpetas simples; Secciones muestra encabezados simples."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Façon dont un groupe s’affiche. Dossiers affiche de simples dossiers ; Rubriques affiche de simples titres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come viene disegnato un gruppo. Cartelle mostra semplici cartelle; Sezioni mostra semplici intestazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "グループの描き方です。フォルダはシンプルなフォルダを、セクションはシンプルな見出しを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបដែលក្រុមត្រូវបានគូរ។ ថត បង្ហាញថតធម្មតា ហើយ ផ្នែក បង្ហាញចំណងជើងធម្មតា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그룹을 그리는 방식입니다. 폴더는 단순한 폴더를, 섹션은 단순한 제목을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan en gruppe tegnes. Mapper viser enkle mapper; Seksjoner viser enkle overskrifter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sposób rysowania grupy. Foldery pokazują zwykłe foldery, a Sekcje zwykłe nagłówki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como um grupo é desenhado. Pastas mostra pastas simples; Seções mostra títulos simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как рисуется группа. «Папки» показывают простые папки, «Разделы» — простые заголовки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิธีวาดกลุ่ม โฟลเดอร์ แสดงเป็นโฟลเดอร์แบบเรียบง่าย ส่วน แสดงเป็นหัวข้อแบบเรียบง่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir grubun nasıl çizildiği. Klasörler sade klasörler, Bölümler sade başlıklar gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як малюється група. Теки показують прості теки, Розділи — прості заголовки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách vẽ một nhóm. Thư mục hiển thị thư mục đơn giản; Mục hiển thị tiêu đề đơn giản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "群组的绘制方式。“文件夹”显示简单的文件夹，“分区”显示简单的标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "群組的繪製方式。資料夾顯示簡單的資料夾，分區顯示簡單的標題。"
          }
        }
      }
    },
