    "settings.remote.agentShareIdleMinutes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف مشاركة الوكيل بعد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje agenta se isključuje nakon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentdeling slås fra efter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentenfreigabe endet nach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Sharing Turns Off After"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido de agentes se desactiva tras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage par un agent s’arrête après"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione degli agenti si disattiva dopo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの共有をオフにするまで"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចែករំលែករបស់ភ្នាក់ងារបិទបន្ទាប់ពី"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 공유 자동 끄기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentdeling slås av etter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie przez agenta wyłącza się po"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento do agente desativa após"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ от агента выключается через"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแชร์ของเอเจนต์ปิดหลังจาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan paylaşımı şu süre sonra kapanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ від агента вимикається через"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ của tác tử tắt sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
