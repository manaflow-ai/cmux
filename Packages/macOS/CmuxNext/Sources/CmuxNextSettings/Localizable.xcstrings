        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spotify や Music などのアプリで再生中のものも表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញ​អ្វី​ដែល​កំពុង​ចាក់​ក្នុង​កម្មវិធី​ដូចជា Spotify ឬ Music ផង​ដែរ។"
