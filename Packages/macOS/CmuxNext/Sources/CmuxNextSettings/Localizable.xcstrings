    "settings.appearance.backgroundOpacity.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the theme color covers the material behind the window."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار ما يغطيه لون السمة من المادة خلف النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko boja teme prekriva materijal iza prozora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget temafarven dækker materialet bag vinduet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark die Themenfarbe das Material hinter dem Fenster überdeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto cubre el color del tema el material detrás de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle mesure la couleur du thème couvre le matériau derrière la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto il colore del tema copre il materiale dietro la finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの背後のマテリアルをテーマの色がどれだけ覆うか。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្រិតដែលពណ៌ស្បែកគ្របលើសម្ភារៈនៅពីក្រោយបង្អួច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 색상이 윈도우 뒤의 재질을 덮는 정도입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye temafargen dekker materialet bak vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak bardzo kolor motywu przykrywa materiał za oknem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto a cor do tema cobre o material atrás da janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько цвет темы закрывает материал за окном."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณที่สีของธีมปิดทับวัสดุด้านหลังหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema renginin pencerenin arkasındaki malzemeyi ne kadar örttüğü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки колір теми закриває матеріал за вікном."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức độ màu chủ đề phủ lên chất liệu phía sau cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题颜色覆盖窗口背后材质的程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題顏色覆蓋視窗背後材質的程度。"
          }
        }
      }
    },
