    "settings.history.terminalCommands.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists finished shell commands in History. Command lines can contain secrets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض أوامر الصدفة المنتهية في السجل. قد تحتوي أسطر الأوامر على أسرار."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje završene komande ljuske u historiji. Komande mogu sadržavati tajne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser færdige shell-kommandoer i Historik. Kommandolinjer kan indeholde hemmeligheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt beendete Shell-Befehle im Verlauf. Befehlszeilen können Geheimnisse enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra en el historial los comandos de shell terminados. Las líneas de comandos pueden contener secretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affiche les commandes shell terminées dans l’historique. Les lignes de commande peuvent contenir des secrets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra nella cronologia i comandi shell terminati. Le righe di comando possono contenere segreti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終了したシェルコマンドを履歴に表示します。コマンドラインには秘密情報が含まれることがあります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្ហាញពាក្យបញ្ជាសែលដែលបានបញ្ចប់ក្នុងប្រវត្តិ។ បន្ទាត់ពាក្យបញ្ជាអាចមានព័ត៌មានសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료된 셸 명령을 기록에 표시합니다. 명령줄에 비밀 정보가 포함될 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser fullførte skallkommandoer i Historikk. Kommandolinjer kan inneholde hemmeligheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje zakończone polecenia powłoki w historii. Wiersze poleceń mogą zawierać sekrety."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra no histórico os comandos de shell concluídos. Linhas de comando podem conter segredos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывает завершённые команды оболочки в истории. Командные строки могут содержать секреты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงคำสั่งเชลล์ที่เสร็จแล้วในประวัติ บรรทัดคำสั่งอาจมีข้อมูลลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biten kabuk komutlarını Geçmiş'te listeler. Komut satırları gizli bilgi içerebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показує завершені команди оболонки в історії. Командні рядки можуть містити секрети."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liệt kê các lệnh shell đã hoàn tất trong Lịch sử. Dòng lệnh có thể chứa thông tin bí mật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在历史记录中列出已完成的 shell 命令。命令行可能包含机密信息。"
