    "settings.feed.needsYouInChief": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin Needs You in Chief"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تثبيت «بحاجة إليك» في Chief"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikači „Treba te“ u Chiefu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør Har brug for dig i Chief"
