    "settings.computerUse.driver.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upstream is the new helper; macOS asks for its permissions again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「アップストリーム」は新しいヘルパーです。macOSは改めて許可を求めます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«المصدر الأصلي» هو المساعد الجديد؛ ويطلب macOS أذوناته مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvorno je novi pomoćnik; macOS ponovo traži njegove dozvole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream er den nye hjælper; macOS beder om dens tilladelser igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Upstream“ ist der neue Helfer; macOS fragt erneut nach seinen Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream es el nuevo asistente; macOS vuelve a pedir sus permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream est le nouvel assistant ; macOS redemande ses autorisations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream è il nuovo helper; macOS chiede di nuovo i suoi permessi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream គឺជាកម្មវិធីជំនួយថ្មី; macOS សុំការអនុញ្ញាតរបស់វាម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "업스트림은 새 도우미이며, macOS가 권한을 다시 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream er den nye hjelperen; macOS ber om tillatelsene på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream to nowy pomocnik; macOS ponownie prosi o jego uprawnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upstream é o novo auxiliar; o macOS pede as permissões dele de novo."
          }
        },
