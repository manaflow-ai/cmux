    "settings.chief.reactionClassifier.harness.help": {
      "comment": "Chief reaction classifier (a416).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent harness the reaction classifier runs on, for example claude or codex. Empty uses the Chief's Claude route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアクション分類を実行するエージェントハーネス(claude、codexなど)。空欄ならChiefのClaudeルートを使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حزمة الوكيل التي يعمل عليها مصنِّف التفاعلات، مثل claude أو codex. الفراغ يستخدم مسار Claude الخاص بـ Chief."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent harness na kojem radi klasifikator reakcija, npr. claude ili codex. Prazno koristi Chiefovu Claude rutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent-harness som reaktionsklassifikatoren kører på, fx claude eller codex. Tom bruger Chiefs Claude-rute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Agent-Harness, auf dem der Reaktionsklassifikator läuft, etwa claude oder codex. Leer nutzt die Claude-Route des Chiefs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El harness de agente en el que corre el clasificador, por ejemplo claude o codex. Vacío usa la ruta de Claude del Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le harness d’agent sur lequel tourne le classificateur, par exemple claude ou codex. Vide utilise la route Claude du Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’harness dell’agente su cui gira il classificatore, ad esempio claude o codex. Vuoto usa la route Claude del Chief."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness ភ្នាក់ងារដែលចំណាត់ថ្នាក់ប្រតិកម្មដំណើរការ ឧ. claude ឬ codex។ ទទេប្រើផ្លូវ Claude របស់ Chief។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "반응 분류기가 실행되는 에이전트 하네스(예: claude, codex). 비워 두면 Chief의 Claude 경로를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent-harness reaksjonsklassifisereren kjører på, for eksempel claude eller codex. Tom bruker Chiefs Claude-rute."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness agenta, na którym działa klasyfikator, np. claude lub codex. Puste używa trasy Claude Chiefa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O harness de agente em que o classificador roda, por exemplo claude ou codex. Vazio usa a rota Claude do Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness агента, на котором работает классификатор, например claude или codex. Пусто: маршрут Claude у Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness ของเอเจนต์ที่ตัวจำแนกทำงาน เช่น claude หรือ codex ว่างไว้จะใช้เส้นทาง Claude ของ Chief"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tepki sınıflandırıcının çalıştığı ajan harness'ı, örneğin claude veya codex. Boş bırakılırsa Chief'in Claude yolu kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness агента, на якому працює класифікатор, наприклад claude або codex. Порожньо: маршрут Claude у Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness tác tử mà bộ phân loại chạy trên đó, ví dụ claude hoặc codex. Để trống dùng tuyến Claude của Chief."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回应分类器运行的代理 harness,例如 claude 或 codex。留空则使用 Chief 的 Claude 路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回應分類器執行的代理 harness,例如 claude 或 codex。留空則使用 Chief 的 Claude 路由。"
          }
        }
      }
    },
    "settings.chief.reactionClassifier.model": {
      "comment": "Chief reaction classifier (a416).",
      "extractionState": "manual",
      "localizations": {
        "en": {
