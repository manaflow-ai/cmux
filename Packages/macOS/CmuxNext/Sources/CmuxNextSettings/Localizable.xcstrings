    "settings.agentPane.display.uiFont.help": {
      "comment": "Settings > Agent Chat: the chat's interface font (agentPane.display.font.ui), its help",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The font of the whole chat: replies, the composer, cards and menus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خط الدردشة كلها: الردود والمحرر والبطاقات والقوائم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Font cijelog chata: odgovori, polje za pisanje, kartice i meniji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrifttypen i hele chatten: svar, skrivefeltet, kort og menuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Schrift des ganzen Chats: Antworten, Eingabefeld, Karten und Menüs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fuente de todo el chat: respuestas, el editor, tarjetas y menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La police de tout le chat : réponses, zone de saisie, cartes et menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il font dell’intera chat: risposte, compositore, schede e menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "チャット全体のフォント：返信、入力欄、カード、メニュー。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពុម្ពអក្សររបស់ការជជែកទាំងមូល៖ ចម្លើយ កន្លែងសរសេរ កាត និងម៉ឺនុយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "채팅 전체의 글꼴: 답변, 작성창, 카드, 메뉴."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriften i hele chatten: svar, skrivefeltet, kort og menyer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czcionka całego czatu: odpowiedzi, pole pisania, karty i menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fonte de todo o chat: respostas, o editor, cartões e menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
