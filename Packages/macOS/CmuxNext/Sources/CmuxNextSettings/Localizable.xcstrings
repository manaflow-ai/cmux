        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il font delle risposte dell’agente. Se impostato, sostituisce il font della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントの返信のフォント。設定すると、チャットのフォントの代わりに使われます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពុម្ពអក្សរនៃចម្លើយរបស់ភ្នាក់ងារ។ ពេលកំណត់ វាជំនួសពុម្ពអក្សរជជែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 답변의 글꼴입니다. 설정하면 채팅 글꼴을 대체합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriften i agentens svar. Når den er angitt, erstatter den skriften i chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czcionka odpowiedzi agenta. Po ustawieniu zastępuje czcionkę czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fonte das respostas do agente. Quando definida, substitui a fonte do chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Шрифт ответов агента. Если задан, заменяет шрифт чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แบบอักษรของคำตอบจากเอเจนต์ เมื่อตั้งค่าแล้วจะใช้แทนแบบอักษรแชท"
