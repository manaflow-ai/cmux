    "settings.statusIndicator.animation.help": {
      "comment": "Settings > Appearance > Loading Indicator (cx-sya4n): help under the Status Indicators row.",
      "extractionState": "manual",
      "localizations": {
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statično prikazuje mirni, poseban oblik za svako stanje. Smanjenje pokreta uvijek koristi Statično."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statisk viser en stillestående, tydelig form for hver tilstand. Reducer bevægelse bruger altid Statisk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statico mostra una forma ferma e distinta per ogni stato. Riduci movimento usa sempre Statico."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឋិតិវន្តបង្ហាញរូបរាងនៅស្ងៀម និងខុសគ្នាសម្រាប់ស្ថានភាពនីមួយៗ។ កាត់បន្ថយចលនាតែងតែប្រើឋិតិវន្ត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statisk viser en stillestående, tydelig form for hver tilstand. Reduser bevegelse bruker alltid Statisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Statyczne pokazuje nieruchomy, odrębny kształt dla każdego stanu. Ograniczanie ruchu zawsze używa trybu Statyczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estático mostra uma forma parada e distinta para cada estado. Reduzir movimento sempre usa Estático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Статичный режим показывает неподвижную отдельную форму для каждого состояния. При уменьшении движения всегда используется статичный режим."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แบบคงที่จะแสดงรูปทรงที่นิ่งและแตกต่างกันสำหรับแต่ละสถานะ ลดการเคลื่อนไหวจะใช้แบบคงที่เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sabit, her durum için hareketsiz ve ayrı bir şekil gösterir. Hareketi Azalt her zaman Sabit kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Статичний режим показує нерухому окрему форму для кожного стану. Зменшення руху завжди використовує статичний режим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tĩnh hiển thị một hình dạng đứng yên, riêng biệt cho mỗi trạng thái. Giảm chuyển động luôn dùng Tĩnh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Static draws a still, distinct shape for each state. Reduce Motion always uses Static."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statisch zeigt für jeden Zustand eine eigene, unbewegte Form. Bei „Bewegung reduzieren“ ist immer Statisch aktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statique affiche une forme fixe et distincte pour chaque état. Réduire les animations utilise toujours Statique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الوضع الثابت شكلًا ثابتًا ومميزًا لكل حالة. يستخدم خيار تقليل الحركة الوضع الثابت دائمًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estático muestra una forma fija y distinta para cada estado. Reducir movimiento siempre usa Estático."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜態會為每種狀態顯示一個不動且各不相同的形狀。「減少動態效果」一律使用靜態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静态会为每种状态显示一个不动且各不相同的形状。“减弱动态效果”始终使用静态。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정적은 각 상태를 움직이지 않는 고유한 모양으로 표시합니다. 동작 줄이기를 켜면 항상 정적이 사용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静的では、状態ごとに動かない別々の形を表示します。視差効果を減らすがオンのときは常に静的になります。"
          }
        }
      }
    },
