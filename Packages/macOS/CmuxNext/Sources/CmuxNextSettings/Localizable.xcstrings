    "settings.experiments.chatWidgets.help": {
      "comment": "Settings > Advanced > Experiments: the help line under the Extension Chat Widgets switch",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed extensions can show a card under a finished tool call in agent chat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للإضافات المثبتة عرض بطاقة أسفل استدعاء أداة مكتمل في دردشة الوكيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirane ekstenzije mogu prikazati karticu ispod završenog poziva alata u chatu agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerede udvidelser kan vise et kort under et afsluttet værktøjskald i agentchatten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Erweiterungen können unter einem abgeschlossenen Tool-Aufruf im Agent-Chat eine Karte anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las extensiones instaladas pueden mostrar una tarjeta debajo de una llamada a herramienta terminada en el chat del agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extensions installées peuvent afficher une carte sous un appel d’outil terminé dans le chat de l’agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le estensioni installate possono mostrare una scheda sotto una chiamata a uno strumento completata nella chat dell’agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みの拡張機能が、エージェントチャットで完了したツール呼び出しの下にカードを表示できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្នែកបន្ថែមដែលបានដំឡើងអាចបង្ហាញកាតមួយនៅក្រោមការហៅឧបករណ៍ដែលបានបញ្ចប់ក្នុងការជជែកជាមួយភ្នាក់ងារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 확장 프로그램이 에이전트 채팅에서 완료된 도구 호출 아래에 카드를 표시할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerte utvidelser kan vise et kort under et fullført verktøykall i agentchatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowane rozszerzenia mogą pokazywać kartę pod zakończonym wywołaniem narzędzia w czacie agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensões instaladas podem mostrar um cartão abaixo de uma chamada de ferramenta concluída no chat do agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установленные расширения могут показывать карточку под завершённым вызовом инструмента в чате агента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนขยายที่ติดตั้งไว้สามารถแสดงการ์ดใต้การเรียกเครื่องมือที่เสร็จแล้วในแชทของเอเจนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü uzantılar, ajan sohbetinde tamamlanan bir araç çağrısının altında bir kart gösterebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлені розширення можуть показувати картку під завершеним викликом інструмента в чаті агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tiện ích mở rộng đã cài đặt có thể hiển thị một thẻ bên dưới lệnh gọi công cụ đã hoàn tất trong cuộc trò chuyện với tác tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的扩展可以在代理聊天中已完成的工具调用下方显示一张卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的擴充功能可以在代理聊天中已完成的工具呼叫下方顯示一張卡片。"
          }
        }
      }
    },
