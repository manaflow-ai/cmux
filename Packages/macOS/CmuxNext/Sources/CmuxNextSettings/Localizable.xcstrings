    "settings.appearance.twoTone": {
      "comment": "Settings > Theme > Two-Tone: title of the setting (appearance.twoTone) that gives the sidebar and tab bar one tone and the panes another",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Two-Tone"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "ثنائي اللون"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Dvobojno"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Totonet"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Zweifarbig"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Bicolor"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Bicolore"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Bicolore"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "ツートーン"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ពីរពណ៌"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "투톤"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Totonet"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Dwukolorowy"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Duas cores"}},
