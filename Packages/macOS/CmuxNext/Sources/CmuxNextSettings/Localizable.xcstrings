    "settings.terminal.linkOpener.rules.help": {
      "comment": "Help for Terminal > Program Link Rules. Keep the rule syntax (<match> -> <target>, caller:aws, re:, the example) untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in order before the default; the first match wins. Write <match> -> <target>: caller:aws matches the program that opened the URL, and text, * wildcards or re: match the URL. Example: caller:gh github.com -> safari"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُفحص بالترتيب قبل الافتراضي، وأول تطابق يفوز. اكتب <match> -> <target>: يطابق caller:aws البرنامج الذي فتح الرابط، ويطابق النص أو أحرف * البديلة أو re: الرابط. مثال: caller:gh github.com -> safari"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provjeravaju se redom prije zadanog; prvo poklapanje pobjeđuje. Pišite <match> -> <target>: caller:aws odgovara programu koji je otvorio URL, a tekst, * zamjenski znakovi ili re: odgovaraju URL-u. Primjer: caller:gh github.com -> safari"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrolleres i rækkefølge før standarden; første match vinder. Skriv <match> -> <target>: caller:aws matcher programmet, der åbnede URL'en, og tekst, *-jokertegn eller re: matcher URL'en. Eksempel: caller:gh github.com -> safari"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Werden der Reihe nach vor dem Standard geprüft; der erste Treffer gewinnt. Schreibe <match> -> <target>: caller:aws passt auf das Programm, das die URL geöffnet hat, und Text, *-Platzhalter oder re: passen auf die URL. Beispiel: caller:gh github.com -> safari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se comprueban en orden antes del valor predeterminado; gana la primera coincidencia. Escribe <match> -> <target>: caller:aws coincide con el programa que abrió la URL, y texto, comodines * o re: coinciden con la URL. Ejemplo: caller:gh github.com -> safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiées dans l’ordre avant la valeur par défaut ; la première correspondance l’emporte. Écrivez <match> -> <target> : caller:aws correspond au programme qui a ouvert l’URL, et du texte, des jokers * ou re: correspondent à l’URL. Exemple : caller:gh github.com -> safari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controllate in ordine prima del predefinito; vince la prima corrispondenza. Scrivi <match> -> <target>: caller:aws corrisponde al programma che ha aperto l'URL, e testo, caratteri jolly * o re: corrispondono all'URL. Esempio: caller:gh github.com -> safari"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デフォルトより先に上から順に確認し、最初に一致したものが使われます。<match> -> <target> と書きます。caller:aws は URL を開いたプログラムに、テキスト、* ワイルドカード、re: は URL に一致します。例: caller:gh github.com -> safari"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពិនិត្យតាមលំដាប់មុនលំនាំដើម ការផ្គូផ្គងដំបូងឈ្នះ។ សរសេរ <match> -> <target>៖ caller:aws ផ្គូផ្គងកម្មវិធីដែលបានបើក URL ហើយអត្ថបទ តួអក្សរជំនួស * ឬ re: ផ្គូផ្គង URL។ ឧទាហរណ៍៖ caller:gh github.com -> safari"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기본값보다 먼저 순서대로 확인하며 처음 일치한 규칙이 적용됩니다. <match> -> <target> 형식으로 쓰세요. caller:aws는 URL을 연 프로그램과, 텍스트, * 와일드카드, re:는 URL과 일치합니다. 예: caller:gh github.com -> safari"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sjekkes i rekkefølge før standarden; første treff vinner. Skriv <match> -> <target>: caller:aws treffer programmet som åpnet URL-en, og tekst, *-jokertegn eller re: treffer URL-en. Eksempel: caller:gh github.com -> safari"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdzane po kolei przed wartością domyślną; wygrywa pierwsze dopasowanie. Pisz <match> -> <target>: caller:aws pasuje do programu, który otworzył URL, a tekst, symbole wieloznaczne * lub re: pasują do URL. Przykład: caller:gh github.com -> safari"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verificadas em ordem antes do padrão; a primeira correspondência vence. Escreva <match> -> <target>: caller:aws corresponde ao programa que abriu a URL, e texto, curingas * ou re: correspondem à URL. Exemplo: caller:gh github.com -> safari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверяются по порядку до значения по умолчанию; побеждает первое совпадение. Пишите <match> -> <target>: caller:aws совпадает с программой, открывшей URL, а текст, подстановочные знаки * или re: — с URL. Пример: caller:gh github.com -> safari"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจตามลำดับก่อนค่าเริ่มต้น กฎแรกที่ตรงจะถูกใช้ เขียน <match> -> <target>: caller:aws ตรงกับโปรแกรมที่เปิด URL ส่วนข้อความ ไวลด์การ์ด * หรือ re: ตรงกับ URL ตัวอย่าง: caller:gh github.com -> safari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Varsayılandan önce sırayla denetlenir; ilk eşleşme kazanır. <match> -> <target> yazın: caller:aws URL'yi açan programla, metin, * joker karakterleri veya re: URL ile eşleşir. Örnek: caller:gh github.com -> safari"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевіряються по черзі до значення за замовчуванням; перемагає перший збіг. Пишіть <match> -> <target>: caller:aws збігається з програмою, що відкрила URL, а текст, символи * або re: — з URL. Приклад: caller:gh github.com -> safari"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Được kiểm tra theo thứ tự trước giá trị mặc định; quy tắc khớp đầu tiên được dùng. Viết <match> -> <target>: caller:aws khớp với chương trình đã mở URL, còn văn bản, ký tự đại diện * hoặc re: khớp với URL. Ví dụ: caller:gh github.com -> safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在默认值之前按顺序检查，第一个匹配的规则生效。写法为 <match> -> <target>：caller:aws 匹配打开 URL 的程序，文本、* 通配符或 re: 匹配 URL。示例：caller:gh github.com -> safari"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在預設值之前依序檢查，第一個符合的規則生效。寫法為 <match> -> <target>：caller:aws 符合開啟 URL 的程式，文字、* 萬用字元或 re: 符合 URL。範例：caller:gh github.com -> safari"
          }
        }
      }
    },
    "settings.terminal.linkOpener.rules.summary": {
      "comment": "Summary under Terminal > Program Link Rules.",
      "extractionState": "manual",
      "localizations": {
        "en": {
