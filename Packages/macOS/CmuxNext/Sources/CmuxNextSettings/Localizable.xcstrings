    "settings.tabs.newTabWidgets.timer.help": {
      "comment": "Settings: help for the New Tab stopwatch widget toggle.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
