    "settings.browser.siteEngines.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites that always open in one engine: a site, such as spotify.com, and chromium or webkit. Spotify, Netflix and other protected media sites open in WebKit, because their media does not play in Chromium."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مواقع تُفتح دائمًا بمحرك واحد: موقع، مثل spotify.com، و chromium أو webkit. تُفتح Spotify و Netflix ومواقع الوسائط المحمية الأخرى في WebKit، لأن وسائطها لا تعمل في Chromium."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranice koje se uvijek otvaraju u jednom mehanizmu: stranica, kao što je spotify.com, i chromium ili webkit. Spotify, Netflix i druge stranice sa zaštićenim medijima otvaraju se u WebKitu, jer se njihovi mediji ne reproduciraju u Chromiumu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Websteder, der altid åbnes med én motor: et websted, f.eks. spotify.com, og chromium eller webkit. Spotify, Netflix og andre websteder med beskyttede medier åbnes i WebKit, fordi deres medier ikke afspilles i Chromium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Websites, die immer in einer Engine geöffnet werden: eine Website wie spotify.com und chromium oder webkit. Spotify, Netflix und andere Websites mit geschützten Medien öffnen sich in WebKit, weil ihre Medien in Chromium nicht abgespielt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitios que siempre se abren con un motor: un sitio, como spotify.com, y chromium o webkit. Spotify, Netflix y otros sitios con contenido protegido se abren en WebKit, porque su contenido no se reproduce en Chromium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sites toujours ouverts avec un moteur : un site, comme spotify.com, et chromium ou webkit. Spotify, Netflix et d’autres sites de médias protégés s’ouvrent dans WebKit, car leurs médias ne sont pas lus dans Chromium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siti che si aprono sempre con un motore: un sito, come spotify.com, e chromium o webkit. Spotify, Netflix e altri siti con contenuti protetti si aprono in WebKit, perché i loro contenuti non vengono riprodotti in Chromium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "常に 1 つのエンジンで開くサイトです。spotify.com などのサイトと、chromium または webkit を指定します。Spotify、Netflix などの保護されたメディアのサイトは、Chromium では再生できないため WebKit で開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គេហទំព័រដែលតែងតែបើកក្នុងម៉ាស៊ីនមួយ៖ គេហទំព័រ ដូចជា spotify.com និង chromium ឬ webkit ។ Spotify, Netflix និងគេហទំព័រមេឌៀដែលបានការពារផ្សេងទៀតបើកក្នុង WebKit ព្រោះមេឌៀរបស់វាមិនចាក់ក្នុង Chromium ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "항상 한 엔진으로 여는 사이트입니다. spotify.com 같은 사이트와 chromium 또는 webkit을 지정합니다. Spotify, Netflix 및 기타 보호된 미디어 사이트는 Chromium에서 미디어가 재생되지 않으므로 WebKit으로 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nettsteder som alltid åpnes med én motor: et nettsted, for eksempel spotify.com, og chromium eller webkit. Spotify, Netflix og andre nettsteder med beskyttede medier åpnes i WebKit, fordi mediene deres ikke spilles av i Chromium."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Witryny, które zawsze otwierają się w jednym silniku: witryna, np. spotify.com, oraz chromium lub webkit. Spotify, Netflix i inne witryny z chronionymi multimediami otwierają się w WebKit, ponieważ ich multimedia nie odtwarzają się w Chromium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sites que sempre abrem em um motor: um site, como spotify.com, e chromium ou webkit. Spotify, Netflix e outros sites de mídia protegida abrem no WebKit, porque a mídia deles não toca no Chromium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сайты, которые всегда открываются в одном движке: сайт, например spotify.com, и chromium или webkit. Spotify, Netflix и другие сайты с защищённым контентом открываются в WebKit, потому что их медиа не воспроизводятся в Chromium."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เว็บไซต์ที่เปิดด้วยเอนจินเดียวเสมอ: เว็บไซต์ เช่น spotify.com และ chromium หรือ webkit โดย Spotify, Netflix และเว็บไซต์สื่อที่มีการป้องกันอื่นๆ จะเปิดใน WebKit เพราะสื่อของเว็บไซต์เหล่านี้เล่นใน Chromium ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her zaman tek bir motorla açılan siteler: spotify.com gibi bir site ve chromium veya webkit. Spotify, Netflix ve diğer korumalı medya siteleri, medyaları Chromium’da oynatılmadığı için WebKit’te açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сайти, що завжди відкриваються в одному рушії: сайт, як-от spotify.com, і chromium або webkit. Spotify, Netflix та інші сайти із захищеним вмістом відкриваються у WebKit, бо їхні медіа не відтворюються в Chromium."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các trang luôn mở bằng một công cụ: một trang, như spotify.com, và chromium hoặc webkit. Spotify, Netflix và các trang phương tiện được bảo vệ khác mở trong WebKit, vì phương tiện của chúng không phát được trong Chromium."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "始终使用同一引擎打开的网站：填写网站（如 spotify.com）以及 chromium 或 webkit。Spotify、Netflix 等受保护媒体网站会在 WebKit 中打开，因为其媒体无法在 Chromium 中播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一律以同一引擎開啟的網站：填寫網站（例如 spotify.com）以及 chromium 或 webkit。Spotify、Netflix 等受保護媒體網站會在 WebKit 中開啟，因為其媒體無法在 Chromium 中播放。"
          }
        }
      }
    },
