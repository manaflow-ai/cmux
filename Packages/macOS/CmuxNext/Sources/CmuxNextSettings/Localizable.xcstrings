    "settings.workspaces.autoName.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unnamed workspace shows its front tab's name. Your own name always wins."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض مساحة العمل غير المسمّاة اسم علامة التبويب الأمامية. الاسم الذي تختاره يفوز دائمًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neimenovani radni prostor prikazuje ime svoje prednje kartice. Vaše ime uvijek ima prednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et unavngivet arbejdsområde viser navnet på sin forreste fane. Dit eget navn vinder altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein unbenannter Arbeitsbereich zeigt den Namen seines vorderen Tabs. Dein eigener Name hat immer Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espacio de trabajo sin nombre muestra el de su pestaña principal. Tu propio nombre siempre prevalece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espace de travail sans nom affiche le nom de son onglet au premier plan. Votre propre nom l’emporte toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uno spazio di lavoro senza nome mostra il nome della sua scheda in primo piano. Il tuo nome ha sempre la precedenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "名前のないワークスペースには前面のタブの名前が表示されます。自分で付けた名前が常に優先されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការដែលគ្មានឈ្មោះ បង្ហាញឈ្មោះផ្ទាំងខាងមុខរបស់វា។ ឈ្មោះដែលអ្នកដាក់ខ្លួនឯងតែងតែឈ្នះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이름이 없는 워크스페이스는 앞쪽 탭의 이름을 표시합니다. 직접 지정한 이름이 항상 우선합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et arbeidsområde uten navn viser navnet på fanen foran. Ditt eget navn vinner alltid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nienazwana przestrzeń robocza pokazuje nazwę swojej karty na wierzchu. Twoja własna nazwa zawsze wygrywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um espaço de trabalho sem nome mostra o nome da aba da frente. O nome que você der sempre prevalece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Безымянное рабочее пространство показывает имя своей передней вкладки. Ваше собственное имя всегда важнее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เวิร์กสเปซที่ไม่มีชื่อจะแสดงชื่อของแท็บด้านหน้า ชื่อที่คุณตั้งเองมีผลเหนือกว่าเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adlandırılmamış bir çalışma alanı öndeki sekmesinin adını gösterir. Kendi verdiğiniz ad her zaman önceliklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочий простір без назви показує назву передньої вкладки. Ваша власна назва завжди має перевагу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc chưa đặt tên sẽ hiện tên của thẻ phía trước. Tên bạn tự đặt luôn được ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未命名的工作区会显示其前台标签页的名称。你自己起的名称始终优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未命名的工作區會顯示其前景分頁的名稱。你自己取的名稱永遠優先。"
          }
        }
      }
    },
