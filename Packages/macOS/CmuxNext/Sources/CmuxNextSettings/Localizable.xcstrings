    "settings.workspaceHibernation.hiddenSpaceMinutes.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دقائق الخمول قبل إسبات مساحات العمل في مساحة لا تعرضها أي نافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minute neaktivnosti prije nego što hiberniraju radni prostori prostora koji nijedan prozor ne prikazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inaktive minutter, før arbejdsområderne i et rum, som intet vindue viser, går i dvale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inaktive Minuten, bevor die Workspaces eines Space, den kein Fenster zeigt, in den Ruhezustand gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle minutes before the workspaces of a space no window shows hibernate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minutos de inactividad antes de que hibernen los espacios de trabajo de un espacio que ninguna ventana muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minutes d’inactivité avant la mise en veille des espaces de travail d’un espace qu’aucune fenêtre n’affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minuti di inattività prima che vadano in ibernazione i workspace di uno spazio che nessuna finestra mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "どのウインドウにも表示されていないスペースのワークスペースがハイバネートするまでのアイドル時間（分）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចំនួននាទីទំនេរ មុនពេលកន្លែងធ្វើការនៃលំហដែលគ្មានបង្អួចបង្ហាញ ផ្អាក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어떤 창에도 표시되지 않는 스페이스의 워크스페이스가 최대 절전 모드로 전환되기까지의 유휴 시간(분)입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inaktive minutter før arbeidsområdene i et område som ingen vinduer viser, går i dvale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minuty bezczynności, po których hibernują obszary robocze przestrzeni niewidocznej w żadnym oknie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minutos de inatividade até hibernarem os espaços de trabalho de um espaço que nenhuma janela mostra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Минуты бездействия до гибернации рабочих областей пространства, которое не показано ни в одном окне."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จำนวนนาทีที่ไม่ได้ใช้งานก่อนที่เวิร์กสเปซของพื้นที่ที่ไม่มีหน้าต่างแสดงจะพัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiçbir pencerenin göstermediği bir alanın çalışma alanları bekletilmeden önceki boşta dakika."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хвилини бездіяльності, після яких робочі області простору, якого не показує жодне вікно, переходять у гібернацію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Số phút nhàn rỗi trước khi các workspace của một không gian không có cửa sổ nào hiển thị sẽ ngủ đông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有窗口显示的空间中，其工作区闲置多少分钟后休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有視窗顯示的空間中，工作區休眠前的閒置分鐘數。"
          }
        }
      }
    },
    "settings.workspaceHibernation.idleMinutes": {
