    "settings.agentPane.display.senderIcon.badge.help": {
      "comment": "Settings: the agent chat's sender icon rows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The small colored glyph on a sender's icon that tells sessions of one model family apart."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الرمز الملوّن الصغير على أيقونة المرسل الذي يميّز بين جلسات عائلة النموذج نفسها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mali obojeni znak na ikoni pošiljaoca koji razlikuje sesije iste porodice modela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det lille farvede tegn på en afsenders ikon, der skelner sessioner fra samme modelfamilie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das kleine farbige Zeichen am Absendersymbol, das Sitzungen derselben Modellfamilie unterscheidet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El pequeño glifo de color en el icono del remitente que distingue las sesiones de una misma familia de modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le petit glyphe coloré sur l’icône de l’expéditeur qui distingue les sessions d’une même famille de modèles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il piccolo glifo colorato sull’icona del mittente che distingue le sessioni della stessa famiglia di modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同じモデルファミリーのセッションを見分ける、送信者アイコン上の小さな色付きグリフ。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សញ្ញាពណ៌តូចលើរូបតំណាងអ្នកផ្ញើ ដែលបែងចែកវគ្គនៃគ្រួសារម៉ូដែលតែមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "같은 모델 계열의 세션을 구분하는 발신자 아이콘의 작은 색상 글리프."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det lille fargede tegnet på et avsenderikon som skiller økter i samme modellfamilie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mały kolorowy znak na ikonie nadawcy, który odróżnia sesje jednej rodziny modeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O pequeno glifo colorido no ícone do remetente que distingue sessões da mesma família de modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Небольшой цветной знак на значке отправителя, различающий сеансы одного семейства моделей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สัญลักษณ์สีเล็กๆ บนไอคอนผู้ส่งที่แยกเซสชันของตระกูลโมเดลเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aynı model ailesinin oturumlarını ayıran, gönderen simgesindeki küçük renkli işaret."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невеликий кольоровий знак на значку відправника, що розрізняє сеанси одного сімейства моделей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ký hiệu màu nhỏ trên biểu tượng người gửi giúp phân biệt các phiên cùng dòng mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发送者图标上的小彩色符号，用于区分同一模型系列的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "傳送者圖示上的小彩色符號，用於區分同一模型系列的工作階段。"
          }
        }
      }
    },
