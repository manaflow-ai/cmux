    "settings.workspaceColors.indicatorStyle.help": {
      "comment": "Settings > Appearance > Sidebar: help for the workspace color style choice",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يظهر لون مساحة العمل في الشريط الجانبي: نقطة قبل اسمها، أو شريط على حافة الصف، أو الصف كله مملوء باللون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako se boja radnog prostora prikazuje na bočnoj traci: tačka ispred imena, traka uz rub reda ili cijeli red ispunjen bojom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sådan vises et arbejdsområdes farve i sidepanelet: en prik før navnet, en streg langs rækkens kant eller hele rækken fyldt med farven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Farbe eines Workspace in der Seitenleiste erscheint: ein Punkt vor dem Namen, ein Balken am Rand der Zeile oder die ganze Zeile in der Farbe gefüllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How a workspace's color shows in the sidebar: a dot before its name, a bar down the row's edge, or the whole row filled with the color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se muestra el color de un espacio de trabajo en la barra lateral: un punto antes del nombre, una barra en el borde de la fila o toda la fila rellena con el color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment la couleur d’un espace de travail apparaît dans la barre latérale : un point devant son nom, une barre le long du bord de la ligne ou toute la ligne remplie de la couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come appare il colore di un’area di lavoro nella barra laterale: un punto prima del nome, una barra lungo il bordo della riga o l’intera riga riempita con il colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーでのワークスペースの色の表示方法：名前の前の点、行の端に沿ったバー、または行全体をその色で塗りつぶします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របៀបដែលពណ៌កន្លែងធ្វើការបង្ហាញនៅក្នុងរបារចំហៀង៖ ចំណុចមួយនៅមុខឈ្មោះ របារមួយតាមគែមជួរ ឬជួរទាំងមូលបំពេញដោយពណ៌។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 워크스페이스 색상을 표시하는 방식: 이름 앞의 점, 행 가장자리의 막대, 또는 행 전체를 색상으로 채우기."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik vises fargen til et arbeidsområde i sidefeltet: en prikk foran navnet, en strek langs radens kant eller hele raden fylt med fargen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak kolor obszaru roboczego wyświetla się na pasku bocznym: kropka przed nazwą, pasek wzdłuż krawędzi wiersza lub cały wiersz wypełniony kolorem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a cor de um espaço de trabalho aparece na barra lateral: um ponto antes do nome, uma barra na borda da linha ou a linha inteira preenchida com a cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как цвет рабочего пространства показан на боковой панели: точка перед названием, полоса по краю строки или вся строка, залитая цветом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีแสดงสีของพื้นที่ทำงานในแถบด้านข้าง: จุดหน้าชื่อ แถบตามขอบแถว หรือเติมสีทั้งแถว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çalışma alanının renginin kenar çubuğunda nasıl görüneceği: adının önünde bir nokta, satırın kenarında bir çubuk veya renkle doldurulmuş satırın tamamı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як колір робочого простору показано на бічній панелі: крапка перед назвою, смуга вздовж краю рядка або весь рядок, залитий кольором."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách màu của không gian làm việc hiển thị ở thanh bên: một chấm trước tên, một thanh dọc mép hàng, hoặc tô màu cả hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区颜色在边栏中的显示方式：名称前的圆点、沿行边缘的竖条，或用该颜色填充整行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區顏色在側邊欄中的顯示方式：名稱前的圓點、沿列邊緣的直條，或以該顏色填滿整列。"
          }
        }
      }
    },
