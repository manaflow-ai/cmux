    "settings.sidebar.side.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, the window buttons sit over the tab bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "右にすると、ウインドウのボタンはタブバーの上に表示されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند وضعه على اليمين، تظهر أزرار النافذة فوق شريط علامات التبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desno, dugmad prozora su iznad trake kartica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Til højre sidder vinduesknapperne over fanebjælken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rechts liegen die Fenstertasten über der Tableiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A la derecha, los botones de la ventana quedan sobre la barra de pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À droite, les boutons de la fenêtre se placent sur la barre d’onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A destra, i pulsanti della finestra stanno sopra la barra delle schede."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅខាងស្តាំ ប៊ូតុងបង្អួចស្ថិតនៅលើរបារផ្ទាំង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오른쪽에 두면 윈도우 버튼이 탭 막대 위에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Til høyre ligger vindusknappene over fanelinjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po prawej przyciski okna są nad paskiem kart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À direita, os botões da janela ficam sobre a barra de abas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Справа кнопки окна располагаются над панелью вкладок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หากอยู่ทางขวา ปุ่มหน้าต่างจะอยู่เหนือแถบแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sağda, pencere düğmeleri sekme çubuğunun üzerinde durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Праворуч кнопки вікна розташовуються над панеллю вкладок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
