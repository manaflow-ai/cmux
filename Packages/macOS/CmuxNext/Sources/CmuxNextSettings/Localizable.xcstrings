    "settings.agents.subsessions.maxDepth.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many levels of sub-sessions can start under a session. 1 lets a session start sub-sessions that cannot start their own."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد مستويات الجلسات الفرعية التي يمكن أن تبدأ تحت جلسة. القيمة 1 تتيح لجلسة بدء جلسات فرعية لا يمكنها بدء جلسات خاصة بها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko nivoa podsesija može započeti ispod jedne sesije. 1 dozvoljava sesiji da pokreće podsesije koje ne mogu pokretati vlastite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange niveauer af undersessioner der kan starte under en session. 1 lader en session starte undersessioner, som ikke kan starte deres egne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Ebenen von Untersitzungen unter einer Sitzung starten können. Bei 1 kann eine Sitzung Untersitzungen starten, die selbst keine starten können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos niveles de subsesiones pueden iniciarse bajo una sesión. Con 1, una sesión puede iniciar subsesiones que no pueden iniciar las suyas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de niveaux de sous-sessions pouvant démarrer sous une session. Avec 1, une session peut démarrer des sous-sessions qui ne peuvent pas en démarrer elles-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti livelli di sottosessioni possono avviarsi sotto una sessione. Con 1 una sessione può avviare sottosessioni che non possono avviarne di proprie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのセッションの下に何階層までサブセッションを開始できるかを指定します。1 にすると、セッションはサブセッションを開始できますが、そのサブセッションは自身のサブセッションを開始できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំនួនកម្រិតនៃវគ្គរងដែលអាចចាប់ផ្ដើមនៅក្រោមវគ្គមួយ។ 1 អនុញ្ញាតឱ្យវគ្គមួយចាប់ផ្ដើមវគ្គរង ដែលមិនអាចចាប់ផ្ដើមវគ្គរងផ្ទាល់ខ្លួនបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 세션 아래에서 하위 세션을 몇 단계까지 시작할 수 있는지 정합니다. 1이면 세션이 하위 세션을 시작할 수 있지만, 그 하위 세션은 자체 하위 세션을 시작할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange nivåer med underøkter som kan starte under en økt. 1 lar en økt starte underøkter som ikke kan starte sine egne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile poziomów podsesji może się uruchomić pod jedną sesją. 1 pozwala sesji uruchamiać podsesje, które nie mogą uruchamiać własnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos níveis de subsessões podem ser iniciados sob uma sessão. Com 1, uma sessão pode iniciar subsessões que não podem iniciar as próprias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько уровней вложенных сеансов может запускаться под сеансом. При значении 1 сеанс может запускать вложенные сеансы, которые не могут запускать свои."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนระดับของเซสชันย่อยที่เริ่มได้ภายใต้เซสชันหนึ่ง ค่า 1 ให้เซสชันเริ่มเซสชันย่อยได้ แต่เซสชันย่อยนั้นเริ่มของตัวเองไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oturumun altında kaç düzey alt oturum başlayabileceği. 1, bir oturumun kendi alt oturumunu başlatamayan alt oturumlar başlatmasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки рівнів вкладених сеансів може запускатися під сеансом. Значення 1 дозволяє сеансу запускати вкладені сеанси, які не можуть запускати власних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số cấp phiên con có thể bắt đầu bên dưới một phiên. Giá trị 1 cho phép một phiên bắt đầu các phiên con không thể tự bắt đầu phiên con của riêng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个会话下可以启动多少层子会话。设为 1 时，会话可以启动子会话，但这些子会话不能再启动自己的子会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個工作階段下可以啟動多少層子工作階段。設為 1 時，工作階段可以啟動子工作階段，但這些子工作階段不能再啟動自己的子工作階段。"
          }
        }
      }
    },
