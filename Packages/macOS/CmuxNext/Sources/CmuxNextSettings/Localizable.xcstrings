    "settings.ui.paneAnimations.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits, closes, moves, zooms and column scrolls slide into place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割、閉じる、移動、ズーム、列のスクロールがスライドして収まります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنزلق عمليات التقسيم والإغلاق والنقل والتكبير وتمرير الأعمدة إلى أماكنها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dijeljenja, zatvaranja, premještanja, zumiranja i pomicanja kolona klize na mjesto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opdelinger, lukninger, flytninger, zoom og kolonnerulning glider på plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teilen, Schließen, Verschieben, Zoomen und Spaltenscrollen gleiten an ihren Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las divisiones, cierres, movimientos, zooms y desplazamientos de columnas se deslizan a su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les divisions, fermetures, déplacements, zooms et défilements de colonnes glissent en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisioni, chiusure, spostamenti, zoom e scorrimenti delle colonne scorrono in posizione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការបំបែក ការបិទ ការផ្លាស់ទី ការពង្រីក និងការរំកិលជួរឈរ រអិលចូលកន្លែង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "분할, 닫기, 이동, 확대/축소, 열 스크롤이 미끄러지듯 자리를 잡습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Delinger, lukkinger, flyttinger, zoom og kolonnerulling glir på plass."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podziały, zamknięcia, przeniesienia, powiększenia i przewijanie kolumn wsuwają się na miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisões, fechamentos, movimentos, zooms e rolagens de colunas deslizam até o lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разделение, закрытие, перемещение, масштабирование и прокрутка колонок плавно встают на место."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแบ่ง การปิด การย้าย การซูม และการเลื่อนคอลัมน์จะเลื่อนเข้าที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bölme, kapatma, taşıma, yakınlaştırma ve sütun kaydırma kayarak yerine oturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розділення, закриття, переміщення, масштабування і прокручування колонок плавно стають на місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chia, đóng, di chuyển, phóng to và cuộn cột trượt vào chỗ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拆分、关闭、移动、缩放和列滚动会滑动到位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割、關閉、移動、縮放和欄捲動會滑動到位。"
          }
        }
      }
    },
