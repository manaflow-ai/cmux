          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Яка панель отримує фокус, коли закривається активна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khung nào nhận tiêu điểm khi khung đang có tiêu điểm đóng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
