          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откуда берутся цвета групп. Цвет, выбранный для группы, остаётся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แหล่งที่มาของสีกลุ่ม สีที่คุณเลือกให้กลุ่มจะคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grup renklerinin kaynağı. Bir grup için seçtiğiniz renk kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звідки беруться кольори груп. Колір, вибраний для групи, залишається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nguồn màu của các nhóm. Màu bạn chọn cho một nhóm vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分组颜色的来源。你为分组选的颜色会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "群組顏色的來源。你為群組選的顏色會保留。"
          }
        }
      }
    },
