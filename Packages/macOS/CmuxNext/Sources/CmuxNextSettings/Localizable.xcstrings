    "settings.updates.showWhatsNew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show What's New After Updates"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار ما الجديد بعد التحديثات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži šta je novo nakon ažuriranja"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis nyheder efter opdateringer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuigkeiten nach Updates anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar novedades tras actualizar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les nouveautés après les mises à jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le novità dopo gli aggiornamenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後に新機能を表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញអ្វីដែលថ្មីបន្ទាប់ពីការធ្វើបច្ចុប្បន្នភាព"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 후 새로운 기능 표시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis nyheter etter oppdateringer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj nowości po aktualizacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar novidades após atualizações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать новое после обновлений"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสิ่งใหม่หลังอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemelerden Sonra Yenilikleri Göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати нове після оновлень"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện Có gì mới sau khi cập nhật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新后显示新功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新後顯示新功能"
          }
        }
      }
    },
    "settings.updates.showWhatsNew.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After an update, a card at the bottom of the sidebar links to What's New until you open or dismiss it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد التحديث، تظهر بطاقة أسفل الشريط الجانبي تفتح «ما الجديد» حتى تفتحها أو تغلقها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon ažuriranja, kartica na dnu bočne trake vodi na Šta je novo dok je ne otvorite ili zatvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter en opdatering viser et kort nederst i indholdsoversigten et link til Nyheder, indtil du åbner eller lukker det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Update führt eine Karte unten in der Seitenleiste zu „Neuigkeiten“, bis du sie öffnest oder schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una actualización, una tarjeta abajo en la barra lateral enlaza a Novedades hasta que la abras o la cierres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une mise à jour, une carte en bas de la barre latérale mène aux Nouveautés jusqu’à ce que vous l’ouvriez ou la fermiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un aggiornamento, una scheda in fondo alla barra laterale porta a Novità finché non la apri o la chiudi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後、開くか閉じるまでサイドバーの下部に「新機能」へのカードが表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ទាប់ពីធ្វើបច្ចុប្បន្នភាព កាតមួយនៅខាងក្រោមរបារចំហៀងភ្ជាប់ទៅ អ្វីដែលថ្មី រហូតដល់អ្នកបើក ឬបិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 후 사이드바 아래쪽에 새로운 기능으로 이동하는 카드가 열거나 닫을 때까지 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter en oppdatering viser et kort nederst i sidepanelet til Nyheter til du åpner eller lukker det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po aktualizacji karta na dole paska bocznego prowadzi do Co nowego, dopóki jej nie otworzysz lub nie zamkniesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após uma atualização, um cartão na parte de baixo da barra lateral leva às Novidades até você abrir ou fechar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После обновления карточка внизу боковой панели ведёт в «Что нового», пока вы её не откроете или не закроете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังอัปเดต การ์ดที่ด้านล่างของแถบด้านข้างจะลิงก์ไปยังมีอะไรใหม่จนกว่าคุณจะเปิดหรือปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir güncellemeden sonra, siz açana veya kapatana kadar kenar çubuğunun altında Yenilikler'e giden bir kart görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після оновлення картка внизу бічної панелі веде до «Що нового», доки ви її не відкриєте або не закриєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi cập nhật, một thẻ ở cuối thanh bên dẫn tới Có gì mới cho đến khi bạn mở hoặc đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新后，边栏底部会显示一张通往“新功能”的卡片，直到你打开或关闭它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新後，側邊欄底部會顯示一張通往「新功能」的卡片，直到你打開或關閉它。"
          }
        }
      }
    },
