    "settings.layout.focusFollowsMouse.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovering or scrolling a pane focuses it"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التمرير فوق جزء أو تحريك المؤشر عليه ينقل التركيز إليه"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prelazak mišem ili pomicanje preko okna ga fokusira"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du holder over eller ruller i en rude, får den fokus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigen auf einen Bereich oder Scrollen darin fokussiert ihn"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasar el puntero o desplazarse sobre un panel lo enfoca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Survoler ou faire défiler un panneau lui donne le focus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passare sopra un riquadro o scorrerlo lo rende attivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペインにポインタを重ねるかスクロールするとフォーカスされます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការដាក់ទស្សន៍ទ្រនិច ឬរំកិលលើផ្ទាំង នឹងផ្ដោតលើវា"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "창 위에 포인터를 올리거나 스크롤하면 포커스됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du holder over eller ruller i en rute, får den fokus"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najechanie lub przewinięcie panelu ustawia na nim fokus"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passar o ponteiro ou rolar sobre um painel o coloca em foco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наведение или прокрутка панели переводит на неё фокус"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การวางเมาส์หรือเลื่อนบนบานหน้าต่างจะโฟกัสบานนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir bölmenin üzerine gelmek veya kaydırmak ona odaklanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Наведення або прокручування панелі переводить на неї фокус"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di chuột hoặc cuộn trên một ô sẽ đặt tiêu điểm vào ô đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "悬停或滚动窗格时聚焦该窗格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "懸停或捲動窗格時聚焦該窗格"
          }
        }
      }
    },
    "settings.layout.focusFollowsMouse.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the pointer onto a pane or scrolling over it focuses that pane. Off keeps focus where you type until you click. Momentum and the first second after typing never move focus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نقل المؤشر إلى جزء أو التمرير فوقه ينقل التركيز إلى ذلك الجزء. عند الإيقاف يبقى التركيز حيث تكتب حتى تنقر. التمرير بالقصور الذاتي والثانية الأولى بعد الكتابة لا ينقلان التركيز أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomicanje pokazivača na okno ili skrolanje preko njega fokusira to okno. Kada je isključeno, fokus ostaje gdje kucate dok ne kliknete. Inercijsko skrolanje i prva sekunda nakon kucanja nikad ne pomiču fokus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du flytter markøren hen over en rude eller ruller i den, får ruden fokus. Når det er slået fra, bliver fokus, hvor du skriver, indtil du klikker. Inerti-rulning og det første sekund efter indtastning flytter aldrig fokus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn der Zeiger auf einen Bereich bewegt oder darin gescrollt wird, erhält dieser Bereich den Fokus. Aus lässt den Fokus dort, wo du tippst, bis du klickst. Nachlaufendes Scrollen und die erste Sekunde nach dem Tippen verschieben den Fokus nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover el puntero a un panel o desplazarse sobre él lo enfoca. Desactivado, el foco se queda donde escribes hasta que hagas clic. La inercia y el primer segundo después de escribir nunca mueven el foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déplacer le pointeur sur un panneau ou le faire défiler lui donne le focus. Désactivé, le focus reste là où vous tapez jusqu’à un clic. L’inertie et la première seconde après la saisie ne déplacent jamais le focus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spostare il puntatore su un riquadro o scorrerlo lo rende attivo. Se disattivato, lo stato attivo resta dove scrivi finché non fai clic. L’inerzia e il primo secondo dopo la digitazione non spostano mai lo stato attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ペインにポインタを移動するか、その上でスクロールすると、そのペインにフォーカスします。オフの場合、クリックするまで入力中の場所にフォーカスが残ります。慣性スクロールと入力後1秒以内はフォーカスを移動しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការផ្លាស់ទីទស្សន៍ទ្រនិចទៅលើផ្ទាំង ឬរំកិលលើវា នឹងផ្ដោតលើផ្ទាំងនោះ។ ពេលបិទ ការផ្ដោតនៅកន្លែងដែលអ្នកវាយ រហូតដល់អ្នកចុច។ ការរំកិលបន្តដោយសន្ទុះ និងវិនាទីដំបូងក្រោយការវាយ មិនផ្លាស់ការផ្ដោតឡើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포인터를 창으로 옮기거나 창 위에서 스크롤하면 그 창에 포커스됩니다. 끄면 클릭할 때까지 입력 중인 곳에 포커스가 유지됩니다. 관성 스크롤과 입력 후 1초 동안은 포커스를 옮기지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du flytter pekeren til en rute eller ruller i den, får ruten fokus. Av beholder fokus der du skriver til du klikker. Treghetsrulling og det første sekundet etter skriving flytter aldri fokus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przesunięcie wskaźnika na panel lub przewinięcie go ustawia na nim fokus. Wyłączone zostawia fokus tam, gdzie piszesz, aż klikniesz. Przewijanie bezwładnościowe i pierwsza sekunda po pisaniu nigdy nie przenoszą fokusu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mover o ponteiro para um painel ou rolar sobre ele coloca o painel em foco. Desativado, o foco fica onde você digita até você clicar. A inércia e o primeiro segundo após digitar nunca movem o foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перемещение указателя на панель или прокрутка над ней переводит на неё фокус. Если выключено, фокус остаётся там, где вы печатаете, пока вы не щёлкнете. Инерционная прокрутка и первая секунда после ввода никогда не перемещают фокус."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเลื่อนตัวชี้ไปบนบานหน้าต่างหรือเลื่อนบนบานนั้นจะโฟกัสบานนั้น เมื่อปิด โฟกัสจะอยู่ที่ที่คุณพิมพ์จนกว่าคุณจะคลิก การเลื่อนต่อเนื่องและวินาทีแรกหลังพิมพ์จะไม่ย้ายโฟกัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İşaretçiyi bir bölmeye götürmek veya üzerinde kaydırmak o bölmeye odaklanır. Kapalıyken odak, tıklayana kadar yazdığınız yerde kalır. Atalet kaydırması ve yazdıktan sonraki ilk saniye odağı asla taşımaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переміщення вказівника на панель або прокручування над нею переводить на неї фокус. Якщо вимкнено, фокус лишається там, де ви друкуєте, доки ви не клацнете. Інерційне прокручування й перша секунда після введення ніколи не переміщують фокус."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di chuyển con trỏ vào một ô hoặc cuộn trên ô đó sẽ đặt tiêu điểm vào ô. Khi tắt, tiêu điểm ở nơi bạn gõ cho đến khi bạn nhấp. Cuộn quán tính và giây đầu tiên sau khi gõ không bao giờ di chuyển tiêu điểm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将指针移到窗格上或在其上滚动会聚焦该窗格。关闭时，焦点停留在你输入的位置，直到你点击。惯性滚动和输入后的第一秒不会移动焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將指標移到窗格上或在其上捲動會聚焦該窗格。關閉時，焦點會停留在你輸入的位置，直到你點按。慣性捲動和輸入後的第一秒不會移動焦點。"
          }
        }
      }
    },
