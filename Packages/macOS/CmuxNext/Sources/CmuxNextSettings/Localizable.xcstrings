    "settings.agentPane.display.sendPop.help": {
      "comment": "Settings > Appearance > Agent Chat > Pop In Sent Prompts: help",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يظهر الطلب الذي ترسله بحركة ويستقر في مكانه بدلًا من الظهور فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upit koji pošaljete iskoči i smiri se na svom mjestu, umjesto da se odmah pojavi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En prompt, du sender, popper ind og falder på plads i stedet for at dukke op med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein gesendeter Prompt springt herein und setzt sich an seinen Platz, statt sofort zu erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prompt you send pops in and settles where it lands, instead of appearing at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un prompt que envías aparece con un pequeño salto y se asienta en su sitio, en lugar de aparecer de golpe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un prompt envoyé apparaît avec un petit rebond et se pose à sa place, au lieu d'apparaître d'un coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un prompt inviato compare con un piccolo balzo e si assesta al suo posto, invece di apparire di colpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "送信したプロンプトが即座に表示される代わりに、ポップして所定の位置に収まります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "prompt ដែលអ្នកផ្ញើលោតចូល ហើយតាំងនៅកន្លែងរបស់វា ជំនួសឲ្យការបង្ហាញភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보낸 프롬프트가 바로 나타나는 대신 튀어나온 뒤 제자리에 자리 잡습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En prompt du sender, spretter inn og legger seg på plass i stedet for å vises med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysłany prompt wskakuje i osiada na swoim miejscu, zamiast pojawić się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um prompt enviado surge com um pequeno salto e se acomoda no lugar, em vez de aparecer de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отправленный запрос появляется с лёгким толчком и встаёт на место, а не возникает сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "prompt ที่คุณส่งจะเด้งเข้ามาแล้วลงตัวในตำแหน่ง แทนที่จะปรากฏทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönderdiğiniz istem hemen görünmek yerine küçük bir sıçrayışla gelip yerine oturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Надісланий запит з'являється з легким поштовхом і стає на місце, а не виникає одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lời nhắc bạn gửi bật vào rồi nằm yên tại chỗ, thay vì hiện ra ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你发送的提示会弹入并落定到位，而不是立即出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你傳送的提示會彈入並落定到位，而不是立即出現。"
          }
        }
      }
    },
