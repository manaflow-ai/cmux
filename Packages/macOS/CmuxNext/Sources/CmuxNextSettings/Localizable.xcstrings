    "settings.sidebar.nav.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صفوف في أعلى الشريط الجانبي تشغّل إجراءات cmux، حسب معرّف الإجراء، واختياريًا \"id | Title | symbol\". الفارغ لا يعرض شيئًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redovi na vrhu bočne trake koji pokreću cmux radnje, po ID-u radnje, opcionalno \"id | Title | symbol\". Prazno ne prikazuje ništa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rækker øverst i sidepanelet, der kører cmux-handlinger efter handlings-id, eventuelt \"id | Title | symbol\". Tom viser ingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeilen oben in der Seitenleiste, die cmux-Aktionen ausführen, nach Aktions-ID, optional \"id | Title | symbol\". Leer zeigt keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows at the top of the sidebar that run cmux actions, by action id, optionally \"id | Title | symbol\". Empty shows none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filas en la parte superior de la barra lateral que ejecutan acciones de cmux, por id de acción, opcionalmente \"id | Title | symbol\". Vacío no muestra ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lignes en haut de la barre latérale qui lancent des actions cmux, par identifiant d'action, éventuellement \"id | Title | symbol\". Vide n'en affiche aucune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Righe in cima alla barra laterale che eseguono azioni cmux, per id azione, facoltativamente \"id | Title | symbol\". Vuoto non ne mostra nessuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバー上部に並ぶ、cmux のアクションを実行する行。アクション ID で指定し、必要なら \"id | Title | symbol\"。空なら表示しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជួរ​នៅ​ខាង​លើ​របារ​ចំហៀង​ដែល​ដំណើរការ​សកម្មភាព cmux តាម​លេខ​សម្គាល់​សកម្មភាព ឬ \"id | Title | symbol\"។ ទទេ​មិន​បង្ហាញ​អ្វី​ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바 맨 위에서 cmux 작업을 실행하는 행으로, 작업 ID로 지정하며 필요하면 \"id | Title | symbol\" 형식을 씁니다. 비어 있으면 표시하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rader øverst i sidefeltet som kjører cmux-handlinger etter handlings-ID, eventuelt \"id | Title | symbol\". Tom viser ingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiersze u góry paska bocznego uruchamiające akcje cmux, według identyfikatora akcji, opcjonalnie \"id | Title | symbol\". Pusta lista nic nie pokazuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linhas no topo da barra lateral que executam ações do cmux, por id de ação, opcionalmente \"id | Title | symbol\". Vazio não mostra nenhuma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строки вверху боковой панели, запускающие действия cmux, по идентификатору действия, при желании \"id | Title | symbol\". Пусто: ничего не показывается."
