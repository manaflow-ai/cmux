    "settings.markdown.remoteImages.help": {
      "comment": "Settings help for automatic Markdown web images",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image sites can see your address and when you open a document."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لمواقع الصور رؤية عنوانك ووقت فتح المستند."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Web lokacije sa slikama mogu vidjeti vašu adresu i kada otvorite dokument."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Websteder med billeder kan se din adresse, og hvornår du åbner et dokument."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bild-Websites können deine Adresse sehen und wann du ein Dokument öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los sitios de imágenes pueden ver tu dirección y cuándo abres un documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sites d'images peuvent voir votre adresse et quand vous ouvrez un document."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I siti che ospitano immagini possono vedere il tuo indirizzo e quando apri un documento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画像のサイトには、あなたのアドレスとドキュメントを開いた時刻が伝わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គេហទំព័ររូបភាពអាចមើលឃើញអាសយដ្ឋានរបស់អ្នក និងពេលអ្នកបើកឯកសារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이미지 사이트는 사용자의 주소와 문서를 연 시간을 알 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nettsteder som leverer bilder, kan se adressen din og når du åpner et dokument."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Witryny z obrazami mogą zobaczyć Twój adres i czas otwarcia dokumentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sites de imagens podem ver seu endereço e quando você abre um documento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сайты с изображениями могут узнать ваш адрес и время открытия документа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เว็บไซต์รูปภาพสามารถเห็นที่อยู่ของคุณและเวลาที่คุณเปิดเอกสาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Görsel siteleri adresinizi ve bir belgeyi ne zaman açtığınızı görebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сайти із зображеннями можуть дізнатися вашу адресу й час відкриття документа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các trang hình ảnh có thể thấy địa chỉ của bạn và thời điểm bạn mở tài liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "图片网站可以看到你的地址和打开文档的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "圖片網站可以看到你的位址和開啟文件的時間。"
          }
        }
      }
    },
