    "settings.layout.rows.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off hides New Row and fits a column's existing rows into it without scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると「新しい行」が非表示になり、列の既存の行はスクロールせずに列に収まります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند الإيقاف يُخفى «صف جديد» وتُلائم صفوف العمود الحالية العمود دون تمرير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isključeno skriva Novi red i smješta postojeće redove kolone u nju bez pomicanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fra skjuler Ny række og tilpasser en kolonnes eksisterende rækker til den uden rulning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aus blendet „Neue Zeile“ aus und passt die vorhandenen Zeilen einer Spalte ohne Scrollen in sie ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado oculta Nueva fila y ajusta las filas existentes de una columna a ella sin desplazamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé masque Nouvelle ligne et ajuste les lignes existantes d’une colonne sans défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattivato nasconde Nuova riga e adatta le righe esistenti di una colonna senza scorrimento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បិទ នឹងលាក់ ជួរដេកថ្មី ហើយដាក់ជួរដេកដែលមានស្រាប់ឱ្យសមនឹងជួរឈរ ដោយគ្មានការរំកិល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끄면 새 행이 숨겨지고 열의 기존 행이 스크롤 없이 열에 맞춰집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Av skjuler Ny rad og tilpasser en kolonnes eksisterende rader til den uten rulling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłączone ukrywa Nowy wiersz i dopasowuje istniejące wiersze kolumny bez przewijania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado oculta Nova Linha e ajusta as linhas existentes de uma coluna sem rolagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выключено: скрывает «Новая строка» и вписывает существующие строки столбца без прокрутки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดจะซ่อนแถวใหม่ และจัดแถวที่มีอยู่ของคอลัมน์ให้พอดีโดยไม่เลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalıyken Yeni Satır gizlenir ve sütunun mevcut satırları kaydırma olmadan sığdırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкнено: приховує «Новий рядок» і вміщує наявні рядки стовпця без прокручування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt sẽ ẩn Hàng mới và xếp vừa các hàng hiện có của cột mà không cuộn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "关闭后会隐藏“新建行”，并将列中已有的行适配到列内，不滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "關閉後會隱藏「新增列」，並將欄中現有的列調整至欄內，不捲動。"
          }
        }
      }
    },
