    "settings.sidebar.hoverCards.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card with details opens when the pointer rests on a workspace or a tab."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح بطاقة بالتفاصيل عندما يستقر المؤشر على مساحة عمل أو علامة تبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica s detaljima se otvara kada pokazivač miruje na radnom prostoru ili kartici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kort med detaljer åbner, når markøren hviler på et arbejdsområde eller en fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte mit Details öffnet sich, wenn der Zeiger auf einem Workspace oder Tab ruht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre una tarjeta con detalles cuando el puntero se detiene sobre un espacio de trabajo o una pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte détaillée s'ouvre quand le pointeur reste sur un espace de travail ou un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre una scheda con i dettagli quando il puntatore si ferma su uno spazio di lavoro o una scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタをワークスペースやタブの上に置くと、詳細を示すカードが開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កាតដែលមានព័ត៌មានលម្អិតបើកនៅពេលទស្សន៍ទ្រនិចនៅលើកន្លែងធ្វើការ ឬផ្ទាំង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 워크스페이스나 탭 위에 두면 세부 정보 카드가 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kort med detaljer åpnes når pekeren hviler på et arbeidsområde eller en fane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta ze szczegółami otwiera się, gdy wskaźnik zatrzyma się na obszarze roboczym lub karcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão com detalhes abre quando o ponteiro para sobre um espaço de trabalho ou uma aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточка с подробностями открывается, когда указатель задерживается на рабочем пространстве или вкладке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดพร้อมรายละเอียดจะเปิดขึ้นเมื่อวางตัวชี้ไว้บนเวิร์กสเปซหรือแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçi bir çalışma alanı veya sekme üzerinde durduğunda ayrıntıları içeren bir kart açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картка з подробицями відкривається, коли вказівник зупиняється на робочому просторі або вкладці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thẻ chi tiết sẽ mở khi con trỏ dừng trên một không gian làm việc hoặc một tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针停留在工作区或标签页上时，会打开一张详情卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標停留在工作區或分頁上時，會開啟一張詳細資訊卡片。"
          }
        }
      }
    },
