    "settings.mobile.terminalSizing.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decides the size of a terminal while this Mac and a phone show it at once. A device that gets a larger terminal than it fits scrolls sideways or shows empty space; text never wraps wrong. Set the priority order in the cmux app on your iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحدد حجم الطرفية عندما يعرضها هذا الـ Mac وهاتف في الوقت نفسه. الجهاز الذي يحصل على طرفية أكبر مما يتسع له يمرر أفقيًا أو يعرض مساحة فارغة، ولا يلتف النص بشكل خاطئ أبدًا. اضبط ترتيب الأولوية في تطبيق cmux على iPhone."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Određuje veličinu terminala dok ga ovaj Mac i telefon prikazuju istovremeno. Uređaj koji dobije veći terminal nego što stane klizi bočno ili prikazuje prazan prostor; tekst se nikad ne prelama pogrešno. Redoslijed prioriteta postavite u aplikaciji cmux na iPhoneu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestemmer størrelsen på en terminal, mens denne Mac og en telefon viser den samtidig. En enhed, der får en større terminal end den kan rumme, ruller sidelæns eller viser tom plads; teksten ombrydes aldrig forkert. Angiv prioritetsrækkefølgen i cmux-appen på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legt die Größe eines Terminals fest, während dieser Mac und ein Telefon es gleichzeitig zeigen. Ein Gerät, das ein größeres Terminal bekommt, als es darstellen kann, scrollt seitwärts oder zeigt leeren Raum; Text wird nie falsch umbrochen. Die Prioritätsreihenfolge legst du in der cmux-App auf deinem iPhone fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Decide el tamaño de un terminal mientras este Mac y un teléfono lo muestran a la vez. Un dispositivo que recibe un terminal más grande de lo que cabe se desplaza de lado o muestra espacio vacío; el texto nunca se ajusta mal. Define el orden de prioridad en la app cmux de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Détermine la taille d’un terminal quand ce Mac et un téléphone l’affichent en même temps. Un appareil qui reçoit un terminal plus grand que son écran défile latéralement ou affiche un espace vide ; le texte n’est jamais mal renvoyé à la ligne. Définissez l’ordre de priorité dans l’app cmux de votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Decide la dimensione di un terminale mentre questo Mac e un telefono lo mostrano insieme. Un dispositivo che riceve un terminale più grande di quanto possa contenere scorre lateralmente o mostra spazio vuoto; il testo non va mai a capo in modo errato. Imposta l’ordine di priorità nell’app cmux su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac とスマートフォンが同時にターミナルを表示しているときのサイズを決めます。収まらない大きさのターミナルを受け取ったデバイスは横にスクロールするか空白を表示し、テキストが誤って折り返されることはありません。優先順位は iPhone の cmux アプリで設定します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំណត់ទំហំ Terminal ពេល Mac នេះ និងទូរសព្ទបង្ហាញវាក្នុងពេលតែមួយ។ ឧបករណ៍ដែលទទួលបាន Terminal ធំជាងអេក្រង់ រំកិលទៅចំហៀង ឬបង្ហាញចន្លោះទទេ ហើយអត្ថបទមិនដែលបត់ខុសទេ។ កំណត់លំដាប់អាទិភាពនៅក្នុងកម្មវិធី cmux លើ iPhone។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac과 휴대폰이 동시에 터미널을 표시할 때 터미널 크기를 정합니다. 화면보다 큰 터미널을 받은 기기는 옆으로 스크롤하거나 빈 공간을 표시하며, 텍스트가 잘못 줄바꿈되지 않습니다. 우선순위는 iPhone의 cmux 앱에서 설정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestemmer størrelsen på en terminal mens denne Macen og en telefon viser den samtidig. En enhet som får en større terminal enn den har plass til, ruller sidelengs eller viser tomt område; teksten brytes aldri feil. Angi prioritetsrekkefølgen i cmux-appen på iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Określa rozmiar terminala, gdy ten Mac i telefon wyświetlają go jednocześnie. Urządzenie, które dostaje terminal większy, niż się mieści, przewija go w bok lub pokazuje puste miejsce; tekst nigdy nie jest źle zawijany. Kolejność priorytetów ustawisz w aplikacji cmux na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Decide o tamanho de um terminal enquanto este Mac e um telefone o exibem ao mesmo tempo. Um dispositivo que recebe um terminal maior do que cabe rola para os lados ou mostra espaço vazio; o texto nunca quebra errado. Defina a ordem de prioridade no app cmux do iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Определяет размер терминала, когда его одновременно показывают этот Mac и телефон. Устройство, которому достался терминал больше экрана, прокручивает его вбок или показывает пустое место; текст никогда не переносится неправильно. Порядок приоритета задаётся в приложении cmux на iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำหนดขนาดเทอร์มินัลเมื่อ Mac เครื่องนี้และโทรศัพท์แสดงพร้อมกัน อุปกรณ์ที่ได้เทอร์มินัลใหญ่กว่าหน้าจอจะเลื่อนไปด้านข้างหรือแสดงพื้นที่ว่าง ข้อความจะไม่ตัดบรรทัดผิด ตั้งลำดับความสำคัญได้ในแอป cmux บน iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac ve bir telefon bir terminali aynı anda gösterirken boyutunu belirler. Sığdığından büyük bir terminal alan cihaz yana kaydırır veya boş alan gösterir; metin asla yanlış kaydırılmaz. Öncelik sırasını iPhone’daki cmux uygulamasında ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Визначає розмір термінала, коли його одночасно показують цей Mac і телефон. Пристрій, якому дістався термінал більший за екран, прокручує його вбік або показує порожнє місце; текст ніколи не переноситься неправильно. Порядок пріоритету задається в застосунку cmux на iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quyết định kích thước terminal khi máy Mac này và điện thoại cùng hiển thị. Thiết bị nhận terminal lớn hơn màn hình sẽ cuộn ngang hoặc hiện khoảng trống; chữ không bao giờ xuống dòng sai. Đặt thứ tự ưu tiên trong ứng dụng cmux trên iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "决定这台 Mac 和手机同时显示终端时的终端大小。收到超出屏幕的终端的设备会横向滚动或显示空白，文字绝不会错误换行。在 iPhone 上的 cmux App 中设置优先顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "決定這台 Mac 和手機同時顯示終端機時的大小。收到超出螢幕的終端機的裝置會橫向捲動或顯示空白，文字絕不會錯誤換行。在 iPhone 上的 cmux App 中設定優先順序。"
          }
        }
      }
    },
