        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนหน่วยความจำ โดยเก็บประวัติและตำแหน่งเลื่อนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belleği boşaltır; geçmiş ve kaydırma korunur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звільняє пам’ять; історія й прокрутка зберігаються"
