    "settings.agents.cacheCompact.enabled.help": {
      "comment": "Settings > General > Prompt Cache: help under the compact-before-expiry toggle; names its cost",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يضغط محادثة Claude الخاملة بينما لا تزال ذاكرة التخزين المؤقت دافئة، فتكلّف الرسالة التالية أقل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sažima neaktivan Claude chat dok je keš topao, da sljedeća poruka košta manje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komprimerer en inaktiv Claude-chat, mens cachen er varm, så næste besked koster mindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komprimiert einen ruhenden Claude-Chat, solange sein Cache warm ist, damit die nächste Nachricht weniger kostet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacts an idle Claude chat while its cache is warm, so the next message costs less."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compacta un chat de Claude inactivo mientras su caché sigue activa, para que el siguiente mensaje cueste menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compacte un chat Claude inactif tant que son cache est actif, pour que le message suivant coûte moins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compatta una chat di Claude inattiva mentre la cache è ancora attiva, così il messaggio successivo costa meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アイドル状態の Claude チャットをキャッシュが有効なうちに圧縮し、次のメッセージのコストを抑えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្រួមការជជែក Claude ដែលទំនេរ ខណៈឃ្លាំងសម្ងាត់នៅក្តៅ ដូច្នេះសារបន្ទាប់ចំណាយតិចជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "유휴 Claude 채팅을 캐시가 유지되는 동안 압축해 다음 메시지 비용을 줄입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komprimerer en inaktiv Claude-chat mens hurtigbufferen er varm, så neste melding koster mindre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kompaktuje bezczynny czat Claude, póki pamięć podręczna jest aktywna, aby następna wiadomość kosztowała mniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compacta um chat ocioso do Claude enquanto o cache está ativo, para que a próxima mensagem custe menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сжимает простаивающий чат Claude, пока кэш активен, чтобы следующее сообщение стоило меньше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บีบอัดแชต Claude ที่ว่างขณะที่แคชยังอุ่นอยู่ เพื่อให้ข้อความถัดไปมีค่าใช้จ่ายน้อยลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boştaki bir Claude sohbetini önbelleği sıcakken sıkıştırır; böylece sonraki mesaj daha ucuza gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стискає неактивний чат Claude, поки кеш активний, щоб наступне повідомлення коштувало менше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nén cuộc trò chuyện Claude đang rảnh khi bộ nhớ đệm còn ấm, để tin nhắn tiếp theo tốn ít hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在缓存仍有效时压缩空闲的 Claude 聊天，让下一条消息更便宜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在快取仍有效時壓縮閒置的 Claude 聊天，讓下一則訊息費用更低。"
          }
        }
      }
    },
    "settings.agents.cacheCompact.minContext": {
      "comment": "Settings > General > Prompt Cache: number field, the share of the context window (percent) a chat must use before it is compacted",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط فوق نسبة السياق المستخدم (%)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo iznad iskorištenog konteksta (%)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun over brugt kontekst (%)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ab genutztem Kontext (%)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Above Context Used (%)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo por encima del contexto usado (%)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement au-delà du contexte utilisé (%)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo oltre il contesto usato (%)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用コンテキストがこれを超える場合のみ (%)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តែលើសបរិបទដែលបានប្រើ (%)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용한 컨텍스트가 이 값 이상일 때만 (%)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare over brukt kontekst (%)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko powyżej użytego kontekstu (%)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só acima do contexto usado (%)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только при использовании контекста выше (%)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมื่อใช้บริบทเกิน (%)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kullanılan bağlam üzerinde (%)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише понад використаний контекст (%)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi ngữ cảnh đã dùng vượt (%)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在上下文使用率超过时 (%)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在上下文使用率超過時 (%)"
          }
        }
      }
    },
    "settings.agents.cacheCompact.minContext.help": {
      "comment": "Settings > General > Prompt Cache: help under the context threshold field",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُترك المحادثات التي تستخدم أقل من هذه النسبة من نافذة السياق كما هي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatovi koji koriste manje konteksta od ovoga ostaju kakvi jesu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, der bruger mindre af kontekstvinduet end dette, lades være."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, die weniger ihres Kontextfensters nutzen, bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats using less of their context window than this are left as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats que usan menos de su ventana de contexto que esto se dejan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chats qui utilisent moins de leur fenêtre de contexte restent tels quels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat che usano meno della loro finestra di contesto restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストウィンドウの使用量がこれ未満のチャットはそのままにします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat ដែលប្រើបរិបទតិចជាងនេះ ត្រូវបានទុកដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트 창을 이보다 적게 쓰는 채팅은 그대로 둡니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatter som bruker mindre av kontekstvinduet enn dette, blir latt være."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czaty używające mniej okna kontekstu pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats que usam menos da janela de contexto que isso ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты, использующие меньше окна контекста, остаются как есть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตที่ใช้บริบทน้อยกว่านี้จะไม่ถูกเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlam penceresini bundan az kullanan sohbetler olduğu gibi bırakılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чати, що використовують менше вікна контексту, залишаються як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện dùng ít ngữ cảnh hơn mức này được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文窗口使用量低于此值的聊天保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文視窗使用量低於此值的聊天保持不變。"
          }
        }
      }
    },
