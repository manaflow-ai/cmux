    "settings.home.server.help": {
      "comment": "Settings help (home.server): cmux Cloud by default, or a self-hosted server over Tailscale. Keep the example address unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-hosted: a Tailscale MagicDNS address, such as http://mini.tail1234.ts.net:7320."
          }
        },
        "ar": {
          "stringUnit": {
