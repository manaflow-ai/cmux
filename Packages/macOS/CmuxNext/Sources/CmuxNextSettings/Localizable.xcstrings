            "value": "Command + រំកិល ផ្លាស់ទីជួរឈរ និងជួរដេក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + 스크롤로 열과 행 이동"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommando + rulling flytter kolonner og rader"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + przewijanie przesuwa kolumny i wiersze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + rolagem move colunas e linhas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + прокрутка двигает столбцы и строки"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + เลื่อน เพื่อย้ายคอลัมน์และแถว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + kaydırma sütunları ve satırları taşır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + прокручування рухає стовпці й рядки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + cuộn để di chuyển cột và hàng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + 滚动可移动列和行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + 捲動可移動欄與列"
          }
        }
      }
    },
    "settings.layout.scrollModifier.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command + Scroll moves columns and rows from anywhere, and a plain scroll always scrolls the pane under the pointer. Without a modifier, a sideways scroll moves columns unless the pane scrolls sideways itself, and rows scroll only over the gaps between them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + التمرير ينقل الأعمدة والصفوف من أي مكان، والتمرير العادي يمرر دائمًا الجزء الموجود تحت المؤشر. بدون مفتاح تعديل، ينقل التمرير الجانبي الأعمدة ما لم يكن الجزء نفسه يتمرر جانبيًا، ولا تتمرر الصفوف إلا فوق الفجوات بينها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + pomicanje pomjera kolone i redove s bilo kojeg mjesta, a obično pomicanje uvijek pomiče okno ispod pokazivača. Bez modifikatora, bočno pomicanje pomjera kolone osim ako se okno samo ne pomiče bočno, a redovi se pomiču samo iznad razmaka između njih."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + rul flytter kolonner og rækker overalt, og en almindelig rulning ruller altid ruden under markøren. Uden en ændringstast flytter en sidelæns rulning kolonnerne, medmindre ruden selv ruller sidelæns, og rækker ruller kun over mellemrummene mellem dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Befehl + Scrollen bewegt Spalten und Zeilen von überall, und einfaches Scrollen scrollt immer den Bereich unter dem Zeiger. Ohne Sondertaste bewegt seitliches Scrollen die Spalten, außer der Bereich scrollt selbst seitlich, und Zeilen scrollen nur über den Lücken zwischen ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comando + desplazamiento mueve columnas y filas desde cualquier lugar, y un desplazamiento normal siempre desplaza el panel bajo el puntero. Sin modificador, un desplazamiento lateral mueve las columnas salvo que el panel se desplace de lado por sí mismo, y las filas solo se desplazan sobre los espacios entre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commande + défilement déplace colonnes et rangées depuis n’importe où, et un défilement simple fait toujours défiler la sous-fenêtre sous le pointeur. Sans touche de modification, un défilement latéral déplace les colonnes sauf si la sous-fenêtre défile elle-même latéralement, et les rangées ne défilent qu’au-dessus des espaces qui les séparent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comando + scorrimento sposta colonne e righe da qualsiasi punto, e uno scorrimento semplice scorre sempre il riquadro sotto il puntatore. Senza modificatore, uno scorrimento laterale sposta le colonne a meno che il riquadro non scorra lateralmente da sé, e le righe scorrono solo sopra gli spazi tra di esse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command + スクロールで、どこからでも列と行を動かせます。修飾キーなしのスクロールは、常にポインタの下のペインをスクロールします。修飾キーを使わない設定では、ペイン自体が横にスクロールする場合を除き横スクロールで列が動き、行は行の間のすき間の上でだけスクロールします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + រំកិល ផ្លាស់ទីជួរឈរ និងជួរដេកពីគ្រប់ទីកន្លែង ហើយការរំកិលធម្មតាតែងតែរំកិលផ្ទាំងនៅក្រោមទ្រនិច។ បើគ្មានគ្រាប់ចុចកែប្រែ ការរំកិលទៅចំហៀងផ្លាស់ទីជួរឈរ លុះត្រាតែផ្ទាំងខ្លួនឯងរំកិលទៅចំហៀង ហើយជួរដេករំកិលតែនៅលើចន្លោះរវាងពួកវាប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + 스크롤은 어디서든 열과 행을 이동하고, 일반 스크롤은 항상 포인터 아래의 패인을 스크롤합니다. 보조 키 없이 사용하면 패인 자체가 가로로 스크롤되지 않는 한 가로 스크롤이 열을 이동하고, 행은 행 사이의 간격 위에서만 스크롤됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kommando + rulling flytter kolonner og rader fra hvor som helst, og vanlig rulling ruller alltid ruten under pekeren. Uten valgtast flytter sidelengs rulling kolonnene med mindre ruten selv ruller sidelengs, og rader ruller bare over mellomrommene mellom dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + przewijanie przesuwa kolumny i wiersze z dowolnego miejsca, a zwykłe przewijanie zawsze przewija panel pod wskaźnikiem. Bez modyfikatora przewijanie w bok przesuwa kolumny, chyba że panel sam przewija się w bok, a wiersze przewijają się tylko nad odstępami między nimi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + rolagem move colunas e linhas de qualquer lugar, e uma rolagem simples sempre rola o painel sob o ponteiro. Sem modificador, uma rolagem lateral move as colunas, a menos que o próprio painel role de lado, e as linhas só rolam sobre os espaços entre elas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + прокрутка двигает столбцы и строки из любого места, а обычная прокрутка всегда прокручивает панель под указателем. Без клавиши-модификатора прокрутка вбок двигает столбцы, если панель сама не прокручивается вбок, а строки прокручиваются только над промежутками между ними."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + เลื่อน ย้ายคอลัมน์และแถวได้จากทุกที่ และการเลื่อนปกติจะเลื่อนบานหน้าต่างใต้ตัวชี้เสมอ หากไม่ใช้ปุ่มปรับแต่ง การเลื่อนด้านข้างจะย้ายคอลัมน์ เว้นแต่บานหน้าต่างเลื่อนด้านข้างได้เอง และแถวจะเลื่อนเฉพาะเหนือช่องว่างระหว่างแถวเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + kaydırma sütunları ve satırları her yerden taşır; düz kaydırma her zaman işaretçinin altındaki bölmeyi kaydırır. Değiştirici tuş olmadan, bölme kendisi yana kaymıyorsa yana kaydırma sütunları taşır ve satırlar yalnızca aralarındaki boşlukların üzerinde kayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + прокручування рухає стовпці й рядки з будь-якого місця, а звичайне прокручування завжди прокручує панель під вказівником. Без клавіші-модифікатора прокручування вбік рухає стовпці, якщо панель сама не прокручується вбік, а рядки прокручуються лише над проміжками між ними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + cuộn di chuyển cột và hàng từ bất kỳ đâu, còn cuộn thường luôn cuộn ngăn dưới con trỏ. Khi không dùng phím bổ trợ, cuộn ngang di chuyển các cột trừ khi chính ngăn đó cuộn ngang, và hàng chỉ cuộn trên khoảng trống giữa chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + 滚动可在任意位置移动列和行，普通滚动始终滚动指针下的窗格。不使用修饰键时，横向滚动会移动列（除非窗格本身可横向滚动），行只在行之间的间隙上滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Command + 捲動可在任何位置移動欄與列，一般捲動一律捲動指標下方的窗格。不使用修飾鍵時，橫向捲動會移動欄（除非窗格本身可橫向捲動），列只在列之間的間隙上捲動。"
          }
        }
      }
    },
