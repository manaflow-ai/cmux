            "value": "需要你處理"
          }
        }
      }
    },
    "settings.agentPane.needsYou.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge in the chat header counts what your agents wait on; a click lists every ask with its answers. New agent tabs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارة في رأس المحادثة تعدّ ما ينتظرك فيه وكلاؤك؛ والنقر عليها يعرض كل طلب مع إجاباته. علامات تبويب الوكلاء الجديدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Značka u zaglavlju razgovora broji ono na šta vaši agenti čekaju; klik prikazuje svaki upit s odgovorima. Nove kartice agenata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et mærke i chattens top tæller, hvad dine agenter venter på; et klik viser hver forespørgsel med dens svar. Nye agentfaner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Badge im Chat-Kopf zählt, worauf deine Agenten warten; ein Klick listet jede Anfrage mit ihren Antworten. Neue Agenten-Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una insignia en la cabecera del chat cuenta lo que esperan tus agentes; un clic muestra cada solicitud con sus respuestas. Pestañas de agente nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un badge dans l'en-tête du chat compte ce que vos agents attendent ; un clic liste chaque demande avec ses réponses. Nouveaux onglets d'agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un badge nell'intestazione della chat conta ciò che aspettano i tuoi agenti; un clic elenca ogni richiesta con le sue risposte. Nuove schede agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのヘッダーのバッジに、エージェントが待っている件数を表示します。クリックすると、すべての確認を回答とともに一覧表示します。新しいエージェントタブ。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្លាកមួយនៅក្បាលការជជែក រាប់អ្វីដែលភ្នាក់ងាររបស់អ្នកកំពុងរង់ចាំ ការចុចបង្ហាញរាល់សំណើជាមួយចម្លើយរបស់វា។ ផ្ទាំងភ្នាក់ងារថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 헤더의 배지에 에이전트가 기다리는 요청 수를 표시합니다. 클릭하면 모든 요청을 답변과 함께 보여 줍니다. 새 에이전트 탭."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et merke i chattens topp teller hva agentene dine venter på; et klikk viser hver forespørsel med svarene. Nye agentfaner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plakietka w nagłówku czatu liczy to, na co czekają twoi agenci; kliknięcie pokazuje każdą prośbę z odpowiedziami. Nowe karty agentów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um selo no cabeçalho do chat conta o que seus agentes esperam; um clique lista cada pedido com suas respostas. Novas abas de agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок в заголовке чата считает, чего ждут ваши агенты; щелчок показывает каждый запрос с ответами. Новые вкладки агентов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้ายบนส่วนหัวของแชตนับสิ่งที่เอเจนต์ของคุณรออยู่ คลิกเพื่อดูทุกคำขอพร้อมคำตอบ แท็บเอเจนต์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet başlığındaki rozet, ajanlarınızın beklediklerini sayar; tıklayınca her isteği yanıtlarıyla listeler. Yeni ajan sekmeleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок у заголовку чату рахує, на що чекають ваші агенти; клацання показує кожен запит із відповідями. Нові вкладки агентів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một huy hiệu ở đầu cuộc trò chuyện đếm những gì tác tử của bạn đang chờ; nhấp để xem mọi yêu cầu kèm câu trả lời. Tab tác tử mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话标题栏的徽章显示智能体在等你处理的数量；点按即可列出每个请求及其回答。新的智能体标签页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話標題列的徽章顯示代理在等你處理的數量；點按即可列出每個請求及其回答。新的代理標籤頁。"
          }
        }
      }
    },
