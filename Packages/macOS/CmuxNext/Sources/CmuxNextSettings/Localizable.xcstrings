            "value": "Obszary robocze obok siebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espaços de trabalho lado a lado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рабочие пространства рядом"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เวิร์กสเปซเคียงข้างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yan Yana Çalışma Alanları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочі простори поруч"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc cạnh nhau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作区并排显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作區並排顯示"
          }
        }
      }
    },
    "settings.sidebar.sideBySide.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يتم التبديل عند الضغط على صف مساحة العمل إلا عند تحريره، فيمكنك الضغط مع السحب وإسقاط الصف على حافة جزء لعرض مساحة العمل بجانب الحالية. تظهر مساحات العمل المعروضة على الشاشة بتمييز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pritisak na red radnog prostora mijenja prostor tek kad ga otpustite, pa možete držati i povući red na rub okna da se taj radni prostor prikaže pored trenutnog. Radni prostori na ekranu su istaknuti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et tryk på en arbejdsområderække skifter først, når du slipper, så du kan holde og trække rækken hen på kanten af et panel for at vise arbejdsområdet ved siden af det aktuelle. Arbejdsområder på skærmen fremhæves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Klick auf eine Arbeitsbereich-Zeile wechselt erst beim Loslassen, sodass du die Zeile halten und an den Rand eines Bereichs ziehen kannst, um diesen Arbeitsbereich neben dem aktuellen anzuzeigen. Angezeigte Arbeitsbereiche sind hervorgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A press on a workspace row switches only when you release it, so you can hold and drag the row onto a pane's edge to show that workspace beside the current one. Workspaces on screen are highlighted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al pulsar una fila de espacio de trabajo, solo se cambia al soltar, así que puedes mantenerla y arrastrarla al borde de un panel para mostrar ese espacio de trabajo junto al actual. Los espacios de trabajo en pantalla aparecen resaltados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un appui sur une ligne d’espace de travail ne change d’espace qu’au relâchement : vous pouvez maintenir et faire glisser la ligne sur le bord d’un volet pour afficher cet espace de travail à côté de l’actuel. Les espaces de travail à l’écran sont surlignés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premere una riga di workspace cambia workspace solo al rilascio, così puoi tenere premuto e trascinare la riga sul bordo di un riquadro per mostrare quel workspace accanto a quello attuale. I workspace sullo schermo sono evidenziati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペースの行を押しても、指を離すまで切り替わりません。押したまま行をペインの端にドラッグすると、そのワークスペースを現在のものの横に表示できます。画面に表示中のワークスペースはハイライトされます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចុចលើជួរកន្លែងធ្វើការនឹងប្តូរតែពេលអ្នកលែង ដូច្នេះអ្នកអាចសង្កត់ហើយអូសជួរទៅគែមផ្ទាំង ដើម្បីបង្ហាញកន្លែងធ្វើការនោះក្បែរកន្លែងបច្ចុប្បន្ន។ កន្លែងធ្វើការដែលនៅលើអេក្រង់ត្រូវបានគូសបញ្ជាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "워크스페이스 행을 눌러도 손을 뗄 때까지 전환되지 않으므로, 행을 누른 채 패널 가장자리로 드래그하면 현재 워크스페이스 옆에 해당 워크스페이스를 표시할 수 있습니다. 화면에 표시된 워크스페이스는 강조됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et trykk på en arbeidsområderad bytter først når du slipper, så du kan holde og dra raden til kanten av et panel for å vise arbeidsområdet ved siden av det gjeldende. Arbeidsområder på skjermen er uthevet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naciśnięcie wiersza obszaru roboczego przełącza go dopiero po zwolnieniu, więc możesz przytrzymać i przeciągnąć wiersz na krawędź panelu, aby pokazać ten obszar roboczy obok bieżącego. Obszary robocze widoczne na ekranie są wyróżnione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pressionar uma linha de espaço de trabalho só troca ao soltar, então você pode segurar e arrastar a linha até a borda de um painel para mostrar esse espaço de trabalho ao lado do atual. Os espaços de trabalho na tela ficam destacados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нажатие на строку рабочего пространства переключает его только при отпускании, поэтому можно зажать строку и перетащить её к краю панели, чтобы показать это рабочее пространство рядом с текущим. Рабочие пространства на экране выделены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การกดแถวเวิร์กสเปซจะสลับเมื่อคุณปล่อยเท่านั้น คุณจึงกดค้างแล้วลากแถวไปที่ขอบของบานหน้าต่างเพื่อแสดงเวิร์กสเปซนั้นข้างเวิร์กสเปซปัจจุบันได้ เวิร์กสเปซที่แสดงบนหน้าจอจะถูกไฮไลต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir çalışma alanı satırına basmak yalnızca bıraktığınızda geçiş yapar; böylece satırı basılı tutup bir bölmenin kenarına sürükleyerek o çalışma alanını mevcut olanın yanında gösterebilirsiniz. Ekrandaki çalışma alanları vurgulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Натискання рядка робочого простору перемикає його лише після відпускання, тож можна утримувати рядок і перетягнути його до краю панелі, щоб показати цей робочий простір поруч із поточним. Робочі простори на екрані виділено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhấn vào một dòng không gian làm việc chỉ chuyển khi bạn nhả ra, nên bạn có thể giữ và kéo dòng đó đến cạnh của một ngăn để hiện không gian làm việc đó bên cạnh không gian hiện tại. Các không gian làm việc trên màn hình được làm nổi bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按下工作区行时，松开后才会切换，因此你可以按住该行并拖到窗格边缘，在当前工作区旁边显示该工作区。屏幕上显示的工作区会高亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按下工作區列時，放開後才會切換，因此你可以按住該列並拖到窗格邊緣，在目前工作區旁邊顯示該工作區。螢幕上顯示的工作區會醒目標示。"
          }
        }
      }
    },
