    "settings.sidebar.side.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window edge the sidebar sits on. On the right, the window buttons sit over the tab bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーを置くウインドウの端。右にすると、ウインドウのボタンはタブバーの上に表示されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حافة النافذة التي يوجد عليها الشريط الجانبي. عند وضعه على اليمين، تظهر أزرار النافذة فوق شريط علامات التبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ivica prozora na kojoj je bočna traka. Desno, dugmad prozora su iznad trake kartica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den kant af vinduet, sidepanelet sidder ved. Til højre sidder vinduesknapperne over fanebjælken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Fensterrand, an dem die Seitenleiste sitzt. Rechts liegen die Fenstertasten über der Tableiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El borde de la ventana donde está la barra lateral. A la derecha, los botones de la ventana quedan sobre la barra de pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bord de la fenêtre où se trouve la barre latérale. À droite, les boutons de la fenêtre se placent sur la barre d’onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il bordo della finestra su cui si trova la barra laterale. A destra, i pulsanti della finestra stanno sopra la barra delle schede."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គែមបង្អួចដែលរបារចំហៀងស្ថិតនៅ។ នៅខាងស្តាំ ប៊ូតុងបង្អួចស្ថិតនៅលើរបារផ្ទាំង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바가 놓이는 윈도우 가장자리입니다. 오른쪽에 두면 윈도우 버튼이 탭 막대 위에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vinduskanten sidefeltet ligger ved. Til høyre ligger vindusknappene over fanelinjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krawędź okna, przy której jest pasek boczny. Po prawej przyciski okna są nad paskiem kart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A borda da janela onde fica a barra lateral. À direita, os botões da janela ficam sobre a barra de abas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Край окна, у которого находится боковая панель. Справа кнопки окна располагаются над панелью вкладок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขอบหน้าต่างที่แถบด้านข้างอยู่ หากอยู่ทางขวา ปุ่มหน้าต่างจะอยู่เหนือแถบแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğunun bulunduğu pencere kenarı. Sağda, pencere düğmeleri sekme çubuğunun üzerinde durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Край вікна, біля якого розташована бічна панель. Праворуч кнопки вікна розташовуються над панеллю вкладок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cạnh cửa sổ nơi đặt thanh bên. Khi ở bên phải, các nút cửa sổ nằm trên thanh tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "侧边栏所在的窗口边缘。放在右侧时，窗口按钮位于标签栏上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄所在的視窗邊緣。放在右側時，視窗按鈕位於標籤列上方。"
          }
        }
      }
    },
