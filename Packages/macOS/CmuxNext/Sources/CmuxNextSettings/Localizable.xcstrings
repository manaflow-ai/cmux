    "settings.sidebar.minimal.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض صفوف مساحات العمل أيقونتها واسمها وعلامة غير المقروء فقط، وتصبح عناوين الأقسام خطوطًا رفيعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redovi radnih prostora prikazuju samo ikonu, naziv i oznaku nepročitanog, a naslovi odjeljaka postaju tanke linije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbejdsområderækker viser kun ikon, navn og ulæst-mærke, og sektionstitler bliver til tynde streger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbeitsbereichszeilen zeigen nur Symbol, Namen und Ungelesen-Markierung, und Abschnittstitel werden zu dünnen Linien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspace rows show only their icon, name and unread mark, and section titles become thin lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las filas de los espacios de trabajo solo muestran su icono, nombre y marca de no leído, y los títulos de sección se vuelven líneas finas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les lignes des espaces de travail n’affichent que leur icône, leur nom et la marque non lu, et les titres de section deviennent de fines lignes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le righe degli spazi di lavoro mostrano solo icona, nome e indicatore di non letto, e i titoli delle sezioni diventano linee sottili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースの行にはアイコン、名前、未読マークだけを表示し、セクションのタイトルは細い線になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជួរកន្លែងធ្វើការបង្ហាញតែរូបតំណាង ឈ្មោះ និងសញ្ញាមិនទាន់អាន ហើយចំណងជើងផ្នែកក្លាយជាបន្ទាត់ស្តើង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간 행에는 아이콘, 이름, 읽지 않음 표시만 나타나고 섹션 제목은 얇은 선이 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbeidsområderader viser bare ikon, navn og ulest-merke, og seksjonstitler blir tynne streker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiersze obszarów roboczych pokazują tylko ikonę, nazwę i znacznik nieprzeczytanych, a tytuły sekcji stają się cienkimi liniami."
