        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una notificación avisa mientras cmux no es la app activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une notification alerte alors que cmux n’est pas l’app active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una notifica avvisa mentre cmux non è l’app attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がアクティブなアプリでないときに通知が届いた場合。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលការជូនដំណឹងព្រមាន ខណៈ cmux មិនមែនជាកម្មវិធីសកម្ម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 활성 앱이 아닐 때 알림이 오면."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et varsel gir beskjed mens cmux ikke er den aktive appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy powiadomienie ostrzega, a cmux nie jest aktywną aplikacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma notificação alerta enquanto o cmux não é o app ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда приходит уведомление, а cmux не активное приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีการแจ้งเตือนขณะที่ cmux ไม่ใช่แอปที่ใช้งานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux etkin uygulama değilken bir bildirim uyardığında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли надходить сповіщення, а cmux не є активною програмою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
