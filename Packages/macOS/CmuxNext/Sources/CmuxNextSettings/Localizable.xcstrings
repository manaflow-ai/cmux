    "settings.sidebar.priorityView.shown.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة جرس الشريط الجانبي أثناء تشغيل عرض الأولوية. عند الإيقاف، يبقى الشريط الجانبي كما هو."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanje zvona u bočnoj traci dok je prikaz prioriteta uključen. Isključeno, bočna traka ostaje nepromijenjena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klokkens tilstand i sidepanelet, mens prioritetsvisningen er slået til. Slået fra er sidepanelet uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zustand der Glocke in der Seitenleiste, solange die Prioritätsansicht an ist. Aus bleibt die Seitenleiste unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sidebar bell's state while the Priority view is on. Off, the sidebar is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de la campana de la barra lateral mientras la vista de prioridad está activada. Desactivado, la barra lateral no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de la cloche de la barre latérale quand la vue Priorité est activée. Désactivé, la barre latérale reste inchangée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato della campanella della barra laterale quando la vista Priorità è attiva. Disattivata, la barra laterale non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先ビューがオンのときのサイドバーのベルの状態です。オフにするとサイドバーは変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្ថានភាពកណ្ដឹងរបារចំហៀង ពេលទិដ្ឋភាពអាទិភាពបើក។ ពេលបិទ របារចំហៀងនៅដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선순위 보기가 켜져 있을 때 사이드바 종 아이콘의 상태입니다. 끄면 사이드바는 그대로입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bjellens tilstand i sidepanelet mens prioritetsvisningen er på. Av er sidepanelet uendret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan dzwonka na pasku bocznym, gdy widok priorytetów jest włączony. Po wyłączeniu pasek boczny się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado do sino da barra lateral enquanto a visualização de prioridade está ativada. Desativado, a barra lateral não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние колокольчика боковой панели, пока вид «Приоритет» включён. Если выключено, боковая панель не меняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะของกระดิ่งในแถบด้านข้างขณะที่มุมมองลำดับความสำคัญเปิดอยู่ เมื่อปิด แถบด้านข้างจะไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelik görünümü açıkken kenar çubuğundaki zilin durumu. Kapalıyken kenar çubuğu değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан дзвоника бічної панелі, поки вигляд «Пріоритет» увімкнено. Якщо вимкнено, бічна панель не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái chuông của thanh bên khi chế độ xem ưu tiên đang bật. Khi tắt, thanh bên giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先视图打开时侧边栏铃铛的状态。关闭时侧边栏保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先檢視開啟時側邊欄鈴鐺的狀態。關閉時側邊欄維持不變。"
          }
        }
      }
    },
