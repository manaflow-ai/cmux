    "settings.browser.omnibar.fontSize.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size of the address and the suggestions. Match Density follows the density."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حجم العنوان والاقتراحات. مطابقة الكثافة تتبع الكثافة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veličina adrese i prijedloga. Prema gustoći prati gustoću."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Størrelsen på adressen og forslagene. Følg tæthed følger tætheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Größe der Adresse und der Vorschläge. Wie Dichte folgt der Dichte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tamaño de la dirección y las sugerencias. Igual que la densidad sigue la densidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La taille de l’adresse et des suggestions. Comme la densité suit la densité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dimensione dell’indirizzo e dei suggerimenti. Come la densità segue la densità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスと候補の文字サイズです。「密度に合わせる」は密度に従います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំហំអាសយដ្ឋាន និងការណែនាំ។ ដូចដង់ស៊ីតេ ធ្វើតាមដង់ស៊ីតេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "주소와 제안의 크기입니다. 밀도에 맞춤은 밀도를 따릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Størrelsen på adressen og forslagene. Følg tetthet følger tettheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmiar adresu i podpowiedzi. Jak gęstość podąża za gęstością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O tamanho do endereço e das sugestões. Igual à densidade segue a densidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Размер адреса и подсказок. «Как плотность» следует плотности."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขนาดของที่อยู่และคำแนะนำ ตามความหนาแน่นจะใช้ตามความหนาแน่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adresin ve önerilerin boyutu. Yoğunluğa uy yoğunluğu izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розмір адреси й підказок. «Як щільність» відповідає щільності."
          }
        },
        "vi": {
          "stringUnit": {
