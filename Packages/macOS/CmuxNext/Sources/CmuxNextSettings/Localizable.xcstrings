            "state": "translated",
            "value": "ធ្វើបច្ចុប្បន្នភាពនៅពេលទំនេរ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 시 업데이트"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater ved inaktivitet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuj w bezczynności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar quando ocioso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлять при бездействии"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตเมื่อไม่มีการใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşta Kalınca Güncelle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлювати під час бездіяльності"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật khi nhàn rỗi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閒置時更新"
          }
        }
      }
    },
    "settings.updates.installWhenIdle.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs a downloaded update after cmux has been idle for the time below, never while an agent is working or a message is unsent. Agents keep running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبّت تحديثًا تم تنزيله بعد أن يبقى cmux خاملًا للمدة أدناه، ولا يفعل ذلك أبدًا أثناء عمل وكيل أو وجود رسالة لم تُرسل. تستمر الوكلاء في العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalira preuzeto ažuriranje kada cmux bude neaktivan tokom vremena ispod, nikad dok agent radi ili poruka nije poslana. Agenti nastavljaju raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerer en hentet opdatering, når cmux har været inaktiv i tiden nedenfor, aldrig mens en agent arbejder, eller en besked ikke er sendt. Agenter kører videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert ein geladenes Update, wenn cmux so lange wie unten angegeben inaktiv war, nie während ein Agent arbeitet oder eine Nachricht nicht gesendet ist. Agenten laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala una actualización descargada cuando cmux lleva inactivo el tiempo indicado abajo, nunca mientras un agente trabaja o hay un mensaje sin enviar. Los agentes siguen en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe une mise à jour téléchargée quand cmux est inactif depuis la durée ci-dessous, jamais pendant qu'un agent travaille ou qu'un message n'est pas envoyé. Les agents continuent de tourner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa un aggiornamento scaricato dopo che cmux è rimasto inattivo per il tempo indicato sotto, mai mentre un agente lavora o un messaggio non è inviato. Gli agenti continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux が下の時間だけアイドル状態になると、ダウンロード済みのアップデートをインストールします。エージェントの作業中や未送信のメッセージがあるときは行いません。エージェントは動き続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំឡើងបច្ចុប្បន្នភាពដែលបានទាញយក បន្ទាប់ពី cmux ទំនេររយៈពេលខាងក្រោម មិនដែលដំឡើងពេលភ្នាក់ងារកំពុងធ្វើការ ឬមានសារមិនទាន់ផ្ញើឡើយ។ ភ្នាក់ងារនៅតែដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 아래 시간 동안 유휴 상태이면 다운로드한 업데이트를 설치합니다. 에이전트가 작업 중이거나 보내지 않은 메시지가 있을 때는 설치하지 않습니다. 에이전트는 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerer en nedlastet oppdatering når cmux har vært inaktiv i tiden nedenfor, aldri mens en agent jobber eller en melding ikke er sendt. Agenter fortsetter å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluje pobraną aktualizację, gdy cmux jest bezczynny przez czas podany niżej, nigdy gdy agent pracuje lub wiadomość nie została wysłana. Agenci działają dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala uma atualização baixada depois que o cmux fica ocioso pelo tempo abaixo, nunca enquanto um agente trabalha ou há uma mensagem não enviada. Os agentes continuam rodando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает загруженное обновление, когда cmux бездействует указанное ниже время, но никогда во время работы агента или при неотправленном сообщении. Агенты продолжают работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งอัปเดตที่ดาวน์โหลดแล้วเมื่อ cmux ไม่มีการใช้งานตามเวลาด้านล่าง และจะไม่ติดตั้งขณะที่เอเจนต์กำลังทำงานหรือมีข้อความที่ยังไม่ได้ส่ง เอเจนต์ยังคงทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux aşağıdaki süre boyunca boşta kaldığında indirilen güncellemeyi yükler; bir ajan çalışırken veya gönderilmemiş bir mesaj varken asla yüklemez. Ajanlar çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює завантажене оновлення, коли cmux бездіяльний протягом часу нижче, але ніколи під час роботи агента чи з невідправленим повідомленням. Агенти продовжують працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài bản cập nhật đã tải về sau khi cmux nhàn rỗi trong khoảng thời gian bên dưới, không bao giờ khi một tác nhân đang làm việc hoặc có tin nhắn chưa gửi. Các tác nhân vẫn tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 空闲达到下方时长后安装已下载的更新；代理工作时或有未发送的消息时绝不安装。代理会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 閒置達到下方時長後安裝已下載的更新；代理正在工作或有未傳送的訊息時絕不安裝。代理會繼續執行。"
          }
        }
      }
    },
