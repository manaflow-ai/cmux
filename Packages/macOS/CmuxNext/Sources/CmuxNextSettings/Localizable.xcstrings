    "settings.appearance.theme.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors for terminals. cmux uses them too while App Theme is Match Terminal Theme. A space, workspace or terminal theme overrides it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの色です。アプリテーマが「ターミナルテーマに合わせる」の間は cmux もこの色を使います。スペース、ワークスペース、ターミナルのテーマが優先されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ألوان الطرفيات. يستخدمها cmux أيضًا ما دامت سمة التطبيق «مطابقة سمة الطرفية». تتجاوزها سمة المساحة أو مساحة العمل أو الطرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boje terminala. cmux ih koristi i dok je tema aplikacije „Prati temu terminala”. Tema prostora, radnog prostora ili terminala ima prednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farver til terminaler. cmux bruger dem også, mens apptemaet er Følg terminaltema. Et tema for et rum, et arbejdsområde eller en terminal går forud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farben für Terminals. cmux nutzt sie auch, solange das App-Theme „Wie Terminal-Theme“ ist. Ein Space-, Workspace- oder Terminal-Theme hat Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colores de los terminales. cmux también los usa mientras el tema de la app sea Igual que el tema del terminal. Un tema de espacio, área de trabajo o terminal lo reemplaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Couleurs des terminaux. cmux les utilise aussi tant que le thème de l’app est « Comme le thème du terminal ». Un thème d’espace, d’espace de travail ou de terminal le remplace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colori dei terminali. cmux li usa anche finché il tema dell’app è Come il tema del terminale. Un tema di spazio, area di lavoro o terminale lo sostituisce."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពណ៌សម្រាប់ទែមីណាល់។ cmux ក៏ប្រើពួកវាដែរ ពេលស្បែកកម្មវិធីជា «ត្រូវនឹងស្បែកទែមីណាល់»។ ស្បែកលំហ កន្លែងធ្វើការ ឬទែមីណាល់ មានអាទិភាពជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널의 색상입니다. 앱 테마가 '터미널 테마와 일치'인 동안 cmux도 이 색상을 사용합니다. 스페이스, 워크스페이스 또는 터미널 테마가 우선합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Farger for terminaler. cmux bruker dem også så lenge apptemaet er Samme som terminaltema. Et tema for et rom, arbeidsområde eller en terminal går foran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolory terminali. cmux używa ich też, gdy motyw aplikacji to „Jak motyw terminala”. Motyw przestrzeni, obszaru roboczego lub terminala ma pierwszeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cores dos terminais. O cmux também as usa enquanto o tema do app for Igual ao tema do terminal. Um tema de espaço, área de trabalho ou terminal o substitui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цвета терминалов. cmux тоже использует их, пока тема приложения — «Как тема терминала». Тема пространства, рабочей области или терминала имеет приоритет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สีของเทอร์มินัล cmux ใช้สีเหล่านี้ด้วยขณะที่ธีมแอปเป็น \"ตรงกับธีมเทอร์มินัล\" ธีมของสเปซ เวิร์กสเปซ หรือเทอร์มินัลจะมีผลก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminallerin renkleri. Uygulama teması Terminal Temasıyla Eşleş olduğu sürece cmux da bunları kullanır. Alan, çalışma alanı veya terminal teması önceliklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кольори терміналів. cmux теж використовує їх, поки тема застосунку — «Як тема термінала». Тема простору, робочої області чи термінала має пріоритет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màu cho terminal. cmux cũng dùng chúng khi chủ đề ứng dụng là Khớp chủ đề terminal. Chủ đề của không gian, workspace hoặc terminal sẽ được ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "终端的颜色。应用主题为“匹配终端主题”时，cmux 也使用这些颜色。空间、工作区或终端主题优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終端機的顏色。App 主題為「符合終端機主題」時，cmux 也使用這些顏色。空間、工作區或終端機主題優先。"
          }
        }
      }
    },
