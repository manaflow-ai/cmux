    "settings.updates.idleInstallMaxWait.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A downloaded nightly installs by itself once agents and commands finish and you stop typing, and never waits longer than this. Terminals and agents carry on after the restart."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُثبَّت إصدار nightly الذي تم تنزيله تلقائيًا عندما ينتهي الوكلاء والأوامر وتتوقف عن الكتابة، ولا ينتظر أبدًا أطول من هذه المدة. تستمر الطرفيات والوكلاء بعد إعادة التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeti nightly se sam instalira kada agenti i komande završe i prestanete kucati, i nikad ne čeka duže od ovoga. Terminali i agenti nastavljaju nakon ponovnog pokretanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En hentet nightly installeres af sig selv, når agenter og kommandoer er færdige, og du holder op med at skrive, og den venter aldrig længere end dette. Terminaler og agenter fortsætter efter genstarten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein heruntergeladenes Nightly installiert sich selbst, sobald Agenten und Befehle fertig sind und du aufhörst zu tippen, und wartet nie länger als diese Zeit. Terminals und Agenten laufen nach dem Neustart weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nightly descargada se instala sola cuando los agentes y los comandos terminan y dejas de escribir, y nunca espera más que esto. Las terminales y los agentes continúan después del reinicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nightly téléchargée s'installe d'elle-même quand les agents et les commandes ont terminé et que vous arrêtez de taper, sans jamais attendre plus longtemps que ce délai. Les terminaux et les agents reprennent après le redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nightly scaricata si installa da sola quando agenti e comandi hanno finito e smetti di digitare, e non aspetta mai più di questo. Terminali e agenti continuano dopo il riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みの nightly は、エージェントとコマンドが終わり入力が止まると自動でインストールされ、この時間より長くは待ちません。ターミナルとエージェントは再起動後もそのまま続きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែ nightly ដែលបានទាញយកនឹងដំឡើងដោយខ្លួនឯង នៅពេលភ្នាក់ងារ និងពាក្យបញ្ជាបញ្ចប់ ហើយអ្នកឈប់វាយ ហើយមិនដែលរង់ចាំយូរជាងនេះទេ។ ទែមីណាល់ និងភ្នាក់ងារបន្តដំណើរការបន្ទាប់ពីចាប់ផ្ដើមឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드된 nightly는 에이전트와 명령이 끝나고 입력을 멈추면 스스로 설치되며, 이 시간보다 오래 기다리지 않습니다. 터미널과 에이전트는 재시작 후에도 이어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En nedlastet nightly installeres av seg selv når agenter og kommandoer er ferdige og du slutter å skrive, og venter aldri lenger enn dette. Terminaler og agenter fortsetter etter omstarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrana wersja nightly instaluje się sama, gdy agenci i polecenia skończą, a Ty przestaniesz pisać, i nigdy nie czeka dłużej niż tyle. Terminale i agenci działają dalej po ponownym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nightly baixada se instala sozinha quando os agentes e comandos terminam e você para de digitar, e nunca espera mais do que isso. Terminais e agentes continuam após a reinicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженная nightly-сборка устанавливается сама, когда агенты и команды завершатся и вы перестанете печатать, и никогда не ждёт дольше этого времени. Терминалы и агенты продолжают работу после перезапуска."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "nightly ที่ดาวน์โหลดแล้วจะติดตั้งเองเมื่อเอเจนต์และคำสั่งทำงานเสร็จและคุณหยุดพิมพ์ และจะไม่รอนานกว่านี้ เทอร์มินัลและเอเจนต์จะทำงานต่อหลังรีสตาร์ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen nightly, ajanlar ve komutlar bittiğinde ve yazmayı bıraktığınızda kendiliğinden yüklenir ve asla bundan uzun beklemez. Terminaller ve ajanlar yeniden başlatmadan sonra devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажена nightly-збірка встановлюється сама, коли агенти й команди завершаться і ви перестанете друкувати, і ніколи не чекає довше за цей час. Термінали та агенти продовжують роботу після перезапуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản nightly đã tải xuống sẽ tự cài đặt khi các tác tử và lệnh hoàn tất và bạn ngừng gõ, và không bao giờ chờ lâu hơn khoảng này. Terminal và tác tử tiếp tục sau khi khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的 nightly 会在代理和命令完成、你停止输入后自动安装，且等待不会超过此时长。重启后终端和代理会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載的 nightly 會在代理和命令完成、你停止輸入後自動安裝，且等待不會超過此時長。重新啟動後終端機和代理會繼續執行。"
          }
        }
      }
    },
