    "settings.diagnostics.usagePatterns.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Stays on this computer. Counts only, no text."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تبقى على هذا الكمبيوتر. أعداد فقط، بلا نصوص."}},
        "de": {"stringUnit": {"state": "translated", "value": "Bleibt auf diesem Computer. Nur Zählungen, kein Text."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se queda en este ordenador. Solo recuentos, sin texto."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Reste sur cet ordinateur. Des comptes, aucun texte."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このコンピュータにのみ保存。回数だけで、テキストは含みません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 컴퓨터에만 저장됩니다. 횟수만 기록하고 텍스트는 없습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "只保存在这台电脑上。只有计数，没有文字。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "只存在這台電腦上。只有計數，沒有文字。"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ostaje na ovom računaru. Samo brojevi, bez teksta."}},
        "da": {"stringUnit": {"state": "translated", "value": "Bliver på denne computer. Kun tællinger, ingen tekst."}},
        "it": {"stringUnit": {"state": "translated", "value": "Resta su questo computer. Solo conteggi, nessun testo."}},
        "km": {"stringUnit": {"state": "translated", "value": "នៅលើកុំព្យូទ័រនេះ។ រាប់តែចំនួន គ្មានអត្ថបទ។"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Blir på denne datamaskinen. Kun tellinger, ingen tekst."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zostaje na tym komputerze. Tylko liczniki, bez tekstu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Fica neste computador. Apenas contagens, sem texto."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Остаётся на этом компьютере. Только счётчики, без текста."}},
        "th": {"stringUnit": {"state": "translated", "value": "อยู่บนคอมพิวเตอร์เครื่องนี้ นับเฉพาะจำนวน ไม่มีข้อความ"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu bilgisayarda kalır. Yalnızca sayılar, metin yok."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Лишається на цьому комп’ютері. Лише лічильники, без тексту."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Ở lại trên máy tính này. Chỉ đếm số lượng, không có văn bản."}}
      }
    },
    "settings.diagnostics.usagePatterns.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts how you use cmux on this Mac. Nothing you type is recorded; nothing is sent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحسب كيف تستخدم cmux على هذا الـ Mac. لا يُسجَّل شيء مما تكتبه، ولا يُرسل شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zählt, wie du cmux auf diesem Mac nutzt. Eingaben werden nie aufgezeichnet; nichts wird gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuenta cómo usas cmux en este Mac. No se registra nada de lo que escribes; no se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compte votre usage de cmux sur ce Mac. Rien de ce que vous tapez n’est enregistré ; rien n’est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac での cmux の使い方を数えます。入力した内容は記録せず、何も送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에서 cmux를 어떻게 쓰는지 셉니다. 입력한 내용은 기록하지 않으며 아무것도 보내지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "统计你在这台 Mac 上如何使用 cmux。不记录你输入的任何内容，也不发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "統計你在這台 Mac 上如何使用 cmux。不記錄你輸入的任何內容，也不傳送任何資料。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Broji kako koristite cmux na ovom Macu. Ništa što upišete se ne bilježi; ništa se ne šalje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tæller, hvordan du bruger cmux på denne Mac. Intet, du skriver, registreres; intet sendes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
