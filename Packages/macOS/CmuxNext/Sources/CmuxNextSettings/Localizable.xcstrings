    "settings.ui.animations.enabled.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف تتوقف كل الرسوم المتحركة في cmux: تتغير الصفوف وعلامات التبويب والأجزاء والقوائم والبطاقات ومؤشر الوكيل ومؤشرات الانتظار وصفحات ويب cmux فورًا. عند التشغيل تختار المفاتيح أدناه كل منطقة على حدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno gasi sve animacije u cmuxu: redovi, kartice, okna, meniji, kartice s informacijama, kursor agenta, indikatori učitavanja i cmux web stranice mijenjaju se odmah. Uključeno, prekidači ispod biraju područje po područje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra slår alle animationer i cmux fra: rækker, faner, ruder, menuer, kort, agentmarkøren, spinnere og cmux-websider skifter med det samme. Til vælger kontakterne nedenfor område for område."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus schaltet alle Animationen in cmux ab: Zeilen, Tabs, Bereiche, Menüs, Karten, der Agent-Cursor, Ladeanzeigen und cmux-Webseiten ändern sich sofort. An wählen die Schalter darunter Bereich für Bereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off turns every animation in cmux off: rows, tabs, panes, menus, cards, the agent cursor, spinners and cmux web pages change at once. On, the switches below choose area by area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado apaga todas las animaciones de cmux: filas, pestañas, paneles, menús, tarjetas, el cursor del agente, indicadores de carga y páginas web de cmux cambian al instante. Activado, los interruptores de abajo eligen área por área."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé coupe toutes les animations de cmux : lignes, onglets, volets, menus, cartes, curseur de l’agent, indicateurs de chargement et pages web de cmux changent immédiatement. Activé, les commutateurs ci-dessous choisissent zone par zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato spegne tutte le animazioni di cmux: righe, schede, riquadri, menu, schede informative, cursore dell’agente, indicatori di caricamento e pagine web di cmux cambiano subito. Attivato, gli interruttori sotto scelgono area per area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると cmux のすべてのアニメーションが止まり、行、タブ、ペイン、メニュー、カード、エージェントカーソル、スピナー、cmux の Web ページが即座に切り替わります。オンのときは下のスイッチで領域ごとに選べます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បិទ នឹងបិទចលនាទាំងអស់ក្នុង cmux៖ ជួរ ផ្ទាំង ផ្ទាំងរង ម៉ឺនុយ កាត ទស្សន៍ទ្រនិចភ្នាក់ងារ សញ្ញាផ្ទុក និងទំព័របណ្ដាញ cmux ផ្លាស់ប្ដូរភ្លាមៗ។ បើក កុងតាក់ខាងក្រោមជ្រើសរើសតាមតំបន់នីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 cmux의 모든 애니메이션이 꺼져 행, 탭, 창, 메뉴, 카드, 에이전트 커서, 스피너, cmux 웹 페이지가 즉시 바뀝니다. 켜면 아래 스위치로 영역별로 고를 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av slår av alle animasjoner i cmux: rader, faner, ruter, menyer, kort, agentmarkøren, spinnere og cmux-nettsider endres med en gang. På velger bryterne nedenfor område for område."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone wyłącza wszystkie animacje w cmux: wiersze, karty, panele, menu, karty informacyjne, kursor agenta, wskaźniki ładowania i strony cmux zmieniają się od razu. Włączone — przełączniki poniżej wybierają obszar po obszarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado desliga todas as animações do cmux: linhas, abas, painéis, menus, cartões, o cursor do agente, indicadores de carregamento e páginas web do cmux mudam na hora. Ativado, as chaves abaixo escolhem área por área."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено отключает все анимации в cmux: строки, вкладки, панели, меню, карточки, курсор агента, индикаторы загрузки и веб-страницы cmux меняются сразу. Включено — переключатели ниже выбирают область за областью."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดจะหยุดภาพเคลื่อนไหวทั้งหมดใน cmux: แถว แท็บ บานหน้าต่าง เมนู การ์ด เคอร์เซอร์เอเจนต์ ตัวหมุน และหน้าเว็บของ cmux จะเปลี่ยนทันที เปิดอยู่ สวิตช์ด้านล่างเลือกได้ทีละส่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı, cmux'taki tüm animasyonları kapatır: satırlar, sekmeler, bölmeler, menüler, kartlar, aracı imleci, yükleme göstergeleri ve cmux web sayfaları anında değişir. Açıkken aşağıdaki anahtarlar alan alan seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнено вимикає всі анімації в cmux: рядки, вкладки, панелі, меню, картки, курсор агента, індикатори завантаження й вебсторінки cmux змінюються одразу. Увімкнено — перемикачі нижче вибирають область за областю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt sẽ tắt mọi hoạt ảnh trong cmux: hàng, thẻ, khung, menu, thẻ thông tin, con trỏ tác tử, vòng xoay và trang web của cmux thay đổi ngay. Bật thì các công tắc bên dưới chọn theo từng khu vực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后 cmux 的所有动画都会停止：行、标签页、窗格、菜单、卡片、代理光标、加载指示器和 cmux 网页都会立即变化。开启时，可用下方开关逐个区域选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後 cmux 的所有動畫都會停止：列、分頁、窗格、選單、卡片、代理游標、載入指示器與 cmux 網頁都會立即變化。開啟時，可用下方開關逐一選擇區域。"
          }
        }
      }
    },
    "settings.ui.animations.sidebar.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزلق الصفوف والمجموعات عند إعادة ترتيبها أو فتحها أو إغلاقها أو تثبيتها أو نقلها إلى الأعلى، وينزلق الشريط الجانبي عند إظهاره أو إخفائه. عند الإيقاف تتغير فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Redovi i grupe klize kad se preurede, otvore, zatvore, zakače ili pomaknu na vrh, a bočna traka klizi kad se prikaže ili sakrije. Isključeno: mijenjaju se odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rækker og grupper glider, når de omarrangeres, åbnes, lukkes, fastgøres eller flyttes til toppen, og sidepanelet glider, når det vises eller skjules. Fra: de skifter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen und Gruppen gleiten, wenn sie umsortiert, geöffnet, geschlossen, angeheftet oder nach oben verschoben werden, und die Seitenleiste gleitet beim Ein- und Ausblenden. Aus: sie ändern sich sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows and groups slide when they reorder, open, close, pin or move to the top, and the sidebar slides when it shows or hides. Off: they change at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las filas y los grupos se deslizan al reordenarse, abrirse, cerrarse, fijarse o moverse arriba, y la barra lateral se desliza al mostrarse u ocultarse. Desactivado: cambian al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes et les groupes glissent quand ils sont réordonnés, ouverts, fermés, épinglés ou déplacés en haut, et la barre latérale glisse quand elle s’affiche ou se masque. Désactivé : ils changent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Righe e gruppi scorrono quando vengono riordinati, aperti, chiusi, fissati o spostati in alto, e la barra laterale scorre quando appare o si nasconde. Disattivato: cambiano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行やグループの並べ替え、開閉、ピン留め、先頭への移動、サイドバーの表示・非表示をスライドで表示します。オフにすると即座に切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជួរ និងក្រុមរំកិលនៅពេលតម្រៀបឡើងវិញ បើក បិទ ខ្ទាស់ ឬផ្លាស់ទីទៅខាងលើ ហើយរបារចំហៀងរំកិលនៅពេលបង្ហាញ ឬលាក់។ បិទ៖ ផ្លាស់ប្ដូរភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행과 그룹을 재정렬, 열기, 닫기, 고정하거나 맨 위로 옮길 때, 그리고 사이드바를 보이거나 숨길 때 미끄러지듯 움직입니다. 끄면 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rader og grupper glir når de sorteres om, åpnes, lukkes, festes eller flyttes til toppen, og sidefeltet glir når det vises eller skjules. Av: de endres med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiersze i grupy przesuwają się przy zmianie kolejności, otwieraniu, zamykaniu, przypinaniu lub przenoszeniu na górę, a pasek boczny przesuwa się przy pokazywaniu i ukrywaniu. Wyłączone: zmieniają się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas e grupos deslizam ao serem reordenados, abertos, fechados, fixados ou movidos para o topo, e a barra lateral desliza ao aparecer ou sumir. Desativado: mudam na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки и группы скользят при перестановке, открытии, закрытии, закреплении или перемещении наверх, а боковая панель скользит при показе и скрытии. Выключено: меняются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถวและกลุ่มจะเลื่อนเมื่อจัดเรียงใหม่ เปิด ปิด ปักหมุด หรือย้ายขึ้นบนสุด และแถบด้านข้างจะเลื่อนเมื่อแสดงหรือซ่อน ปิด: เปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırlar ve gruplar yeniden sıralanınca, açılınca, kapanınca, sabitlenince veya en üste taşınınca kayar; kenar çubuğu gösterilip gizlenirken kayar. Kapalı: anında değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядки й групи ковзають під час перестановки, відкриття, закриття, закріплення чи переміщення вгору, а бічна панель ковзає під час показу й приховування. Вимкнено: змінюються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng và nhóm trượt khi sắp xếp lại, mở, đóng, ghim hoặc chuyển lên đầu, và thanh bên trượt khi hiện hoặc ẩn. Tắt: thay đổi ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行和分组在重新排序、打开、关闭、固定或移到顶部时滑动，侧边栏在显示或隐藏时滑动。关闭：立即变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列與群組在重新排序、開啟、關閉、釘選或移到頂端時滑動，側邊欄在顯示或隱藏時滑動。關閉：立即變化。"
          }
        }
      }
    },
    "settings.ui.animations.tabs.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكبر علامات التبويب وتصغر وتنزلق عند فتحها أو إغلاقها أو إعادة ترتيبها أو طيها في مجموعة. عند الإيقاف يتغير شريط علامات التبويب فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice rastu, smanjuju se i klize kad se otvore, zatvore, preurede ili skupe u grupu. Isključeno: traka kartica se mijenja odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner vokser, krymper og glider, når de åbnes, lukkes, omarrangeres eller foldes sammen i en gruppe. Fra: fanelinjen skifter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs wachsen, schrumpfen und gleiten, wenn sie geöffnet, geschlossen, umsortiert oder in eine Gruppe eingeklappt werden. Aus: die Tableiste ändert sich sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs grow, shrink and slide when they open, close, reorder or collapse into a group. Off: the tab bar changes at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas crecen, se encogen y se deslizan al abrirse, cerrarse, reordenarse o contraerse en un grupo. Desactivado: la barra de pestañas cambia al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets grandissent, rétrécissent et glissent quand ils s’ouvrent, se ferment, sont réordonnés ou repliés dans un groupe. Désactivé : la barre d’onglets change immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede crescono, si restringono e scorrono quando si aprono, si chiudono, vengono riordinate o compresse in un gruppo. Disattivato: la barra delle schede cambia subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを開く、閉じる、並べ替える、グループに折りたたむときに、伸縮やスライドで表示します。オフにするとタブバーが即座に切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងរីក រួម និងរំកិលនៅពេលបើក បិទ តម្រៀបឡើងវិញ ឬបង្រួមចូលក្រុម។ បិទ៖ របារផ្ទាំងផ្លាស់ប្ដូរភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭을 열고, 닫고, 재정렬하거나 그룹으로 접을 때 커지고 줄어들며 미끄러집니다. 끄면 탭 막대가 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner vokser, krymper og glir når de åpnes, lukkes, sorteres om eller slås sammen i en gruppe. Av: fanelinjen endres med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty rosną, kurczą się i przesuwają przy otwieraniu, zamykaniu, zmianie kolejności lub zwijaniu do grupy. Wyłączone: pasek kart zmienia się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abas crescem, encolhem e deslizam ao abrir, fechar, reordenar ou recolher em um grupo. Desativado: a barra de abas muda na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки растут, сжимаются и скользят при открытии, закрытии, перестановке или сворачивании в группу. Выключено: панель вкладок меняется сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บจะขยาย หด และเลื่อนเมื่อเปิด ปิด จัดเรียงใหม่ หรือยุบเข้ากลุ่ม ปิด: แถบแท็บเปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmeler açılınca, kapanınca, yeniden sıralanınca veya bir gruba daraltılınca büyür, küçülür ve kayar. Kapalı: sekme çubuğu anında değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки ростуть, стискаються й ковзають під час відкриття, закриття, перестановки чи згортання в групу. Вимкнено: панель вкладок змінюється одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ phóng to, thu nhỏ và trượt khi mở, đóng, sắp xếp lại hoặc thu gọn vào nhóm. Tắt: thanh thẻ thay đổi ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页在打开、关闭、重新排序或折叠进分组时伸缩并滑动。关闭：标签栏立即变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分頁在開啟、關閉、重新排序或收合進群組時伸縮並滑動。關閉：分頁列立即變化。"
          }
        }
      }
    },
    "settings.ui.animations.panes.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك التقسيمات والإغلاقات والتكبير والفواصل وحلقات التركيز ومناطق الإفلات، وتُفتح النوافذ وتُغلق وتتحرك بحركة. عند الإيقاف تتغير فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podjele, zatvaranja, zumiranja, razdjelnici, prstenovi fokusa, zone ispuštanja i prozori otvaraju se, zatvaraju i pomiču uz pokret. Isključeno: mijenjaju se odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdelinger, lukninger, zoom, skillelinjer, fokusringe, slipzoner og vinduer åbner, lukker og flytter sig med bevægelse. Fra: de skifter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilungen, Schließen, Zoomen, Trennlinien, Fokusringe, Ablagezonen und Fenster öffnen, schließen und bewegen sich mit Bewegung. Aus: sie ändern sich sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits, closes, zooms, dividers, focus rings, drop zones and windows open, close and move with motion. Off: they change at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisiones, cierres, zoom, divisores, anillos de foco, zonas de soltar y ventanas se abren, cierran y mueven con movimiento. Desactivado: cambian al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisions, fermetures, zooms, séparateurs, anneaux de focus, zones de dépôt et fenêtres s’ouvrent, se ferment et bougent avec du mouvement. Désactivé : ils changent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisioni, chiusure, zoom, divisori, anelli di focus, zone di rilascio e finestre si aprono, si chiudono e si spostano con movimento. Disattivato: cambiano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分割、閉じる、ズーム、仕切り、フォーカスリング、ドロップ領域、ウインドウの開閉と移動に動きを付けます。オフにすると即座に切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបំបែក ការបិទ ការពង្រីក បន្ទាត់ខណ្ឌ រង្វង់ផ្ដោត តំបន់ទម្លាក់ និងបង្អួច បើក បិទ និងផ្លាស់ទីដោយមានចលនា។ បិទ៖ ផ្លាស់ប្ដូរភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할, 닫기, 확대, 구분선, 포커스 링, 놓기 영역, 윈도우의 열기·닫기·이동에 움직임이 있습니다. 끄면 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delinger, lukkinger, zoom, skillelinjer, fokusringer, slippsoner og vinduer åpnes, lukkes og flyttes med bevegelse. Av: de endres med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziały, zamknięcia, powiększenia, separatory, pierścienie fokusu, strefy upuszczania i okna otwierają się, zamykają i przesuwają z ruchem. Wyłączone: zmieniają się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisões, fechamentos, zoom, divisores, anéis de foco, zonas de soltar e janelas abrem, fecham e se movem com movimento. Desativado: mudam na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделения, закрытия, масштабирование, разделители, кольца фокуса, зоны перетаскивания и окна открываются, закрываются и двигаются с анимацией. Выключено: меняются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแบ่ง การปิด การซูม เส้นแบ่ง วงโฟกัส พื้นที่วาง และหน้าต่าง จะเปิด ปิด และเคลื่อนที่อย่างมีการเคลื่อนไหว ปิด: เปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölmeler, kapanışlar, yakınlaştırmalar, ayırıcılar, odak halkaları, bırakma alanları ve pencereler hareketle açılır, kapanır ve taşınır. Kapalı: anında değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділи, закриття, масштабування, роздільники, кільця фокуса, зони перетягування й вікна відкриваються, закриваються й рухаються з анімацією. Вимкнено: змінюються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia khung, đóng, phóng to, đường chia, vòng tiêu điểm, vùng thả và cửa sổ mở, đóng và di chuyển có chuyển động. Tắt: thay đổi ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分、关闭、缩放、分隔线、焦点环、放置区域以及窗口的打开、关闭和移动都带有动效。关闭：立即变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分割、關閉、縮放、分隔線、焦點環、放置區域以及視窗的開啟、關閉與移動都帶有動態效果。關閉：立即變化。"
          }
        }
      }
    },
    "settings.ui.animations.overlays.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلاشى القوائم والنوافذ المنبثقة ولوحة الأوامر والأوراق والإشعارات العابرة والتنبيهات وأشرطة البحث والبطاقات وتنزلق عند ظهورها واختفائها. عند الإيقاف تظهر وتختفي فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Meniji, skočni prozori, paleta naredbi, listovi, obavijesti, trake za pretragu i kartice blijede i klize unutra i van. Isključeno: prikazuju se i skrivaju odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Menuer, popovere, kommandopaletten, ark, toasts, meddelelser, søgelinjer og kort toner og glider ind og ud. Fra: de vises og skjules med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüs, Popover, die Befehlspalette, Sheets, Toasts, Hinweise, Suchleisten und Karten blenden und gleiten ein und aus. Aus: sie erscheinen und verschwinden sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, popovers, the command palette, sheets, toasts, notices, find bars and cards fade and slide in and out. Off: they show and hide at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menús, ventanas emergentes, la paleta de comandos, hojas, avisos, notificaciones, barras de búsqueda y tarjetas aparecen y desaparecen con fundido y deslizamiento. Desactivado: se muestran y ocultan al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, popovers, palette de commandes, feuilles, toasts, avis, barres de recherche et cartes apparaissent et disparaissent en fondu et en glissant. Désactivé : ils s’affichent et se masquent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu, popover, la palette dei comandi, fogli, avvisi, notifiche, barre di ricerca e schede informative entrano ed escono con dissolvenza e scorrimento. Disattivato: appaiono e spariscono subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー、ポップオーバー、コマンドパレット、シート、トースト、通知、検索バー、カードをフェードやスライドで表示・非表示にします。オフにすると即座に表示・非表示になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ឺនុយ ផ្ទាំងលេចឡើង ផ្ទាំងបញ្ជា សន្លឹក ការជូនដំណឹង របារស្វែងរក និងកាត ស្រអាប់ និងរំកិលចូល និងចេញ។ បិទ៖ បង្ហាញ និងលាក់ភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴, 팝오버, 명령 팔레트, 시트, 토스트, 알림, 찾기 막대, 카드가 페이드와 슬라이드로 나타나고 사라집니다. 끄면 즉시 나타나고 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyer, popovere, kommandopaletten, ark, varsler, merknader, søkefelt og kort tones og glir inn og ut. Av: de vises og skjules med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu, wyskakujące okna, paleta poleceń, arkusze, powiadomienia, komunikaty, paski wyszukiwania i karty pojawiają się i znikają z przenikaniem i przesunięciem. Wyłączone: pojawiają się i znikają od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus, popovers, a paleta de comandos, folhas, avisos, notificações, barras de busca e cartões entram e saem com esmaecimento e deslize. Desativado: aparecem e somem na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню, всплывающие окна, палитра команд, листы, уведомления, сообщения, панели поиска и карточки появляются и исчезают с затуханием и скольжением. Выключено: появляются и скрываются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนู ป็อปโอเวอร์ จานคำสั่ง ชีต การแจ้งเตือน แถบค้นหา และการ์ด จะค่อย ๆ ปรากฏและเลื่อนเข้าออก ปิด: แสดงและซ่อนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüler, açılır pencereler, komut paleti, sayfalar, bildirimler, uyarılar, arama çubukları ve kartlar solarak ve kayarak girip çıkar. Kapalı: anında gösterilir ve gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню, спливні вікна, палітра команд, аркуші, сповіщення, повідомлення, панелі пошуку й картки з’являються й зникають із затуханням і ковзанням. Вимкнено: з’являються й ховаються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu, cửa sổ bật lên, bảng lệnh, trang tính, thông báo, thanh tìm kiếm và thẻ thông tin mờ dần và trượt vào ra. Tắt: hiện và ẩn ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单、弹出框、命令面板、表单、提示、通知、查找栏和卡片以淡入淡出和滑动方式出现和消失。关闭：立即显示和隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單、彈出框、指令面板、表單、提示、通知、尋找列與卡片以淡入淡出和滑動方式出現與消失。關閉：立即顯示與隱藏。"
          }
        }
      }
    },
    "settings.ui.animations.hoverCards.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلاشى بطاقات التمرير والتلميحات وتنزلق عند ظهورها. عند الإيقاف تظهر وتختفي فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice pri prelasku i opisi alata blijede i klize unutra. Isključeno: prikazuju se i skrivaju odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svævekort og værktøjstip toner og glider ind. Fra: de vises og skjules med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover-Karten und Tooltips blenden und gleiten ein. Aus: sie erscheinen und verschwinden sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover cards and tooltips fade and slide in. Off: they show and hide at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas al pasar el cursor y las descripciones aparecen con fundido y deslizamiento. Desactivado: se muestran y ocultan al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes de survol et les infobulles apparaissent en fondu et en glissant. Désactivé : elles s’affichent et se masquent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede al passaggio e i suggerimenti entrano con dissolvenza e scorrimento. Disattivato: appaiono e spariscono subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホバーカードとツールチップをフェードとスライドで表示します。オフにすると即座に表示・非表示になります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កាតពេលដាក់ទស្សន៍ទ្រនិច និងព័ត៌មានជំនួយ ស្រអាប់ និងរំកិលចូល។ បិទ៖ បង្ហាញ និងលាក់ភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호버 카드와 도움말이 페이드와 슬라이드로 나타납니다. 끄면 즉시 나타나고 사라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svevekort og verktøytips tones og glir inn. Av: de vises og skjules med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty podglądu i podpowiedzi pojawiają się z przenikaniem i przesunięciem. Wyłączone: pojawiają się i znikają od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões ao passar o cursor e dicas entram com esmaecimento e deslize. Desativado: aparecem e somem na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающие карточки и подсказки появляются с затуханием и скольжением. Выключено: появляются и скрываются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดเมื่อชี้และคำแนะนำจะค่อย ๆ ปรากฏและเลื่อนเข้า ปิด: แสดงและซ่อนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerine gelme kartları ve ipuçları solarak ve kayarak girer. Kapalı: anında gösterilir ve gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливні картки й підказки з’являються із затуханням і ковзанням. Вимкнено: з’являються й ховаються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ khi di chuột và chú giải công cụ mờ dần và trượt vào. Tắt: hiện và ẩn ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停卡片和工具提示以淡入和滑动方式出现。关闭：立即显示和隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸停卡片與工具提示以淡入和滑動方式出現。關閉：立即顯示與隱藏。"
          }
        }
      }
    },
    "settings.ui.animations.home.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك محادثة Chief وفقاعاتها وحقل الكتابة وقائمة الرئيسية وتتلاشى. عند الإيقاف تتغير فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief razgovor, njegovi oblačići, polje za pisanje i lista Početne pomiču se i blijede. Isključeno: mijenjaju se odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-chatten, dens bobler, skrivefeltet og Hjem-listen bevæger sig og toner. Fra: de skifter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chief-Chat, seine Blasen, das Eingabefeld und die Startliste bewegen sich und blenden. Aus: sie ändern sich sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Chief chat, its bubbles, the composer and the Home list move and fade. Off: they change at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat de Chief, sus burbujas, el campo de redacción y la lista de Inicio se mueven y se desvanecen. Desactivado: cambian al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discussion Chief, ses bulles, la zone de saisie et la liste d’accueil bougent et s’estompent. Désactivé : ils changent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat di Chief, le sue bolle, il campo di scrittura e l’elenco Home si muovono e sfumano. Disattivato: cambiano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief チャット、吹き出し、入力欄、ホームのリストに動きとフェードを付けます。オフにすると即座に切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែក Chief ពពុះរបស់វា ប្រអប់សរសេរ និងបញ្ជីទំព័រដើម ផ្លាស់ទី និងស្រអាប់។ បិទ៖ ផ្លាស់ប្ដូរភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 채팅, 말풍선, 입력란, 홈 목록이 움직이고 페이드됩니다. 끄면 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief-chatten, boblene, skrivefeltet og Hjem-listen beveger seg og tones. Av: de endres med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat Chief, jego dymki, pole pisania i lista strony głównej poruszają się i przenikają. Wyłączone: zmieniają się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat do Chief, seus balões, o campo de escrita e a lista do Início se movem e esmaecem. Desativado: mudam na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат Chief, его пузыри, поле ввода и список главной двигаются и затухают. Выключено: меняются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชท Chief ฟองข้อความ ช่องพิมพ์ และรายการหน้าหลักจะเคลื่อนที่และค่อย ๆ จางลง ปิด: เปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief sohbeti, baloncukları, yazma alanı ve ana sayfa listesi hareket eder ve solar. Kapalı: anında değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат Chief, його бульбашки, поле введення та список головної рухаються й затухають. Вимкнено: змінюються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện Chief, bong bóng, ô soạn và danh sách Trang chủ di chuyển và mờ dần. Tắt: thay đổi ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 聊天、气泡、输入框和主页列表带有移动和淡入淡出。关闭：立即变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief 聊天、對話泡泡、輸入框與首頁列表帶有移動與淡入淡出。關閉：立即變化。"
          }
        }
      }
    },
    "settings.ui.animations.cursor.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينزلق مؤشر الوكيل بين النقاط ويعرض تموجات النقر. عند الإيقاف يقفز ولا يعرض تموجًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursor agenta klizi između tačaka i prikazuje talase klika. Isključeno: skače i ne prikazuje talas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentmarkøren glider mellem punkter og viser klikbølger. Fra: den springer og viser ingen bølge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent-Cursor gleitet zwischen Punkten und zeigt Klickwellen. Aus: er springt und zeigt keine Welle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent cursor glides between points and shows click ripples. Off: it jumps and shows no ripple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cursor del agente se desliza entre puntos y muestra ondas al hacer clic. Desactivado: salta y no muestra ondas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le curseur de l’agent glisse entre les points et affiche des ondes de clic. Désactivé : il saute et n’affiche aucune onde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cursore dell’agente scivola tra i punti e mostra onde al clic. Disattivato: salta e non mostra onde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントカーソルが点から点へ滑らかに移動し、クリックの波紋を表示します。オフにするとジャンプし、波紋は表示しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទស្សន៍ទ្រនិចភ្នាក់ងាររំកិលរវាងចំណុច និងបង្ហាញរលកចុច។ បិទ៖ វាលោត ហើយមិនបង្ហាញរលកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 커서가 지점 사이를 미끄러지듯 이동하고 클릭 물결을 표시합니다. 끄면 점프하고 물결을 표시하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentmarkøren glir mellom punkter og viser klikkbølger. Av: den hopper og viser ingen bølge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursor agenta płynie między punktami i pokazuje fale kliknięć. Wyłączone: przeskakuje i nie pokazuje fali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cursor do agente desliza entre pontos e mostra ondas de clique. Desativado: ele salta e não mostra ondas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсор агента плавно движется между точками и показывает волны щелчков. Выключено: он перескакивает и не показывает волн."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคอร์เซอร์เอเจนต์จะเลื่อนระหว่างจุดและแสดงระลอกเมื่อคลิก ปิด: กระโดดและไม่แสดงระลอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracı imleci noktalar arasında kayar ve tıklama dalgaları gösterir. Kapalı: atlar ve dalga göstermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсор агента плавно рухається між точками й показує хвилі клацань. Вимкнено: він перестрибує й не показує хвиль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con trỏ tác tử lướt giữa các điểm và hiện gợn sóng khi nhấp. Tắt: nó nhảy và không hiện gợn sóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理光标在点之间平滑移动并显示点击涟漪。关闭：直接跳转且不显示涟漪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理游標在點之間平滑移動並顯示點按漣漪。關閉：直接跳轉且不顯示漣漪。"
          }
        }
      }
    },
    "settings.ui.animations.indicators.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدور مؤشرات الانتظار وتنبض نقاط الحالة وتومض تنبيهات الانتباه. عند الإيقاف تعرض رمزًا ثابتًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Indikatori učitavanja se okreću, tačke statusa pulsiraju, a upozorenja trepere. Isključeno: prikazuju mirnu ikonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinnere drejer, statusprikker pulserer og opmærksomhedsblink blinker. Fra: de viser et stillestående symbol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladeanzeigen drehen sich, Statuspunkte pulsieren und Hinweisblitze blinken. Aus: sie zeigen ein ruhendes Symbol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinners turn, status dots pulse and attention flashes blink. Off: they show a still glyph."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los indicadores de carga giran, los puntos de estado laten y los avisos parpadean. Desactivado: muestran un icono fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indicateurs de chargement tournent, les points d’état pulsent et les alertes clignotent. Désactivé : ils affichent un symbole fixe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indicatori di caricamento ruotano, i punti di stato pulsano e gli avvisi lampeggiano. Disattivato: mostrano un simbolo fermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピナーが回転し、状態ドットが脈打ち、注意の点滅が光ります。オフにすると静止したアイコンを表示します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សញ្ញាផ្ទុកបង្វិល ចំណុចស្ថានភាពលោតញ័រ និងការព្រមានភ្លឹបភ្លែត។ បិទ៖ បង្ហាញរូបនៅស្ងៀម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스피너가 회전하고 상태 점이 깜박이며 주의 표시가 반짝입니다. 끄면 정지된 아이콘을 표시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinnere snurrer, statusprikker pulserer og varselblink blinker. Av: de viser et stillestående symbol."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaźniki ładowania się obracają, kropki stanu pulsują, a alerty migają. Wyłączone: pokazują nieruchomy symbol."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicadores de carregamento giram, pontos de status pulsam e alertas piscam. Desativado: mostram um ícone parado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индикаторы загрузки вращаются, точки состояния пульсируют, а предупреждения мигают. Выключено: показывают неподвижный значок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวหมุนจะหมุน จุดสถานะจะกะพริบเป็นจังหวะ และการแจ้งเตือนจะกะพริบ ปิด: แสดงสัญลักษณ์นิ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme göstergeleri döner, durum noktaları atar ve uyarılar yanıp söner. Kapalı: sabit bir simge gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індикатори завантаження обертаються, точки стану пульсують, а попередження блимають. Вимкнено: показують нерухомий значок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng xoay quay, chấm trạng thái nhấp nháy theo nhịp và cảnh báo chớp sáng. Tắt: hiện biểu tượng đứng yên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载指示器旋转，状态点脉动，提醒闪烁。关闭：显示静止图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入指示器旋轉，狀態點脈動，提醒閃爍。關閉：顯示靜止圖示。"
          }
        }
      }
    },
    "settings.ui.animations.feedback.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر إبرازات التمرير والضغط وتلاشي التركيز وتغييرات ألوان السمة بسلاسة. عند الإيقاف تتغير فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isticanja pri prelasku i pritisku, blijeđenje fokusa i promjene boja teme pojavljuju se postepeno. Isključeno: mijenjaju se odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svæve- og trykfremhævninger, fokustoninger og farveskift i temaet glider ind. Fra: de skifter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover- und Klick-Hervorhebungen, Fokus-Überblendungen und Farbwechsel des Themas blenden weich ein. Aus: sie ändern sich sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover and press highlights, focus fades and theme color changes ease in. Off: they change at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resaltados al pasar y pulsar, los fundidos de foco y los cambios de color del tema aparecen suavemente. Desactivado: cambian al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les surbrillances de survol et d’appui, les fondus de focus et les changements de couleur du thème apparaissent en douceur. Désactivé : ils changent immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le evidenziazioni al passaggio e alla pressione, le dissolvenze del focus e i cambi di colore del tema compaiono gradualmente. Disattivato: cambiano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホバーや押下のハイライト、フォーカスのフェード、テーマの色の変化をなめらかに表示します。オフにすると即座に切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបន្លិចពេលដាក់ទស្សន៍ទ្រនិច និងចុច ការស្រអាប់ការផ្ដោត និងការប្ដូរពណ៌រចនាប័ទ្ម លេចឡើងបន្តិចម្ដងៗ។ បិទ៖ ផ្លាស់ប្ដូរភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호버와 누르기 강조, 포커스 페이드, 테마 색상 변경이 부드럽게 나타납니다. 끄면 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveve- og trykkmarkeringer, fokustoninger og fargeskift i temaet tones inn. Av: de endres med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podświetlenia przy najechaniu i naciśnięciu, przenikanie fokusu i zmiany kolorów motywu pojawiają się płynnie. Wyłączone: zmieniają się od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realces ao passar e pressionar, esmaecimentos de foco e mudanças de cor do tema surgem suavemente. Desativado: mudam na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсветка при наведении и нажатии, затухание фокуса и смена цветов темы появляются плавно. Выключено: меняются сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฮไลต์เมื่อชี้และกด การจางของโฟกัส และการเปลี่ยนสีธีม จะค่อย ๆ ปรากฏ ปิด: เปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerine gelme ve basma vurguları, odak geçişleri ve tema renk değişiklikleri yumuşakça belirir. Kapalı: anında değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсвічування під час наведення й натискання, затухання фокуса й зміни кольорів теми з’являються плавно. Вимкнено: змінюються одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô sáng khi di chuột và nhấn, mờ dần tiêu điểm và đổi màu chủ đề hiện dần. Tắt: thay đổi ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停和按下高亮、焦点渐变以及主题颜色变化都会平滑出现。关闭：立即变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸停與按下醒目提示、焦點漸變以及主題顏色變化都會平滑出現。關閉：立即變化。"
          }
        }
      }
    },
    "settings.ui.animations.web.help": {
      "comment": "Settings > Appearance > Motion: the help text under a motion switch (ui.animations.*).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانتقالات والرسوم المتحركة في صفحات cmux نفسها، مثل محادثات الوكلاء وعلامة التبويب الجديدة وMarkdown. عند الإيقاف تنتهي فورًا. لا تتغير المواقع الأخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijelazi i animacije na cmuxovim stranicama, poput razgovora s agentima, Nove kartice i Markdowna. Isključeno: završavaju odmah. Druge web stranice se ne mijenjaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overgange og animationer på cmux' egne sider, som agentchats, Ny fane og Markdown. Fra: de slutter med det samme. Andre websteder ændres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übergänge und Animationen auf cmux-eigenen Seiten wie Agent-Chats, Neuer Tab und Markdown. Aus: sie enden sofort. Andere Websites bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transitions and animations in cmux's own pages, such as agent chats, New Tab and Markdown. Off: they end at once. Websites are not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transiciones y animaciones en las páginas propias de cmux, como chats de agentes, Nueva pestaña y Markdown. Desactivado: terminan al instante. Otros sitios web no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transitions et animations des pages propres à cmux, comme les discussions d’agents, Nouvel onglet et Markdown. Désactivé : elles se terminent immédiatement. Les autres sites ne changent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transizioni e animazioni nelle pagine di cmux, come chat degli agenti, Nuova scheda e Markdown. Disattivato: terminano subito. Gli altri siti web non cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントチャット、新規タブ、Markdown など cmux 独自のページのトランジションとアニメーションです。オフにすると即座に終わります。ほかの Web サイトは変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្លាស់ប្ដូរ និងចលនានៅក្នុងទំព័រផ្ទាល់របស់ cmux ដូចជាការជជែកជាមួយភ្នាក់ងារ ផ្ទាំងថ្មី និង Markdown។ បិទ៖ បញ្ចប់ភ្លាមៗ។ គេហទំព័រផ្សេងទៀតមិនផ្លាស់ប្ដូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 채팅, 새 탭, Markdown 같은 cmux 자체 페이지의 전환과 애니메이션입니다. 끄면 즉시 끝납니다. 다른 웹사이트는 바뀌지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overganger og animasjoner på cmux sine egne sider, som agentchatter, Ny fane og Markdown. Av: de slutter med en gang. Andre nettsteder endres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejścia i animacje na stronach cmux, takich jak czaty agentów, Nowa karta i Markdown. Wyłączone: kończą się od razu. Inne witryny się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transições e animações nas páginas do próprio cmux, como chats de agentes, Nova aba e Markdown. Desativado: terminam na hora. Outros sites não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходы и анимации на собственных страницах cmux, например в чатах агентов, на новой вкладке и в Markdown. Выключено: завершаются сразу. Другие сайты не меняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทรานซิชันและภาพเคลื่อนไหวในหน้าของ cmux เอง เช่น แชทเอเจนต์ แท็บใหม่ และ Markdown ปิด: จบทันที เว็บไซต์อื่นไม่เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux'un kendi sayfalarındaki geçişler ve animasyonlar; aracı sohbetleri, Yeni Sekme ve Markdown gibi. Kapalı: anında biter. Diğer web siteleri değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходи й анімації на власних сторінках cmux, як-от у чатах агентів, на новій вкладці та в Markdown. Вимкнено: завершуються одразу. Інші сайти не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển tiếp và hoạt ảnh trong các trang của chính cmux, như trò chuyện tác tử, Thẻ mới và Markdown. Tắt: kết thúc ngay. Các trang web khác không đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 自有页面（如代理聊天、新标签页和 Markdown）中的过渡和动画。关闭：立即结束。其他网站不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 自有頁面（如代理聊天、新分頁與 Markdown）中的轉場與動畫。關閉：立即結束。其他網站不受影響。"
          }
        }
      }
    },
