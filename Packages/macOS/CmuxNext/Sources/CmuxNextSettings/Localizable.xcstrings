    "settings.appearance.colorTransition.duration.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a color change takes. 0 changes colors at once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يستغرقها تغيير الألوان. 0 يغيّر الألوان فورًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko traje promjena boja. 0 mijenja boje odmah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor længe et farveskift varer. 0 skifter farver med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange ein Farbwechsel dauert. 0 wechselt die Farben sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto dura un cambio de color. 0 cambia los colores al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée d’un changement de couleur. 0 change les couleurs immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dura un cambio di colore. 0 cambia i colori subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色の変化にかかる時間。0 ですぐに切り替わります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រយៈពេលនៃការប្ដូរពណ៌។ 0 ប្ដូរពណ៌ភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상 변경에 걸리는 시간입니다. 0이면 즉시 바뀝니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lenge en fargeendring varer. 0 endrer fargene med en gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo trwa zmiana kolorów. 0 zmienia kolory od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo uma mudança de cor leva. 0 muda as cores na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько длится смена цветов. 0 меняет цвета сразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาที่ใช้ในการเปลี่ยนสี 0 คือเปลี่ยนทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir renk değişikliğinin süresi. 0 renkleri hemen değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки триває зміна кольорів. 0 змінює кольори одразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian một lần đổi màu. 0 là đổi ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
