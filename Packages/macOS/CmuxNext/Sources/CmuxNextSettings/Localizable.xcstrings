    "settings.statusIndicator.style.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How sidebar rows, tabs and panes show work in progress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーの行、タブ、ペインで進行中の作業を示す方法。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كيف تعرض صفوف الشريط الجانبي وعلامات التبويب والأجزاء العمل الجاري."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako redovi bočne trake, kartice i okna prikazuju rad u toku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan rækker i sidepanelet, faner og ruder viser igangværende arbejde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie Seitenleistenzeilen, Tabs und Bereiche laufende Arbeit anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cómo muestran el trabajo en curso las filas de la barra lateral, las pestañas y los paneles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comment les lignes de la barre latérale, les onglets et les volets montrent le travail en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Come righe della barra laterale, schede e riquadri mostrano il lavoro in corso."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របៀបដែលជួររបារចំហៀង ផ្ទាំង និងផ្ទាំងរង បង្ហាញការងារកំពុងដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바 행, 탭, 창에 진행 중인 작업을 표시하는 방법."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvordan rader i sidefeltet, faner og ruter viser pågående arbeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak wiersze paska bocznego, karty i panele pokazują trwającą pracę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Como linhas da barra lateral, abas e painéis mostram o trabalho em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как строки боковой панели, вкладки и панели показывают выполняемую работу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิธีที่แถบด้านข้าง แท็บ และบานหน้าต่างแสดงงานที่กำลังดำเนินอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğu satırlarının, sekmelerin ve bölmelerin devam eden işi nasıl gösterdiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Як рядки бічної панелі, вкладки й панелі показують поточну роботу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cách các hàng thanh bên, thẻ và ngăn hiển thị công việc đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "侧边栏行、标签页和窗格如何显示进行中的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄列、分頁和窗格如何顯示進行中的工作。"
          }
        }
      }
    },
