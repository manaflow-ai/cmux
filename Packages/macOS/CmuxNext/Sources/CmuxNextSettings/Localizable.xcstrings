    "settings.updates.channel.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary and Dev get builds before they reach Nightly. Stable gets only builds that have run a week without problems, so switching to it may mean no updates for a while."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary und Dev erhalten Builds, bevor sie Nightly erreichen. Stable erhält nur Builds, die eine Woche ohne Probleme gelaufen sind; nach dem Wechsel kann es eine Weile keine Updates geben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary et Dev reçoivent les builds avant Nightly. Stable ne reçoit que les builds qui ont tourné une semaine sans problème : après le changement, il peut n’y avoir aucune mise à jour pendant un moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحصل قناتا Canary وDev على الإصدارات قبل وصولها إلى Nightly. لا تحصل Stable إلا على الإصدارات التي عملت أسبوعًا دون مشكلات، لذا قد لا تصل تحديثات لفترة بعد التبديل إليها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary y Dev reciben las compilaciones antes que Nightly. Stable solo recibe compilaciones que han funcionado una semana sin problemas, así que al cambiar puede que no haya actualizaciones durante un tiempo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 與 Dev 會比 Nightly 更早取得版本。Stable 只取得已穩定執行一週的版本，因此切換後可能有一段時間沒有更新。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 和 Dev 会比 Nightly 更早获得版本。Stable 只获得已稳定运行一周的版本，因此切换后可能有一段时间没有更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary와 Dev는 Nightly보다 먼저 빌드를 받습니다. Stable은 일주일 동안 문제 없이 실행된 빌드만 받으므로, 전환 후 한동안 업데이트가 없을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary と Dev は Nightly より先にビルドを受け取ります。Stable は 1 週間問題なく動いたビルドだけを受け取るため、切り替えるとしばらく更新がないことがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary e Dev recebem builds antes do Nightly. Stable recebe só builds que rodaram uma semana sem problemas, então ao mudar para ele pode ficar um tempo sem atualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary и Dev получают сборки раньше Nightly. Stable получает только сборки, которые неделю работали без проблем, поэтому после переключения обновлений может не быть какое-то время."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary e Dev ricevono le build prima di Nightly. Stable riceve solo build che hanno funzionato una settimana senza problemi, quindi dopo il passaggio potrebbero non esserci aggiornamenti per un po'."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary і Dev отримують збірки раніше за Nightly. Stable отримує лише збірки, що тиждень працювали без проблем, тож після перемикання оновлень може не бути деякий час."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary i Dev dobijaju buildove prije Nightly. Stable dobija samo buildove koji su sedmicu radili bez problema, pa nakon prelaska neko vrijeme možda neće biti ažuriranja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary i Dev dostają kompilacje przed Nightly. Stable dostaje tylko kompilacje, które przez tydzień działały bez problemów, więc po przełączeniu przez jakiś czas może nie być aktualizacji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary ve Dev, sürümleri Nightly'den önce alır. Stable yalnızca bir hafta sorunsuz çalışmış sürümleri alır; bu yüzden geçiş yaptıktan sonra bir süre güncelleme gelmeyebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary và Dev nhận bản dựng trước Nightly. Stable chỉ nhận bản dựng đã chạy ổn định một tuần, nên sau khi chuyển có thể một thời gian không có cập nhật."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary และ Dev ได้รับบิลด์ก่อน Nightly ส่วน Stable ได้รับเฉพาะบิลด์ที่ทำงานได้ดีมาแล้วหนึ่งสัปดาห์ ดังนั้นหลังจากเปลี่ยนอาจไม่มีอัปเดตไปสักพัก"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary og Dev får bygg før Nightly. Stable får bare bygg som har kjørt en uke uten problemer, så etter byttet kan det gå en stund uten oppdateringer."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary និង Dev ទទួលបានកំណែមុន Nightly។ Stable ទទួលបានតែកំណែដែលដំណើរការមួយសប្ដាហ៍ដោយគ្មានបញ្ហា ដូច្នេះបន្ទាប់ពីប្ដូរ អាចគ្មានបច្ចុប្បន្នភាពមួយរយៈ។"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary og Dev får builds før Nightly. Stable får kun builds, der har kørt en uge uden problemer, så efter skiftet kan der gå et stykke tid uden opdateringer."
          }
        }
      }
    },
