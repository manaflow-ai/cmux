        "de": {"stringUnit": {"state": "needs_review", "value": "Die Breite des Lichtbands. 0 nimmt die halbe Zeile."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El ancho de la banda de luz. 0 usa la mitad de la línea."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La largeur de la bande lumineuse. 0 utilise la moitié de la ligne."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La larghezza della banda luminosa. 0 usa metà della riga."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "光の帯の幅。0 は行の半分の幅です。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ទទឹងនៃបន្ទះពន្លឺ។ 0 ប្រើពាក់កណ្តាលបន្ទាត់។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "빛 띠의 너비입니다. 0이면 줄의 절반을 씁니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Bredden på glimtets lysbånd. 0 bruker halve linjen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Szerokość jasnego pasa. 0 to połowa wiersza."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A largura da faixa de luz. 0 usa metade da linha."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ширина светлой полосы. 0 — половина строки."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ความกว้างของแถบแสง 0 ใช้ครึ่งหนึ่งของบรรทัด"}},
