    "settings.notifications.dockBounce.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a notification alerts while cmux isn't the active app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يصل تنبيه بإشعار بينما cmux ليس التطبيق النشط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada obavještenje upozori dok cmux nije aktivna aplikacija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en notifikation advarer, mens cmux ikke er den aktive app."
          }
        },
        "de": {
          "stringUnit": {
