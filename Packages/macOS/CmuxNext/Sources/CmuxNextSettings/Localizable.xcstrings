    "settings.agentPane.display.thinking.shimmer": {
      "comment": "Settings > Chat > Transcript > Thinking Shimmer: title of the setting for how the agent chat's live status line shimmers",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Thinking Shimmer"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "وميض التفكير"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Svjetlucanje razmišljanja"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Tænke-glimt"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Schimmer beim Denken"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Brillo al pensar"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Scintillement de réflexion"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Scintillio del pensiero"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "思考中のきらめき"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ពន្លឺភ្លឹបភ្លែតពេលគិត"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "생각 중 반짝임"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Tenkeglimt"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Połysk myślenia"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Brilho do pensamento"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Мерцание при размышлении"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสงวาบขณะคิด"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Düşünme parıltısı"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Мерехтіння під час роздумів"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hiệu ứng ánh sáng khi suy nghĩ"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "思考光泽"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "思考光澤"}}
      }
    },
    "settings.agentPane.display.thinking.shimmer.help": {
      "comment": "Settings > Chat > Transcript > Thinking Shimmer: help",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "How the light band moves across the live status line."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "كيف يتحرك شريط الضوء عبر سطر الحالة المباشر."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Kako se svijetla traka kreće preko živog statusnog reda."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Hvordan lysbåndet bevæger sig hen over den levende statuslinje."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Wie das Lichtband über die Live-Statuszeile wandert."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Cómo se mueve la banda de luz por la línea de estado en vivo."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Comment la bande lumineuse traverse la ligne d'état en direct."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Come la banda luminosa attraversa la riga di stato in tempo reale."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "ライブのステータス行を光の帯がどう流れるか。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "របៀបដែលបន្ទះពន្លឺផ្លាស់ទីឆ្លងកាត់បន្ទាត់ស្ថានភាពផ្ទាល់។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "빛 띠가 실시간 상태 줄을 지나가는 방식입니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Hvordan lysbåndet beveger seg over den levende statuslinjen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Jak jasny pas przesuwa się po wierszu stanu na żywo."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Como a faixa de luz se move pela linha de status ao vivo."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Как светлая полоса движется по строке текущего состояния."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แถบแสงเคลื่อนผ่านบรรทัดสถานะสดอย่างไร"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Işık bandının canlı durum satırında nasıl ilerlediği."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Як світла смуга рухається рядком поточного стану."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Cách dải sáng di chuyển qua dòng trạng thái trực tiếp."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "光带如何扫过实时状态行。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "光帶如何掃過即時狀態列。"}}
      }
    },
    "settings.agentPane.display.thinking.shimmerPeriod": {
      "comment": "Settings > Chat > Transcript > Shimmer Speed: title of the setting for one shimmer pass in milliseconds",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Shimmer Speed"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "سرعة الوميض"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Brzina svjetlucanja"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Glimtets hastighed"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Schimmer-Geschwindigkeit"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Velocidad del brillo"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Vitesse du scintillement"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Velocità dello scintillio"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "きらめきの速さ"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ល្បឿនពន្លឺភ្លឹបភ្លែត"}},
