        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 새 작업 공간 시작 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La telefonen starte nye arbeidsområder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól telefonowi tworzyć nowe obszary robocze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o celular inicie novos espaços de trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить телефону создавать рабочие пространства"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้โทรศัพท์ของคุณเริ่มพื้นที่ทำงานใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzun yeni çalışma alanları başlatmasına izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити телефону створювати робочі простори"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép điện thoại mở không gian làm việc mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许手机新建工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許手機建立新工作區"
          }
        }
      }
    },
    "settings.phone.startSessions.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off, your phone can still follow, type into and answer what's already running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، يظل بإمكان هاتفك متابعة ما يعمل بالفعل والكتابة فيه والرد عليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada je isključeno, telefon i dalje može pratiti, kucati u ono što već radi i odgovarati na to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er slået fra, kan din telefon stadig følge med i, skrive i og svare på det, der allerede kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeschaltet kann dein Telefon weiterhin verfolgen, was schon läuft, darin tippen und darauf antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, tu teléfono aún puede seguir, escribir en lo que ya está en marcha y responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, votre téléphone peut toujours suivre ce qui tourne déjà, y saisir du texte et y répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, il telefono può comunque seguire ciò che è già in esecuzione, scriverci e rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにしても、実行中のものを見たり、入力したり、応答したりはできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលបិទ ទូរសព្ទរបស់អ្នកនៅតែអាចតាមដាន វាយបញ្ចូល និងឆ្លើយតបអ្វីដែលកំពុងដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄더라도 휴대폰에서 이미 실행 중인 항목을 보고, 입력하고, 응답할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er av, kan telefonen fortsatt følge med på, skrive i og svare på det som allerede kjører."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wyłączeniu telefon nadal może śledzić to, co już działa, pisać i odpowiadać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, o celular ainda pode acompanhar, digitar e responder ao que já está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, телефон по-прежнему может следить за тем, что уже запущено, вводить текст и отвечать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิด โทรศัพท์ของคุณยังติดตาม พิมพ์ และตอบสิ่งที่กำลังทำงานอยู่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken telefonunuz zaten çalışan şeyleri izleyebilir, onlara yazabilir ve yanıt verebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнено, телефон і далі може стежити за тим, що вже працює, вводити текст і відповідати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, điện thoại vẫn có thể theo dõi, gõ vào và trả lời những gì đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，手机仍可查看、输入和回应已在运行的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，手機仍可查看、輸入和回應已在執行的內容。"
          }
        }
      }
    },
    "settings.phone.cloudReplica": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show This Mac's Workspaces on Your Phone While It's Off"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار مساحات عمل هذا الـ Mac على هاتفك أثناء إيقاف تشغيله"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži radne prostore ovog Maca na telefonu dok je isključen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis denne Macs arbejdsområder på din telefon, mens den er slukket"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereiche dieses Macs auf dem iPhone zeigen, während er aus ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar los espacios de trabajo de este Mac en tu teléfono mientras está apagado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les espaces de travail de ce Mac sur votre téléphone lorsqu'il est éteint"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli spazi di lavoro di questo Mac sul telefono quando è spento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacがオフのときもこのMacのワークスペースをスマートフォンに表示"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្ហាញកន្លែងធ្វើការរបស់ Mac នេះនៅលើទូរសព្ទរបស់អ្នក ពេលវាបិទ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 꺼져 있을 때도 이 Mac의 작업 공간을 휴대폰에 표시"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis denne Macens arbeidsområder på telefonen mens den er av"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj obszary robocze tego Maca na telefonie, gdy jest wyłączony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar os espaços de trabalho deste Mac no celular enquanto ele estiver desligado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать рабочие пространства этого Mac на телефоне, когда он выключен"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงพื้นที่ทำงานของ Mac เครื่องนี้บนโทรศัพท์ขณะที่ปิดเครื่องอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac kapalıyken çalışma alanlarını telefonunda göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати робочі простори цього Mac на телефоні, коли він вимкнений"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị không gian làm việc của máy Mac này trên điện thoại khi máy tắt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 关机时于手机上显示其工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 關機時於手機上顯示其工作區"
          }
        }
      }
