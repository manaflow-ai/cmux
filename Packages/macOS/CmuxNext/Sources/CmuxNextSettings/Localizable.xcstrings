    "settings.window.titlebarButtons.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the sidebar hidden, On Hover hides the sidebar button, Back and Forward until the pointer is over the top row. With the sidebar open, they always show."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーを隠しているとき、「ポインタを置いたとき」では、ポインタが上端の行に来るまでサイドバーのボタン、「戻る」と「進む」を隠します。サイドバーを開いているときは常に表示されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند إخفاء الشريط الجانبي، يُخفي «عند التمرير» زر الشريط الجانبي وزرَّي الرجوع والتقدم حتى يصل المؤشر إلى الصف العلوي. عند فتح الشريط الجانبي، تظهر دائمًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kad je bočna traka skrivena, Pri prelasku skriva dugme bočne trake, Nazad i Naprijed dok pokazivač ne dođe na gornji red. Kad je bočna traka otvorena, uvijek se prikazuju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når sidepanelet er skjult, skjuler Ved hover sidepanelknappen, Tilbage og Frem, indtil markøren er over den øverste række. Når sidepanelet er åbent, vises de altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei ausgeblendeter Seitenleiste blendet „Bei Hover“ die Seitenleistentaste, Zurück und Vorwärts aus, bis der Zeiger über der oberen Zeile ist. Bei geöffneter Seitenleiste werden sie immer angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con la barra lateral oculta, Al pasar el puntero oculta el botón de la barra lateral, Atrás y Adelante hasta que el puntero está sobre la fila superior. Con la barra lateral abierta, se muestran siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Barre latérale masquée, Au survol masque le bouton de la barre latérale, Précédent et Suivant jusqu’à ce que le pointeur soit sur la ligne du haut. Barre latérale ouverte, ils s’affichent toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con la barra laterale nascosta, Al passaggio nasconde il pulsante della barra laterale, Indietro e Avanti finché il puntatore non è sulla riga in alto. Con la barra laterale aperta, sono sempre visibili."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅពេលរបារចំហៀងត្រូវបានលាក់ «ពេលដាក់ព្រួញលើ» លាក់ប៊ូតុងរបារចំហៀង ថយក្រោយ និងទៅមុខ រហូតដល់ព្រួញនៅលើជួរខាងលើ។ នៅពេលរបារចំហៀងបើក ពួកវាតែងតែបង្ហាញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바가 숨겨져 있으면 '호버 시'는 포인터가 맨 위 행에 올 때까지 사이드바 버튼, 뒤로, 앞으로를 숨깁니다. 사이드바가 열려 있으면 항상 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når sidefeltet er skjult, skjuler Ved peker sidefeltknappen, Tilbake og Frem til pekeren er over den øverste raden. Når sidefeltet er åpent, vises de alltid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy pasek boczny jest ukryty, Po najechaniu ukrywa przycisk paska bocznego, Wstecz i Dalej, dopóki wskaźnik nie znajdzie się nad górnym wierszem. Gdy pasek boczny jest otwarty, są zawsze widoczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com a barra lateral oculta, Ao passar o cursor oculta o botão da barra lateral, Voltar e Avançar até o ponteiro ficar sobre a linha superior. Com a barra lateral aberta, eles sempre aparecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когда боковая панель скрыта, «При наведении» скрывает кнопку боковой панели, «Назад» и «Вперёд», пока указатель не окажется над верхней строкой. Когда боковая панель открыта, они видны всегда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อซ่อนแถบด้านข้าง «เมื่อวางเมาส์» จะซ่อนปุ่มแถบด้านข้าง ย้อนกลับ และไปข้างหน้า จนกว่าตัวชี้จะอยู่เหนือแถวบนสุด เมื่อเปิดแถบด้านข้าง ปุ่มเหล่านี้จะแสดงเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenar çubuğu gizliyken, Üzerine gelince kenar çubuğu düğmesini, Geri ve İleri düğmelerini işaretçi üst satıra gelene kadar gizler. Kenar çubuğu açıkken her zaman görünürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коли бічну панель приховано, «При наведенні» приховує кнопку бічної панелі, «Назад» і «Вперед», доки вказівник не опиниться над верхнім рядком. Коли бічна панель відкрита, вони видні завжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi thanh bên bị ẩn, Khi di chuột sẽ ẩn nút thanh bên, Quay lại và Tiếp tới cho đến khi con trỏ ở trên hàng trên cùng. Khi thanh bên mở, chúng luôn hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隐藏边栏时，“悬停时”会隐藏边栏按钮、“后退”和“前进”，直到指针移到顶部一行。打开边栏时，它们始终显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "隱藏側邊欄時，「游標停留時」會隱藏側邊欄按鈕、「上一頁」和「下一頁」，直到指標移到頂部一列。開啟側邊欄時，它們一律顯示。"
          }
        }
      }
    },
