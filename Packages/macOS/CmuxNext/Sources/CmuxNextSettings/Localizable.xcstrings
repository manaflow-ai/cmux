        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند كتابته في استعلام فارغ، يدخل هذا الحرف إلى النطاق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
