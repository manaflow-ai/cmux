    "settings.chief.reactionClassifier.prompt.help": {
      "comment": "Chief reaction classifier (a416).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the classifier is told when it decides. Empty uses the built-in instructions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分類モデルが判断するときに与える指示。空欄なら組み込みの指示を使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما يُقال للمصنِّف عندما يقرر. الفراغ يستخدم التعليمات المضمَّنة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šta se klasifikatoru kaže kada odlučuje. Prazno koristi ugrađene upute."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvad klassifikatoren får at vide, når den afgør. Tom bruger de indbyggede instruktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was dem Klassifikator bei der Entscheidung gesagt wird. Leer nutzt die eingebauten Anweisungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que se le dice al clasificador cuando decide. Vacío usa las instrucciones integradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce qu’on dit au classificateur quand il décide. Vide utilise les instructions intégrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cosa viene detto al classificatore quando decide. Vuoto usa le istruzioni integrate."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្វីដែលប្រាប់ចំណាត់ថ្នាក់ពេលវាសម្រេច។ ទទេប្រើសេចក្ដីណែនាំដែលមានស្រាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "분류기가 판단할 때 받는 지침. 비워 두면 기본 지침을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hva klassifisereren får beskjed om når den avgjør. Tom bruker de innebygde instruksjonene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Co klasyfikator otrzymuje przy decyzji. Puste używa wbudowanych instrukcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que o classificador recebe ao decidir. Vazio usa as instruções embutidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Что говорят классификатору при решении. Пусто: встроенные инструкции."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สิ่งที่บอกตัวจำแนกเมื่อตัดสิน ว่างไว้จะใช้คำสั่งในตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sınıflandırıcıya karar verirken söylenen. Boş bırakılırsa yerleşik talimatlar kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Що кажуть класифікатору під час рішення. Порожньо: вбудовані інструкції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Những gì được nói với bộ phân loại khi nó quyết định. Để trống dùng hướng dẫn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分类器判断时收到的指令。留空则使用内置指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分類器判斷時收到的指示。留空則使用內建指示。"
          }
        }
      }
    },
    "settings.sidebar.showColors.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُظهر مساحات العمل والمجموعات ألوانها في الشريط الجانبي. عند الإيقاف لا يُظهر الشريط الجانبي أي ألوان ويحتفظ بالألوان التي عيّنتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radni prostori i grupe prikazuju svoje boje na bočnoj traci. Kada je isključeno, bočna traka ne prikazuje boje i zadržava boje koje ste postavili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbejdsområder og grupper viser deres farver i sidepanelet. Slået fra viser sidepanelet ingen farver og beholder de farver, du har valgt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Workspaces und Gruppen zeigen ihre Farben in der Seitenleiste. Aus: Die Seitenleiste zeigt keine Farben und behält die gesetzten Farben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces and groups draw their colors in the sidebar. Off, the sidebar draws no colors and keeps the colors you set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los espacios de trabajo y los grupos muestran sus colores en la barra lateral. Desactivado, la barra lateral no muestra colores y conserva los que elegiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les espaces de travail et les groupes affichent leurs couleurs dans la barre latérale. Désactivé, la barre latérale n’affiche aucune couleur et conserve celles que vous avez choisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli spazi di lavoro e i gruppi mostrano i loro colori nella barra laterale. Disattivato, la barra laterale non mostra colori e mantiene quelli impostati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーでワークスペースとグループの色を表示します。オフにすると色を表示しませんが、設定した色は保持されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការ និងក្រុមបង្ហាញពណ៌របស់វានៅរបារចំហៀង។ ពេលបិទ របារចំហៀងមិនបង្ហាញពណ៌ទេ ហើយរក្សាពណ៌ដែលអ្នកបានកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바에 워크스페이스와 그룹의 색상을 표시합니다. 끄면 색상을 표시하지 않으며 설정한 색상은 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arbeidsområder og grupper viser fargene sine i sidefeltet. Av: sidefeltet viser ingen farger og beholder fargene du har valgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obszary robocze i grupy pokazują swoje kolory na pasku bocznym. Po wyłączeniu pasek boczny nie pokazuje kolorów i zachowuje ustawione kolory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espaços de trabalho e grupos mostram suas cores na barra lateral. Desativado, a barra lateral não mostra cores e mantém as cores que você definiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рабочие пространства и группы показывают свои цвета на боковой панели. Если выключено, панель не показывает цвета и сохраняет заданные вами цвета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานและกลุ่มแสดงสีในแถบด้านข้าง เมื่อปิด แถบด้านข้างจะไม่แสดงสีและเก็บสีที่คุณตั้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalışma alanları ve gruplar renklerini kenar çubuğunda gösterir. Kapalıyken kenar çubuğu renk göstermez ve ayarladığınız renkleri korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочі простори й групи показують свої кольори на бічній панелі. Якщо вимкнено, панель не показує кольорів і зберігає задані вами кольори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không gian làm việc và nhóm hiện màu của chúng trong thanh bên. Khi tắt, thanh bên không hiện màu và vẫn giữ các màu bạn đã đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作区和组在边栏中显示其颜色。关闭后，边栏不显示颜色，并保留你设置的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作區和群組在側邊欄中顯示其顏色。關閉後，側邊欄不顯示顏色，並保留你設定的顏色。"
          }
        }
      }
    },
    "settings.workspaceColors.indicatorStyle": {
      "comment": "Settings > Appearance > Sidebar: how a workspace's color shows on its row",
      "extractionState": "manual",
      "localizations": {
