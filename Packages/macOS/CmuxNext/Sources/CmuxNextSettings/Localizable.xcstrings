    "settings.tabs.newTabTemplate.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تخطيط صفحة علامة التبويب الجديدة. يتخطى خيار الطرفية الصفحة ويفتح طرفية. النقاط أسفل الصفحة تغيره أيضًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raspored stranice nove kartice. Terminal preskače stranicu i otvara terminal. Tačke na dnu stranice ga također mijenjaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layoutet af siden Ny fane. Terminal springer siden over og åbner en terminal. Prikkerne nederst på siden ændrer det også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Layout der Seite „Neuer Tab“. Terminal überspringt die Seite und öffnet ein Terminal. Die Punkte unten auf der Seite ändern es ebenfalls."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout of the New Tab page. Terminal skips the page and opens a terminal. The dots at the bottom of the page also change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El diseño de la página Nueva pestaña. Terminal omite la página y abre una terminal. Los puntos al pie de la página también lo cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La disposition de la page Nouvel onglet. Terminal ignore la page et ouvre un terminal. Les points en bas de la page la changent aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il layout della pagina Nuova scheda. Terminale salta la pagina e apre un terminale. Anche i punti in fondo alla pagina lo cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規タブページのレイアウトです。「ターミナル」はページを表示せずにターミナルを開きます。ページ下部のドットでも変更できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្លង់នៃទំព័រផ្ទាំងថ្មី។ ទែមីណាល់រំលងទំព័រ ហើយបើកទែមីណាល់។ ចំណុចនៅខាងក្រោមទំព័រក៏ផ្លាស់ប្ដូរវាដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 탭 페이지의 레이아웃입니다. 터미널은 페이지를 건너뛰고 터미널을 엽니다. 페이지 하단의 점으로도 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oppsettet for siden Ny fane. Terminal hopper over siden og åpner en terminal. Prikkene nederst på siden endrer det også."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Układ strony Nowa karta. Terminal pomija stronę i otwiera terminal. Kropki na dole strony też go zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O layout da página Nova aba. Terminal pula a página e abre um terminal. Os pontos no rodapé da página também o alteram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Макет страницы новой вкладки. «Терминал» пропускает страницу и открывает терминал. Точки внизу страницы тоже его меняют."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลย์เอาต์ของหน้าแท็บใหม่ เทอร์มินัลจะข้ามหน้าและเปิดเทอร์มินัล จุดที่ด้านล่างของหน้าก็เปลี่ยนได้เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeni Sekme sayfasının düzeni. Terminal sayfayı atlar ve bir terminal açar. Sayfanın altındaki noktalar da bunu değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Макет сторінки нової вкладки. «Термінал» пропускає сторінку й відкриває термінал. Крапки внизу сторінки теж його змінюють."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bố cục của trang Thẻ mới. Terminal bỏ qua trang và mở terminal. Các chấm ở cuối trang cũng thay đổi nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新标签页的布局。“终端”跳过该页面并打开终端。页面底部的圆点也可以更改它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新分頁頁面的版面配置。「終端機」會略過該頁面並開啟終端機。頁面底部的圓點也可以變更它。"
          }
        }
      }
    },
