    "settings.appearance.density.help": {
      "comment": "Help under the Density setting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row height, padding, corners, icons and text size together. Compact is the default."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ارتفاع الصفوف والهوامش والزوايا والأيقونات وحجم النص معًا. المضغوط هو الافتراضي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visina redova, razmaci, uglovi, ikone i veličina teksta zajedno. Kompaktno je zadano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rækkehøjde, afstand, hjørner, ikoner og tekststørrelse samlet. Kompakt er standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeilenhöhe, Abstände, Ecken, Symbole und Textgröße gemeinsam. Kompakt ist der Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altura de filas, márgenes, esquinas, iconos y tamaño del texto a la vez. Compacta es la predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hauteur des lignes, marges, coins, icônes et taille du texte ensemble. Compact est la valeur par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altezza delle righe, spaziature, angoli, icone e dimensione del testo insieme. Compatta è il valore predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "行の高さ、余白、角、アイコン、文字サイズをまとめて変えます。標準はコンパクトです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្ពស់ជួរ គម្លាត ជ្រុង រូបតំណាង និងទំហំអក្សរ រួមគ្នា។ បង្រួម គឺជាលំនាំដើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "행 높이, 여백, 모서리, 아이콘, 텍스트 크기를 함께 바꿉니다. 기본값은 컴팩트입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radhøyde, avstand, hjørner, ikoner og tekststørrelse samlet. Kompakt er standard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysokość wierszy, odstępy, narożniki, ikony i rozmiar tekstu razem. Domyślna jest kompaktowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Altura das linhas, espaçamento, cantos, ícones e tamanho do texto juntos. Compacta é o padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Высота строк, отступы, углы, значки и размер текста вместе. По умолчанию — компактная."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความสูงแถว ระยะห่าง มุม ไอคอน และขนาดข้อความไปพร้อมกัน ค่าเริ่มต้นคือกะทัดรัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Satır yüksekliği, boşluk, köşeler, simgeler ve metin boyutu birlikte. Varsayılan Kompakt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Висота рядків, відступи, кути, значки й розмір тексту разом. Типово — компактна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiều cao hàng, khoảng đệm, góc, biểu tượng và cỡ chữ cùng lúc. Mặc định là Gọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "行高、间距、圆角、图标和文字大小一起变化。默认为紧凑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "列高、間距、圓角、圖示和文字大小一起變化。預設為緊湊。"
          }
        }
      }
    },
