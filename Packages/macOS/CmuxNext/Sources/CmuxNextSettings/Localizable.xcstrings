    "settings.appearance.colorTransition.springDamping.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 arrives smoothly with no overshoot. Above 1 is slower; below 1 arrives sooner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏1 يصل بسلاسة دون تجاوز. أعلى من 1 أبطأ؛ وأقل من 1 يصل أسرع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "1 stiže glatko bez prebačaja. Iznad 1 je sporije; ispod 1 stiže ranije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1 når frem blødt uden at skyde over. Over 1 er langsommere; under 1 når frem hurtigere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kommt sanft ohne Überschwingen an. Über 1 ist langsamer, unter 1 kommt früher an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 llega con suavidad y sin pasarse. Más de 1 es más lento; menos de 1 llega antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 arrive en douceur sans dépassement. Au-dessus de 1, c’est plus lent ; en dessous, c’est plus rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 arriva dolcemente senza superare. Sopra 1 è più lento; sotto 1 arriva prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 はオーバーシュートせずなめらかに到達します。1 より大きいと遅く、小さいと早く到達します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ដល់ដោយរលូន គ្មានលើស។ លើស 1 យឺតជាង ក្រោម 1 ដល់លឿនជាង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1이면 넘치지 않고 부드럽게 도달합니다. 1보다 크면 느리고, 작으면 더 빨리 도달합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kommer mykt frem uten å skyte over. Over 1 er tregere; under 1 kommer raskere frem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dochodzi płynnie bez przestrzelenia. Powyżej 1 wolniej; poniżej 1 szybciej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 chega suavemente sem passar do ponto. Acima de 1 é mais lento; abaixo de 1 chega antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 доходит плавно без перелёта. Больше 1 медленнее, меньше 1 быстрее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ไปถึงอย่างนุ่มนวลโดยไม่เลยเป้า มากกว่า 1 จะช้ากว่า น้อยกว่า 1 จะถึงเร็วกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 aşmadan yumuşakça ulaşır. 1'in üstü daha yavaş, altı daha erken ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 доходить плавно без перельоту. Більше 1 повільніше, менше 1 швидше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 tới nơi êm ái, không vượt quá. Trên 1 chậm hơn; dưới 1 tới sớm hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 平滑到达，不会过冲。大于 1 更慢；小于 1 更快到达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 平順到達，不會過衝。大於 1 更慢；小於 1 更快到達。"
          }
        }
      }
    },
