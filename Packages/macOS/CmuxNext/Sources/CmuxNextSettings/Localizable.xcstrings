          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigjør minne; historikk og rulling beholdes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwalnia pamięć; historia i przewinięcie zostają"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera memória; histórico e rolagem são mantidos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождает память; история и прокрутка сохраняются"
