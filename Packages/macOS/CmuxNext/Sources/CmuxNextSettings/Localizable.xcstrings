    "settings.contextMenus.showCustomizeItem.help": {
      "comment": "Settings > Menus: line under the Show Customize Menu… switch; 'it' is the Customize Menu… row. At most 60 characters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds Customize Menu… to the end of every right-click menu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف «تخصيص القائمة…» إلى نهاية كل قائمة للنقر بزر الماوس الأيمن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje „Prilagodi meni…“ na kraj svakog menija desnog klika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer “Tilpas menu…” nederst i hver højrekliksmenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt „Menü anpassen…“ am Ende jedes Kontextmenüs hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade «Personalizar menú…» al final de cada menú contextual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute « Personnaliser le menu… » à la fin de chaque menu contextuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge «Personalizza menu…» alla fine di ogni menu contestuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての右クリックメニューの末尾に「メニューをカスタマイズ…」を追加します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែម «ប្ដូរម៉ឺនុយតាមបំណង…» ទៅចុងម៉ឺនុយចុចខាងស្តាំនីមួយៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 오른쪽 클릭 메뉴의 끝에 ‘메뉴 사용자화…’를 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til «Tilpass meny…» nederst i hver høyreklikkmeny."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje „Dostosuj menu…” na końcu każdego menu kontekstowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona “Personalizar Menu…” ao final de cada menu de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет «Настроить меню…» в конец каждого контекстного меню."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม “ปรับแต่งเมนู…” ไว้ท้ายเมนูคลิกขวาทุกเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sağ tık menüsünün sonuna “Menüyü Özelleştir…” ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає «Налаштувати меню…» в кінець кожного контекстного меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm “Tùy chỉnh menu…” vào cuối mọi menu chuột phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个右键菜单的末尾添加“自定义菜单…”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個右鍵選單的末尾加入「自訂選單…」。"
          }
        }
      }
    },
    "settings.sidebar.textSize": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "حجم نص الشريط الجانبي"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Veličina teksta bočne trake"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Tekststørrelse i sidepanelet"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Textgröße der Seitenleiste"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sidebar Text Size"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tamaño del texto de la barra lateral"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Taille du texte de la barre latérale"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Dimensione del testo della barra laterale"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーの文字サイズ"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ទំហំអក្សររបារចំហៀង"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사이드바 텍스트 크기"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Tekststørrelse i sidefeltet"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Rozmiar tekstu paska bocznego"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Tamanho do texto da barra lateral"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Размер текста боковой панели"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ขนาดข้อความแถบด้านข้าง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğu metin boyutu"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Розмір тексту бічної панелі"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Cỡ chữ thanh bên"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "边栏文字大小"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "側邊欄文字大小"}}
      }
    },
    "settings.sidebar.textSize.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {"stringUnit": {"state": "needs_review", "value": "يكبّر الأسماء والعناوين والأيقونات والصفوف في الشريط الجانبي معًا. يطابق «أكبر» الشريط الجانبي لتطبيق ChatGPT."}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Povećava nazive, zaglavlja, ikone i redove bočne trake zajedno. „Veće” odgovara bočnoj traci aplikacije ChatGPT."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Gør sidepanelets navne, overskrifter, ikoner og rækker større sammen. Større svarer til sidepanelet i ChatGPT-appen."}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Vergrößert Namen, Überschriften, Symbole und Zeilen der Seitenleiste gemeinsam. „Größer“ entspricht der Seitenleiste der ChatGPT-App."}},
        "en": {"stringUnit": {"state": "translated", "value": "Makes the sidebar's names, headers, icons and rows larger together. Larger matches the ChatGPT app's sidebar."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Agranda a la vez los nombres, encabezados, iconos y filas de la barra lateral. «Más grande» coincide con la barra lateral de la app de ChatGPT."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Agrandit ensemble les noms, en-têtes, icônes et lignes de la barre latérale. « Plus grand » correspond à la barre latérale de l’app ChatGPT."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Ingrandisce insieme nomi, intestazioni, icone e righe della barra laterale. «Più grande» corrisponde alla barra laterale dell'app ChatGPT."}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "サイドバーの名前、見出し、アイコン、行をまとめて大きくします。「さらに大きく」は ChatGPT アプリのサイドバーと同じ大きさです。"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ធ្វើឱ្យឈ្មោះ ក្បាល រូបតំណាង និងជួរនៃរបារចំហៀងធំជាងមុនជាមួយគ្នា។ «ធំជាង» ស្មើនឹងរបារចំហៀងនៃកម្មវិធី ChatGPT។"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사이드바의 이름, 헤더, 아이콘, 행을 함께 키웁니다. \"더 크게\"는 ChatGPT 앱의 사이드바와 같은 크기입니다."}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Gjør navn, overskrifter, ikoner og rader i sidefeltet større samtidig. Større tilsvarer sidefeltet i ChatGPT-appen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Powiększa jednocześnie nazwy, nagłówki, ikony i wiersze paska bocznego. „Większy” odpowiada paskowi bocznemu aplikacji ChatGPT."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Aumenta juntos os nomes, cabeçalhos, ícones e linhas da barra lateral. “Maior” corresponde à barra lateral do app ChatGPT."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Увеличивает имена, заголовки, значки и строки боковой панели вместе. «Крупнее» совпадает с боковой панелью приложения ChatGPT."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ขยายชื่อ หัวข้อ ไอคอน และแถวในแถบด้านข้างไปพร้อมกัน \"ใหญ่ขึ้น\" มีขนาดเท่ากับแถบด้านข้างของแอป ChatGPT"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kenar çubuğundaki adları, başlıkları, simgeleri ve satırları birlikte büyütür. \"Daha büyük\", ChatGPT uygulamasının kenar çubuğuyla aynıdır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Збільшує назви, заголовки, значки й рядки бічної панелі разом. «Більший» відповідає бічній панелі застосунку ChatGPT."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Phóng to cùng lúc tên, tiêu đề, biểu tượng và các hàng của thanh bên. \"Lớn hơn\" khớp với thanh bên của ứng dụng ChatGPT."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "同时放大边栏的名称、标题、图标和行。“更大”与 ChatGPT 应用的边栏一致。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "同時放大側邊欄的名稱、標題、圖示和列。「更大」與 ChatGPT App 的側邊欄一致。"}}
      }
    },
