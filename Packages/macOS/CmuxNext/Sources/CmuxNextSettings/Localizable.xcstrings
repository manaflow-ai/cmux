    "settings.sidebar.groupPalette.help": {
      "comment": "Setting help: group palette.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where group colors come from. A color you pick for a group stays."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مصدر ألوان المجموعات. اللون الذي تختاره لمجموعة يبقى كما اخترته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odakle dolaze boje grupa. Boja koju izabereš za grupu ostaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor gruppefarverne kommer fra. En farve, du vælger til en gruppe, bliver ved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Woher die Gruppenfarben kommen. Eine Farbe, die du für eine Gruppe wählst, bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De dónde vienen los colores de grupo. Un color que elijas para un grupo se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "D'où viennent les couleurs des groupes. Une couleur choisie pour un groupe reste choisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da dove vengono i colori dei gruppi. Un colore scelto per un gruppo resta scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "グループの色の出どころです。グループに選んだ色はそのまま残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រភពនៃពណ៌ក្រុម។ ពណ៌ដែលអ្នកជ្រើសសម្រាប់ក្រុមនៅតែដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그룹 색상을 가져오는 곳입니다. 그룹에 직접 고른 색상은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
