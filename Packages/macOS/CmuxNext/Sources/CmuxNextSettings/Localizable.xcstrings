    "settings.computerUse.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can see and use your apps. macOS asks for Accessibility and Screen Recording."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن للوكلاء رؤية تطبيقاتك واستخدامها. يطلب macOS إذن تسهيلات الاستخدام وتسجيل الشاشة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenti mogu vidjeti i koristiti vaše aplikacije. macOS traži Pristupačnost i Snimanje ekrana."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenter kan se og bruge dine apps. macOS beder om Tilgængelighed og Skærmoptagelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenten können deine Apps sehen und bedienen. macOS fragt nach Bedienungshilfen und Bildschirmaufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los agentes pueden ver y usar tus apps. macOS pide Accesibilidad y Grabación de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les agents peuvent voir et utiliser vos apps. macOS demande l’Accessibilité et l’Enregistrement de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli agenti possono vedere e usare le tue app. macOS chiede Accessibilità e Registrazione schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントがアプリを表示・操作できます。macOSがアクセシビリティと画面収録の許可を求めます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារអាចមើល និងប្រើកម្មវិធីរបស់អ្នក។ macOS សុំការអនុញ្ញាត Accessibility និង Screen Recording។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트가 앱을 보고 사용할 수 있습니다. macOS가 손쉬운 사용과 화면 기록 권한을 요청합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenter kan se og bruke appene dine. macOS ber om Tilgjengelighet og Skjermopptak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenci mogą widzieć i używać Twoich aplikacji. macOS prosi o Dostępność i Nagrywanie ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os agentes podem ver e usar seus apps. O macOS pede Acessibilidade e Gravação de Tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенты могут видеть и использовать ваши приложения. macOS запросит Универсальный доступ и Запись экрана."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอเจนต์มองเห็นและใช้แอปของคุณได้ macOS จะขอสิทธิ์การช่วยการเข้าถึงและการบันทึกหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajanlar uygulamalarınızı görebilir ve kullanabilir. macOS Erişilebilirlik ve Ekran Kaydı ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Агенти можуть бачити й використовувати ваші застосунки. macOS запитає Доступність і Запис екрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác nhân có thể xem và dùng các ứng dụng của bạn. macOS sẽ hỏi quyền Trợ năng và Ghi màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理可以查看和使用你的应用。macOS 会请求辅助功能和屏幕录制权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理可以檢視和使用你的應用程式。macOS 會要求輔助使用與螢幕錄製權限。"
          }
        }
      }
    },
