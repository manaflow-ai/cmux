    "settings.agents.trust.ownOrgs.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A repository is trusted when all of its GitHub remotes belong to these users or organizations."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكون المستودع موثوقاً عندما تعود جميع مستودعاته البعيدة على GitHub إلى هؤلاء المستخدمين أو المؤسسات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozitorij je pouzdan kada svi njegovi GitHub udaljeni repozitoriji pripadaju ovim korisnicima ili organizacijama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et repository er betroet, når alle dets GitHub-remotes tilhører disse brugere eller organisationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Repository gilt als vertrauenswürdig, wenn alle seine GitHub-Remotes zu diesen Benutzern oder Organisationen gehören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repositorio es de confianza cuando todos sus remotos de GitHub pertenecen a estos usuarios u organizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dépôt est approuvé lorsque tous ses dépôts distants GitHub appartiennent à ces utilisateurs ou organisations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repository è attendibile quando tutti i suoi remoti GitHub appartengono a questi utenti o organizzazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリのすべての GitHub リモートがこれらのユーザーまたは組織に属している場合、そのリポジトリを信頼します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឃ្លាំងមួយត្រូវបានជឿទុកចិត្តនៅពេលដែល remote GitHub ទាំងអស់របស់វាជាកម្មសិទ្ធិរបស់អ្នកប្រើប្រាស់ ឬអង្គការទាំងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소의 모든 GitHub 원격이 이 사용자 또는 조직에 속하면 해당 저장소를 신뢰합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et repositorium er klarert når alle GitHub-remotene tilhører disse brukerne eller organisasjonene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozytorium jest zaufane, gdy wszystkie jego zdalne repozytoria GitHub należą do tych użytkowników lub organizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um repositório é confiável quando todos os seus remotos do GitHub pertencem a esses usuários ou organizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий считается доверенным, если все его удалённые репозитории GitHub принадлежат этим пользователям или организациям."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีโพซิทอรีจะได้รับความเชื่อถือเมื่อรีโมต GitHub ทั้งหมดเป็นของผู้ใช้หรือองค์กรเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir deponun tüm GitHub uzak depoları bu kullanıcılara veya kuruluşlara aitse depoya güvenilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторій вважається довіреним, якщо всі його віддалені репозиторії GitHub належать цим користувачам або організаціям."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một kho được tin cậy khi tất cả remote GitHub của nó thuộc về các người dùng hoặc tổ chức này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当仓库的所有 GitHub 远程仓库都属于这些用户或组织时，该仓库即受信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當儲存庫的所有 GitHub 遠端儲存庫都屬於這些使用者或組織時，該儲存庫即受信任。"
          }
        }
      }
    },
