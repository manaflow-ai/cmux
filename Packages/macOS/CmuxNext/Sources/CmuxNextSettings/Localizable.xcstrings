    "settings.sidebar.numbering.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل العناصر: الصفحة الرئيسية هي Command-1. مساحات العمل فقط: أول مساحة عمل هي Command-1."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka stavka: Početna je Command-1. Samo radni prostori: prvi radni prostor je Command-1."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle elementer: Hjem er Command-1. Kun arbejdsområder: det første arbejdsområde er Command-1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Einträge: Home ist Command-1. Nur Arbeitsbereiche: Der erste Arbeitsbereich ist Command-1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Item: Home is Command-1. Workspaces Only: the first workspace is Command-1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los elementos: Inicio es Command-1. Solo espacios de trabajo: el primer espacio de trabajo es Command-1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les éléments : Accueil est Command-1. Espaces de travail uniquement : le premier espace de travail est Command-1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutti gli elementi: Home è Command-1. Solo spazi di lavoro: il primo spazio di lavoro è Command-1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての項目: ホームが Command-1。ワークスペースのみ: 最初のワークスペースが Command-1。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ធាតុទាំងអស់៖ ទំព័រដើមគឺ Command-1។ តែកន្លែងធ្វើការ៖ កន្លែងធ្វើការដំបូងគឺ Command-1។"
          }
        },
        "ko": {
          "stringUnit": {
