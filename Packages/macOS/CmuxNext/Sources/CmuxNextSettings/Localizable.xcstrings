    "settings.app.showMenuBarIcon.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cmux item in the menu bar: open cmux, your account, working agents, help, Discord, updates, logs and Quit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنصر cmux في شريط القوائم: فتح cmux وحسابك والوكلاء العاملون والمساعدة وDiscord والتحديثات والسجلات والإنهاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavka cmux na traci menija: otvori cmux, tvoj račun, agenti koji rade, pomoć, Discord, ažuriranja, zapisnici i Izlaz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et cmux-element på menulinjen: åbn cmux, din konto, agenter i arbejde, hjælp, Discord, opdateringer, logfiler og Afslut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein cmux-Eintrag in der Menüleiste: cmux öffnen, dein Konto, aktive Agenten, Hilfe, Discord, Updates, Protokolle und Beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento de cmux en la barra de menús: abrir cmux, tu cuenta, agentes trabajando, ayuda, Discord, actualizaciones, registros y Salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément cmux dans la barre des menus : ouvrir cmux, votre compte, les agents au travail, l’aide, Discord, les mises à jour, les journaux et Quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento cmux nella barra dei menu: apri cmux, il tuo account, agenti al lavoro, aiuto, Discord, aggiornamenti, log ed Esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの cmux 項目: cmux を開く、アカウント、作業中のエージェント、ヘルプ、Discord、アップデート、ログ、終了。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ធាតុ cmux នៅរបារម៉ឺនុយ៖ បើក cmux គណនីរបស់អ្នក ភ្នាក់ងារកំពុងធ្វើការ ជំនួយ Discord បច្ចុប្បន្នភាព កំណត់ហេតុ និងចាកចេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 cmux 항목: cmux 열기, 계정, 작업 중인 에이전트, 도움말, Discord, 업데이트, 로그, 종료."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et cmux-element i menylinjen: åpne cmux, kontoen din, agenter i arbeid, hjelp, Discord, oppdateringer, logger og Avslutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element cmux na pasku menu: otwórz cmux, twoje konto, pracujący agenci, pomoc, Discord, aktualizacje, logi i Zakończ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item do cmux na barra de menus: abrir o cmux, sua conta, agentes trabalhando, ajuda, Discord, atualizações, registros e Sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункт cmux в строке меню: открыть cmux, ваш аккаунт, работающие агенты, справка, Discord, обновления, журналы и выход."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการ cmux ในแถบเมนู: เปิด cmux บัญชีของคุณ เอเจนต์ที่กำลังทำงาน ความช่วยเหลือ Discord การอัปเดต บันทึก และออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğunda bir cmux öğesi: cmux'ı aç, hesabın, çalışan ajanlar, yardım, Discord, güncellemeler, günlükler ve Çık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункт cmux у рядку меню: відкрити cmux, ваш обліковий запис, агенти, що працюють, довідка, Discord, оновлення, журнали й вихід."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mục cmux trên thanh menu: mở cmux, tài khoản của bạn, tác nhân đang làm việc, trợ giúp, Discord, cập nhật, nhật ký và Thoát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏中的 cmux 项目：打开 cmux、你的账户、正在工作的代理、帮助、Discord、更新、日志和退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列中的 cmux 項目：打開 cmux、你的帳號、正在工作的代理程式、輔助說明、Discord、更新、記錄和結束。"
          }
        }
      }
    },
