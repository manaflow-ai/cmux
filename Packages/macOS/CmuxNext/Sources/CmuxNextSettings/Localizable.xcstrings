    "settings.tabs.newTabWidgets.actions.help": {
      "comment": "Settings: help for the New Tab quick actions toggle. New Terminal, New Browser Tab and New Chat are the names of those buttons.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحادثات التي تحتاج إليك، و«طرفية جديدة» و«علامة تبويب متصفح جديدة» و«محادثة جديدة»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razgovori kojima ste potrebni, te Novi terminal, Nova kartica preglednika i Novi razgovor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, der har brug for dig, og Ny terminal, Ny browserfane og Ny chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, die dich brauchen, sowie Neues Terminal, Neuer Browser-Tab und Neuer Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats that need you, and New Terminal, New Browser Tab and New Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats que te necesitan, y Nueva terminal, Nueva pestaña del navegador y Nuevo chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions qui attendent votre réponse, ainsi que Nouveau terminal, Nouvel onglet de navigateur et Nouvelle discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat che richiedono la tua attenzione, e Nuovo terminale, Nuova scheda del browser e Nuova chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なチャットと、新規ターミナル、新規ブラウザタブ、新規チャット。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​ជជែក​ដែល​ត្រូវ​ការ​អ្នក និង​ទែមីណាល់​ថ្មី ផ្ទាំង​កម្មវិធី​រុករក​ថ្មី និង​ការ​ជជែក​ថ្មី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 필요한 채팅과 새 터미널, 새 브라우저 탭, 새 채팅."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatter som trenger deg, og Ny terminal, Ny nettleserfane og Ny chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czaty, które czekają na Ciebie, oraz Nowy terminal, Nowa karta przeglądarki i Nowy czat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas que precisam de você, e Novo terminal, Nova aba do navegador e Nova conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты, которые ждут вас, а также «Новый терминал», «Новая вкладка браузера» и «Новый чат»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตที่รอคุณ รวมถึงเทอร์มินัลใหม่ แท็บเบราว์เซอร์ใหม่ และแชตใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi bekleyen sohbetler ve Yeni Terminal, Yeni Tarayıcı Sekmesi ve Yeni Sohbet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чати, які чекають на вас, а також «Новий термінал», «Нова вкладка браузера» і «Новий чат»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện cần bạn, cùng Terminal mới, Tab trình duyệt mới và Trò chuyện mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你处理的对话，以及“新建终端”“新建浏览器标签页”和“新建对话”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你處理的對話，以及「新增終端機」「新增瀏覽器分頁」和「新增對話」。"
          }
        }
      }
    },
