    "settings.sidebar.numbering.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل العناصر: الصفحة الرئيسية هي Command-1، وApp Store هو Command-2، وأول مساحة عمل هي Command-3. مساحات العمل فقط: أول مساحة عمل هي Command-1."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaka stavka: Početna je Command-1, App Store Command-2, prvi radni prostor Command-3. Samo radni prostori: prvi radni prostor je Command-1."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle elementer: Hjem er Command-1, App Store Command-2, det første arbejdsområde Command-3. Kun arbejdsområder: det første arbejdsområde er Command-1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Einträge: Home ist Befehl-1, der App Store Befehl-2, der erste Arbeitsbereich Befehl-3. Nur Arbeitsbereiche: Der erste Arbeitsbereich ist Befehl-1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every item: Home is Command-1, the App Store Command-2, the first workspace Command-3. Workspaces only: the first workspace is Command-1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos los elementos: Inicio es Comando-1, la App Store Comando-2 y el primer espacio de trabajo Comando-3. Solo espacios de trabajo: el primer espacio de trabajo es Comando-1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tous les éléments : Accueil est Commande-1, l’App Store Commande-2, le premier espace de travail Commande-3. Espaces de travail uniquement : le premier espace de travail est Commande-1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutti gli elementi: Home è Comando-1, l’App Store Comando-2, il primo spazio di lavoro Comando-3. Solo spazi di lavoro: il primo spazio di lavoro è Comando-1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての項目: ホームが Command-1、App Store が Command-2、最初のワークスペースが Command-3 です。ワークスペースのみ: 最初のワークスペースが Command-1 です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ធាតុទាំងអស់៖ ទំព័រដើមគឺ Command-1, App Store គឺ Command-2, កន្លែងធ្វើការដំបូងគឺ Command-3។ តែកន្លែងធ្វើការ៖ កន្លែងធ្វើការដំបូងគឺ Command-1។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 항목: 홈은 Command-1, App Store는 Command-2, 첫 작업 공간은 Command-3입니다. 작업 공간만: 첫 작업 공간이 Command-1입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle elementer: Hjem er Kommando-1, App Store Kommando-2, det første arbeidsområdet Kommando-3. Bare arbeidsområder: det første arbeidsområdet er Kommando-1."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie elementy: Strona główna to Command-1, App Store to Command-2, pierwszy obszar roboczy to Command-3. Tylko obszary robocze: pierwszy obszar roboczy to Command-1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todos os itens: Início é Command-1, a App Store Command-2 e o primeiro espaço de trabalho Command-3. Somente espaços de trabalho: o primeiro espaço de trabalho é Command-1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все элементы: Главная — Command-1, App Store — Command-2, первое рабочее пространство — Command-3. Только рабочие пространства: первое рабочее пространство — Command-1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทุกรายการ: หน้าหลักคือ Command-1, App Store คือ Command-2, พื้นที่ทำงานแรกคือ Command-3 เฉพาะพื้นที่ทำงาน: พื้นที่ทำงานแรกคือ Command-1"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm öğeler: Ana Sayfa Command-1, App Store Command-2, ilk çalışma alanı Command-3'tür. Yalnızca çalışma alanları: ilk çalışma alanı Command-1'dir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усі елементи: Головна — Command-1, App Store — Command-2, перший робочий простір — Command-3. Лише робочі простори: перший робочий простір — Command-1."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mọi mục: Trang chủ là Command-1, App Store là Command-2, không gian làm việc đầu tiên là Command-3. Chỉ không gian làm việc: không gian làm việc đầu tiên là Command-1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有项目：主页是 Command-1，App Store 是 Command-2，第一个工作区是 Command-3。仅工作区：第一个工作区是 Command-1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有項目：首頁是 Command-1，App Store 是 Command-2，第一個工作區是 Command-3。僅工作區：第一個工作區是 Command-1。"
          }
        }
      }
    },
