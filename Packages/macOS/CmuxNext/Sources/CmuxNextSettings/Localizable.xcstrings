    "settings.browser.verificationAutofill.accounts.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes come only from these addresses. Mail is read on this Mac, never stored or sent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تأتي الرموز من هذه العناوين فقط. تُقرأ الرسائل على هذا الـ Mac ولا تُخزَّن ولا تُرسَل أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kodovi dolaze samo s ovih adresa. Pošta se čita na ovom Macu i nikad se ne pohranjuje niti šalje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koder kommer kun fra disse adresser. Mail læses på denne Mac og bliver aldrig gemt eller sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codes kommen nur von diesen Adressen. Mails werden auf diesem Mac gelesen, nie gespeichert oder gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los códigos solo provienen de estas direcciones. El correo se lee en este Mac y nunca se guarda ni se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les codes viennent uniquement de ces adresses. Les e-mails sont lus sur ce Mac, jamais enregistrés ni envoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I codici arrivano solo da questi indirizzi. La posta viene letta su questo Mac, mai salvata né inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コードはこれらのアドレスからのみ読み取ります。メールはこの Mac 上で読み取り、保存も送信もしません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "លេខកូដមកពីអាសយដ្ឋានទាំងនេះតែប៉ុណ្ណោះ។ អ៊ីមែលត្រូវបានអាននៅលើ Mac នេះ មិនដែលរក្សាទុក ឬផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "코드는 이 주소에서만 가져옵니다. 메일은 이 Mac에서 읽으며 저장하거나 전송하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koder kommer bare fra disse adressene. E-post leses på denne Macen og blir aldri lagret eller sendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kody pochodzą tylko z tych adresów. Poczta jest czytana na tym Macu, nigdy zapisywana ani wysyłana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os códigos vêm apenas destes endereços. Os e-mails são lidos neste Mac e nunca são guardados nem enviados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коды берутся только с этих адресов. Почта читается на этом Mac, никогда не сохраняется и не отправляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รหัสมาจากที่อยู่เหล่านี้เท่านั้น อีเมลถูกอ่านบน Mac เครื่องนี้ ไม่ถูกเก็บหรือส่งไปที่ใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kodlar yalnızca bu adreslerden gelir. E-postalar bu Mac'te okunur, asla saklanmaz veya gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коди беруться лише з цих адрес. Пошта читається на цьому Mac і ніколи не зберігається й не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mã chỉ lấy từ các địa chỉ này. Thư được đọc trên máy Mac này, không bao giờ được lưu hay gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "验证码只来自这些地址。邮件只在这台 Mac 上读取，从不保存或发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "驗證碼只來自這些地址。郵件只在這台 Mac 上讀取，從不儲存或傳送。"
          }
        }
      }
    },
