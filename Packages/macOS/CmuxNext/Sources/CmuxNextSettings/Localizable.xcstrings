    "settings.agentPane.display.proseFamily.help": {
      "comment": "Settings > Agent Chat: help for the reply font family row",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The font of the agent's replies. When set, it replaces the Chat Font."
          }
        },
        "ar": {
          "stringUnit": {
