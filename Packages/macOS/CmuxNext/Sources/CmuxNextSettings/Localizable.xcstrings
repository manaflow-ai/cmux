          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko Nightly. Bez nazw plików, tekstu i adresów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente Nightly. Sem nomes de arquivos, texto ou endereços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только Nightly. Без имён файлов, текста и адресов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะ Nightly ไม่มีชื่อไฟล์ ข้อความ หรือที่อยู่"
