    "settings.notifications.suppressWhileTyping.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pane typed into this recently is marked read at once. 0 turns it off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この時間内に入力したペインはすぐに既読になります。0でオフ。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُعلَّم الجزء الذي كُتب فيه خلال هذه المدة كمقروء فورًا. القيمة 0 توقف ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okno u koje ste kucali u ovom periodu odmah se označava pročitanim. 0 isključuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En rude, der er skrevet i så nylig, markeres straks som læst. 0 slår det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Bereich, in den so kürzlich getippt wurde, gilt sofort als gelesen. 0 schaltet es aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un panel en el que se escribió hace tan poco se marca como leído al instante. 0 lo desactiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un panneau où vous avez tapé aussi récemment est marqué comme lu aussitôt. 0 désactive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un riquadro in cui hai scritto così di recente viene segnato come letto subito. 0 lo disattiva."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងដែលបានវាយក្នុងរយៈពេលនេះត្រូវបានសម្គាល់ថាបានអានភ្លាម។ 0 បិទវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 시간 안에 입력한 창은 바로 읽음으로 표시됩니다. 0이면 끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En rute det nylig er skrevet i, markeres straks som lest. 0 slår det av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Panel, w którym pisano tak niedawno, od razu jest oznaczany jako przeczytany. 0 wyłącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um painel em que se digitou há tão pouco é marcado como lido na hora. 0 desativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель, в которой печатали так недавно, сразу помечается прочитанной. 0 отключает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แผงที่เพิ่งพิมพ์ภายในช่วงเวลานี้จะถูกทำเครื่องหมายว่าอ่านแล้วทันที 0 คือปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kadar yakın zamanda yazılan bölme hemen okundu sayılır. 0 kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Панель, у якій друкували так нещодавно, одразу позначається прочитаною. 0 вимикає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khung vừa được gõ trong khoảng này sẽ được đánh dấu đã đọc ngay. 0 để tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此时长内输入过的窗格会立即标记为已读。0 表示关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此時長內輸入過的窗格會立即標示為已讀。0 表示關閉。"
          }
        }
      }
    },
