    "settings.sidebar.showNewWorkspaceChooser.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chevron beside the + opens the New Workspace menu. Off: right-click the +."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ の横のシェブロンで新規ワークスペースメニューを開きます。オフ: + を右クリック。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفتح سهم بجانب + قائمة مساحة العمل الجديدة. عند الإيقاف: انقر بزر الماوس الأيمن على +."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strelica pored + otvara meni nove radne površine. Isključeno: desni klik na +."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En pil ved siden af + åbner menuen Nyt arbejdsområde. Fra: højreklik på +."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Pfeil neben dem + öffnet das Menü „Neuer Arbeitsbereich“. Aus: Rechtsklick auf das +."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una flecha junto al + abre el menú Nuevo espacio de trabajo. Desactivado: haz clic derecho en el +."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un chevron à côté du + ouvre le menu Nouvel espace de travail. Désactivé : clic droit sur le +."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una freccia accanto al + apre il menu Nuovo spazio di lavoro. Disattivato: fai clic destro sul +."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សញ្ញាព្រួញនៅក្បែរ + បើកម៉ឺនុយកន្លែងធ្វើការថ្មី។ បិទ៖ ចុចកណ្ដុរស្ដាំលើ +។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ 옆 화살표로 새 작업 공간 메뉴를 엽니다. 끄면 +를 오른쪽 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En pil ved siden av + åpner menyen Nytt arbeidsområde. Av: høyreklikk på +."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strzałka obok + otwiera menu nowego obszaru roboczego. Wyłączone: kliknij + prawym przyciskiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma seta ao lado do + abre o menu Novo espaço de trabalho. Desativado: clique com o botão direito no +."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стрелка рядом с + открывает меню нового рабочего пространства. Выкл.: щёлкните + правой кнопкой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลูกศรข้าง + จะเปิดเมนูพื้นที่ทำงานใหม่ ปิด: คลิกขวาที่ +"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ yanındaki ok Yeni Çalışma Alanı menüsünü açar. Kapalı: + üzerine sağ tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стрілка поруч із + відкриває меню нового робочого простору. Вимкнено: клацніть + правою кнопкою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mũi tên cạnh dấu + mở menu Không gian làm việc mới. Tắt: nhấp chuột phải vào dấu +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ 旁的箭头可打开新建工作区菜单。关闭：右键点按 +。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ 旁的箭頭可開啟新增工作區選單。關閉：按右鍵點按 +。"
          }
        }
      }
    },
