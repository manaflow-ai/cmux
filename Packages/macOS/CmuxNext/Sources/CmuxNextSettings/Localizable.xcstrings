        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជាមួយ បំបែកដោយស្វ័យប្រវត្តិ កម្មវិធីរុករកថ្មីក៏ទទួលបានផ្ទាំងផ្ទាល់ខ្លួនជំនួសឱ្យផ្ទាំងទំព័រ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자동으로 분할을 사용하면 새 브라우저도 탭 대신 자체 패널을 갖습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med Del automatisk får nye nettlesere også sin egen rute i stedet for en fane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przy opcji Dziel automatycznie nowe przeglądarki także dostają własny panel zamiast karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com Dividir automaticamente, novos navegadores também ganham um painel próprio em vez de uma aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При «Разделять автоматически» новые браузеры тоже получают свою панель вместо вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อใช้แยกโดยอัตโนมัติ เบราว์เซอร์ใหม่จะได้บานของตัวเองแทนแท็บด้วย"
