    "globalSearch.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type to search every terminal, agent session and tab"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب للبحث في كل طرفية وجلسة وكيل وعلامة تبويب"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kucajte da pretražite svaki terminal, sesiju agenta i karticu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv for at søge i alle terminaler, agentsessioner og faner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um alle Terminals, Agent-Sitzungen und Tabs zu durchsuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe para buscar en cada terminal, sesión de agente y pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez pour rechercher dans chaque terminal, session d’agent et onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita per cercare in ogni terminale, sessione degli agenti e scheda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力すると、すべてのターミナル、エージェントセッション、タブを検索します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វាយដើម្បីស្វែងរកក្នុងទែមីណាល់ វគ្គភ្នាក់ងារ និងផ្ទាំងទាំងអស់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하여 모든 터미널, 에이전트 세션, 탭 검색"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skriv for å søke i alle terminaler, agentøkter og faner"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz, aby przeszukać każdy terminal, sesję agenta i kartę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite para buscar em todos os terminais, sessões de agentes e abas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните вводить, чтобы искать по всем терминалам, сеансам агентов и вкладкам"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พิมพ์เพื่อค้นหาในทุกเทอร์มินัล เซสชันเอเจนต์ และแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm terminallerde, ajan oturumlarında ve sekmelerde aramak için yazın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Почніть вводити, щоб шукати в усіх терміналах, сеансах агентів і вкладках"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập để tìm trong mọi terminal, phiên agent và tab"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入以搜索所有终端、代理会话和标签页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入以搜尋所有終端機、代理工作階段和分頁"
          }
        }
      }
    },
