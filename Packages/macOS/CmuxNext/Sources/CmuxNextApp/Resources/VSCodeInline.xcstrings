{
  "sourceLanguage": "en",
  "strings": {
    "vscodeInline.noFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No folder to open: focus a terminal, or run this from the palette to pick one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد مجلد لفتحه: ركّز على طرفية، أو شغّل هذا من لوحة الأوامر لاختيار مجلد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema mape za otvaranje: fokusirajte terminal ili ovo pokrenite iz palete da odaberete mapu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen mappe at åbne: fokuser en terminal, eller kør dette fra paletten for at vælge en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Ordner zum Öffnen: Fokussiere ein Terminal oder führe dies über die Befehlspalette aus, um einen auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay carpeta que abrir: enfoca una terminal o ejecuta esto desde la paleta para elegir una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun dossier à ouvrir : activez un terminal ou lancez ceci depuis la palette pour en choisir un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna cartella da aprire: attiva un terminale oppure esegui il comando dalla palette per sceglierne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くフォルダーがありません。ターミナルにフォーカスするか、パレットから実行してフォルダーを選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានថតដើម្បីបើកទេ៖ ផ្ដោតលើស្ថានីយ ឬដំណើរការពីផ្ទាំងពាក្យបញ្ជាដើម្បីជ្រើសថតមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "열 폴더가 없습니다. 터미널에 포커스를 두거나 팔레트에서 실행해 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen mappe å åpne: fokuser en terminal, eller kjør dette fra paletten for å velge en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak folderu do otwarcia: aktywuj terminal albo uruchom to z palety, aby wybrać folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma pasta para abrir: foque um terminal ou execute pela paleta para escolher uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет папки для открытия: переключитесь на терминал или запустите это из палитры, чтобы выбрать папку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีโฟลเดอร์ให้เปิด: โฟกัสเทอร์มินัล หรือเรียกจากพาเล็ตคำสั่งเพื่อเลือกโฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Açılacak klasör yok: bir terminale odaklanın veya bir klasör seçmek için bunu paletten çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає папки для відкриття: перейдіть у термінал або запустіть це з палітри, щоб вибрати папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có thư mục để mở: hãy chọn một terminal, hoặc chạy lệnh này từ bảng lệnh để chọn thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有可打开的文件夹：请聚焦一个终端，或从命令面板运行以选择文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有可開啟的資料夾：請聚焦一個終端機，或從命令面板執行以選擇資料夾。"
          }
        }
      }
    },
