    "hangReports.ask.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل تقريرًا يوميًا عن حالات التجمّد والإطارات البطيئة من إصدار Nightly هذا. يحتوي على مكدسات الاستدعاء والتوقيتات، ولا يحتوي أبدًا على أسماء ملفات أو نصوص أو عناوين ويب. يضم قسم الإعدادات المفتاح ويعرض ما يُرسل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šalji dnevni izvještaj o zastojima i sporim kadrovima iz ove Nightly verzije. Sadrži stekove poziva i vremena, nikada imena datoteka, tekst ni web adrese. Postavke imaju prekidač i pokazuju šta se šalje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send en daglig rapport om hængninger og langsomme billeder fra denne Nightly-build. Den indeholder kaldestakke og tider, aldrig filnavne, tekst eller webadresser. Indstillinger har kontakten og viser, hvad der sendes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende täglich einen Bericht über Hänger und langsame Frames aus diesem Nightly-Build. Er enthält Aufrufstapel und Zeiten, nie Dateinamen, Texte oder Webadressen. In den Einstellungen findest du den Schalter und siehst, was gesendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a daily report of hangs and slow frames from this Nightly build. It holds call stacks and timings, never file names, text or web addresses. Settings has the switch and shows what is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un informe diario de bloqueos y fotogramas lentos de esta versión Nightly. Contiene pilas de llamadas y tiempos, nunca nombres de archivo, texto ni direcciones web. En Ajustes está el interruptor y puedes ver lo que se envía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez chaque jour un rapport sur les blocages et les images lentes de cette version Nightly. Il contient des piles d’appels et des durées, jamais de noms de fichiers, de texte ni d’adresses web. Les réglages contiennent l’interrupteur et montrent ce qui est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia ogni giorno un rapporto su blocchi e fotogrammi lenti da questa build Nightly. Contiene stack di chiamate e tempi, mai nomi di file, testo o indirizzi web. Nelle Impostazioni trovi l’interruttore e vedi cosa viene inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このNightlyビルドのハングと遅いフレームのレポートを1日1回送信します。コールスタックと所要時間のみで、ファイル名、テキスト、Webアドレスは一切含みません。設定でオン・オフを切り替え、送信内容を確認できます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ផ្ញើ​របាយការណ៍​ប្រចាំថ្ងៃ​អំពី​ការ​គាំង និង​ស៊ុម​យឺត​ពី​កំណែ Nightly នេះ។ វា​មាន​ជង់​ការ​ហៅ និង​ពេលវេលា មិន​ដែល​មាន​ឈ្មោះ​ឯកសារ អត្ថបទ ឬ​អាសយដ្ឋាន​បណ្ដាញ​ឡើយ។ ការកំណត់​មាន​កុងតាក់ និង​បង្ហាញ​អ្វី​ដែល​ត្រូវ​ផ្ញើ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Nightly 빌드의 멈춤과 느린 프레임에 대한 보고서를 하루에 한 번 보냅니다. 호출 스택과 소요 시간만 담기며 파일 이름, 텍스트, 웹 주소는 절대 포함하지 않습니다. 설정에서 켜고 끌 수 있고 보내는 내용을 확인할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send en daglig rapport om henginger og trege bilder fra dette Nightly-bygget. Den inneholder kallstabler og tider, aldri filnavn, tekst eller nettadresser. Innstillinger har bryteren og viser hva som sendes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj codzienny raport o zawieszeniach i wolnych klatkach z tej wersji Nightly. Zawiera stosy wywołań i czasy, nigdy nazwy plików, tekst ani adresy stron. W Ustawieniach jest przełącznik i podgląd tego, co jest wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie um relatório diário de travamentos e quadros lentos desta versão Nightly. Ele contém pilhas de chamadas e tempos, nunca nomes de arquivos, texto ou endereços web. Os Ajustes têm a chave e mostram o que é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раз в день отправлять отчёт о зависаниях и медленных кадрах из этой сборки Nightly. В нём только стеки вызовов и длительности, никогда имена файлов, текст или веб-адреса. В настройках есть переключатель и видно, что отправляется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งรายงานการค้างและเฟรมที่ช้าจากรุ่น Nightly นี้วันละครั้ง มีเพียง call stack และเวลาที่ใช้ ไม่มีชื่อไฟล์ ข้อความ หรือที่อยู่เว็บเลย การตั้งค่ามีสวิตช์และแสดงสิ่งที่ส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Nightly sürümünden her gün donmalar ve yavaş kareler hakkında bir rapor gönderin. Çağrı yığınlarını ve süreleri içerir; asla dosya adı, metin veya web adresi içermez. Ayarlar’da anahtar bulunur ve neyin gönderildiği gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щодня надсилати звіт про зависання й повільні кадри з цієї збірки Nightly. Він містить стеки викликів і тривалості, ніколи назви файлів, текст чи вебадреси. У Параметрах є перемикач і видно, що надсилається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi báo cáo hằng ngày về các lần treo và khung hình chậm từ bản Nightly này. Báo cáo chứa ngăn xếp lệnh gọi và thời gian, không bao giờ có tên tệp, văn bản hay địa chỉ web. Cài đặt có công tắc và cho thấy nội dung được gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天从这个 Nightly 版本发送一份卡顿与慢帧报告。报告只含调用栈和耗时，绝不包含文件名、文本或网址。可在设置中开关并查看发送的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天從這個 Nightly 版本傳送一份卡頓與慢影格報告。報告只含呼叫堆疊和耗時，絕不包含檔案名稱、文字或網址。可在設定中開關並檢視傳送的內容。"
          }
        }
      }
    },
