    "cloud.codexDevice.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use Codex sign-in on this Mac. Enter this one-time code: %@"}},
        "de": {"stringUnit": {"state": "translated", "value": "Melde dich auf diesem Mac bei Codex an. Gib diesen Einmalcode ein: %@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Connectez-vous à Codex sur ce Mac. Saisissez ce code à usage unique : %@"}},
        "ar": {"stringUnit": {"state": "translated", "value": "سجّل الدخول إلى Codex على جهاز Mac هذا. أدخل هذا الرمز المخصص للاستخدام مرة واحدة: %@"}},
        "es": {"stringUnit": {"state": "translated", "value": "Inicia sesión en Codex en este Mac. Introduce este código de un solo uso: %@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在這部 Mac 上登入 Codex。輸入此一次性驗證碼：%@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在这台 Mac 上登录 Codex。输入此一次性验证码：%@"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 Mac에서 Codex에 로그인하세요. 다음 일회용 코드를 입력하세요: %@"}},
        "ja": {"stringUnit": {"state": "translated", "value": "このMacでCodexにログインしてください。次のワンタイムコードを入力してください：%@"}},
        "it": {"stringUnit": {"state": "translated", "value": "Accedi a Codex su questo Mac. Inserisci questo codice monouso: %@"}},
        "da": {"stringUnit": {"state": "translated", "value": "Log ind på Codex på denne Mac. Indtast denne engangskode: %@"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Logg inn på Codex på denne Macen. Skriv inn denne engangskoden: %@"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się do Codex na tym Macu. Wpisz ten jednorazowy kod: %@"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Entre no Codex neste Mac. Insira este código de uso único: %@"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Войдите в Codex на этом Mac. Введите этот одноразовый код: %@"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Увійдіть у Codex на цьому Mac. Введіть цей одноразовий код: %@"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Prijavite se u Codex na ovom Macu. Unesite ovaj jednokratni kôd: %@"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Đăng nhập vào Codex trên máy Mac này. Nhập mã dùng một lần sau: %@"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu Mac’te Codex’te oturum açın. Bu tek kullanımlık kodu girin: %@"}},
        "th": {"stringUnit": {"state": "translated", "value": "ลงชื่อเข้าใช้ Codex บน Mac เครื่องนี้ ป้อนรหัสแบบใช้ครั้งเดียวนี้: %@"}},
        "km": {"stringUnit": {"state": "translated", "value": "ចូលប្រើ Codex នៅលើ Mac នេះ។ បញ្ចូលលេខកូដប្រើបានតែម្តងនេះ៖ %@"}}
      }
    },
    "cloud.codexDevice.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Open sign-in"}},
        "de": {"stringUnit": {"state": "translated", "value": "Anmeldung öffnen"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ouvrir la connexion"}},
        "ar": {"stringUnit": {"state": "translated", "value": "فتح تسجيل الدخول"}},
        "es": {"stringUnit": {"state": "translated", "value": "Abrir inicio de sesión"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟登入頁面"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开登录页面"}},
        "ko": {"stringUnit": {"state": "translated", "value": "로그인 열기"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ログイン画面を開く"}},
        "it": {"stringUnit": {"state": "translated", "value": "Apri accesso"}},
        "da": {"stringUnit": {"state": "translated", "value": "Åbn login"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Åpne innlogging"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Otwórz logowanie"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abrir login"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Открыть страницу входа"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Відкрити сторінку входу"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Otvori prijavu"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Mở trang đăng nhập"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Oturum açma sayfasını aç"}},
        "th": {"stringUnit": {"state": "translated", "value": "เปิดหน้าลงชื่อเข้าใช้"}},
        "km": {"stringUnit": {"state": "translated", "value": "បើកទំព័រចូល"}}
      }
    },
    "cloud.codexDevice.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Only short-lived access moves to the VM; the refresh token stays on this Mac. Keep cmux running on this Mac to renew Codex access."}},
        "de": {"stringUnit": {"state": "translated", "value": "Nur der kurzlebige Zugang wird auf die VM übertragen; das Aktualisierungstoken bleibt auf diesem Mac. Lass cmux auf diesem Mac laufen, um den Codex-Zugang zu erneuern."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Seul un accès de courte durée est transféré à la machine virtuelle ; le jeton de renouvellement reste sur ce Mac. Laissez cmux en cours d’exécution sur ce Mac pour renouveler l’accès à Codex."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يُنقل إلى الآلة الافتراضية إذن وصول قصير الأجل فقط؛ ويبقى رمز التجديد على جهاز Mac هذا. أبقِ cmux قيد التشغيل على جهاز Mac هذا لتجديد الوصول إلى Codex."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solo se transfiere a la máquina virtual el acceso de corta duración; el token de renovación permanece en este Mac. Mantén cmux en ejecución en este Mac para renovar el acceso a Codex."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "只有短期存取權限會傳送至虛擬機器；更新權杖會留在這部 Mac 上。請保持 cmux 在這部 Mac 上執行，以更新 Codex 存取權限。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "只有短期访问权限会传送至虚拟机；刷新令牌会保留在这台 Mac 上。请保持 cmux 在这台 Mac 上运行，以续期 Codex 访问权限。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "단기 액세스 권한만 VM으로 전송되며 갱신 토큰은 이 Mac에 남습니다. Codex 액세스 권한을 갱신하려면 이 Mac에서 cmux를 계속 실행해 두세요."}},
        "ja": {"stringUnit": {"state": "translated", "value": "VMには短期間のアクセス権限のみが転送され、更新トークンはこのMacに残ります。Codexのアクセス権限を更新するには、このMacでcmuxを実行したままにしてください。"}},
        "it": {"stringUnit": {"state": "translated", "value": "Solo l’accesso di breve durata viene trasferito alla macchina virtuale; il token di rinnovo rimane su questo Mac. Mantieni cmux in esecuzione su questo Mac per rinnovare l’accesso a Codex."}},
        "da": {"stringUnit": {"state": "translated", "value": "Kun kortvarig adgang overføres til den virtuelle maskine; fornyelsestokenet bliver på denne Mac. Hold cmux kørende på denne Mac for at forny adgangen til Codex."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Bare kortvarig tilgang overføres til den virtuelle maskinen; fornyelsestokenet blir på denne Macen. La cmux kjøre på denne Macen for å fornye tilgangen til Codex."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Do maszyny wirtualnej przenoszony jest tylko krótkotrwały dostęp; token odświeżania pozostaje na tym Macu. Pozostaw cmux uruchomiony na tym Macu, aby odnawiać dostęp do Codex."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Somente o acesso de curta duração é transferido para a máquina virtual; o token de renovação permanece neste Mac. Mantenha o cmux em execução neste Mac para renovar o acesso ao Codex."}},
        "ru": {"stringUnit": {"state": "translated", "value": "На виртуальную машину передаётся только краткосрочный доступ; токен обновления остаётся на этом Mac. Не закрывайте cmux на этом Mac, чтобы продлевать доступ к Codex."}},
        "uk": {"stringUnit": {"state": "translated", "value": "На віртуальну машину передається лише короткочасний доступ; токен оновлення залишається на цьому Mac. Не закривайте cmux на цьому Mac, щоб поновлювати доступ до Codex."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Samo kratkotrajni pristup prenosi se na virtuelnu mašinu; token za obnavljanje ostaje na ovom Macu. Ostavite cmux pokrenut na ovom Macu da bi se pristup Codexu obnavljao."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chỉ quyền truy cập ngắn hạn được chuyển sang máy ảo; mã thông báo làm mới vẫn ở trên máy Mac này. Hãy giữ cmux chạy trên máy Mac này để gia hạn quyền truy cập Codex."}},
        "tr": {"stringUnit": {"state": "translated", "value": "VM’ye yalnızca kısa süreli erişim aktarılır; yenileme belirteci bu Mac’te kalır. Codex erişimini yenilemek için bu Mac’te cmux’u çalışır durumda tutun."}},
        "th": {"stringUnit": {"state": "translated", "value": "เฉพาะสิทธิ์เข้าถึงระยะสั้นเท่านั้นที่จะโอนไปยัง VM ส่วนโทเค็นรีเฟรชจะอยู่บน Mac เครื่องนี้ เปิด cmux บน Mac เครื่องนี้ไว้เพื่อต่ออายุสิทธิ์เข้าถึง Codex"}},
        "km": {"stringUnit": {"state": "translated", "value": "មានតែសិទ្ធិចូលប្រើរយៈពេលខ្លីប៉ុណ្ណោះដែលត្រូវបានផ្ទេរទៅ VM។ ថូខឹនបន្តសុពលភាពនៅតែស្ថិតលើ Mac នេះ។ ទុកឱ្យ cmux ដំណើរការនៅលើ Mac នេះ ដើម្បីបន្តសិទ្ធិចូលប្រើ Codex។"}}
      }
    },
