    "cloud.codexDevice.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Codex sign-in on this Mac. Enter this one-time code: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf diesem Mac bei Codex an. Gib diesen Einmalcode ein: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Codex sur ce Mac. Saisissez ce code à usage unique : %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى Codex على جهاز Mac هذا. أدخل هذا الرمز المخصص للاستخدام مرة واحدة: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Codex en este Mac. Introduce este código de un solo uso: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這部 Mac 上登入 Codex。輸入此一次性驗證碼：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上登录 Codex。输入此一次性验证码：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Codex에 로그인하세요. 다음 일회용 코드를 입력하세요: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでCodexにログインしてください。次のワンタイムコードを入力してください：%@"
          }
        }
      }
    },
