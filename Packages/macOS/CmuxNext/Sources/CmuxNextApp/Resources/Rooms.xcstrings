    "rooms.deleteMovesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its workspaces and groups move to “%@”."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تنتقل مساحات العمل والمجموعات إلى “%@”."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njeni radni prostori i grupe premještaju se u „%@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dets arbejdsområder og grupper flyttes til “%@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Arbeitsbereiche und Gruppen werden nach „%@“ verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sus espacios de trabajo y grupos pasan a «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses espaces de travail et groupes passent dans « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le sue aree di lavoro e i gruppi passano in “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークスペースとグループは“%@”へ移動します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កន្លែងធ្វើការ និងក្រុមរបស់វាផ្លាស់ទៅ “%@”។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "작업 공간과 그룹이 “%@”(으)로 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arbeidsområdene og gruppene flyttes til «%@»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jego przestrzenie i grupy zostaną przeniesione do „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suas áreas de trabalho e grupos vão para “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Его пространства и группы переместятся в «%@»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เวิร์กสเปซและกลุ่มจะย้ายไปที่ “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çalışma alanları ve grupları “%@” odasına taşınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Її робочі області й групи переміщуються до «%@»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không gian làm việc và nhóm sẽ chuyển tới “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其工作区和组将移到“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其工作區和群組將移至「%@」。"
          }
        }
      }
    },
    "rooms.deleteReturnsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its workspaces stay open and return to the rooms that follow their machines."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تبقى مساحات العمل مفتوحة وتعود إلى الغرف التي تتابع أجهزتها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njeni radni prostori ostaju otvoreni i vraćaju se u sobe koje prate njihove mašine."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dets arbejdsområder forbliver åbne og vender tilbage til de rum, der følger deres maskiner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Arbeitsbereiche bleiben geöffnet und kehren in die Räume zurück, die ihren Rechnern folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sus espacios de trabajo siguen abiertos y vuelven a las salas que siguen a sus máquinas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses espaces de travail restent ouverts et reviennent dans les salles qui suivent leurs machines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le sue aree di lavoro restano aperte e tornano nelle stanze che seguono le loro macchine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ワークスペースは開いたまま、そのマシンをフォローしているルームに戻ります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "កន្លែងធ្វើការរបស់វានៅបើក ហើយត្រឡប់ទៅបន្ទប់ដែលតាមដានម៉ាស៊ីនរបស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "작업 공간은 열린 채로 해당 머신을 팔로우하는 룸으로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arbeidsområdene forblir åpne og går tilbake til rommene som følger maskinene deres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jego przestrzenie pozostają otwarte i wracają do pokojów, które śledzą ich maszyny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suas áreas de trabalho continuam abertas e voltam às salas que seguem suas máquinas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Его пространства остаются открытыми и возвращаются в комнаты, которые следят за их машинами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เวิร์กสเปซยังเปิดอยู่และกลับไปยังห้องที่ติดตามเครื่องของเวิร์กสเปซนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çalışma alanları açık kalır ve makinelerini izleyen odalara döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Її робочі області лишаються відкритими й повертаються до кімнат, що стежать за їхніми машинами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các không gian làm việc vẫn mở và quay về những phòng theo dõi máy của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其工作区保持打开，并回到关注其机器的房间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其工作區保持開啟，並回到追蹤其機器的房間。"
          }
        }
      }
    },
