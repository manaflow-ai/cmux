    "rooms.clearDefaultsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New terminals in this space stop starting in its directory and stop getting its environment variables."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تبدأ الطرفيات الجديدة في هذه المساحة في مجلدها ولن تحصل على متغيرات بيئتها."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi terminali u ovom prostoru više ne počinju u njegovom direktoriju niti dobijaju njegove varijable okruženja."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye terminaler i dette område starter ikke længere i dets mappe og får ikke længere dets miljøvariabler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Terminals in diesem Space starten nicht mehr in seinem Verzeichnis und erhalten seine Umgebungsvariablen nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los terminales nuevos de este espacio dejan de abrirse en su directorio y de recibir sus variables de entorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux terminaux de cet espace ne démarrent plus dans son dossier et ne reçoivent plus ses variables d’environnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi terminali di questo spazio non partono più nella sua directory e non ricevono più le sue variabili d’ambiente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスペースの新しいターミナルは、そのディレクトリで開始されず、その環境変数も受け取らなくなります。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ស្ថានីយថ្មីក្នុងលំហនេះនឹងលែងចាប់ផ្ដើមក្នុងថតរបស់វា ហើយលែងទទួលអថេរបរិស្ថានរបស់វា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스페이스의 새 터미널은 더 이상 해당 디렉터리에서 시작하지 않고 환경 변수도 받지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye terminaler i dette området starter ikke lenger i mappen og får ikke lenger miljøvariablene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe terminale w tym obszarze przestaną uruchamiać się w jego katalogu i otrzymywać jego zmienne środowiskowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos terminais neste espaço deixam de iniciar no diretório dele e de receber as variáveis de ambiente dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые терминалы в этой области перестанут запускаться в её каталоге и получать её переменные окружения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทอร์มินัลใหม่ในพื้นที่นี้จะไม่เริ่มในไดเรกทอรีของพื้นที่และไม่ได้รับตัวแปรสภาพแวดล้อมของพื้นที่อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu alandaki yeni terminaller artık onun dizininde başlamaz ve ortam değişkenlerini almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові термінали в цьому просторі більше не запускатимуться в його каталозі й не отримуватимуть його змінні середовища."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal mới trong không gian này sẽ không còn bắt đầu trong thư mục của nó và không nhận biến môi trường của nó nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此空间中的新终端将不再从其目录启动，也不再获得其环境变量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此空間中的新終端機將不再從其目錄啟動，也不再取得其環境變數。"
          }
        }
      }
    },
