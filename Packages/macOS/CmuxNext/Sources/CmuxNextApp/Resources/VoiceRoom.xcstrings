{
  "sourceLanguage": "en",
  "strings": {
    "voiceRoom.refusal.address": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عنوان غرفة الصوت في الإعدادات ليس عنوان ويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adresa glasovne sobe u Postavkama nije web adresa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemmerummets adresse i Indstillinger er ikke en webadresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Sprachraum-Adresse in den Einstellungen ist keine Webadresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Voice Room address in Settings is not a web address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dirección de la sala de voz en Ajustes no es una dirección web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’adresse de la salle vocale dans les Réglages n’est pas une adresse web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’indirizzo della stanza vocale nelle Impostazioni non è un indirizzo web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定のボイスルームのアドレスが Web アドレスではありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អាសយដ្ឋានបន្ទប់សំឡេងក្នុងការកំណត់ មិនមែនជាអាសយដ្ឋានវេបទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정의 음성 룸 주소가 웹 주소가 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taleromadressen i Innstillinger er ikke en nettadresse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adres pokoju głosowego w Ustawieniach nie jest adresem internetowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O endereço da sala de voz nos Ajustes não é um endereço da web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Адрес голосовой комнаты в настройках не является веб-адресом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ที่อยู่ห้องเสียงในการตั้งค่าไม่ใช่ที่อยู่เว็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ayarlardaki Ses Odası adresi bir web adresi değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Адреса голосової кімнати в параметрах не є веб-адресою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Địa chỉ phòng thoại trong Cài đặt không phải là địa chỉ web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设置中的语音房间地址不是网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定中的語音房間位址不是網址。"
          }
        }
      }
    },
    "voiceRoom.refusal.notOpen": {
      "extractionState": "manual",
      "localizations": {
