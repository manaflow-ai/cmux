        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phòng thoại là tính năng Labs: hãy bật trong Cài đặt > Nâng cao > Labs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "语音房间是 Labs 功能：请在“设置 > 高级 > Labs”中开启。"
