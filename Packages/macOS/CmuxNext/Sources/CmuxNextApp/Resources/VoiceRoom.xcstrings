    "voiceRoom.refusal.off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "غرفة الصوت ميزة تجريبية: فعّلها من الإعدادات > متقدم > المختبرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasovna soba je eksperimentalna funkcija: uključite je u Postavke > Napredno > Labs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemmerum er en Labs-funktion: slå det til under Indstillinger > Avanceret > Labs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Sprachraum ist eine Labs-Funktion: Aktiviere ihn unter Einstellungen > Erweitert > Labs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice Room is a Labs feature: turn it on in Settings > Advanced > Labs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sala de voz es una función de Labs: actívala en Ajustes > Avanzado > Labs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La salle vocale est une fonctionnalité Labs : activez-la dans Réglages > Avancé > Labs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La stanza vocale è una funzione Labs: attivala in Impostazioni > Avanzate > Labs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ボイスルームは Labs の機能です。設定 > 詳細 > Labs でオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ទប់សំឡេងជាមុខងារ Labs៖ បើកវានៅក្នុង ការកំណត់ > កម្រិតខ្ពស់ > Labs។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 룸은 Labs 기능입니다. 설정 > 고급 > Labs에서 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Talerom er en Labs-funksjon: slå det på under Innstillinger > Avansert > Labs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokój głosowy to funkcja Labs: włącz go w Ustawienia > Zaawansowane > Labs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sala de voz é um recurso do Labs: ative-a em Ajustes > Avançado > Labs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Голосовая комната — функция Labs: включите её в Настройки > Дополнительно > Labs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ห้องเสียงเป็นฟีเจอร์ Labs: เปิดได้ที่ การตั้งค่า > ขั้นสูง > Labs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses Odası bir Labs özelliğidir: Ayarlar > Gelişmiş > Labs bölümünden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Голосова кімната — функція Labs: увімкніть її в Параметри > Додатково > Labs."
