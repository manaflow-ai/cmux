  "strings": {
    "voiceRoom.refusal.address": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عنوان غرفة الصوت في الإعدادات ليس عنوان ويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adresa glasovne sobe u Postavkama nije web adresa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemmerummets adresse i Indstillinger er ikke en webadresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Sprachraum-Adresse in den Einstellungen ist keine Webadresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Voice Room address in Settings is not a web address."
