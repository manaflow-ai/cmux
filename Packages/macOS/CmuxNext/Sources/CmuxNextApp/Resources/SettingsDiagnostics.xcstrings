{
  "sourceLanguage": "en",
  "strings": {
    "settings.diagnostic.key": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json: تم تجاهل %1$@: %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json: %1$@ wurde ignoriert: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json: %1$@ was ignored: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json: se ignoró %1$@: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json : %1$@ a été ignoré : %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json: %1$@ は無視されました: %2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json: %1$@이(가) 무시되었습니다: %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json：已忽略 %1$@：%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json：已忽略 %1$@：%2$@。"
          }
        }
      }
    },
    "settings.diagnostic.more": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الإعدادات القيم الأخرى التي تم تجاهلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen zeigen die übrigen ignorierten Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings lists the other ignored values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes muestra los demás valores ignorados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Réglages indiquent les autres valeurs ignorées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視されたほかの値は設定に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 무시된 다른 값을 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”会列出其他被忽略的值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」會列出其他被忽略的值。"
          }
        }
      }
    },
