    "settings.diagnostic.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة cmux-next.json (%@). تظل آخر الإعدادات التي تم تحميلها سارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json konnte nicht gelesen werden (%@). Die zuletzt geladenen Einstellungen bleiben aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json could not be read (%@). The last settings that loaded stay in effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer cmux-next.json (%@). Siguen vigentes los últimos ajustes cargados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cmux-next.json (%@). Les derniers réglages chargés restent en vigueur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json を読み込めませんでした（%@）。最後に読み込んだ設定がそのまま有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next.json을 읽을 수 없습니다(%@). 마지막으로 불러온 설정이 계속 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 cmux-next.json（%@）。最后加载的设置仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 cmux-next.json（%@）。最後載入的設定仍然有效。"
          }
        }
      }
    },
