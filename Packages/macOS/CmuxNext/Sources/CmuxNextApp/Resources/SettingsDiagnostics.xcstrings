    "settings.diagnostic.more": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الإعدادات القيم الأخرى التي تم تجاهلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavke prikazuju ostale zanemarene vrijednosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indstillinger viser de andre ignorerede værdier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen zeigen die übrigen ignorierten Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings lists the other ignored values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes muestra los demás valores ignorados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Réglages indiquent les autres valeurs ignorées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le Impostazioni elencano gli altri valori ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視されたほかの値は設定に表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការកំណត់បង្ហាញតម្លៃផ្សេងទៀតដែលត្រូវបានមិនអើពើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 무시된 다른 값을 확인할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Innstillinger viser de andre ignorerte verdiene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustawienia pokazują pozostałe zignorowane wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os Ajustes mostram os outros valores ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Остальные проигнорированные значения показаны в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การตั้งค่าแสดงค่าอื่นๆ ที่ถูกละเว้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer yok sayılan değerler Ayarlar'da listelenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Інші проігноровані значення показано в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cài đặt liệt kê các giá trị bị bỏ qua khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”会列出其他被忽略的值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」會列出其他被忽略的值。"
          }
