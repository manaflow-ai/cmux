{
  "sourceLanguage": "en",
  "strings": {
    "runs.error.agentInvalid": {
      "comment": "cmux run --sandboxed refusal: unknown agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown agent. Use claude, codex, opencode or pi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannter Agent. Verwende claude, codex, opencode oder pi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent inconnu. Utilisez claude, codex, opencode ou pi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكيل غير معروف. استخدم claude أو codex أو opencode أو pi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente desconocido. Usa claude, codex, opencode o pi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的代理。請使用 claude、codex、opencode 或 pi。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的代理。请使用 claude、codex、opencode 或 pi。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 에이전트입니다. claude, codex, opencode, pi 중 하나를 쓰세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なエージェントです。claude、codex、opencode、pi のいずれかを使ってください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepoznat agent. Koristite claude, codex, opencode ili pi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukendt agent. Brug claude, codex, opencode eller pi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agente sconosciuto. Usa claude, codex, opencode o pi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារមិនស្គាល់។ ប្រើ claude, codex, opencode ឬ pi។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukjent agent. Bruk claude, codex, opencode eller pi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nieznany agent. Użyj claude, codex, opencode lub pi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agente desconhecido. Use claude, codex, opencode ou pi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Неизвестный агент. Используйте claude, codex, opencode или pi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่รู้จักเอเจนต์ ใช้ claude, codex, opencode หรือ pi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilinmeyen ajan. claude, codex, opencode veya pi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невідомий агент. Використовуйте claude, codex, opencode або pi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác tử không xác định. Dùng claude, codex, opencode hoặc pi."
          }
        }
      }
    },
    "runs.error.badResponse": {
      "comment": "A sandboxed run call got a reply from cmux.com that the app could not parse.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com sent an answer the app couldn't read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com hat eine Antwort gesendet, die die App nicht lesen konnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com a envoyé une réponse que l'app n'a pas pu lire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل cmux.com ردًا تعذّر على التطبيق قراءته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com envió una respuesta que la app no pudo leer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com 傳回了 App 無法讀取的回應。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com 返回了 App 无法读取的响应。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com이 앱에서 읽을 수 없는 응답을 보냈습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com からアプリが読み取れない応答が返されました。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com je poslao odgovor koji aplikacija nije mogla pročitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com sendte et svar, som appen ikke kunne læse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com ha inviato una risposta che l'app non è riuscita a leggere."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com បានផ្ញើចម្លើយដែលកម្មវិធីមិនអាចអានបាន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com sendte et svar appen ikke kunne lese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com wysłał odpowiedź, której aplikacja nie mogła odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux.com enviou uma resposta que o app não conseguiu ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com прислал ответ, который приложение не смогло прочитать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com ส่งคำตอบที่แอปอ่านไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com, uygulamanın okuyamadığı bir yanıt gönderdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com надіслав відповідь, яку застосунок не зміг прочитати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com đã gửi một phản hồi mà ứng dụng không đọc được."
          }
        }
      }
    },
    "runs.error.cloudUnavailable": {
      "comment": "cmux run --sandboxed and cmux vm token refusal: Cloud may not be called here (a managed team missing, or a local-only backend).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud غير متاح لهذا الحساب أو الفريق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud nije dostupan za ovaj račun ili tim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud er ikke tilgængelig for denne konto eller dette team."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ist für dieses Konto oder Team nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud is not available for this account or team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud no está disponible para esta cuenta o equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud n’est pas disponible pour ce compte ou cette équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud non è disponibile per questo account o team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントまたはチームでは cmux Cloud を利用できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud មិនអាចប្រើបានសម្រាប់គណនី ឬក្រុមនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정 또는 팀에서는 cmux Cloud를 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud er ikke tilgjengelig for denne kontoen eller dette teamet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud nie jest dostępny dla tego konta lub zespołu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux Cloud não está disponível para esta conta ou equipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud недоступен для этой учётной записи или команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ไม่พร้อมใช้งานสำหรับบัญชีหรือทีมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud bu hesap veya ekip için kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud недоступний для цього облікового запису або команди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud không khả dụng cho tài khoản hoặc nhóm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户或团队无法使用 cmux Cloud。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號或團隊無法使用 cmux Cloud。"
          }
        }
      }
    },
    "runs.error.idRequired": {
      "comment": "runs.wait or runs.cancel refusal when no Run id was given.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the run with `id`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Lauf mit `id` an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l’exécution avec `id`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد التشغيل باستخدام `id`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la ejecución con `id`."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 `id` 指定執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 `id` 指定运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`id`로 실행을 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`id` で実行を指定してください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Navedite izvršavanje pomoću `id`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angiv kørslen med `id`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indica l’esecuzione con `id`."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដាក់ឈ្មោះការដំណើរការដោយ `id`។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angi kjøringen med `id`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wskaż uruchomienie za pomocą `id`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indique a execução com `id`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Укажите запуск через `id`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ระบุการรันด้วย `id`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalıştırmayı `id` ile belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкажіть запуск через `id`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ định lần chạy bằng `id`."
          }
        }
      }
    },
    "runs.error.imageInvalid": {
      "comment": "cmux run --sandboxed refusal: the image is not a Cloud VM manifest image.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That image isn't a cmux Cloud VM image. Leave out --image to use the base image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Image ist kein cmux-Cloud-VM-Image. Lass --image weg, um das Basis-Image zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image n’est pas une image de VM cmux Cloud. Omettez --image pour utiliser l’image de base."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة ليست صورة آلة cmux Cloud. احذف ‎--image لاستخدام الصورة الأساسية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa imagen no es una imagen de VM de cmux Cloud. Omite --image para usar la imagen base."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該映像不是 cmux Cloud VM 映像。省略 --image 以使用基礎映像。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该镜像不是 cmux Cloud VM 镜像。省略 --image 以使用基础镜像。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지는 cmux Cloud VM 이미지가 아닙니다. 기본 이미지를 쓰려면 --image를 빼세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのイメージは cmux Cloud VM のイメージではありません。--image を省くとベースイメージを使います。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta slika nije slika cmux Cloud VM-a. Izostavite --image da koristite osnovnu sliku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det image er ikke et cmux Cloud VM-image. Udelad --image for at bruge basisimaget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quell’immagine non è un’immagine di VM cmux Cloud. Ometti --image per usare l’immagine di base."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបភាពនោះមិនមែនជារូបភាព cmux Cloud VM ទេ។ ដក --image ចេញ ដើម្បីប្រើរូបភាពមូលដ្ឋាន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det imaget er ikke et cmux Cloud VM-image. Utelat --image for å bruke basisimaget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten obraz nie jest obrazem maszyny wirtualnej cmux Cloud. Pomiń --image, aby użyć obrazu bazowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essa imagem não é uma imagem de VM do cmux Cloud. Omita --image para usar a imagem base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот образ не является образом ВМ cmux Cloud. Не указывайте --image, чтобы использовать базовый образ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อิมเมจนั้นไม่ใช่อิมเมจ VM ของ cmux Cloud ละ --image ไว้เพื่อใช้อิมเมจพื้นฐาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu imaj bir cmux Cloud VM imajı değil. Temel imajı kullanmak için --image vermeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей образ не є образом ВМ cmux Cloud. Не вказуйте --image, щоб використати базовий образ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ảnh đó không phải ảnh VM của cmux Cloud. Bỏ --image để dùng ảnh cơ sở."
          }
        }
      }
    },
    "runs.error.notSignedIn": {
      "comment": "cmux run --sandboxed refusal when the app is not signed in to cmux.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux in the cmux app first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zuerst in der cmux-App bei cmux an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d’abord à cmux dans l’app cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى cmux في تطبيق cmux أولًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero inicia sesión en cmux desde la app cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 cmux App 中登入 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 cmux 应用中登录 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 cmux 앱에서 cmux에 로그인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に cmux アプリで cmux にサインインしてください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo se prijavite u cmux u aplikaciji cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log først ind på cmux i cmux-appen."
