{
  "sourceLanguage": "en",
  "strings": {
    "runs.error.agentInvalid": {
      "comment": "cmux run --sandboxed refusal: unknown agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown agent. Use claude, codex, opencode or pi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannter Agent. Verwende claude, codex, opencode oder pi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent inconnu. Utilisez claude, codex, opencode ou pi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكيل غير معروف. استخدم claude أو codex أو opencode أو pi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente desconocido. Usa claude, codex, opencode o pi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的代理。請使用 claude、codex、opencode 或 pi。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的代理。请使用 claude、codex、opencode 或 pi。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 에이전트입니다. claude, codex, opencode, pi 중 하나를 쓰세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なエージェントです。claude、codex、opencode、pi のいずれかを使ってください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepoznat agent. Koristite claude, codex, opencode ili pi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukendt agent. Brug claude, codex, opencode eller pi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agente sconosciuto. Usa claude, codex, opencode o pi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារមិនស្គាល់។ ប្រើ claude, codex, opencode ឬ pi។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukjent agent. Bruk claude, codex, opencode eller pi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nieznany agent. Użyj claude, codex, opencode lub pi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agente desconhecido. Use claude, codex, opencode ou pi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Неизвестный агент. Используйте claude, codex, opencode или pi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่รู้จักเอเจนต์ ใช้ claude, codex, opencode หรือ pi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilinmeyen ajan. claude, codex, opencode veya pi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Невідомий агент. Використовуйте claude, codex, opencode або pi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tác tử không xác định. Dùng claude, codex, opencode hoặc pi."
          }
        }
      }
    },
    "runs.error.badResponse": {
      "comment": "A sandboxed run call got a reply from cmux.com that the app could not parse.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com sent an answer the app couldn't read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com hat eine Antwort gesendet, die die App nicht lesen konnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com a envoyé une réponse que l'app n'a pas pu lire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل cmux.com ردًا تعذّر على التطبيق قراءته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com envió una respuesta que la app no pudo leer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com 傳回了 App 無法讀取的回應。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com 返回了 App 无法读取的响应。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com이 앱에서 읽을 수 없는 응답을 보냈습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.com からアプリが読み取れない応答が返されました。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com je poslao odgovor koji aplikacija nije mogla pročitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com sendte et svar, som appen ikke kunne læse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com ha inviato una risposta che l'app non è riuscita a leggere."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com បានផ្ញើចម្លើយដែលកម្មវិធីមិនអាចអានបាន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com sendte et svar appen ikke kunne lese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com wysłał odpowiedź, której aplikacja nie mogła odczytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux.com enviou uma resposta que o app não conseguiu ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com прислал ответ, который приложение не смогло прочитать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com ส่งคำตอบที่แอปอ่านไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com, uygulamanın okuyamadığı bir yanıt gönderdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com надіслав відповідь, яку застосунок не зміг прочитати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.com đã gửi một phản hồi mà ứng dụng không đọc được."
          }
        }
      }
    },
    "runs.error.idRequired": {
      "comment": "runs.wait or runs.cancel refusal when no Run id was given.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the run with `id`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Lauf mit `id` an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l’exécution avec `id`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد التشغيل باستخدام `id`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la ejecución con `id`."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 `id` 指定執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 `id` 指定运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`id`로 실행을 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`id` で実行を指定してください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Navedite izvršavanje pomoću `id`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angiv kørslen med `id`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indica l’esecuzione con `id`."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដាក់ឈ្មោះការដំណើរការដោយ `id`។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angi kjøringen med `id`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wskaż uruchomienie za pomocą `id`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Indique a execução com `id`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Укажите запуск через `id`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ระบุการรันด้วย `id`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalıştırmayı `id` ile belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкажіть запуск через `id`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ định lần chạy bằng `id`."
          }
        }
      }
    },
    "runs.error.imageInvalid": {
      "comment": "cmux run --sandboxed refusal: the image is not a Cloud VM manifest image.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That image isn't a cmux Cloud VM image. Leave out --image to use the base image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Image ist kein cmux-Cloud-VM-Image. Lass --image weg, um das Basis-Image zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image n’est pas une image de VM cmux Cloud. Omettez --image pour utiliser l’image de base."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة ليست صورة آلة cmux Cloud. احذف ‎--image لاستخدام الصورة الأساسية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa imagen no es una imagen de VM de cmux Cloud. Omite --image para usar la imagen base."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該映像不是 cmux Cloud VM 映像。省略 --image 以使用基礎映像。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该镜像不是 cmux Cloud VM 镜像。省略 --image 以使用基础镜像。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지는 cmux Cloud VM 이미지가 아닙니다. 기본 이미지를 쓰려면 --image를 빼세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのイメージは cmux Cloud VM のイメージではありません。--image を省くとベースイメージを使います。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta slika nije slika cmux Cloud VM-a. Izostavite --image da koristite osnovnu sliku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det image er ikke et cmux Cloud VM-image. Udelad --image for at bruge basisimaget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quell’immagine non è un’immagine di VM cmux Cloud. Ometti --image per usare l’immagine di base."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបភាពនោះមិនមែនជារូបភាព cmux Cloud VM ទេ។ ដក --image ចេញ ដើម្បីប្រើរូបភាពមូលដ្ឋាន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det imaget er ikke et cmux Cloud VM-image. Utelat --image for å bruke basisimaget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten obraz nie jest obrazem maszyny wirtualnej cmux Cloud. Pomiń --image, aby użyć obrazu bazowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essa imagem não é uma imagem de VM do cmux Cloud. Omita --image para usar a imagem base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот образ не является образом ВМ cmux Cloud. Не указывайте --image, чтобы использовать базовый образ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อิมเมจนั้นไม่ใช่อิมเมจ VM ของ cmux Cloud ละ --image ไว้เพื่อใช้อิมเมจพื้นฐาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu imaj bir cmux Cloud VM imajı değil. Temel imajı kullanmak için --image vermeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей образ не є образом ВМ cmux Cloud. Не вказуйте --image, щоб використати базовий образ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ảnh đó không phải ảnh VM của cmux Cloud. Bỏ --image để dùng ảnh cơ sở."
          }
        }
      }
    },
    "runs.error.labsOff": {
      "comment": "cmux run --sandboxed refusal while the Labs preview flag is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandboxed runs are a preview. Turn on Settings > Advanced > Labs > Show Preview Features."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox-Läufe sind eine Vorschau. Aktiviere Einstellungen > Erweitert > Labs > Vorschaufunktionen anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exécutions isolées sont en aperçu. Activez Réglages > Avancé > Labs > Afficher les fonctions en aperçu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيلات المعزولة ميزة تجريبية. فعّل الإعدادات > متقدم > المختبرات > إظهار الميزات التجريبية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ejecuciones aisladas son una vista previa. Activa Ajustes > Avanzado > Labs > Mostrar funciones en vista previa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱執行仍為預覽功能。請開啟「設定 > 進階 > Labs > 顯示預覽功能」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱运行仍是预览功能。请打开“设置 > 高级 > Labs > 显示预览功能”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샌드박스 실행은 미리보기 기능입니다. 설정 > 고급 > Labs > 미리보기 기능 표시를 켜세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックス実行はプレビュー機能です。設定 > 詳細 > Labs > プレビュー機能を表示 をオンにしてください。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izolirana izvršavanja su pregled. Uključite Postavke > Napredno > Labs > Prikaži funkcije u pregledu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sandkassekørsler er en forhåndsvisning. Slå Indstillinger > Avanceret > Labs > Vis forhåndsvisningsfunktioner til."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le esecuzioni isolate sono un’anteprima. Attiva Impostazioni > Avanzate > Labs > Mostra funzioni in anteprima."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការដំណើរការក្នុង sandbox ជាការមើលជាមុន។ បើក ការកំណត់ > កម្រិតខ្ពស់ > Labs > បង្ហាញមុខងារមើលជាមុន។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sandkassekjøringer er en forhåndsvisning. Slå på Innstillinger > Avansert > Labs > Vis forhåndsvisningsfunksjoner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchomienia w piaskownicy to wersja zapoznawcza. Włącz Ustawienia > Zaawansowane > Labs > Pokaż funkcje w wersji zapoznawczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Execuções isoladas são uma prévia. Ative Ajustes > Avançado > Labs > Mostrar recursos em prévia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запуски в песочнице — предварительная функция. Включите «Настройки > Дополнительно > Labs > Показывать предварительные функции»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การรันในแซนด์บ็อกซ์เป็นฟีเจอร์ตัวอย่าง เปิด การตั้งค่า > ขั้นสูง > Labs > แสดงฟีเจอร์ตัวอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Korumalı çalıştırmalar önizlemedir. Ayarlar > Gelişmiş > Labs > Önizleme Özelliklerini Göster'i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запуски в пісочниці — попередня функція. Увімкніть «Налаштування > Додатково > Labs > Показувати попередні функції»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy trong hộp cát là tính năng xem trước. Bật Cài đặt > Nâng cao > Labs > Hiện tính năng xem trước."
          }
        }
      }
    },
    "runs.error.notSignedIn": {
      "comment": "cmux run --sandboxed refusal when the app is not signed in to cmux.",
