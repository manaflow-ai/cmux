    "runs.error.taskInvalid": {
      "comment": "cmux run --sandboxed refusal: the task is empty or too long.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sandboxed run needs a task of at most 16,000 characters."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sandbox-Lauf braucht eine Aufgabe mit höchstens 16.000 Zeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exécution isolée a besoin d’une tâche de 16 000 caractères au plus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج التشغيل المعزول إلى مهمة لا تتجاوز 16000 حرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ejecución aislada necesita una tarea de 16.000 caracteres como máximo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱執行需要一項不超過 16,000 個字元的任務。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱运行需要一个不超过 16,000 个字符的任务。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샌드박스 실행에는 16,000자 이하의 작업이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックス実行には 16,000 文字以内のタスクが必要です。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izolirano izvršavanje treba zadatak od najviše 16.000 znakova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sandkassekørsel kræver en opgave på højst 16.000 tegn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un’esecuzione isolata richiede un’attività di al massimo 16.000 caratteri."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការដំណើរការក្នុង sandbox ត្រូវការកិច្ចការដែលមានមិនលើស 16,000 តួអក្សរ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En sandkassekjøring trenger en oppgave på høyst 16 000 tegn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchomienie w piaskownicy wymaga zadania o długości najwyżej 16 000 znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma execução isolada precisa de uma tarefa com no máximo 16.000 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для запуска в песочнице нужна задача длиной не более 16 000 символов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การรันในแซนด์บ็อกซ์ต้องมีงานที่ยาวไม่เกิน 16,000 อักขระ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Korumalı bir çalıştırma en fazla 16.000 karakterlik bir görev gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для запуску в пісочниці потрібне завдання довжиною не більше 16 000 символів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần chạy trong hộp cát cần một tác vụ tối đa 16.000 ký tự."
          }
        }
      }
    },
