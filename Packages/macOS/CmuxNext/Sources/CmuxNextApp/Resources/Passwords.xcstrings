{
  "sourceLanguage": "en",
  "strings": {
    "passwords.csv.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر ملف CSV لكلمات السر صدّرته من متصفح أو مدير كلمات سر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite CSV datoteku lozinki izvezenu iz preglednika ili upravitelja lozinki."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en CSV-fil med adgangskoder, der er eksporteret fra en browser eller adgangskodeadministrator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle eine Passwort-CSV, die aus einem Browser oder Passwortmanager exportiert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a password CSV exported from a browser or password manager."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige un CSV de contraseñas exportado desde un navegador o un gestor de contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez un fichier CSV de mots de passe exporté depuis un navigateur ou un gestionnaire de mots de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli un file CSV di password esportato da un browser o da un gestore di password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザまたはパスワードマネージャから書き出したパスワード CSV を選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសឯកសារ CSV ពាក្យសម្ងាត់ដែលបាននាំចេញពីកម្មវិធីរុករក ឬកម្មវិធីគ្រប់គ្រងពាក្យសម្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저나 암호 관리자에서 내보낸 암호 CSV 파일을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en passord-CSV eksportert fra en nettleser eller passordbehandler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz plik CSV z hasłami wyeksportowany z przeglądarki lub menedżera haseł."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha um CSV de senhas exportado de um navegador ou gerenciador de senhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите CSV-файл с паролями, экспортированный из браузера или менеджера паролей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกไฟล์ CSV รหัสผ่านที่ส่งออกจากเบราว์เซอร์หรือโปรแกรมจัดการรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir tarayıcıdan veya parola yöneticisinden dışa aktarılmış bir parola CSV’si seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть CSV-файл із паролями, експортований із браузера або менеджера паролів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn tệp CSV mật khẩu được xuất từ trình duyệt hoặc trình quản lý mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择从浏览器或密码管理器导出的密码 CSV 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇從瀏覽器或密碼管理工具匯出的密碼 CSV 檔案。"
          }
        }
      }
    },
