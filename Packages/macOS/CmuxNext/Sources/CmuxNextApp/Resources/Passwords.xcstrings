    "passwords.csv.counts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم الاستيراد: %1$lld. لم يتم الاستيراد: %2$lld (محفوظة مسبقًا أو مكررة أو ليست تسجيل دخول لموقع ويب)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvezeno: %1$lld. Nije uvezeno: %2$lld (već sačuvano, ponovljeno ili nije prijava na web-stranicu)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importeret: %1$lld. Ikke importeret: %2$lld (allerede gemt, gentaget eller ikke et websted-login)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importiert: %1$lld. Nicht importiert: %2$lld (bereits gespeichert, doppelt oder keine Website-Anmeldung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported: %1$lld. Not imported: %2$lld (already saved, repeated, or not a website sign-in)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importadas: %1$lld. No importadas: %2$lld (ya guardadas, repetidas o que no son inicios de sesión de sitios web)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importés : %1$lld. Non importés : %2$lld (déjà enregistrés, en double ou pas une connexion à un site web)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importate: %1$lld. Non importate: %2$lld (già salvate, ripetute o non accessi a siti web)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読み込み済み: %1$lld。読み込まなかった項目: %2$lld（保存済み、重複、または Web サイトのサインインではない項目）。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បាននាំចូល៖ %1$lld។ មិនបាននាំចូល៖ %2$lld (បានរក្សាទុករួច ស្ទួន ឬមិនមែនជាការចូលគេហទំព័រ)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져옴: %1$lld. 가져오지 않음: %2$lld(이미 저장됨, 중복 또는 웹사이트 로그인이 아님)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importert: %1$lld. Ikke importert: %2$lld (allerede lagret, gjentatt eller ikke en nettstedpålogging)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaimportowano: %1$lld. Nie zaimportowano: %2$lld (już zapisane, powtórzone lub nie są logowaniami do witryn)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importadas: %1$lld. Não importadas: %2$lld (já salvas, repetidas ou que não são logins de sites)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импортировано: %1$lld. Не импортировано: %2$lld (уже сохранены, повторяются или не относятся к входу на сайт)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำเข้าแล้ว: %1$lld ไม่ได้นำเข้า: %2$lld (บันทึกไว้แล้ว ซ้ำกัน หรือไม่ใช่การลงชื่อเข้าเว็บไซต์)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İçe aktarılan: %1$lld. İçe aktarılmayan: %2$lld (zaten kayıtlı, tekrarlanan veya web sitesi girişi olmayan)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Імпортовано: %1$lld. Не імпортовано: %2$lld (уже збережені, повторюються або не є входом на вебсайт)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã nhập: %1$lld. Chưa nhập: %2$lld (đã lưu, bị lặp hoặc không phải thông tin đăng nhập trang web)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已导入：%1$lld。未导入：%2$lld（已存储、重复或不是网站登录信息）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已匯入：%1$lld。未匯入：%2$lld（已儲存、重複，或不是網站登入資料）。"
          }
        }
      }
    },
    "passwords.csv.plaintext": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يزال ملف CSV يحتوي على كلمات السر هذه كنص عادي. هل تريد نقله إلى سلة المهملات؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV datoteka i dalje sadrži ove lozinke kao običan tekst. Premjestiti je u Smeće?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV-filen indeholder stadig disse adgangskoder i klartekst. Vil du flytte den til papirkurven?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die CSV-Datei enthält diese Passwörter weiterhin im Klartext. In den Papierkorb legen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CSV file still holds these passwords in plain text. Move it to the Trash?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El archivo CSV todavía contiene estas contraseñas en texto sin cifrar. ¿Trasladarlo a la papelera?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le fichier CSV contient toujours ces mots de passe en clair. Le placer dans la corbeille ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il file CSV contiene ancora queste password in chiaro. Spostarlo nel Cestino?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV ファイルにはこれらのパスワードが平文のまま残っています。ゴミ箱に入れますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ឯកសារ CSV នៅតែផ្ទុកពាក្យសម្ងាត់ទាំងនេះជាអត្ថបទធម្មតា។ ផ្លាស់វាទៅធុងសំរាមឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV 파일에는 여전히 이 암호들이 일반 텍스트로 남아 있습니다. 휴지통으로 이동할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV-filen inneholder fortsatt disse passordene i klartekst. Vil du flytte den til papirkurven?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plik CSV nadal zawiera te hasła jako zwykły tekst. Przenieść go do kosza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O arquivo CSV ainda contém essas senhas em texto simples. Mover para o Lixo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV-файл по-прежнему хранит эти пароли открытым текстом. Переместить его в Корзину?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์ CSV ยังเก็บรหัสผ่านเหล่านี้เป็นข้อความธรรมดา ย้ายไปที่ถังขยะหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV dosyası bu parolaları hâlâ düz metin olarak içeriyor. Çöp Sepeti’ne taşınsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV-файл досі містить ці паролі звичайним текстом. Перемістити його в Смітник?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp CSV vẫn chứa các mật khẩu này ở dạng văn bản thuần. Chuyển tệp vào Thùng rác?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV 文件仍以明文保存这些密码。要将其移到废纸篓吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CSV 檔案仍以明文保存這些密碼。要將它丟到垃圾桶嗎？"
          }
        }
      }
    },
