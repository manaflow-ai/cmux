    "passwords.csv.guide.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux imports a CSV file that the app with your passwords exports. Where are your passwords now?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は、パスワードを保存しているアプリが書き出した CSV ファイルを読み込みます。パスワードは現在どこにありますか？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستورد cmux ملف CSV يصدّره التطبيق الذي يحفظ كلمات مرورك. أين كلمات مرورك الآن؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux uvozi CSV datoteku koju izveze aplikacija s vašim lozinkama. Gdje su vaše lozinke sada?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importerer en CSV-fil, som appen med dine adgangskoder eksporterer. Hvor er dine adgangskoder nu?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importiert eine CSV-Datei, die die App mit Ihren Passwörtern exportiert. Wo sind Ihre Passwörter jetzt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importa un archivo CSV que exporta la app que guarda tus contraseñas. ¿Dónde están tus contraseñas ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importe un fichier CSV exporté par l’app qui contient vos mots de passe. Où sont vos mots de passe actuellement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importa un file CSV esportato dall’app che contiene le tue password. Dove sono ora le tue password?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux នាំចូលឯកសារ CSV ដែលកម្មវិធីរក្សាពាក្យសម្ងាត់របស់អ្នកនាំចេញ។ តើពាក្យសម្ងាត់របស់អ្នកនៅឯណាឥឡូវនេះ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux는 암호를 보관하는 앱이 내보낸 CSV 파일을 가져옵니다. 지금 암호는 어디에 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importerer en CSV-fil som appen med passordene dine eksporterer. Hvor er passordene dine nå?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux importuje plik CSV wyeksportowany przez aplikację, w której są Twoje hasła. Gdzie są teraz Twoje hasła?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux importa um arquivo CSV exportado pelo app que guarda suas senhas. Onde estão suas senhas agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux импортирует CSV-файл, который экспортирует приложение с вашими паролями. Где сейчас ваши пароли?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux นำเข้าไฟล์ CSV ที่แอปซึ่งเก็บรหัสผ่านของคุณส่งออก ตอนนี้รหัสผ่านของคุณอยู่ที่ใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux, parolalarınızın bulunduğu uygulamanın dışa aktardığı bir CSV dosyasını içe aktarır. Parolalarınız şu anda nerede?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux імпортує CSV-файл, який експортує застосунок із вашими паролями. Де зараз ваші паролі?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nhập tệp CSV do ứng dụng chứa mật khẩu của bạn xuất ra. Mật khẩu của bạn hiện đang ở đâu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 会导入存放你密码的 App 所导出的 CSV 文件。你的密码现在在哪里？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 會匯入存放你密碼的 App 所匯出的 CSV 檔案。你的密碼目前在哪裡？"
          }
        }
      }
    },
