    "passwords.csv.guide.bitwarden.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. In Bitwarden, choose File > Export Vault (in the web vault: Tools > Export Vault)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Bitwarden で「ファイル」>「保管庫のエクスポート」を選択します（Web 保管庫では「ツール」>「保管庫のエクスポート」）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. في Bitwarden، اختر ملف > تصدير الخزنة (في خزنة الويب: أدوات > تصدير الخزنة)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. U Bitwardenu odaberite File > Export Vault (u web trezoru: Tools > Export Vault)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Vælg Arkiv > Eksportér boks i Bitwarden (i web-boksen: Værktøjer > Eksportér boks)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Wählen Sie in Bitwarden „Datei“ > „Tresor exportieren“ (im Web-Tresor: „Werkzeuge“ > „Tresor exportieren“)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. En Bitwarden, elige Archivo > Exportar caja fuerte (en la caja fuerte web: Herramientas > Exportar caja fuerte)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Dans Bitwarden, choisissez Fichier > Exporter le coffre (dans le coffre web : Outils > Exporter le coffre)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. In Bitwarden, scegli File > Esporta cassaforte (nella cassaforte web: Strumenti > Esporta cassaforte)."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. នៅក្នុង Bitwarden ជ្រើស File > Export Vault (ក្នុង web vault៖ Tools > Export Vault)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Bitwarden에서 파일 > 보관함 내보내기를 선택합니다(웹 보관함에서는 도구 > 보관함 내보내기)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. I Bitwarden velger du Arkiv > Eksporter hvelv (i netthvelvet: Verktøy > Eksporter hvelv)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. W Bitwarden wybierz Plik > Eksportuj sejf (w sejfie internetowym: Narzędzia > Eksportuj sejf)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. No Bitwarden, escolha Arquivo > Exportar Cofre (no cofre web: Ferramentas > Exportar Cofre)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. В Bitwarden выберите «Файл» > «Экспорт хранилища» (в веб-хранилище: «Инструменты» > «Экспорт хранилища»)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. ใน Bitwarden เลือก ไฟล์ > ส่งออกตู้นิรภัย (ในตู้นิรภัยบนเว็บ: เครื่องมือ > ส่งออกตู้นิรภัย)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Bitwarden'da Dosya > Kasayı Dışa Aktar'ı seçin (web kasasında: Araçlar > Kasayı Dışa Aktar)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. У Bitwarden виберіть «Файл» > «Експорт сховища» (у веб-сховищі: «Інструменти» > «Експорт сховища»)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. Trong Bitwarden, chọn Tệp > Xuất kho (trong kho web: Công cụ > Xuất kho)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. 在 Bitwarden 中选取“文件”>“导出密码库”（在网页密码库中：“工具”>“导出密码库”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1. 在 Bitwarden 中選擇「檔案」>「匯出密碼庫」（在網頁密碼庫中：「工具」>「匯出密碼庫」）。"
          }
        }
      }
    },
