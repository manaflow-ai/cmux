          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie pozwolił odczytać tego pliku. Pliki z jego folderu domowego otwierają się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não permitiu ler este arquivo. Arquivos da pasta pessoal dele abrem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не разрешил прочитать этот файл. Здесь открываются файлы из его домашней папки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ไม่อนุญาตให้อ่านไฟล์นี้ ไฟล์ในโฟลเดอร์หลักของเครื่องนั้นเปิดที่นี่ได้"
