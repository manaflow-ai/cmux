    "filePages.noFilePage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No file page has the keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーボードを使っているファイルページがありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد صفحة ملف تستخدم لوحة المفاتيح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna stranica datoteke nema tastaturu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen filside har tastaturet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Dateiseite hat die Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ninguna página de archivo tiene el teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune page de fichier n’a le clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna pagina di file ha la tastiera."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានទំព័រឯកសារណាមានក្ដារចុចទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키보드를 가진 파일 페이지가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen filside har tastaturet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadna strona pliku nie ma klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma página de arquivo está com o teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ни одна страница файла не владеет клавиатурой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีหน้าไฟล์ที่ใช้แป้นพิมพ์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klavyeye sahip dosya sayfası yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жодна сторінка файлу не має клавіатури."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có trang tệp nào đang nhận bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有文件页面拥有键盘焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有檔案頁面擁有鍵盤焦點。"
          }
        }
      }
    },
    "filePages.notAFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file cannot be opened."
          }
