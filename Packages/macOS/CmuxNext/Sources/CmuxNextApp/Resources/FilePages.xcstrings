    "filePages.openOutside.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link in this page points outside the folder of the file you opened."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このページのリンクは、開いたファイルのフォルダの外を指しています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشير رابط في هذه الصفحة إلى خارج مجلد الملف الذي فتحته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza na ovoj stranici pokazuje izvan mape datoteke koju ste otvorili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et link på denne side peger uden for mappen med den fil, du åbnede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Link auf dieser Seite zeigt aus dem Ordner der geöffneten Datei heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un enlace de esta página apunta fuera de la carpeta del archivo que abriste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un lien de cette page pointe hors du dossier du fichier que vous avez ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un link in questa pagina punta fuori dalla cartella del file che hai aperto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "តំណមួយនៅក្នុងទំព័រនេះចង្អុលទៅក្រៅថតនៃឯកសារដែលអ្នកបានបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 페이지의 링크가 연 파일의 폴더 밖을 가리킵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En lenke på denne siden peker utenfor mappen til filen du åpnet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Link na tej stronie wskazuje poza folder otwartego pliku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um link nesta página aponta para fora da pasta do arquivo que você abriu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ссылка на этой странице указывает за пределы папки открытого файла."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลิงก์ในหน้านี้ชี้ออกไปนอกโฟลเดอร์ของไฟล์ที่คุณเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sayfadaki bir bağlantı, açtığınız dosyanın klasörünün dışını gösteriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Посилання на цій сторінці вказує за межі теки відкритого файлу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một liên kết trong trang này trỏ ra ngoài thư mục của tệp bạn đã mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此页面中的链接指向你打开的文件所在文件夹之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此頁面中的連結指向你打開的檔案所在資料夾之外。"
          }
        }
      }
    },
