    "filePages.remote.offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏„%@“ غير متصل. سيظهر الملف مجددًا عند إعادة الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nije povezan. Datoteka će se ponovo prikazati kada se ponovo poveže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er ikke forbundet. Filen vises igen, når forbindelsen er genoprettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht verbunden. Die Datei wird wieder angezeigt, sobald die Verbindung besteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not connected. The file shows again when it reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no está conectado. El archivo volverá a mostrarse cuando se reconecte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas connecté. Le fichier s’affichera de nouveau à la reconnexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è connesso. Il file verrà mostrato di nuovo alla riconnessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は接続されていません。再接続するとファイルが再び表示されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” មិនបានភ្ជាប់ទេ។ ឯកសារនឹងបង្ហាញម្ដងទៀតនៅពេលភ្ជាប់ឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 연결되어 있지 않습니다. 다시 연결되면 파일이 다시 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke tilkoblet. Filen vises igjen når den kobler til på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie jest połączony. Plik pojawi się ponownie po ponownym połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está conectado. O arquivo aparecerá de novo quando reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не подключён. Файл снова появится после переподключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ไม่ได้เชื่อมต่อ ไฟล์จะแสดงอีกครั้งเมื่อเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” bağlı değil. Yeniden bağlandığında dosya tekrar gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не під’єднано. Файл знову з’явиться після повторного під’єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” chưa được kết nối. Tệp sẽ hiển thị lại khi kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未连接。重新连接后会再次显示文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」未連線。重新連線後會再次顯示檔案。"
          }
        }
      }
    },
    "filePages.remote.noFiles": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏„%@“ لا يشارك ملفاته مع هذا الـ Mac. حدّث cmux عليه لفتح ملفاته هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ne dijeli svoje datoteke s ovim Macom. Ažurirajte cmux na njemu da biste ovdje otvarali njegove datoteke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” deler ikke sine filer med denne Mac. Opdater cmux på den for at åbne dens filer her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ teilt seine Dateien nicht mit diesem Mac. Aktualisiere cmux dort, um seine Dateien hier zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” does not share its files with this Mac. Update cmux on it to open its files here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no comparte sus archivos con este Mac. Actualiza cmux en esa máquina para abrir sus archivos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne partage pas ses fichiers avec ce Mac. Mettez à jour cmux sur cette machine pour ouvrir ses fichiers ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non condivide i suoi file con questo Mac. Aggiorna cmux su quella macchina per aprirne i file qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこの Mac とファイルを共有していません。ここでファイルを開くには、そのマシンの cmux をアップデートしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” មិនចែករំលែកឯកសាររបស់វាជាមួយ Mac នេះទេ។ ធ្វើបច្ចុប្បន្នភាព cmux នៅលើវា ដើម្បីបើកឯកសាររបស់វានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 이 Mac과 파일을 공유하지 않습니다. 여기서 파일을 열려면 해당 기기의 cmux를 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» deler ikke filene sine med denne Macen. Oppdater cmux på den for å åpne filene her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie udostępnia swoich plików temu Macowi. Zaktualizuj na nim cmux, aby otwierać tu jego pliki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não compartilha os arquivos com este Mac. Atualize o cmux nele para abrir os arquivos aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не делится своими файлами с этим Mac. Обновите на нём cmux, чтобы открывать его файлы здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ไม่ได้แชร์ไฟล์กับ Mac เครื่องนี้ อัปเดต cmux บนเครื่องนั้นเพื่อเปิดไฟล์ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dosyalarını bu Mac ile paylaşmıyor. Dosyalarını burada açmak için oradaki cmux’u güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не ділиться файлами з цим Mac. Оновіть на ньому cmux, щоб відкривати його файли тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” không chia sẻ tệp với máy Mac này. Hãy cập nhật cmux trên máy đó để mở tệp tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未与这台 Mac 共享文件。请更新该机器上的 cmux，以便在此打开其文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」未與這部 Mac 共享檔案。請更新該機器上的 cmux，以便在此開啟其檔案。"
          }
        }
      }
    },
    "filePages.remote.denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
