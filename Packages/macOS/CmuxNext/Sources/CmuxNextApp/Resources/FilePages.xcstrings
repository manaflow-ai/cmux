        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не дозволив прочитати цей файл. Тут відкриваються файли з його домашньої папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” không cho phép đọc tệp này. Các tệp trong thư mục chính của máy đó mở được tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不允许读取此文件。其个人文件夹中的文件可在此打开。"
          }
