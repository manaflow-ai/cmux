    "browserProfiles.deleteBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its cookies, logins, history, extensions and site permissions are deleted. Its open tabs reopen in “%@”."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سيتم حذف ملفات تعريف الارتباط وتسجيلات الدخول والسجل والإضافات وأذونات المواقع الخاصة به. وستُعاد فتح علاماته المفتوحة في «%@»."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Njegovi kolačići, prijave, historija, proširenja i dozvole stranica bit će izbrisani. Otvorene kartice ponovo se otvaraju u „%@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dens cookies, logins, historik, udvidelser og webstedstilladelser slettes. Dens åbne faner genåbnes i “%@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cookies, Anmeldungen, Verlauf, Erweiterungen und Website-Berechtigungen werden gelöscht. Offene Tabs werden in „%@“ erneut geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se eliminan sus cookies, inicios de sesión, historial, extensiones y permisos de sitios. Sus pestañas abiertas se vuelven a abrir en «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses cookies, identifiants, historique, extensions et autorisations de sites sont supprimés. Ses onglets ouverts se rouvrent dans « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cookie, accessi, cronologia, estensioni e autorizzazioni dei siti vengono eliminati. Le schede aperte si riaprono in “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cookie、ログイン、履歴、拡張機能、サイトの権限が削除されます。開いているタブは“%@”で開き直されます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ខូគី ការចូល ប្រវត្តិ កម្មវិធីបន្ថែម និងការអនុញ្ញាតគេហទំព័ររបស់វានឹងត្រូវលុប។ ផ្ទាំងដែលបើកនឹងបើកឡើងវិញក្នុង “%@”។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "쿠키, 로그인, 기록, 확장 프로그램, 사이트 권한이 삭제됩니다. 열린 탭은 “%@”에서 다시 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Informasjonskapsler, pålogginger, logg, utvidelser og nettstedstillatelser slettes. Åpne faner åpnes på nytt i «%@»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jego pliki cookie, logowania, historia, rozszerzenia i uprawnienia witryn zostaną usunięte. Otwarte karty otworzą się ponownie w „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os cookies, logins, histórico, extensões e permissões de sites serão apagados. As abas abertas serão reabertas em “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Его файлы cookie, входы, история, расширения и разрешения сайтов будут удалены. Открытые вкладки откроются заново в «%@»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คุกกี้ การเข้าสู่ระบบ ประวัติ ส่วนขยาย และสิทธิ์ของไซต์จะถูกลบ แท็บที่เปิดอยู่จะเปิดใหม่ใน “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Çerezleri, oturumları, geçmişi, uzantıları ve site izinleri silinir. Açık sekmeleri “%@” içinde yeniden açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Його файли cookie, входи, історію, розширення та дозволи сайтів буде видалено. Відкриті вкладки відкриються знову в «%@»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cookie, thông tin đăng nhập, lịch sử, tiện ích mở rộng và quyền trang web sẽ bị xóa. Các tab đang mở sẽ mở lại trong “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其 Cookie、登录信息、历史记录、扩展程序和网站权限将被删除。其打开的标签页将在“%@”中重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "其 Cookie、登入資料、瀏覽記錄、擴充功能和網站權限將被刪除。其開啟的分頁將在「%@」中重新開啟。"
          }
        }
      }
    },
