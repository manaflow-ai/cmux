          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 %@(으)로 로그인한 iPhone에서 cmux를 여세요. 이 Mac이 Mac 목록에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller åpne cmux på iPhonen, logget på som %@: denne Macen står i listen over Macer."
