    "mobilePairing.page.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this Mac’s workspaces and terminals from cmux on your iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مساحات العمل والطرفيات على هذا الـ Mac من cmux على iPhone."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
