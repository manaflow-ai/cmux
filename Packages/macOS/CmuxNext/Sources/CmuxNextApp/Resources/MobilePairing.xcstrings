          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere lo stato di abbinamento di questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのペアリング状態を読み取れませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចអានស្ថានភាពផ្គូផ្គងរបស់ Mac នេះបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 페어링 상태를 읽을 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese paringsstatusen til denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać stanu parowania tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o status de pareamento deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить состояние связывания этого Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านสถานะการจับคู่ของ Mac เครื่องนี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in eşleştirme durumu okunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати стан під’єднання цього Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được trạng thái ghép nối của máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这台 Mac 的配对状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這台 Mac 的配對狀態。"
          }
        }
      }
    },
