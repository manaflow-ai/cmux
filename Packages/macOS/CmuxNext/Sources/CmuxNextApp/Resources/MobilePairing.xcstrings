    "mobilePairing.page.signedOut.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in on this Mac and on your iPhone with the same cmux account. Only phones signed in to that account can connect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول على هذا الـ Mac وعلى iPhone بحساب cmux نفسه. يمكن فقط للهواتف المسجّلة في هذا الحساب الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na ovom Macu i na iPhoneu istim cmux računom. Povezati se mogu samo telefoni prijavljeni na taj račun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på denne Mac og på din iPhone med den samme cmux-konto. Kun telefoner, der er logget ind på den konto, kan forbinde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf diesem Mac und auf deinem iPhone mit demselben cmux-Konto an. Nur Telefone mit diesem Konto können sich verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en este Mac y en tu iPhone con la misma cuenta de cmux. Solo pueden conectarse los teléfonos con esa cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous sur ce Mac et sur votre iPhone avec le même compte cmux. Seuls les téléphones connectés à ce compte peuvent se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi su questo Mac e sul tuo iPhone con lo stesso account cmux. Solo i telefoni con quell’account possono connettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacとiPhoneで同じcmuxアカウントにサインインしてください。そのアカウントでサインインした電話だけが接続できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលនៅលើ Mac នេះ និងលើ iPhone របស់អ្នកដោយប្រើគណនី cmux ដូចគ្នា។ មានតែទូរស័ព្ទដែលចូលគណនីនោះប៉ុណ្ណោះដែលអាចភ្ជាប់បាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac과 iPhone에서 같은 cmux 계정으로 로그인하세요. 그 계정으로 로그인한 휴대폰만 연결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på denne Macen og iPhonen med den samme cmux-kontoen. Bare telefoner som er logget på den kontoen, kan koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na tym Macu i na iPhonie tym samym kontem cmux. Połączyć mogą się tylko telefony zalogowane na to konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão neste Mac e no seu iPhone com a mesma conta do cmux. Só celulares conectados a essa conta podem se conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите на этом Mac и на iPhone в одну и ту же учётную запись cmux. Подключиться могут только телефоны с этой учётной записью."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้บน Mac เครื่องนี้และบน iPhone ด้วยบัญชี cmux เดียวกัน เฉพาะโทรศัพท์ที่ลงชื่อเข้าใช้บัญชีนั้นเท่านั้นที่เชื่อมต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te ve iPhone’unda aynı cmux hesabıyla giriş yap. Yalnızca bu hesapla giriş yapmış telefonlar bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть на цьому Mac і на iPhone в той самий обліковий запис cmux. Під’єднатися можуть лише телефони з цим обліковим записом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập trên máy Mac này và trên iPhone bằng cùng một tài khoản cmux. Chỉ điện thoại đăng nhập tài khoản đó mới kết nối được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在这台 Mac 和你的 iPhone 上登录同一个 cmux 账户。只有登录该账户的手机才能连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在這台 Mac 與你的 iPhone 上登入同一個 cmux 帳號。只有登入該帳號的手機才能連線。"
          }
        }
      }
    },
