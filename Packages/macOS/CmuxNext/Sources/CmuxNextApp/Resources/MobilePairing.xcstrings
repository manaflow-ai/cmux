        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo otwórz cmux na iPhonie zalogowanym jako %@: ten Mac jest na liście Maców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou abra o cmux no iPhone com a sessão de %@: este Mac aparece na lista de Macs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или откройте cmux на iPhone с учётной записью %@: этот Mac есть в списке Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หรือเปิด cmux บน iPhone ที่ลงชื่อเข้าใช้เป็น %@ แล้ว Mac เครื่องนี้จะอยู่ในรายการ Mac"
