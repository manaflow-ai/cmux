    "mobilePairing.page.ready.list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or open cmux on your iPhone, signed in as %@: this Mac is in its list of Macs."
