    "mobilePairing.settingsNotLoaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are still loading. Try again in a moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الإعدادات قيد التحميل. حاول مرة أخرى بعد لحظة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavke se još učitavaju. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillingerne indlæses stadig. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen werden noch geladen. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes aún se están cargando. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages sont encore en cours de chargement. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sono ancora in caricamento. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込み中です。しばらくしてからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការកំណត់កំពុងផ្ទុកនៅឡើយ។ សូមព្យាយាមម្តងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 아직 불러오는 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillingene lastes fortsatt inn. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia wciąż się wczytują. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes ainda estão carregando. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ещё загружаются. Повторите попытку через минуту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่ายังโหลดอยู่ ลองอีกครั้งในอีกสักครู่"
