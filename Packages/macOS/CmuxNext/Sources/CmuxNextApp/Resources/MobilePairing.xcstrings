          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystaj z obszarów roboczych i terminali tego Maca w cmux na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os espaços de trabalho e terminais deste Mac no cmux do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работайте с рабочими пространствами и терминалами этого Mac из cmux на iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้พื้นที่ทำงานและเทอร์มินัลของ Mac เครื่องนี้จาก cmux บน iPhone ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’in çalışma alanlarını ve terminallerini iPhone’undaki cmux’tan kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся робочими просторами й терміналами цього Mac із cmux на iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
