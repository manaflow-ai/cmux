{
  "sourceLanguage": "en",
  "strings": {
    "mobilePairing.page.accessOff.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone access lets cmux on your iPhone connect to this Mac. Workspace names and terminal output go only over the encrypted link to your phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح وصول الهاتف لتطبيق cmux على iPhone الاتصال بهذا الـ Mac. تنتقل أسماء مساحات العمل ومخرجات الطرفية عبر الرابط المشفّر إلى هاتفك فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup telefona omogućava cmuxu na iPhoneu da se poveže s ovim Macom. Nazivi radnih prostora i izlaz terminala idu samo šifriranom vezom do vašeg telefona."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang fra telefon lader cmux på din iPhone forbinde til denne Mac. Navne på arbejdsområder og terminaloutput sendes kun over den krypterede forbindelse til din telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Telefonzugriff verbindet sich cmux auf deinem iPhone mit diesem Mac. Namen von Arbeitsbereichen und Terminalausgaben gehen nur über die verschlüsselte Verbindung zu deinem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso del teléfono permite que cmux en tu iPhone se conecte a este Mac. Los nombres de los espacios de trabajo y la salida del terminal solo viajan por el enlace cifrado a tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès du téléphone permet à cmux sur votre iPhone de se connecter à ce Mac. Les noms des espaces de travail et la sortie du terminal passent uniquement par le lien chiffré vers votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso dal telefono consente a cmux sul tuo iPhone di connettersi a questo Mac. I nomi delle aree di lavoro e l’output del terminale passano solo dal collegamento cifrato verso il tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話からのアクセスを許可すると、iPhoneのcmuxがこのMacに接続できます。ワークスペース名とターミナル出力は、電話への暗号化された接続だけを通ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលប្រើពីទូរស័ព្ទអនុញ្ញាតឲ្យ cmux នៅលើ iPhone របស់អ្នកភ្ជាប់ទៅ Mac នេះ។ ឈ្មោះកន្លែងធ្វើការ និងលទ្ធផល terminal ឆ្លងកាត់តែតំណដែលបានអ៊ិនគ្រីបទៅទូរស័ព្ទរបស់អ្នកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 접근을 허용하면 iPhone의 cmux가 이 Mac에 연결할 수 있습니다. 작업 공간 이름과 터미널 출력은 휴대폰과의 암호화된 연결로만 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med telefontilgang kan cmux på iPhonen koble til denne Macen. Navn på arbeidsområder og terminalutdata går bare over den krypterte forbindelsen til telefonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp z telefonu pozwala cmux na iPhonie połączyć się z tym Makiem. Nazwy obszarów roboczych i dane z terminala trafiają tylko przez szyfrowane połączenie do telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso do celular permite que o cmux no iPhone se conecte a este Mac. Nomes de espaços de trabalho e a saída do terminal passam apenas pelo link criptografado até o seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ с телефона позволяет cmux на iPhone подключаться к этому Mac. Названия рабочих пространств и вывод терминала передаются только по зашифрованному каналу на ваш телефон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงจากโทรศัพท์ทำให้ cmux บน iPhone เชื่อมต่อกับ Mac เครื่องนี้ได้ ชื่อพื้นที่ทำงานและเอาต์พุตเทอร์มินัลจะส่งผ่านลิงก์ที่เข้ารหัสไปยังโทรศัพท์ของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon erişimi, iPhone’undaki cmux’un bu Mac’e bağlanmasını sağlar. Çalışma alanı adları ve terminal çıktısı yalnızca telefonuna giden şifreli bağlantıdan geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ із телефона дає змогу cmux на iPhone під’єднуватися до цього Mac. Назви робочих просторів і вивід термінала передаються лише зашифрованим з’єднанням на ваш телефон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập từ điện thoại cho phép cmux trên iPhone kết nối tới máy Mac này. Tên không gian làm việc và đầu ra terminal chỉ đi qua kết nối mã hóa tới điện thoại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启手机访问后，iPhone 上的 cmux 可以连接这台 Mac。工作区名称和终端输出只通过加密连接发送到你的手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟手機存取後，iPhone 上的 cmux 可以連線這台 Mac。工作區名稱和終端機輸出只會透過加密連線傳到你的手機。"
          }
        }
      }
    },
    "mobilePairing.page.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Phone Access"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بوصول الهاتف"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli pristup telefona"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang fra telefon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonzugriff erlauben"
          }
        },
        "es": {
