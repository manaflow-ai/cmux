        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើកន្លែងធ្វើការ និង terminal របស់ Mac នេះពី cmux នៅលើ iPhone របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 cmux에서 이 Mac의 작업 공간과 터미널을 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
