          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតការចូលប្រើពីទូរស័ព្ទ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 접근 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat telefontilgang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp z telefonu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir Acesso do Celular"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ с телефона"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงจากโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon Erişimine İzin Ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити доступ із телефона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép điện thoại truy cập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许手机访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許手機存取"
          }
        }
      }
    },
    "mobilePairing.page.failed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac could not start listening for phones. Check your internet connection; cmux keeps trying."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على هذا الـ Mac بدء الاستماع للهواتف. تحقّق من اتصالك بالإنترنت؛ يواصل cmux المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nije mogao početi primati telefone. Provjerite internetsku vezu; cmux nastavlja pokušavati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac kunne ikke begynde at lytte efter telefoner. Tjek din internetforbindelse; cmux bliver ved med at prøve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac konnte nicht beginnen, auf Telefone zu warten. Prüfe deine Internetverbindung; cmux versucht es weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no pudo empezar a esperar teléfonos. Comprueba tu conexión a internet; cmux lo sigue intentando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a pas pu commencer à attendre les téléphones. Vérifiez votre connexion internet ; cmux continue d’essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è riuscito a mettersi in ascolto dei telefoni. Controlla la connessione a internet; cmux continua a provare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで電話の待ち受けを開始できませんでした。インターネット接続を確認してください。cmuxは再試行を続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះមិនអាចចាប់ផ្តើមរង់ចាំទូរស័ព្ទបានទេ។ សូមពិនិត្យការតភ្ជាប់អ៊ីនធឺណិត; cmux នៅតែព្យាយាម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 휴대폰 연결 대기를 시작할 수 없습니다. 인터넷 연결을 확인하세요. cmux가 계속 재시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen kunne ikke begynne å lytte etter telefoner. Sjekk internettforbindelsen; cmux fortsetter å prøve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie mógł zacząć nasłuchiwać telefonów. Sprawdź połączenie z internetem; cmux próbuje dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não conseguiu começar a aguardar celulares. Verifique sua conexão com a internet; o cmux continua tentando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не смог начать ожидать подключения телефонов. Проверьте подключение к интернету; cmux продолжает попытки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้เริ่มรอการเชื่อมต่อจากโทรศัพท์ไม่ได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต cmux จะพยายามต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac telefonları dinlemeye başlayamadı. İnternet bağlantını denetle; cmux denemeye devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не зміг почати чекати на телефони. Перевірте з’єднання з інтернетом; cmux продовжує спроби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này chưa thể bắt đầu chờ kết nối từ điện thoại. Hãy kiểm tra kết nối internet; cmux vẫn tiếp tục thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法开始等待手机连接。请检查网络连接；cmux 会继续尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 無法開始等待手機連線。請檢查網路連線；cmux 會繼續嘗試。"
          }
        }
      }
    },
    "mobilePairing.page.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read this Mac’s pairing status."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة حالة الإقران لهذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pročitati status uparivanja ovog Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse denne Macs parringsstatus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
