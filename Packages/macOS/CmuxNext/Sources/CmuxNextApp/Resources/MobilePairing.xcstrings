{
  "sourceLanguage": "en",
  "strings": {
    "mobilePairing.page.accessOff.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone access lets cmux on your iPhone connect to this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح وصول الهاتف لتطبيق cmux على iPhone الاتصال بهذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pristup telefona omogućava cmuxu na iPhoneu da se poveže s ovim Macom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adgang fra telefon lader cmux på din iPhone forbinde til denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit Telefonzugriff verbindet sich cmux auf deinem iPhone mit diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso del teléfono permite que cmux en tu iPhone se conecte a este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès du téléphone permet à cmux sur votre iPhone de se connecter à ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accesso dal telefono consente a cmux sul tuo iPhone di connettersi a questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "電話からのアクセスを許可すると、iPhoneのcmuxがこのMacに接続できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចូលប្រើពីទូរស័ព្ទអនុញ្ញាតឲ្យ cmux នៅលើ iPhone របស់អ្នកភ្ជាប់ទៅ Mac នេះ។ ឈ្មោះកន្លែងធ្វើការ និងលទ្ធផល terminal ឆ្លងកាត់តែតំណដែលបានអ៊ិនគ្រីបទៅទូរស័ព្ទរបស់អ្នកប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "휴대폰 접근을 허용하면 iPhone의 cmux가 이 Mac에 연결할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med telefontilgang kan cmux på iPhonen koble til denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dostęp z telefonu pozwala cmux na iPhonie połączyć się z tym Makiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O acesso do celular permite que o cmux no iPhone se conecte a este Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доступ с телефона позволяет cmux на iPhone подключаться к этому Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเข้าถึงจากโทรศัพท์ทำให้ cmux บน iPhone เชื่อมต่อกับ Mac เครื่องนี้ได้ ชื่อพื้นที่ทำงานและเอาต์พุตเทอร์มินัลจะส่งผ่านลิงก์ที่เข้ารหัสไปยังโทรศัพท์ของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon erişimi, iPhone’undaki cmux’un bu Mac’e bağlanmasını sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доступ із телефона дає змогу cmux на iPhone під’єднуватися до цього Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quyền truy cập từ điện thoại cho phép cmux trên iPhone kết nối tới máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "开启手机访问后，iPhone 上的 cmux 可以连接这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟手機存取後，iPhone 上的 cmux 可以連線這台 Mac。"
          }
        }
      }
    },
    "mobilePairing.page.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Phone Access"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بوصول الهاتف"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli pristup telefona"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang fra telefon"
          }
        },
        "de": {
