    "remote.terminal.moveBrowser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser tabs cannot move to a workspace on another machine yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن نقل علامات تبويب المتصفح إلى مساحة عمل على جهاز آخر بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice preglednika se još ne mogu premjestiti u radni prostor na drugoj mašini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browserfaner kan endnu ikke flyttes til et arbejdsområde på en anden maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser-Tabs können noch nicht in einen Arbeitsbereich auf einem anderen Rechner verschoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pestañas del navegador aún no pueden moverse a un espacio de trabajo de otra máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les onglets du navigateur ne peuvent pas encore être déplacés vers un espace de travail d'une autre machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le schede del browser non possono ancora essere spostate in uno spazio di lavoro su un'altra macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザタブはまだ別のマシンのワークスペースへ移動できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងកម្មវិធីរុករកមិនអាចផ្លាស់ទីទៅកន្លែងធ្វើការនៅលើម៉ាស៊ីនផ្សេងបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 탭은 아직 다른 컴퓨터의 작업 공간으로 이동할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nettleserfaner kan ennå ikke flyttes til et arbeidsområde på en annen maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty przeglądarki nie mogą jeszcze zostać przeniesione do obszaru roboczego na innym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abas do navegador ainda não podem ser movidas para um espaço de trabalho em outra máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки браузера пока нельзя переместить в рабочую область на другой машине."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังย้ายแท็บเบราว์เซอร์ไปยังพื้นที่ทำงานบนเครื่องอื่นไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarayıcı sekmeleri henüz başka bir makinedeki çalışma alanına taşınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки браузера поки не можна перемістити до робочого простору на іншій машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa thể di chuyển thẻ trình duyệt sang không gian làm việc trên máy khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
