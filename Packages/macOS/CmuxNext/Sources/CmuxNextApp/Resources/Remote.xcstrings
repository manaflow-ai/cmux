    "remote.failed.destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not an SSH destination. Use user@host, a host from your SSH config, or host:port."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” ليس وجهة SSH. استخدم user@host أو مضيفًا من إعدادات SSH أو host:port."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ nije SSH odredište. Koristite user@host, host iz SSH konfiguracije ili host:port."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” er ikke en SSH-destination. Brug user@host, en vært fra din SSH-konfiguration eller host:port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ ist kein SSH-Ziel. Verwende user@host, einen Host aus deiner SSH-Konfiguration oder host:port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” no es un destino SSH. Usa user@host, un host de tu configuración SSH o host:port."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » n’est pas une destination SSH. Utilisez user@host, un hôte de votre configuration SSH ou host:port."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” non è una destinazione SSH. Usa user@host, un host dalla configurazione SSH o host:port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」は SSH の接続先ではありません。user@host、SSH 設定のホスト、または host:port を使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” មិនមែនជាគោលដៅ SSH ទេ។ ប្រើ user@host ម៉ាស៊ីនពីការកំណត់ SSH ឬ host:port។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”은(는) SSH 대상이 아닙니다. user@host, SSH 설정의 호스트 또는 host:port를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» er ikke et SSH-mål. Bruk user@host, en vert fra SSH-konfigurasjonen eller host:port."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” nie jest celem SSH. Użyj user@host, hosta z konfiguracji SSH lub host:port."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” não é um destino SSH. Use user@host, um host da sua configuração SSH ou host:port."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» — не адрес SSH. Используйте user@host, хост из конфигурации SSH или host:port."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” ไม่ใช่ปลายทาง SSH ใช้ user@host โฮสต์จากการตั้งค่า SSH หรือ host:port"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” bir SSH hedefi değil. user@host, SSH yapılandırmanızdaki bir ana makine ya da host:port kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» — не адреса SSH. Використайте user@host, хост із конфігурації SSH або host:port."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” không phải đích SSH. Dùng user@host, một máy trong cấu hình SSH, hoặc host:port."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”不是 SSH 目标。请使用 user@host、SSH 配置中的主机或 host:port。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」不是 SSH 目標。請使用 user@host、SSH 設定中的主機或 host:port。"
          }
        }
      }
    },
    "remote.failed.noMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No SSH machine is selected. Right-click a machine or pass --machine <name>."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُحدَّد جهاز SSH. انقر بزر الماوس الأيمن على جهاز أو مرّر ‎--machine <name>‎."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije odabrana SSH mašina. Kliknite desnim klikom na mašinu ili proslijedite --machine <name>."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen SSH-maskine er valgt. Højreklik på en maskine, eller angiv --machine <name>."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine SSH-Maschine ausgewählt. Klicke eine Maschine mit rechts an oder gib --machine <name> an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay ninguna máquina SSH seleccionada. Haz clic derecho en una máquina o pasa --machine <name>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune machine SSH n’est sélectionnée. Cliquez sur une machine avec le bouton droit ou passez --machine <name>."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna macchina SSH selezionata. Fai clic destro su una macchina o passa --machine <name>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH マシンが選択されていません。マシンを右クリックするか、--machine <name> を指定してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនបានជ្រើសម៉ាស៊ីន SSH ទេ។ ចុចស្ដាំលើម៉ាស៊ីន ឬផ្ដល់ --machine <name>។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택된 SSH 머신이 없습니다. 머신을 오른쪽 클릭하거나 --machine <name>을 전달하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen SSH-maskin er valgt. Høyreklikk på en maskin, eller angi --machine <name>."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie wybrano maszyny SSH. Kliknij maszynę prawym przyciskiem lub podaj --machine <name>."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma máquina SSH selecionada. Clique com o botão direito em uma máquina ou passe --machine <name>."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-машина не выбрана. Щёлкните машину правой кнопкой или передайте --machine <name>."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่ได้เลือกเครื่อง SSH คลิกขวาที่เครื่องหรือระบุ --machine <name>"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH makinesi seçili değil. Bir makineye sağ tıklayın ya da --machine <name> verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-машину не вибрано. Клацніть машину правою кнопкою або передайте --machine <name>."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa chọn máy SSH. Nhấp chuột phải vào một máy hoặc truyền --machine <name>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未选择 SSH 机器。请右键点按机器，或传入 --machine <name>。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未選擇 SSH 機器。請按右鍵點選機器，或傳入 --machine <name>。"
          }
        }
      }
    },
