    "remote.install.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads cmux-tui %1$@ from files.cmux.com, checks its SHA-256 checksum and installs it at %2$@ on %3$@, without sudo. A cmux-tui running there restarts on the new build; its terminals keep running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُنزّل cmux-tui %1$@ من files.cmux.com ويتحقق من مجموع SHA-256 ثم يثبّته في %2$@ على %3$@ دون sudo. يُعاد تشغيل cmux-tui العامل هناك على الإصدار الجديد وتستمر طرفياته في العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preuzima cmux-tui %1$@ sa files.cmux.com, provjerava njegov SHA-256 kontrolni zbir i instalira ga na %2$@ na %3$@, bez sudo. cmux-tui koji tamo radi ponovo se pokreće na novoj verziji; njegovi terminali nastavljaju raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Henter cmux-tui %1$@ fra files.cmux.com, tjekker SHA-256-kontrolsummen og installerer den i %2$@ på %3$@ uden sudo. En cmux-tui, der kører der, genstarter på den nye build; dens terminaler kører videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lädt cmux-tui %1$@ von files.cmux.com, prüft die SHA-256-Prüfsumme und installiert es unter %2$@ auf %3$@, ohne sudo. Ein dort laufendes cmux-tui startet mit dem neuen Build neu; seine Terminals laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descarga cmux-tui %1$@ de files.cmux.com, comprueba su suma SHA-256 y lo instala en %2$@ en %3$@, sin sudo. Un cmux-tui en ejecución allí se reinicia con la nueva compilación; sus terminales siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Télécharge cmux-tui %1$@ depuis files.cmux.com, vérifie sa somme SHA-256 et l’installe dans %2$@ sur %3$@, sans sudo. Un cmux-tui en cours d’exécution y redémarre sur la nouvelle version ; ses terminaux continuent de tourner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scarica cmux-tui %1$@ da files.cmux.com, verifica il checksum SHA-256 e lo installa in %2$@ su %3$@, senza sudo. Un cmux-tui in esecuzione lì si riavvia con la nuova build; i suoi terminali restano attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "files.cmux.com から cmux-tui %1$@ をダウンロードし、SHA-256 チェックサムを確認して %3$@ の %2$@ に sudo なしでインストールします。そこで動作中の cmux-tui は新しいビルドで再起動し、ターミナルは動作し続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទាញយក cmux-tui %1$@ ពី files.cmux.com ពិនិត្យ checksum SHA-256 និងដំឡើងវានៅ %2$@ លើ %3$@ ដោយគ្មាន sudo។ cmux-tui ដែលកំពុងដំណើរការនៅទីនោះចាប់ផ្ដើមឡើងវិញលើ build ថ្មី ហើយ terminal របស់វានៅតែដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "files.cmux.com에서 cmux-tui %1$@를 내려받아 SHA-256 체크섬을 확인하고 %3$@의 %2$@에 sudo 없이 설치합니다. 그곳에서 실행 중인 cmux-tui는 새 빌드로 다시 시작되며 터미널은 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laster ned cmux-tui %1$@ fra files.cmux.com, sjekker SHA-256-kontrollsummen og installerer den i %2$@ på %3$@, uten sudo. En cmux-tui som kjører der, starter på nytt med den nye builden; terminalene fortsetter å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pobiera cmux-tui %1$@ z files.cmux.com, sprawdza sumę SHA-256 i instaluje go w %2$@ na %3$@, bez sudo. Działający tam cmux-tui uruchamia się ponownie w nowej wersji; jego terminale działają dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baixa o cmux-tui %1$@ de files.cmux.com, confere o checksum SHA-256 e o instala em %2$@ em %3$@, sem sudo. Um cmux-tui em execução lá reinicia na nova build; seus terminais continuam rodando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скачивает cmux-tui %1$@ с files.cmux.com, проверяет контрольную сумму SHA-256 и устанавливает его в %2$@ на %3$@ без sudo. Работающий там cmux-tui перезапускается на новой сборке; его терминалы продолжают работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดาวน์โหลด cmux-tui %1$@ จาก files.cmux.com ตรวจ checksum SHA-256 แล้วติดตั้งที่ %2$@ บน %3$@ โดยไม่ใช้ sudo cmux-tui ที่ทำงานอยู่ที่นั่นจะรีสตาร์ตด้วยบิลด์ใหม่ และเทอร์มินัลยังทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-tui %1$@ sürümünü files.cmux.com’dan indirir, SHA-256 sağlama toplamını denetler ve %3$@ üzerinde %2$@ konumuna sudo olmadan kurar. Orada çalışan cmux-tui yeni derlemeyle yeniden başlar; terminalleri çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завантажує cmux-tui %1$@ з files.cmux.com, перевіряє контрольну суму SHA-256 і встановлює його в %2$@ на %3$@ без sudo. Запущений там cmux-tui перезапускається на новій збірці; його термінали працюють далі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tải cmux-tui %1$@ từ files.cmux.com, kiểm tra checksum SHA-256 và cài vào %2$@ trên %3$@, không dùng sudo. cmux-tui đang chạy ở đó sẽ khởi động lại bằng bản mới; các terminal của nó vẫn tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从 files.cmux.com 下载 cmux-tui %1$@，校验其 SHA-256 校验和，并在不使用 sudo 的情况下安装到 %3$@ 上的 %2$@。那里正在运行的 cmux-tui 会以新版本重启，其终端继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從 files.cmux.com 下載 cmux-tui %1$@，驗證其 SHA-256 校驗和，並在不使用 sudo 的情況下安裝到 %3$@ 上的 %2$@。那裡正在執行的 cmux-tui 會以新版本重新啟動，其終端機繼續執行。"
          }
        }
      }
    },
