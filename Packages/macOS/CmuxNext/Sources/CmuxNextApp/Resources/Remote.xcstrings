        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំង Home ការសន្ទនា និងកម្មវិធី មិនអាចផ្លាស់ទីទៅកន្លែងធ្វើការលើម៉ាស៊ីនផ្សេងទៀតបានទេ។"
