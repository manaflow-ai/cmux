          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال. يعيد cmux الاتصال تلقائيًا، وتستمر البرامج في العمل على الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza je prekinuta. cmux se sam ponovo povezuje; programi nastavljaju raditi na mašini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen blev afbrudt. cmux genopretter den selv; programmer kører videre på maskinen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen. cmux verbindet sich selbst neu; Programme laufen auf der Maschine weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión. cmux se reconecta solo; los programas siguen ejecutándose en la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été interrompue. cmux se reconnecte seul ; les programmes continuent de tourner sur la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione si è interrotta. cmux si riconnette da solo; i programmi continuano a funzionare sulla macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました。cmux が自動で再接続します。マシン上のプログラムは動作し続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការតភ្ជាប់បានដាច់។ cmux ភ្ជាប់ឡើងវិញដោយខ្លួនឯង កម្មវិធីនៅតែដំណើរការលើម៉ាស៊ីន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊겼습니다. cmux가 자동으로 다시 연결하며, 프로그램은 머신에서 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen ble brutt. cmux kobler til på nytt av seg selv; programmer fortsetter å kjøre på maskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie zostało przerwane. cmux połączy się ponownie samodzielnie; programy nadal działają na maszynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão caiu. O cmux se reconecta sozinho; os programas continuam rodando na máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервалось. cmux переподключится сам; программы продолжают работать на машине."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อขาดหาย cmux จะเชื่อมต่อใหม่เอง โปรแกรมยังคงทำงานบนเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı koptu. cmux kendiliğinden yeniden bağlanır; programlar makinede çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднання обірвалося. cmux перепідключиться сам; програми продовжують працювати на машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối bị ngắt. cmux tự kết nối lại; các chương trình vẫn tiếp tục chạy trên máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已断开。cmux 会自动重新连接；程序会继续在机器上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已中斷。cmux 會自動重新連線；程式會繼續在機器上執行。"
          }
        }
      }
    },
    "remote.status.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the machine: %@ cmux tries again when the network changes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر الوصول إلى الجهاز: %@ سيحاول cmux مجددًا عند تغيّر الشبكة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina nije dostupna: %@ cmux pokušava ponovo kada se mreža promijeni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen kan ikke nås: %@ cmux prøver igen, når netværket ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Maschine ist nicht erreichbar: %@ cmux versucht es erneut, wenn sich das Netzwerk ändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede acceder a la máquina: %@ cmux lo reintenta cuando cambia la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Machine injoignable : %@ cmux réessaie quand le réseau change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere la macchina: %@ cmux riprova quando cambia la rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マシンに到達できません: %@ ネットワークが変わると cmux が再試行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចទៅដល់ម៉ាស៊ីនបានទេ៖ %@ cmux ព្យាយាមម្ដងទៀតនៅពេលបណ្ដាញផ្លាស់ប្ដូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "머신에 연결할 수 없습니다: %@ 네트워크가 바뀌면 cmux가 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen kan ikke nås: %@ cmux prøver igjen når nettverket endres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można połączyć się z maszyną: %@ cmux spróbuje ponownie po zmianie sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível alcançar a máquina: %@ O cmux tenta de novo quando a rede muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина недоступна: %@ cmux повторит попытку при смене сети."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เข้าถึงเครื่องไม่ได้: %@ cmux จะลองอีกครั้งเมื่อเครือข่ายเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makineye ulaşılamıyor: %@ cmux ağ değiştiğinde yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина недоступна: %@ cmux спробує знову, коли зміниться мережа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể kết nối tới máy: %@ cmux sẽ thử lại khi mạng thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法访问该机器：%@ 网络变化时 cmux 会重试。"
          }
