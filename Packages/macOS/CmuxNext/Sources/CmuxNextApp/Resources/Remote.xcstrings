          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Home-, samtale- og appfaner kan ikke flyttes til et arbeidsområde på en annen maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kart Home, rozmów i aplikacji nie można przenieść do obszaru roboczego na innym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abas da Home, de conversas e de apps não podem ser movidas para um espaço de trabalho em outra máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки Home, бесед и приложений нельзя переместить в рабочее пространство на другом компьютере."
          }
        },
        "th": {
          "stringUnit": {
