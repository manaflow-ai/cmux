    "remote.status.hostKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key is not trusted: %1$@ Run ssh %2$@ in a terminal to check it. cmux never skips host key checks."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مفتاح المضيف غير موثوق: %1$@ شغّل ssh %2$@ في طرفية للتحقق منه. لا يتخطى cmux فحص مفتاح المضيف أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ključ hosta nije pouzdan: %1$@ Pokrenite ssh %2$@ u terminalu da ga provjerite. cmux nikad ne preskače provjeru ključa hosta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Værtsnøglen er ikke betroet: %1$@ Kør ssh %2$@ i en terminal for at kontrollere den. cmux springer aldrig kontrol af værtsnøgler over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dem Host-Schlüssel wird nicht vertraut: %1$@ Führe ssh %2$@ in einem Terminal aus, um ihn zu prüfen. cmux überspringt die Host-Schlüssel-Prüfung nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clave del host no es de confianza: %1$@ Ejecuta ssh %2$@ en una terminal para comprobarla. cmux nunca omite la comprobación de claves de host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé d’hôte n’est pas approuvée : %1$@ Exécutez ssh %2$@ dans un terminal pour la vérifier. cmux ne saute jamais la vérification des clés d’hôte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chiave dell’host non è attendibile: %1$@ Esegui ssh %2$@ in un terminale per verificarla. cmux non salta mai il controllo delle chiavi host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ホストキーが信頼されていません: %1$@ ターミナルで ssh %2$@ を実行して確認してください。cmux がホストキーの確認を省くことはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កូនសោម៉ាស៊ីនមិនត្រូវបានទុកចិត្តទេ៖ %1$@ រត់ ssh %2$@ ក្នុង terminal ដើម្បីពិនិត្យវា។ cmux មិនដែលរំលងការពិនិត្យកូនសោម៉ាស៊ីនទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "호스트 키를 신뢰할 수 없습니다: %1$@ 터미널에서 ssh %2$@를 실행해 확인하세요. cmux는 호스트 키 확인을 건너뛰지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertsnøkkelen er ikke klarert: %1$@ Kjør ssh %2$@ i en terminal for å sjekke den. cmux hopper aldri over kontroll av vertsnøkler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klucz hosta nie jest zaufany: %1$@ Uruchom ssh %2$@ w terminalu, aby go sprawdzić. cmux nigdy nie pomija sprawdzania kluczy hosta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A chave do host não é confiável: %1$@ Rode ssh %2$@ em um terminal para conferi-la. O cmux nunca pula a verificação de chaves de host."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ хоста не доверенный: %1$@ Выполните ssh %2$@ в терминале, чтобы проверить его. cmux никогда не пропускает проверку ключей хоста."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่เชื่อถือคีย์โฮสต์: %1$@ เรียก ssh %2$@ ในเทอร์มินัลเพื่อตรวจสอบ cmux ไม่เคยข้ามการตรวจคีย์โฮสต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ana makine anahtarına güvenilmiyor: %1$@ Denetlemek için bir terminalde ssh %2$@ çalıştırın. cmux ana makine anahtarı denetimini asla atlamaz."
          }
        },
        "uk": {
          "stringUnit": {
