    "remote.terminal.needsCapability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace's machine runs a cmux-tui without terminals from other machines. Update it first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشغّل جهاز مساحة العمل هذه cmux-tui لا يدعم طرفيات من أجهزة أخرى. حدّثه أولاً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina ovog radnog prostora pokreće cmux-tui bez terminala s drugih mašina. Prvo ga ažurirajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette arbejdsområdes maskine kører en cmux-tui uden terminaler fra andre maskiner. Opdater den først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Rechner dieses Arbeitsbereichs nutzt ein cmux-tui ohne Terminals anderer Rechner. Aktualisiere es zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La máquina de este espacio de trabajo ejecuta un cmux-tui sin terminales de otras máquinas. Actualízalo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La machine de cet espace de travail exécute un cmux-tui sans terminaux d'autres machines. Mettez-le à jour d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La macchina di questo spazio di lavoro esegue un cmux-tui senza terminali di altre macchine. Aggiornalo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このワークスペースのマシンの cmux-tui は、他のマシンのターミナルに対応していません。先に更新してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននៃកន្លែងធ្វើការនេះដំណើរការ cmux-tui ដែលគ្មានស្ថានីយពីម៉ាស៊ីនផ្សេង។ សូមធ្វើបច្ចុប្បន្នភាពជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업 공간의 컴퓨터는 다른 컴퓨터의 터미널을 지원하지 않는 cmux-tui를 실행합니다. 먼저 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen til dette arbeidsområdet kjører en cmux-tui uten terminaler fra andre maskiner. Oppdater den først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Komputer tego obszaru roboczego ma cmux-tui bez terminali z innych komputerów. Najpierw go zaktualizuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A máquina deste espaço de trabalho roda um cmux-tui sem terminais de outras máquinas. Atualize-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На машине этой рабочей области cmux-tui без терминалов других машин. Сначала обновите его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องของพื้นที่ทำงานนี้ใช้ cmux-tui ที่ไม่รองรับเทอร์มินัลจากเครื่องอื่น อัปเดตก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu çalışma alanının makinesi diğer makinelerin terminallerini desteklemeyen bir cmux-tui çalıştırıyor. Önce güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина цього робочого простору має cmux-tui без терміналів інших машин. Спершу оновіть його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy của không gian làm việc này chạy cmux-tui không hỗ trợ terminal từ máy khác. Hãy cập nhật trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作区所在机器的 cmux-tui 不支持其他机器的终端。请先更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此工作區所在機器的 cmux-tui 不支援其他機器的終端機。請先更新。"
          }
        }
      }
    },
