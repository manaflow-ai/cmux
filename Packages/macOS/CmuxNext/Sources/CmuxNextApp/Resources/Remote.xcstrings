    "remote.forget.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the machine from the saved list with its personal order, groups and space pins. Nothing on the machine changes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يزيل الجهاز من القائمة المحفوظة مع ترتيبه الشخصي ومجموعاته وتثبيتات المساحات. لا يتغير شيء على الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uklanja mašinu sa sačuvane liste zajedno s ličnim redoslijedom, grupama i pričvršćenjima u prostorima. Na mašini se ništa ne mijenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjerner maskinen fra den gemte liste med dens personlige rækkefølge, grupper og områdefastgørelser. Intet på maskinen ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entfernt die Maschine mit ihrer persönlichen Reihenfolge, ihren Gruppen und Space-Pins aus der gespeicherten Liste. Auf der Maschine ändert sich nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quita la máquina de la lista guardada con su orden personal, grupos y fijaciones de espacios. En la máquina no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retire la machine de la liste enregistrée avec son ordre personnel, ses groupes et ses épinglages d’espaces. Rien ne change sur la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rimuove la macchina dall’elenco salvato con ordine personale, gruppi e fissaggi negli spazi. Sulla macchina non cambia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存済みリストからマシンを、個人の並び順、グループ、スペースのピン留めと一緒に削除します。マシン上では何も変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដកម៉ាស៊ីនចេញពីបញ្ជីដែលបានរក្សាទុក រួមជាមួយលំដាប់ផ្ទាល់ខ្លួន ក្រុម និងការខ្ទាស់ក្នុងលំហ។ គ្មានអ្វីផ្លាស់ប្ដូរលើម៉ាស៊ីនទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장된 목록에서 머신을 개인 순서, 그룹, 스페이스 고정과 함께 제거합니다. 머신에서는 아무것도 바뀌지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fjerner maskinen fra den lagrede listen med personlig rekkefølge, grupper og områdefestinger. Ingenting endres på maskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuwa maszynę z zapisanej listy wraz z osobistą kolejnością, grupami i przypięciami w obszarach. Na maszynie nic się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remove a máquina da lista salva com sua ordem pessoal, grupos e fixações em espaços. Nada muda na máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет машину из сохранённого списка вместе с личным порядком, группами и закреплениями в областях. На самой машине ничего не меняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลบเครื่องออกจากรายการที่บันทึกไว้ พร้อมลำดับส่วนตัว กลุ่ม และการปักหมุดในพื้นที่ ไม่มีอะไรเปลี่ยนบนเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makineyi kişisel sırası, grupları ve alan sabitlemeleriyle birlikte kayıtlı listeden kaldırır. Makinede hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вилучає машину зі збереженого списку разом з особистим порядком, групами й закріпленнями в просторах. На самій машині нічого не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa máy khỏi danh sách đã lưu cùng thứ tự cá nhân, nhóm và ghim không gian. Không có gì thay đổi trên máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从已保存列表中移除该机器及其个人排序、分组和空间置顶。机器上不会有任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從已儲存列表中移除該機器及其個人排序、群組和空間釘選。機器上不會有任何變更。"
          }
        }
      }
    },
