{
  "sourceLanguage": "en",
  "strings": {
    "clipboardRead.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a program to read the clipboard?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تسمح لبرنامج بقراءة الحافظة؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoliti programu da čita međuspremnik?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du tillade et program at læse udklipsholderen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einem Programm erlauben, die Zwischenablage zu lesen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir que un programa lea el portapapeles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser un programme à lire le presse-papiers ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consentire a un programma di leggere gli appunti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムにクリップボードの読み取りを許可しますか?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យកម្មវិធីអានក្ដារតម្បៀតខ្ទាស់ឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로그램이 클립보드를 읽도록 허용하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du la et program lese utklippstavlen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolić programowi na odczyt schowka?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que um programa leia a área de transferência?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить программе читать буфер обмена?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้โปรแกรมอ่านคลิปบอร์ดหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir programın panoyu okumasına izin verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити програмі читати буфер обміну?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép một chương trình đọc bảng nhớ tạm?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许程序读取剪贴板吗?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許程式讀取剪貼簿嗎?"
          }
        }
      }
    },
    "clipboardRead.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program in “%1$@” on %2$@ asked for the clipboard contents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلب برنامج في “%1$@” على %2$@ محتويات الحافظة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program u “%1$@” na %2$@ zatražio je sadržaj međuspremnika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program i “%1$@” på %2$@ bad om indholdet af udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Programm in „%1$@“ auf %2$@ hat den Inhalt der Zwischenablage angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programa en “%1$@” en %2$@ pidió el contenido del portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programme dans « %1$@ » sur %2$@ a demandé le contenu du presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un programma in “%1$@” su %2$@ ha chiesto il contenuto degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の「%1$@」で実行中のプログラムがクリップボードの内容を要求しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីមួយក្នុង “%1$@” នៅលើ %2$@ បានស្នើសុំខ្លឹមសារក្ដារតម្បៀតខ្ទាស់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@의 “%1$@”에서 실행 중인 프로그램이 클립보드 내용을 요청했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et program i «%1$@» på %2$@ ba om innholdet i utklippstavlen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Program w „%1$@” na %2$@ poprosił o zawartość schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um programa em “%1$@” em %2$@ pediu o conteúdo da área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Программа в «%1$@» на %2$@ запросила содержимое буфера обмена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรแกรมใน “%1$@” บน %2$@ ขอเนื้อหาในคลิปบอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ üzerindeki “%1$@” içindeki bir program pano içeriğini istedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програма в «%1$@» на %2$@ запитала вміст буфера обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một chương trình trong “%1$@” trên %2$@ đã yêu cầu nội dung bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ 上“%1$@”中的程序请求读取剪贴板内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ 上「%1$@」中的程式要求讀取剪貼簿內容。"
          }
        }
      }
    },
