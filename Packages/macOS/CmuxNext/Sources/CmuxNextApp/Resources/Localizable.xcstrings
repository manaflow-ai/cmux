    "notifications.action.markRead": {
      "comment": "A notification banner's button: marks the tab's notification read without opening cmux.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعليم كمقروء"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi kao pročitano"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér som læst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gelesen markieren"
          }
        },
        "en": {
