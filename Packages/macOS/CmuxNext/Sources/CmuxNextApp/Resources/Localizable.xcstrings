        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện của tác nhân đã được chuyển sang bản dựng này nhưng thẻ của nó chưa mở. Hãy mở từ Trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理聊天已移到此版本，但其标签页尚未打开。请从“聊天”中打开。"
          }
