          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux è stato riavviato dopo un problema. Le finestre e i terminali sono stati ripristinati."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux បានចាប់ផ្ដើមឡើងវិញបន្ទាប់ពីមានបញ្ហា។ បង្អួច និងទែមីណាល់របស់អ្នកបានត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문제가 발생하여 cmux가 다시 시작되었습니다. 창과 터미널이 복원되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ble startet på nytt etter et problem. Vinduene og terminalene dine er tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux uruchomił się ponownie po problemie. Okna i terminale zostały przywrócone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux foi reiniciado após um problema. Suas janelas e terminais estão de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux перезапущен после сбоя. Окна и терминалы восстановлены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux เริ่มใหม่หลังจากเกิดปัญหา หน้าต่างและเทอร์มินัลของคุณกลับมาแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bir sorundan sonra yeniden başlatıldı. Pencereleriniz ve terminalleriniz geri geldi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux перезапущено після збою. Вікна й термінали відновлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux đã khởi động lại sau khi gặp sự cố. Cửa sổ và terminal của bạn đã được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 在出现问题后已重新启动。你的窗口和终端已恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 在發生問題後已重新啟動。你的視窗和終端機已恢復。"
          }
        }
      }
