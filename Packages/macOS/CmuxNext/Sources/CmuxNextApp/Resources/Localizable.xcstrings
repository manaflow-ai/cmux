          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema sesija koje se mogu premjestiti iz druge cmux verzije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen sessioner, der kan flyttes fra en anden cmux-build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
