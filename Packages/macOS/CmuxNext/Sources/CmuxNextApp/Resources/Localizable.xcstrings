    "app.restart.noticeSafe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux restarted after a problem again. Browser pages were not reopened. Reload a tab to open it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "問題が再び発生したため cmux を再起動しました。ブラウザのページは開き直していません。タブを再読み込みすると開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُعيد تشغيل cmux مرة أخرى بعد حدوث مشكلة. لم تُفتح صفحات المتصفح. أعد تحميل علامة تبويب لفتحها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux je ponovo pokrenut nakon još jednog problema. Stranice preglednika nisu ponovo otvorene. Ponovo učitajte karticu da biste je otvorili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux blev genstartet efter endnu et problem. Browsersider blev ikke genåbnet. Genindlæs en fane for at åbne den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux wurde erneut nach einem Problem neu gestartet. Browserseiten wurden nicht wieder geöffnet. Laden Sie einen Tab neu, um ihn zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux se ha vuelto a reiniciar tras un problema. Las páginas del navegador no se han vuelto a abrir. Vuelve a cargar una pestaña para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux a de nouveau redémarré après un problème. Les pages du navigateur n’ont pas été rouvertes. Actualisez un onglet pour l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux è stato riavviato di nuovo dopo un problema. Le pagine del browser non sono state riaperte. Ricarica una scheda per aprirla."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux បានចាប់ផ្ដើមឡើងវិញម្ដងទៀតបន្ទាប់ពីមានបញ្ហា។ ទំព័រកម្មវិធីរុករកមិនត្រូវបានបើកឡើងវិញទេ។ ផ្ទុកផ្ទាំងឡើងវិញដើម្បីបើកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문제가 다시 발생하여 cmux가 다시 시작되었습니다. 브라우저 페이지는 다시 열지 않았습니다. 탭을 새로고침하면 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ble startet på nytt etter enda et problem. Nettlesersider ble ikke åpnet igjen. Last inn en fane på nytt for å åpne den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ponownie uruchomił się po problemie. Strony przeglądarki nie zostały otwarte ponownie. Załaduj kartę ponownie, aby ją otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux foi reiniciado de novo após um problema. As páginas do navegador não foram reabertas. Recarregue uma aba para abri-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux снова перезапущен после сбоя. Страницы браузера не открыты повторно. Перезагрузите вкладку, чтобы открыть её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux เริ่มใหม่อีกครั้งหลังจากเกิดปัญหา ไม่ได้เปิดหน้าเบราว์เซอร์ใหม่ โหลดแท็บซ้ำเพื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bir sorundan sonra yeniden başlatıldı. Tarayıcı sayfaları yeniden açılmadı. Açmak için bir sekmeyi yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux знову перезапущено після збою. Сторінки браузера не відкрито повторно. Перезавантажте вкладку, щоб відкрити її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lại khởi động lại sau khi gặp sự cố. Các trang trình duyệt chưa được mở lại. Tải lại một thẻ để mở trang đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 再次在出现问题后重新启动。浏览器页面未重新打开。重新加载标签页即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 再次在發生問題後重新啟動。瀏覽器頁面未重新開啟。重新載入分頁即可開啟。"
          }
        }
      }
    },
