    "sessionTransfer.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not move sessions from the other cmux build."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر نقل الجلسات من إصدار cmux الآخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće premjestiti sesije iz druge cmux verzije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionerne kunne ikke flyttes fra den anden cmux-build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen konnten nicht aus dem anderen cmux-Build verschoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron mover las sesiones desde la otra compilación de cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déplacer les sessions depuis l’autre version de cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile spostare le sessioni dall’altra build di cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の cmux ビルドからセッションを移動できませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្លាស់ទីវគ្គពីកំណែ cmux ផ្សេងទៀតបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 cmux 빌드에서 세션을 이동할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke flytte økter fra den andre cmux-versjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przenieść sesji z innej kompilacji cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover as sessões da outra versão do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перенести сеансы из другой сборки cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายเซสชันจาก cmux รุ่นอื่นไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumlar diğer cmux sürümünden taşınamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перенести сеанси з іншої збірки cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuyển phiên từ bản dựng cmux khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从其他 cmux 版本移动会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從其他 cmux 版本移動工作階段。"
          }
        }
      }
    },
    "sessionTransfer.error.invalidSurfaces": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source build returned invalid session identifiers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد الإصدار المصدر معرّفات جلسات غير صالحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvorna verzija je vratila nevažeće identifikatore sesija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilde-buildet returnerede ugyldige sessions-id’er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Quell-Build hat ungültige Sitzungskennungen zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilación de origen devolvió identificadores de sesión no válidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version source a renvoyé des identifiants de session non valides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La build di origine ha restituito identificatori di sessione non validi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動元のビルドが無効なセッション識別子を返しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែប្រភពបានផ្ដល់លេខសម្គាល់វគ្គមិនត្រឹមត្រូវ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 빌드가 잘못된 세션 식별자를 반환했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kildeversjonen returnerte ugyldige økt-ID-er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilacja źródłowa zwróciła nieprawidłowe identyfikatory sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de origem retornou identificadores de sessão inválidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная сборка вернула недопустимые идентификаторы сеансов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux รุ่นต้นทางส่งรหัสเซสชันที่ไม่ถูกต้องกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak sürüm geçersiz oturum kimlikleri döndürdü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихідна збірка повернула недійсні ідентифікатори сеансів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng nguồn trả về mã định danh phiên không hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源版本返回了无效的会话标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源版本傳回了無效的工作階段識別碼。"
          }
        }
      }
    },
