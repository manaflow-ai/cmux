          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែករបស់ភ្នាក់ងារបានផ្លាស់ទីមកកំណែនេះ ប៉ុន្តែផ្ទាំងរបស់វាមិនទាន់បើកនៅឡើយ។ សូមបើកវាពីការជជែក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 채팅이 이 빌드로 옮겨졌지만 탭이 아직 열리지 않았습니다. 채팅에서 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentchatten ble flyttet til denne builden, men fanen er ikke åpnet ennå. Åpne den fra Chatter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat agenta został przeniesiony do tej wersji, ale jego karta jeszcze się nie otworzyła. Otwórz go z Czatów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat do agente foi movido para esta versão, mas a aba dele ainda não abriu. Abra-o em Chats."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат агента перенесён в эту сборку, но его вкладка ещё не открылась. Откройте его из «Чатов»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายแชตเอเจนต์มายังบิลด์นี้แล้ว แต่แท็บของแชตยังไม่เปิด เปิดได้จากแชต"
