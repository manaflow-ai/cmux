          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke flytte økter fra den andre cmux-versjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przenieść sesji z innej kompilacji cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
