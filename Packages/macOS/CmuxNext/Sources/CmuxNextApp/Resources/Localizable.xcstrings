    "classicImport.toast.sshScrollbackStays": {
      "comment": "Added to the Import Workspaces from Classic cmux toast when SSH terminals of classic cmux (the older app) had saved scrollback: they open on their host without it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH terminals open without their old scrollback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-Terminals öffnen sich ohne ihren bisherigen Verlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux SSH s’ouvrent sans leur ancien historique de défilement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح طرفيات SSH بدون سجل التمرير القديم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las terminales SSH se abren sin su historial de desplazamiento anterior."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 終端機開啟時不含先前的捲動記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 终端打开时不含之前的回滚记录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 터미널은 이전 스크롤백 없이 열립니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ターミナルは以前のスクロールバックなしで開きます。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH terminali se otvaraju bez svoje stare historije pomicanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-terminaler åbnes uden deres gamle rullehistorik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I terminali SSH si aprono senza la loro vecchia cronologia di scorrimento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ស្ថានីយ SSH បើកដោយគ្មានប្រវត្តិរំកិលចាស់របស់វា។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH-terminaler åpnes uten den gamle rullehistorikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminale SSH otwierają się bez dawnej historii przewijania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminais SSH abrem sem o histórico de rolagem antigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Терминалы SSH открываются без прежней истории прокрутки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัล SSH เปิดขึ้นโดยไม่มีประวัติการเลื่อนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SSH terminalleri eski kaydırma geçmişleri olmadan açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Термінали SSH відкриваються без попередньої історії прокручування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các terminal SSH mở ra mà không có lịch sử cuộn cũ."
          }
        }
      }
    },
    "classicImport.toast.tabsStay": {
      "comment": "Added to the Import Workspaces from Classic cmux toast when classic cmux (the older app) had markdown viewer or file preview tabs, which cmux-next does not open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown and file preview tabs stay in classic cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown- und Dateivorschau-Tabs bleiben im klassischen cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets Markdown et d’aperçu de fichier restent dans cmux classique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى علامات تبويب Markdown ومعاينة الملفات في cmux الكلاسيكي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas de Markdown y de vista previa de archivos se quedan en cmux clásico."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 與檔案預覽分頁會留在經典版 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 和文件预览标签页会留在经典版 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 및 파일 미리 보기 탭은 클래식 cmux에 남습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown とファイルプレビューのタブはクラシック版 cmux に残ります。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kartice za Markdown i pregled datoteka ostaju u klasičnom cmux-u."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner med Markdown og filvisning bliver i klassisk cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le schede Markdown e di anteprima dei file restano in cmux classico."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំង Markdown និងផ្ទាំងមើលឯកសារជាមុន នៅតែក្នុង cmux បុរាណ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faner for Markdown og forhåndsvisning av filer blir værende i klassisk cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Karty Markdown i podglądu plików pozostają w klasycznym cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abas de Markdown e de pré-visualização de arquivos ficam no cmux clássico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки Markdown и предпросмотра файлов остаются в классическом cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บ Markdown และแท็บแสดงตัวอย่างไฟล์ยังคงอยู่ใน cmux แบบคลาสสิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Markdown ve dosya önizleme sekmeleri klasik cmux'ta kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вкладки Markdown і попереднього перегляду файлів залишаються в класичному cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tab Markdown và xem trước tệp vẫn ở lại trong cmux cổ điển."
          }
        }
      }
    },
