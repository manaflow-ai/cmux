    "sessionTransfer.error.peerRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other cmux build only accepts connections from its own terminals. Set its socket control mode to Automation, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل إصدار cmux الآخر الاتصالات من طرفياته فقط. اضبط وضع التحكم في المقبس على Automation، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druga cmux verzija prihvata veze samo iz vlastitih terminala. Postavite njen način kontrole utičnice na Automation i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anden cmux-build accepterer kun forbindelser fra sine egne terminaler. Sæt dens socketkontroltilstand til Automation, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der andere cmux-Build akzeptiert nur Verbindungen aus seinen eigenen Terminals. Stelle seinen Socket-Steuerungsmodus auf Automation und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra compilación de cmux solo acepta conexiones de sus propios terminales. Cambia su modo de control del socket a Automation e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre version de cmux n’accepte que les connexions de ses propres terminaux. Réglez son mode de contrôle du socket sur Automation, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altra build di cmux accetta solo connessioni dai propri terminali. Imposta la modalità di controllo del socket su Automation, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の cmux ビルドは自身のターミナルからの接続のみ受け付けます。ソケット制御モードを Automation に設定してから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែ cmux ផ្សេងទៀតទទួលយកតែការតភ្ជាប់ពីស្ថានីយរបស់វាប៉ុណ្ណោះ។ កំណត់របៀបគ្រប់គ្រងរន្ធរបស់វាទៅ Automation រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 cmux 빌드는 자체 터미널의 연결만 허용합니다. 소켓 제어 모드를 Automation으로 설정한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andre cmux-versjonen godtar bare tilkoblinger fra sine egne terminaler. Sett socketkontrollmodusen til Automation, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druga kompilacja cmux akceptuje tylko połączenia z własnych terminali. Ustaw jej tryb sterowania gniazdem na Automation i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A outra versão do cmux só aceita conexões dos próprios terminais. Defina o modo de controle de soquete como Automation e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая сборка cmux принимает подключения только из собственных терминалов. Установите для неё режим управления сокетом Automation и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux รุ่นอื่นยอมรับการเชื่อมต่อจากเทอร์มินัลของตัวเองเท่านั้น ตั้งโหมดควบคุมซ็อกเก็ตเป็น Automation แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cmux sürümü yalnızca kendi terminallerinden gelen bağlantıları kabul eder. Soket denetim modunu Automation olarak ayarlayıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша збірка cmux приймає з’єднання лише з власних терміналів. Установіть для неї режим керування сокетом Automation і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng cmux khác chỉ chấp nhận kết nối từ các terminal của chính nó. Đặt chế độ điều khiển socket thành Automation rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 cmux 版本只接受来自其自身终端的连接。请将其套接字控制模式设为 Automation，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 cmux 版本只接受來自其自身終端機的連線。請將其通訊端控制模式設為 Automation，然後再試一次。"
          }
        }
      }
    },
    "sessionTransfer.error.sourceAgentsStopped": {
      "comment": "session.transfer.pull of an agent chat: the source cmux build's agent service (acpmux) does not answer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other build's agent service is not running. Open that build's chat once, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الوكلاء في الإصدار الآخر لا تعمل. افتح محادثة ذلك الإصدار مرة واحدة، ثم حاول مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Servis agenata druge verzije nije pokrenut. Jednom otvorite chat te verzije, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anden builds agenttjeneste kører ikke. Åbn den builds chat én gang, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent-Dienst des anderen Builds läuft nicht. Öffne den Chat dieses Builds einmal und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de agentes de la otra compilación no se está ejecutando. Abre una vez el chat de esa compilación y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’agents de l’autre build n’est pas lancé. Ouvrez une fois la discussion de ce build, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio agenti dell’altra build non è in esecuzione. Apri una volta la chat di quella build, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のビルドのエージェントサービスが動いていません。そのビルドのチャットを一度開いてから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេវាភ្នាក់ងាររបស់កំណែផ្សេងមិនកំពុងដំណើរការទេ។ សូមបើកការជជែករបស់កំណែនោះម្តង រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 빌드의 에이전트 서비스가 실행 중이 아닙니다. 그 빌드의 채팅을 한 번 연 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenttjenesten i den andre builden kjører ikke. Åpne chatten i den builden én gang, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa agentów drugiej wersji nie działa. Otwórz raz czat tamtej wersji i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de agentes da outra versão não está em execução. Abra o chat dessa versão uma vez e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба агентов другой сборки не запущена. Откройте один раз чат той сборки и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการเอเจนต์ของบิลด์อื่นไม่ได้ทำงาน เปิดแชตของบิลด์นั้นหนึ่งครั้ง แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer derlemenin ajan hizmeti çalışmıyor. O derlemenin sohbetini bir kez açın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба агентів іншої збірки не запущена. Відкрийте один раз чат тієї збірки й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ tác nhân của bản dựng kia không chạy. Hãy mở cuộc trò chuyện của bản dựng đó một lần rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个版本的代理服务未运行。请先在该版本中打开一次聊天，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個版本的代理服務未執行。請先在該版本中開啟一次聊天，然後再試一次。"
          }
        }
      }
    },
    "sessionTransfer.error.agentNotOpened": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent chat did not open in cmux-next, so the source was left as it was."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُفتح محادثة الوكيل في cmux-next، لذا تُرك المصدر كما هو."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent chat se nije otvorio u cmux-next, pa je izvor ostao nepromijenjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentchatten blev ikke åbnet i cmux-next, så kilden blev ikke ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent-Chat wurde in cmux-next nicht geöffnet, daher blieb die Quelle unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat del agente no se abrió en cmux-next, así que el origen se dejó como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discussion d’agent ne s’est pas ouverte dans cmux-next ; la source est donc restée inchangée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat dell’agente non si è aperta in cmux-next, quindi l’origine è rimasta invariata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントチャットが cmux-next で開かなかったため、移動元はそのままにしました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែករបស់ភ្នាក់ងារមិនបានបើកក្នុង cmux-next ទេ ដូច្នេះប្រភពត្រូវបានទុកដដែល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 채팅이 cmux-next에서 열리지 않아 원본을 그대로 두었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentchatten ble ikke åpnet i cmux-next, så kilden ble ikke endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat agenta nie otworzył się w cmux-next, więc źródło pozostało bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat do agente não abriu no cmux-next, então a origem ficou como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат агента не открылся в cmux-next, поэтому источник оставлен без изменений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตเอเจนต์ไม่ได้เปิดใน cmux-next จึงปล่อยต้นทางไว้ตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan sohbeti cmux-next’te açılmadı, bu yüzden kaynak olduğu gibi bırakıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат агента не відкрився в cmux-next, тому джерело залишено без змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện của tác nhân không mở trong cmux-next nên nguồn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体聊天未在 cmux-next 中打开，因此来源保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式聊天未在 cmux-next 中開啟，因此來源保持不變。"
          }
        }
      }
    },
    "sessionTransfer.error.chatFolderMissing": {
      "comment": "session.transfer.pull of an agent chat failed because the chat's folder does not exist on this Mac; the chat stays in the other build. %@ is the folder path.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل هذه الدردشة في %@، وهو غير موجود على هذا الـ Mac، لذا بقيت في الإصدار الآخر. أنشئ هذا المجلد هنا، ثم انقل الدردشة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj chat radi u %@, koji nije na ovom Macu, pa je ostao u drugoj verziji. Napravite tu mapu ovdje, pa ponovo premjestite chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chat arbejder i %@, som ikke findes på denne Mac, så den blev i den anden build. Opret mappen her, og flyt derefter chatten igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat arbeitet in %@; diesen Ordner gibt es auf diesem Mac nicht, daher ist der Chat im anderen Build geblieben. Lege den Ordner hier an und verschiebe den Chat dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat works in %@, which isn't on this Mac, so it stayed in the other build. Create that folder here, then move the chat again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat trabaja en %@, que no está en este Mac, así que se quedó en la otra compilación. Crea esa carpeta aquí y vuelve a mover el chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion travaille dans %@, qui n’existe pas sur ce Mac ; elle est donc restée dans l’autre build. Créez ce dossier ici, puis déplacez à nouveau la discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chat lavora in %@, che non è su questo Mac, quindi è rimasta nell'altra build. Crea quella cartella qui, poi sposta di nuovo la chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットの作業フォルダ %@ はこのMacにないため、チャットはもう一方のビルドに残りました。ここにそのフォルダを作成してから、もう一度チャットを移動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកនេះធ្វើការនៅក្នុង %@ ដែលមិនមាននៅលើ Mac នេះទេ ដូច្នេះវានៅតែក្នុងកំណែផ្សេងទៀត។ បង្កើតថតនោះនៅទីនេះ រួចផ្លាស់ទីការជជែកម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅은 %@에서 작업하는데, 이 폴더가 이 Mac에 없어 채팅이 다른 빌드에 남아 있습니다. 여기에 해당 폴더를 만든 다음 채팅을 다시 이동하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chatten jobber i %@, som ikke finnes på denne Macen, så den ble værende i den andre builden. Opprett mappen her, og flytt chatten på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten czat działa w %@, którego nie ma na tym Macu, więc pozostał w drugiej wersji. Utwórz tutaj ten folder, a potem przenieś czat ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat trabalha em %@, que não está neste Mac, então ele ficou na outra versão. Crie essa pasta aqui e mova o chat novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат работает в %@, а этой папки нет на этом Mac, поэтому чат остался в другой сборке. Создайте эту папку здесь, затем снова перенесите чат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชทนี้ทำงานใน %@ ซึ่งไม่มีอยู่บน Mac เครื่องนี้ แชทจึงยังอยู่ในบิลด์อื่น สร้างโฟลเดอร์นั้นที่นี่ แล้วย้ายแชทอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet %@ içinde çalışıyor ve bu klasör bu Mac’te yok, bu yüzden sohbet diğer derlemede kaldı. Klasörü burada oluşturun, ardından sohbeti yeniden taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чат працює в %@, а цієї теки немає на цьому Mac, тож чат лишився в іншій збірці. Створіть цю теку тут, а потім знову перенесіть чат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này làm việc trong %@, thư mục không có trên máy Mac này, nên nó vẫn ở bản dựng kia. Hãy tạo thư mục đó ở đây rồi chuyển cuộc trò chuyện lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天在 %@ 中工作，而这台 Mac 上没有该文件夹，因此聊天仍留在另一个版本中。请在这里创建该文件夹，然后再次移动聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天在 %@ 中工作，而這台 Mac 上沒有該資料夾，因此聊天仍留在另一個版本中。請在這裡建立該資料夾，然後再次移動聊天。"
          }
        }
      }
    },
    "sessionTransfer.error.chatInChats": {
      "comment": "session.transfer.pull: the agent chat is in this build's agent service (or still moving there) but no tab opened. Chats is the sidebar's chat list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent chat moved to this build but its tab did not open yet. Open it from Chats."
