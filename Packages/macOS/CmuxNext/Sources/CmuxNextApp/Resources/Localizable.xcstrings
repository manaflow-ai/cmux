    "browser.engine.unavailable.restoredTab": {
      "comment": "A browser tab's notice when Chromium could not start in this process: the page is not loaded in WebKit (no Chromium cookies there); a restart of cmux is needed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium unavailable: this tab isn’t loaded, because WebKit would open it signed out. Quit and reopen cmux to load it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium غير متاح: لم تُحمَّل علامة التبويب هذه لأن WebKit سيفتحها بدون تسجيل الدخول. أغلق cmux وأعد فتحه لتحميلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium nije dostupan: ova kartica nije učitana jer bi je WebKit otvorio odjavljenu. Zatvorite i ponovo otvorite cmux da je učitate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium er ikke tilgængelig: fanen er ikke indlæst, fordi WebKit ville åbne den logget ud. Afslut og åbn cmux igen for at indlæse den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium nicht verfügbar: Dieser Tab wird nicht geladen, weil WebKit ihn abgemeldet öffnen würde. Beende cmux und öffne es erneut, um ihn zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium no está disponible: esta pestaña no se carga porque WebKit la abriría sin sesión. Sal de cmux y vuelve a abrirlo para cargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium indisponible : cet onglet n’est pas chargé, car WebKit l’ouvrirait déconnecté. Quittez puis rouvrez cmux pour le charger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium non disponibile: questa scheda non viene caricata perché WebKit la aprirebbe senza accesso. Esci e riapri cmux per caricarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium を使用できません。WebKit ではサインアウトした状態で開くため、このタブは読み込んでいません。読み込むには cmux を終了して開き直してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium មិនអាចប្រើបាន៖ ផ្ទាំងនេះមិនត្រូវបានផ្ទុកទេ ព្រោះ WebKit នឹងបើកវាដោយមិនបានចូល។ ចាកចេញ ហើយបើក cmux ម្តងទៀត ដើម្បីផ្ទុកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium을 사용할 수 없음: WebKit에서는 로그아웃된 상태로 열리므로 이 탭을 불러오지 않았습니다. 불러오려면 cmux를 종료한 후 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium er ikke tilgjengelig: fanen er ikke lastet inn, fordi WebKit ville åpnet den utlogget. Avslutt og åpne cmux igjen for å laste den inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium jest niedostępny: ta karta nie została załadowana, bo WebKit otworzyłby ją bez logowania. Zamknij i ponownie otwórz cmux, aby ją załadować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium indisponível: esta aba não foi carregada porque o WebKit a abriria sem login. Saia e abra o cmux de novo para carregá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium недоступен: вкладка не загружена, потому что WebKit открыл бы её без входа. Закройте и снова откройте cmux, чтобы загрузить её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ Chromium ไม่ได้: ไม่ได้โหลดแท็บนี้ เพราะ WebKit จะเปิดโดยไม่ได้ลงชื่อเข้าใช้ ออกจาก cmux แล้วเปิดใหม่เพื่อโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium kullanılamıyor: WebKit oturum kapalı açacağı için bu sekme yüklenmedi. Yüklemek için cmux'tan çıkıp yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium недоступний: вкладку не завантажено, бо WebKit відкрив би її без входу. Закрийте й знову відкрийте cmux, щоб завантажити її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium không khả dụng: tab này chưa được tải vì WebKit sẽ mở nó khi chưa đăng nhập. Thoát và mở lại cmux để tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium 不可用：此标签页未加载，因为 WebKit 会以未登录状态打开它。退出并重新打开 cmux 以加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium 無法使用：此分頁未載入，因為 WebKit 會以未登入狀態開啟它。結束並重新開啟 cmux 以載入。"
          }
        }
      }
    },
    "app.restart.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux restarted after a problem. Your windows and terminals are back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "問題が発生したため cmux を再起動しました。ウインドウとターミナルは元に戻っています。"
          }
