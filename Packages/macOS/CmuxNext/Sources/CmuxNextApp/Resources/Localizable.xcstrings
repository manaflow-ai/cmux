            "state": "translated",
            "value": "ការផ្ទេរវគ្គមិនអាចប្រើបានទេ ខណៈពេល cmux កំពុងចាប់ផ្ដើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 시작되는 동안에는 세션을 이동할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytting av økter er ikke tilgjengelig mens cmux starter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoszenie sesji jest niedostępne podczas uruchamiania cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência de sessões não está disponível enquanto o cmux inicia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос сеансов недоступен во время запуска cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายเซสชันไม่ได้ขณะที่ cmux กำลังเริ่มทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux başlatılırken oturum aktarımı kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесення сеансів недоступне під час запуску cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuyển phiên khi cmux đang khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 启动期间无法移动会话。"
          }
        },
