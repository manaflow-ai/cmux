    "sessionTransfer.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session transfer is unavailable while cmux is starting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
