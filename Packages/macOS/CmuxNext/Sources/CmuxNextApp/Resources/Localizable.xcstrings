        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux បានចាប់ផ្ដើមឡើងវិញបន្ទាប់ពីមានបញ្ហា។ បង្អួច និងទែមីណាល់របស់អ្នកបានត្រឡប់មកវិញ។"
