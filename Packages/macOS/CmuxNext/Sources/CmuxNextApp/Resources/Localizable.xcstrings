    "sessionTransfer.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not move sessions from the other cmux build."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر نقل الجلسات من إصدار cmux الآخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće premjestiti sesije iz druge cmux verzije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionerne kunne ikke flyttes fra den anden cmux-build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen konnten nicht aus dem anderen cmux-Build verschoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron mover las sesiones desde la otra compilación de cmux."
          }
        },
