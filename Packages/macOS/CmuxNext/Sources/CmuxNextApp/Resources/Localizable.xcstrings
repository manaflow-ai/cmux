    "app.restart.crashedPage": {
      "comment": "On a restored browser tab after cmux quit unexpectedly twice in a row while that tab's page was loading: the page waits until the person reloads it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux quit unexpectedly twice while this page was loading, so it was not loaded again. Reload to open it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページの読み込み中に cmux が 2 回続けて予期せず終了したため、再度読み込んでいません。再読み込みすると開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقف cmux بشكل غير متوقع مرتين أثناء تحميل هذه الصفحة، لذا لم يُعَد تحميلها. أعد التحميل لفتحها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux se dvaput neočekivano zatvorio dok se ova stranica učitavala, pa nije ponovo učitana. Ponovo učitajte da je otvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux lukkede uventet to gange, mens siden indlæste, så den blev ikke indlæst igen. Genindlæs for at åbne den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux wurde zweimal unerwartet beendet, während diese Seite lud, daher wurde sie nicht erneut geladen. Neu laden, um sie zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux se cerró inesperadamente dos veces mientras se cargaba esta página, así que no se volvió a cargar. Vuelve a cargar para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux a quitté de manière inattendue deux fois pendant le chargement de cette page ; elle n'a donc pas été rechargée. Actualisez pour l'ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux si è chiuso inaspettatamente due volte mentre questa pagina si caricava, quindi non è stata ricaricata. Ricarica per aprirla."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux បានបិទដោយមិននឹកស្មានដល់ពីរដង ខណៈទំព័រនេះកំពុងផ្ទុក ដូច្នេះវាមិនត្រូវបានផ្ទុកម្ដងទៀតទេ។ ផ្ទុកឡើងវិញដើម្បីបើកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 페이지를 불러오는 동안 cmux가 두 번 예기치 않게 종료되어 다시 불러오지 않았습니다. 새로고침하면 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux avsluttet uventet to ganger mens denne siden lastet, så den ble ikke lastet inn igjen. Last inn på nytt for å åpne den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux dwukrotnie nieoczekiwanie się zamknął podczas ładowania tej strony, więc nie załadowano jej ponownie. Załaduj ponownie, aby ją otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux fechou inesperadamente duas vezes enquanto esta página carregava, então ela não foi carregada de novo. Recarregue para abri-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux дважды неожиданно завершился во время загрузки этой страницы, поэтому она не загружена снова. Перезагрузите, чтобы открыть её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ปิดโดยไม่คาดคิดสองครั้งขณะโหลดหน้านี้ จึงไม่ได้โหลดอีก โหลดซ้ำเพื่อเปิดหน้านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sayfa yüklenirken cmux iki kez beklenmedik şekilde kapandı, bu yüzden yeniden yüklenmedi. Açmak için yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux двічі неочікувано завершився під час завантаження цієї сторінки, тому її не завантажено знову. Перезавантажте, щоб відкрити її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux đã thoát bất ngờ hai lần khi trang này đang tải, nên trang không được tải lại. Tải lại để mở trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此页面加载时 cmux 两次意外退出，因此未再次加载。重新加载即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此頁面載入時 cmux 兩次意外結束，因此未再次載入。重新載入即可開啟。"
          }
        }
      }
    },
