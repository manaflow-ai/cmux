    "browser.engine.fallback.downloading": {
      "comment": "The one-time notice on a browser tab that opened in WebKit because the Chromium engine is still downloading (the app downloads Chromium on first use).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم تنزيل Chromium، لذا تستخدم علامة التبويب هذه WebKit. ستستخدم علامات التبويب الجديدة Chromium عندما يصبح جاهزًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium se preuzima, pa ova kartica koristi WebKit. Nove kartice koriste Chromium kada bude spreman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium hentes, så fanen bruger WebKit. Nye faner bruger Chromium, når det er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium wird geladen, daher nutzt dieser Tab WebKit. Neue Tabs nutzen Chromium, sobald es bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium is downloading, so this tab uses WebKit. New tabs use Chromium when it’s ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium se está descargando, así que esta pestaña usa WebKit. Las pestañas nuevas usarán Chromium cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium est en cours de téléchargement, cet onglet utilise donc WebKit. Les nouveaux onglets utiliseront Chromium dès qu’il sera prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium è in download, quindi questa scheda usa WebKit. Le nuove schede useranno Chromium quando sarà pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium をダウンロード中のため、このタブは WebKit を使用します。準備ができると新しいタブで Chromium を使用します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium កំពុងទាញយក ដូច្នេះផ្ទាំងនេះប្រើ WebKit។ ផ្ទាំងថ្មីនឹងប្រើ Chromium នៅពេលវារួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium을 다운로드하는 중이어서 이 탭은 WebKit을 사용합니다. 준비되면 새 탭은 Chromium을 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium lastes ned, så denne fanen bruker WebKit. Nye faner bruker Chromium når det er klart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium jest pobierany, więc ta karta używa WebKit. Nowe karty użyją Chromium, gdy będzie gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chromium está sendo baixado, então esta aba usa o WebKit. Novas abas usarão o Chromium quando ele estiver pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium загружается, поэтому эта вкладка использует WebKit. Новые вкладки будут использовать Chromium, когда он будет готов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังดาวน์โหลด Chromium แท็บนี้จึงใช้ WebKit แท็บใหม่จะใช้ Chromium เมื่อพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium indiriliyor, bu yüzden bu sekme WebKit kullanıyor. Hazır olduğunda yeni sekmeler Chromium kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium завантажується, тому ця вкладка використовує WebKit. Нові вкладки використовуватимуть Chromium, коли він буде готовий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium đang được tải xuống nên tab này dùng WebKit. Các tab mới sẽ dùng Chromium khi sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在下载 Chromium，因此此标签页使用 WebKit。准备就绪后，新标签页将使用 Chromium。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在下載 Chromium，因此此分頁使用 WebKit。準備就緒後，新分頁將使用 Chromium。"
          }
        }
      }
    },
    "browser.engine.fallback.downloadFailed": {
      "comment": "The one-time notice on a browser tab that opened in WebKit because the Chromium download failed; the app tries the download again by itself.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر تنزيل Chromium حتى الآن، لذا تستخدم علامة التبويب هذه WebKit. سيحاول cmux مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium se još nije mogao preuzeti, pa ova kartica koristi WebKit. cmux će pokušati ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium kunne ikke hentes endnu, så fanen bruger WebKit. cmux prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium konnte noch nicht geladen werden, daher nutzt dieser Tab WebKit. cmux versucht es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium couldn’t download yet, so this tab uses WebKit. cmux will try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium aún no se pudo descargar, así que esta pestaña usa WebKit. cmux lo volverá a intentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium n’a pas encore pu être téléchargé, cet onglet utilise donc WebKit. cmux va réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato ancora possibile scaricare Chromium, quindi questa scheda usa WebKit. cmux riproverà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium をまだダウンロードできないため、このタブは WebKit を使用します。cmux が再試行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនទាន់អាចទាញយក Chromium បានទេ ដូច្នេះផ្ទាំងនេះប្រើ WebKit។ cmux នឹងព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 Chromium을 다운로드하지 못해 이 탭은 WebKit을 사용합니다. cmux가 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium kunne ikke lastes ned ennå, så denne fanen bruker WebKit. cmux prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się jeszcze pobrać Chromium, więc ta karta używa WebKit. cmux spróbuje ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não foi possível baixar o Chromium, então esta aba usa o WebKit. O cmux tentará de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium пока не удалось загрузить, поэтому эта вкладка использует WebKit. cmux попробует снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังดาวน์โหลด Chromium ไม่ได้ แท็บนี้จึงใช้ WebKit cmux จะลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium henüz indirilemedi, bu yüzden bu sekme WebKit kullanıyor. cmux yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium поки не вдалося завантажити, тому ця вкладка використовує WebKit. cmux спробує ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chưa tải xuống được Chromium nên tab này dùng WebKit. cmux sẽ thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暂时无法下载 Chromium，因此此标签页使用 WebKit。cmux 将重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暫時無法下載 Chromium，因此此分頁使用 WebKit。cmux 將重試。"
          }
        }
      }
    },
