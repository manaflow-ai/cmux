    "home.stopAll.chiefOnly": {
      "comment": "Toast after Stop All Agents when the Chief's turn stopped and no subagent was running.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف الـ Chief؛ لم يكن أي وكيل فرعي قيد التشغيل"
          }
