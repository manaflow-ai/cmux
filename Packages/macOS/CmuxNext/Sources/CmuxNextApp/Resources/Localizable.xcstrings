            "value": "%@ hace una pregunta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pose une question"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fa una domanda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からの質問があります"
          }
        },
        "km": {
          "stringUnit": {
