    "feed.bridge.question.untitled": {
      "comment": "A phone feed title for a question an agent asks the person when the question has no text (never a permission). %@ is the agent's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks a question"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يطرح سؤالًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ postavlja pitanje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stiller et spørgsmål"
          }
        },
        "de": {
          "stringUnit": {
