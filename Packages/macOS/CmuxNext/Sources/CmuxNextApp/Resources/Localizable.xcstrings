          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Premještanje sesija nije dostupno dok se cmux pokreće."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytning af sessioner er ikke tilgængelig, mens cmux starter."
          }
        },
        "de": {
