          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak sesji do przeniesienia z innej kompilacji cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há sessões disponíveis para mover de outra versão do cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сеансов, которые можно перенести из другой сборки cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเซสชันที่ย้ายได้จาก cmux รุ่นอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cmux sürümünden taşınabilecek oturum yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає сеансів, які можна перенести з іншої збірки cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có phiên nào để chuyển từ bản dựng cmux khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
