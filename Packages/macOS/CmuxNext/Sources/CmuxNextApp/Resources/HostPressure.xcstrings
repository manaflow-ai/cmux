    "hostPressure.stop.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its agent stops now. The chat stays, and a new message resumes it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف وكيلها الآن. تبقى المحادثة، وتستأنفها رسالة جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Agent stoppt sofort. Der Chat bleibt erhalten, und eine neue Nachricht setzt ihn fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su agente se detiene ahora. El chat se conserva y un mensaje nuevo lo reanuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son agent s’arrête maintenant. La conversation est conservée et un nouveau message la reprend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはすぐに停止します。チャットは残り、新しいメッセージで再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 지금 중지됩니다. 채팅은 남아 있으며 새 메시지를 보내면 다시 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其代理会立即停止。聊天会保留，发送新消息即可继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其代理程式會立即停止。對話會保留，傳送新訊息即可繼續。"
          }
        }
      }
    },
    "hostPressure.stop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop %@?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف %@؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stoppen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Detener %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter %@ ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を停止しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 중지할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止 %@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止 %@ 嗎？"
          }
        }
      }
    },
    "hostPressure.title.critical": {
      "extractionState": "manual",
      "localizations": {
