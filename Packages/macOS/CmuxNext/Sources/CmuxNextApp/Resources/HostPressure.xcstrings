    "hostPressure.warnOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux only warns. Nothing is paused or stopped."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتفي cmux بالتحذير. لا يُوقَف أي شيء مؤقتًا أو نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux warnt nur. Nichts wird pausiert oder gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux solo avisa. No se pausa ni se detiene nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne fait qu’avertir. Rien n’est mis en pause ni arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は警告するだけです。一時停止や停止は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 경고만 합니다. 아무것도 일시 정지하거나 중지하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 只会提醒，不会暂停或停止任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 只會提醒，不會暫停或停止任何項目。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux samo upozorava. Ništa se ne pauzira niti zaustavlja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux advarer kun. Intet sættes på pause eller stoppes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux si limita ad avvisare. Nulla viene messo in pausa o fermato."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux គ្រាន់តែព្រមាន។ គ្មានអ្វីត្រូវបានផ្អាក ឬបញ្ឈប់ទេ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux bare advarer. Ingenting settes på pause eller stoppes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux tylko ostrzega. Nic nie jest wstrzymywane ani zatrzymywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux apenas avisa. Nada é pausado nem interrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux только предупреждает. Ничего не приостанавливается и не останавливается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux แค่เตือนเท่านั้น ไม่มีการหยุดชั่วคราวหรือหยุดสิ่งใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux yalnızca uyarır. Hiçbir şey duraklatılmaz veya durdurulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux лише попереджає. Нічого не призупиняється й не зупиняється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux chỉ cảnh báo. Không có gì bị tạm dừng hay dừng lại."
          }
        }
      }
    }
  },
  "version": "1.0"
}
