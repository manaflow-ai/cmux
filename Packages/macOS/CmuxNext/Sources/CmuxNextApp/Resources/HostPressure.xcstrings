    "hostPressure.stop.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its agent stops now. The chat stays, and a new message resumes it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف وكيلها الآن. تبقى المحادثة، وتستأنفها رسالة جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Agent stoppt sofort. Der Chat bleibt erhalten, und eine neue Nachricht setzt ihn fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su agente se detiene ahora. El chat se conserva y un mensaje nuevo lo reanuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son agent s’arrête maintenant. La conversation est conservée et un nouveau message la reprend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはすぐに停止します。チャットは残り、新しいメッセージで再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 지금 중지됩니다. 채팅은 남아 있으며 새 메시지를 보내면 다시 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其代理会立即停止。聊天会保留，发送新消息即可继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其代理程式會立即停止。對話會保留，傳送新訊息即可繼續。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegov agent se odmah zaustavlja. Razgovor ostaje, a nova poruka ga nastavlja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens agent stopper nu. Chatten bliver, og en ny besked genoptager den."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo agente si ferma ora. La chat resta e un nuovo messaggio la riprende."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងាររបស់វាឈប់ឥឡូវនេះ។ ការជជែកនៅដដែល ហើយសារថ្មីនឹងបន្តវា។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten stopper nå. Chatten blir værende, og en ny melding gjenopptar den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego agent zatrzymuje się teraz. Czat zostaje, a nowa wiadomość go wznawia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente para agora. O chat continua, e uma nova mensagem o retoma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его агент сейчас остановится. Чат сохранится, и новое сообщение возобновит его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์จะหยุดทันที แชตยังคงอยู่ และข้อความใหม่จะทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanı şimdi durur. Sohbet kalır ve yeni bir mesaj onu sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його агент зупиниться зараз. Чат залишиться, і нове повідомлення його відновить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử của phiên sẽ dừng ngay. Cuộc trò chuyện vẫn còn và một tin nhắn mới sẽ tiếp tục nó."
          }
        }
      }
    },
