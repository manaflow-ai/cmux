    "hostPressure.warnOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux only warns. Nothing is paused or stopped."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتفي cmux بالتحذير. لا يُوقَف أي شيء مؤقتًا أو نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux warnt nur. Nichts wird pausiert oder gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux solo avisa. No se pausa ni se detiene nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne fait qu’avertir. Rien n’est mis en pause ni arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は警告するだけです。一時停止や停止は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 경고만 합니다. 아무것도 일시 정지하거나 중지하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 只会提醒，不会暂停或停止任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 只會提醒，不會暫停或停止任何項目。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
