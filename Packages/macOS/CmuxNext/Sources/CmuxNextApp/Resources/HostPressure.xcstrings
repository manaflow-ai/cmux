{
  "sourceLanguage": "en",
  "strings": {
    "hostPressure.load": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load %1$@, limit %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحمل %1$@، والحد %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Last %1$@, Grenze %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga %1$@, límite %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge %1$@, limite %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷 %1$@（上限 %2$@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부하 %1$@, 한도 %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载 %1$@，上限 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "負載 %1$@，上限 %2$@"
          }
        }
      }
    },
