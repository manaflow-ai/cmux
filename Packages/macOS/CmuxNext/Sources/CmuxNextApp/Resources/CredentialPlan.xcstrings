{
  "sourceLanguage": "en",
  "strings": {
    "cloud.credentials.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass --confirm to view credential setup steps for this machine. No credentials are transferred."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンの認証情報の設定手順を表示するには --confirm を指定してください。認証情報は転送されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib --confirm an, um die Einrichtungsschritte für Anmeldedaten auf diesem Computer anzuzeigen. Es werden keine Anmeldedaten übertragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez --confirm pour afficher les étapes de configuration des identifiants sur cette machine. Aucun identifiant ne sera transféré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa --confirm para ver los pasos de configuración de credenciales en esta máquina. No se transferirá ninguna credencial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر --confirm لعرض خطوات إعداد بيانات الاعتماد لهذا الجهاز. لن يتم نقل أي بيانات اعتماد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传入 --confirm 以查看此机器的凭据设置步骤。不会传输任何凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳入 --confirm 以檢視此機器的憑證設定步驟。不會傳輸任何憑證。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신의 자격 증명 설정 단계를 보려면 --confirm을 전달하세요. 자격 증명은 전송되지 않습니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
