          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更されたショートカットはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានផ្លូវកាត់ត្រូវបានផ្លាស់ប្ដូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경된 단축키가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen snarveier endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie zmieniono żadnych skrótów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum atalho alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сочетания клавиш не изменены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีการเปลี่ยนแปลงทางลัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiçbir kısayol değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жодне сполучення клавіш не змінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có phím tắt nào thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未更改任何快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未變更任何快速鍵。"
          }
        }
      }
    },
