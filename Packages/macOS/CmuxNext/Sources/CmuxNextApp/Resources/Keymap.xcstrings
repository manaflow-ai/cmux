{
  "sourceLanguage": "en",
  "strings": {
    "keymap.required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وسيطة keymap مطلوبة (cmux أو iterm2 أو terminal أو tmux)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "potreban je argument keymap (cmux, iterm2, terminal ili tmux)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "et keymap-argument (cmux, iterm2, terminal eller tmux) er påkrævet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein keymap-Argument (cmux, iterm2, terminal oder tmux) ist erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a keymap argument (cmux, iterm2, terminal or tmux) is required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se requiere un argumento keymap (cmux, iterm2, terminal o tmux)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "un argument keymap (cmux, iterm2, terminal ou tmux) est requis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "è richiesto un argomento keymap (cmux, iterm2, terminal o tmux)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "keymap 引数（cmux、iterm2、terminal、tmux）が必要です"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រូវការអាគុយម៉ង់ keymap (cmux, iterm2, terminal ឬ tmux)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "keymap 인수(cmux, iterm2, terminal 또는 tmux)가 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "et keymap-argument (cmux, iterm2, terminal eller tmux) er påkrevd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wymagany jest argument keymap (cmux, iterm2, terminal lub tmux)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "é necessário um argumento keymap (cmux, iterm2, terminal ou tmux)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "требуется аргумент keymap (cmux, iterm2, terminal или tmux)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ต้องระบุอาร์กิวเมนต์ keymap (cmux, iterm2, terminal หรือ tmux)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bir keymap bağımsız değişkeni (cmux, iterm2, terminal veya tmux) gerekli"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "потрібен аргумент keymap (cmux, iterm2, terminal або tmux)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cần đối số keymap (cmux, iterm2, terminal hoặc tmux)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 keymap 参数（cmux、iterm2、terminal 或 tmux）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 keymap 參數（cmux、iterm2、terminal 或 tmux）"
          }
        }
      }
    },
    "keymap.summary.iterm2Numbers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحدد ⌘1…9 علامات التبويب في الجزء المحدد بدلًا من مساحات العمل. تنتقل مساحات العمل إلى ⌥⌘1…9."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 će birati kartice u fokusiranom oknu umjesto radnih prostora. Radni prostori prelaze na ⌥⌘1…9."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 vælger faner i den fokuserede rude i stedet for arbejdsområder. Arbejdsområder flyttes til ⌥⌘1…9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 wählt dann Tabs im fokussierten Bereich statt Arbeitsbereiche aus. Arbeitsbereiche wechseln zu ⌥⌘1…9."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 will select tabs in the focused pane instead of workspaces. Workspaces move to ⌥⌘1…9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 seleccionará pestañas del panel enfocado en lugar de espacios de trabajo. Los espacios de trabajo pasan a ⌥⌘1…9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 sélectionnera les onglets du panneau actif au lieu des espaces de travail. Les espaces de travail passent à ⌥⌘1…9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 selezionerà le schede nel riquadro attivo invece degli spazi di lavoro. Gli spazi di lavoro passano a ⌥⌘1…9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 はワークスペースではなく、フォーカス中のペインのタブを選択するようになります。ワークスペースは ⌥⌘1…9 に移ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 នឹងជ្រើសផ្ទាំងក្នុងផ្ទាំងបង្អួចដែលកំពុងផ្ដោត ជំនួសឱ្យកន្លែងធ្វើការ។ កន្លែងធ្វើការផ្លាស់ទៅ ⌥⌘1…9។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9는 작업 공간 대신 포커스된 패널의 탭을 선택합니다. 작업 공간은 ⌥⌘1…9로 이동합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 velger faner i den fokuserte ruten i stedet for arbeidsområder. Arbeidsområder flyttes til ⌥⌘1…9."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 będzie wybierać karty w aktywnym panelu zamiast obszarów roboczych. Obszary robocze przechodzą na ⌥⌘1…9."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 selecionará abas no painel em foco em vez de espaços de trabalho. Os espaços de trabalho passam para ⌥⌘1…9."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 будет выбирать вкладки в активной панели вместо рабочих пространств. Рабочие пространства переходят на ⌥⌘1…9."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 จะเลือกแท็บในบานหน้าต่างที่โฟกัสแทนพื้นที่ทำงาน พื้นที่ทำงานย้ายไปที่ ⌥⌘1…9"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9, çalışma alanları yerine odaktaki bölmedeki sekmeleri seçecek. Çalışma alanları ⌥⌘1…9 kısayoluna taşınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 вибиратиме вкладки в активній панелі замість робочих просторів. Робочі простори переходять на ⌥⌘1…9."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⌘1…9 sẽ chọn tab trong ô đang focus thay vì không gian làm việc. Không gian làm việc chuyển sang ⌥⌘1…9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 将选择当前窗格中的标签页，而不是工作区。工作区改用 ⌥⌘1…9。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1…9 將選取目前窗格中的分頁，而不是工作區。工作區改用 ⌥⌘1…9。"
          }
        }
      }
    },
    "keymap.summary.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تغيير أي اختصارات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna prečica nije promijenjena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen genveje ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
