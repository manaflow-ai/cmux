          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maszyna tego czatu nie jest maszyną cmux Cloud, więc nie ma czego udostępnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
