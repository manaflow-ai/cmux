    "cloud.share.notMember": {
      "comment": "Share refused: the teammate is no longer on the machine's team",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a current member of this machine's team can be given chats on it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن منح المحادثات على هذا الجهاز إلا لعضو حالي في فريقه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Razgovore na ovoj mašini može dobiti samo trenutni član njenog tima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun et nuværende medlem af maskinens team kan få chats på den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chats auf dieser Maschine kann nur ein aktuelles Mitglied ihres Teams bekommen."
