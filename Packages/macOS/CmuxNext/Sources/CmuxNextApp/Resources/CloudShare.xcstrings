        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマシンでチャットを許可できるのは、そのチームの現在のメンバーだけです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានតែសមាជិកបច្ចុប្បន្ននៃក្រុមរបស់ម៉ាស៊ីននេះប៉ុណ្ណោះដែលអាចទទួលការជជែកនៅលើវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기의 팀에 현재 속한 멤버만 이 기기에서 채팅할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare et nåværende medlem av maskinens team kan få chatter på den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Czaty na tej maszynie może otrzymać tylko obecny członek jej zespołu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só um membro atual da equipe desta máquina pode receber chats nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чаты на этой машине можно дать только текущему участнику её команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ให้สิทธิ์แชทบนเครื่องนี้ได้เฉพาะสมาชิกปัจจุบันของทีมเครื่องนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
