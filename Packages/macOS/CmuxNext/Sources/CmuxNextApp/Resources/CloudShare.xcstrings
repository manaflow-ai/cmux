          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette machine est sur un compte personnel : seul son créateur peut y démarrer des discussions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa macchina è su un account personale, quindi solo chi l'ha creata può avviarvi chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマシンは個人アカウントにあるため、チャットを開始できるのは作成者だけです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននេះស្ថិតនៅលើគណនីផ្ទាល់ខ្លួន ដូច្នេះមានតែអ្នកបង្កើតប៉ុណ្ណោះដែលអាចចាប់ផ្ដើមការជជែកនៅលើវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기는 개인 계정에 있어서 만든 사람만 채팅을 시작할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne maskinen er på en personlig konto, så bare den som opprettet den kan starte chatter på den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta maszyna należy do konta osobistego, więc czaty może na niej rozpoczynać tylko jej twórca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina está em uma conta pessoal, então só quem a criou pode iniciar chats nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта машина в личной учётной записи, поэтому чаты на ней может начинать только её создатель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องนี้อยู่ในบัญชีส่วนตัว จึงมีเพียงผู้สร้างเท่านั้นที่เริ่มแชทบนเครื่องนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
