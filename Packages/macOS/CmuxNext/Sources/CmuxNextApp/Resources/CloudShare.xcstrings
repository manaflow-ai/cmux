    "cloud.share.forbidden": {
      "comment": "Share refused: only the machine's creator or a team admin shares it",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the machine's creator or a team admin can share it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن مشاركة الجهاز إلا لمنشئه أو لمسؤول الفريق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašinu može podijeliti samo njen kreator ili administrator tima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun maskinens opretter eller en teamadministrator kan dele den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur wer die Maschine erstellt hat oder ein Team-Admin kann sie teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo quien creó la máquina o un administrador del equipo puede compartirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul le créateur de la machine ou un administrateur de l'équipe peut la partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo chi ha creato la macchina o un amministratore del team può condividerla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマシンを共有できるのは作成者かチーム管理者だけです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មានតែអ្នកបង្កើតម៉ាស៊ីន ឬអ្នកគ្រប់គ្រងក្រុមប៉ុណ្ណោះដែលអាចចែករំលែកវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기는 만든 사람이나 팀 관리자만 공유할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bare den som opprettet maskinen eller en teamadministrator kan dele den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maszynę może udostępnić tylko jej twórca lub administrator zespołu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Só quem criou a máquina ou um administrador da equipe pode compartilhá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поделиться машиной может только её создатель или администратор команды."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มีเพียงผู้สร้างเครื่องหรือผู้ดูแลทีมเท่านั้นที่แชร์เครื่องนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makineyi yalnızca onu oluşturan kişi veya bir ekip yöneticisi paylaşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поділитися машиною може лише її творець або адміністратор команди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ người tạo máy hoặc quản trị viên nhóm mới chia sẻ được máy này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有这台机器的创建者或团队管理员可以共享它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有這台機器的建立者或團隊管理員可以共享它。"
          }
        }
      }
    },
