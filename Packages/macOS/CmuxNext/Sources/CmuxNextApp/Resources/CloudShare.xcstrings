          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 채팅의 기기는 cmux Cloud 기기가 아니어서 공유할 것이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
