    "cloud.share.noTeam": {
      "comment": "Share Machine… refused: no active team",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing a machine needs a team. Pick your team in Settings > Accounts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتطلب مشاركة الجهاز فريقًا. اختر فريقك من الإعدادات > الحسابات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Za dijeljenje mašine potreban je tim. Odaberite tim u Postavke > Računi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deling af en maskine kræver et team. Vælg dit team under Indstillinger > Konti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Teilen einer Maschine brauchst du ein Team. Wähle dein Team unter Einstellungen > Konten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compartir una máquina requiere un equipo. Elige tu equipo en Ajustes > Cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Partager une machine nécessite une équipe. Choisissez votre équipe dans Réglages > Comptes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per condividere una macchina serve un team. Scegli il tuo team in Impostazioni > Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マシンを共有するにはチームが必要です。設定 > アカウントでチームを選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការចែករំលែកម៉ាស៊ីនត្រូវការក្រុម។ ជ្រើសក្រុមរបស់អ្នកនៅក្នុង ការកំណត់ > គណនី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기를 공유하려면 팀이 필요합니다. 설정 > 계정에서 팀을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deling av en maskin krever et team. Velg teamet ditt under Innstillinger > Kontoer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udostępnianie maszyny wymaga zespołu. Wybierz zespół w Ustawienia > Konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compartilhar uma máquina exige uma equipe. Escolha sua equipe em Ajustes > Contas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Чтобы поделиться машиной, нужна команда. Выберите команду в Настройки > Учётные записи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแชร์เครื่องต้องมีทีม เลือกทีมของคุณใน การตั้งค่า > บัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makine paylaşmak için bir ekip gerekir. Ekibinizi Ayarlar > Hesaplar'dan seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щоб поділитися машиною, потрібна команда. Виберіть команду в Налаштування > Облікові записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chia sẻ máy cần có nhóm. Hãy chọn nhóm của bạn trong Cài đặt > Tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "共享机器需要团队。请在“设置 > 账户”中选择你的团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "共享機器需要團隊。請在「設定 > 帳號」中選擇你的團隊。"
          }
        }
      }
    },
    "cloud.share.notCloudMachine": {
      "comment": "Share with Me refused: the chat's machine is not a cmux Cloud machine",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat's machine is not a cmux Cloud machine, so it has nothing to share."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جهاز هذه المحادثة ليس جهاز cmux Cloud، لذا لا يوجد ما يمكن مشاركته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina ovog razgovora nije cmux Cloud mašina, pa nema šta da se dijeli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne chats maskine er ikke en cmux Cloud-maskine, så der er intet at dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Maschine dieses Chats ist keine cmux-Cloud-Maschine, daher gibt es nichts zu teilen."
