        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La machine de cette discussion n'est pas une machine cmux Cloud : il n'y a rien à partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
