{
  "sourceLanguage": "en",
  "strings": {
    "tabSearch.refusal.needsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Tabs opens only when focus is requested; read results with tabs.search"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُفتح البحث في علامات التبويب إلا عند طلب التركيز؛ اقرأ النتائج باستخدام tabs.search"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pretraga tabova se otvara samo kada se zatraži fokus; rezultate čitajte pomoću tabs.search"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Søg i faner åbner kun, når der anmodes om fokus; læs resultater med tabs.search"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Tabs durchsuchen“ öffnet sich nur, wenn Fokus angefordert wird; Ergebnisse mit tabs.search lesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buscar pestañas solo se abre cuando se solicita el foco; lee los resultados con tabs.search"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La recherche d'onglets s'ouvre seulement si le focus est demandé ; lisez les résultats avec tabs.search"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cerca nelle schede si apre solo quando si richiede il focus; leggi i risultati con tabs.search"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブ検索はフォーカスを要求した場合のみ開きます。結果は tabs.search で取得してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការស្វែងរកផ្ទាំងបើកតែពេលស្នើសុំការផ្តោត; អានលទ្ធផលដោយ tabs.search"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭 검색은 포커스를 요청할 때만 열립니다. 결과는 tabs.search로 읽으세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Søk i faner åpnes bare når fokus er bedt om; les resultater med tabs.search"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyszukiwanie kart otwiera się tylko po zażądaniu fokusu; wyniki odczytaj przez tabs.search"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buscar abas só abre quando o foco é solicitado; leia os resultados com tabs.search"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поиск вкладок открывается только при запросе фокуса; результаты читайте через tabs.search"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การค้นหาแท็บจะเปิดเมื่อขอโฟกัสเท่านั้น อ่านผลลัพธ์ด้วย tabs.search"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sekmelerde Ara yalnızca odak istendiğinde açılır; sonuçları tabs.search ile okuyun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пошук вкладок відкривається лише на запит фокуса; результати читайте через tabs.search"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tìm kiếm thẻ chỉ mở khi yêu cầu tiêu điểm; đọc kết quả bằng tabs.search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅在请求焦点时打开搜索标签页；请用 tabs.search 读取结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅在要求焦點時開啟搜尋分頁；請用 tabs.search 讀取結果"
          }
        }
      }
    },
    "tabSearch.refusal.tabGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That tab is no longer open"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تعد علامة التبويب هذه مفتوحة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taj tab više nije otvoren"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den fane er ikke længere åben"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Tab ist nicht mehr geöffnet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esa pestaña ya no está abierta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet onglet n'est plus ouvert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quella scheda non è più aperta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのタブはもう開いていません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងនោះលែងបើកទៀតហើយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "해당 탭은 더 이상 열려 있지 않습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den fanen er ikke lenger åpen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta karta nie jest już otwarta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essa aba não está mais aberta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта вкладка больше не открыта"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บนั้นไม่ได้เปิดอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sekme artık açık değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ця вкладка вже не відкрита"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thẻ đó không còn mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该标签页已不再打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "該分頁已不再開啟"
          }
        }
      }
    },
