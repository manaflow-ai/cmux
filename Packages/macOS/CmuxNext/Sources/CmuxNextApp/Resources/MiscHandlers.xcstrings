        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentdæmonen kører ikke. Åbn en agentchat for at starte den, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
