{
  "sourceLanguage": "en",
  "strings": {
    "handlers.browserPage.captureFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page could not be captured (%@); show the tab and retry"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر التقاط الصفحة (%@)؛ اعرض علامة التبويب وأعد المحاولة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranicu nije moguće snimiti (%@); prikažite karticu i pokušajte ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden kunne ikke optages (%@); vis fanen, og prøv igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Seite konnte nicht aufgenommen werden (%@); zeige den Tab an und versuche es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo capturar la página (%@); muestra la pestaña y vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de capturer la page (%@) ; affichez l’onglet et réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile acquisire la pagina (%@); mostra la scheda e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ページをキャプチャできませんでした (%@)。タブを表示してからもう一度お試しください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចថតទំព័របានទេ (%@)។ បង្ហាញផ្ទាំង ហើយព្យាយាមម្តងទៀត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "페이지를 캡처할 수 없습니다(%@). 탭을 표시한 후 다시 시도하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siden kunne ikke tas opp (%@); vis fanen og prøv igjen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można przechwycić strony (%@); pokaż kartę i spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível capturar a página (%@); mostre a aba e tente novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось снять страницу (%@); покажите вкладку и повторите попытку"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถจับภาพหน้าได้ (%@) แสดงแท็บแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sayfa yakalanamadı (%@); sekmeyi gösterip yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зняти сторінку (%@); покажіть вкладку й повторіть спробу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể chụp trang (%@); hãy hiển thị tab rồi thử lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法捕获页面(%@);请显示该标签页后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法擷取頁面(%@);請顯示該分頁後再試一次"
          }
        }
      }
    },
    "handlers.browserPage.clipOutside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The element is outside the captured viewport"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "العنصر خارج إطار العرض الملتقط"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Element je izvan snimljenog prikaza"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elementet er uden for det optagne visningsområde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Element liegt außerhalb des aufgenommenen Anzeigebereichs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El elemento está fuera del área visible capturada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’élément est en dehors de la zone d’affichage capturée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’elemento è fuori dall’area visibile acquisita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要素がキャプチャした表示領域の外にあります"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ធាតុនៅក្រៅផ្ទៃបង្ហាញដែលបានថត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "요소가 캡처한 뷰포트 밖에 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elementet er utenfor det innfangede visningsområdet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Element znajduje się poza przechwyconym obszarem widoku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O elemento está fora da área visível capturada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Элемент находится за пределами снятой области просмотра"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "องค์ประกอบอยู่นอกพื้นที่แสดงผลที่จับภาพไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öğe yakalanan görüntü alanının dışında"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Елемент поза межами знятої області перегляду"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phần tử nằm ngoài khung nhìn đã chụp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元素位于已捕获的视口之外"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元素位於已擷取的檢視區之外"
          }
        }
      }
    },
    "handlers.browserPage.encodeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screenshot could not be encoded as PNG"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر ترميز لقطة الشاشة بتنسيق PNG"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snimak ekrana nije moguće kodirati kao PNG"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skærmbilledet kunne ikke kodes som PNG"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Bildschirmfoto konnte nicht als PNG codiert werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo codificar la captura de pantalla como PNG"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’encoder la capture d’écran en PNG"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile codificare lo screenshot come PNG"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スクリーンショットを PNG にエンコードできませんでした"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចអ៊ិនកូដរូបថតអេក្រង់ជា PNG បានទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스크린샷을 PNG로 인코딩할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skjermbildet kunne ikke kodes som PNG"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można zakodować zrzutu ekranu jako PNG"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível codificar a captura de tela como PNG"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось закодировать снимок экрана в PNG"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถเข้ารหัสภาพหน้าจอเป็น PNG ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekran görüntüsü PNG olarak kodlanamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося закодувати знімок екрана у PNG"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể mã hóa ảnh chụp màn hình thành PNG"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法将截图编码为 PNG"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法將截圖編碼為 PNG"
          }
        }
      }
    },
