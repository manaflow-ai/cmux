          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare Claude Code- og Codex-økter kan åpnes som chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako czat można otworzyć tylko sesje Claude Code i Codex."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente sessões do Claude Code e do Codex podem ser abertas como chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как чат можно открыть только сеансы Claude Code и Codex."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเป็นแชตได้เฉพาะเซสชัน Claude Code และ Codex เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Claude Code ve Codex oturumları sohbet olarak açılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як чат можна відкрити лише сеанси Claude Code і Codex."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các phiên Claude Code và Codex mới có thể mở dưới dạng trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
