            "state": "translated",
            "value": "분할 창이 화면에 없습니다. 해당 작업 공간을 표시하는 윈도우가 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruten er ikke på skjermen: ingen vinduer viser arbeidsområdet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelu nie ma na ekranie: żadne okno nie pokazuje jego obszaru roboczego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel não está na tela: nenhuma janela mostra o espaço de trabalho dele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панели нет на экране: ни одно окно не показывает её рабочее пространство"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บานหน้าต่างไม่อยู่บนหน้าจอ: ไม่มีหน้าต่างใดแสดงพื้นที่ทำงานของบานหน้าต่างนี้"
          }
