            "value": "Integriere meinen Harness in cmux. Führe `cmux harness guide` aus und folge der Anleitung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Integra mi harness en cmux. Ejecuta `cmux harness guide` y sigue sus pasos."
          }
        },
        "fr": {
