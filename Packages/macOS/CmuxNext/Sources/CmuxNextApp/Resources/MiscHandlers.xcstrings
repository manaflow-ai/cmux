    "handlers.misc.browserOff": {
      "comment": "Refusal when a browser tab is asked for while the cmux browser is turned off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux browser is off. Run Enable cmux Browser to open web pages in cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "متصفح cmux متوقف. شغّل «تفعيل متصفح cmux» لفتح صفحات الويب في cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux preglednik je isključen. Pokrenite Omogući cmux preglednik da otvarate web stranice u cmuxu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-browseren er slået fra. Kør Slå cmux-browser til for at åbne websider i cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der cmux-Browser ist aus. Führe „cmux-Browser aktivieren“ aus, um Webseiten in cmux zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El navegador de cmux está desactivado. Ejecuta Activar el navegador de cmux para abrir páginas web en cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le navigateur cmux est désactivé. Lancez Activer le navigateur cmux pour ouvrir des pages web dans cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il browser di cmux è disattivato. Esegui Attiva il browser di cmux per aprire pagine web in cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ブラウザはオフです。cmux で Web ページを開くには「cmux ブラウザを有効にする」を実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីរុករក cmux ត្រូវបានបិទ។ ដំណើរការ បើកកម្មវិធីរុករក cmux ដើម្បីបើកទំព័របណ្ដាញក្នុង cmux។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 브라우저가 꺼져 있습니다. cmux에서 웹 페이지를 열려면 cmux 브라우저 사용을 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-nettleseren er av. Kjør Slå på cmux-nettleser for å åpne nettsider i cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przeglądarka cmux jest wyłączona. Uruchom Włącz przeglądarkę cmux, aby otwierać strony internetowe w cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O navegador do cmux está desativado. Execute Ativar o navegador do cmux para abrir páginas da web no cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Браузер cmux выключен. Выполните «Включить браузер cmux», чтобы открывать веб-страницы в cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เบราว์เซอร์ cmux ปิดอยู่ เรียกใช้ เปิดใช้เบราว์เซอร์ cmux เพื่อเปิดหน้าเว็บใน cmux"
          }
        },
        "tr": {
