          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux — браузер по умолчанию, поэтому ссылка откроется в cmux"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux เป็นเบราว์เซอร์เริ่มต้น ลิงก์จึงเปิดใน cmux"
          }
        },
        "tr": {
