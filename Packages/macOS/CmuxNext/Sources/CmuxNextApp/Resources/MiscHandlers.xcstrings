    "handlers.misc.failed.forkClaudeOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forking is supported for Claude sessions only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォークは Claude のセッションでのみ使えます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التفريع مدعوم لجلسات Claude فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Račvanje je podržano samo za Claude sesije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fork understøttes kun for Claude-sessioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forken wird nur für Claude-Sitzungen unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo se pueden bifurcar sesiones de Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La duplication n’est prise en charge que pour les sessions Claude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La duplicazione è supportata solo per le sessioni Claude."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការ Fork គាំទ្រតែវគ្គ Claude ប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "포크는 Claude 세션에서만 지원됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forgrening støttes bare for Claude-økter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozwidlanie jest obsługiwane tylko dla sesji Claude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A bifurcação só é suportada em sessões do Claude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Форк поддерживается только для сеансов Claude."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รองรับการ Fork เฉพาะเซสชัน Claude เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çatallama yalnızca Claude oturumlarında desteklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відгалуження підтримується лише для сеансів Claude."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chỉ hỗ trợ fork cho phiên Claude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅 Claude 会话支持分叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅 Claude 階段作業支援建立分支。"
          }
        }
      }
    },
    "handlers.misc.failed.hardReloadEngine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This browser engine cannot bypass the cache; use Reload Page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブラウザエンジンはキャッシュを無視できません。「ページを再読み込み」を使ってください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن لمحرك المتصفح هذا تجاوز ذاكرة التخزين المؤقت؛ استخدم \"إعادة تحميل الصفحة\"."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj pogon preglednika ne može zaobići keš; koristite Ponovo učitaj stranicu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne browsermotor kan ikke omgå cachen. Brug Genindlæs side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Browser-Engine kann den Cache nicht umgehen; verwenden Sie „Seite neu laden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este motor de navegador no puede omitir la caché; usa Recargar página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce moteur de navigateur ne peut pas ignorer le cache ; utilisez Recharger la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo motore del browser non può ignorare la cache; usa Ricarica pagina."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនកម្មវិធីរុករកនេះមិនអាចរំលង cache បានទេ។ សូមប្រើ ផ្ទុកទំព័រឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 브라우저 엔진은 캐시를 무시할 수 없습니다. '페이지 새로고침'을 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne nettlesermotoren kan ikke omgå hurtigbufferen. Bruk Last inn siden på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten silnik przeglądarki nie może pominąć pamięci podręcznej; użyj opcji Wczytaj stronę ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este motor de navegador não pode ignorar o cache; use Recarregar Página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот движок браузера не может обойти кэш; используйте «Перезагрузить страницу»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอนจินเบราว์เซอร์นี้ข้ามแคชไม่ได้ ใช้ “โหลดหน้าใหม่” แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu tarayıcı motoru önbelleği atlayamaz; Sayfayı Yeniden Yükle’yi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей рушій браузера не може оминути кеш; скористайтеся «Перезавантажити сторінку»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engine trình duyệt này không thể bỏ qua bộ nhớ đệm; hãy dùng Tải lại trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此浏览器引擎无法绕过缓存；请使用“重新加载页面”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此瀏覽器引擎無法略過快取；請使用「重新載入頁面」。"
          }
        }
      }
    },
    "handlers.misc.failed.markUnread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daemon cannot mark a notification unread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デーモンは通知を未読に戻せません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن للخدمة تعليم إشعار كغير مقروء."
          }
        },
        "bs": {
          "stringUnit": {
