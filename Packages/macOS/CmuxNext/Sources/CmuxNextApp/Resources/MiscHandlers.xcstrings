    "handlers.agent.harness.noDaemon": {
      "comment": "Agent harness action refusals; keep commands and --arg text exactly",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برنامج الوكلاء الخفي لا يعمل. افتح محادثة وكيل لتشغيله، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent daemon ne radi. Otvori agent chat da ga pokreneš, pa pokušaj ponovo."
