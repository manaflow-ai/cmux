    "handlers.screenshot.outNeedsValue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) needs a file path, or - for the image inline"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج out ‏(--out) إلى مسار ملف، أو - لإرجاع الصورة مضمّنة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) treba putanju datoteke ili - za sliku u odgovoru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) kræver en filsti eller - for at få billedet direkte i svaret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) braucht einen Dateipfad oder - für das Bild direkt in der Antwort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) necesita una ruta de archivo, o - para devolver la imagen en línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) attend un chemin de fichier, ou - pour renvoyer l’image en ligne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) richiede un percorso di file, oppure - per restituire l’immagine in linea"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "out（--out）にはファイルパスを指定するか、画像をそのまま返す場合は - を指定してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) ត្រូវការផ្លូវឯកសារ ឬ - ដើម្បីបញ្ជូនរូបភាពក្នុងចម្លើយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "out(--out)에는 파일 경로가 필요하며, 이미지를 응답에 바로 담으려면 -를 지정하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) trenger en filbane, eller - for å få bildet direkte i svaret"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) wymaga ścieżki pliku albo - aby zwrócić obraz bezpośrednio w odpowiedzi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) precisa de um caminho de arquivo, ou - para retornar a imagem embutida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для out (--out) нужен путь к файлу или - для изображения прямо в ответе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) ต้องระบุพาธไฟล์ หรือ - เพื่อส่งภาพกลับมาในคำตอบโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) bir dosya yolu ya da görüntüyü yanıtın içinde almak için - bekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для out (--out) потрібен шлях до файлу або - для зображення прямо у відповіді"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) cần đường dẫn tệp, hoặc - để trả ảnh ngay trong phản hồi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "out（--out）需要文件路径，或用 - 直接在结果中返回图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "out（--out）需要檔案路徑，或用 - 直接在結果中傳回影像"
          }
        }
      }
    },
    "handlers.screenshot.outRelative": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) needs an absolute path or -, not “%@”"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج out ‏(--out) إلى مسار مطلق أو -، وليس “%@”"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) treba apsolutnu putanju ili -, a ne “%@”"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) kræver en absolut sti eller -, ikke “%@”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) braucht einen absoluten Pfad oder -, nicht „%@“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) necesita una ruta absoluta o -, no “%@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) attend un chemin absolu ou -, pas « %@ »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) richiede un percorso assoluto o -, non “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "out（--out）には絶対パスか - を指定してください（「%@」は使えません）"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) ត្រូវការផ្លូវដាច់ខាត ឬ - មិនមែន “%@” ទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "out(--out)에는 절대 경로나 -가 필요합니다. “%@”는 사용할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) trenger en absolutt bane eller -, ikke «%@»"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) wymaga ścieżki bezwzględnej albo -, a nie „%@”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) precisa de um caminho absoluto ou -, não “%@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для out (--out) нужен абсолютный путь или -, а не «%@»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) ต้องเป็นพาธแบบสัมบูรณ์หรือ - ไม่ใช่ “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) mutlak bir yol ya da - bekler, “%@” değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для out (--out) потрібен абсолютний шлях або -, а не «%@»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "out (--out) cần đường dẫn tuyệt đối hoặc -, không phải “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "out（--out）需要绝对路径或 -，而不是“%@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "out（--out）需要絕對路徑或 -，而不是「%@」"
          }
        }
      }
    },
