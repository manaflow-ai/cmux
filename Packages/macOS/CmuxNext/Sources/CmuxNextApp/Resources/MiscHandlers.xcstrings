        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) cmux가 열 수 있는 URL이 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ er ikke en URL cmux kan åpne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie jest adresem URL, który cmux może otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não é um URL que o cmux possa abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ — не URL, который cmux может открыть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่ใช่ URL ที่ cmux เปิดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@, cmux’un açabileceği bir URL değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не є URL, який cmux може відкрити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không phải là URL mà cmux có thể mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不是 cmux 可以打开的 URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不是 cmux 可開啟的 URL。"
          }
        }
      }
