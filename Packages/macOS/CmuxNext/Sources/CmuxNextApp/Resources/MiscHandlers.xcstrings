          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست صبغة. استخدم none أو اسم لون أو #RRGGBB."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije nijansa. Koristite none, naziv boje ili #RRGGBB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke en farvetone. Brug none, et farvenavn eller #RRGGBB."
          }
        },
        "de": {
          "stringUnit": {
