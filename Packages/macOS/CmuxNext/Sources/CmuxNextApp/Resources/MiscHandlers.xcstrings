    "handlers.misc.failed.pathNotAbsolute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a relative path. Give the file's absolute path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は相対パスです。ファイルの絶対パスを指定してください。"
          }
        },
        "ar": {
