    "handlers.misc.failed.noForkTarget": {
      "comment": "Fork Conversation with neither an agent chat nor a terminal focused",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ركّز على محادثة وكيل، أو على طرفية يعمل فيها وكيل، لتفريعها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusirajte chat agenta ili terminal u kojem radi agent da ga račvate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokuser på en agentchat eller en terminal, der kører en agent, for at forgrene den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokussiere einen Agent-Chat oder ein Terminal mit einem Agenten, um ihn zu forken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus an agent chat, or a terminal running an agent, to fork it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoca un chat de agente, o una terminal que ejecute un agente, para bifurcarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le focus sur un chat d’agent, ou un terminal qui exécute un agent, pour le dupliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti a fuoco una chat dell’agente, o un terminale che esegue un agente, per biforcarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォークするには、エージェントのチャット、またはエージェントを実行中のターミナルにフォーカスしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្តោតលើការជជែកភ្នាក់ងារ ឬទែមីណាល់ដែលកំពុងដំណើរការភ្នាក់ងារ ដើម្បីបំបែកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포크하려면 에이전트 채팅이나 에이전트를 실행 중인 터미널에 포커스를 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokuser på en agentchat eller en terminal som kjører en agent, for å forgrene den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw fokus na czacie agenta lub terminalu z działającym agentem, aby go rozwidlić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foque um chat de agente, ou um terminal executando um agente, para bifurcá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы ответвить, выберите чат агента или терминал, в котором работает агент."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟกัสแชตเอเจนต์ หรือเทอร์มินัลที่กำลังเรียกใช้เอเจนต์ เพื่อแยก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çatallamak için bir ajan sohbetine veya ajan çalıştıran bir terminale odaklanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб відгалузити, виберіть чат агента або термінал, у якому працює агент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn một cuộc trò chuyện với tác tử, hoặc một terminal đang chạy tác tử, để phân nhánh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请聚焦代理聊天或正在运行代理的终端以进行分叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請聚焦代理聊天或正在執行代理的終端機以進行分岔。"
          }
        }
      }
    },
    "handlers.misc.failed.forkTerminalAgents": {
      "comment": "Fork Conversation on a terminal whose agent has no fork command",
      "extractionState": "manual",
      "localizations": {
        "ar": {
