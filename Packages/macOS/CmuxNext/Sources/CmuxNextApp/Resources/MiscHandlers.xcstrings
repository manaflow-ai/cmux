    },
    "handlers.agent.harness.stillUpdating": {
      "comment": "Agent CLI update refusal while an earlier update of the same CLI runs; %@ is the CLI name (claude, codex)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يزال %@ قيد التحديث. انتظر حتى ينتهي ذلك التحديث، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se još ažurira. Sačekaj da to ažuriranje završi, pa pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ opdateres stadig. Vent, til opdateringen er færdig, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wird noch aktualisiert. Warte, bis dieses Update fertig ist, und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still updating. Wait for that update to finish, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ todavía se está actualizando. Espera a que termine esa actualización y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ est toujours en cours de mise à jour. Attendez la fin de cette mise à jour, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ si sta ancora aggiornando. Attendi che l'aggiornamento finisca, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだ更新中です。その更新が終わるまで待ってから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ នៅតែកំពុងធ្វើបច្ចុប្បន្នភាព។ រង់ចាំការធ្វើបច្ចុប្បន្នភាពនោះបញ្ចប់ រួចព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@이(가) 아직 업데이트 중입니다. 업데이트가 끝날 때까지 기다린 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ oppdateres fortsatt. Vent til oppdateringen er ferdig, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nadal się aktualizuje. Poczekaj na zakończenie tej aktualizacji i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ainda está sendo atualizado. Aguarde essa atualização terminar e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ещё обновляется. Дождитесь завершения этого обновления и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ยังอัปเดตอยู่ รอให้การอัปเดตนั้นเสร็จ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hâlâ güncelleniyor. Bu güncellemenin bitmesini bekleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ще оновлюється. Дочекайтеся завершення цього оновлення й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ vẫn đang cập nhật. Hãy đợi bản cập nhật đó hoàn tất rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 仍在更新。请等待该更新完成后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 仍在更新。請等待該更新完成後再試一次。"
          }
        }
      }
    },
    "handlers.agent.harness.unsupported": {
      "comment": "Agent harness action refusals; keep commands and --arg text exactly",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستطيع acpmux هذا إضافة الوكلاء أو إزالتهم من التطبيق. استخدم cmux harness add أو cmux harness doctor في طرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj acpmux ne može dodavati ni uklanjati agente iz aplikacije. Koristi cmux harness add ili cmux harness doctor u terminalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne acpmux kan ikke tilføje eller fjerne agenter fra appen. Brug cmux harness add eller cmux harness doctor i en terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses acpmux kann in der App keine Agenten hinzufügen oder entfernen. Nutze cmux harness add oder cmux harness doctor im Terminal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This acpmux cannot add or remove agents from the app. Use cmux harness add or cmux harness doctor in a terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este acpmux no puede añadir ni quitar agentes desde la app. Usa cmux harness add o cmux harness doctor en una terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet acpmux ne peut pas ajouter ni supprimer d’agents depuis l’app. Utilisez cmux harness add ou cmux harness doctor dans un terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo acpmux non può aggiungere o rimuovere agenti dall’app. Usa cmux harness add o cmux harness doctor in un terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このacpmuxはアプリからエージェントを追加・削除できません。ターミナルでcmux harness addまたはcmux harness doctorを使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux នេះមិនអាចបន្ថែម ឬលុបភ្នាក់ងារពីកម្មវិធីបានទេ។ ប្រើ cmux harness add ឬ cmux harness doctor ក្នុងស្ថានីយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 acpmux는 앱에서 에이전트를 추가하거나 제거할 수 없습니다. 터미널에서 cmux harness add 또는 cmux harness doctor를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne acpmux kan ikke legge til eller fjerne agenter fra appen. Bruk cmux harness add eller cmux harness doctor i en terminal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten acpmux nie może dodawać ani usuwać agentów z aplikacji. Użyj cmux harness add lub cmux harness doctor w terminalu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este acpmux não pode adicionar nem remover agentes pelo app. Use cmux harness add ou cmux harness doctor em um terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот acpmux не может добавлять или удалять агентов из приложения. Используйте cmux harness add или cmux harness doctor в терминале."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux นี้เพิ่มหรือลบเอเจนต์จากแอปไม่ได้ ใช้ cmux harness add หรือ cmux harness doctor ในเทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu acpmux uygulamadan aracı ekleyemez veya kaldıramaz. Bir terminalde cmux harness add veya cmux harness doctor kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей acpmux не може додавати чи видаляти агентів із застосунку. Використовуйте cmux harness add або cmux harness doctor у терміналі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "acpmux này không thể thêm hoặc xóa tác tử từ ứng dụng. Dùng cmux harness add hoặc cmux harness doctor trong terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 acpmux 无法在应用中添加或移除智能体。请在终端中使用 cmux harness add 或 cmux harness doctor。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 acpmux 無法在 App 中新增或移除代理。請在終端機中使用 cmux harness add 或 cmux harness doctor。"
          }
        }
      }
    },
    "handlers.agent.addHarness.needsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
