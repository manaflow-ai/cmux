    "handlers.screenshot.notOnScreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window is not on screen (the app is hidden or the window is closed)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
