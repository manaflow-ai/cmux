    "handlers.misc.failed.continueInNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue In… requires focus; use cmux acp continue for a headless handoff."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「…」で続行するにはフォーカスが必要です。UI なしで引き継ぐには cmux acp continue を使ってください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب المتابعة في… التركيز؛ استخدم cmux acp continue للتسليم من دون واجهة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavak u… zahteva fokus; koristite cmux acp continue za predaju bez sučelja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt i… kræver fokus; brug cmux acp continue til en hovedløs overdragelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter in… erfordert den Fokus; für eine Übergabe ohne Oberfläche verwenden Sie cmux acp continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar en… requiere el foco; usa cmux acp continue para una transferencia sin interfaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer dans… nécessite le focus ; utilisez cmux acp continue pour un transfert sans interface."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua in… richiede il focus; usa cmux acp continue per un passaggio senza interfaccia."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្តក្នុង… ត្រូវការការផ្ដោត; ប្រើ cmux acp continue សម្រាប់ការផ្ទេរដោយគ្មាន UI។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에서 계속…하려면 포커스가 필요합니다. UI 없는 핸드오프에는 cmux acp continue를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett i… krever fokus; bruk cmux acp continue for en håndover uten brukergrensesnitt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj w… wymaga fokusu; użyj cmux acp continue do przekazania bez interfejsu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar em… requer foco; use cmux acp continue para uma transferência sem interface."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для продолжения в… нужен фокус; используйте cmux acp continue для передачи без интерфейса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการต่อใน… ต้องมีโฟกัส ใช้ cmux acp continue สำหรับการส่งต่องานแบบไม่มี UI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şurada devam et… için odak gerekir; arayüzsüz aktarım için cmux acp continue kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для продовження в… потрібен фокус; використовуйте cmux acp continue для передачі без інтерфейсу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục trong… cần tiêu điểm; dùng cmux acp continue để bàn giao không có giao diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用…需要焦点；无界面交接请使用 cmux acp continue。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用…需要焦點；無介面交接請使用 cmux acp continue。"
          }
        }
      }
    },
    "handlers.misc.failed.quickChatNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Agent opens from the keyboard, palette or menu. It does not take the keyboard for automation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「エージェントを開始」はキーボード、パレット、メニューから開きます。自動化のためにキーボードを奪うことはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُفتح «بدء وكيل» من لوحة المفاتيح أو اللوحة أو القائمة. ولا يستحوذ على لوحة المفاتيح لأجل الأتمتة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokreni agenta se otvara s tastature, palete ili menija. Ne preuzima tastaturu za automatizaciju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start agent åbnes fra tastaturet, paletten eller menuen. Den tager ikke tastaturet til automatisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Agent starten“ öffnet sich über Tastatur, Palette oder Menü. Für Automatisierung übernimmt es nicht die Tastatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar agente se abre desde el teclado, la paleta o el menú. No toma el teclado para la automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarrer un agent s’ouvre depuis le clavier, la palette ou le menu. Il ne prend pas le clavier pour l’automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia agente si apre da tastiera, palette o menu. Non prende la tastiera per l’automazione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចាប់ផ្តើមភ្នាក់ងារ បើកពីក្តារចុច ផ្ទាំងពាក្យបញ្ជា ឬម៉ឺនុយ។ វាមិនយកក្តារចុចសម្រាប់ស្វ័យប្រវត្តិកម្មទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 시작은 키보드, 팔레트 또는 메뉴에서 열립니다. 자동화를 위해 키보드를 가져가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start agent åpnes fra tastaturet, paletten eller menyen. Den tar ikke tastaturet for automatisering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom agenta otwiera się z klawiatury, palety lub menu. Nie przejmuje klawiatury na potrzeby automatyzacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iniciar agente abre pelo teclado, pela paleta ou pelo menu. Ele não toma o teclado para automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Запустить агента» открывается с клавиатуры, из палитры или меню. Оно не перехватывает клавиатуру для автоматизации."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มเอเจนต์เปิดจากแป้นพิมพ์ พาเล็ต หรือเมนู และจะไม่ยึดแป้นพิมพ์เพื่อการทำงานอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajan Başlat klavyeden, paletten veya menüden açılır. Otomasyon için klavyeyi almaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Запустити агента» відкривається з клавіатури, палітри або меню. Воно не перехоплює клавіатуру для автоматизації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu tác tử mở từ bàn phím, bảng lệnh hoặc menu. Nó không chiếm bàn phím cho tự động hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“启动智能体”可从键盘、命令面板或菜单打开。它不会为自动化占用键盘。"
          }
