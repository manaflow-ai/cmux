    "handlers.screenshot.minimized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window is minimized in the Dock; cmux does not restore it for a screenshot"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النافذة مصغّرة في Dock؛ لا يستعيدها cmux من أجل لقطة شاشة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozor je minimiziran u Dock; cmux ga ne vraća radi snimka ekrana"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet er minimeret i Dock; cmux gendanner det ikke for at tage et skærmbillede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster ist im Dock minimiert; cmux stellt es für einen Screenshot nicht wieder her"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana está minimizada en el Dock; cmux no la restaura para hacer una captura"
