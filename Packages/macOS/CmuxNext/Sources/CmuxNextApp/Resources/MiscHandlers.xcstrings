    "handlers.agent.addHarness.request": {
      "comment": "Composer text of the chat Add Harness opens. Keep `cmux harness guide` exactly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
