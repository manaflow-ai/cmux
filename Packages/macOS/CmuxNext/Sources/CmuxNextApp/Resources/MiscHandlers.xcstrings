            "state": "needs_review",
            "value": "Daemonen kan ikke merke et varsel som ulest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demon nie może oznaczyć powiadomienia jako nieprzeczytanego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
