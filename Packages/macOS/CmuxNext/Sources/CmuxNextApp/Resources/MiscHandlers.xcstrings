    "handlers.paneBackground.noDurablePane": {
      "comment": "Refusal: the pane's session is too old to remember a per-pane background.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pane cannot keep its own background: its session is too old. Update cmux on that machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا الجزء الاحتفاظ بخلفيته: جلسته قديمة جدًا. حدّث cmux على ذلك الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo okno ne može zadržati vlastitu pozadinu: sesija je prestara. Ažurirajte cmux na tom računaru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rude kan ikke beholde sin egen baggrund: sessionen er for gammel. Opdater cmux på den maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich kann keinen eigenen Hintergrund behalten: Seine Sitzung ist zu alt. Aktualisiere cmux auf diesem Rechner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este panel no puede tener fondo propio: su sesión es demasiado antigua. Actualiza cmux en esa máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce volet ne peut pas garder son propre arrière-plan : sa session est trop ancienne. Mettez à jour cmux sur cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo riquadro non può avere uno sfondo proprio: la sua sessione è troppo vecchia. Aggiorna cmux su quella macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペインは固有の背景を保持できません。セッションが古すぎます。そのマシンの cmux をアップデートしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងនេះមិនអាចរក្សាផ្ទៃខាងក្រោយផ្ទាល់ខ្លួនបានទេ៖ វគ្គរបស់វាចាស់ពេក។ ធ្វើបច្ចុប្បន្នភាព cmux នៅលើម៉ាស៊ីននោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창 영역은 자체 배경을 유지할 수 없습니다. 세션이 너무 오래되었습니다. 해당 기기의 cmux를 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne ruten kan ikke beholde sin egen bakgrunn: økten er for gammel. Oppdater cmux på den maskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten panel nie może mieć własnego tła: jego sesja jest za stara. Zaktualizuj cmux na tym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este painel não pode ter fundo próprio: a sessão é antiga demais. Atualize o cmux nessa máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта панель не может хранить собственный фон: её сеанс слишком старый. Обновите cmux на этом компьютере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บานหน้าต่างนี้เก็บพื้นหลังของตัวเองไม่ได้ เซสชันเก่าเกินไป อัปเดต cmux บนเครื่องนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölme kendi arka planını tutamaz: oturumu çok eski. O makinede cmux'u güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця панель не може зберігати власне тло: її сеанс застарий. Оновіть cmux на тому комп'ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung này không giữ được hình nền riêng: phiên của nó quá cũ. Hãy cập nhật cmux trên máy đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗格无法保留自己的背景：其会话太旧。请在那台电脑上更新 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗格無法保留自己的背景：其工作階段太舊。請在那台電腦上更新 cmux。"
          }
        }
      }
    },
    "handlers.appearance.badProperty": {
      "comment": "Refusal: appearance set or reset was given no valid scope or property.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a scope (window, workspace, pane or tab) and a property (theme, background, tint or opacity)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد نطاقًا (window أو workspace أو pane أو tab) وخاصية (theme أو background أو tint أو opacity)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedite opseg (window, workspace, pane ili tab) i svojstvo (theme, background, tint ili opacity)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv et omfang (window, workspace, pane eller tab) og en egenskab (theme, background, tint eller opacity)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Bereich (window, workspace, pane oder tab) und eine Eigenschaft (theme, background, tint oder opacity) an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un ámbito (window, workspace, pane o tab) y una propiedad (theme, background, tint u opacity)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez une portée (window, workspace, pane ou tab) et une propriété (theme, background, tint ou opacity)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un ambito (window, workspace, pane o tab) e una proprietà (theme, background, tint o opacity)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲（window、workspace、pane、tab）とプロパティ（theme、background、tint、opacity）を指定してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជាក់វិសាលភាព (window, workspace, pane ឬ tab) និងលក្ខណៈ (theme, background, tint ឬ opacity)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위(window, workspace, pane, tab)와 속성(theme, background, tint, opacity)을 지정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi et omfang (window, workspace, pane eller tab) og en egenskap (theme, background, tint eller opacity)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj zakres (window, workspace, pane lub tab) i właściwość (theme, background, tint lub opacity)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um escopo (window, workspace, pane ou tab) e uma propriedade (theme, background, tint ou opacity)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите область (window, workspace, pane или tab) и свойство (theme, background, tint или opacity)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุขอบเขต (window, workspace, pane หรือ tab) และคุณสมบัติ (theme, background, tint หรือ opacity)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kapsam (window, workspace, pane veya tab) ve bir özellik (theme, background, tint veya opacity) belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть область (window, workspace, pane або tab) і властивість (theme, background, tint або opacity)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nêu phạm vi (window, workspace, pane hoặc tab) và thuộc tính (theme, background, tint hoặc opacity)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请指定范围（window、workspace、pane 或 tab）和属性（theme、background、tint 或 opacity）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請指定範圍（window、workspace、pane 或 tab）和屬性（theme、background、tint 或 opacity）。"
          }
        }
      }
    },
    "handlers.appearance.notAtLevel": {
      "comment": "Refusal: the property cannot be set at the chosen scope (for example a background on a tab).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That property cannot be set at that scope."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تعيين هذه الخاصية في هذا النطاق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "To svojstvo se ne može postaviti u tom opsegu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den egenskab kan ikke angives i det omfang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Eigenschaft lässt sich in diesem Bereich nicht festlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa propiedad no se puede establecer en ese ámbito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette propriété ne peut pas être définie à cette portée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella proprietà non si può impostare in quell'ambito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのプロパティはその範囲では設定できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចកំណត់លក្ខណៈនោះក្នុងវិសាលភាពនោះបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 속성은 그 범위에서 설정할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den egenskapen kan ikke angis i det omfanget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej właściwości nie można ustawić w tym zakresie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa propriedade não pode ser definida nesse escopo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это свойство нельзя задать в этой области."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งคุณสมบัตินั้นในขอบเขตนี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özellik bu kapsamda ayarlanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю властивість не можна задати в цій області."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đặt thuộc tính đó ở phạm vi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在该范围设置该属性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在該範圍設定該屬性。"
          }
        }
      }
