    "handlers.misc.failed.continueInNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue in… requires focus; use cmux acp continue for a headless handoff."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「…」で続行するにはフォーカスが必要です。UI なしで引き継ぐには cmux acp continue を使ってください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب المتابعة في… التركيز؛ استخدم cmux acp continue للتسليم من دون واجهة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavak u… zahteva fokus; koristite cmux acp continue za predaju bez sučelja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt i… kræver fokus; brug cmux acp continue til en hovedløs overdragelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter in… erfordert den Fokus; für eine Übergabe ohne Oberfläche verwenden Sie cmux acp continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar en… requiere el foco; usa cmux acp continue para una transferencia sin interfaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer dans… nécessite le focus ; utilisez cmux acp continue pour un transfert sans interface."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua in… richiede il focus; usa cmux acp continue per un passaggio senza interfaccia."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្តក្នុង… ត្រូវការការផ្ដោត; ប្រើ cmux acp continue សម្រាប់ការផ្ទេរដោយគ្មាន UI។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에서 계속…하려면 포커스가 필요합니다. UI 없는 핸드오프에는 cmux acp continue를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett i… krever fokus; bruk cmux acp continue for en håndover uten brukergrensesnitt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj w… wymaga fokusu; użyj cmux acp continue do przekazania bez interfejsu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar em… requer foco; use cmux acp continue para uma transferência sem interface."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для продолжения в… нужен фокус; используйте cmux acp continue для передачи без интерфейса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการต่อใน… ต้องมีโฟกัส ใช้ cmux acp continue สำหรับการส่งต่องานแบบไม่มี UI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şurada devam et… için odak gerekir; arayüzsüz aktarım için cmux acp continue kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для продовження в… потрібен фокус; використовуйте cmux acp continue для передачі без інтерфейсу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục trong… cần tiêu điểm; dùng cmux acp continue để bàn giao không có giao diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用…需要焦点；无界面交接请使用 cmux acp continue。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用…需要焦點；無介面交接請使用 cmux acp continue。"
          }
        }
      }
    },
    "handlers.misc.failed.quickChatNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Agent Chat opens from the keyboard, palette or menu. It does not take the keyboard for automation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックエージェントチャットはキーボード、パレット、メニューから開きます。自動化のためにキーボードを奪うことはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح دردشة الوكيل السريعة من لوحة المفاتيح أو لوحة الأوامر أو القائمة. ولا تستحوذ على لوحة المفاتيح لأغراض الأتمتة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brzi chat s agentom otvara se s tastature, palete ili menija. Ne preuzima tastaturu za automatizaciju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hurtig agentchat åbnes fra tastaturet, paletten eller menuen. Den overtager ikke tastaturet til automatisering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneller Agent-Chat öffnet sich über Tastatur, Befehlspalette oder Menü. Für Automatisierung übernimmt er die Tastatur nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat rápido con agente se abre desde el teclado, la paleta o el menú. No toma el teclado para la automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat agent rapide s’ouvre depuis le clavier, la palette ou le menu. Il ne prend pas le clavier pour l’automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La chat rapida con l’agente si apre da tastiera, palette o menu. Non prende la tastiera per l’automazione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែកភ្នាក់ងាររហ័សបើកពីក្ដារចុច ផ្ទាំងពាក្យបញ្ជា ឬម៉ឺនុយ។ វាមិនយកក្ដារចុចសម្រាប់ស្វ័យប្រវត្តិកម្មទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 에이전트 채팅은 키보드, 팔레트 또는 메뉴에서 열립니다. 자동화를 위해 키보드를 가져가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rask agentchat åpnes fra tastaturet, paletten eller menyen. Den tar ikke over tastaturet for automatisering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szybki czat z agentem otwiera się z klawiatury, palety lub menu. Nie przejmuje klawiatury na potrzeby automatyzacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O chat rápido com agente abre pelo teclado, paleta ou menu. Ele não toma o teclado para automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Быстрый чат с агентом открывается с клавиатуры, из палитры или меню. Для автоматизации он не перехватывает клавиатуру."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แชทเอเจนต์ด่วนเปิดได้จากแป้นพิมพ์ พาเล็ต หรือเมนู และจะไม่แย่งแป้นพิมพ์เพื่อการทำงานอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hızlı Ajan Sohbeti klavyeden, paletten veya menüden açılır. Otomasyon için klavyeyi devralmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Швидкий чат з агентом відкривається з клавіатури, палітри або меню. Для автоматизації він не перехоплює клавіатуру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trò chuyện nhanh với tác tử mở từ bàn phím, bảng lệnh hoặc menu. Nó không chiếm bàn phím cho tự động hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速智能体聊天可从键盘、命令面板或菜单打开。它不会为自动化操作占用键盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速代理聊天可從鍵盤、命令面板或選單開啟。它不會為自動化操作佔用鍵盤。"
          }
        }
      }
    },
