            "state": "translated",
            "value": "Seules les sessions Claude Code et Codex peuvent s’ouvrir comme discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le sessioni di Claude Code e Codex possono essere aperte come chat."
          }
        },
        "ja": {
