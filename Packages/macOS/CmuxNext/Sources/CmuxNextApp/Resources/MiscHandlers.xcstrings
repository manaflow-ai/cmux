    "handlers.misc.failed.sideQuestionNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a Side Question… opens the chat's composer, so it needs focus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفتح «اطرح سؤالًا جانبيًا…» محرّر الدردشة، لذا يحتاج إلى التركيز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavi sporedno pitanje… otvara polje za pisanje u razgovoru, pa mu treba fokus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stil et sidespørgsmål… åbner chattens skrivefelt, så det kræver fokus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nebenfrage stellen… öffnet das Eingabefeld des Chats und braucht daher den Fokus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hacer una pregunta aparte… abre el editor del chat, así que necesita el foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poser une question annexe… ouvre la zone de saisie de la conversation : elle a besoin du focus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai una domanda a parte… apre il campo di scrittura della chat, quindi richiede il focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドで質問… はチャットの入力欄を開くため、フォーカスが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សួរសំណួរចំហៀង… បើកប្រអប់សរសេររបស់ការជជែក ដូច្នេះវាត្រូវការការផ្ដោត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "곁가지 질문하기…는 채팅 입력창을 열기 때문에 포커스가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Still et sidespørsmål… åpner chattens skrivefelt, så det trenger fokus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadaj pytanie poboczne… otwiera pole wiadomości czatu, więc wymaga fokusu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fazer uma pergunta paralela… abre o campo de mensagem do chat, então precisa de foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Задать побочный вопрос… открывает поле ввода чата, поэтому нужен фокус."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ถามคำถามข้างเคียง… จะเปิดช่องพิมพ์ของแชต จึงต้องมีโฟกัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yan soru sor… sohbetin yazma alanını açar, bu yüzden odak gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поставити побічне запитання… відкриває поле введення чату, тому потрібен фокус."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hỏi câu hỏi bên lề… mở ô soạn tin của cuộc trò chuyện nên cần tiêu điểm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提出旁支问题… 会打开聊天输入框，因此需要焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "提出旁支問題… 會開啟聊天輸入框，因此需要焦點。"
          }
        }
      }
    },
    "handlers.misc.failed.sideQuestionNeedsAgentChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
