    "handlers.misc.failed.checkpointNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkpoint review requires focus. Use git.checkpoint.create for a headless capture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックポイントのレビューにはフォーカスが必要です。ヘッドレスキャプチャにはgit.checkpoint.createを使用します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب مراجعة نقطة التفتيش التركيز. استخدم git.checkpoint.create لالتقاط الصور بدون رأس."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregled kontrolnih tačaka zahtijeva fokus. Koristite git.checkpoint.create za snimanje bez glave."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolpunktsgennemgang kræver fokus. Brug git.checkpoint.create til en hovedløs optagelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkpoint-Review erfordert Fokus. Verwenden Sie git.checkpoint.create für eine kopflose Aufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión del punto de control requiere concentración. Utilice git.checkpoint.create para una captura sin cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'examen des points de contrôle nécessite de la concentration. Utilisez git.checkpoint.create pour une capture sans tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisione del checkpoint richiede attenzione. Usa git.checkpoint.create per una cattura senza testa."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការពិនិត្យមើលចំណុចត្រួតពិនិត្យទាមទារការផ្តោតអារម្មណ៍ ។ ប្រើ git.checkpoint.create សម្រាប់ការចាប់យកដោយគ្មានក្បាល ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크포인트 검토에 집중해야 합니다. git.checkpoint.create를 사용하여 헤드리스 캡처를 수행합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollpunktgjennomgang krever fokus. Bruk git.checkpoint.create for et hodeløst bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd punktu kontrolnego wymaga skupienia. Użyj git.checkpoint.create do przechwytywania bezgłowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão do ponto de verificação requer foco. Use git.checkpoint.create para uma captura sem cabeça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассмотрение контрольных точек требует сосредоточенности. Используйте git.checkpoint.create для безголового захвата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบจุดตรวจสอบต้องให้ความสำคัญใช้ git.checkpoint.create เพื่อจับภาพแบบไม่มีหัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol noktası incelemesi odaklanmayı gerektirir. Başsız bir çekim için git.checkpoint.create kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Огляд контрольних точок вимагає зосередженості. Використовуйте git.checkpoint.create для захоплення без голови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xem xét các điểm kiểm tra đòi hỏi sự tập trung. Sử dụng git.checkpoint.create để chụp không đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查点审核需要重点关注。使用git.checkpoint.create进行无头捕获。"
          }
        },
        "zh-Hant": {
