    "handlers.screenshot.maskFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window's browser pages and chats could not be masked, so the capture was refused"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إخفاء صفحات المتصفح والمحادثات في النافذة، لذا رُفض الالتقاط"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stranice preglednika i chatovi u prozoru nisu se mogli maskirati, pa je snimak odbijen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduets browsersider og chats kunne ikke maskeres, så optagelsen blev afvist"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browserseiten und Chats des Fensters konnten nicht maskiert werden, daher wurde die Aufnahme abgelehnt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron ocultar las páginas del navegador ni los chats de la ventana, así que se rechazó la captura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages de navigateur et les discussions de la fenêtre n’ont pas pu être masquées, la capture a donc été refusée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile mascherare le pagine del browser e le chat della finestra, quindi l’acquisizione è stata rifiutata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウのブラウザページとチャットをマスクできなかったため、キャプチャを拒否しました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបិទបាំងទំព័រកម្មវិធីរុករក និងការជជែកក្នុងបង្អួចបានទេ ដូច្នេះការថតត្រូវបានបដិសេធ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창의 브라우저 페이지와 채팅을 가릴 수 없어 캡처를 거부했습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettleserfanene og chattene i vinduet kunne ikke maskeres, så opptaket ble avvist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zamaskować stron przeglądarki i czatów w oknie, więc zrzut został odrzucony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mascarar as páginas do navegador e os chats da janela, então a captura foi recusada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скрыть страницы браузера и чаты в окне, поэтому снимок отклонён"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถปิดบังหน้าเบราว์เซอร์และแชทในหน้าต่างได้ จึงปฏิเสธการจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Penceredeki tarayıcı sayfaları ve sohbetler maskelenemedi, bu yüzden yakalama reddedildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося приховати сторінки браузера й чати у вікні, тому знімок відхилено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể che các trang trình duyệt và cuộc trò chuyện trong cửa sổ, nên ảnh chụp đã bị từ chối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法遮盖窗口中的浏览器页面和聊天，因此已拒绝截取"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法遮蔽視窗中的瀏覽器頁面和聊天，因此已拒絕擷取"
          }
        }
      }
    },
    "handlers.screenshot.pageNeedsGuardedCapture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser tab is not on screen. Capture its page with `cmux browser page screenshot`, which hides secrets, or show the tab and retry"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة تبويب المتصفح ليست على الشاشة. التقط صفحتها باستخدام `cmux browser page screenshot` الذي يخفي الأسرار، أو اعرض علامة التبويب وأعد المحاولة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica preglednika nije na ekranu. Snimite njenu stranicu pomoću `cmux browser page screenshot`, koji skriva tajne, ili prikažite karticu i pokušajte ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserfanen er ikke på skærmen. Tag dens side med `cmux browser page screenshot`, som skjuler hemmeligheder, eller vis fanen og prøv igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browser-Tab ist nicht auf dem Bildschirm. Nimm seine Seite mit `cmux browser page screenshot` auf, das Geheimnisse verbirgt, oder zeige den Tab und versuche es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña del navegador no está en pantalla. Captura su página con `cmux browser page screenshot`, que oculta los secretos, o muestra la pestaña y vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onglet du navigateur n’est pas à l’écran. Capturez sa page avec `cmux browser page screenshot`, qui masque les secrets, ou affichez l’onglet et réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda del browser non è sullo schermo. Acquisisci la pagina con `cmux browser page screenshot`, che nasconde i segreti, oppure mostra la scheda e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザタブが画面に表示されていません。シークレットを隠す `cmux browser page screenshot` でページをキャプチャするか、タブを表示してから再試行してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងកម្មវិធីរុករកមិននៅលើអេក្រង់ទេ។ ថតទំព័ររបស់វាដោយប្រើ `cmux browser page screenshot` ដែលលាក់ការសម្ងាត់ ឬបង្ហាញផ្ទាំង ហើយព្យាយាមម្ដងទៀត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 탭이 화면에 없습니다. 비밀을 숨겨 주는 `cmux browser page screenshot`으로 페이지를 캡처하거나, 탭을 표시한 뒤 다시 시도하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettleserfanen er ikke på skjermen. Ta bilde av siden med `cmux browser page screenshot`, som skjuler hemmeligheter, eller vis fanen og prøv igjen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta przeglądarki nie jest na ekranie. Zrób zrzut jej strony poleceniem `cmux browser page screenshot`, które ukrywa sekrety, albo pokaż kartę i spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aba do navegador não está na tela. Capture a página com `cmux browser page screenshot`, que oculta segredos, ou mostre a aba e tente de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка браузера не на экране. Снимите её страницу командой `cmux browser page screenshot`, которая скрывает секреты, или покажите вкладку и повторите"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บเบราว์เซอร์ไม่ได้อยู่บนหน้าจอ จับภาพหน้าของแท็บด้วย `cmux browser page screenshot` ซึ่งซ่อนข้อมูลลับ หรือแสดงแท็บแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı sekmesi ekranda değil. Sayfasını sırları gizleyen `cmux browser page screenshot` ile yakalayın ya da sekmeyi gösterip yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки браузера немає на екрані. Зробіть знімок її сторінки командою `cmux browser page screenshot`, яка приховує секрети, або покажіть вкладку й повторіть"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ trình duyệt không hiển thị trên màn hình. Chụp trang của thẻ bằng `cmux browser page screenshot`, lệnh này ẩn các bí mật, hoặc hiển thị thẻ rồi thử lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器标签页不在屏幕上。请用会隐藏机密的 `cmux browser page screenshot` 截取其页面，或显示该标签页后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器分頁不在螢幕上。請用會隱藏機密的 `cmux browser page screenshot` 擷取其頁面，或顯示該分頁後重試"
          }
        }
      }
    },
    "handlers.screenshot.windowChanging": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window kept animating or resizing, so its browser pages and chats could not be masked. Retry when it is still"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمرت النافذة في الحركة أو تغيير الحجم، لذا تعذّر إخفاء صفحات المتصفح والمحادثات فيها. أعد المحاولة عندما تستقر"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozor se stalno animirao ili mijenjao veličinu, pa se njegove stranice preglednika i chatovi nisu mogli maskirati. Pokušajte ponovo kad se smiri"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet blev ved med at animere eller ændre størrelse, så dets browsersider og chats kunne ikke maskeres. Prøv igen, når det står stille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster wurde ständig animiert oder in der Größe geändert, daher konnten seine Browserseiten und Chats nicht maskiert werden. Versuche es erneut, wenn es ruht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana no dejó de animarse o cambiar de tamaño, así que no se pudieron ocultar sus páginas del navegador ni sus chats. Vuelve a intentarlo cuando esté quieta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre n’a pas cessé de s’animer ou de changer de taille, ses pages de navigateur et ses discussions n’ont donc pas pu être masquées. Réessayez quand elle est immobile"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra ha continuato ad animarsi o a ridimensionarsi, quindi non è stato possibile mascherarne le pagine del browser e le chat. Riprova quando è ferma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウのアニメーションやサイズ変更が続いたため、ブラウザページとチャットをマスクできませんでした。ウィンドウが静止してから再試行してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្អួចបន្តមានចលនា ឬប្ដូរទំហំ ដូច្នេះមិនអាចបិទបាំងទំព័រកម្មវិធីរុករក និងការជជែករបស់វាបានទេ។ ព្យាយាមម្ដងទៀតពេលវានៅស្ងៀម"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창이 계속 애니메이션되거나 크기가 바뀌어 브라우저 페이지와 채팅을 가릴 수 없었습니다. 창이 멈춘 뒤 다시 시도하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet fortsatte å animeres eller endre størrelse, så nettlesersidene og chattene kunne ikke maskeres. Prøv igjen når det står stille"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno wciąż się animowało lub zmieniało rozmiar, więc nie udało się zamaskować jego stron przeglądarki i czatów. Spróbuj ponownie, gdy się zatrzyma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela continuou animando ou mudando de tamanho, então não foi possível mascarar as páginas do navegador e os chats. Tente de novo quando ela estiver parada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно продолжало анимироваться или менять размер, поэтому скрыть его страницы браузера и чаты не удалось. Повторите, когда оно замрёт"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างยังคงเคลื่อนไหวหรือเปลี่ยนขนาด จึงไม่สามารถปิดบังหน้าเบราว์เซอร์และแชทได้ ลองอีกครั้งเมื่อหน้าต่างหยุดนิ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere animasyonla değişmeye ya da yeniden boyutlanmaya devam etti, bu yüzden tarayıcı sayfaları ve sohbetleri maskelenemedi. Durduğunda yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно постійно анімувалося або змінювало розмір, тому приховати його сторінки браузера й чати не вдалося. Повторіть, коли воно зупиниться"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ liên tục chuyển động hoặc đổi kích thước, nên không thể che các trang trình duyệt và cuộc trò chuyện. Hãy thử lại khi cửa sổ đứng yên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口一直在播放动画或调整大小，因此无法遮盖其浏览器页面和聊天。请在窗口静止时重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗持續在動畫或調整大小，因此無法遮蔽其瀏覽器頁面和聊天。請在視窗靜止時重試"
          }
        }
      }
    },
