          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่พบแอปชื่อ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ adında bir uygulama bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Програму з назвою %@ не знайдено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không tìm thấy ứng dụng nào tên %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未找到名为 %@ 的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "找不到名為 %@ 的 App。"
          }
        }
      }
