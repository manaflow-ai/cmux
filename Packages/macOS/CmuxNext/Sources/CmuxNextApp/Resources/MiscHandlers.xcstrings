          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente di questo terminale non può essere biforcato. Aprilo come chat per biforcarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルのエージェントはフォークできません。フォークするにはチャットとして開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនៃទែមីណាល់នេះមិនអាចបំបែកបានទេ។ បើកវាជាការជជែក ដើម្បីបំបែកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널의 에이전트는 포크할 수 없습니다. 포크하려면 채팅으로 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten i denne terminalen kan ikke forgrenes. Åpne den som en chat for å forgrene den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenta w tym terminalu nie można rozwidlić. Otwórz go jako czat, aby go rozwidlić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente deste terminal não pode ser bifurcado. Abra-o como chat para bifurcá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агента этого терминала нельзя ответвить. Откройте его как чат, чтобы ответвить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแยกเอเจนต์ของเทอร์มินัลนี้ได้ เปิดเป็นแชตเพื่อแยก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu terminalin ajanı çatallanamaz. Çatallamak için sohbet olarak açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агента цього термінала не можна відгалузити. Відкрийте його як чат, щоб відгалузити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể phân nhánh tác tử của terminal này. Hãy mở nó dưới dạng trò chuyện để phân nhánh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法分叉此终端的代理。请将其作为聊天打开以分叉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法分岔此終端機的代理。請將其作為聊天開啟以分岔。"
          }
        }
      }
