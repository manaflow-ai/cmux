          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent daemon is not running. Open an agent chat to start it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El daemon de agentes no se está ejecutando. Abre un chat de agente para iniciarlo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le démon des agents ne tourne pas. Ouvrez une conversation d’agent pour le lancer, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il daemon degli agenti non è in esecuzione. Apri una chat con un agente per avviarlo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントデーモンが動いていません。エージェントチャットを開いて起動してから、もう一度試してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដេមិនភ្នាក់ងារមិនដំណើរការទេ។ បើកការជជែកភ្នាក់ងារដើម្បីចាប់ផ្ដើម រួចសាកម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트 데몬이 실행 중이 아닙니다. 에이전트 채팅을 열어 시작한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agentdemonen kjører ikke. Åpne en agentchat for å starte den, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demon agentów nie działa. Otwórz czat z agentem, aby go uruchomić, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O daemon de agentes não está em execução. Abra um chat de agente para iniciá-lo e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Демон агентов не запущен. Откройте чат с агентом, чтобы запустить его, и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ดีมอนเอเจนต์ไม่ทำงาน เปิดแชทเอเจนต์เพื่อเริ่ม แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aracı arka plan programı çalışmıyor. Başlatmak için bir aracı sohbeti açın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Демон агентів не запущено. Відкрийте чат з агентом, щоб запустити його, і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trình nền tác tử không chạy. Mở một cuộc trò chuyện tác tử để khởi động, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "智能体守护进程未运行。打开智能体聊天以启动它，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "代理常駐程式未執行。開啟代理聊天以啟動它，然後再試一次。"
          }
        }
      }
