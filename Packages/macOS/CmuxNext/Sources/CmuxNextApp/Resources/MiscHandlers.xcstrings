        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ថែម harness… បើកទំព័រ harness ពីផ្ទាំងពាក្យបញ្ជា ឬម៉ឺនុយ។ ស្វ័យប្រវត្តិកម្មដំណើរការ cmux harness guide ជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "하네스 추가…는 팔레트나 메뉴에서 하네스 페이지를 엽니다. 자동화에서는 대신 cmux harness guide를 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legg til harness… åpner siden Harnesses fra paletten eller menyen. Automatisering kjører cmux harness guide i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaj harness… otwiera stronę harnessów z palety lub menu. Automatyzacja uruchamia zamiast tego cmux harness guide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicionar harness… abre a página de harnesses pela paleta ou pelo menu. A automação executa cmux harness guide em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Добавить харнесс…» открывает страницу харнессов из палитры или меню. Автоматизация вместо этого запускает cmux harness guide."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่ม harness… จะเปิดหน้า Harnesses จากพาเลตหรือเมนู ระบบอัตโนมัติให้เรียกใช้ cmux harness guide แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harness ekle… paletten veya menüden Harness'ler sayfasını açar. Otomasyon bunun yerine cmux harness guide çalıştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Додати харнес…» відкриває сторінку харнесів із палітри або меню. Автоматизація натомість запускає cmux harness guide."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thêm harness… mở trang Harness từ bảng lệnh hoặc menu. Tự động hóa chạy cmux harness guide thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“添加 Harness…”从命令面板或菜单打开 Harness 页面。自动化请改为运行 cmux harness guide。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「新增 Harness…」會從命令面板或選單開啟 Harness 頁面。自動化請改為執行 cmux harness guide。"
          }
        }
      }
    },
    "handlers.misc.defaultBrowserIsCmux": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
