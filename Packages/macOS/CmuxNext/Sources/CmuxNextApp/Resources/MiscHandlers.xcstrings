    "handlers.misc.failed.fileNotInTab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens in the editor, not in a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はタブではなくエディタで開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح %@ في المحرر، وليس في علامة تبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se otvara u uređivaču, ne u kartici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ åbnes i editoren, ikke i en fane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet sich im Editor, nicht in einem Tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se abre en el editor, no en una pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’ouvre dans l’éditeur, pas dans un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ si apre nell’editor, non in una scheda."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ បើកក្នុងកម្មវិធីកែសម្រួល មិនមែនក្នុងផ្ទាំងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 탭이 아니라 편집기에서 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ åpnes i redigeringsprogrammet, ikke i en fane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ otwiera się w edytorze, nie w karcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ abre no editor, não em uma aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ открывается в редакторе, а не во вкладке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ เปิดในตัวแก้ไข ไม่ใช่ในแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bir sekmede değil, düzenleyicide açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ відкривається в редакторі, а не у вкладці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ mở trong trình soạn thảo, không mở trong thẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在编辑器中打开，而不是在标签页中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會在編輯器中開啟，而不是在分頁中。"
          }
        }
      }
    },
    "handlers.misc.failed.noEditor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app on this Mac edits text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはテキストを編集するアプリがありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تطبيق على جهاز Mac هذا لتحرير النصوص."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedna aplikacija na ovom Macu ne uređuje tekst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen app på denne Mac redigerer tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App auf diesem Mac bearbeitet Text."
