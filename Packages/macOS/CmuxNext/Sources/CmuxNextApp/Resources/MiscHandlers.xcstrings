          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest odcień. Użyj none, nazwy koloru lub #RRGGBB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é uma tonalidade. Use none, um nome de cor ou #RRGGBB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не оттенок. Используйте none, название цвета или #RRGGBB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่โทนสี ใช้ none, ชื่อสี หรือ #RRGGBB"
          }
        },
        "tr": {
          "stringUnit": {
