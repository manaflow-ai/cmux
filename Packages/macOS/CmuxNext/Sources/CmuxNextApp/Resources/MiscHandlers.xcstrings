  "sourceLanguage": "en",
  "strings": {
    "handlers.misc.failed.invalidURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a URL cmux can open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は cmux で開ける URL ではありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ليس URL يمكن لـ cmux فتحه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nije URL koji cmux može otvoriti."
