    "handlers.misc.refusal.pickerNeedsFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picker opens only when focus is requested."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピッカーはフォーカスが要求されたときにのみ開きます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يفتح المنتقي إلا عند طلب التركيز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Birač se otvara samo kada se zatraži fokus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælgeren åbner kun, når der anmodes om fokus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Auswahl öffnet sich nur, wenn der Fokus angefordert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector solo se abre cuando se solicita el foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sélecteur ne s’ouvre que si le focus est demandé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il selettore si apre solo quando viene richiesto il focus."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីជ្រើសរើសបើកតែនៅពេលស្នើសុំការផ្ដោតប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
