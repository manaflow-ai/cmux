        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウは Dock にしまわれています。cmux はスクリーンショットのために元に戻しません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្អួចត្រូវបានបង្រួមក្នុង Dock; cmux មិនស្ដារវាសម្រាប់ការថតអេក្រង់ទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 Dock으로 최소화되어 있습니다. cmux는 스크린샷을 위해 윈도우를 복원하지 않습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinduet er minimert i Dock; cmux gjenoppretter det ikke for et skjermbilde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno jest zminimalizowane w Docku; cmux nie przywraca go dla zrzutu ekranu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela está minimizada no Dock; o cmux não a restaura para uma captura de tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно свёрнуто в Dock; cmux не разворачивает его ради снимка"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างถูกย่อไว้ใน Dock และ cmux จะไม่คืนหน้าต่างเพื่อถ่ายภาพหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere Dock’a küçültülmüş; cmux ekran görüntüsü için onu geri açmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікно згорнуто в Dock; cmux не розгортає його заради знімка"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ đang thu nhỏ trong Dock; cmux không khôi phục nó để chụp ảnh màn hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
