          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno nie jest na ekranie (aplikacja jest ukryta albo okno jest zamknięte)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela não está na tela (o app está oculto ou a janela está fechada)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна нет на экране (приложение скрыто или окно закрыто)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างไม่อยู่บนหน้าจอ (แอปถูกซ่อนหรือหน้าต่างถูกปิด)"
