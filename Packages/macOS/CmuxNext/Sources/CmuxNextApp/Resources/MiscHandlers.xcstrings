    "handlers.misc.failed.unknownBrowserProfile": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ليس ملف تعريف متصفح. استخدم \"agent\" أو معرّف ملف تعريف موجود."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nije profil preglednika. Koristite \"agent\" ili ID postojećeg profila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ er ikke en browserprofil. Brug \"agent\" eller id'et for en eksisterende profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ist kein Browserprofil. Verwenden Sie \"agent\" oder die ID eines vorhandenen Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a browser profile. Use \"agent\" or the id of an existing profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ no es un perfil del navegador. Usa \"agent\" o el id de un perfil existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ n’est pas un profil de navigateur. Utilisez « agent » ou l’identifiant d’un profil existant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ non è un profilo del browser. Usa \"agent\" o l’id di un profilo esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はブラウザプロファイルではありません。\"agent\" または既存のプロファイルの ID を使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ មិនមែនជាប្រវត្តិរូបកម្មវិធីរុករកទេ។ ប្រើ \"agent\" ឬ id នៃប្រវត្តិរូបដែលមានស្រាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 브라우저 프로필이 아닙니다. \"agent\" 또는 기존 프로필의 ID를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ er ikke en nettleserprofil. Bruk \"agent\" eller ID-en til en eksisterende profil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ nie jest profilem przeglądarki. Użyj \"agent\" lub identyfikatora istniejącego profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ não é um perfil do navegador. Use \"agent\" ou o id de um perfil existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не является профилем браузера. Используйте \"agent\" или id существующего профиля."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ไม่ใช่โปรไฟล์เบราว์เซอร์ ใช้ \"agent\" หรือ id ของโปรไฟล์ที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bir tarayıcı profili değil. \"agent\" ya da mevcut bir profilin kimliğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ не є профілем браузера. Використайте \"agent\" або id наявного профілю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ không phải là hồ sơ trình duyệt. Dùng \"agent\" hoặc id của một hồ sơ hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不是浏览器配置文件。请使用 \"agent\" 或现有配置文件的 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 不是瀏覽器設定檔。請使用 \"agent\" 或現有設定檔的 ID。"
          }
        }
      }
    },
