    "handlers.paneBackground.badBackground": {
      "comment": "Refusal: the pane background value is not one cmux knows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a background. Use inherit, none, daily, desktop, a painting, or a system: or file: path."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست خلفية. استخدم inherit أو none أو daily أو desktop أو لوحة أو مسار system: أو file:."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pozadina. Koristite inherit, none, daily, desktop, sliku ili putanju system: ili file:."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke en baggrund. Brug inherit, none, daily, desktop, et maleri eller en system:- eller file:-sti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Hintergrund. Verwende inherit, none, daily, desktop, ein Gemälde oder einen system:- oder file:-Pfad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un fondo. Usa inherit, none, daily, desktop, una pintura o una ruta system: o file:."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un arrière-plan. Utilisez inherit, none, daily, desktop, un tableau ou un chemin system: ou file:."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è uno sfondo. Usa inherit, none, daily, desktop, un dipinto o un percorso system: o file:."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景ではありません。inherit、none、daily、desktop、絵画、または system: か file: のパスを使ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមែនជាផ្ទៃខាងក្រោយទេ។ ប្រើ inherit, none, daily, desktop, គំនូរ ឬផ្លូវ system: ឬ file:។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경이 아닙니다. inherit, none, daily, desktop, 그림 또는 system: 또는 file: 경로를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke en bakgrunn. Bruk inherit, none, daily, desktop, et maleri eller en system:- eller file:-bane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest tło. Użyj inherit, none, daily, desktop, obrazu lub ścieżki system: albo file:."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é um fundo. Use inherit, none, daily, desktop, uma pintura ou um caminho system: ou file:."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не фон. Используйте inherit, none, daily, desktop, картину или путь system: или file:."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่พื้นหลัง ใช้ inherit, none, daily, desktop, ภาพวาด หรือพาธ system: หรือ file:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan değil. inherit, none, daily, desktop, bir tablo ya da system: veya file: yolu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не тло. Використовуйте inherit, none, daily, desktop, картину або шлях system: чи file:."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải hình nền. Dùng inherit, none, daily, desktop, một bức tranh, hoặc đường dẫn system: hay file:."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是背景。请使用 inherit、none、daily、desktop、画作，或 system: 或 file: 路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是背景。請使用 inherit、none、daily、desktop、畫作，或 system: 或 file: 路徑。"
          }
        }
      }
    },
    "handlers.paneBackground.badTint": {
      "comment": "Refusal: the pane tint value is not a known color.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
