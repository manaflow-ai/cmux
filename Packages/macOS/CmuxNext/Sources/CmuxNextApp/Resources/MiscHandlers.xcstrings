    "handlers.screenshot.terminalNotShown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal tab is not on screen. Read its text with `cmux terminal <id> screen read`, or show its workspace and retry"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علامة تبويب الطرفية ليست على الشاشة. اقرأ نصها باستخدام `cmux terminal <id> screen read`، أو اعرض مساحة العمل الخاصة بها وأعد المحاولة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica terminala nije na ekranu. Pročitajte njen tekst pomoću `cmux terminal <id> screen read` ili prikažite njen radni prostor i pokušajte ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalfanen er ikke på skærmen. Læs dens tekst med `cmux terminal <id> screen read`, eller vis dens arbejdsområde og prøv igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Terminal-Tab ist nicht auf dem Bildschirm. Lies seinen Text mit `cmux terminal <id> screen read` oder zeige seinen Workspace und versuche es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña de terminal no está en pantalla. Lee su texto con `cmux terminal <id> screen read`, o muestra su espacio de trabajo y vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onglet de terminal n’est pas à l’écran. Lisez son texte avec `cmux terminal <id> screen read`, ou affichez son espace de travail et réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda del terminale non è sullo schermo. Leggine il testo con `cmux terminal <id> screen read`, oppure mostra il suo workspace e riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルタブが画面上にありません。`cmux terminal <id> screen read` でテキストを読むか、そのワークスペースを表示してからやり直してください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថេបទែមីណាល់មិននៅលើអេក្រង់ទេ។ អានអត្ថបទរបស់វាដោយ `cmux terminal <id> screen read` ឬបង្ហាញកន្លែងធ្វើការរបស់វា ហើយព្យាយាមម្ដងទៀត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 탭이 화면에 없습니다. `cmux terminal <id> screen read`로 텍스트를 읽거나, 해당 작업 공간을 표시한 뒤 다시 시도하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalfanen er ikke på skjermen. Les teksten med `cmux terminal <id> screen read`, eller vis arbeidsområdet og prøv igjen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty terminala nie ma na ekranie. Odczytaj jej tekst za pomocą `cmux terminal <id> screen read` albo pokaż jej obszar roboczy i spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aba do terminal não está na tela. Leia o texto dela com `cmux terminal <id> screen read`, ou mostre o espaço de trabalho dela e tente de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки терминала нет на экране. Прочитайте её текст командой `cmux terminal <id> screen read` или покажите её рабочее пространство и повторите"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บเทอร์มินัลไม่อยู่บนหน้าจอ อ่านข้อความด้วย `cmux terminal <id> screen read` หรือแสดงพื้นที่ทำงานของแท็บนี้แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal sekmesi ekranda değil. Metnini `cmux terminal <id> screen read` ile okuyun ya da çalışma alanını gösterip yeniden deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки термінала немає на екрані. Прочитайте її текст командою `cmux terminal <id> screen read` або покажіть її робочий простір і повторіть"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab terminal không có trên màn hình. Hãy đọc văn bản của nó bằng `cmux terminal <id> screen read`, hoặc hiển thị không gian làm việc của nó rồi thử lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端标签页不在屏幕上。可用 `cmux terminal <id> screen read` 读取其文本，或显示其工作区后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機標籤頁不在螢幕上。可用 `cmux terminal <id> screen read` 讀取其文字，或顯示其工作區後重試"
          }
        }
      }
    },
