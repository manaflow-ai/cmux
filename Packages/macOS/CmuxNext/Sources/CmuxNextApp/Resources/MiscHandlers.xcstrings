          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Демон не может отметить уведомление непрочитанным."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "daemon ไม่สามารถทำเครื่องหมายการแจ้งเตือนว่ายังไม่อ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
