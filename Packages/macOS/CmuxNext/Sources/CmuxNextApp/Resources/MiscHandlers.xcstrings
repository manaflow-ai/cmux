      }
    },
    "handlers.misc.failed.terminalChatNoSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The focused terminal runs no agent session to open as a chat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشغّل الطرفية المركّز عليها أي جلسة وكيل يمكن فتحها كمحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusirani terminal ne pokreće sesiju agenta koja se može otvoriti kao chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fokuserede terminal kører ingen agentsession, der kan åbnes som chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im fokussierten Terminal läuft keine Agentensitzung, die sich als Chat öffnen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El terminal enfocado no ejecuta ninguna sesión de agente que se pueda abrir como chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal actif n’exécute aucune session d’agent à ouvrir comme discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale attivo non esegue alcuna sessione agente da aprire come chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたターミナルでは、チャットとして開けるエージェントセッションが実行されていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទែមីណាល់ដែលកំពុងផ្ដោតមិនដំណើរការវគ្គភ្នាក់ងារណាមួយដែលអាចបើកជាការជជែកបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 터미널에서 채팅으로 열 수 있는 에이전트 세션이 실행되고 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fokuserte terminalen kjører ingen agentøkt som kan åpnes som chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W aktywnym terminalu nie działa żadna sesja agenta, którą można otworzyć jako czat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal em foco não executa nenhuma sessão de agente para abrir como chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В активном терминале не запущен сеанс агента, который можно открыть как чат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลที่โฟกัสอยู่ไม่ได้เรียกใช้เซสชันเอเจนต์ที่เปิดเป็นแชตได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaktaki terminalde sohbet olarak açılabilecek bir ajan oturumu çalışmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В активному терміналі не запущено сеансу агента, який можна відкрити як чат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal đang được chọn không chạy phiên tác tử nào để mở dưới dạng trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前聚焦的终端没有运行可作为聊天打开的代理会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前聚焦的終端機沒有執行可作為聊天開啟的代理工作階段。"
          }
        }
      }
