    "handlers.misc.failed.terminalChatHarness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Claude Code and Codex sessions can open as a chat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح جلسات Claude Code وCodex فقط كمحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo Claude Code i Codex sesije se mogu otvoriti kao chat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Claude Code- og Codex-sessioner kan åbnes som chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Claude Code- und Codex-Sitzungen lassen sich als Chat öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las sesiones de Claude Code y Codex se pueden abrir como chat."
          }
        },
