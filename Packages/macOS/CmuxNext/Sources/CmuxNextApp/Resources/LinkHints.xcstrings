        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីត្រូវចុចនៅក្នុងបង្អួចនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 윈도우에는 클릭할 항목이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting å klikke på i dette vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym oknie nie ma nic do kliknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para clicar nesta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом окне нечего нажимать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งใดให้คลิกในหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencerede tıklanacak bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому вікні нічого натискати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì để nhấp trong cửa sổ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口中没有可点击的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此視窗中沒有可點按的項目。"
          }
        }
      }
    }
  },
