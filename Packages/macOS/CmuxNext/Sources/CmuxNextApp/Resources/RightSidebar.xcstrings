{
  "sourceLanguage": "en",
  "strings": {
    "rightSidebar.dock.dockFocused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock Focused Column"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تثبيت العمود المحدد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Usidri fokusiranu kolonu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør den fokuserede kolonne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokussierte Spalte andocken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoplar la columna enfocada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancrer la colonne active"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggancia la colonna attiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中の列をドック"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្ជាប់ជួរឈរដែលកំពុងផ្ដោត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 열 도킹"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forankre kolonnen i fokus"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadokuj aktywną kolumnę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixar a coluna em foco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепить активный столбец"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปักหมุดคอลัมน์ที่โฟกัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaktaki Sütunu Sabitle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріпити активний стовпець"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghim cột đang chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停靠当前列"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停駐目前的欄"
          }
        }
      }
    },
    "rightSidebar.dock.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No docked columns on this screen. A docked column stays at the edge while the others scroll."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أعمدة مثبتة في هذه الشاشة. يبقى العمود المثبت عند الحافة بينما تتمرر الأعمدة الأخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovom ekranu nema usidrenih kolona. Usidrena kolona ostaje na rubu dok se ostale pomiču."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fastgjorte kolonner på denne skærm. En fastgjort kolonne bliver ved kanten, mens de andre ruller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine angedockten Spalten auf diesem Bildschirm. Eine angedockte Spalte bleibt am Rand, während die anderen scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay columnas acopladas en esta pantalla. Una columna acoplada se queda en el borde mientras las demás se desplazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune colonne ancrée sur cet écran. Une colonne ancrée reste au bord pendant que les autres défilent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna colonna agganciata in questa schermata. Una colonna agganciata resta sul bordo mentre le altre scorrono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面にドックされた列はありません。ドックされた列は、ほかの列がスクロールしても端にとどまります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានជួរឈរដែលបានភ្ជាប់នៅលើអេក្រង់នេះទេ។ ជួរឈរដែលបានភ្ជាប់នៅតែនៅគែម ខណៈដែលជួរផ្សេងទៀតរំកិល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에 도킹된 열이 없습니다. 도킹된 열은 다른 열이 스크롤되는 동안 가장자리에 머뭅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen forankrede kolonner på denne skjermen. En forankret kolonne blir ved kanten mens de andre ruller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zadokowanych kolumn na tym ekranie. Zadokowana kolumna zostaje przy krawędzi, gdy pozostałe się przewijają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há colunas encaixadas nesta tela. Uma coluna encaixada fica na borda enquanto as outras rolam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом экране нет закреплённых столбцов. Закреплённый столбец остаётся у края, пока остальные прокручиваются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีคอลัมน์ที่ปักหมุดบนหน้าจอนี้ คอลัมน์ที่ปักหมุดจะอยู่ที่ขอบขณะที่คอลัมน์อื่นเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekranda sabitlenmiş sütun yok. Sabitlenmiş bir sütun diğerleri kayarken kenarda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому екрані немає закріплених стовпців. Закріплений стовпець лишається біля краю, поки інші прокручуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có cột nào được ghim trên màn hình này. Cột được ghim nằm yên ở cạnh trong khi các cột khác cuộn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏幕上没有停靠的列。停靠的列会留在边缘，其他列照常滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此畫面上沒有停駐的欄。停駐的欄會留在邊緣，其他欄照常捲動。"
          }
        }
      }
    },
