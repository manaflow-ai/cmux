    "keybinding.error.missingKeys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "keybinding.resolve requires params.keys (for example \"ctrl+k s\")."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "keybinding.resolve には params.keys が必要です（例: \"ctrl+k s\"）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب keybinding.resolve المعامل params.keys (مثلاً \"ctrl+k s\")."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve zahtijeva params.keys (na primjer \"ctrl+k s\")."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve kræver params.keys (for eksempel \"ctrl+k s\")."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve benötigt params.keys (zum Beispiel \"ctrl+k s\")."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve requiere params.keys (por ejemplo \"ctrl+k s\")."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve nécessite params.keys (par exemple \"ctrl+k s\")."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve richiede params.keys (per esempio \"ctrl+k s\")."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve ត្រូវការ params.keys (ឧទាហរណ៍ \"ctrl+k s\")។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve에는 params.keys가 필요합니다(예: \"ctrl+k s\")."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve krever params.keys (for eksempel \"ctrl+k s\")."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve wymaga params.keys (na przykład \"ctrl+k s\")."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve requer params.keys (por exemplo \"ctrl+k s\")."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve требует params.keys (например, \"ctrl+k s\")."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve ต้องมี params.keys (เช่น \"ctrl+k s\")"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve params.keys gerektirir (örneğin \"ctrl+k s\")."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve потребує params.keys (наприклад, \"ctrl+k s\")."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve cần params.keys (ví dụ \"ctrl+k s\")."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve 需要 params.keys（例如 \"ctrl+k s\"）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "keybinding.resolve 需要 params.keys（例如 \"ctrl+k s\"）。"
          }
        }
      }
