    "keybinding.error.needsKeybindingsJSON": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.json holds one shortcut per action, with no When clause or arguments. This change needs keybindings.json, which is not ready yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux.json には、アクションごとに When 条件と引数のないショートカットを1つだけ保存できます。この変更には keybindings.json が必要ですが、まだ準備できていません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحفظ cmux.json اختصارًا واحدًا لكل إجراء بدون شرط When أو وسيطات. يحتاج هذا التغيير إلى keybindings.json، وهو غير جاهز بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json čuva jednu prečicu po radnji, bez uvjeta When i argumenata. Ova promjena treba keybindings.json, koji još nije spreman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json gemmer én genvej pr. handling uden When-betingelse eller argumenter. Denne ændring kræver keybindings.json, som ikke er klar endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json speichert ein Kürzel pro Aktion, ohne When-Bedingung oder Argumente. Diese Änderung braucht keybindings.json, das noch nicht bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json guarda un atajo por acción, sin condición When ni argumentos. Este cambio necesita keybindings.json, que aún no está listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json enregistre un raccourci par action, sans condition When ni arguments. Cette modification nécessite keybindings.json, qui n’est pas encore prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json salva una scorciatoia per azione, senza condizione When né argomenti. Questa modifica richiede keybindings.json, che non è ancora pronto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json រក្សាទុកផ្លូវកាត់មួយក្នុងមួយសកម្មភាព ដោយគ្មានលក្ខខណ្ឌ When ឬអាគុយម៉ង់។ ការផ្លាស់ប្ដូរនេះត្រូវការ keybindings.json ដែលមិនទាន់រួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json은 동작마다 When 조건과 인수가 없는 단축키 하나만 저장합니다. 이 변경에는 keybindings.json이 필요하지만 아직 준비되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json lagrer én snarvei per handling, uten When-betingelse eller argumenter. Denne endringen trenger keybindings.json, som ikke er klar ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json zapisuje jeden skrót na akcję, bez warunku When i argumentów. Ta zmiana wymaga pliku keybindings.json, który nie jest jeszcze gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux.json guarda um atalho por ação, sem condição When nem argumentos. Esta alteração precisa do keybindings.json, que ainda não está pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json хранит одно сочетание на действие, без условия When и аргументов. Для этого изменения нужен keybindings.json, который ещё не готов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json เก็บทางลัดหนึ่งรายการต่อการทำงาน โดยไม่มีเงื่อนไข When หรืออาร์กิวเมนต์ การเปลี่ยนแปลงนี้ต้องใช้ keybindings.json ซึ่งยังไม่พร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json her eylem için When koşulu ve argüman olmadan bir kısayol saklar. Bu değişiklik henüz hazır olmayan keybindings.json gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json зберігає одне сполучення на дію, без умови When і аргументів. Ця зміна потребує keybindings.json, який ще не готовий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json lưu một phím tắt cho mỗi tác vụ, không có điều kiện When hay đối số. Thay đổi này cần keybindings.json, hiện chưa sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json 为每个操作保存一个快捷键，不含 When 条件或参数。此更改需要 keybindings.json，但它尚未就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux.json 為每個動作儲存一個快速鍵，不含 When 條件或引數。此變更需要 keybindings.json，但它尚未就緒。"
          }
        }
      }
    },
