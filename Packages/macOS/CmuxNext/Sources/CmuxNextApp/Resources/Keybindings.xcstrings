{
  "sourceLanguage": "en",
  "strings": {
    "keybinding.error.editingUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing key bindings needs keybindings.json support, which is not ready yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーバインドの編集には keybindings.json のサポートが必要ですが、まだ準備できていません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب تعديل اختصارات المفاتيح دعم keybindings.json، وهو غير جاهز بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uređivanje prečica zahtijeva podršku za keybindings.json, koja još nije spremna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redigering af tastebindinger kræver understøttelse af keybindings.json, som ikke er klar endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Bearbeiten von Tastenbelegungen benötigt keybindings.json, das noch nicht bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Editar atajos requiere compatibilidad con keybindings.json, que aún no está lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modification des raccourcis nécessite keybindings.json, qui n'est pas encore prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modifica delle scorciatoie richiede il supporto di keybindings.json, non ancora pronto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការកែផ្លូវកាត់ត្រូវការការគាំទ្រ keybindings.json ដែលមិនទាន់រួចរាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키 바인딩을 편집하려면 keybindings.json 지원이 필요하지만 아직 준비되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Redigering av hurtigtaster krever støtte for keybindings.json, som ikke er klar ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Edycja skrótów wymaga obsługi keybindings.json, która nie jest jeszcze gotowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Editar atalhos requer suporte a keybindings.json, que ainda não está pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для изменения сочетаний клавиш нужна поддержка keybindings.json, она ещё не готова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การแก้ไขแป้นลัดต้องใช้ keybindings.json ซึ่งยังไม่พร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kısayolları düzenlemek keybindings.json desteği gerektirir; bu henüz hazır değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для редагування сполучень клавіш потрібна підтримка keybindings.json, яка ще не готова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sửa phím tắt cần hỗ trợ keybindings.json, hiện chưa sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "编辑键绑定需要 keybindings.json 支持，目前尚未就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "編輯按鍵綁定需要 keybindings.json 支援，目前尚未就緒。"
          }
        }
      }
    },
