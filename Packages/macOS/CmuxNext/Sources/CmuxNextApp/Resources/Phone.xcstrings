    "phone.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the cmux iPhone app to connect"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "السماح لتطبيق cmux على iPhone بالاتصال"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoli cmux iPhone aplikaciji da se poveže"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad cmux-appen på iPhone at oprette forbindelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verbindung der cmux iPhone-App erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que la app cmux para iPhone se conecte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser l’app cmux pour iPhone à se connecter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti all’app cmux per iPhone di connettersi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux iPhone アプリの接続を許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យកម្មវិធី cmux iPhone ភ្ជាប់"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux iPhone 앱의 연결 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillat cmux-appen for iPhone å koble til"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwalaj aplikacji cmux na iPhone’a na łączenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que o app cmux para iPhone se conecte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить приложению cmux для iPhone подключаться"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้แอป cmux บน iPhone เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux iPhone uygulamasının bağlanmasına izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити застосунку cmux для iPhone підключатися"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép ứng dụng cmux trên iPhone kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许 cmux iPhone App 连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許 cmux iPhone App 連線"
          }
        }
      }
    },
    "phone.allow.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone reaches this Mac's terminals over an encrypted link, direct or relayed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يصل iPhone إلى طرفيات هذا الـ Mac عبر اتصال مشفّر، مباشر أو عبر مُرحِّل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaš iPhone pristupa terminalima ovog Maca preko šifrirane veze, direktno ili preko releja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Din iPhone når denne Macs terminaler via en krypteret forbindelse, direkte eller via relæ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein iPhone erreicht die Terminals dieses Mac über eine verschlüsselte Verbindung, direkt oder über ein Relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu iPhone accede a los terminales de este Mac mediante un enlace cifrado, directo o retransmitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre iPhone accède aux terminaux de ce Mac via une liaison chiffrée, directe ou relayée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo iPhone raggiunge i terminali di questo Mac tramite un collegamento cifrato, diretto o tramite relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone は暗号化された接続（直接またはリレー経由）でこの Mac のターミナルにアクセスします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone របស់អ្នកចូលដល់ terminal របស់ Mac នេះតាមតំណដែលបានអ៊ិនគ្រីប ដោយផ្ទាល់ ឬតាម relay។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone은 암호화된 연결(직접 또는 릴레이)로 이 Mac의 터미널에 접속합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhonen din når terminalene på denne Macen via en kryptert forbindelse, direkte eller via relé."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twój iPhone łączy się z terminalami tego Maca przez szyfrowane połączenie, bezpośrednie lub przez przekaźnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu iPhone acessa os terminais deste Mac por um link criptografado, direto ou retransmitido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone подключается к терминалам этого Mac по зашифрованному каналу, напрямую или через ретранслятор."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone ของคุณเข้าถึงเทอร์มินัลของ Mac เครื่องนี้ผ่านลิงก์ที่เข้ารหัส ทั้งแบบตรงหรือผ่านรีเลย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone’unuz bu Mac’in terminallerine doğrudan ya da aktarıcı üzerinden şifreli bir bağlantıyla ulaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone під’єднується до терміналів цього Mac через зашифрований канал, напряму або через ретранслятор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone của bạn truy cập các terminal của máy Mac này qua liên kết được mã hóa, trực tiếp hoặc qua chuyển tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 iPhone 通过加密连接（直连或中继）访问这台 Mac 的终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的 iPhone 透過加密連線（直接或中繼）存取這台 Mac 的終端機。"
          }
        }
      }
    },
