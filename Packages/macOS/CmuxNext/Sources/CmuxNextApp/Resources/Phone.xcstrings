    "phone.reset.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgets this Mac's registration. Paired iPhones pair again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينسى تسجيل هذا الـ Mac. يجب إقران أجهزة iPhone مجددًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaboravlja registraciju ovog Maca. Upareni iPhone uređaji se ponovo uparuju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glemmer denne Macs registrering. Parrede iPhones skal parres igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergisst die Registrierung dieses Mac. Gekoppelte iPhones müssen neu gekoppelt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olvida el registro de este Mac. Los iPhone enlazados deben enlazarse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oublie l’enregistrement de ce Mac. Les iPhone jumelés doivent être jumelés à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dimentica la registrazione di questo Mac. Gli iPhone abbinati vanno abbinati di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac の登録を削除します。ペアリング済みの iPhone は再度ペアリングが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បំភ្លេចការចុះឈ្មោះ Mac នេះ។ iPhone ដែលបានផ្គូផ្គងត្រូវផ្គូផ្គងម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac의 등록을 삭제합니다. 페어링된 iPhone은 다시 페어링해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glemmer registreringen av denne Macen. Parede iPhoner må pares på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuwa rejestrację tego Maca. Sparowane iPhone’y trzeba sparować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esquece o registro deste Mac. iPhones pareados precisam ser pareados de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляет регистрацию этого Mac. Связанные iPhone нужно связать заново."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลบการลงทะเบียนของ Mac เครื่องนี้ iPhone ที่จับคู่ไว้ต้องจับคู่ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’in kaydını siler. Eşlenmiş iPhone’lar yeniden eşlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Видаляє реєстрацію цього Mac. Під’єднані iPhone потрібно під’єднати знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xóa đăng ký của máy Mac này. Các iPhone đã ghép đôi cần ghép đôi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移除这台 Mac 的注册。已配对的 iPhone 需要重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "移除這台 Mac 的註冊。已配對的 iPhone 需要重新配對。"
          }
        }
      }
    }
  },
