{
  "sourceLanguage": "en",
  "strings": {
    "phone.feedback.chiefNotRunning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief لا يعمل. تم حفظ التسجيل؛ أرسله مرة أخرى لاحقًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief nije pokrenut. Snimak je sačuvan; pošaljite ga ponovo kasnije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief kører ikke. Optagelsen er gemt; send den igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief läuft nicht. Die Aufnahme ist gespeichert; sende sie später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief is not running. The recording is saved; send it again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief no se está ejecutando. La grabación está guardada; envíala de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief n’est pas lancé. L’enregistrement est conservé ; renvoyez-le plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief non è in esecuzione. La registrazione è salvata; inviala di nuovo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief が実行されていません。録画は保存されています。後でもう一度送信してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief មិនកំពុងដំណើរការទេ។ ការថតត្រូវបានរក្សាទុក សូមផ្ញើម្ដងទៀតពេលក្រោយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief가 실행 중이 아닙니다. 녹화는 저장되었으니 나중에 다시 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief kjører ikke. Opptaket er lagret; send det på nytt senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief nie działa. Nagranie zostało zapisane; wyślij je ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief não está em execução. A gravação foi salva; envie-a novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief не запущен. Запись сохранена; отправьте её позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ไม่ได้ทำงานอยู่ การบันทึกถูกเก็บไว้แล้ว ส่งอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief çalışmıyor. Kayıt saklandı; daha sonra yeniden gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief не запущено. Запис збережено; надішліть його пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief không chạy. Bản ghi đã được lưu; hãy gửi lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 未运行。录制已存储，请稍后重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 未執行。錄製已儲存，請稍後重新傳送。"
          }
        }
      }
    },
