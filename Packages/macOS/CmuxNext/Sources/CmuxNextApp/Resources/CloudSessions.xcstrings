{
  "sourceLanguage": "en",
  "strings": {
    "cloud.startSession.start": {
      "comment": "Button on the card: start the agent session.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Start"}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Starten"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Démarrer"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Iniciar"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدء"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "시작"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "启动"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "啟動"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Pokreni"}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kør"}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Avvia"}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ចាប់ផ្ដើម"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kjør"}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Uruchom"}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Iniciar"}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Запустить"}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เริ่ม"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Başlat"}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Запустити"}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Bắt đầu"}}
      }
    },
    "cloud.startSession.noPage": {
      "comment": "The card couldn't show in the chat. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't show the question in the chat, so %2$@ didn't start on %1$@. Run `%3$@` again once the chat is open."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チャットに確認を表示できなかったため、%1$@ で %2$@ は開始されませんでした。チャットを開いてから `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Frage konnte im Chat nicht angezeigt werden, daher wurde %2$@ auf %1$@ nicht gestartet. Führe `%3$@` erneut aus, sobald der Chat geöffnet ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d'afficher la question dans la discussion : %2$@ n'a pas démarré sur %1$@. Relancez `%3$@` une fois la discussion ouverte."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo mostrar la pregunta en el chat, así que %2$@ no se inició en %1$@. Vuelve a ejecutar `%3$@` cuando el chat esté abierto."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر عرض السؤال في الدردشة، لذا لم يبدأ %2$@ على %1$@. شغّل `%3$@` مرة أخرى بعد فتح الدردشة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "채팅에 질문을 표시하지 못해 %1$@에서 %2$@이(가) 시작되지 않았습니다. 채팅이 열리면 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法在聊天中显示问题，因此 %2$@ 没有在 %1$@ 上启动。聊天打开后请再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法在聊天中顯示問題，因此 %2$@ 沒有在 %1$@ 上啟動。聊天開啟後請再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće prikazati pitanje u razgovoru, pa se %2$@ nije pokrenuo na %1$@. Ponovo pokrenite `%3$@` kada razgovor bude otvoren."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke vise spørgsmålet i chatten, så %2$@ startede ikke på %1$@. Kør `%3$@` igen, når chatten er åben."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile mostrare la domanda nella chat, quindi %2$@ non è stato avviato su %1$@. Esegui di nuovo `%3$@` quando la chat è aperta."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចបង្ហាញសំណួរក្នុងការជជែកបានទេ ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមនៅលើ %1$@ ទេ។ ដំណើរការ `%3$@` ម្ដងទៀតនៅពេលការជជែកបើក។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke vise spørsmålet i chatten, så %2$@ startet ikke på %1$@. Kjør `%3$@` på nytt når chatten er åpen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można pokazać pytania w czacie, więc %2$@ nie uruchomił się na %1$@. Uruchom ponownie `%3$@`, gdy czat będzie otwarty."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível mostrar a pergunta no chat, então %2$@ não iniciou em %1$@. Execute `%3$@` novamente quando o chat estiver aberto."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось показать вопрос в чате, поэтому %2$@ не запущен на %1$@. Снова выполните `%3$@`, когда чат будет открыт."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แสดงคำถามในแชทไม่ได้ %2$@ จึงไม่ได้เริ่มบน %1$@ เรียกใช้ `%3$@` อีกครั้งเมื่อแชทเปิดอยู่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Soru sohbette gösterilemedi, bu yüzden %2$@ %1$@ üzerinde başlamadı. Sohbet açıkken `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося показати запитання в чаті, тому %2$@ не запущено на %1$@. Знову виконайте `%3$@`, коли чат буде відкрито."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể hiển thị câu hỏi trong cuộc trò chuyện nên %2$@ chưa khởi động trên %1$@. Chạy lại `%3$@` khi cuộc trò chuyện đang mở."}}
      }
    },
    "cloud.startSession.askOpen": {
      "comment": "A second ask while the chat's card is still open. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This chat already asks the person to start a Cloud session. Wait for their answer, then run `%3$@` again if %2$@ still isn't running on %1$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このチャットではすでに Cloud セッションの開始を確認しています。回答を待ち、%1$@ で %2$@ がまだ動いていなければ `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dieser Chat fragt die Person schon, ob eine Cloud-Sitzung starten soll. Warte auf ihre Antwort und führe `%3$@` erneut aus, falls %2$@ auf %1$@ dann noch nicht läuft."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette discussion demande déjà à la personne de démarrer une session Cloud. Attendez sa réponse, puis relancez `%3$@` si %2$@ ne tourne toujours pas sur %1$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Este chat ya pide a la persona iniciar una sesión de Cloud. Espera su respuesta y vuelve a ejecutar `%3$@` si %2$@ sigue sin ejecutarse en %1$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تطلب هذه الدردشة بالفعل من الشخص بدء جلسة Cloud. انتظر إجابته، ثم شغّل `%3$@` مرة أخرى إذا كان %2$@ لا يزال لا يعمل على %1$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 채팅은 이미 사용자에게 Cloud 세션 시작을 묻고 있습니다. 답을 기다린 뒤 %1$@에서 %2$@이(가) 아직 실행 중이 아니면 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "此聊天已在询问对方是否启动 Cloud 会话。请等待回答；如果 %2$@ 仍未在 %1$@ 上运行，再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "此聊天已在詢問對方是否啟動 Cloud 工作階段。請等待回答；如果 %2$@ 仍未在 %1$@ 上執行，再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ovaj razgovor već traži od osobe da pokrene Cloud sesiju. Sačekajte odgovor, a zatim ponovo pokrenite `%3$@` ako %2$@ još ne radi na %1$@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne chat spørger allerede personen om at starte en Cloud-session. Vent på svaret, og kør derefter `%3$@` igen, hvis %2$@ stadig ikke kører på %1$@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa chat chiede già alla persona di avviare una sessione Cloud. Attendi la risposta, poi esegui di nuovo `%3$@` se %2$@ non è ancora in esecuzione su %1$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការជជែកនេះកំពុងសុំឱ្យមនុស្សនោះចាប់ផ្ដើមវគ្គ Cloud រួចហើយ។ រង់ចាំចម្លើយរបស់គេ រួចដំណើរការ `%3$@` ម្ដងទៀត ប្រសិនបើ %2$@ នៅតែមិនដំណើរការនៅលើ %1$@។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne chatten spør allerede personen om å starte en Cloud-økt. Vent på svaret, og kjør deretter `%3$@` på nytt hvis %2$@ fortsatt ikke kjører på %1$@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ten czat już prosi użytkownika o uruchomienie sesji Cloud. Poczekaj na odpowiedź, a następnie uruchom ponownie `%3$@`, jeśli %2$@ nadal nie działa na %1$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Este chat já está pedindo à pessoa para iniciar uma sessão do Cloud. Aguarde a resposta e execute `%3$@` novamente se %2$@ ainda não estiver rodando em %1$@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Этот чат уже просит пользователя запустить сеанс Cloud. Дождитесь ответа, затем снова выполните `%3$@`, если %2$@ всё ещё не работает на %1$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แชทนี้กำลังขอให้ผู้ใช้เริ่มเซสชัน Cloud อยู่แล้ว รอคำตอบ แล้วเรียกใช้ `%3$@` อีกครั้งหาก %2$@ ยังไม่ทำงานบน %1$@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu sohbet kişiden zaten bir Cloud oturumu başlatmasını istiyor. Yanıtını bekleyin, %2$@ hâlâ %1$@ üzerinde çalışmıyorsa `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Цей чат уже просить користувача запустити сеанс Cloud. Дочекайтеся відповіді, потім знову виконайте `%3$@`, якщо %2$@ досі не працює на %1$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Cuộc trò chuyện này đã đang hỏi người dùng để bắt đầu một phiên Cloud. Hãy chờ câu trả lời, rồi chạy lại `%3$@` nếu %2$@ vẫn chưa chạy trên %1$@."}}
      }
    },
    "cloud.startSession.declined": {
      "comment": "The person chose Not now on the card. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The person chose Not now, so %2$@ didn't start on %1$@. Ask them in the chat before you run `%3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "「後で」が選ばれたため、%1$@ で %2$@ は開始されませんでした。`%3$@` をもう一度実行する前に、チャットで確認してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Person hat „Nicht jetzt“ gewählt, daher wurde %2$@ auf %1$@ nicht gestartet. Frag sie im Chat, bevor du `%3$@` erneut ausführst."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La personne a choisi Pas maintenant : %2$@ n'a pas démarré sur %1$@. Demandez-lui dans la discussion avant de relancer `%3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La persona eligió Ahora no, así que %2$@ no se inició en %1$@. Pregúntale en el chat antes de volver a ejecutar `%3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "اختار الشخص «ليس الآن»، لذا لم يبدأ %2$@ على %1$@. اسأله في الدردشة قبل تشغيل `%3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사용자가 나중에를 선택해 %1$@에서 %2$@이(가) 시작되지 않았습니다. `%3$@`을(를) 다시 실행하기 전에 채팅에서 물어보세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "对方选择了“以后再说”，因此 %2$@ 没有在 %1$@ 上启动。再次运行 `%3$@` 前请先在聊天中询问。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "對方選擇了「以後再說」，因此 %2$@ 沒有在 %1$@ 上啟動。再次執行 `%3$@` 前請先在聊天中詢問。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Osoba je odabrala „Ne sada“, pa se %2$@ nije pokrenuo na %1$@. Pitajte je u razgovoru prije nego što ponovo pokrenete `%3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Personen valgte »Ikke nu«, så %2$@ startede ikke på %1$@. Spørg vedkommende i chatten, før du kører `%3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La persona ha scelto «Non ora», quindi %2$@ non è stato avviato su %1$@. Chiedile nella chat prima di eseguire di nuovo `%3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មនុស្សនោះបានជ្រើស «មិនមែនឥឡូវនេះ» ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមនៅលើ %1$@ ទេ។ សួរគេក្នុងការជជែក មុនពេលអ្នកដំណើរការ `%3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Personen valgte «Ikke nå», så %2$@ startet ikke på %1$@. Spør vedkommende i chatten før du kjører `%3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Użytkownik wybrał „Nie teraz”, więc %2$@ nie uruchomił się na %1$@. Zapytaj go w czacie, zanim ponownie uruchomisz `%3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A pessoa escolheu “Agora não”, então %2$@ não iniciou em %1$@. Pergunte a ela no chat antes de executar `%3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Пользователь выбрал «Не сейчас», поэтому %2$@ не запущен на %1$@. Спросите его в чате, прежде чем снова выполнять `%3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ผู้ใช้เลือก “ไม่ใช่ตอนนี้” %2$@ จึงไม่ได้เริ่มบน %1$@ ถามผู้ใช้ในแชทก่อนเรียกใช้ `%3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kişi “Şimdi değil” seçeneğini seçti, bu yüzden %2$@ %1$@ üzerinde başlamadı. `%3$@` komutunu yeniden çalıştırmadan önce sohbette ona sorun."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Користувач вибрав «Не зараз», тому %2$@ не запущено на %1$@. Запитайте його в чаті, перш ніж знову виконувати `%3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Người dùng đã chọn “Để sau” nên %2$@ chưa khởi động trên %1$@. Hãy hỏi họ trong cuộc trò chuyện trước khi chạy lại `%3$@`."}}
      }
    },
    "cloud.startSession.expired": {
      "comment": "Nobody answered the card in time. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Nobody answered the question in the chat within 2 minutes, so %2$@ didn't start on %1$@. Run `%3$@` again when the person is there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "2 分以内にチャットの確認に回答がなかったため、%1$@ で %2$@ は開始されませんでした。本人がいるときに `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Niemand hat die Frage im Chat innerhalb von 2 Minuten beantwortet, daher wurde %2$@ auf %1$@ nicht gestartet. Führe `%3$@` erneut aus, wenn die Person da ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Personne n'a répondu à la question dans la discussion en 2 minutes : %2$@ n'a pas démarré sur %1$@. Relancez `%3$@` quand la personne est là."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Nadie respondió a la pregunta del chat en 2 minutos, así que %2$@ no se inició en %1$@. Vuelve a ejecutar `%3$@` cuando la persona esté."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يُجب أحد عن السؤال في الدردشة خلال دقيقتين، لذا لم يبدأ %2$@ على %1$@. شغّل `%3$@` مرة أخرى عندما يكون الشخص موجودًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "2분 안에 채팅의 질문에 답한 사람이 없어 %1$@에서 %2$@이(가) 시작되지 않았습니다. 사용자가 있을 때 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "2 分钟内没有人回答聊天中的问题，因此 %2$@ 没有在 %1$@ 上启动。对方在时请再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "2 分鐘內沒有人回答聊天中的問題，因此 %2$@ 沒有在 %1$@ 上啟動。對方在時請再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Niko nije odgovorio na pitanje u razgovoru u roku od 2 minute, pa se %2$@ nije pokrenuo na %1$@. Ponovo pokrenite `%3$@` kada osoba bude tu."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen svarede på spørgsmålet i chatten inden for 2 minutter, så %2$@ startede ikke på %1$@. Kør `%3$@` igen, når personen er der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessuno ha risposto alla domanda nella chat entro 2 minuti, quindi %2$@ non è stato avviato su %1$@. Esegui di nuovo `%3$@` quando la persona è presente."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គ្មាននរណាឆ្លើយសំណួរក្នុងការជជែកក្នុងរយៈពេល 2 នាទីទេ ដូច្នេះ %2$@ មិនបានចាប់ផ្ដើមនៅលើ %1$@ ទេ។ ដំណើរការ `%3$@` ម្ដងទៀតនៅពេលមនុស្សនោះនៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen svarte på spørsmålet i chatten innen 2 minutter, så %2$@ startet ikke på %1$@. Kjør `%3$@` på nytt når personen er til stede."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nikt nie odpowiedział na pytanie w czacie w ciągu 2 minut, więc %2$@ nie uruchomił się na %1$@. Uruchom ponownie `%3$@`, gdy użytkownik będzie dostępny."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Ninguém respondeu à pergunta no chat em 2 minutos, então %2$@ não iniciou em %1$@. Execute `%3$@` novamente quando a pessoa estiver presente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Никто не ответил на вопрос в чате за 2 минуты, поэтому %2$@ не запущен на %1$@. Снова выполните `%3$@`, когда пользователь будет на месте."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่มีใครตอบคำถามในแชทภายใน 2 นาที %2$@ จึงไม่ได้เริ่มบน %1$@ เรียกใช้ `%3$@` อีกครั้งเมื่อผู้ใช้อยู่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Sohbetteki soruyu 2 dakika içinde kimse yanıtlamadı, bu yüzden %2$@ %1$@ üzerinde başlamadı. Kişi oradayken `%3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ніхто не відповів на запитання в чаті протягом 2 хвилин, тому %2$@ не запущено на %1$@. Знову виконайте `%3$@`, коли користувач буде на місці."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không ai trả lời câu hỏi trong cuộc trò chuyện trong vòng 2 phút nên %2$@ chưa khởi động trên %1$@. Chạy lại `%3$@` khi người dùng có mặt."}}
      }
    },
    "cloud.startSession.accountChanged": {
      "comment": "The signed-in Cloud account or team changed while the run waited. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your Cloud account or team changed after this was asked, so %2$@ didn't start on %1$@. Run `%3$@` again in the account you want it in."}},
        "ja": {"stringUnit": {"state": "translated", "value": "確認の後に Cloud のアカウントまたはチームが変わったため、%1$@ で %2$@ は開始されませんでした。使いたいアカウントで `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dein Cloud-Konto oder Team hat sich nach der Anfrage geändert, daher wurde %2$@ auf %1$@ nicht gestartet. Führe `%3$@` im gewünschten Konto erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre compte ou équipe Cloud a changé après la demande : %2$@ n'a pas démarré sur %1$@. Relancez `%3$@` dans le compte voulu."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu cuenta o equipo de Cloud cambió después de la solicitud, así que %2$@ no se inició en %1$@. Vuelve a ejecutar `%3$@` en la cuenta que quieras."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تغيّر حساب Cloud أو الفريق بعد الطلب، لذا لم يبدأ %2$@ على %1$@. شغّل `%3$@` مرة أخرى في الحساب الذي تريده."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "요청 후 Cloud 계정 또는 팀이 바뀌어 %1$@에서 %2$@이(가) 시작되지 않았습니다. 원하는 계정에서 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "提出请求后你的 Cloud 帐户或团队已更改，因此 %2$@ 没有在 %1$@ 上启动。请在你想要的帐户中再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "提出請求後你的 Cloud 帳號或團隊已變更，因此 %2$@ 沒有在 %1$@ 上啟動。請在你想要的帳號中再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Vaš Cloud račun ili tim se promijenio nakon zahtjeva, pa %2$@ nije pokrenut na %1$@. Ponovo pokrenite `%3$@` u računu u kojem ga želite."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Din Cloud-konto eller dit team ændrede sig efter anmodningen, så %2$@ startede ikke på %1$@. Kør `%3$@` igen i den konto, du vil bruge."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo account o team Cloud è cambiato dopo la richiesta, quindi %2$@ non è stato avviato su %1$@. Esegui di nuovo `%3$@` nell'account che vuoi usare."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គណនី ឬក្រុម Cloud របស់អ្នកបានប្តូរបន្ទាប់ពីសំណើនេះ ដូច្នេះ %2$@ មិនបានចាប់ផ្តើមលើ %1$@ ទេ។ ដំណើរការ `%3$@` ម្តងទៀតក្នុងគណនីដែលអ្នកចង់ប្រើ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Cloud-kontoen eller teamet ditt endret seg etter forespørselen, så %2$@ startet ikke på %1$@. Kjør `%3$@` igjen i kontoen du vil bruke."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twoje konto lub zespół Cloud zmieniły się po prośbie, więc %2$@ nie uruchomiono na %1$@. Uruchom `%3$@` ponownie na koncie, którego chcesz użyć."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Sua conta ou equipe do Cloud mudou depois do pedido, então %2$@ não foi iniciado em %1$@. Execute `%3$@` de novo na conta que você quer usar."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Аккаунт или команда Cloud изменились после запроса, поэтому %2$@ не запущен на %1$@. Снова выполните `%3$@` в нужном аккаунте."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "บัญชีหรือทีม Cloud ของคุณเปลี่ยนไปหลังจากคำขอนี้ %2$@ จึงไม่ได้เริ่มบน %1$@ เรียกใช้ `%3$@` อีกครั้งในบัญชีที่คุณต้องการ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "İstekten sonra Cloud hesabınız veya ekibiniz değişti, bu yüzden %2$@ %1$@ üzerinde başlamadı. `%3$@` komutunu istediğiniz hesapta yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Обліковий запис або команда Cloud змінилися після запиту, тому %2$@ не запущено на %1$@. Знову виконайте `%3$@` у потрібному обліковому записі."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tài khoản hoặc nhóm Cloud của bạn đã thay đổi sau yêu cầu này, nên %2$@ chưa khởi động trên %1$@. Hãy chạy lại `%3$@` trong tài khoản bạn muốn dùng."}}
      }
    },
    "cloud.startSession.accountChangedWhileStarting": {
      "comment": "The signed-in Cloud account or team changed after the person clicked Start, while the run went on, so it stopped. %1$@ machine, %2$@ agent, %3$@ the command (keep it in backticks).",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your Cloud account or team changed while %2$@ was starting on %1$@, so the start stopped. Run `%3$@` again in the account you want it in."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ で %2$@ を開始している間に Cloud のアカウントまたはチームが変わったため、開始は中止されました。使いたいアカウントで `%3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dein Cloud-Konto oder Team hat sich geändert, während %2$@ auf %1$@ startete, daher wurde der Start abgebrochen. Führe `%3$@` im gewünschten Konto erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre compte ou équipe Cloud a changé pendant le démarrage de %2$@ sur %1$@ : le démarrage s'est arrêté. Relancez `%3$@` dans le compte voulu."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu cuenta o equipo de Cloud cambió mientras %2$@ se iniciaba en %1$@, así que el inicio se detuvo. Vuelve a ejecutar `%3$@` en la cuenta que quieras."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تغيّر حساب Cloud أو الفريق أثناء بدء %2$@ على %1$@، لذا توقّف البدء. شغّل `%3$@` مرة أخرى في الحساب الذي تريده."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@에서 %2$@을(를) 시작하는 동안 Cloud 계정 또는 팀이 바뀌어 시작이 중단되었습니다. 원하는 계정에서 `%3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "在 %1$@ 上启动 %2$@ 期间你的 Cloud 帐户或团队已更改，因此启动已停止。请在你想要的帐户中再次运行 `%3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "在 %1$@ 上啟動 %2$@ 期間你的 Cloud 帳號或團隊已變更，因此啟動已停止。請在你想要的帳號中再次執行 `%3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Vaš Cloud račun ili tim promijenio se dok se %2$@ pokretao na %1$@, pa je pokretanje zaustavljeno. Ponovo pokrenite `%3$@` u računu u kojem ga želite."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Din Cloud-konto eller dit team ændrede sig, mens %2$@ startede på %1$@, så starten stoppede. Kør `%3$@` igen i den konto, du vil bruge."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo account o team Cloud è cambiato mentre %2$@ si avviava su %1$@, quindi l'avvio si è fermato. Esegui di nuovo `%3$@` nell'account che vuoi."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គណនី ឬក្រុម Cloud របស់អ្នកបានផ្លាស់ប្ដូរ ខណៈពេល %2$@ កំពុងចាប់ផ្ដើមនៅលើ %1$@ ដូច្នេះការចាប់ផ្ដើមបានឈប់។ ដំណើរការ `%3$@` ម្ដងទៀតក្នុងគណនីដែលអ្នកចង់បាន។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Cloud-kontoen eller teamet ditt endret seg mens %2$@ startet på %1$@, så oppstarten stoppet. Kjør `%3$@` på nytt i kontoen du vil bruke."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twoje konto lub zespół Cloud zmieniły się podczas uruchamiania %2$@ na %1$@, więc uruchamianie zostało zatrzymane. Uruchom ponownie `%3$@` na wybranym koncie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Sua conta ou equipe do Cloud mudou enquanto %2$@ iniciava em %1$@, então a inicialização parou. Execute `%3$@` novamente na conta que você quer."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ваш аккаунт или команда Cloud изменились, пока %2$@ запускался на %1$@, поэтому запуск остановлен. Снова выполните `%3$@` в нужном аккаунте."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "บัญชีหรือทีม Cloud ของคุณเปลี่ยนไประหว่างที่ %2$@ กำลังเริ่มบน %1$@ การเริ่มจึงหยุดลง เรียกใช้ `%3$@` อีกครั้งในบัญชีที่คุณต้องการ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%2$@ %1$@ üzerinde başlatılırken Cloud hesabınız veya ekibiniz değişti, bu yüzden başlatma durduruldu. `%3$@` komutunu istediğiniz hesapta yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ваш обліковий запис або команда Cloud змінилися, поки %2$@ запускався на %1$@, тому запуск зупинено. Знову виконайте `%3$@` у потрібному обліковому записі."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tài khoản hoặc nhóm Cloud của bạn đã thay đổi trong khi %2$@ đang khởi động trên %1$@, nên việc khởi động đã dừng. Chạy lại `%3$@` trong tài khoản bạn muốn."}}
      }
    },
    "cloud.startSession.needsMachine": {
      "comment": "cmux cloud start-session run by a script or agent without a machine. %1$@ is the agent (claude). Keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Say which Cloud machine to start %1$@ on: `cmux cloud start-session --target machine:<id> --agent %1$@`, or `--name <name>` to take that machine or create it. `cmux cloud list-machines` lists your machines."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ を開始する Cloud マシンを指定してください: `cmux cloud start-session --target machine:<id> --agent %1$@`、または `--name <name>` でその名前のマシンを使うか作成します。`cmux cloud list-machines` でマシンを一覧表示できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib an, auf welcher Cloud-Maschine %1$@ starten soll: `cmux cloud start-session --target machine:<id> --agent %1$@`, oder `--name <name>`, um diese Maschine zu nehmen oder zu erstellen. `cmux cloud list-machines` listet deine Maschinen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez sur quelle machine Cloud démarrer %1$@ : `cmux cloud start-session --target machine:<id> --agent %1$@`, ou `--name <name>` pour prendre cette machine ou la créer. `cmux cloud list-machines` liste vos machines."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica en qué máquina de Cloud iniciar %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, o `--name <name>` para usar esa máquina o crearla. `cmux cloud list-machines` muestra tus máquinas."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "حدّد جهاز Cloud الذي يبدأ عليه %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`، أو `--name <name>` لاستخدام ذلك الجهاز أو إنشائه. يعرض `cmux cloud list-machines` أجهزتك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@을(를) 시작할 Cloud 머신을 지정하세요: `cmux cloud start-session --target machine:<id> --agent %1$@`, 또는 `--name <name>`으로 그 머신을 사용하거나 만듭니다. `cmux cloud list-machines`로 머신 목록을 볼 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请指定在哪台 Cloud 机器上启动 %1$@：`cmux cloud start-session --target machine:<id> --agent %1$@`，或用 `--name <name>` 使用或创建该机器。`cmux cloud list-machines` 会列出你的机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請指定在哪台 Cloud 機器上啟動 %1$@：`cmux cloud start-session --target machine:<id> --agent %1$@`，或用 `--name <name>` 使用或建立該機器。`cmux cloud list-machines` 會列出你的機器。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite na kojoj Cloud mašini treba pokrenuti %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` ili `--name <name>` da uzmete tu mašinu ili je kreirate. `cmux cloud list-machines` prikazuje vaše mašine."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv, hvilken Cloud-maskine %1$@ skal startes på: `cmux cloud start-session --target machine:<id> --agent %1$@`, eller `--name <name>` for at bruge den maskine eller oprette den. `cmux cloud list-machines` viser dine maskiner."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica su quale macchina Cloud avviare %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, oppure `--name <name>` per usare quella macchina o crearla. `cmux cloud list-machines` elenca le tue macchine."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ម៉ាស៊ីន Cloud ដែលត្រូវចាប់ផ្ដើម %1$@៖ `cmux cloud start-session --target machine:<id> --agent %1$@` ឬ `--name <name>` ដើម្បីយកម៉ាស៊ីននោះ ឬបង្កើតវា។ `cmux cloud list-machines` បង្ហាញម៉ាស៊ីនរបស់អ្នក។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi hvilken Cloud-maskin %1$@ skal startes på: `cmux cloud start-session --target machine:<id> --agent %1$@`, eller `--name <name>` for å bruke den maskinen eller opprette den. `cmux cloud list-machines` viser maskinene dine."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Wskaż, na której maszynie Cloud uruchomić %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` lub `--name <name>`, aby użyć tej maszyny albo ją utworzyć. `cmux cloud list-machines` wyświetla Twoje maszyny."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Diga em qual máquina do Cloud iniciar %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, ou `--name <name>` para usar essa máquina ou criá-la. `cmux cloud list-machines` lista suas máquinas."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите, на какой машине Cloud запустить %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` или `--name <name>`, чтобы взять эту машину или создать её. `cmux cloud list-machines` показывает ваши машины."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุเครื่อง Cloud ที่จะเริ่ม %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` หรือ `--name <name>` เพื่อใช้เครื่องนั้นหรือสร้างขึ้นใหม่ `cmux cloud list-machines` แสดงรายการเครื่องของคุณ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ ajanının hangi Cloud makinesinde başlatılacağını belirtin: `cmux cloud start-session --target machine:<id> --agent %1$@` veya o makineyi kullanmak ya da oluşturmak için `--name <name>`. `cmux cloud list-machines` makinelerinizi listeler."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть, на якій машині Cloud запустити %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@` або `--name <name>`, щоб узяти цю машину чи створити її. `cmux cloud list-machines` показує ваші машини."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Hãy cho biết máy Cloud nào để khởi động %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, hoặc `--name <name>` để dùng máy đó hoặc tạo máy mới. `cmux cloud list-machines` liệt kê các máy của bạn."}}
      }
    },
    "cloud.startSession.noSuchMachine": {
      "comment": "cmux cloud start-session --target names no listed machine. %1$@ is the machine id, %2$@ the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No Cloud machine `%1$@` is listed on this Mac. `cmux cloud list-machines` lists them, and `cmux cloud start-session --name <name> --agent %2$@` creates one."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシン `%1$@` はこの Mac に表示されていません。`cmux cloud list-machines` で一覧を表示し、`cmux cloud start-session --name <name> --agent %2$@` で作成できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Keine Cloud-Maschine `%1$@` ist auf diesem Mac aufgeführt. `cmux cloud list-machines` listet sie, und `cmux cloud start-session --name <name> --agent %2$@` erstellt eine."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Aucune machine Cloud `%1$@` n'est listée sur ce Mac. `cmux cloud list-machines` les liste, et `cmux cloud start-session --name <name> --agent %2$@` en crée une."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No hay ninguna máquina de Cloud `%1$@` en este Mac. `cmux cloud list-machines` las muestra y `cmux cloud start-session --name <name> --agent %2$@` crea una."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد جهاز Cloud باسم `%1$@` في قائمة هذا الـ Mac. يعرضها `cmux cloud list-machines`، وينشئ `cmux cloud start-session --name <name> --agent %2$@` جهازًا جديدًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac에 Cloud 머신 `%1$@`이(가) 없습니다. `cmux cloud list-machines`로 목록을 보고 `cmux cloud start-session --name <name> --agent %2$@`로 만들 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台 Mac 上没有 Cloud 机器 `%1$@`。`cmux cloud list-machines` 会列出机器，`cmux cloud start-session --name <name> --agent %2$@` 会创建一台。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台 Mac 上沒有 Cloud 機器 `%1$@`。`cmux cloud list-machines` 會列出機器，`cmux cloud start-session --name <name> --agent %2$@` 會建立一台。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nijedna Cloud mašina `%1$@` nije navedena na ovom Mac računaru. `cmux cloud list-machines` ih prikazuje, a `cmux cloud start-session --name <name> --agent %2$@` kreira novu."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-maskine `%1$@` er på listen på denne Mac. `cmux cloud list-machines` viser dem, og `cmux cloud start-session --name <name> --agent %2$@` opretter en."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Nessuna macchina Cloud `%1$@` è elencata su questo Mac. `cmux cloud list-machines` le elenca e `cmux cloud start-session --name <name> --agent %2$@` ne crea una."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "គ្មានម៉ាស៊ីន Cloud `%1$@` ក្នុងបញ្ជីនៅលើ Mac នេះទេ។ `cmux cloud list-machines` បង្ហាញបញ្ជីម៉ាស៊ីន ហើយ `cmux cloud start-session --name <name> --agent %2$@` បង្កើតម៉ាស៊ីនថ្មី។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Ingen Cloud-maskin `%1$@` er oppført på denne Mac-en. `cmux cloud list-machines` viser dem, og `cmux cloud start-session --name <name> --agent %2$@` oppretter en."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Na tym komputerze Mac nie ma na liście maszyny Cloud `%1$@`. `cmux cloud list-machines` wyświetla listę maszyn, a `cmux cloud start-session --name <name> --agent %2$@` tworzy nową."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Nenhuma máquina do Cloud `%1$@` está listada neste Mac. `cmux cloud list-machines` lista as máquinas, e `cmux cloud start-session --name <name> --agent %2$@` cria uma."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "На этом Mac в списке нет машины Cloud `%1$@`. `cmux cloud list-machines` показывает их, а `cmux cloud start-session --name <name> --agent %2$@` создаёт новую."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ไม่มีเครื่อง Cloud `%1$@` ในรายการบน Mac เครื่องนี้ `cmux cloud list-machines` แสดงรายการเครื่อง และ `cmux cloud start-session --name <name> --agent %2$@` จะสร้างเครื่องใหม่"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Mac'te listelenen `%1$@` adında bir Cloud makinesi yok. `cmux cloud list-machines` makineleri listeler, `cmux cloud start-session --name <name> --agent %2$@` ise yeni bir makine oluşturur."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "На цьому Mac у списку немає машини Cloud `%1$@`. `cmux cloud list-machines` показує їх, а `cmux cloud start-session --name <name> --agent %2$@` створює нову."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không có máy Cloud `%1$@` nào trong danh sách trên máy Mac này. `cmux cloud list-machines` liệt kê các máy, còn `cmux cloud start-session --name <name> --agent %2$@` sẽ tạo một máy."}}
      }
    },
    "cloud.startSession.agentInvalid": {
      "comment": "cmux cloud start-session without a valid --agent. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass the agent to start with --agent, for example `cmux cloud start-session --name dev --agent claude`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始するエージェントを --agent で指定してください (例: `cmux cloud start-session --name dev --agent claude`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib den zu startenden Agent mit --agent an, zum Beispiel `cmux cloud start-session --name dev --agent claude`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez l'agent à démarrer avec --agent, par exemple `cmux cloud start-session --name dev --agent claude`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica el agente que se iniciará con --agent, por ejemplo `cmux cloud start-session --name dev --agent claude`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر الوكيل المراد بدؤه باستخدام ‎--agent، مثل `cmux cloud start-session --name dev --agent claude`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--agent로 시작할 에이전트를 지정하세요(예: `cmux cloud start-session --name dev --agent claude`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请用 --agent 指定要启动的代理，例如 `cmux cloud start-session --name dev --agent claude`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請用 --agent 指定要啟動的代理，例如 `cmux cloud start-session --name dev --agent claude`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite agenta za pokretanje pomoću --agent, na primjer `cmux cloud start-session --name dev --agent claude`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv den agent, der skal startes, med --agent, for eksempel `cmux cloud start-session --name dev --agent claude`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica l'agente da avviare con --agent, per esempio `cmux cloud start-session --name dev --agent claude`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ភ្នាក់ងារដែលត្រូវចាប់ផ្ដើមដោយប្រើ --agent ឧទាហរណ៍ `cmux cloud start-session --name dev --agent claude`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi agenten som skal startes med --agent, for eksempel `cmux cloud start-session --name dev --agent claude`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj agenta do uruchomienia za pomocą --agent, na przykład `cmux cloud start-session --name dev --agent claude`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe o agente a iniciar com --agent, por exemplo `cmux cloud start-session --name dev --agent claude`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите агента для запуска через --agent, например `cmux cloud start-session --name dev --agent claude`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุเอเจนต์ที่จะเริ่มด้วย --agent เช่น `cmux cloud start-session --name dev --agent claude`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Başlatılacak ajanı --agent ile belirtin, örneğin `cmux cloud start-session --name dev --agent claude`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть агента для запуску через --agent, наприклад `cmux cloud start-session --name dev --agent claude`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền tác tử cần khởi động bằng --agent, ví dụ `cmux cloud start-session --name dev --agent claude`."}}
      }
    },
    "cloud.startSession.cwdInvalid": {
      "comment": "cmux cloud start-session with a relative or bad --cwd. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass --cwd as an absolute folder on the machine, for example `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--cwd にはマシン上の絶対パスのフォルダを指定してください (例: `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib --cwd als absoluten Ordner auf der Maschine an, zum Beispiel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez --cwd sous forme de dossier absolu sur la machine, par exemple `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica --cwd como una carpeta absoluta en la máquina, por ejemplo `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر ‎--cwd كمجلد بمسار مطلق على الجهاز، مثل `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--cwd에는 머신의 절대 경로 폴더를 지정하세요(예: `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请将 --cwd 设为机器上的绝对路径文件夹，例如 `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請將 --cwd 設為機器上的絕對路徑資料夾，例如 `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Navedite --cwd kao apsolutnu putanju foldera na mašini, na primjer `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Angiv --cwd som en absolut mappe på maskinen, for eksempel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Indica --cwd come cartella assoluta sulla macchina, per esempio `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "បញ្ជាក់ --cwd ជាផ្លូវថតពេញលេញនៅលើម៉ាស៊ីន ឧទាហរណ៍ `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Angi --cwd som en absolutt mappe på maskinen, for eksempel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Podaj --cwd jako bezwzględną ścieżkę folderu na maszynie, na przykład `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Informe --cwd como uma pasta absoluta na máquina, por exemplo `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Укажите в --cwd абсолютный путь к папке на машине, например `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ระบุ --cwd เป็นพาธแบบเต็มของโฟลเดอร์บนเครื่อง เช่น `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--cwd değerini makinedeki mutlak bir klasör yolu olarak verin, örneğin `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкажіть у --cwd абсолютний шлях до папки на машині, наприклад `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Truyền --cwd là đường dẫn tuyệt đối tới thư mục trên máy, ví dụ `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}}
      }
    },
    "cloud.startSession.createFailed": {
      "comment": "The named machine could not be created. %1$@ is its name, %2$@ the name as a shell word, %3$@ the agent, %4$@ the reason. Keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't create Cloud machine `%1$@` (%4$@), so no agent started. Run `cmux cloud start-session --name %2$@ --agent %3$@` again, or pick a machine from `cmux cloud list-machines`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシン `%1$@` を作成できなかったため (%4$@)、エージェントは開始されませんでした。`cmux cloud start-session --name %2$@ --agent %3$@` をもう一度実行するか、`cmux cloud list-machines` からマシンを選んでください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Cloud-Maschine `%1$@` konnte nicht erstellt werden (%4$@), daher wurde kein Agent gestartet. Führe `cmux cloud start-session --name %2$@ --agent %3$@` erneut aus oder wähle eine Maschine aus `cmux cloud list-machines`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de créer la machine Cloud `%1$@` (%4$@) : aucun agent n'a démarré. Relancez `cmux cloud start-session --name %2$@ --agent %3$@`, ou choisissez une machine dans `cmux cloud list-machines`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo crear la máquina de Cloud `%1$@` (%4$@), así que no se inició ningún agente. Vuelve a ejecutar `cmux cloud start-session --name %2$@ --agent %3$@` o elige una máquina de `cmux cloud list-machines`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر إنشاء جهاز Cloud ‏`%1$@` (%4$@)، لذا لم يبدأ أي وكيل. شغّل `cmux cloud start-session --name %2$@ --agent %3$@` مرة أخرى، أو اختر جهازًا من `cmux cloud list-machines`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud 머신 `%1$@`을(를) 만들지 못해(%4$@) 에이전트가 시작되지 않았습니다. `cmux cloud start-session --name %2$@ --agent %3$@`을(를) 다시 실행하거나 `cmux cloud list-machines`에서 머신을 고르세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法创建 Cloud 机器 `%1$@`（%4$@），因此没有启动代理。请再次运行 `cmux cloud start-session --name %2$@ --agent %3$@`，或从 `cmux cloud list-machines` 中选一台机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法建立 Cloud 機器 `%1$@`（%4$@），因此沒有啟動代理。請再次執行 `cmux cloud start-session --name %2$@ --agent %3$@`，或從 `cmux cloud list-machines` 中選一台機器。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće kreirati Cloud mašinu `%1$@` (%4$@), pa nijedan agent nije pokrenut. Ponovo pokrenite `cmux cloud start-session --name %2$@ --agent %3$@` ili odaberite mašinu iz `cmux cloud list-machines`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke oprette Cloud-maskinen `%1$@` (%4$@), så ingen agent startede. Kør `cmux cloud start-session --name %2$@ --agent %3$@` igen, eller vælg en maskine fra `cmux cloud list-machines`."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile creare la macchina Cloud `%1$@` (%4$@), quindi nessun agente è stato avviato. Esegui di nuovo `cmux cloud start-session --name %2$@ --agent %3$@` oppure scegli una macchina da `cmux cloud list-machines`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចបង្កើតម៉ាស៊ីន Cloud `%1$@` បានទេ (%4$@) ដូច្នេះគ្មានភ្នាក់ងារណាបានចាប់ផ្ដើមទេ។ ដំណើរការ `cmux cloud start-session --name %2$@ --agent %3$@` ម្ដងទៀត ឬជ្រើសម៉ាស៊ីនពី `cmux cloud list-machines`។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke opprette Cloud-maskinen `%1$@` (%4$@), så ingen agent startet. Kjør `cmux cloud start-session --name %2$@ --agent %3$@` på nytt, eller velg en maskin fra `cmux cloud list-machines`."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można utworzyć maszyny Cloud `%1$@` (%4$@), więc żaden agent nie został uruchomiony. Uruchom ponownie `cmux cloud start-session --name %2$@ --agent %3$@` lub wybierz maszynę z `cmux cloud list-machines`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível criar a máquina do Cloud `%1$@` (%4$@), então nenhum agente foi iniciado. Execute `cmux cloud start-session --name %2$@ --agent %3$@` novamente ou escolha uma máquina em `cmux cloud list-machines`."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось создать машину Cloud `%1$@` (%4$@), поэтому агент не запущен. Снова выполните `cmux cloud start-session --name %2$@ --agent %3$@` или выберите машину из `cmux cloud list-machines`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "สร้างเครื่อง Cloud `%1$@` ไม่ได้ (%4$@) จึงไม่มีเอเจนต์เริ่มทำงาน เรียกใช้ `cmux cloud start-session --name %2$@ --agent %3$@` อีกครั้ง หรือเลือกเครื่องจาก `cmux cloud list-machines`"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` Cloud makinesi oluşturulamadı (%4$@), bu yüzden hiçbir ajan başlatılmadı. `cmux cloud start-session --name %2$@ --agent %3$@` komutunu yeniden çalıştırın veya `cmux cloud list-machines` listesinden bir makine seçin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося створити машину Cloud `%1$@` (%4$@), тому агент не запущено. Знову виконайте `cmux cloud start-session --name %2$@ --agent %3$@` або виберіть машину з `cmux cloud list-machines`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể tạo máy Cloud `%1$@` (%4$@) nên không có tác tử nào được khởi động. Chạy lại `cmux cloud start-session --name %2$@ --agent %3$@`, hoặc chọn một máy từ `cmux cloud list-machines`."}}
      }
    },
    "cloud.startSession.notConnected": {
      "comment": "The machine never connected. %1$@ is its name, %2$@ its id, %3$@ the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` didn't connect, so no agent started there. Check it with `cmux cloud machine-status --target machine:%2$@`, then run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` に接続できなかったため、エージェントは開始されませんでした。`cmux cloud machine-status --target machine:%2$@` で確認してから、`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` hat sich nicht verbunden, daher wurde dort kein Agent gestartet. Prüfe sie mit `cmux cloud machine-status --target machine:%2$@` und führe dann `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` ne s'est pas connectée, aucun agent n'y a donc démarré. Vérifiez-la avec `cmux cloud machine-status --target machine:%2$@`, puis relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` no se conectó, así que no se inició ningún agente. Revísala con `cmux cloud machine-status --target machine:%2$@` y vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يتصل الجهاز `%1$@`، لذا لم يبدأ أي وكيل عليه. افحصه باستخدام `cmux cloud machine-status --target machine:%2$@`، ثم شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`이(가) 연결되지 않아 에이전트가 시작되지 않았습니다. `cmux cloud machine-status --target machine:%2$@`로 확인한 다음 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 未连接，因此没有启动代理。请用 `cmux cloud machine-status --target machine:%2$@` 检查，然后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 未連線，因此沒有啟動代理。請用 `cmux cloud machine-status --target machine:%2$@` 檢查，然後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se nije povezala, pa na njoj nije pokrenut nijedan agent. Provjerite je pomoću `cmux cloud machine-status --target machine:%2$@`, a zatim ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` oprettede ikke forbindelse, så ingen agent startede der. Tjek den med `cmux cloud machine-status --target machine:%2$@`, og kør derefter `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` non si è connessa, quindi nessun agente è stato avviato lì. Controllala con `cmux cloud machine-status --target machine:%2$@`, poi esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` មិនបានភ្ជាប់ទេ ដូច្នេះគ្មានភ្នាក់ងារណាបានចាប់ផ្ដើមនៅទីនោះទេ។ ពិនិត្យវាដោយប្រើ `cmux cloud machine-status --target machine:%2$@` រួចដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` koblet seg ikke til, så ingen agent startet der. Sjekk den med `cmux cloud machine-status --target machine:%2$@`, og kjør deretter `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` nie połączyła się, więc żaden agent nie został na niej uruchomiony. Sprawdź ją poleceniem `cmux cloud machine-status --target machine:%2$@`, a następnie uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` não se conectou, então nenhum agente foi iniciado nela. Verifique-a com `cmux cloud machine-status --target machine:%2$@` e execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` не подключилась, поэтому агент на ней не запущен. Проверьте её командой `cmux cloud machine-status --target machine:%2$@`, затем снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` ไม่ได้เชื่อมต่อ จึงไม่มีเอเจนต์เริ่มทำงานบนเครื่องนั้น ตรวจสอบด้วย `cmux cloud machine-status --target machine:%2$@` แล้วเรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi bağlanmadı, bu yüzden orada hiçbir ajan başlatılmadı. Makineyi `cmux cloud machine-status --target machine:%2$@` ile kontrol edin, ardından `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` не під'єдналася, тому агент на ній не запущено. Перевірте її командою `cmux cloud machine-status --target machine:%2$@`, потім знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` không kết nối được nên không có tác tử nào được khởi động trên đó. Kiểm tra máy bằng `cmux cloud machine-status --target machine:%2$@`, rồi chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.tabClosed": {
      "comment": "The person closed the new chat's tab before its agent started. %1$@ machine name, %2$@ machine id, %3$@ agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The new chat's tab on machine `%1$@` was closed before its agent started, so %3$@ didn't start there. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` の新しいチャットのタブがエージェントの開始前に閉じられたため、%3$@ はそこで開始されませんでした。`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Tab des neuen Chats auf Maschine `%1$@` wurde geschlossen, bevor sein Agent startete, daher wurde %3$@ dort nicht gestartet. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'onglet de la nouvelle discussion sur la machine `%1$@` a été fermé avant le démarrage de son agent : %3$@ n'y a pas démarré. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La pestaña del nuevo chat en la máquina `%1$@` se cerró antes de que se iniciara su agente, así que %3$@ no se inició allí. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أُغلق تبويب الدردشة الجديدة على الجهاز `%1$@` قبل أن يبدأ وكيلها، لذا لم يبدأ %3$@ هناك. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`의 새 채팅 탭이 에이전트가 시작되기 전에 닫혀 %3$@이(가) 시작되지 않았습니다. `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 上新聊天的标签页在其代理启动前被关闭，因此 %3$@ 没有在那里启动。请再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 上新聊天的分頁在其代理啟動前被關閉，因此 %3$@ 沒有在那裡啟動。請再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Kartica novog chata na mašini `%1$@` zatvorena je prije nego što se njen agent pokrenuo, pa %3$@ tamo nije pokrenut. Ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Fanen med den nye chat på maskinen `%1$@` blev lukket, før dens agent startede, så %3$@ startede ikke der. Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La scheda della nuova chat sulla macchina `%1$@` è stata chiusa prima che il suo agente si avviasse, quindi %3$@ non è stato avviato lì. Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ផ្ទាំងជជែកថ្មីនៅលើម៉ាស៊ីន `%1$@` ត្រូវបានបិទមុនពេលភ្នាក់ងាររបស់វាចាប់ផ្ដើម ដូច្នេះ %3$@ មិនបានចាប់ផ្ដើមនៅទីនោះទេ។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Fanen for den nye chatten på maskinen `%1$@` ble lukket før agenten startet, så %3$@ startet ikke der. Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Karta nowego czatu na maszynie `%1$@` została zamknięta, zanim uruchomił się jej agent, więc %3$@ nie został tam uruchomiony. Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A aba do novo chat na máquina `%1$@` foi fechada antes de o agente iniciar, então %3$@ não foi iniciado lá. Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Вкладку нового чата на машине `%1$@` закрыли до запуска её агента, поэтому %3$@ там не запущен. Снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แท็บแชตใหม่บนเครื่อง `%1$@` ถูกปิดก่อนที่เอเจนต์จะเริ่มทำงาน %3$@ จึงไม่ได้เริ่มบนเครื่องนั้น เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesindeki yeni sohbetin sekmesi ajanı başlamadan kapatıldı, bu yüzden %3$@ orada başlatılmadı. `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Вкладку нового чату на машині `%1$@` закрили до запуску її агента, тому %3$@ там не запущено. Знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Thẻ của cuộc trò chuyện mới trên máy `%1$@` đã bị đóng trước khi tác tử khởi động, nên %3$@ chưa khởi động trên đó. Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.agentFailed": {
      "comment": "The machine is up but the agent session didn't start. %1$@ name, %2$@ id, %3$@ agent, %4$@ the reason in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started but its agent didn't (%4$@). Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、エージェントは開始されませんでした (%4$@)。`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, ihr Agent aber nicht (%4$@). Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais pas son agent (%4$@). Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero su agente no (%4$@). Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@` لكن وكيله لم يبدأ (%4$@). شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 에이전트는 시작되지 않았습니다(%4$@). `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但其代理未启动（%4$@）。请再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但其代理未啟動（%4$@）。請再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali njen agent nije (%4$@). Ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men dens agent gjorde ikke (%4$@). Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@` igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma il suo agente no (%4$@). Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែភ្នាក់ងាររបស់វាមិនបានចាប់ផ្ដើមទេ (%4$@)។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@` ម្ដងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men agenten på den gjorde ikke det (%4$@). Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@` på nytt."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale jej agent nie (%4$@). Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o agente dela não (%4$@). Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@` novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, а её агент нет (%4$@). Снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่เอเจนต์ของเครื่องไม่เริ่ม (%4$@) เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@` อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama ajanı başlamadı (%4$@). `cmux cloud start-session --target machine:%2$@ --agent %3$@` komutunu yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, а її агент ні (%4$@). Знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng tác tử của máy thì không (%4$@). Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}}
      }
    },
    "cloud.startSession.needsFolder": {
      "comment": "The agent session needs a folder on the machine. %1$@ name, %2$@ id, %3$@ agent. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started but its agent didn't: it needs a folder on that machine to start in. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` again with a folder there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、エージェントは開始されませんでした: そのマシン上の開始フォルダが必要です。そのマシンのフォルダを指定して `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, ihr Agent aber nicht: Er braucht einen Ordner auf dieser Maschine zum Starten. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` erneut mit einem Ordner dort aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais pas son agent : il lui faut un dossier sur cette machine où démarrer. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` avec un dossier de cette machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero su agente no: necesita una carpeta en esa máquina donde iniciarse. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` con una carpeta de allí."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@` لكن وكيله لم يبدأ: يحتاج إلى مجلد على ذلك الجهاز ليبدأ فيه. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` مرة أخرى مع مجلد هناك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 에이전트는 시작되지 않았습니다. 그 머신에서 시작할 폴더가 필요합니다. 그 머신의 폴더로 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但其代理未启动：它需要在该机器上的一个文件夹中启动。请用该机器上的文件夹再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但其代理未啟動：它需要在該機器上的一個資料夾中啟動。請用該機器上的資料夾再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Mašina `%1$@` se pokrenula, ali njen agent nije: treba mu folder na toj mašini u kojem će se pokrenuti. Ponovo pokrenite `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` s folderom koji postoji tamo."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startede, men dens agent gjorde ikke: den skal have en mappe på maskinen at starte i. Kør `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` igen med en mappe, der findes der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La macchina `%1$@` si è avviata, ma il suo agente no: gli serve una cartella su quella macchina in cui avviarsi. Esegui di nuovo `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` con una cartella presente lì."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីន `%1$@` បានចាប់ផ្ដើម ប៉ុន្តែភ្នាក់ងាររបស់វាមិនបានចាប់ផ្ដើមទេ៖ វាត្រូវការថតមួយនៅលើម៉ាស៊ីននោះដើម្បីចាប់ផ្ដើម។ ដំណើរការ `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` ម្ដងទៀតជាមួយថតដែលមាននៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinen `%1$@` startet, men agenten på den gjorde ikke det: den trenger en mappe på maskinen å starte i. Kjør `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` på nytt med en mappe som finnes der."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Maszyna `%1$@` uruchomiła się, ale jej agent nie: potrzebuje folderu na tej maszynie, w którym się uruchomi. Uruchom ponownie `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` z folderem, który tam istnieje."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A máquina `%1$@` iniciou, mas o agente dela não: ele precisa de uma pasta nessa máquina para iniciar. Execute `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` novamente com uma pasta que exista lá."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилась, а её агент нет: ему нужна папка на этой машине, в которой он запустится. Снова выполните `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`, указав папку на ней."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่อง `%1$@` เริ่มทำงานแล้ว แต่เอเจนต์ของเครื่องไม่เริ่ม: เอเจนต์ต้องมีโฟลเดอร์บนเครื่องนั้นเพื่อเริ่มทำงาน เรียกใช้ `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` อีกครั้งโดยระบุโฟลเดอร์ที่อยู่บนเครื่องนั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "`%1$@` makinesi başladı ama ajanı başlamadı: başlamak için o makinede bir klasöre ihtiyacı var. `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` komutunu oradaki bir klasörle yeniden çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Машина `%1$@` запустилася, а її агент ні: йому потрібна папка на цій машині, у якій він запуститься. Знову виконайте `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`, указавши папку на ній."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy `%1$@` đã khởi động nhưng tác tử của máy thì không: tác tử cần một thư mục trên máy đó để khởi động. Chạy lại `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` với một thư mục có trên máy đó."}}
      }
    },
    "cloud.startSession.ask": {
      "comment": "Card in an agent's chat. %1$@ is the agent (claude), %2$@ the Cloud machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The agent asks to start a %1$@ session on Cloud machine %2$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが Cloud マシン %2$@ で %1$@ セッションの開始を求めています。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Agent möchte eine %1$@-Sitzung auf der Cloud-Maschine %2$@ starten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'agent demande à démarrer une session %1$@ sur la machine Cloud %2$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El agente pide iniciar una sesión de %1$@ en la máquina de Cloud %2$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يطلب الوكيل بدء جلسة %1$@ على جهاز Cloud ‏%2$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 Cloud 머신 %2$@에서 %1$@ 세션을 시작하려고 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理请求在 Cloud 机器 %2$@ 上启动 %1$@ 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理請求在 Cloud 機器 %2$@ 上啟動 %1$@ 工作階段。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Agent traži da se pokrene %1$@ sesija na Cloud mašini %2$@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Agenten beder om at starte en %1$@-session på Cloud-maskinen %2$@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "L’agente chiede di avviare una sessione %1$@ sulla macchina Cloud %2$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ភ្នាក់ងារសុំចាប់ផ្ដើមវគ្គ %1$@ នៅលើម៉ាស៊ីន Cloud %2$@។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Agenten ber om å starte en %1$@-økt på Cloud-maskinen %2$@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Agent prosi o uruchomienie sesji %1$@ na maszynie Cloud %2$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O agente pede para iniciar uma sessão de %1$@ na máquina do Cloud %2$@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Агент просит запустить сеанс %1$@ на машине Cloud %2$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เอเจนต์ขอเริ่มเซสชัน %1$@ บนเครื่อง Cloud %2$@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajan, %2$@ Cloud makinesinde bir %1$@ oturumu başlatmak istiyor."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Агент просить запустити сеанс %1$@ на машині Cloud %2$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tác tử muốn bắt đầu một phiên %1$@ trên máy Cloud %2$@."}}
      }
    },
    "cloud.startSession.askNew": {
      "comment": "Card in an agent's chat when the machine doesn't exist yet. %1$@ is the agent, %2$@ the new machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The agent asks to create Cloud machine %2$@ and start a %1$@ session there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが Cloud マシン %2$@ を作成し、そこで %1$@ セッションを開始することを求めています。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Agent möchte die Cloud-Maschine %2$@ erstellen und dort eine %1$@-Sitzung starten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'agent demande à créer la machine Cloud %2$@ et à y démarrer une session %1$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El agente pide crear la máquina de Cloud %2$@ e iniciar allí una sesión de %1$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يطلب الوكيل إنشاء جهاز Cloud ‏%2$@ وبدء جلسة %1$@ عليه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 Cloud 머신 %2$@을(를) 만들고 그곳에서 %1$@ 세션을 시작하려고 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理请求创建 Cloud 机器 %2$@ 并在其上启动 %1$@ 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理請求建立 Cloud 機器 %2$@ 並在其上啟動 %1$@ 工作階段。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Agent traži da se kreira Cloud mašina %2$@ i na njoj pokrene %1$@ sesija."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Agenten beder om at oprette Cloud-maskinen %2$@ og starte en %1$@-session der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "L’agente chiede di creare la macchina Cloud %2$@ e di avviarvi una sessione %1$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ភ្នាក់ងារសុំបង្កើតម៉ាស៊ីន Cloud %2$@ ហើយចាប់ផ្ដើមវគ្គ %1$@ នៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Agenten ber om å opprette Cloud-maskinen %2$@ og starte en %1$@-økt der."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Agent prosi o utworzenie maszyny Cloud %2$@ i uruchomienie na niej sesji %1$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O agente pede para criar a máquina do Cloud %2$@ e iniciar uma sessão de %1$@ nela."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Агент просит создать машину Cloud %2$@ и запустить на ней сеанс %1$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เอเจนต์ขอสร้างเครื่อง Cloud %2$@ และเริ่มเซสชัน %1$@ บนเครื่องนั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ajan, %2$@ Cloud makinesini oluşturmak ve orada bir %1$@ oturumu başlatmak istiyor."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Агент просить створити машину Cloud %2$@ і запустити на ній сеанс %1$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tác tử muốn tạo máy Cloud %2$@ và bắt đầu một phiên %1$@ trên đó."}}
      }
    },
