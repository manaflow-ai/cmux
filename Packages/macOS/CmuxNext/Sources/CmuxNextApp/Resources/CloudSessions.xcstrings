{
  "sourceLanguage": "en",
  "strings": {
    "cloud.startSession.needsMachine": {
      "comment": "cmux cloud start-session run by a script or agent without a machine. %1$@ is the agent (claude). Keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Say which Cloud machine to start %1$@ on: `cmux cloud start-session --target machine:<id> --agent %1$@`, or `--name <name>` to take that machine or create it. `cmux cloud list-machines` lists your machines."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%1$@ を開始する Cloud マシンを指定してください: `cmux cloud start-session --target machine:<id> --agent %1$@`、または `--name <name>` でその名前のマシンを使うか作成します。`cmux cloud list-machines` でマシンを一覧表示できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib an, auf welcher Cloud-Maschine %1$@ starten soll: `cmux cloud start-session --target machine:<id> --agent %1$@`, oder `--name <name>`, um diese Maschine zu nehmen oder zu erstellen. `cmux cloud list-machines` listet deine Maschinen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez sur quelle machine Cloud démarrer %1$@ : `cmux cloud start-session --target machine:<id> --agent %1$@`, ou `--name <name>` pour prendre cette machine ou la créer. `cmux cloud list-machines` liste vos machines."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica en qué máquina de Cloud iniciar %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`, o `--name <name>` para usar esa máquina o crearla. `cmux cloud list-machines` muestra tus máquinas."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "حدّد جهاز Cloud الذي يبدأ عليه %1$@: `cmux cloud start-session --target machine:<id> --agent %1$@`، أو `--name <name>` لاستخدام ذلك الجهاز أو إنشائه. يعرض `cmux cloud list-machines` أجهزتك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%1$@을(를) 시작할 Cloud 머신을 지정하세요: `cmux cloud start-session --target machine:<id> --agent %1$@`, 또는 `--name <name>`으로 그 머신을 사용하거나 만듭니다. `cmux cloud list-machines`로 머신 목록을 볼 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请指定在哪台 Cloud 机器上启动 %1$@：`cmux cloud start-session --target machine:<id> --agent %1$@`，或用 `--name <name>` 使用或创建该机器。`cmux cloud list-machines` 会列出你的机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請指定在哪台 Cloud 機器上啟動 %1$@：`cmux cloud start-session --target machine:<id> --agent %1$@`，或用 `--name <name>` 使用或建立該機器。`cmux cloud list-machines` 會列出你的機器。"}}
      }
    },
    "cloud.startSession.noSuchMachine": {
      "comment": "cmux cloud start-session --target names no listed machine. %1$@ is the machine id, %2$@ the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No Cloud machine `%1$@` is listed on this Mac. `cmux cloud list-machines` lists them, and `cmux cloud start-session --name <name> --agent %2$@` creates one."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシン `%1$@` はこの Mac に表示されていません。`cmux cloud list-machines` で一覧を表示し、`cmux cloud start-session --name <name> --agent %2$@` で作成できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Keine Cloud-Maschine `%1$@` ist auf diesem Mac aufgeführt. `cmux cloud list-machines` listet sie, und `cmux cloud start-session --name <name> --agent %2$@` erstellt eine."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Aucune machine Cloud `%1$@` n'est listée sur ce Mac. `cmux cloud list-machines` les liste, et `cmux cloud start-session --name <name> --agent %2$@` en crée une."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No hay ninguna máquina de Cloud `%1$@` en este Mac. `cmux cloud list-machines` las muestra y `cmux cloud start-session --name <name> --agent %2$@` crea una."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يوجد جهاز Cloud باسم `%1$@` في قائمة هذا الـ Mac. يعرضها `cmux cloud list-machines`، وينشئ `cmux cloud start-session --name <name> --agent %2$@` جهازًا جديدًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac에 Cloud 머신 `%1$@`이(가) 없습니다. `cmux cloud list-machines`로 목록을 보고 `cmux cloud start-session --name <name> --agent %2$@`로 만들 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台 Mac 上没有 Cloud 机器 `%1$@`。`cmux cloud list-machines` 会列出机器，`cmux cloud start-session --name <name> --agent %2$@` 会创建一台。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台 Mac 上沒有 Cloud 機器 `%1$@`。`cmux cloud list-machines` 會列出機器，`cmux cloud start-session --name <name> --agent %2$@` 會建立一台。"}}
      }
    },
    "cloud.startSession.agentInvalid": {
      "comment": "cmux cloud start-session without a valid --agent. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass the agent to start with --agent, for example `cmux cloud start-session --name dev --agent claude`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始するエージェントを --agent で指定してください (例: `cmux cloud start-session --name dev --agent claude`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib den zu startenden Agent mit --agent an, zum Beispiel `cmux cloud start-session --name dev --agent claude`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez l'agent à démarrer avec --agent, par exemple `cmux cloud start-session --name dev --agent claude`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica el agente que se iniciará con --agent, por ejemplo `cmux cloud start-session --name dev --agent claude`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر الوكيل المراد بدؤه باستخدام ‎--agent، مثل `cmux cloud start-session --name dev --agent claude`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--agent로 시작할 에이전트를 지정하세요(예: `cmux cloud start-session --name dev --agent claude`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请用 --agent 指定要启动的代理，例如 `cmux cloud start-session --name dev --agent claude`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請用 --agent 指定要啟動的代理，例如 `cmux cloud start-session --name dev --agent claude`。"}}
      }
    },
    "cloud.startSession.cwdInvalid": {
      "comment": "cmux cloud start-session with a relative or bad --cwd. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass --cwd as an absolute folder on the machine, for example `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--cwd にはマシン上の絶対パスのフォルダを指定してください (例: `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`)。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Gib --cwd als absoluten Ordner auf der Maschine an, zum Beispiel `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Indiquez --cwd sous forme de dossier absolu sur la machine, par exemple `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Indica --cwd como una carpeta absoluta en la máquina, por ejemplo `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "مرّر ‎--cwd كمجلد بمسار مطلق على الجهاز، مثل `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--cwd에는 머신의 절대 경로 폴더를 지정하세요(예: `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "请将 --cwd 设为机器上的绝对路径文件夹，例如 `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "請將 --cwd 設為機器上的絕對路徑資料夾，例如 `cmux cloud start-session --target machine:<id> --agent claude --cwd /home/cmux/work`。"}}
      }
    },
    "cloud.startSession.createFailed": {
      "comment": "The named machine could not be created. %1$@ is its name, %2$@ the agent, %3$@ the reason. Keep the commands as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't create Cloud machine `%1$@` (%3$@), so no agent started. Run `cmux cloud start-session --name %1$@ --agent %2$@` again, or pick a machine from `cmux cloud list-machines`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Cloud マシン `%1$@` を作成できなかったため (%3$@)、エージェントは開始されませんでした。`cmux cloud start-session --name %1$@ --agent %2$@` をもう一度実行するか、`cmux cloud list-machines` からマシンを選んでください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Cloud-Maschine `%1$@` konnte nicht erstellt werden (%3$@), daher wurde kein Agent gestartet. Führe `cmux cloud start-session --name %1$@ --agent %2$@` erneut aus oder wähle eine Maschine aus `cmux cloud list-machines`."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de créer la machine Cloud `%1$@` (%3$@) : aucun agent n'a démarré. Relancez `cmux cloud start-session --name %1$@ --agent %2$@`, ou choisissez une machine dans `cmux cloud list-machines`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo crear la máquina de Cloud `%1$@` (%3$@), así que no se inició ningún agente. Vuelve a ejecutar `cmux cloud start-session --name %1$@ --agent %2$@` o elige una máquina de `cmux cloud list-machines`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر إنشاء جهاز Cloud ‏`%1$@` (%3$@)، لذا لم يبدأ أي وكيل. شغّل `cmux cloud start-session --name %1$@ --agent %2$@` مرة أخرى، أو اختر جهازًا من `cmux cloud list-machines`."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "Cloud 머신 `%1$@`을(를) 만들지 못해(%3$@) 에이전트가 시작되지 않았습니다. `cmux cloud start-session --name %1$@ --agent %2$@`을(를) 다시 실행하거나 `cmux cloud list-machines`에서 머신을 고르세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法创建 Cloud 机器 `%1$@`（%3$@），因此没有启动代理。请再次运行 `cmux cloud start-session --name %1$@ --agent %2$@`，或从 `cmux cloud list-machines` 中选一台机器。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法建立 Cloud 機器 `%1$@`（%3$@），因此沒有啟動代理。請再次執行 `cmux cloud start-session --name %1$@ --agent %2$@`，或從 `cmux cloud list-machines` 中選一台機器。"}}
      }
    },
    "cloud.startSession.stillStarting": {
      "comment": "The run answered pending while the session still starts. Keep the command as written; keep machine_id and session_id in English.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The session is still starting. Run the same `cmux cloud start-session` command again to get its machine_id and session_id."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セッションはまだ開始中です。同じ `cmux cloud start-session` コマンドをもう一度実行すると、machine_id と session_id を取得できます。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Sitzung startet noch. Führe denselben Befehl `cmux cloud start-session` erneut aus, um machine_id und session_id zu erhalten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La session démarre encore. Relancez la même commande `cmux cloud start-session` pour obtenir son machine_id et son session_id."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La sesión todavía se está iniciando. Vuelve a ejecutar el mismo comando `cmux cloud start-session` para obtener su machine_id y session_id."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا تزال الجلسة قيد البدء. شغّل الأمر `cmux cloud start-session` نفسه مرة أخرى للحصول على machine_id وsession_id."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "세션이 아직 시작 중입니다. 같은 `cmux cloud start-session` 명령을 다시 실행하면 machine_id와 session_id를 받을 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "会话仍在启动。请再次运行同一条 `cmux cloud start-session` 命令以获取其 machine_id 和 session_id。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "工作階段仍在啟動。請再次執行同一條 `cmux cloud start-session` 命令以取得其 machine_id 和 session_id。"}}
      }
    },
    "cloud.startSession.notConnected": {
      "comment": "The machine never connected. %1$@ is its name, %2$@ its id, %3$@ the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` didn't connect, so no agent started there. Check it with `cmux cloud machine-status --target machine:%2$@`, then run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` に接続できなかったため、エージェントは開始されませんでした。`cmux cloud machine-status --target machine:%2$@` で確認してから、`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` hat sich nicht verbunden, daher wurde dort kein Agent gestartet. Prüfe sie mit `cmux cloud machine-status --target machine:%2$@` und führe dann `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` ne s'est pas connectée, aucun agent n'y a donc démarré. Vérifiez-la avec `cmux cloud machine-status --target machine:%2$@`, puis relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` no se conectó, así que no se inició ningún agente. Revísala con `cmux cloud machine-status --target machine:%2$@` y vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يتصل الجهاز `%1$@`، لذا لم يبدأ أي وكيل عليه. افحصه باستخدام `cmux cloud machine-status --target machine:%2$@`، ثم شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`이(가) 연결되지 않아 에이전트가 시작되지 않았습니다. `cmux cloud machine-status --target machine:%2$@`로 확인한 다음 `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 未连接，因此没有启动代理。请用 `cmux cloud machine-status --target machine:%2$@` 检查，然后再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 未連線，因此沒有啟動代理。請用 `cmux cloud machine-status --target machine:%2$@` 檢查，然後再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}}
      }
    },
    "cloud.startSession.agentFailed": {
      "comment": "The machine is up but the agent session didn't start. %1$@ name, %2$@ id, %3$@ agent, %4$@ the reason in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started but its agent didn't (%4$@). Run `cmux cloud start-session --target machine:%2$@ --agent %3$@` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、エージェントは開始されませんでした (%4$@)。`cmux cloud start-session --target machine:%2$@ --agent %3$@` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, ihr Agent aber nicht (%4$@). Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@` erneut aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais pas son agent (%4$@). Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero su agente no (%4$@). Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@` لكن وكيله لم يبدأ (%4$@). شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 에이전트는 시작되지 않았습니다(%4$@). `cmux cloud start-session --target machine:%2$@ --agent %3$@`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但其代理未启动（%4$@）。请再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但其代理未啟動（%4$@）。請再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@`。"}}
      }
    },
    "cloud.startSession.needsFolder": {
      "comment": "The agent session needs a folder on the machine. %1$@ name, %2$@ id, %3$@ agent. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Machine `%1$@` started but its agent didn't: it needs a folder on that machine to start in. Run `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` again with a folder there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン `%1$@` は起動しましたが、エージェントは開始されませんでした: そのマシン上の開始フォルダが必要です。そのマシンのフォルダを指定して `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Maschine `%1$@` ist gestartet, ihr Agent aber nicht: Er braucht einen Ordner auf dieser Maschine zum Starten. Führe `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` erneut mit einem Ordner dort aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La machine `%1$@` a démarré, mais pas son agent : il lui faut un dossier sur cette machine où démarrer. Relancez `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` avec un dossier de cette machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La máquina `%1$@` se inició, pero su agente no: necesita una carpeta en esa máquina donde iniciarse. Vuelve a ejecutar `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` con una carpeta de allí."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدأ الجهاز `%1$@` لكن وكيله لم يبدأ: يحتاج إلى مجلد على ذلك الجهاز ليبدأ فيه. شغّل `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work` مرة أخرى مع مجلد هناك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 `%1$@`은(는) 시작됐지만 에이전트는 시작되지 않았습니다. 그 머신에서 시작할 폴더가 필요합니다. 그 머신의 폴더로 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器 `%1$@` 已启动，但其代理未启动：它需要在该机器上的一个文件夹中启动。请用该机器上的文件夹再次运行 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器 `%1$@` 已啟動，但其代理未啟動：它需要在該機器上的一個資料夾中啟動。請用該機器上的資料夾再次執行 `cmux cloud start-session --target machine:%2$@ --agent %3$@ --cwd /home/cmux/work`。"}}
      }
    },
    "cloud.startSession.ask": {
      "comment": "Card in an agent's chat. %1$@ is the agent (claude), %2$@ the Cloud machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The agent asks to start a %1$@ session on Cloud machine %2$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが Cloud マシン %2$@ で %1$@ セッションの開始を求めています。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Agent möchte eine %1$@-Sitzung auf der Cloud-Maschine %2$@ starten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'agent demande à démarrer une session %1$@ sur la machine Cloud %2$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El agente pide iniciar una sesión de %1$@ en la máquina de Cloud %2$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يطلب الوكيل بدء جلسة %1$@ على جهاز Cloud ‏%2$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 Cloud 머신 %2$@에서 %1$@ 세션을 시작하려고 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理请求在 Cloud 机器 %2$@ 上启动 %1$@ 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理請求在 Cloud 機器 %2$@ 上啟動 %1$@ 工作階段。"}}
      }
    },
    "cloud.startSession.askNew": {
      "comment": "Card in an agent's chat when the machine doesn't exist yet. %1$@ is the agent, %2$@ the new machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The agent asks to create Cloud machine %2$@ and start a %1$@ session there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "エージェントが Cloud マシン %2$@ を作成し、そこで %1$@ セッションを開始することを求めています。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Agent möchte die Cloud-Maschine %2$@ erstellen und dort eine %1$@-Sitzung starten."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "L'agent demande à créer la machine Cloud %2$@ et à y démarrer une session %1$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El agente pide crear la máquina de Cloud %2$@ e iniciar allí una sesión de %1$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يطلب الوكيل إنشاء جهاز Cloud ‏%2$@ وبدء جلسة %1$@ عليه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "에이전트가 Cloud 머신 %2$@을(를) 만들고 그곳에서 %1$@ 세션을 시작하려고 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "代理请求创建 Cloud 机器 %2$@ 并在其上启动 %1$@ 会话。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "代理請求建立 Cloud 機器 %2$@ 並在其上啟動 %1$@ 工作階段。"}}
      }
    },
    "cloud.startSession.starting": {
      "comment": "Card while the session starts. %1$@ is the agent, %2$@ the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Starting %1$@ on %2$@…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "%2$@ で %1$@ を開始しています…"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%1$@ wird auf %2$@ gestartet…"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Démarrage de %1$@ sur %2$@…"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Iniciando %1$@ en %2$@…"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "جارٍ بدء %1$@ على %2$@…"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%2$@에서 %1$@ 시작 중…"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "正在 %2$@ 上启动 %1$@…"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "正在 %2$@ 上啟動 %1$@…"}}
      }
    },
    "cloud.startSession.start": {
      "comment": "Button on the card: start the agent session.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Start"}},
        "ja": {"stringUnit": {"state": "translated", "value": "開始"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Starten"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Démarrer"}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Iniciar"}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "بدء"}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "시작"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "启动"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "啟動"}}
      }
    },
    "cloud.startSession.notInChat": {
      "comment": "An agent's run whose chat cmux can't find. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't find the chat this agent runs in, so there is nowhere to ask the person. Run `cmux cloud start-session` from an agent's shell in a cmux chat, or ask the person to run it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このエージェントが動いているチャットが見つからないため、確認できる場所がありません。cmux チャット内のエージェントのシェルから `cmux cloud start-session` を実行するか、本人に実行を依頼してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Chat dieses Agents wurde nicht gefunden, daher gibt es keinen Ort für die Frage. Führe `cmux cloud start-session` aus der Shell eines Agents in einem cmux-Chat aus oder bitte die Person, es auszuführen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de trouver la discussion de cet agent : il n'y a nulle part où poser la question. Lancez `cmux cloud start-session` depuis le shell d'un agent dans une discussion cmux, ou demandez à la personne de le lancer."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se encontró el chat de este agente, así que no hay dónde preguntar. Ejecuta `cmux cloud start-session` desde la shell de un agente en un chat de cmux, o pide a la persona que lo ejecute."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر العثور على الدردشة التي يعمل فيها هذا الوكيل، لذا لا يوجد مكان لطرح السؤال. شغّل `cmux cloud start-session` من صدفة وكيل في دردشة cmux، أو اطلب من الشخص تشغيله."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 에이전트가 실행 중인 채팅을 찾지 못해 물어볼 곳이 없습니다. cmux 채팅 속 에이전트의 셸에서 `cmux cloud start-session`을(를) 실행하거나 사용자에게 실행을 요청하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "找不到此代理所在的聊天，因此无处询问。请从 cmux 聊天中代理的 shell 运行 `cmux cloud start-session`，或请对方运行。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "找不到此代理所在的聊天，因此無處詢問。請從 cmux 聊天中代理的 shell 執行 `cmux cloud start-session`，或請對方執行。"}}
      }
    },
    "cloud.startSession.noPage": {
      "comment": "The card couldn't show in the chat. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't show the question in the chat, so nothing started. Run `cmux cloud start-session` again once the chat is open."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チャットに確認を表示できなかったため、何も開始されませんでした。チャットを開いてから `cmux cloud start-session` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Frage konnte im Chat nicht angezeigt werden, daher wurde nichts gestartet. Führe `cmux cloud start-session` erneut aus, sobald der Chat geöffnet ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d'afficher la question dans la discussion : rien n'a démarré. Relancez `cmux cloud start-session` une fois la discussion ouverte."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo mostrar la pregunta en el chat, así que no se inició nada. Vuelve a ejecutar `cmux cloud start-session` cuando el chat esté abierto."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر عرض السؤال في الدردشة، لذا لم يبدأ شيء. شغّل `cmux cloud start-session` مرة أخرى بعد فتح الدردشة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "채팅에 질문을 표시하지 못해 아무것도 시작되지 않았습니다. 채팅이 열리면 `cmux cloud start-session`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法在聊天中显示问题，因此没有启动任何内容。聊天打开后请再次运行 `cmux cloud start-session`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法在聊天中顯示問題，因此沒有啟動任何內容。聊天開啟後請再次執行 `cmux cloud start-session`。"}}
      }
    },
    "cloud.startSession.askOpen": {
      "comment": "A second ask while the chat's card is still open. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This chat already shows a question to start a Cloud session. Wait for the person's answer before you run `cmux cloud start-session` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このチャットにはすでに Cloud セッション開始の確認が表示されています。本人の回答を待ってから `cmux cloud start-session` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dieser Chat zeigt schon eine Frage zum Starten einer Cloud-Sitzung. Warte auf die Antwort der Person, bevor du `cmux cloud start-session` erneut ausführst."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette discussion affiche déjà une question pour démarrer une session Cloud. Attendez la réponse de la personne avant de relancer `cmux cloud start-session`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Este chat ya muestra una pregunta para iniciar una sesión de Cloud. Espera la respuesta de la persona antes de volver a ejecutar `cmux cloud start-session`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعرض هذه الدردشة بالفعل سؤالًا لبدء جلسة Cloud. انتظر إجابة الشخص قبل تشغيل `cmux cloud start-session` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 채팅에는 이미 Cloud 세션 시작 질문이 표시되어 있습니다. 사용자의 답을 기다린 다음 `cmux cloud start-session`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "此聊天已显示启动 Cloud 会话的问题。请等对方回答后再运行 `cmux cloud start-session`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "此聊天已顯示啟動 Cloud 工作階段的問題。請等對方回答後再執行 `cmux cloud start-session`。"}}
      }
    },
    "cloud.startSession.declined": {
      "comment": "The person chose Not now on the card. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The person chose Not now, so nothing started. Ask them in the chat before you run `cmux cloud start-session` again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "「後で」が選ばれたため、何も開始されませんでした。`cmux cloud start-session` をもう一度実行する前に、チャットで確認してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Person hat „Nicht jetzt“ gewählt, daher wurde nichts gestartet. Frag sie im Chat, bevor du `cmux cloud start-session` erneut ausführst."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La personne a choisi Pas maintenant : rien n'a démarré. Demandez-lui dans la discussion avant de relancer `cmux cloud start-session`."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La persona eligió Ahora no, así que no se inició nada. Pregúntale en el chat antes de volver a ejecutar `cmux cloud start-session`."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "اختار الشخص «ليس الآن»، لذا لم يبدأ شيء. اسأله في الدردشة قبل تشغيل `cmux cloud start-session` مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "사용자가 나중에를 선택해 아무것도 시작되지 않았습니다. `cmux cloud start-session`을(를) 다시 실행하기 전에 채팅에서 물어보세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "对方选择了“以后再说”，因此没有启动任何内容。再次运行 `cmux cloud start-session` 前请先在聊天中询问。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "對方選擇了「以後再說」，因此沒有啟動任何內容。再次執行 `cmux cloud start-session` 前請先在聊天中詢問。"}}
      }
    },
    "cloud.startSession.expired": {
      "comment": "Nobody answered the card in time. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Nobody answered the question in the chat within 2 minutes, so nothing started. Run `cmux cloud start-session` again when the person is there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "2 分以内にチャットの確認に回答がなかったため、何も開始されませんでした。本人がいるときに `cmux cloud start-session` をもう一度実行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Niemand hat die Frage im Chat innerhalb von 2 Minuten beantwortet, daher wurde nichts gestartet. Führe `cmux cloud start-session` erneut aus, wenn die Person da ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Personne n'a répondu à la question dans la discussion en 2 minutes : rien n'a démarré. Relancez `cmux cloud start-session` quand la personne est là."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Nadie respondió a la pregunta del chat en 2 minutos, así que no se inició nada. Vuelve a ejecutar `cmux cloud start-session` cuando la persona esté."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يُجب أحد عن السؤال في الدردشة خلال دقيقتين، لذا لم يبدأ شيء. شغّل `cmux cloud start-session` مرة أخرى عندما يكون الشخص موجودًا."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "2분 안에 채팅의 질문에 답한 사람이 없어 아무것도 시작되지 않았습니다. 사용자가 있을 때 `cmux cloud start-session`을(를) 다시 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "2 分钟内没有人回答聊天中的问题，因此没有启动任何内容。对方在时请再次运行 `cmux cloud start-session`。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "2 分鐘內沒有人回答聊天中的問題，因此沒有啟動任何內容。對方在時請再次執行 `cmux cloud start-session`。"}}
      }
    }
  },
  "version": "1.0"
}
