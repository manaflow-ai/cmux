    "workspaceVerbs.refusal.otherMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tabs cannot move to a workspace on another machine"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن نقل علامات التبويب إلى مساحة عمل على جهاز آخر"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kartice se ne mogu premjestiti u radni prostor na drugoj mašini"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "faner kan ikke flyttes til et arbejdsområde på en anden maskine"
          }
        },
