          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الجهاز غير متصل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mašina nije povezana"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
