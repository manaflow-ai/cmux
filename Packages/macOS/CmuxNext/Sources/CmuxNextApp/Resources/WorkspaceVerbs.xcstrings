        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "les onglets ne peuvent pas passer dans un espace de travail d’une autre machine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "le schede non possono passare a uno spazio di lavoro su un’altra macchina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブを別のマシンのワークスペースへ移動することはできません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងមិនអាចផ្លាស់ទីទៅកន្លែងធ្វើការលើម៉ាស៊ីនផ្សេងបានទេ"
