          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "faner kan ikke flyttes til et arbeidsområde på en annen maskin"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kart nie można przenieść do obszaru roboczego na innej maszynie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "as abas não podem ir para um espaço de trabalho em outra máquina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "вкладки нельзя перенести в рабочее пространство на другой машине"
          }
