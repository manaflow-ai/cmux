{
  "sourceLanguage": "en",
  "strings": {
    "workspaceVerbs.refusal.invalidIcon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the icon must be an SF Symbol name or one emoji"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يجب أن تكون الأيقونة اسم رمز SF Symbol أو رمزًا تعبيريًا واحدًا"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ikona mora biti naziv SF Symbola ili jedan emoji"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ikonet skal være et SF Symbol-navn eller én emoji"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "das Symbol muss ein SF-Symbol-Name oder ein Emoji sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el icono debe ser un nombre de SF Symbol o un emoji"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "l’icône doit être un nom SF Symbol ou un emoji"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "l’icona deve essere un nome SF Symbol o un’emoji"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アイコンはSF Symbol名か絵文字1文字にしてください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបតំណាងត្រូវតែជាឈ្មោះ SF Symbol ឬអេម៉ូជីមួយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아이콘은 SF Symbol 이름이나 이모지 하나여야 합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ikonet må være et SF Symbol-navn eller én emoji"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ikona musi być nazwą SF Symbol lub jednym emoji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o ícone deve ser um nome de SF Symbol ou um emoji"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "значок должен быть именем SF Symbol или одним эмодзи"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไอคอนต้องเป็นชื่อ SF Symbol หรืออีโมจิหนึ่งตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "simge bir SF Symbol adı veya tek bir emoji olmalı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "піктограма має бути назвою SF Symbol або одним емодзі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "biểu tượng phải là tên SF Symbol hoặc một emoji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "图标必须是 SF Symbol 名称或一个表情符号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "圖示必須是 SF Symbol 名稱或一個表情符號"
          }
        }
      }
    },
    "workspaceVerbs.refusal.machineNotConnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the machine is not connected"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الجهاز غير متصل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mašina nije povezana"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "maskinen er ikke forbundet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "die Maschine ist nicht verbunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la máquina no está conectada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la machine n’est pas connectée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la macchina non è connessa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "マシンが接続されていません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីនមិនបានភ្ជាប់ទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "머신이 연결되어 있지 않습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "maskinen er ikke tilkoblet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "maszyna nie jest połączona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "a máquina não está conectada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "машина не подключена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องไม่ได้เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "makine bağlı değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "машина не підключена"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "máy chưa được kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "机器未连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "機器未連線"
          }
        }
      }
    },
    "workspaceVerbs.refusal.mergeIntoItself": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a workspace cannot merge into itself"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن دمج مساحة عمل في نفسها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "radni prostor se ne može spojiti sam u sebe"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "et arbejdsområde kan ikke flettes ind i sig selv"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ein Arbeitsbereich kann nicht mit sich selbst zusammengeführt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "un espacio de trabajo no puede combinarse consigo mismo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "un espace de travail ne peut pas fusionner avec lui-même"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "uno spazio di lavoro non può unirsi a sé stesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペースを自分自身に統合することはできません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការមិនអាចបញ្ចូលទៅក្នុងខ្លួនឯងបានទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간을 자기 자신에 병합할 수 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "et arbeidsområde kan ikke slås sammen med seg selv"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "obszaru roboczego nie można scalić z nim samym"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "um espaço de trabalho não pode ser mesclado em si mesmo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "рабочее пространство нельзя объединить с самим собой"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถรวมพื้นที่ทำงานเข้ากับตัวเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bir çalışma alanı kendisiyle birleştirilemez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "робочий простір не можна об’єднати із самим собою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "không thể gộp không gian làm việc vào chính nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作区不能合并到自身"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作區無法合併到自身"
          }
        }
      }
    },
    "workspaceVerbs.refusal.mergeTargetRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "an into argument naming a workspace is required"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يلزم وسيط into يسمي مساحة عمل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "potreban je argument into koji imenuje radni prostor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "et into-argument med et arbejdsområde er påkrævet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ein Argument into mit einem Arbeitsbereich ist erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "se requiere un argumento into con un espacio de trabajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "un argument into désignant un espace de travail est requis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "serve un argomento into che indichi uno spazio di lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペースを指定する into 引数が必要です"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រូវការអាគុយម៉ង់ into ដែលដាក់ឈ្មោះកន្លែងធ្វើការ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간을 지정하는 into 인수가 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "et into-argument som angir et arbeidsområde, kreves"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wymagany jest argument into wskazujący obszar roboczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "é necessário um argumento into com um espaço de trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нужен аргумент into с рабочим пространством"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ต้องมีอาร์กิวเมนต์ into ที่ระบุพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bir çalışma alanını belirten into bağımsız değişkeni gerekli"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "потрібен аргумент into з робочим простором"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cần đối số into chỉ một không gian làm việc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要指定工作区的 into 参数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要指定工作區的 into 引數"
          }
        }
      }
    },
    "workspaceVerbs.refusal.noDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the workspace has no terminal with a known directory"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تحتوي مساحة العمل على طرفية بمجلد معروف"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "radni prostor nema terminal s poznatim direktorijem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "arbejdsområdet har ingen terminal med en kendt mappe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "der Arbeitsbereich hat kein Terminal mit bekanntem Verzeichnis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el espacio de trabajo no tiene un terminal con carpeta conocida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "l’espace de travail n’a aucun terminal avec un dossier connu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "lo spazio di lavoro non ha un terminale con una cartella nota"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ワークスペースにディレクトリが分かるターミナルがありません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កន្លែងធ្វើការគ្មានស្ថានីយដែលស្គាល់ថតទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "작업 공간에 디렉터리를 알 수 있는 터미널이 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "arbeidsområdet har ingen terminal med kjent mappe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "obszar roboczy nie ma terminala ze znanym katalogiem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o espaço de trabalho não tem terminal com diretório conhecido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "в рабочем пространстве нет терминала с известной папкой"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พื้นที่ทำงานไม่มีเทอร์มินัลที่ทราบไดเรกทอรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "çalışma alanında dizini bilinen bir terminal yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "у робочому просторі немає термінала з відомою текою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "không gian làm việc không có terminal nào biết thư mục"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作区中没有已知目录的终端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "工作區中沒有已知目錄的終端機"
          }
        }
      }
    },
    "workspaceVerbs.refusal.noLastUsed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this window has not shown another workspace yet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تعرض هذه النافذة مساحة عمل أخرى بعد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ovaj prozor još nije prikazao drugi radni prostor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "dette vindue har ikke vist et andet arbejdsområde endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "dieses Fenster hat noch keinen anderen Arbeitsbereich gezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "esta ventana aún no ha mostrado otro espacio de trabajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cette fenêtre n’a pas encore affiché d’autre espace de travail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "questa finestra non ha ancora mostrato un altro spazio di lavoro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このウインドウはまだ他のワークスペースを表示していません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្អួចនេះមិនទាន់បង្ហាញកន្លែងធ្វើការផ្សេងទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 윈도우는 아직 다른 작업 공간을 표시하지 않았습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "dette vinduet har ikke vist et annet arbeidsområde ennå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "to okno nie pokazało jeszcze innego obszaru roboczego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "esta janela ainda não mostrou outro espaço de trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "это окно ещё не показывало другое рабочее пространство"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าต่างนี้ยังไม่เคยแสดงพื้นที่ทำงานอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bu pencere henüz başka bir çalışma alanı göstermedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "це вікно ще не показувало інший робочий простір"
          }
        },
        "vi": {
