{
  "sourceLanguage": "en",
  "strings": {
    "cookieImport.prompt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay signed in to your sites"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトにサインインしたままにする"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابقَ مسجّلاً الدخول إلى مواقعك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ostanite prijavljeni na svoje stranice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbliv logget ind på dine websteder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei deinen Websites angemeldet bleiben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén la sesión iniciada en tus sitios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Restez connecté à vos sites"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resta connesso ai tuoi siti"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្តចូលគណនីលើគេហទំព័ររបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이트에 로그인된 상태 유지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbli logget på nettstedene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostań zalogowany na swoich stronach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Continue conectado aos seus sites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставайтесь в своих аккаунтах на сайтах"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลงชื่อเข้าใช้เว็บไซต์ของคุณต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitelerinizde oturumunuz açık kalsın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Залишайтеся в обліковому записі на своїх сайтах"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luôn đăng nhập vào các trang web của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保持网站的登录状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保持網站的登入狀態"
          }
        }
      }
    },
    "cookieImport.prompt.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import cookies from your other browsers. Only cookies come over, and nothing leaves this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのブラウザから Cookie を読み込みます。読み込むのは Cookie だけで、データがこの Mac の外に出ることはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استورد ملفات تعريف الارتباط من متصفحاتك الأخرى. تُنقل ملفات تعريف الارتباط فقط، ولا يغادر أي شيء جهاز Mac هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvezite kolačiće iz drugih preglednika. Prenose se samo kolačići i ništa ne napušta ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importér cookies fra dine andre browsere. Kun cookies kommer med, og intet forlader denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importiere Cookies aus deinen anderen Browsern. Nur Cookies werden übernommen, und nichts verlässt diesen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa cookies de tus otros navegadores. Solo se traen las cookies y nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importez les cookies de vos autres navigateurs. Seuls les cookies sont importés, et rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa i cookie dagli altri browser. Vengono importati solo i cookie e nulla lascia questo Mac."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នាំចូលខូគីពីកម្មវិធីរុករកផ្សេងទៀតរបស់អ្នក។ មានតែខូគីប៉ុណ្ណោះដែលត្រូវបាននាំចូល ហើយគ្មានអ្វីចេញពី Mac នេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 브라우저에서 쿠키를 가져옵니다. 쿠키만 가져오며 어떤 데이터도 이 Mac 밖으로 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importer informasjonskapsler fra de andre nettleserne dine. Bare informasjonskapsler blir med, og ingenting forlater denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaimportuj pliki cookie z innych przeglądarek. Przenoszone są tylko pliki cookie i nic nie opuszcza tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importe cookies dos seus outros navegadores. Só os cookies são trazidos, e nada sai deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импортируйте файлы cookie из других браузеров. Переносятся только файлы cookie, и ничего не покидает этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำเข้าคุกกี้จากเบราว์เซอร์อื่นของคุณ นำเข้าเฉพาะคุกกี้ และไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer tarayıcılarınızdan çerezleri içe aktarın. Yalnızca çerezler aktarılır ve hiçbir şey bu Mac'ten çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Імпортуйте файли cookie з інших браузерів. Переносяться лише файли cookie, і ніщо не залишає цей Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập cookie từ các trình duyệt khác của bạn. Chỉ cookie được chuyển sang và không có gì rời khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从其他浏览器导入 Cookie。只导入 Cookie，任何数据都不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從其他瀏覽器匯入 Cookie。只匯入 Cookie，任何資料都不會離開這台 Mac。"
          }
        }
      }
    },
