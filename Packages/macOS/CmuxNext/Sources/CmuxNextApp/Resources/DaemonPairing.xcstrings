    "daemonPairing.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can then read and send your messages, open workspaces and type in terminals for 8 hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنها بعد ذلك قراءة رسائلك وإرسالها وفتح مساحات العمل والكتابة في الطرفيات لمدة 8 ساعات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tada 8 sati može čitati i slati tvoje poruke, otvarati radne prostore i kucati u terminalima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den kan derefter læse og sende dine beskeder, åbne arbejdsområder og skrive i terminaler i 8 timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie kann dann 8 Stunden lang deine Nachrichten lesen und senden, Arbeitsbereiche öffnen und in Terminals tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Después podrá leer y enviar tus mensajes, abrir espacios de trabajo y escribir en terminales durante 8 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elle pourra alors lire et envoyer vos messages, ouvrir des espaces de travail et taper dans les terminaux pendant 8 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potrà quindi leggere e inviare i tuoi messaggi, aprire spazi di lavoro e scrivere nei terminali per 8 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "承認すると、8 時間メッセージの閲覧と送信、ワークスペースを開く操作、ターミナルへの入力ができます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បន្ទាប់មក វាអាចអាន និងផ្ញើសាររបស់អ្នក បើកកន្លែងធ្វើការ និងវាយក្នុងទែមីណាល់បាន 8 ម៉ោង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "승인하면 8시간 동안 메시지를 읽고 보내고, 워크스페이스를 열고, 터미널에 입력할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den kan da lese og sende meldingene dine, åpne arbeidsområder og skrive i terminaler i 8 timer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przez 8 godzin będzie mogła czytać i wysyłać Twoje wiadomości, otwierać obszary robocze i pisać w terminalach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois ela poderá ler e enviar suas mensagens, abrir espaços de trabalho e digitar nos terminais por 8 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Затем в течение 8 часов она сможет читать и отправлять ваши сообщения, открывать рабочие пространства и печатать в терминалах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จากนั้นหน้านั้นจะอ่านและส่งข้อความของคุณ เปิดเวิร์กสเปซ และพิมพ์ในเทอร์มินัลได้เป็นเวลา 8 ชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ardından 8 saat boyunca mesajlarını okuyup gönderebilir, çalışma alanları açabilir ve terminallere yazabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Потім протягом 8 годин вона зможе читати й надсилати ваші повідомлення, відкривати робочі простори й друкувати в терміналах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sau đó trang có thể đọc và gửi tin nhắn của bạn, mở không gian làm việc và gõ trong terminal trong 8 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "之后它可以在 8 小时内读取和发送你的消息、打开工作区并在终端中输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "之後它可以在 8 小時內讀取和傳送你的訊息、開啟工作區並在終端機中輸入。"
          }
        }
      }
    },
