{
  "sourceLanguage": "en",
  "strings": {
    "daemonPairing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a browser to control cmux?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تسمح لمتصفح بالتحكم في cmux؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoliti pregledniku da upravlja cmuxom?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du lade en browser styre cmux?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einem Browser erlauben, cmux zu steuern?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir que un navegador controle cmux?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser un navigateur à contrôler cmux ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consentire a un browser di controllare cmux?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザに cmux の操作を許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតឱ្យកម្មវិធីរុករកគ្រប់គ្រង cmux ឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저가 cmux를 제어하도록 허용할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du la en nettleser styre cmux?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolić przeglądarce na sterowanie cmux?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir que um navegador controle o cmux?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить браузеру управлять cmux?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตให้เบราว์เซอร์ควบคุม cmux หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir tarayıcının cmux'u denetlemesine izin verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити браузеру керувати cmux?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép trình duyệt điều khiển cmux?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许浏览器控制 cmux？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許瀏覽器控制 cmux？"
          }
        }
      }
    },
    "daemonPairing.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A browser page asked to connect to this cmux. Approve only if it shows the code %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلبت صفحة في متصفح الاتصال بـ cmux هذا. وافق فقط إذا كانت تعرض الرمز %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stranica u pregledniku traži vezu s ovim cmuxom. Odobri samo ako prikazuje kod %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En browserside bad om at oprette forbindelse til denne cmux. Godkend kun, hvis den viser koden %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Browserseite möchte sich mit diesem cmux verbinden. Genehmige nur, wenn sie den Code %@ zeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una página del navegador pidió conectarse a este cmux. Aprueba solo si muestra el código %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une page de navigateur demande à se connecter à ce cmux. N’approuvez que si elle affiche le code %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una pagina del browser ha chiesto di connettersi a questo cmux. Approva solo se mostra il codice %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブラウザのページがこの cmux への接続を求めています。コード %@ が表示されている場合のみ承認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទំព័រកម្មវិធីរុករកមួយបានស្នើភ្ជាប់ទៅ cmux នេះ។ យល់ព្រមតែពេលវាបង្ហាញលេខកូដ %@ ប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 페이지가 이 cmux에 연결을 요청했습니다. 코드 %@이(가) 표시될 때만 승인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En nettleserside ba om å koble til denne cmux. Godkjenn bare hvis den viser koden %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Strona w przeglądarce prosi o połączenie z tym cmux. Zatwierdź tylko, jeśli pokazuje kod %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma página do navegador pediu para se conectar a este cmux. Aprove somente se ela mostrar o código %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Страница в браузере запросила подключение к этому cmux. Одобряйте, только если она показывает код %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าเว็บในเบราว์เซอร์ขอเชื่อมต่อกับ cmux นี้ อนุมัติเฉพาะเมื่อหน้านั้นแสดงรหัส %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir tarayıcı sayfası bu cmux'a bağlanmak istedi. Yalnızca %@ kodunu gösteriyorsa onayla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сторінка в браузері просить підключитися до цього cmux. Схвалюйте, лише якщо вона показує код %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một trang trình duyệt yêu cầu kết nối với cmux này. Chỉ chấp thuận nếu trang hiển thị mã %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一个浏览器页面请求连接到此 cmux。仅当它显示代码 %@ 时才批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一個瀏覽器頁面要求連線到此 cmux。僅在它顯示代碼 %@ 時才核准。"
          }
        }
      }
    },
