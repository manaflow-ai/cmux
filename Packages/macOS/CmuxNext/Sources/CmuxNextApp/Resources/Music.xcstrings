        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีเพลงที่กำลังเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalan müzik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Музика не відтворюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có nhạc đang phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有正在播放的音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有正在播放的音樂。"
          }
        }
      }
    },
    "music.choose.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر أغاني أو مجلدات لتشغيلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite pjesme ili mape za puštanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg sange eller mapper, der skal afspilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle Songs oder Ordner zum Abspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose songs or folders to play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige canciones o carpetas para reproducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez des morceaux ou des dossiers à lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli brani o cartelle da riprodurre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再生する曲またはフォルダを選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសរើសបទចម្រៀង ឬថតដើម្បីចាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재생할 노래나 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg sanger eller mapper som skal spilles av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz utwory lub foldery do odtworzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha músicas ou pastas para tocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите песни или папки для воспроизведения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกเพลงหรือโฟลเดอร์ที่จะเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalınacak şarkıları veya klasörleri seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть пісні або папки для відтворення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn bài hát hoặc thư mục để phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择要播放的歌曲或文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇要播放的歌曲或資料夾。"
          }
        }
      }
    },
