{
  "sourceLanguage": "en",
  "strings": {
    "music.refusal.preview": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مشغل الموسيقى ميزة تجريبية: فعّل labs.previewFeatures في cmux.json."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muzički plejer je funkcija u pregledu: uključite labs.previewFeatures u cmux.json."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Musikafspilleren er en prøvefunktion: slå labs.previewFeatures til i cmux.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Musikplayer ist eine Vorschaufunktion: Aktiviere labs.previewFeatures in cmux.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music player is a preview feature: turn on labs.previewFeatures in cmux.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El reproductor de música es una función preliminar: activa labs.previewFeatures en cmux.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le lecteur de musique est une fonctionnalité en aperçu : activez labs.previewFeatures dans cmux.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il lettore musicale è una funzione in anteprima: attiva labs.previewFeatures in cmux.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ミュージックプレーヤーはプレビュー機能です。cmux.json で labs.previewFeatures をオンにしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីចាក់តន្ត្រីជាមុខងារសាកល្បង៖ បើក labs.previewFeatures ក្នុង cmux.json។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음악 플레이어는 미리 보기 기능입니다. cmux.json에서 labs.previewFeatures를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Musikkspilleren er en forhåndsvisningsfunksjon: slå på labs.previewFeatures i cmux.json."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odtwarzacz muzyki to funkcja w wersji zapoznawczej: włącz labs.previewFeatures w cmux.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O player de música é um recurso de prévia: ative labs.previewFeatures no cmux.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Музыкальный плеер — предварительная функция: включите labs.previewFeatures в cmux.json."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องเล่นเพลงเป็นฟีเจอร์ทดลอง: เปิด labs.previewFeatures ใน cmux.json"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Müzik çalar bir önizleme özelliğidir: cmux.json içinde labs.previewFeatures'ı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Музичний плеєр — попередня функція: увімкніть labs.previewFeatures у cmux.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trình phát nhạc là tính năng xem trước: bật labs.previewFeatures trong cmux.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音乐播放器是预览功能：请在 cmux.json 中开启 labs.previewFeatures。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音樂播放器是預覽功能：請在 cmux.json 中開啟 labs.previewFeatures。"
          }
        }
      }
    },
    "music.refusal.noSongs": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد أغانٍ هناك لتشغيلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tamo nema pjesama za puštanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der er ingen sange at afspille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dort gibt es keine Songs zum Abspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No songs there to play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay canciones para reproducir ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun morceau à lire ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun brano da riprodurre lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再生できる曲がありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានបទចម្រៀងនៅទីនោះដើម្បីចាក់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "재생할 노래가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen sanger å spille av der."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak utworów do odtworzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não há músicas para tocar aí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Там нет песен для воспроизведения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีเพลงให้เล่นที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Orada çalınacak şarkı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Там немає пісень для відтворення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có bài hát nào để phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "那里没有可播放的歌曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "那裡沒有可播放的歌曲。"
          }
        }
      }
    },
    "music.refusal.nothingPlaying": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد موسيقى قيد التشغيل."
          }
