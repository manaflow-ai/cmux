    "cli.error.occupiedChoices" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To make this app's CLI the cmux command, choose Replace or run `cmux settings install-cli-in-path --replace`. To keep both, install it as %@, which never shadows the other one."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لجعل واجهة سطر أوامر هذا التطبيق هي أمر cmux، اختر استبدال أو شغّل `cmux settings install-cli-in-path --replace`. للاحتفاظ بالاثنين، ثبّتها باسم %@، الذي لا يحجب الآخر أبدًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da CLI ove aplikacije postane naredba cmux, odaberite Zamijeni ili pokrenite `cmux settings install-cli-in-path --replace`. Da zadržite oba, instalirajte ga kao %@, koji nikad ne zaklanja drugi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Erstat eller kør `cmux settings install-cli-in-path --replace` for at gøre denne apps CLI til cmux-kommandoen. Installer den som %@ for at beholde begge; den skygger aldrig for den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit die CLI dieser App der Befehl cmux wird, wähle „Ersetzen“ oder führe `cmux settings install-cli-in-path --replace` aus. Um beide zu behalten, installiere sie als %@; das verdeckt die andere nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que la CLI de esta app sea el comando cmux, elige Reemplazar o ejecuta `cmux settings install-cli-in-path --replace`. Para conservar ambas, instálala como %@, que nunca oculta la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que la CLI de cette app devienne la commande cmux, choisissez Remplacer ou exécutez `cmux settings install-cli-in-path --replace`. Pour garder les deux, installez-la en tant que %@, qui ne masque jamais l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per rendere la CLI di questa app il comando cmux, scegli Sostituisci o esegui `cmux settings install-cli-in-path --replace`. Per tenerle entrambe, installala come %@, che non nasconde mai l'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの CLI を cmux コマンドにするには、「置き換える」を選ぶか `cmux settings install-cli-in-path --replace` を実行してください。両方を残すには %@ としてインストールしてください。もう一方を隠すことはありません。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ដើម្បីធ្វើឱ្យ CLI របស់កម្មវិធីនេះជាពាក្យបញ្ជា cmux សូមជ្រើស ជំនួស ឬដំណើរការ `cmux settings install-cli-in-path --replace`។ ដើម្បីរក្សាទុកទាំងពីរ សូមដំឡើងវាជា %@ ដែលមិនដែលបិទបាំងមួយទៀតឡើយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 CLI를 cmux 명령으로 쓰려면 대체를 선택하거나 `cmux settings install-cli-in-path --replace`를 실행하세요. 둘 다 유지하려면 %@로 설치하세요. 다른 CLI를 가리지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg Erstatt eller kjør `cmux settings install-cli-in-path --replace` for å gjøre dette programmets CLI til cmux-kommandoen. Installer det som %@ for å beholde begge; det skygger aldri for det andre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby CLI tej aplikacji było poleceniem cmux, wybierz Zastąp lub uruchom `cmux settings install-cli-in-path --replace`. Aby zachować oba, zainstaluj je jako %@, które nigdy nie przesłania drugiego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para tornar a CLI deste app o comando cmux, escolha Substituir ou execute `cmux settings install-cli-in-path --replace`. Para manter as duas, instale-a como %@, que nunca encobre a outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы CLI этого приложения стал командой cmux, выберите «Заменить» или выполните `cmux settings install-cli-in-path --replace`. Чтобы оставить оба, установите его как %@ — он никогда не перекрывает другой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการให้ CLI ของแอปนี้เป็นคำสั่ง cmux ให้เลือก แทนที่ หรือเรียกใช้ `cmux settings install-cli-in-path --replace` หากต้องการเก็บทั้งสองไว้ ให้ติดตั้งเป็น %@ ซึ่งจะไม่บังอีกตัวหนึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamanın CLI'ını cmux komutu yapmak için Değiştir'i seçin veya `cmux settings install-cli-in-path --replace` komutunu çalıştırın. İkisini de tutmak için %@ olarak yükleyin; diğerini asla gölgelemez."
          }
        },
        "uk" : {
