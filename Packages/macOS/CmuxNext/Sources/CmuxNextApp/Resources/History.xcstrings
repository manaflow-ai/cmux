          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przełącz okno na %@, aby tam ponownie otworzyć ten workspace"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mude uma janela para %@ para reabrir este workspace lá"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переключите окно на %@, чтобы снова открыть там этот workspace"
