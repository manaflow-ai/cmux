{
  "sourceLanguage": "en",
  "strings": {
    "paidPlans.welcome.title": {
      "comment": "The paid-plan welcome card in the sidebar, shown once after an upgrade. %@ is the plan name, for example cmux Pro.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ へようこそ"
          }
        }
      }
    },
    "paidPlans.welcome.detail": {
      "comment": "The welcome card's body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan is active. Start a Cloud machine, or see your usage and invoices on the billing page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランが有効になりました。Cloud マシンを起動するか、請求ページで利用状況と請求書を確認できます。"
          }
        }
      }
    },
    "paidPlans.welcome.start": {
      "comment": "The welcome card's main button: starts a new Cloud workspace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Cloud Workspace"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Cloud ワークスペース"
          }
        }
      }
    },
    "paidPlans.welcome.later": {
      "comment": "The welcome card's second button: closes the card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで"
          }
        }
      }
    },
    "paidPlans.plan.pro": {
      "comment": "Plan name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Pro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Pro"
          }
        }
      }
    },
    "paidPlans.plan.max": {
      "comment": "Plan name.",
      "extractionState": "manual",
