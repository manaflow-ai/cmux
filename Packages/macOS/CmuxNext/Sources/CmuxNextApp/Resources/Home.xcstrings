        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief를 보관할 수 없습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kunne ikke arkivere Chief. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się zarchiwizować Chiefa. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível arquivar o Chief. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось архивировать Chief. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เก็บ Chief ถาวรไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
