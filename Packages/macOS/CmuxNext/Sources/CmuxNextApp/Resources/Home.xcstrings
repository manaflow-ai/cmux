    "home.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations need a newer cmux daemon."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتطلب المحادثات إصدارًا أحدث من خادم cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Razgovori zahtijevaju noviji cmux daemon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samtaler kræver en nyere cmux-daemon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unterhaltungen benötigen einen neueren cmux-Daemon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las conversaciones requieren un daemon de cmux más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les conversations nécessitent un daemon cmux plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le conversazioni richiedono un daemon cmux più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話には新しい cmux デーモンが必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការសន្ទនាត្រូវការ cmux daemon ថ្មីជាងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "대화를 사용하려면 최신 cmux 데몬이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samtaler krever en nyere cmux-daemon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmowy wymagają nowszego demona cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As conversas exigem um daemon do cmux mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для бесед нужен более новый демон cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การสนทนาต้องใช้ cmux daemon เวอร์ชันใหม่กว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbetler daha yeni bir cmux arka plan hizmeti gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для розмов потрібен новіший демон cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuộc trò chuyện cần trình nền cmux mới hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "会话需要更新版本的 cmux 守护进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "對話需要較新版本的 cmux 常駐程式。"
          }
        }
      }
    },
