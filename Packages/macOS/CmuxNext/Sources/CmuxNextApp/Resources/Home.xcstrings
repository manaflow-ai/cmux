          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samtaler krever en nyere cmux-daemon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmowy wymagają nowszego demona cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As conversas exigem um daemon do cmux mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для бесед нужен более новый демон cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การสนทนาต้องใช้ cmux daemon เวอร์ชันใหม่กว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sohbetler daha yeni bir cmux arka plan hizmeti gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для розмов потрібен новіший демон cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
