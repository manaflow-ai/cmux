    "home.engine.brain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on this Mac (%@). Tools: zoom, date, spawn, tell and the harness's own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で動作します（%@）。ツール: zoom、date、spawn、tell とハーネス自身のツール。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعمل على جهاز Mac هذا (%@). الأدوات: zoom وdate وspawn وtell وأدوات الحزمة نفسها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Radi na ovom Macu (%@). Alati: zoom, date, spawn, tell i vlastiti alati okvira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kører på denne Mac (%@). Værktøjer: zoom, date, spawn, tell og harnessens egne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Läuft auf diesem Mac (%@). Werkzeuge: zoom, date, spawn, tell und die des Harness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se ejecuta en este Mac (%@). Herramientas: zoom, date, spawn, tell y las del harness."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S’exécute sur ce Mac (%@). Outils : zoom, date, spawn, tell et ceux du harness."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viene eseguito su questo Mac (%@). Strumenti: zoom, date, spawn, tell e quelli dell’harness."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការលើ Mac នេះ (%@)។ ឧបករណ៍៖ zoom, date, spawn, tell និងឧបករណ៍របស់ harness។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에서 실행됩니다(%@). 도구: zoom, date, spawn, tell 및 하니스 자체 도구."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjører på denne Macen (%@). Verktøy: zoom, date, spawn, tell og harnessens egne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Działa na tym Macu (%@). Narzędzia: zoom, date, spawn, tell i własne narzędzia harnessu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Executa neste Mac (%@). Ferramentas: zoom, date, spawn, tell e as do harness."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Работает на этом Mac (%@). Инструменты: zoom, date, spawn, tell и собственные инструменты харнесса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำงานบน Mac เครื่องนี้ (%@) เครื่องมือ: zoom, date, spawn, tell และของ harness เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac’te çalışır (%@). Araçlar: zoom, date, spawn, tell ve harness’in kendi araçları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Працює на цьому Mac (%@). Інструменти: zoom, date, spawn, tell і власні інструменти харнеса."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạy trên máy Mac này (%@). Công cụ: zoom, date, spawn, tell và công cụ của harness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此 Mac 上运行（%@）。工具：zoom、date、spawn、tell 以及 harness 自带的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此 Mac 上執行（%@）。工具：zoom、date、spawn、tell 以及 harness 自帶的工具。"
          }
        }
      }
    },
