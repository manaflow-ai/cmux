        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“จบทั้งหมด” จะลบเวิร์กสเปซของคุณด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her şeyi sonlandır, çalışma alanlarınızı da siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Завершити все» також видалить ваші робочі області."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết thúc tất cả cũng xóa các không gian làm việc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
