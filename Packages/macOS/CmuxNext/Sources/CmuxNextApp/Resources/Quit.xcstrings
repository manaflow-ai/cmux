    "recovery.noticeChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered unsaved changes in %@. The file changed on disk since; review before saving."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم استرداد التغييرات غير المحفوظة في %@. تغيّر الملف على القرص منذ ذلك الحين؛ راجعه قبل الحفظ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraćene nesačuvane promjene u %@. Datoteka se od tada promijenila na disku; pregledajte prije spremanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gendannede ugemte ændringer i %@. Filen er ændret på disken siden; gennemse før du gemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht gesicherte Änderungen in %@ wiederhergestellt. Die Datei hat sich seitdem auf dem Datenträger geändert; vor dem Sichern prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se recuperaron cambios sin guardar en %@. El archivo cambió en el disco desde entonces; revísalo antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modifications non enregistrées récupérées dans %@. Le fichier a changé sur le disque depuis ; vérifiez avant d’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modifiche non salvate recuperate in %@. Da allora il file è cambiato sul disco; controlla prima di salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の未保存の変更を復元しました。その後ファイルがディスク上で変更されています。保存する前に確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានស្ដារការផ្លាស់ប្ដូរមិនទាន់រក្សាទុកក្នុង %@។ ឯកសារបានផ្លាស់ប្ដូរលើថាសតាំងពីពេលនោះ សូមពិនិត្យមុនរក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 저장되지 않은 변경 사항을 복구했습니다. 그 뒤 파일이 디스크에서 변경되었으니 저장하기 전에 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gjenopprettet ulagrede endringer i %@. Filen er endret på disken siden; se gjennom før du lagrer."
