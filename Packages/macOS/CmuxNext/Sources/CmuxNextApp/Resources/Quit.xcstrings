            "value": "Quitter cmux ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uscire da cmux?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux を終了しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចាកចេញពី cmux ឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux를 종료할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vil du avslutte cmux?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamknąć cmux?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sair do cmux?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выйти из cmux?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ออกจาก cmux หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux'tan çıkılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вийти з cmux?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thoát cmux?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要退出 cmux 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "要結束 cmux 嗎？"
          }
        }
      }
    },
    "quit.remote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions on other machines are not affected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تتأثر الجلسات على الأجهزة الأخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesije na drugim računarima nisu pogođene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessioner på andre maskiner påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitzungen auf anderen Rechnern sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las sesiones en otras máquinas no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sessions sur d'autres machines ne sont pas affectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sessioni su altre macchine non sono interessate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ほかのマシンのセッションには影響しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "វគ្គនៅលើម៉ាស៊ីនផ្សេងទៀតមិនរងផលប៉ះពាល់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 컴퓨터의 세션에는 영향이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Økter på andre maskiner påvirkes ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesje na innych maszynach nie są zmieniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessões em outras máquinas não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сеансы на других компьютерах не затрагиваются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เซสชันบนเครื่องอื่นไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diğer makinelerdeki oturumlar etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сеанси на інших комп'ютерах не зачіпаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phiên trên các máy khác không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其他机器上的会话不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "其他機器上的工作階段不受影響。"
          }
        }
      }
    },
