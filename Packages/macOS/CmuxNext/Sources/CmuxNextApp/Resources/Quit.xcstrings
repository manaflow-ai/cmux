        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their running programs end, and their browser data is deleted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنتهي برامجها قيد التشغيل وتُحذف بيانات المتصفح الخاصة بها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Njihovi pokrenuti programi se završavaju, a podaci preglednika se brišu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deres kørende programmer afsluttes, og deres browserdata slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre laufenden Programme werden beendet und ihre Browserdaten gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sus programas en ejecución terminan y se eliminan sus datos del navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leurs programmes en cours s’arrêtent et leurs données de navigation sont supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I loro programmi in esecuzione terminano e i dati del browser vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実行中のプログラムは終了し、ブラウザ データは削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កម្មវិធីដែលកំពុងដំណើរការបញ្ចប់ ហើយទិន្នន័យកម្មវិធីរុករកត្រូវបានលុប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 중인 프로그램이 끝나고 브라우저 데이터가 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Programmene som kjører avsluttes, og nettleserdataene slettes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ich uruchomione programy zostaną zakończone, a dane przeglądarki usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os programas em execução são encerrados e os dados de navegação são apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запущенные программы завершатся, а данные браузера будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรแกรมที่กำลังทำงานจะจบลงและข้อมูลเบราว์เซอร์จะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalışan programlar sonlanır ve tarayıcı verileri silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запущені програми завершаться, а дані браузера буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các chương trình đang chạy sẽ kết thúc và dữ liệu trình duyệt bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
