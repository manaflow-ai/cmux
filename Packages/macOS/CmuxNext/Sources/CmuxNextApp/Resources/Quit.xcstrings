    "quit.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your terminals run in the background in cmux-tui, so they keep running after cmux quits. Keep them to reopen cmux and continue where you left off, or end them all now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعمل طرفياتك في الخلفية داخل cmux-tui، لذا تستمر بعد إنهاء cmux. أبقِها لتعيد فتح cmux وتتابع من حيث توقفت، أو أنهِها كلها الآن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vaši terminali rade u pozadini u cmux-tui, pa nastavljaju raditi nakon izlaska iz cmux. Zadržite ih da ponovo otvorite cmux i nastavite gdje ste stali, ili ih sve završite sada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dine terminaler kører i baggrunden i cmux-tui, så de fortsætter, når cmux afsluttes. Behold dem for at åbne cmux igen og fortsætte, hvor du slap, eller afslut dem alle nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Terminals laufen im Hintergrund in cmux-tui und laufen daher nach dem Beenden von cmux weiter. Behalte sie, um cmux wieder zu öffnen und dort weiterzumachen, wo du aufgehört hast, oder beende jetzt alle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus terminales se ejecutan en segundo plano en cmux-tui, así que siguen en marcha al salir de cmux. Mantenlos para volver a abrir cmux y continuar donde lo dejaste, o finalízalos todos ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos terminaux s'exécutent en arrière-plan dans cmux-tui et continuent donc après la fermeture de cmux. Conservez-les pour rouvrir cmux et reprendre là où vous en étiez, ou terminez-les tous maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tuoi terminali girano in background in cmux-tui, quindi continuano dopo l'uscita da cmux. Mantienili per riaprire cmux e riprendere da dove eri rimasto, oppure terminali tutti ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルは cmux-tui でバックグラウンド実行されているため、cmux を終了しても動き続けます。維持すれば cmux を開き直して続きから作業できます。今すべて終了することもできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ទែមីណាល់របស់អ្នកដំណើរការនៅផ្ទៃខាងក្រោយក្នុង cmux-tui ដូច្នេះវាបន្តដំណើរការបន្ទាប់ពី cmux ចាកចេញ។ រក្សាវាទុក ដើម្បីបើក cmux ម្ដងទៀត ហើយបន្តពីកន្លែងដែលអ្នកឈប់ ឬបញ្ចប់វាទាំងអស់ឥឡូវនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널은 cmux-tui에서 백그라운드로 실행되므로 cmux를 종료해도 계속 실행됩니다. 유지하면 cmux를 다시 열어 이어서 작업할 수 있고, 지금 모두 끝낼 수도 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminalene dine kjører i bakgrunnen i cmux-tui, så de fortsetter etter at cmux avsluttes. Behold dem for å åpne cmux igjen og fortsette der du slapp, eller avslutt alle nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje terminale działają w tle w cmux-tui, więc działają dalej po zamknięciu cmux. Zachowaj je, aby ponownie otworzyć cmux i kontynuować od miejsca, w którym skończyłeś, albo zamknij je wszystkie teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seus terminais rodam em segundo plano no cmux-tui, então continuam após sair do cmux. Mantenha-os para reabrir o cmux e continuar de onde parou, ou encerre todos agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши терминалы работают в фоне в cmux-tui, поэтому продолжают работать после выхода из cmux. Сохраните их, чтобы снова открыть cmux и продолжить с того же места, или завершите все сейчас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เทอร์มินัลของคุณทำงานเบื้องหลังใน cmux-tui จึงทำงานต่อหลังจากออกจาก cmux เก็บไว้เพื่อเปิด cmux อีกครั้งและทำต่อจากที่ค้างไว้ หรือจบทั้งหมดตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminalleriniz cmux-tui içinde arka planda çalışır, bu yüzden cmux kapandıktan sonra da çalışmaya devam eder. cmux'u yeniden açıp kaldığınız yerden devam etmek için onları koruyun ya da hepsini şimdi sonlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваші термінали працюють у фоні в cmux-tui, тому працюють далі після виходу з cmux. Збережіть їх, щоб знову відкрити cmux і продовжити з того самого місця, або завершіть усі зараз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các terminal của bạn chạy nền trong cmux-tui nên vẫn chạy sau khi thoát cmux. Giữ lại để mở lại cmux và tiếp tục từ chỗ đã dừng, hoặc kết thúc tất cả ngay bây giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的终端在 cmux-tui 中后台运行，因此退出 cmux 后仍会继续运行。保留它们，就能重新打开 cmux 从中断处继续；也可以现在全部结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的終端機在 cmux-tui 中於背景執行，因此結束 cmux 後仍會繼續執行。保留它們，就能重新開啟 cmux 從中斷處繼續；也可以現在全部終止。"
          }
        }
      }
    },
