{
  "sourceLanguage": "en",
  "strings": {
    "quit.agentsKeepWorking": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكلاء لا يزالون يعملون: %lld. يستمرون في العمل ويعاودون الاتصال عند إعادة فتح cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti koji još rade: %lld. Nastavljaju raditi i ponovo se povezuju kada ponovo otvorite cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter, der stadig arbejder: %lld. De kører videre og genforbindes, når du åbner cmux igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch arbeitende Agenten: %lld. Sie laufen weiter und verbinden sich wieder, wenn du cmux erneut öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents still working: %lld. They keep running and reattach when you reopen cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes que siguen trabajando: %lld. Siguen en ejecución y se vuelven a conectar al abrir cmux de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents encore au travail : %lld. Ils continuent de tourner et se reconnectent à la réouverture de cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti ancora al lavoro: %lld. Continuano a funzionare e si ricollegano quando riapri cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中のエージェント: %lld。実行は続き、cmux を再び開くと再接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារដែលនៅតែធ្វើការ៖ %lld។ ពួកវាបន្តដំណើរការ ហើយភ្ជាប់ឡើងវិញនៅពេលអ្នកបើក cmux ម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 작업 중인 에이전트: %lld. 계속 실행되며 cmux를 다시 열면 다시 연결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter som fortsatt arbeider: %lld. De fortsetter å kjøre og kobles til igjen når du åpner cmux på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenty nadal pracujące: %lld. Działają dalej i połączą się ponownie po ponownym otwarciu cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes ainda trabalhando: %lld. Eles continuam em execução e se reconectam quando você abrir o cmux de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агентов ещё работает: %lld. Они продолжат работу и переподключатся, когда вы снова откроете cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ที่ยังทำงานอยู่: %lld ตัว จะทำงานต่อและเชื่อมต่อใหม่เมื่อคุณเปิด cmux อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ çalışan ajanlar: %lld. Çalışmaya devam ederler ve cmux'u yeniden açtığınızda tekrar bağlanırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агентів ще працює: %lld. Вони продовжать роботу й перепідключаться, коли ви знову відкриєте cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử vẫn đang làm việc: %lld. Chúng tiếp tục chạy và kết nối lại khi bạn mở lại cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在工作的智能体：%lld 个。它们会继续运行，并在你重新打开 cmux 时重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在工作的代理程式：%lld 個。它們會繼續執行，並在你重新開啟 cmux 時重新連線。"
          }
        }
      }
    },
    "quit.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit cmux?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تريد إنهاء cmux؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izaći iz cmux?"
          }
        },
        "da": {
