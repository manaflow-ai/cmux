    "quit.incognitoCloses": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incognito windows close, and their programs end."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُغلق نوافذ التصفح المتخفي وتنتهي برامجها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anonimni prozori se zatvaraju i njihovi programi se završavaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inkognitovinduer lukkes, og deres programmer afsluttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inkognitofenster werden geschlossen und ihre Programme beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las ventanas de incógnito se cierran y sus programas terminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fenêtres de navigation privée se ferment et leurs programmes s’arrêtent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le finestre in incognito si chiudono e i loro programmi terminano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "シークレット ウィンドウは閉じ、そのプログラムは終了します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្អួចអនាមិកបិទ ហើយកម្មវិធីរបស់វាបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시크릿 창이 닫히고 그 안의 프로그램이 끝납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inkognitovinduer lukkes, og programmene deres avsluttes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okna incognito zostaną zamknięte, a ich programy zakończone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As janelas anônimas fecham e seus programas são encerrados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Окна инкогнито закроются, их программы завершатся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าต่างไม่ระบุตัวตนจะปิดและโปรแกรมในนั้นจะจบลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gizli pencereler kapanır ve programları sonlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вікна інкогніто закриються, їхні програми завершаться."
          }
        },
        "vi": {
