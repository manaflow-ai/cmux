    "quit.failed.keepRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you quit anyway, the terminals that did not end keep running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إذا أنهيت على أي حال، فستظل الطرفيات التي لم تنتهِ قيد التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ako ipak izađete, terminali koji nisu završeni nastavljaju raditi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvis du afslutter alligevel, fortsætter de terminaler, der ikke blev afsluttet, med at køre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn Sie trotzdem beenden, laufen die nicht beendeten Terminals weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si sales de todos modos, los terminales que no finalizaron siguen en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si vous quittez quand même, les terminaux non terminés continuent de s’exécuter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se esci comunque, i terminali non terminati continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このまま終了すると、終了できなかったターミナルは実行し続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បើអ្នកចាកចេញទោះយ៉ាងណា ទែមីណាល់ដែលមិនបានបញ្ចប់នឹងបន្តដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그래도 종료하면 끝나지 않은 터미널은 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvis du avslutter likevel, fortsetter terminalene som ikke ble avsluttet å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeśli mimo to zakończysz, niezakończone terminale będą nadal działać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se você sair mesmo assim, os terminais que não foram encerrados continuam em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если всё равно выйти, незавершённые терминалы продолжат работу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หากออกต่อไป เทอร์มินัลที่ไม่ได้จบจะยังคงทำงานอยู่"
          }
        },
        "tr": {
