    "quit.unsaved.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not quitting: %@ could not be saved. Save or close it, then quit again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الإنهاء: تعذّر حفظ %@. احفظه أو أغلقه، ثم أنهِ مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije izađeno: %@ nije moguće sačuvati. Sačuvajte ga ili zatvorite, pa ponovo izađite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslutter ikke: %@ kunne ikke gemmes. Gem eller luk det, og afslut igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht beendet: %@ konnte nicht gesichert werden. Sichern oder schließen Sie es und beenden Sie dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sale: no se pudo guardar %@. Guárdalo o ciérralo y vuelve a salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de fermeture : %@ n’a pas pu être enregistré. Enregistrez-le ou fermez-le, puis quittez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscita annullata: impossibile salvare %@. Salvalo o chiudilo, poi esci di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了しません：%@ を保存できませんでした。保存するか閉じてから、もう一度終了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនចាកចេញ៖ មិនអាចរក្សាទុក %@ បានទេ។ រក្សាទុក ឬបិទវា រួចចាកចេញម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하지 않음: %@을(를) 저장할 수 없습니다. 저장하거나 닫은 후 다시 종료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutter ikke: %@ kunne ikke lagres. Lagre eller lukk det, og avslutt på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zakończono: nie można zapisać %@. Zapisz lub zamknij, a potem zakończ ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não saiu: não foi possível salvar %@. Salve ou feche e saia novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход отменён: не удалось сохранить %@. Сохраните или закройте его и выйдите снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ออก: บันทึก %@ ไม่ได้ บันทึกหรือปิดก่อน แล้วออกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkılmadı: %@ kaydedilemedi. Kaydedin veya kapatın, sonra yeniden çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід скасовано: не вдалося зберегти %@. Збережіть або закрийте його й вийдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thoát: không thể lưu %@. Hãy lưu hoặc đóng nó rồi thoát lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未退出：无法保存 %@。请保存或关闭它，然后再次退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未結束：無法儲存 %@。請儲存或關閉它，然後再次結束。"
          }
        }
      }
    },
