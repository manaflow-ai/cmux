        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alterações não salvas recuperadas em %@. O arquivo mudou no disco desde então; revise antes de salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Восстановлены несохранённые изменения в %@. С тех пор файл изменился на диске; проверьте перед сохранением."
          }
        },
