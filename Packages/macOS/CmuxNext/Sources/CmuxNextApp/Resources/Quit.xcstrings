          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«បញ្ចប់ទាំងអស់» លុបកន្លែងធ្វើការរបស់អ្នកផងដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘모두 끝내기’는 워크스페이스도 삭제합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avslutt alt sletter også arbeidsområdene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamknij wszystko usuwa też Twoje obszary robocze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encerrar tudo também apaga seus espaços de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Завершить всё» также удалит ваши рабочие области."
