          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Деякі сеанси не завершилися"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một số phiên chưa kết thúc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "部分会话未能结束"
          }
        },
        "zh-Hant": {
