    "quit.end.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End Everything also deletes your workspaces."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خيار «إنهاء كل شيء» يحذف مساحات العمل أيضًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Završi sve briše i vaše radne prostore."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslut alt sletter også dine arbejdsområder."
          }
        },
        "de": {
