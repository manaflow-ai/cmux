    "recovery.noticeChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered unsaved changes in %@. The file changed on disk since."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استرداد التغييرات غير المحفوظة في %@. تغيّر الملف على القرص منذ ذلك الحين."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćene su nesačuvane izmjene u %@. Datoteka se u međuvremenu promijenila na disku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendannede ikke-gemte ændringer i %@. Filen er ændret på disken siden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungesicherte Änderungen in %@ wiederhergestellt. Die Datei hat sich seitdem auf der Festplatte geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuperaron los cambios sin guardar de %@. El archivo cambió en el disco desde entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications non enregistrées de %@ récupérées. Le fichier a changé sur le disque depuis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiche non salvate di %@ recuperate. Il file è cambiato sul disco nel frattempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の未保存の変更を復元しました。その後ファイルはディスク上で変更されています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានស្ដារការផ្លាស់ប្ដូរមិនទាន់រក្សាទុកក្នុង %@។ ឯកសារបានផ្លាស់ប្ដូរនៅលើថាសតាំងពីពេលនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 저장하지 않은 변경 사항을 복구했습니다. 그 사이 디스크의 파일이 변경되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettet ulagrede endringer i %@. Filen er endret på disken siden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzyskano niezapisane zmiany w %@. Plik na dysku zmienił się od tego czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações não salvas de %@ recuperadas. O arquivo mudou no disco desde então."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлены несохранённые изменения в %@. С тех пор файл на диске изменился."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนการเปลี่ยนแปลงที่ยังไม่บันทึกใน %@ แล้ว ไฟล์บนดิสก์เปลี่ยนไปตั้งแต่นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki kaydedilmemiş değişiklikler kurtarıldı. Dosya o zamandan beri diskte değişti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлено незбережені зміни в %@. Відтоді файл на диску змінився."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục thay đổi chưa lưu trong %@. Tệp trên ổ đĩa đã thay đổi kể từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复 %@ 中未保存的更改。此后磁盘上的文件已更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已復原 %@ 中未儲存的變更。此後磁碟上的檔案已變更。"
          }
        }
      }
    },
