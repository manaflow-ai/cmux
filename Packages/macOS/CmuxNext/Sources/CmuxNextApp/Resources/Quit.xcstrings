    "quit.unsaved.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not quitting: unsaved changes in %@ could not be saved. Save or close them in the app, then quit again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن يتم الإنهاء: تعذّر حفظ التغييرات غير المحفوظة في %@. احفظها أو أغلقها في التطبيق، ثم أنهِ مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatvaranje otkazano: nesačuvane promjene u %@ nisu sačuvane. Sačuvajte ih ili zatvorite u aplikaciji, pa ponovo zatvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afslutter ikke: ugemte ændringer i %@ kunne ikke gemmes. Gem eller luk dem i appen, og afslut derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht beendet: Nicht gesicherte Änderungen in %@ konnten nicht gesichert werden. Sichere oder schließe sie in der App und beende dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se sale: los cambios sin guardar en %@ no se pudieron guardar. Guárdalos o ciérralos en la app y vuelve a salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas de fermeture : les modifications non enregistrées de %@ n’ont pas pu être enregistrées. Enregistrez-les ou fermez-les dans l’app, puis quittez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uscita annullata: le modifiche non salvate in %@ non sono state salvate. Salvale o chiudile nell’app, poi esci di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了しません: %@ の未保存の変更を保存できませんでした。アプリで保存するか閉じてから、もう一度終了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនចាកចេញ៖ មិនអាចរក្សាទុកការផ្លាស់ប្ដូរក្នុង %@ បានទេ។ រក្សាទុក ឬបិទវានៅក្នុងកម្មវិធី រួចចាកចេញម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "종료하지 않음: %@의 저장되지 않은 변경 사항을 저장할 수 없습니다. 앱에서 저장하거나 닫은 후 다시 종료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avslutter ikke: ulagrede endringer i %@ kunne ikke lagres. Lagre eller lukk dem i appen, og avslutt så på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie zakończono: nie można zapisać niezapisanych zmian w %@. Zapisz je lub zamknij w aplikacji, a potem zakończ ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não encerrado: não foi possível salvar as alterações em %@. Salve-as ou feche-as no app e encerre novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выход отменён: не удалось сохранить несохранённые изменения в %@. Сохраните или закройте их в приложении и выйдите снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ออก: ไม่สามารถบันทึกการเปลี่ยนแปลงใน %@ ได้ บันทึกหรือปิดในแอป แล้วออกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çıkılmıyor: %@ içindeki kaydedilmemiş değişiklikler kaydedilemedi. Uygulamada kaydedin veya kapatın, sonra yeniden çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вихід скасовано: не вдалося зберегти незбережені зміни в %@. Збережіть або закрийте їх у застосунку, а тоді вийдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thoát: không thể lưu thay đổi chưa lưu trong %@. Hãy lưu hoặc đóng chúng trong ứng dụng, rồi thoát lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未退出：无法保存 %@ 中未保存的更改。请在应用中保存或关闭它们，然后再次退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
