            "value": "“%@” çalışma alanı kapanmadı: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Робочий простір «%@» не закрився: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không đóng được không gian làm việc “%@”: %@"
