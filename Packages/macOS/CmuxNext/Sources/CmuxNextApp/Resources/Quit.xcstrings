    "quit.failed.keepRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Anyway leaves them running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي «إنهاء على أي حال» عليها قيد التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ipak izađi“ ih ostavlja da rade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut alligevel lader dem køre videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Trotzdem beenden“ lässt sie weiterlaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de todos modos los deja en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter quand même les laisse s’exécuter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci comunque li lascia in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「このまま終了」では実行したままになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចាកចេញទោះយ៉ាងណា នឹងទុកវាឱ្យបន្តដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 종료하면 계속 실행된 채로 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt likevel lar dem fortsette å kjøre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ mimo to pozostawi je uruchomione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair mesmo assim os deixa em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Всё равно выйти» оставит их работать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกต่อไปจะปล่อยให้ทำงานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de Çık onları çalışır durumda bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Усе одно вийти» залишить їх працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn thoát sẽ để chúng tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“仍然退出”会让它们继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「仍然結束」會讓它們繼續執行。"
          }
        }
      }
    },
