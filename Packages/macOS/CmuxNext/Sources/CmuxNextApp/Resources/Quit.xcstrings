    "quit.dontAskAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t ask again"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا تسأل مرة أخرى"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne pitaj ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spørg ikke igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht mehr fragen"
          }
        },
        "es": {
          "stringUnit": {
