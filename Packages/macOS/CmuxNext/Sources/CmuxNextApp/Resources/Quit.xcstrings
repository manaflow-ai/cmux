    "quit.incognito.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incognito windows close either way: %@ end and their browser data is deleted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُغلق نوافذ التصفح المتخفي في الحالتين: ينتهي %@ وتُحذف بيانات المتصفح الخاصة بها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anonimni prozori se zatvaraju u svakom slučaju: %@ se završava i njihovi podaci preglednika se brišu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inkognitovinduer lukkes under alle omstændigheder: %@ afsluttes, og deres browserdata slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inkognitofenster werden in jedem Fall geschlossen: %@ endet und ihre Browserdaten werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las ventanas de incógnito se cierran en cualquier caso: %@ finaliza y se eliminan sus datos del navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fenêtres de navigation privée se ferment dans tous les cas : %@ s'arrête et leurs données de navigation sont supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le finestre in incognito si chiudono comunque: %@ termina e i loro dati del browser vengono eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "シークレット ウィンドウはどちらの場合も閉じます: %@ は終了し、ブラウザ データは削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បង្អួចអនាមិកបិទទោះយ៉ាងណាក៏ដោយ៖ %@ បញ្ចប់ ហើយទិន្នន័យកម្មវិធីរុករករបស់វាត្រូវបានលុប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시크릿 창은 어느 쪽이든 닫힙니다: %@이(가) 끝나고 브라우저 데이터가 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inkognitovinduer lukkes uansett: %@ avsluttes og nettleserdataene deres slettes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okna incognito zamykają się w każdym przypadku: %@ kończy działanie, a ich dane przeglądarki są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As janelas anônimas fecham de qualquer forma: %@ é encerrado e os dados de navegação são apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Окна инкогнито закрываются в любом случае: %@ завершается, а данные браузера удаляются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าต่างไม่ระบุตัวตนจะปิดไม่ว่าอย่างไร: %@ จะจบลงและข้อมูลเบราว์เซอร์จะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gizli pencereler her durumda kapanır: %@ sonlanır ve tarayıcı verileri silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вікна інкогніто закриваються в будь-якому разі: %@ завершується, а дані браузера видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cửa sổ ẩn danh luôn đóng: %@ kết thúc và dữ liệu trình duyệt của chúng bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无痕窗口无论如何都会关闭：%@ 将结束，其浏览器数据会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無痕視窗無論如何都會關閉：%@ 將終止，其瀏覽器資料會被刪除。"
          }
        }
      }
    },
    "quit.remote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
