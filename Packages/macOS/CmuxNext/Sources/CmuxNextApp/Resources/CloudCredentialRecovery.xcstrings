{
  "sourceLanguage": "en",
  "strings": {
    "cloud.credentialRecovery.laterMachines": {
      "comment": "First Claude login confirmation: later machines the person owns get the same login without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Cloud machines you own later get this login with no prompt."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تحصل الأجهزة السحابية التي تملكها لاحقًا على تسجيل الدخول هذا دون أي مطالبة."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Cloud mašine koje kasnije budete posjedovali dobiće ovu prijavu bez upita."}},
        "da": {"stringUnit": {"state": "translated", "value": "Cloud-maskiner, du ejer senere, får dette login uden at spørge."}},
        "de": {"stringUnit": {"state": "translated", "value": "Cloud-Maschinen, die dir später gehören, erhalten diese Anmeldung ohne Rückfrage."}},
        "es": {"stringUnit": {"state": "translated", "value": "Las máquinas en la nube que tengas más adelante recibirán este inicio de sesión sin preguntar."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les machines Cloud que vous posséderez ensuite recevront cette connexion sans demande."}},
        "it": {"stringUnit": {"state": "translated", "value": "Le macchine Cloud che possiederai in seguito riceveranno questo accesso senza richiesta."}},
        "ja": {"stringUnit": {"state": "translated", "value": "今後あなたが所有する Cloud マシンには、確認なしでこのログインが設定されます。"}},
        "km": {"stringUnit": {"state": "translated", "value": "ម៉ាស៊ីន Cloud ដែលអ្នកមាននៅពេលក្រោយ នឹងទទួលបានការចូលនេះដោយមិនសួរ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이후 소유하는 Cloud 머신에는 묻지 않고 이 로그인이 적용됩니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Cloud-maskiner du eier senere, får denne påloggingen uten å spørre."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Maszyny Cloud, które będziesz mieć później, otrzymają to logowanie bez pytania."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "As máquinas na nuvem que você tiver depois recebem este login sem perguntar."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Облачные машины, которыми вы будете владеть позже, получат этот вход без запроса."}},
        "th": {"stringUnit": {"state": "translated", "value": "เครื่อง Cloud ที่คุณเป็นเจ้าของภายหลังจะได้รับการลงชื่อเข้าใช้นี้โดยไม่ต้องถาม"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Daha sonra sahip olacağınız Cloud makineleri bu oturumu sormadan alır."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Хмарні машини, якими ви володітимете пізніше, отримають цей вхід без запиту."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Các máy Cloud bạn sở hữu sau này sẽ nhận đăng nhập này mà không cần hỏi."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你以后拥有的 Cloud 机器会自动获得此登录，无需再次确认。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你之後擁有的 Cloud 機器會自動取得此登入，無需再次確認。"}}
      }
    },
    "cloud.credentialRecovery.setUp": {
      "comment": "Button that confirms the first Claude login setup for a Cloud chat's machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Set Up"}},
        "ar": {"stringUnit": {"state": "translated", "value": "إعداد"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Postavi"}},
        "da": {"stringUnit": {"state": "translated", "value": "Konfigurer"}},
        "de": {"stringUnit": {"state": "translated", "value": "Einrichten"}},
        "es": {"stringUnit": {"state": "translated", "value": "Configurar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Configurer"}},
        "it": {"stringUnit": {"state": "translated", "value": "Configura"}},
        "ja": {"stringUnit": {"state": "translated", "value": "設定する"}},
        "km": {"stringUnit": {"state": "translated", "value": "រៀបចំ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "설정"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Konfigurer"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Skonfiguruj"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Configurar"}},
