    "cloud.credentialRecovery.transfer": {
      "comment": "Confirm credential transfer and chat restart.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Transfer and restart"}},
        "ar": {"stringUnit": {"state": "translated", "value": "نقل وإعادة تشغيل"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Prenesi i ponovo pokreni"}},
        "da": {"stringUnit": {"state": "translated", "value": "Overfør og genstart"}},
        "de": {"stringUnit": {"state": "translated", "value": "Übertragen und neu starten"}},
        "es": {"stringUnit": {"state": "translated", "value": "Transferir y reiniciar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Transférer et redémarrer"}},
        "it": {"stringUnit": {"state": "translated", "value": "Trasferisci e riavvia"}},
        "ja": {"stringUnit": {"state": "translated", "value": "転送して再起動"}},
        "km": {"stringUnit": {"state": "translated", "value": "ផ្ទេរ និងចាប់ផ្តើមឡើងវិញ"}},
        "ko": {"stringUnit": {"state": "translated", "value": "전송 및 다시 시작"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Overfør og start på nytt"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Przenieś i uruchom ponownie"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Transferir e reiniciar"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Перенести и перезапустить"}},
        "th": {"stringUnit": {"state": "translated", "value": "โอนและเริ่มใหม่"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Aktar ve yeniden başlat"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Перенести й перезапустити"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chuyển và khởi động lại"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "传输并重启"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳輸並重新啟動"}}
      }
    },
    "cloud.credentialRecovery.installedTitle": {
      "comment": "Credential installation succeeded but restarting the chat was deferred.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Credentials installed"}},
        "ar": {"stringUnit": {"state": "translated", "value": "تم تثبيت بيانات الاعتماد"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Vjerodajnice su instalirane"}},
        "da": {"stringUnit": {"state": "translated", "value": "Legitimationsoplysninger installeret"}},
        "de": {"stringUnit": {"state": "translated", "value": "Zugangsdaten installiert"}},
        "es": {"stringUnit": {"state": "translated", "value": "Credenciales instaladas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Identifiants installés"}},
        "it": {"stringUnit": {"state": "translated", "value": "Credenziali installate"}},
        "ja": {"stringUnit": {"state": "translated", "value": "認証情報をインストールしました"}},
        "km": {"stringUnit": {"state": "translated", "value": "បានដំឡើងព័ត៌មានសម្គាល់"}},
        "ko": {"stringUnit": {"state": "translated", "value": "자격 증명 설치됨"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Legitimasjon installert"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zainstalowano poświadczenia"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Credenciais instaladas"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Учётные данные установлены"}},
        "th": {"stringUnit": {"state": "translated", "value": "ติดตั้งข้อมูลรับรองแล้ว"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kimlik bilgileri yüklendi"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Облікові дані встановлено"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Đã cài đặt thông tin xác thực"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已安装凭据"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已安裝憑證"}}
      }
    },
    "cloud.credentialRecovery.restartDeferred": {
      "comment": "Explain how to retry when credential installation succeeded but the chat could not yet restart.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The chat could not restart yet. Wait for any running turn to finish, then retry the prompt."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تعذرت إعادة تشغيل المحادثة حتى الآن. انتظر انتهاء أي دور قيد التشغيل، ثم أعد محاولة الطلب."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Razgovor se još nije mogao ponovo pokrenuti. Sačekajte da se završi tekući potez, a zatim ponovo pokušajte poslati upit."}},
        "da": {"stringUnit": {"state": "translated", "value": "Chatten kunne endnu ikke genstartes. Vent, til en eventuel igangværende tur er afsluttet, og prøv derefter prompten igen."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der Chat konnte noch nicht neu gestartet werden. Warte, bis ein laufender Dialogschritt abgeschlossen ist, und versuche die Anfrage dann erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "El chat aún no se ha podido reiniciar. Espera a que termine cualquier turno en curso y vuelve a intentar la solicitud."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La conversation n’a pas encore pu redémarrer. Attendez la fin de tout tour en cours, puis réessayez la requête."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non è stato ancora possibile riavviare la chat. Attendi che finisca qualsiasi turno in corso, poi riprova la richiesta."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チャットをまだ再起動できませんでした。実行中のターンが完了するのを待ってから、プロンプトを再試行してください。"}},
        "km": {"stringUnit": {"state": "translated", "value": "មិនទាន់អាចចាប់ផ្តើមការជជែកឡើងវិញបានទេ។ រង់ចាំឱ្យវេនដែលកំពុងដំណើរការបញ្ចប់ រួចសាកល្បងសំណើម្តងទៀត។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "아직 채팅을 다시 시작할 수 없습니다. 진행 중인 턴이 끝날 때까지 기다린 후 프롬프트를 다시 시도하세요."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Samtalen kunne ikke startes på nytt ennå. Vent til en pågående tur er ferdig, og prøv deretter forespørselen igjen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się jeszcze uruchomić czatu ponownie. Poczekaj na zakończenie trwającej tury, a następnie ponów prośbę."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ainda não foi possível reiniciar o chat. Aguarde a conclusão de qualquer turno em andamento e tente enviar a solicitação novamente."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Пока не удалось перезапустить чат. Дождитесь завершения текущего хода, затем повторите запрос."}},
        "th": {"stringUnit": {"state": "translated", "value": "ยังไม่สามารถเริ่มแชทใหม่ได้ รอให้เทิร์นที่กำลังทำงานเสร็จสิ้น แล้วลองส่งพรอมต์อีกครั้ง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Sohbet henüz yeniden başlatılamadı. Devam eden turun bitmesini bekleyin, ardından istemi yeniden deneyin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Поки що не вдалося перезапустити чат. Дочекайтеся завершення поточного ходу, а потім повторіть запит."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Chưa thể khởi động lại cuộc trò chuyện. Hãy đợi lượt đang chạy kết thúc rồi thử lại yêu cầu."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂时无法重启聊天。请等待正在运行的轮次完成，然后重试提示。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫時無法重新啟動聊天。請等待執行中的回合完成，然後重試提示。"}}
      }
    }
  },
  "version": "1.0"
}
