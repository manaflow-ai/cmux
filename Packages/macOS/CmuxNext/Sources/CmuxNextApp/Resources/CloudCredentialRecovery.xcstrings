        "th": {"stringUnit": {"state": "translated", "value": "ตั้งค่า"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kur"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Налаштувати"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Thiết lập"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "设置"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "設定"}}
      }
    },
    "cloud.credentialRecovery.personalAccount": {
      "comment": "Fallback account name in the explicit credential-transfer confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Personal account"}},
        "ar": {"stringUnit": {"state": "translated", "value": "حساب شخصي"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Lični račun"}},
        "da": {"stringUnit": {"state": "translated", "value": "Personlig konto"}},
        "de": {"stringUnit": {"state": "translated", "value": "Persönliches Konto"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cuenta personal"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Compte personnel"}},
        "it": {"stringUnit": {"state": "translated", "value": "Account personale"}},
        "ja": {"stringUnit": {"state": "translated", "value": "個人アカウント"}},
        "km": {"stringUnit": {"state": "translated", "value": "គណនីផ្ទាល់ខ្លួន"}},
        "ko": {"stringUnit": {"state": "translated", "value": "개인 계정"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Personlig konto"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Konto osobiste"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Conta pessoal"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Личный аккаунт"}},
        "th": {"stringUnit": {"state": "translated", "value": "บัญชีส่วนตัว"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Kişisel hesap"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Особистий обліковий запис"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Tài khoản cá nhân"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "个人账户"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "個人帳號"}}
      }
    },
    "cloud.credentialRecovery.claudeDisclosure": {
      "comment": "Claude transfer disclosure. Keep claude setup-token unchanged; %@ is the account name. owner VM means a VM in owner authentication mode.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "cmux will run claude setup-token in a visible local terminal, then install the resulting one-year login on this owner VM for %@."}},
        "ar": {"stringUnit": {"state": "translated", "value": "سيشغّل cmux الأمر claude setup-token في نافذة طرفية محلية مرئية، ثم يثبّت تسجيل الدخول الناتج الصالح لمدة سنة على هذه الآلة الافتراضية المملوكة لك من أجل %@."}},
        "bs": {"stringUnit": {"state": "translated", "value": "cmux će pokrenuti claude setup-token u vidljivom lokalnom terminalu, a zatim instalirati dobijenu prijavu koja vrijedi godinu dana na ovu vlasničku virtuelnu mašinu za %@."}},
        "da": {"stringUnit": {"state": "translated", "value": "cmux kører claude setup-token i en synlig lokal terminal og installerer derefter det resulterende login, som gælder i et år, på denne ejers VM for %@."}},
        "de": {"stringUnit": {"state": "translated", "value": "cmux führt claude setup-token in einem sichtbaren lokalen Terminal aus und installiert anschließend die daraus erzeugte, ein Jahr gültige Anmeldung für %@ auf dieser Eigentümer-VM."}},
        "es": {"stringUnit": {"state": "translated", "value": "cmux ejecutará claude setup-token en un terminal local visible y luego instalará el inicio de sesión resultante, válido durante un año, en esta máquina virtual del propietario para %@."}},
        "fr": {"stringUnit": {"state": "translated", "value": "cmux exécutera claude setup-token dans un terminal local visible, puis installera la connexion obtenue, valable un an, sur cette VM propriétaire pour %@."}},
        "it": {"stringUnit": {"state": "translated", "value": "cmux eseguirà claude setup-token in un terminale locale visibile, quindi installerà l’accesso ottenuto, valido per un anno, su questa VM del proprietario per %@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "cmux は表示されたローカルターミナルで claude setup-token を実行し、取得した有効期間1年のログイン情報を %@ 用にこの所有者の VM にインストールします。"}},
        "km": {"stringUnit": {"state": "translated", "value": "cmux នឹងដំណើរការ claude setup-token ក្នុងស្ថានីយមូលដ្ឋានដែលអាចមើលឃើញ រួចដំឡើងព័ត៌មានចូលដែលមានសុពលភាពមួយឆ្នាំនៅលើ VM របស់ម្ចាស់នេះសម្រាប់ %@។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "cmux가 표시되는 로컬 터미널에서 claude setup-token을 실행한 후, 생성된 1년 유효 로그인 정보를 %@용으로 이 소유자 VM에 설치합니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "cmux vil kjøre claude setup-token i en synlig lokal terminal og deretter installere den resulterende påloggingen, som er gyldig i ett år, på denne eierens VM for %@."}},
        "pl": {"stringUnit": {"state": "translated", "value": "cmux uruchomi claude setup-token w widocznym lokalnym terminalu, a następnie zainstaluje uzyskane dane logowania ważne przez rok na tej maszynie wirtualnej właściciela dla %@."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O cmux executará claude setup-token em um terminal local visível e instalará o login resultante, válido por um ano, nesta VM do proprietário para %@."}},
        "ru": {"stringUnit": {"state": "translated", "value": "cmux запустит claude setup-token в видимом локальном терминале, а затем установит полученные данные входа со сроком действия один год на эту виртуальную машину владельца для %@."}},
        "th": {"stringUnit": {"state": "translated", "value": "cmux จะเรียกใช้ claude setup-token ในเทอร์มินัลภายในเครื่องที่มองเห็นได้ แล้วติดตั้งข้อมูลเข้าสู่ระบบที่สร้างขึ้นซึ่งมีอายุหนึ่งปีบน VM ของเจ้าของนี้สำหรับ %@"}},
        "tr": {"stringUnit": {"state": "translated", "value": "cmux, görünür bir yerel terminalde claude setup-token komutunu çalıştıracak, ardından oluşan bir yıllık oturum açma bilgilerini %@ için bu sahibine ait sanal makineye yükleyecek."}},
        "uk": {"stringUnit": {"state": "translated", "value": "cmux запустить claude setup-token у видимому локальному терміналі, а потім встановить отримані дані входу з терміном дії один рік на цю віртуальну машину власника для %@."}},
        "vi": {"stringUnit": {"state": "translated", "value": "cmux sẽ chạy claude setup-token trong cửa sổ dòng lệnh cục bộ hiển thị, sau đó cài đặt thông tin đăng nhập có thời hạn một năm vừa tạo trên máy ảo của chủ sở hữu này cho %@."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "cmux 将在可见的本地终端中运行 claude setup-token，然后将生成的有效期为一年的登录凭据安装到此所有者虚拟机上，供 %@ 使用。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "cmux 將在可見的本機終端機中執行 claude setup-token，然後將產生的有效期限為一年的登入憑證安裝到此擁有者虛擬機器上，供 %@ 使用。"}}
      }
    },
    "cloud.credentialRecovery.codexDisclosure": {
      "comment": "Codex transfer disclosure for the per-VM device-login path; refresh credentials never move between machines.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "cmux will start a fresh Codex device login in a visible local terminal for this VM. Codex refresh credentials are never copied between VMs; Codex requires a separate sign-in for each VM."}},
        "ar": {"stringUnit": {"state": "translated", "value": "سيبدأ cmux تسجيل دخول جديدًا عبر جهاز Codex في نافذة طرفية محلية مرئية لهذه الآلة الافتراضية. لا تُنسخ بيانات اعتماد تجديد Codex بين الآلات الافتراضية أبدًا؛ يتطلب Codex تسجيل دخول منفصلًا لكل آلة افتراضية."}},
        "bs": {"stringUnit": {"state": "translated", "value": "cmux će pokrenuti novu Codex prijavu putem uređaja u vidljivom lokalnom terminalu za ovu virtuelnu mašinu. Codex vjerodajnice za osvježavanje nikada se ne kopiraju između virtuelnih mašina; Codex zahtijeva zasebnu prijavu za svaku virtuelnu mašinu."}},
        "da": {"stringUnit": {"state": "translated", "value": "cmux starter et nyt Codex-enhedslogin i en synlig lokal terminal til denne VM. Codex-legitimationsoplysninger til fornyelse kopieres aldrig mellem VM’er; Codex kræver et separat login til hver VM."}},
        "de": {"stringUnit": {"state": "translated", "value": "cmux startet für diese VM eine neue Codex-Geräteanmeldung in einem sichtbaren lokalen Terminal. Codex-Zugangsdaten zur Erneuerung werden niemals zwischen VMs kopiert; Codex erfordert für jede VM eine separate Anmeldung."}},
        "es": {"stringUnit": {"state": "translated", "value": "cmux iniciará un nuevo inicio de sesión de dispositivo de Codex en un terminal local visible para esta máquina virtual. Las credenciales de renovación de Codex nunca se copian entre máquinas virtuales; Codex requiere un inicio de sesión independiente para cada una."}},
        "fr": {"stringUnit": {"state": "translated", "value": "cmux lancera une nouvelle connexion par appareil Codex dans un terminal local visible pour cette VM. Les identifiants de renouvellement Codex ne sont jamais copiés entre les VM ; Codex exige une connexion distincte pour chaque VM."}},
        "it": {"stringUnit": {"state": "translated", "value": "cmux avvierà un nuovo accesso tramite dispositivo Codex in un terminale locale visibile per questa VM. Le credenziali di rinnovo di Codex non vengono mai copiate tra VM; Codex richiede un accesso separato per ogni VM."}},
        "ja": {"stringUnit": {"state": "translated", "value": "cmux は、この VM 用に表示されたローカルターミナルで新しい Codex デバイスログインを開始します。Codex の更新用認証情報を VM 間でコピーすることはありません。Codex では VM ごとに個別のサインインが必要です。"}},
        "km": {"stringUnit": {"state": "translated", "value": "cmux នឹងចាប់ផ្តើមការចូលតាមឧបករណ៍ Codex ថ្មីក្នុងស្ថានីយមូលដ្ឋានដែលអាចមើលឃើញសម្រាប់ VM នេះ។ ព័ត៌មានសម្គាល់សម្រាប់បន្តសុពលភាពរបស់ Codex មិនត្រូវបានចម្លងរវាង VM ទេ។ Codex តម្រូវឱ្យចូលដោយឡែកសម្រាប់ VM នីមួយៗ។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "cmux가 이 VM용으로 표시되는 로컬 터미널에서 새 Codex 기기 로그인을 시작합니다. Codex 갱신 자격 증명은 VM 간에 복사되지 않습니다. Codex는 각 VM에서 별도로 로그인해야 합니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "cmux starter en ny Codex-enhetspålogging i en synlig lokal terminal for denne VM-en. Codex-legitimasjon for fornyelse kopieres aldri mellom VM-er; Codex krever en separat pålogging for hver VM."}},
        "pl": {"stringUnit": {"state": "translated", "value": "cmux rozpocznie nowe logowanie urządzenia Codex w widocznym lokalnym terminalu dla tej maszyny wirtualnej. Poświadczenia odświeżania Codex nigdy nie są kopiowane między maszynami wirtualnymi; Codex wymaga osobnego logowania na każdej z nich."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O cmux iniciará um novo login de dispositivo do Codex em um terminal local visível para esta VM. As credenciais de renovação do Codex nunca são copiadas entre VMs; o Codex exige um login separado para cada VM."}},
        "ru": {"stringUnit": {"state": "translated", "value": "cmux начнёт новый вход в Codex через устройство в видимом локальном терминале для этой виртуальной машины. Учётные данные обновления Codex никогда не копируются между виртуальными машинами; для каждой машины нужен отдельный вход в Codex."}},
        "th": {"stringUnit": {"state": "translated", "value": "cmux จะเริ่มการเข้าสู่ระบบด้วยอุปกรณ์ Codex ใหม่ในเทอร์มินัลภายในเครื่องที่มองเห็นได้สำหรับ VM นี้ ข้อมูลรับรองการรีเฟรชของ Codex จะไม่ถูกคัดลอกระหว่าง VM โดย Codex ต้องเข้าสู่ระบบแยกกันสำหรับแต่ละ VM"}},
        "tr": {"stringUnit": {"state": "translated", "value": "cmux, bu sanal makine için görünür bir yerel terminalde yeni bir Codex cihaz oturumu başlatacak. Codex yenileme kimlik bilgileri sanal makineler arasında asla kopyalanmaz; Codex her sanal makine için ayrı oturum açılmasını gerektirir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "cmux розпочне новий вхід у Codex через пристрій у видимому локальному терміналі для цієї віртуальної машини. Облікові дані оновлення Codex ніколи не копіюються між віртуальними машинами; для кожної машини потрібен окремий вхід у Codex."}},
        "vi": {"stringUnit": {"state": "translated", "value": "cmux sẽ bắt đầu phiên đăng nhập thiết bị Codex mới trong cửa sổ dòng lệnh cục bộ hiển thị cho máy ảo này. Thông tin xác thực làm mới Codex không bao giờ được sao chép giữa các máy ảo; Codex yêu cầu đăng nhập riêng cho từng máy ảo."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "cmux 将在可见的本地终端中为此虚拟机启动新的 Codex 设备登录。Codex 刷新凭据绝不会在虚拟机之间复制；每台虚拟机都需要单独登录 Codex。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "cmux 將在可見的本機終端機中為此虛擬機器啟動新的 Codex 裝置登入。Codex 重新整理憑證絕不會在虛擬機器之間複製；每台虛擬機器都需要個別登入 Codex。"}}
      }
    },
    "cloud.credentialRecovery.title": {
      "comment": "Confirmation title: first %@ is the provider name, second %@ is the machine name. Reordering translations use positional placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Set up %@ on %@?"}},
        "ar": {"stringUnit": {"state": "translated", "value": "هل تريد إعداد %@ على %@؟"}},
        "bs": {"stringUnit": {"state": "translated", "value": "Postaviti %@ na %@?"}},
        "da": {"stringUnit": {"state": "translated", "value": "Konfigurer %@ på %@?"}},
        "de": {"stringUnit": {"state": "translated", "value": "%@ auf %@ einrichten?"}},
        "es": {"stringUnit": {"state": "translated", "value": "¿Configurar %@ en %@?"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Configurer %@ sur %@ ?"}},
        "it": {"stringUnit": {"state": "translated", "value": "Configurare %@ su %@?"}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ を %@ に設定しますか？"}},
        "km": {"stringUnit": {"state": "translated", "value": "ដំឡើង %@ នៅលើ %@?"}},
        "ko": {"stringUnit": {"state": "translated", "value": "%@을(를) %@에 설정할까요?"}},
        "nb": {"stringUnit": {"state": "translated", "value": "Konfigurer %@ på %@?"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Skonfigurować %@ na %@?"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Configurar %@ em %@?"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Настроить %@ на %@?"}},
        "th": {"stringUnit": {"state": "translated", "value": "ตั้งค่า %@ บน %@ หรือไม่?"}},
        "tr": {"stringUnit": {"state": "translated", "value": "%@, %@ üzerinde kurulsun mu?"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Налаштувати %@ на %@?"}},
        "vi": {"stringUnit": {"state": "translated", "value": "Thiết lập %@ trên %@?"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在 %2$@ 上设置 %1$@？"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在 %2$@ 上設定 %1$@？"}}
      }
    },
    "cloud.credentialRecovery.restartDisclosure": {
      "comment": "Confirmation of replacing credentials and restarting this chat; %@ is the provider name.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This replaces %@'s login on this VM and restarts this chat before retrying its failed prompt."}},
        "ar": {"stringUnit": {"state": "translated", "value": "سيستبدل هذا تسجيل دخول %@ على هذه الآلة الافتراضية ويعيد تشغيل هذه المحادثة قبل إعادة محاولة الطلب الذي فشل."}},
        "bs": {"stringUnit": {"state": "translated", "value": "Ovo zamjenjuje prijavu za %@ na ovoj virtuelnoj mašini i ponovo pokreće ovaj razgovor prije ponovnog pokušaja neuspjelog upita."}},
        "da": {"stringUnit": {"state": "translated", "value": "Dette erstatter login til %@ på denne VM og genstarter denne chat, før den mislykkede prompt forsøges igen."}},
        "de": {"stringUnit": {"state": "translated", "value": "Dadurch wird die Anmeldung für %@ auf dieser VM ersetzt und dieser Chat neu gestartet, bevor die fehlgeschlagene Anfrage erneut versucht wird."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esto sustituye el inicio de sesión de %@ en esta máquina virtual y reinicia este chat antes de reintentar la solicitud fallida."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cela remplace la connexion de %@ sur cette VM et redémarre cette conversation avant de réessayer la requête qui a échoué."}},
        "it": {"stringUnit": {"state": "translated", "value": "Questa operazione sostituisce l’accesso di %@ su questa VM e riavvia questa chat prima di riprovare la richiesta non riuscita."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この VM の %@ のログイン情報を置き換え、このチャットを再起動してから失敗したプロンプトを再試行します。"}},
        "km": {"stringUnit": {"state": "translated", "value": "វានឹងជំនួសព័ត៌មានចូលរបស់ %@ នៅលើ VM នេះ ហើយចាប់ផ្តើមការជជែកនេះឡើងវិញ មុនពេលសាកល្បងសំណើដែលបរាជ័យម្តងទៀត។"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 VM에서 %@의 로그인 정보를 교체하고 이 채팅을 다시 시작한 후 실패한 프롬프트를 다시 시도합니다."}},
        "nb": {"stringUnit": {"state": "translated", "value": "Dette erstatter påloggingen til %@ på denne VM-en og starter denne samtalen på nytt før den mislykkede forespørselen forsøkes igjen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ta operacja zastąpi dane logowania %@ na tej maszynie wirtualnej i uruchomi czat ponownie przed ponowieniem nieudanej prośby."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Isso substitui o login de %@ nesta VM e reinicia este chat antes de tentar novamente a solicitação que falhou."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Это заменит данные входа %@ на этой виртуальной машине и перезапустит чат перед повторной отправкой неудавшегося запроса."}},
        "th": {"stringUnit": {"state": "translated", "value": "การดำเนินการนี้จะแทนที่ข้อมูลเข้าสู่ระบบของ %@ บน VM นี้และเริ่มแชทนี้ใหม่ก่อนลองส่งพรอมต์ที่ล้มเหลวอีกครั้ง"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Bu işlem, bu sanal makinedeki %@ oturum açma bilgilerini değiştirir ve başarısız istem yeniden denenmeden önce bu sohbeti yeniden başlatır."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Це замінить дані входу %@ на цій віртуальній машині й перезапустить чат перед повторним надсиланням невдалого запиту."}},
        "vi": {"stringUnit": {"state": "translated", "value": "Thao tác này thay thế thông tin đăng nhập của %@ trên máy ảo này và khởi động lại cuộc trò chuyện trước khi thử lại yêu cầu bị lỗi."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这将替换此虚拟机上 %@ 的登录凭据，并在重试失败的提示之前重启此聊天。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這將取代此虛擬機器上 %@ 的登入憑證，並在重試失敗的提示之前重新啟動此聊天。"}}
      }
    },
    "cloud.credentialRecovery.cancel": {
