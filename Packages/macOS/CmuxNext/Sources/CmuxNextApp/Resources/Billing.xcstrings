        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accedi prima a cmux nell’app cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に cmux アプリで cmux にサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សូមចូលគណនី cmux ក្នុងកម្មវិធី cmux ជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 cmux 앱에서 cmux에 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logg inn på cmux i cmux-appen først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw zaloguj się do cmux w aplikacji cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Primeiro entre no cmux pelo app cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала войдите в cmux в приложении cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลงชื่อเข้าใช้ cmux ในแอป cmux ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce cmux uygulamasında cmux’a giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спершу увійдіть у cmux у застосунку cmux."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy đăng nhập cmux trong ứng dụng cmux trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先在 cmux 应用中登录 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先在 cmux App 中登入 cmux。"
          }
        }
      }
