{
  "sourceLanguage": "en",
  "strings": {
    "billing.error.liveOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live checkout from cmux-next is not on yet. Open https://cmux.com/pricing to buy a plan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الشراء المباشر من cmux-next غير مفعّل بعد. افتح https://cmux.com/pricing لشراء خطة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kupovina uživo iz cmux-next još nije uključena. Otvorite https://cmux.com/pricing da kupite plan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live-køb fra cmux-next er ikke slået til endnu. Åbn https://cmux.com/pricing for at købe en plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live-Checkout aus cmux-next ist noch nicht aktiv. Öffne https://cmux.com/pricing, um einen Plan zu kaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El pago real desde cmux-next aún no está activado. Abre https://cmux.com/pricing para comprar un plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le paiement réel depuis cmux-next n’est pas encore activé. Ouvrez https://cmux.com/pricing pour acheter une offre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il checkout reale da cmux-next non è ancora attivo. Apri https://cmux.com/pricing per acquistare un piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next からの本番の購入はまだ有効ではありません。プランの購入は https://cmux.com/pricing から行ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការទិញពិតពី cmux-next មិនទាន់បើកនៅឡើយទេ។ បើក https://cmux.com/pricing ដើម្បីទិញគម្រោង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-next의 실제 결제는 아직 켜져 있지 않습니다. 플랜을 구매하려면 https://cmux.com/pricing 을 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekte kjøp fra cmux-next er ikke slått på ennå. Åpne https://cmux.com/pricing for å kjøpe en plan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prawdziwy zakup z cmux-next nie jest jeszcze włączony. Otwórz https://cmux.com/pricing, aby kupić plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O checkout real pelo cmux-next ainda não está ativado. Abra https://cmux.com/pricing para comprar um plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Реальная оплата из cmux-next пока не включена. Откройте https://cmux.com/pricing, чтобы купить план."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การชำระเงินจริงจาก cmux-next ยังไม่เปิดใช้งาน เปิด https://cmux.com/pricing เพื่อซื้อแพ็กเกจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-next üzerinden gerçek ödeme henüz açık değil. Bir plan satın almak için https://cmux.com/pricing adresini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Справжня оплата з cmux-next ще не ввімкнена. Відкрийте https://cmux.com/pricing, щоб купити план."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thanh toán thật từ cmux-next chưa được bật. Mở https://cmux.com/pricing để mua gói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-next 尚未开启真实付款。请打开 https://cmux.com/pricing 购买套餐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-next 尚未開啟真實付款。請開啟 https://cmux.com/pricing 購買方案。"
          }
        }
      }
    },
    "billing.error.notSignedIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to cmux in the cmux app first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سجّل الدخول إلى cmux في تطبيق cmux أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo se prijavite u cmux u aplikaciji cmux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Log ind på cmux i cmux-appen først."
          }
        },
        "de": {
