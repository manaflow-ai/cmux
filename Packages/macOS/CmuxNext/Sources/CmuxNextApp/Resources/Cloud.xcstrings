          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud កំពុងលុបម៉ាស៊ីននេះ និងថាសរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 이 머신과 디스크를 삭제하고 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sletter denne maskinen og disken dens."
          }
        },
        "pl": {
          "stringUnit": {
