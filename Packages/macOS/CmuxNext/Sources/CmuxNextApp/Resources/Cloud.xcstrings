            "value": "Se perdió la conexión con %@ durante el traslado. Vuelve a intentarlo para terminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à %@ a été perdue pendant le déplacement. Réessayez pour le terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione a %@ persa durante lo spostamento. Riprova per completarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中に %@ との接続が切れました。再試行して完了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បាត់ការតភ្ជាប់ទៅ %@ ពេលកំពុងផ្លាស់ទី។ ព្យាយាមម្តងទៀតដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 중에 %@과(와)의 연결이 끊어졌습니다. 다시 시도하여 완료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistet tilkoblingen til %@ under flyttingen. Prøv igjen for å fullføre den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utracono połączenie z %@ podczas przenoszenia. Ponów, aby je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com %@ caiu durante a transferência. Tente novamente para concluí-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь с %@ прервалась во время переноса. Повторите, чтобы завершить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกับ %@ ขาดระหว่างการย้าย ลองอีกครั้งเพื่อให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma sırasında %@ bağlantısı koptu. Tamamlamak için yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зв'язок із %@ обірвався під час перенесення. Повторіть, щоб завершити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất kết nối với %@ trong khi chuyển. Hãy thử lại để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动期间与 %@ 的连接中断。请重试以完成移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動期間與 %@ 的連線中斷。請重試以完成移動。"
          }
        }
      }
