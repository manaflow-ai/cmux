          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтвердите эту машину в ленте cmux и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุมัติเครื่องนี้ในฟีด cmux ของคุณ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu makineyi cmux akışınızda onaylayın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Схваліть цю машину у стрічці cmux і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phê duyệt máy này trong nguồn cấp cmux của bạn, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
