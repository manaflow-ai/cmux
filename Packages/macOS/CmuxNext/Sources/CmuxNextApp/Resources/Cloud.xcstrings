    "cloud.machineUpdate.unsupportedKeepsWorking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs a cmux too old to update in place. Its chats and terminals keep working; features newer than its cmux stay off there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل %@ إصدارًا من cmux أقدم من أن يُحدَّث في مكانه. تستمر محادثاته وطرفياته في العمل، وتبقى الميزات الأحدث من إصدار cmux فيه متوقفة هناك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ koristi cmux prestar za ažuriranje na licu mjesta. Njegovi chatovi i terminali i dalje rade; funkcije novije od njegovog cmuxa tamo ostaju isključene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører en cmux, der er for gammel til at blive opdateret på stedet. Dens chats og terminaler bliver ved med at virke; funktioner, der er nyere end dens cmux, forbliver slået fra der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet ein cmux, das zu alt für ein Update vor Ort ist. Chats und Terminals laufen dort weiter; Funktionen, die neuer als dieses cmux sind, bleiben dort aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa un cmux demasiado antiguo para actualizarse en su sitio. Sus chats y terminales siguen funcionando; las funciones más nuevas que su cmux quedan desactivadas allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise un cmux trop ancien pour être mis à jour sur place. Ses discussions et terminaux continuent de fonctionner ; les fonctionnalités plus récentes que son cmux y restent désactivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa un cmux troppo vecchio per essere aggiornato sul posto. Le sue chat e i suoi terminali continuano a funzionare; le funzioni più recenti del suo cmux restano disattivate lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の cmux は古いため、その場で更新できません。チャットとターミナルはそのまま動作します。その cmux より新しい機能はそこではオフのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ដំណើរការ cmux ចាស់ពេកដើម្បីធ្វើបច្ចុប្បន្នភាពនៅនឹងកន្លែង។ ការជជែក និងទែមីណាល់របស់វានៅតែដំណើរការ ហើយមុខងារថ្មីជាង cmux របស់វានៅតែបិទនៅទីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 cmux는 너무 오래되어 그 자리에서 업데이트할 수 없습니다. 채팅과 터미널은 계속 작동하며, 그 cmux보다 새로운 기능은 그곳에서 꺼진 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører en cmux som er for gammel til å oppdateres på stedet. Chattene og terminalene fortsetter å virke; funksjoner som er nyere enn dens cmux, forblir av der."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma cmux zbyt stary, by zaktualizować go na miejscu. Czaty i terminale nadal działają; funkcje nowsze niż ten cmux pozostają tam wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa um cmux antigo demais para ser atualizado no local. Os chats e terminais continuam funcionando; os recursos mais novos que esse cmux ficam desativados lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ работает cmux, слишком старый для обновления на месте. Чаты и терминалы продолжают работать; функции новее этого cmux там остаются выключенными."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ cmux ที่เก่าเกินกว่าจะอัปเดตในที่ได้ แชทและเทอร์มินัลยังทำงานต่อได้ ส่วนฟีเจอร์ที่ใหม่กว่า cmux ของเครื่องนั้นจะยังปิดอยู่ที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yerinde güncellenemeyecek kadar eski bir cmux çalıştırıyor. Sohbetleri ve terminalleri çalışmaya devam eder; cmux sürümünden yeni özellikler orada kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ працює cmux, надто старий для оновлення на місці. Чати й термінали працюють далі; функції, новіші за цей cmux, там залишаються вимкненими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chạy cmux quá cũ để cập nhật tại chỗ. Các cuộc trò chuyện và terminal vẫn hoạt động; những tính năng mới hơn cmux của máy đó vẫn tắt ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 运行的 cmux 太旧，无法就地更新。它的聊天和终端仍可正常使用；比其 cmux 更新的功能在那里保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 執行的 cmux 太舊，無法就地更新。它的聊天和終端機仍可正常使用；比其 cmux 更新的功能在那裡保持關閉。"
          }
        }
      }
    },
    "cloud.cli.machineConfigUnreadable": {
      "comment": "cmux cloud new-machine / apply-machine-config: the --machine-config file can't be used. %@ is its path.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't use the machine config %@: it must be a readable file of at most 64 KB."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン構成 %@ を使用できません。64 KB 以下の読み取り可能なファイルである必要があります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Maschinenkonfiguration %@ kann nicht verwendet werden: Sie muss eine lesbare Datei von höchstens 64 KB sein."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d’utiliser la configuration de machine %@ : il doit s’agir d’un fichier lisible de 64 Ko au plus."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede usar la configuración de máquina %@: debe ser un archivo legible de 64 KB como máximo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر استخدام إعداد الجهاز %@: يجب أن يكون ملفًا قابلًا للقراءة لا يزيد حجمه على 64 كيلوبايت."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 구성 %@을(를) 사용할 수 없습니다. 64KB 이하의 읽을 수 있는 파일이어야 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法使用机器配置 %@：它必须是不超过 64 KB 的可读文件。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法使用機器設定 %@：它必須是不超過 64 KB 的可讀檔案。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Konfiguracija mašine %@ se ne može koristiti: mora biti čitljiva datoteka od najviše 64 KB."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinkonfigurationen %@ kan ikke bruges: den skal være en læsbar fil på højst 64 KB."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile usare la configurazione della macchina %@: deve essere un file leggibile di al massimo 64 KB."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចប្រើការកំណត់រចនាសម្ព័ន្ធម៉ាស៊ីន %@ បានទេ៖ វាត្រូវតែជាឯកសារដែលអាចអានបាន ទំហំមិនលើស 64 KB។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke bruke maskinkonfigurasjonen %@: den må være en lesbar fil på høyst 64 KB."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można użyć konfiguracji maszyny %@: musi to być czytelny plik o rozmiarze co najwyżej 64 KB."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível usar a configuração da máquina %@: ela deve ser um arquivo legível de no máximo 64 KB."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удаётся использовать конфигурацию машины %@: это должен быть читаемый файл размером не более 64 КБ."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ใช้การกำหนดค่าเครื่อง %@ ไม่ได้: ต้องเป็นไฟล์ที่อ่านได้ ขนาดไม่เกิน 64 KB"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ makine yapılandırması kullanılamıyor: en fazla 64 KB boyutunda okunabilir bir dosya olmalıdır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдається використати конфігурацію машини %@: це має бути файл для читання розміром не більше 64 КБ."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể dùng cấu hình máy %@: tệp phải đọc được và không quá 64 KB."}}
      }
    },
    "cloud.cli.secretUnreadable": {
      "comment": "cmux cloud deliver-secrets: the Keychain did not give a stored secret's value. %@ is the secret's name. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't read the secret %@ from this Mac's Keychain. Unlock it, or store it again with cmux cloud secret set."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Mac のキーチェーンからシークレット %@ を読み取れません。キーチェーンのロックを解除するか、cmux cloud secret set でもう一度保存してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das Geheimnis %@ kann nicht aus dem Schlüsselbund dieses Mac gelesen werden. Entsperre ihn oder speichere es mit cmux cloud secret set erneut."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de lire le secret %@ dans le trousseau de ce Mac. Déverrouillez-le, ou enregistrez-le à nouveau avec cmux cloud secret set."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede leer el secreto %@ del llavero de este Mac. Desbloquéalo o guárdalo de nuevo con cmux cloud secret set."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّرت قراءة السر %@ من سلسلة مفاتيح جهاز Mac هذا. افتح قفلها، أو خزّنه مرة أخرى باستخدام cmux cloud secret set."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac의 키체인에서 비밀 %@을(를) 읽을 수 없습니다. 키체인 잠금을 해제하거나 cmux cloud secret set으로 다시 저장하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法从这台 Mac 的钥匙串读取机密 %@。请解锁钥匙串，或用 cmux cloud secret set 重新保存。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法從這台 Mac 的鑰匙圈讀取機密 %@。請解鎖鑰匙圈，或用 cmux cloud secret set 重新儲存。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Tajna %@ se ne može pročitati iz privjeska ključeva ovog Maca. Otključajte ga ili je ponovo sačuvajte pomoću cmux cloud secret set."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Hemmeligheden %@ kan ikke læses fra denne Macs nøglering. Lås den op, eller gem den igen med cmux cloud secret set."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile leggere il segreto %@ dal portachiavi di questo Mac. Sbloccalo o salvalo di nuovo con cmux cloud secret set."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចអានអាថ៌កំបាំង %@ ពី Keychain របស់ Mac នេះបានទេ។ ដោះសោវា ឬរក្សាទុកវាម្ដងទៀតដោយ cmux cloud secret set។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke lese hemmeligheten %@ fra nøkkelringen på denne Macen. Lås den opp, eller lagre den på nytt med cmux cloud secret set."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można odczytać sekretu %@ z pęku kluczy tego Maca. Odblokuj go albo zapisz sekret ponownie poleceniem cmux cloud secret set."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível ler o segredo %@ das Chaves deste Mac. Desbloqueie-as ou armazene-o de novo com cmux cloud secret set."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удаётся прочитать секрет %@ из связки ключей этого Mac. Разблокируйте её или сохраните секрет снова командой cmux cloud secret set."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "อ่านความลับ %@ จากพวงกุญแจของ Mac เครื่องนี้ไม่ได้ ปลดล็อกพวงกุญแจ หรือจัดเก็บใหม่ด้วย cmux cloud secret set"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ sırrı bu Mac'in anahtar zincirinden okunamıyor. Kilidini açın veya cmux cloud secret set ile yeniden saklayın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдається прочитати секрет %@ зі зв'язки ключів цього Mac. Розблокуйте її або збережіть секрет знову командою cmux cloud secret set."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể đọc bí mật %@ từ Chuỗi khóa của máy Mac này. Hãy mở khóa, hoặc lưu lại bằng cmux cloud secret set."}}
      }
    },
