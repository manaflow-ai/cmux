    "cloud.progress.next.pausing": {
      "comment": "The progress card's line under a Cloud machine that cmux Cloud is pausing. Resume is the Resume Machine action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud is pausing this machine. Its disk and session are kept. Resume works once it is paused."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم cmux Cloud بإيقاف هذا الجهاز مؤقتًا. يتم الاحتفاظ بقرصه وجلسته. يعمل الاستئناف بعد إيقافه مؤقتًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud pauzira ovu mašinu. Njen disk i sesija su sačuvani. Nastavi radi kada bude pauzirana."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sætter denne maskine på pause. Dens disk og session bevares. Genoptag virker, når den er sat på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud pausiert diese Maschine. Ihre Festplatte und Sitzung bleiben erhalten. „Fortsetzen“ geht, sobald sie pausiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud está pausando esta máquina. Se conservan su disco y su sesión. Reanudar funciona cuando esté en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud met cette machine en pause. Son disque et sa session sont conservés. Reprendre fonctionne une fois qu'elle est en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sta mettendo in pausa questa macchina. Il disco e la sessione sono conservati. Riprendi funziona quando è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud がこのマシンを一時停止しています。ディスクとセッションは保持されます。一時停止が完了すると「再開」できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud កំពុងផ្អាកម៉ាស៊ីននេះ។ ថាស និងវគ្គរបស់វាត្រូវបានរក្សាទុក។ បន្ត អាចប្រើបាននៅពេលវាផ្អាករួច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 이 머신을 일시 정지하고 있습니다. 디스크와 세션은 유지됩니다. 일시 정지되면 재개할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud setter denne maskinen på pause. Disken og økten beholdes. Gjenoppta virker når den er satt på pause."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud wstrzymuje tę maszynę. Jej dysk i sesja są zachowane. Wznów zadziała, gdy będzie wstrzymana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux Cloud está pausando esta máquina. O disco e a sessão dela são mantidos. Retomar funciona quando ela estiver pausada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud приостанавливает эту машину. Её диск и сеанс сохранены. «Возобновить» сработает, когда она будет приостановлена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud กำลังหยุดเครื่องนี้ชั่วคราว ดิสก์และเซสชันของเครื่องยังคงอยู่ ดำเนินการต่อได้เมื่อหยุดชั่วคราวแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud bu makineyi duraklatıyor. Diski ve oturumu korunur. Sürdür, makine duraklatıldığında çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud призупиняє цю машину. Її диск і сеанс збережено. «Відновити» спрацює, коли її буде призупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud đang tạm dừng máy này. Ổ đĩa và phiên của máy được giữ lại. Có thể Tiếp tục khi máy đã tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在暂停该机器。它的磁盘和会话均会保留。暂停完成后即可“恢复”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在暫停此機器。它的磁碟和工作階段均會保留。暫停完成後即可「繼續」。"
          }
        }
      }
    },
