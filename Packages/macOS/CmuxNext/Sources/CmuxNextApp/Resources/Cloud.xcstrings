    "cloud.error.unreadable": {
      "comment": "cmux Cloud answered with something this cmux build cannot parse.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sent an answer this version of cmux can't read. Update cmux, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل cmux Cloud ردًا لا يستطيع هذا الإصدار من cmux قراءته. حدّث cmux، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud je poslao odgovor koji ova verzija cmuxa ne može pročitati. Ažurirajte cmux, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sendte et svar, som denne version af cmux ikke kan læse. Opdater cmux, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud hat eine Antwort gesendet, die diese cmux-Version nicht lesen kann. Aktualisiere cmux und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud envió una respuesta que esta versión de cmux no puede leer. Actualiza cmux e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud a envoyé une réponse que cette version de cmux ne sait pas lire. Mettez cmux à jour, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ha inviato una risposta che questa versione di cmux non sa leggere. Aggiorna cmux, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud から、このバージョンの cmux では読み取れない応答が届きました。cmux をアップデートしてから、もう一度試してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud បានផ្ញើចម្លើយដែលកំណែ cmux នេះមិនអាចអានបាន។ ធ្វើបច្ចុប្បន្នភាព cmux រួចសាកម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 이 버전의 cmux에서 읽을 수 없는 응답을 보냈습니다. cmux를 업데이트한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sendte et svar denne versjonen av cmux ikke kan lese. Oppdater cmux, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud wysłał odpowiedź, której ta wersja cmux nie potrafi odczytać. Zaktualizuj cmux i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux Cloud enviou uma resposta que esta versão do cmux não consegue ler. Atualize o cmux e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud прислал ответ, который эта версия cmux не может прочитать. Обновите cmux и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ส่งคำตอบที่ cmux เวอร์ชันนี้อ่านไม่ได้ อัปเดต cmux แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud, cmux'ın bu sürümünün okuyamadığı bir yanıt gönderdi. cmux'ı güncelleyin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud надіслав відповідь, яку ця версія cmux не може прочитати. Оновіть cmux і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud đã gửi một phản hồi mà phiên bản cmux này không đọc được. Hãy cập nhật cmux rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 发来的响应此版本的 cmux 无法读取。请更新 cmux，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 傳來的回應此版本的 cmux 無法讀取。請更新 cmux，然後再試一次。"
          }
        }
      }
    },
    "cloud.machineUpdate.unsupportedKeepsWorking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs a cmux too old to update in place. Its chats and terminals keep working; features newer than its cmux stay off there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل %@ إصدارًا من cmux أقدم من أن يُحدَّث في مكانه. تستمر محادثاته وطرفياته في العمل، وتبقى الميزات الأحدث من إصدار cmux فيه متوقفة هناك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ koristi cmux prestar za ažuriranje na licu mjesta. Njegovi chatovi i terminali i dalje rade; funkcije novije od njegovog cmuxa tamo ostaju isključene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører en cmux, der er for gammel til at blive opdateret på stedet. Dens chats og terminaler bliver ved med at virke; funktioner, der er nyere end dens cmux, forbliver slået fra der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet ein cmux, das zu alt für ein Update vor Ort ist. Chats und Terminals laufen dort weiter; Funktionen, die neuer als dieses cmux sind, bleiben dort aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa un cmux demasiado antiguo para actualizarse en su sitio. Sus chats y terminales siguen funcionando; las funciones más nuevas que su cmux quedan desactivadas allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise un cmux trop ancien pour être mis à jour sur place. Ses discussions et terminaux continuent de fonctionner ; les fonctionnalités plus récentes que son cmux y restent désactivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa un cmux troppo vecchio per essere aggiornato sul posto. Le sue chat e i suoi terminali continuano a funzionare; le funzioni più recenti del suo cmux restano disattivate lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の cmux は古いため、その場で更新できません。チャットとターミナルはそのまま動作します。その cmux より新しい機能はそこではオフのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ដំណើរការ cmux ចាស់ពេកដើម្បីធ្វើបច្ចុប្បន្នភាពនៅនឹងកន្លែង។ ការជជែក និងទែមីណាល់របស់វានៅតែដំណើរការ ហើយមុខងារថ្មីជាង cmux របស់វានៅតែបិទនៅទីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 cmux는 너무 오래되어 그 자리에서 업데이트할 수 없습니다. 채팅과 터미널은 계속 작동하며, 그 cmux보다 새로운 기능은 그곳에서 꺼진 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører en cmux som er for gammel til å oppdateres på stedet. Chattene og terminalene fortsetter å virke; funksjoner som er nyere enn dens cmux, forblir av der."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma cmux zbyt stary, by zaktualizować go na miejscu. Czaty i terminale nadal działają; funkcje nowsze niż ten cmux pozostają tam wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa um cmux antigo demais para ser atualizado no local. Os chats e terminais continuam funcionando; os recursos mais novos que esse cmux ficam desativados lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ работает cmux, слишком старый для обновления на месте. Чаты и терминалы продолжают работать; функции новее этого cmux там остаются выключенными."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ cmux ที่เก่าเกินกว่าจะอัปเดตในที่ได้ แชทและเทอร์มินัลยังทำงานต่อได้ ส่วนฟีเจอร์ที่ใหม่กว่า cmux ของเครื่องนั้นจะยังปิดอยู่ที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yerinde güncellenemeyecek kadar eski bir cmux çalıştırıyor. Sohbetleri ve terminalleri çalışmaya devam eder; cmux sürümünden yeni özellikler orada kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ працює cmux, надто старий для оновлення на місці. Чати й термінали працюють далі; функції, новіші за цей cmux, там залишаються вимкненими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chạy cmux quá cũ để cập nhật tại chỗ. Các cuộc trò chuyện và terminal vẫn hoạt động; những tính năng mới hơn cmux của máy đó vẫn tắt ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 运行的 cmux 太旧，无法就地更新。它的聊天和终端仍可正常使用；比其 cmux 更新的功能在那里保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 執行的 cmux 太舊，無法就地更新。它的聊天和終端機仍可正常使用；比其 cmux 更新的功能在那裡保持關閉。"
          }
        }
      }
    },
    "cloud.bootstrap.needsGitHub": {
      "comment": "New Cloud Workspace from a repository: the machine's clone needs GitHub access it does not have. %@ is OWNER/NAME.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This machine has no GitHub access to %@, so it couldn't clone it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンには %@ への GitHub アクセスがないため、クローンできませんでした。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Maschine hat keinen GitHub-Zugriff auf %@ und konnte es daher nicht klonen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette machine n'a pas accès à %@ sur GitHub ; elle n'a donc pas pu le cloner."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Esta máquina no tiene acceso de GitHub a %@, así que no pudo clonarlo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يملك هذا الجهاز وصولًا إلى ‎%@ على GitHub، لذا تعذّر استنساخه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신에는 %@에 대한 GitHub 접근 권한이 없어 복제하지 못했습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台机器没有 %@ 的 GitHub 访问权限，因此无法克隆它。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台機器沒有 %@ 的 GitHub 存取權限，因此無法複製它。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ova mašina nema GitHub pristup za %@, pa ga nije mogla klonirati."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne maskine har ingen GitHub-adgang til %@, så den kunne ikke klone det."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa macchina non ha accesso GitHub a %@, quindi non è riuscita a clonarlo."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីននេះគ្មានសិទ្ធិចូល GitHub ទៅ %@ ទេ ដូច្នេះវាមិនអាច clone បានទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne maskinen har ikke GitHub-tilgang til %@, så den kunne ikke klone det."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ta maszyna nie ma dostępu GitHub do %@, więc nie mogła go sklonować."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Esta máquina não tem acesso do GitHub a %@, então não conseguiu cloná-lo."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "У этой машины нет доступа к %@ на GitHub, поэтому клонировать его не удалось."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่องนี้ไม่มีสิทธิ์เข้าถึง %@ บน GitHub จึงโคลนไม่ได้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makinenin %@ için GitHub erişimi yok, bu yüzden onu klonlayamadı."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ця машина не має доступу до %@ на GitHub, тому не змогла його клонувати."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy này không có quyền truy cập GitHub vào %@ nên không thể sao chép nó."}}
      }
    },
    "cloud.bootstrap.repoFailed": {
      "comment": "New Cloud Workspace from a repository: the clone or update failed. %1$@ is OWNER/NAME, %2$@ the log's path on the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't clone or update %1$@ on the machine. See the log at %2$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン上で %1$@ をクローンまたは更新できませんでした。ログは %2$@ にあります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%1$@ konnte auf der Maschine nicht geklont oder aktualisiert werden. Siehe das Protokoll unter %2$@."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de cloner ou de mettre à jour %1$@ sur la machine. Consultez le journal dans %2$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se pudo clonar ni actualizar %1$@ en la máquina. Consulta el registro en %2$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر استنساخ ‎%1$@ أو تحديثه على الجهاز. راجع السجل في ‎%2$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신에서 %1$@을(를) 복제하거나 업데이트하지 못했습니다. 로그는 %2$@에 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法在机器上克隆或更新 %1$@。请查看 %2$@ 中的日志。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法在機器上複製或更新 %1$@。請查看 %2$@ 中的記錄。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće klonirati ili ažurirati %1$@ na mašini. Pogledajte log u %2$@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke klone eller opdatere %1$@ på maskinen. Se loggen i %2$@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile clonare o aggiornare %1$@ sulla macchina. Vedi il log in %2$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាច clone ឬធ្វើបច្ចុប្បន្នភាព %1$@ នៅលើម៉ាស៊ីនបានទេ។ មើលកំណត់ហេតុនៅ %2$@។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kunne ikke klone eller oppdatere %1$@ på maskinen. Se loggen i %2$@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie udało się sklonować ani zaktualizować %1$@ na maszynie. Zobacz dziennik w %2$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não foi possível clonar ou atualizar %1$@ na máquina. Veja o log em %2$@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удалось клонировать или обновить %1$@ на машине. Журнал: %2$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "โคลนหรืออัปเดต %1$@ บนเครื่องไม่ได้ ดูบันทึกที่ %2$@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%1$@ makinede klonlanamadı veya güncellenemedi. Günlüğe bakın: %2$@."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдалося клонувати чи оновити %1$@ на машині. Журнал: %2$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể sao chép hoặc cập nhật %1$@ trên máy. Xem nhật ký tại %2$@."}}
      }
    },
    "cloud.bootstrap.scriptFailed": {
      "comment": "A new Cloud machine's setup script failed. %1$ld is its exit code, %2$@ the log's path on the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The setup script failed with exit code %1$ld. See the log at %2$@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セットアップスクリプトが終了コード %1$ld で失敗しました。ログは %2$@ にあります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das Einrichtungsskript ist mit Exit-Code %1$ld fehlgeschlagen. Siehe das Protokoll unter %2$@."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le script de configuration a échoué avec le code de sortie %1$ld. Consultez le journal dans %2$@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El script de configuración falló con el código de salida %1$ld. Consulta el registro en %2$@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "فشل نص الإعداد البرمجي برمز الخروج %1$ld. راجع السجل في ‎%2$@."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "설정 스크립트가 종료 코드 %1$ld(으)로 실패했습니다. 로그는 %2$@에 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "设置脚本失败，退出代码为 %1$ld。请查看 %2$@ 中的日志。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "設定指令碼失敗，結束代碼為 %1$ld。請查看 %2$@ 中的記錄。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Skripta za postavljanje nije uspjela, izlazni kod %1$ld. Pogledajte log u %2$@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Opsætningsscriptet mislykkedes med afslutningskode %1$ld. Se loggen i %2$@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Lo script di configurazione è fallito con codice di uscita %1$ld. Vedi il log in %2$@."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ស្គ្រីបរៀបចំបានបរាជ័យដោយលេខកូដចេញ %1$ld។ មើលកំណត់ហេតុនៅ %2$@។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Oppsettskriptet mislyktes med avslutningskode %1$ld. Se loggen i %2$@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Skrypt konfiguracji zakończył się błędem, kod wyjścia %1$ld. Zobacz dziennik w %2$@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O script de configuração falhou com o código de saída %1$ld. Veja o log em %2$@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Скрипт настройки завершился с ошибкой, код выхода %1$ld. Журнал: %2$@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "สคริปต์ตั้งค่าล้มเหลวด้วยรหัสออก %1$ld ดูบันทึกที่ %2$@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kurulum betiği %1$ld çıkış koduyla başarısız oldu. Günlüğe bakın: %2$@."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Скрипт налаштування завершився з помилкою, код виходу %1$ld. Журнал: %2$@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tập lệnh thiết lập thất bại với mã thoát %1$ld. Xem nhật ký tại %2$@."}}
      }
    },
    "cloud.bootstrap.runnerNeverCame": {
      "comment": "A new Cloud machine's setup was started but never began running on the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The setup never started on the machine. Try again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セットアップがマシン上で開始されませんでした。もう一度お試しください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Einrichtung wurde auf der Maschine nie gestartet. Versuche es erneut."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La configuration n'a jamais démarré sur la machine. Réessayez."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La configuración nunca se inició en la máquina. Inténtalo de nuevo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يبدأ الإعداد على الجهاز مطلقًا. حاول مرة أخرى."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신에서 설정이 시작되지 않았습니다. 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "设置从未在机器上启动。请重试。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "設定從未在機器上啟動。請再試一次。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Postavljanje nikad nije pokrenuto na mašini. Pokušajte ponovo."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Opsætningen startede aldrig på maskinen. Prøv igen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La configurazione non è mai partita sulla macchina. Riprova."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការរៀបចំមិនដែលចាប់ផ្តើមនៅលើម៉ាស៊ីនទេ។ សូមព្យាយាមម្តងទៀត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Oppsettet startet aldri på maskinen. Prøv igjen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Konfiguracja nigdy nie uruchomiła się na maszynie. Spróbuj ponownie."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A configuração nunca começou na máquina. Tente novamente."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Настройка так и не запустилась на машине. Попробуйте ещё раз."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การตั้งค่าไม่ได้เริ่มบนเครื่องเลย ลองอีกครั้ง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kurulum makinede hiç başlamadı. Yeniden deneyin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Налаштування так і не запустилося на машині. Спробуйте ще раз."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Quá trình thiết lập chưa từng bắt đầu trên máy. Hãy thử lại."}}
      }
    },
    "cloud.bootstrap.stopped": {
      "comment": "A new Cloud machine's setup ended without finishing (killed, or the machine restarted). %@ is the log's path on the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The setup stopped on the machine before it finished. See the log at %@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セットアップが完了前にマシン上で停止しました。ログは %@ にあります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Einrichtung wurde auf der Maschine vor dem Abschluss beendet. Siehe das Protokoll unter %@."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "La configuration s'est arrêtée sur la machine avant la fin. Consultez le journal dans %@."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "La configuración se detuvo en la máquina antes de terminar. Consulta el registro en %@."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "توقف الإعداد على الجهاز قبل أن ينتهي. راجع السجل في ‎%@."}},
