    "cloud.moveAsk.ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent asks to move this chat to Cloud, copying %@ to a Cloud machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب الوكيل نقل هذه المحادثة إلى Cloud، مع نسخ %@ إلى جهاز Cloud."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent traži da se ovaj razgovor premjesti u Cloud i da se %@ kopira na Cloud mašinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten beder om at flytte denne chat til Cloud og kopiere %@ til en Cloud-maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent möchte diesen Chat in die Cloud verschieben und %@ auf eine Cloud-Maschine kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente pide mover este chat a Cloud y copiar %@ a una máquina de Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent demande à déplacer ce chat vers Cloud en copiant %@ sur une machine Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente chiede di spostare questa chat su Cloud, copiando %@ su una macchina Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがこのチャットを Cloud に移動し、%@ を Cloud マシンにコピーするよう求めています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារសុំផ្លាស់ទីការជជែកនេះទៅ Cloud ដោយចម្លង %@ ទៅម៉ាស៊ីន Cloud។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 이 채팅을 Cloud로 옮기고 %@을(를) Cloud 머신에 복사하려고 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten ber om å flytte denne chatten til Cloud og kopiere %@ til en Cloud-maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent prosi o przeniesienie tego czatu do Cloud i skopiowanie %@ na maszynę Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente pede para mover este chat para o Cloud, copiando %@ para uma máquina do Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент просит перенести этот чат в Cloud и скопировать %@ на машину Cloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ขอย้ายแชทนี้ไปที่ Cloud โดยคัดลอก %@ ไปยังเครื่อง Cloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan bu sohbeti Cloud'a taşımak ve %@ klasörünü bir Cloud makinesine kopyalamak istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент просить перенести цей чат у Cloud і скопіювати %@ на машину Cloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử muốn chuyển cuộc trò chuyện này lên Cloud và sao chép %@ sang một máy Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体请求将此对话移到 Cloud，并将 %@ 复制到一台 Cloud 机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式請求將此對話移到 Cloud，並將 %@ 複製到一台 Cloud 機器。"
          }
        }
      }
    },
