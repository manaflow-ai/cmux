        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się skopiować folderu z powrotem z %1$@: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível copiar a pasta de volta de %1$@: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скопировать папку обратно с %1$@: %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกโฟลเดอร์กลับจาก %1$@ ไม่ได้: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör %1$@ makinesinden geri kopyalanamadı: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скопіювати теку назад з %1$@: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sao chép thư mục về từ %1$@: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 %1$@ 将文件夹复制回来：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從 %1$@ 將資料夾複製回來：%2$@"
          }
        }
      }
    },
    "cloud.bringBack.outdatedMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs an older cmux that can't give this chat back yet. Update the machine to bring it back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل %@ إصدارًا أقدم من cmux لا يمكنه إعادة هذه المحادثة بعد. حدّث الجهاز لإعادتها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ koristi stariji cmux koji još ne može vratiti ovaj chat. Ažuriraj mašinu da ga vratiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører en ældre cmux, der endnu ikke kan sende denne chat tilbage. Opdater maskinen for at hente den tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ läuft ein älteres cmux, das diesen Chat noch nicht zurückgeben kann. Aktualisiere die Maschine, um ihn zurückzuholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ejecuta una versión anterior de cmux que aún no puede devolver este chat. Actualiza la máquina para traerlo de vuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exécute une ancienne version de cmux qui ne peut pas encore rendre cette discussion. Mettez la machine à jour pour la récupérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esegue una versione precedente di cmux che non può ancora restituire questa chat. Aggiorna la macchina per riportarla indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の cmux は古いため、まだこのチャットを戻せません。戻すにはマシンを更新してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ កំពុងដំណើរការ cmux ចាស់ ដែលមិនទាន់អាចប្រគល់ការជជែកនេះមកវិញបានទេ។ សូមធ្វើបច្ចុប្បន្នភាពម៉ាស៊ីន ដើម្បីនាំវាត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 실행 중인 cmux가 오래되어 아직 이 채팅을 돌려보낼 수 없습니다. 채팅을 가져오려면 머신을 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører en eldre cmux som ennå ikke kan gi tilbake denne chatten. Oppdater maskinen for å hente den tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma starszą wersję cmux, która nie może jeszcze oddać tego czatu. Zaktualizuj maszynę, aby go przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ executa uma versão mais antiga do cmux que ainda não pode devolver este chat. Atualize a máquina para trazê-lo de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ работает старая версия cmux, которая пока не может вернуть этот чат. Обновите машину, чтобы вернуть его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ cmux รุ่นเก่าที่ยังส่งแชทนี้กลับไม่ได้ อัปเดตเครื่องเพื่อนำแชทกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu sohbeti henüz geri veremeyen eski bir cmux sürümü çalıştırıyor. Geri getirmek için makineyi güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ працює старіша версія cmux, яка ще не може повернути цей чат. Оновіть машину, щоб повернути його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang chạy cmux phiên bản cũ nên chưa thể trả lại cuộc trò chuyện này. Hãy cập nhật máy để đưa nó về."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 运行的 cmux 版本较旧，暂时无法交回此对话。请更新该机器以取回对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 執行的 cmux 版本較舊，暫時無法交回此對話。請更新該機器以取回對話。"
          }
        }
      }
    },
    "cloud.bringBack.policyBlocks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat approves actions without asking. A chat coming back from Cloud must ask first: set it to ask in the chat, then Retry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توافق هذه المحادثة على الإجراءات دون أن تسأل. يجب أن تسأل المحادثة العائدة من Cloud أولًا: اضبطها على السؤال داخل المحادثة، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj chat odobrava radnje bez pitanja. Chat koji se vraća s Clouda mora prvo pitati: postavi ga da pita u chatu, pa pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chat godkender handlinger uden at spørge. En chat, der kommer tilbage fra Cloud, skal spørge først: Indstil den til at spørge i chatten, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat genehmigt Aktionen ohne Nachfrage. Ein Chat, der aus der Cloud zurückkommt, muss zuerst fragen: Stelle ihn im Chat auf Nachfragen und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat aprueba acciones sin preguntar. Un chat que vuelve de Cloud debe preguntar primero: configúralo para que pregunte en el chat y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion approuve les actions sans demander. Une discussion qui revient du Cloud doit d’abord demander : réglez-la pour qu’elle demande dans la discussion, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chat approva le azioni senza chiedere. Una chat che torna da Cloud deve prima chiedere: impostala su Chiedi nella chat, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは確認せずに操作を承認します。Cloud から戻るチャットは先に確認する必要があります。チャットで確認するように設定してから再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកនេះយល់ព្រមលើសកម្មភាពដោយមិនសួរ។ ការជជែកដែលត្រឡប់មកពី Cloud ត្រូវតែសួរជាមុនសិន៖ កំណត់វាឲ្យសួរក្នុងការជជែក រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅은 묻지 않고 작업을 승인합니다. Cloud에서 돌아오는 채팅은 먼저 물어야 합니다. 채팅에서 묻기로 설정한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chatten godkjenner handlinger uten å spørre. En chat som kommer tilbake fra Cloud, må spørre først: Sett den til å spørre i chatten, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten czat zatwierdza działania bez pytania. Czat wracający z Cloud musi najpierw pytać: ustaw w czacie pytanie, a potem ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat aprova ações sem perguntar. Um chat que volta do Cloud precisa perguntar antes: configure-o para perguntar no chat e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат одобряет действия, не спрашивая. Чат, возвращающийся из Cloud, должен сначала спрашивать: включите в чате запрос разрешения и повторите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชทนี้อนุมัติการกระทำโดยไม่ถาม แชทที่กลับมาจาก Cloud ต้องถามก่อน: ตั้งค่าให้ถามในแชท แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet eylemleri sormadan onaylıyor. Cloud'dan dönen bir sohbet önce sormalı: Sohbette sorma olarak ayarlayın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чат схвалює дії, не питаючи. Чат, що повертається з Cloud, має спершу питати: увімкніть у чаті запит дозволу й повторіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này phê duyệt hành động mà không hỏi. Cuộc trò chuyện quay về từ Cloud phải hỏi trước: hãy đặt nó thành hỏi trong cuộc trò chuyện rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话会不经询问就批准操作。从 Cloud 带回的对话必须先询问：请在对话中将其设为询问，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話會不經詢問就核准操作。從 Cloud 帶回的對話必須先詢問：請在對話中將其設為詢問，然後重試。"
          }
        }
      }
    },
    "cloud.bringBack.modeBlocks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat's mode acts without asking. A chat coming back from Cloud must ask first: pick an asking mode in the chat, then Retry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع هذه المحادثة ينفّذ دون أن يسأل. يجب أن تسأل المحادثة العائدة من Cloud أولًا: اختر وضعًا يسأل داخل المحادثة، ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Način ovog chata radi bez pitanja. Chat koji se vraća s Clouda mora prvo pitati: odaberi način koji pita u chatu, pa pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chats tilstand handler uden at spørge. En chat, der kommer tilbage fra Cloud, skal spørge først: Vælg en tilstand, der spørger, i chatten, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modus dieses Chats handelt ohne Nachfrage. Ein Chat, der aus der Cloud zurückkommt, muss zuerst fragen: Wähle im Chat einen Modus, der nachfragt, und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de este chat actúa sin preguntar. Un chat que vuelve de Cloud debe preguntar primero: elige un modo que pregunte en el chat y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode de cette discussion agit sans demander. Une discussion qui revient du Cloud doit d’abord demander : choisissez un mode qui demande dans la discussion, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità di questa chat agisce senza chiedere. Una chat che torna da Cloud deve prima chiedere: scegli una modalità che chiede nella chat, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットのモードは確認せずに実行します。Cloud から戻るチャットは先に確認する必要があります。チャットで確認するモードを選んでから再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "របៀបរបស់ការជជែកនេះធ្វើសកម្មភាពដោយមិនសួរ។ ការជជែកដែលត្រឡប់មកពី Cloud ត្រូវតែសួរជាមុនសិន៖ ជ្រើសរើសរបៀបដែលសួរក្នុងការជជែក រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅의 모드는 묻지 않고 실행합니다. Cloud에서 돌아오는 채팅은 먼저 물어야 합니다. 채팅에서 묻는 모드를 고른 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modusen til denne chatten handler uten å spørre. En chat som kommer tilbake fra Cloud, må spørre først: Velg en modus som spør, i chatten, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb tego czatu działa bez pytania. Czat wracający z Cloud musi najpierw pytać: wybierz w czacie tryb z pytaniem, a potem ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo deste chat age sem perguntar. Um chat que volta do Cloud precisa perguntar antes: escolha um modo que pergunte no chat e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим этого чата действует, не спрашивая. Чат, возвращающийся из Cloud, должен сначала спрашивать: выберите в чате режим с запросом и повторите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดของแชทนี้ทำงานโดยไม่ถาม แชทที่กลับมาจาก Cloud ต้องถามก่อน: เลือกโหมดที่ถามในแชท แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbetin modu sormadan işlem yapıyor. Cloud'dan dönen bir sohbet önce sormalı: Sohbette soran bir mod seçin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим цього чату діє, не питаючи. Чат, що повертається з Cloud, має спершу питати: виберіть у чаті режим із запитом і повторіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ của cuộc trò chuyện này hành động mà không hỏi. Cuộc trò chuyện quay về từ Cloud phải hỏi trước: hãy chọn một chế độ có hỏi trong cuộc trò chuyện rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话的模式会不经询问就执行。从 Cloud 带回的对话必须先询问：请在对话中选择会询问的模式，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話的模式會不經詢問就執行。從 Cloud 帶回的對話必須先詢問：請在對話中選擇會詢問的模式，然後重試。"
          }
        }
      }
    },
    "cloud.bringBack.familyBlocks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent can't take a chat back from Cloud yet, so the chat stays there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا الوكيل استعادة محادثة من Cloud بعد، لذا ستبقى المحادثة هناك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj agent još ne može vratiti chat s Clouda, pa chat ostaje tamo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne agent kan endnu ikke tage en chat tilbage fra Cloud, så chatten bliver der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Agent kann noch keinen Chat aus der Cloud zurücknehmen, daher bleibt der Chat dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este agente todavía no puede recuperar un chat de Cloud, así que el chat se queda allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet agent ne peut pas encore reprendre une discussion depuis le Cloud, elle y reste donc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo agente non può ancora riprendere una chat da Cloud, quindi la chat resta lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントはまだ Cloud からチャットを戻せないため、チャットは Cloud に残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនេះមិនទាន់អាចនាំការជជែកត្រឡប់ពី Cloud បានទេ ដូច្នេះការជជែកនៅទីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 에이전트는 아직 Cloud에서 채팅을 다시 가져올 수 없어 채팅이 그대로 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne agenten kan ikke ta tilbake en chat fra Cloud ennå, så chatten blir der."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten agent nie może jeszcze przejąć czatu z Cloud, więc czat tam zostaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este agente ainda não consegue trazer um chat de volta do Cloud, então o chat fica lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот агент пока не может забрать чат из Cloud, поэтому чат остаётся там."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์นี้ยังนำแชทกลับจาก Cloud ไม่ได้ แชทจึงยังอยู่ที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ajan henüz Cloud'dan bir sohbeti geri alamıyor, bu yüzden sohbet orada kalıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей агент поки не може забрати чат із Cloud, тому чат залишається там."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử này chưa thể nhận lại cuộc trò chuyện từ Cloud nên cuộc trò chuyện vẫn ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理暂时无法从 Cloud 带回对话，因此对话会留在那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理暫時無法從 Cloud 帶回對話，因此對話會留在那裡。"
          }
        }
      }
    },
    "cloud.bringBack.unresolved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The move back didn't finish, so the chat is paused. Retry to finish it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل الإعادة، لذا المحادثة متوقفة مؤقتًا. أعد المحاولة لإكمالها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćanje nije završeno, pa je chat pauziran. Pokušaj ponovo da ga završiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytningen tilbage blev ikke færdig, så chatten er sat på pause. Prøv igen for at gøre den færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zurückholen wurde nicht abgeschlossen, daher ist der Chat pausiert. Versuche es erneut, um es abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El regreso no terminó, así que el chat está en pausa. Vuelve a intentarlo para terminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour n’est pas terminé, la discussion est donc en pause. Réessayez pour le terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ritorno non è terminato, quindi la chat è in pausa. Riprova per completarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻す処理が完了しなかったため、チャットは一時停止しています。再試行して完了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនាំត្រឡប់មកវិញមិនទាន់បញ្ចប់ ដូច្នេះការជជែកត្រូវបានផ្អាក។ ព្យាយាមម្តងទៀតដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 가져오기가 끝나지 않아 채팅이 일시 중지되었습니다. 다시 시도하여 완료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttingen tilbake ble ikke fullført, så chatten er satt på pause. Prøv igjen for å fullføre den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie się nie zakończyło, więc czat jest wstrzymany. Ponów, aby je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O retorno não terminou, então o chat está pausado. Tente novamente para concluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат не завершился, поэтому чат приостановлен. Повторите, чтобы завершить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำกลับยังไม่เสร็จ แชทจึงถูกหยุดชั่วคราว ลองอีกครั้งเพื่อให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri getirme bitmedi, bu yüzden sohbet duraklatıldı. Tamamlamak için yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення не завершилося, тому чат призупинено. Повторіть, щоб завершити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đưa về chưa hoàn tất nên cuộc trò chuyện đang tạm dừng. Hãy thử lại để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带回尚未完成，因此对话已暂停。请重试以完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶回尚未完成，因此對話已暫停。請重試以完成。"
          }
        }
      }
    },
