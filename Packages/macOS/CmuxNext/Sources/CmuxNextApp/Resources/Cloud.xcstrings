    "cloud.machine.busy.pausing": {
      "comment": "Why Pause, Resume or Kill Machine is unavailable while cmux Cloud is still pausing the Cloud machine. Shown as the disabled menu row's reason and as a refusal.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine is pausing. Try again once it is paused."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إيقاف هذا الجهاز مؤقتًا. حاول مرة أخرى بعد إيقافه مؤقتًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova mašina se pauzira. Pokušajte ponovo kada bude pauzirana."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne maskine sættes på pause. Prøv igen, når den er sat på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Maschine wird pausiert. Versuche es erneut, sobald sie pausiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina se está pausando. Vuelve a intentarlo cuando esté en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette machine est en cours de mise en pause. Réessayez une fois qu'elle est en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa macchina è in fase di pausa. Riprova quando è in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンは一時停止中です。一時停止が完了してからもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីននេះកំពុងផ្អាក។ សូមព្យាយាមម្ដងទៀតនៅពេលវាផ្អាករួច។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신을 일시 정지하는 중입니다. 일시 정지된 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne maskinen settes på pause. Prøv igjen når den er satt på pause."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta maszyna jest wstrzymywana. Spróbuj ponownie, gdy będzie wstrzymana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina está sendo pausada. Tente novamente quando ela estiver pausada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта машина приостанавливается. Повторите попытку, когда она будет приостановлена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องนี้กำลังหยุดชั่วคราว ลองอีกครั้งเมื่อหยุดชั่วคราวแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makine duraklatılıyor. Duraklatıldığında yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця машина призупиняється. Спробуйте ще раз, коли її буде призупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này đang tạm dừng. Hãy thử lại khi máy đã tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该机器正在暂停。请在暂停完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此機器正在暫停。請在暫停完成後再試一次。"
          }
        }
      }
    },
    "cloud.machine.busy.resuming": {
      "comment": "Why Pause or Resume Machine is unavailable while cmux Cloud is still starting the Cloud machine again. Shown as the disabled menu row's reason and as a refusal.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine is resuming. Try again once it is running."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم استئناف هذا الجهاز. حاول مرة أخرى بعد تشغيله."
          }
        },
        "bs": {
          "stringUnit": {
