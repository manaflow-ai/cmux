        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approva questa macchina nel tuo feed cmux, poi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុម័តម៉ាស៊ីននេះក្នុង feed cmux របស់អ្នក រួចព្យាយាមម្តងទៀត។"
