    "cloud.compat.incompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine runs a cmux-tui this app cannot use (%@). Update the machine to connect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشغّل هذا الجهاز إصدارًا من cmux-tui لا يمكن لهذا التطبيق استخدامه (%@). حدّث الجهاز للاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ova mašina koristi cmux-tui koji ova aplikacija ne može koristiti (%@). Ažurirajte mašinu da se povežete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne maskine kører en cmux-tui, som appen ikke kan bruge (%@). Opdater maskinen for at forbinde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Maschine nutzt ein cmux-tui, das diese App nicht verwenden kann (%@). Aktualisiere die Maschine, um zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina ejecuta un cmux-tui que esta app no puede usar (%@). Actualiza la máquina para conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette machine exécute un cmux-tui que cette app ne peut pas utiliser (%@). Mettez la machine à jour pour vous connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa macchina esegue un cmux-tui che questa app non può usare (%@). Aggiorna la macchina per connetterti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このマシンの cmux-tui はこのアプリで使えません (%@)。接続するにはマシンをアップデートしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីននេះដំណើរការ cmux-tui ដែលកម្មវិធីនេះមិនអាចប្រើបាន (%@)។ ធ្វើបច្ចុប្បន្នភាពម៉ាស៊ីន ដើម្បីភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 머신의 cmux-tui는 이 앱에서 사용할 수 없습니다 (%@). 연결하려면 머신을 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne maskinen kjører en cmux-tui som appen ikke kan bruke (%@). Oppdater maskinen for å koble til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta maszyna działa na cmux-tui, którego ta aplikacja nie może użyć (%@). Zaktualizuj maszynę, aby się połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta máquina executa um cmux-tui que este app não pode usar (%@). Atualize a máquina para conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На этой машине работает cmux-tui, который это приложение не может использовать (%@). Обновите машину, чтобы подключиться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องนี้ใช้ cmux-tui ที่แอปนี้ใช้ไม่ได้ (%@) อัปเดตเครื่องเพื่อเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu makine, bu uygulamanın kullanamadığı bir cmux-tui çalıştırıyor (%@). Bağlanmak için makineyi güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На цій машині працює cmux-tui, який цей застосунок не може використати (%@). Оновіть машину, щоб під'єднатися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy này chạy cmux-tui mà ứng dụng không dùng được (%@). Hãy cập nhật máy để kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此机器运行的 cmux-tui 无法被本应用使用（%@）。请更新机器后再连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此機器執行的 cmux-tui 無法被本 App 使用（%@）。請更新機器後再連線。"
          }
        }
      }
    },
    "cloud.compat.limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
