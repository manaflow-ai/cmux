        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Migawka %@ jest gotowa. Przywróć ją poleceniem Przywróć maszynę Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O snapshot %@ está pronto. Restaure-o com Restaurar Máquina Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Снимок %@ готов. Восстановите его командой «Восстановить машину Cloud»."
          }
        },
        "th": {
          "stringUnit": {
