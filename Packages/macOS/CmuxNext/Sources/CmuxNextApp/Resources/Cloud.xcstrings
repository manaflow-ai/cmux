    "cloud.bringBack.failed": {
      "comment": "Bring Back stopped; %@ is why (last, after “Reason:”). `cmux cloud diagnostics` is a command; keep it as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't bring the chat back. Try again; if it keeps failing, run `cmux cloud diagnostics`. Reason: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إعادة المحادثة. حاول مرة أخرى؛ وإذا استمر الفشل، فشغّل `cmux cloud diagnostics`. السبب: %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat se nije mogao vratiti. Pokušajte ponovo; ako i dalje ne uspijeva, pokrenite `cmux cloud diagnostics`. Razlog: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten kunne ikke hentes tilbage. Prøv igen. Hvis det bliver ved med at mislykkes, så kør `cmux cloud diagnostics`. Årsag: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chat konnte nicht zurückgeholt werden. Versuche es erneut; schlägt es weiter fehl, führe `cmux cloud diagnostics` aus. Grund: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo traer el chat de vuelta. Inténtalo de nuevo; si sigue fallando, ejecuta `cmux cloud diagnostics`. Motivo: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rapatrier la discussion. Réessayez ; si l’échec se répète, exécutez `cmux cloud diagnostics`. Raison : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riportare la chat. Riprova; se continua a non riuscire, esegui `cmux cloud diagnostics`. Motivo: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを戻せませんでした。もう一度試してください。失敗が続く場合は `cmux cloud diagnostics` を実行してください。理由: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចនាំការជជែកត្រឡប់មកវិញបានទេ។ សាកម្តងទៀត។ ប្រសិនបើនៅតែបរាជ័យ សូមដំណើរការ `cmux cloud diagnostics`។ មូលហេតុ៖ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅을 다시 가져오지 못했습니다. 다시 시도하세요. 계속 실패하면 `cmux cloud diagnostics`를 실행하세요. 이유: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke hente chatten tilbake. Prøv igjen. Hvis det fortsatt mislykkes, kjør `cmux cloud diagnostics`. Årsak: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przywrócić czatu. Spróbuj ponownie; jeśli nadal się nie udaje, uruchom `cmux cloud diagnostics`. Powód: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível trazer o chat de volta. Tente de novo; se continuar falhando, execute `cmux cloud diagnostics`. Motivo: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось вернуть чат. Повторите попытку; если сбой повторяется, выполните `cmux cloud diagnostics`. Причина: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำแชทกลับมาไม่ได้ ลองอีกครั้ง หากยังไม่สำเร็จ ให้เรียกใช้ `cmux cloud diagnostics` สาเหตุ: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet geri getirilemedi. Yeniden deneyin; başarısız olmaya devam ederse `cmux cloud diagnostics` komutunu çalıştırın. Neden: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося повернути чат. Спробуйте ще раз; якщо збій повторюється, виконайте `cmux cloud diagnostics`. Причина: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đưa cuộc trò chuyện về. Hãy thử lại; nếu vẫn thất bại, hãy chạy `cmux cloud diagnostics`. Lý do: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法带回对话。请重试；如果仍然失败，请运行 `cmux cloud diagnostics`。原因：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法帶回對話。請再試一次；如果仍然失敗，請執行 `cmux cloud diagnostics`。原因：%@"
          }
        }
      }
    },
    "cloud.bringBack.askFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask first, then bring back"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب الإذن أولًا، ثم أعدها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo pitaj, pa vrati"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg først, og hent tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst fragen, dann zurückholen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar primero y traer de vuelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander d’abord, puis rapatrier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi prima, poi riporta indietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に確認してから戻す"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរជាមុន រួចនាំយកមកវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 묻기로 설정하고 가져오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør først, og hent tilbake"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw pytaj, potem przywróć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes e trazer de volta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала спрашивать, затем вернуть"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ถามก่อน แล้วนำกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce sor, sonra geri getir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу питати, потім повернути"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi trước, rồi mang về"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先询问，再带回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先詢問，再帶回"
          }
        }
      }
    },
    "cloud.bringBack.policyAsksFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat approves actions without asking. A chat coming back from Cloud must ask first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توافق هذه المحادثة على الإجراءات دون أن تسأل. يجب أن تسأل المحادثة العائدة من Cloud أولًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj chat odobrava radnje bez pitanja. Chat koji se vraća s Clouda mora prvo pitati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chat godkender handlinger uden at spørge. En chat, der kommer tilbage fra Cloud, skal spørge først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat genehmigt Aktionen ohne Nachfrage. Ein Chat, der aus der Cloud zurückkommt, muss zuerst fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat aprueba acciones sin preguntar. Un chat que vuelve de Cloud debe preguntar primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion approuve les actions sans demander. Une discussion qui revient du Cloud doit d’abord demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chat approva le azioni senza chiedere. Una chat che torna da Cloud deve prima chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは確認せずに操作を承認します。Cloud から戻るチャットは先に確認する必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកនេះយល់ព្រមលើសកម្មភាពដោយមិនសួរ។ ការជជែកដែលត្រឡប់មកពី Cloud ត្រូវតែសួរជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅은 묻지 않고 작업을 승인합니다. Cloud에서 돌아오는 채팅은 먼저 물어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chatten godkjenner handlinger uten å spørre. En chat som kommer tilbake fra Cloud, må spørre først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten czat zatwierdza działania bez pytania. Czat wracający z Cloud musi najpierw pytać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat aprova ações sem perguntar. Um chat que volta do Cloud precisa perguntar antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат одобряет действия, не спрашивая. Чат, возвращающийся из Cloud, должен сначала спрашивать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชทนี้อนุมัติการกระทำโดยไม่ถาม แชทที่กลับมาจาก Cloud ต้องถามก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet eylemleri sormadan onaylıyor. Cloud'dan dönen bir sohbet önce sormalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чат схвалює дії, не питаючи. Чат, що повертається з Cloud, має спершу питати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này phê duyệt hành động mà không hỏi. Cuộc trò chuyện quay về từ Cloud phải hỏi trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话会不经询问就批准操作。从 Cloud 带回的对话必须先询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話會不經詢問就核准操作。從 Cloud 帶回的對話必須先詢問。"
          }
        }
      }
    },
    "cloud.bringBack.modeAsksFirst": {
