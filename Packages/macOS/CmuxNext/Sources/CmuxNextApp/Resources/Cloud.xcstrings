    "cloud.github.identityFailed": {
      "comment": "Toast prefix when git config failed on the Cloud machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git identity couldn't be set on this machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر ضبط هوية git على هذا الجهاز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Git identitet nije moguće postaviti na ovoj mašini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-identiteten kunne ikke angives på denne maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Git-Identität konnte auf dieser Maschine nicht gesetzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer la identidad de git en esta máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de définir l’identité git sur cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile impostare l’identità git su questa macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンで git の ID を設定できませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចកំណត់អត្តសញ្ញាណ git នៅលើម៉ាស៊ីននេះបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신에서 git ID를 설정할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-identiteten kunne ikke settes på denne maskinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustawić tożsamości git na tej maszynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível definir a identidade do git nesta máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось задать идентификацию git на этой машине."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตั้งค่าข้อมูลประจำตัว git บนเครื่องนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinede git kimliği ayarlanamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося встановити ідентичність git на цій машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đặt danh tính git trên máy này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此机器上设置 git 身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此機器上設定 git 身分。"
          }
        }
      }
