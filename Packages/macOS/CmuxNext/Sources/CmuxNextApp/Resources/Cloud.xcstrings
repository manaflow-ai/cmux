    "cloud.button.resume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استئناف"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre"
          }
