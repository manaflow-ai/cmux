          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenoś bez pytania, gdy poprosi agent w %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover sem perguntar sempre que um agente em %@ pedir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносить без вопроса, когда об этом просит агент в %@"
