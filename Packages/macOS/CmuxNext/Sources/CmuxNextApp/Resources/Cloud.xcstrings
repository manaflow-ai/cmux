        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina i svi terminali na njoj bit će izbrisani. Ovo se ne može poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
