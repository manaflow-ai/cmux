    "cloud.move.linkUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't take a chat over its current connection. Pick another machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ %@ استقبال محادثة عبر اتصاله الحالي. اختر جهازًا آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne može primiti chat preko trenutne veze. Odaberi drugu mašinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke modtage en chat over sin nuværende forbindelse. Vælg en anden maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann über die aktuelle Verbindung keinen Chat übernehmen. Wähle einen anderen Rechner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede recibir un chat con su conexión actual. Elige otra máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas recevoir de discussion avec sa connexion actuelle. Choisissez une autre machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può ricevere una chat con la connessione attuale. Scegli un’altra macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在の接続ではチャットを受け取れません。別のマシンを選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មិនអាចទទួលការជជែកតាមការតភ្ជាប់បច្ចុប្បន្នបានទេ។ ជ្រើសម៉ាស៊ីនផ្សេង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 현재 연결로 채팅을 받을 수 없습니다. 다른 머신을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke ta imot en chat over den nåværende tilkoblingen. Velg en annen maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie może przyjąć czatu przez obecne połączenie. Wybierz inną maszynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode receber um chat pela conexão atual. Escolha outra máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не может принять чат через текущее подключение. Выберите другую машину."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ รับแชทผ่านการเชื่อมต่อปัจจุบันไม่ได้ เลือกเครื่องอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcut bağlantısı üzerinden sohbet alamaz. Başka bir makine seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може прийняти чат через поточне підключення. Виберіть іншу машину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không thể nhận cuộc trò chuyện qua kết nối hiện tại. Hãy chọn máy khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前的连接无法接收对话。请选择另一台机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前的連線無法接收對話。請選擇另一台機器。"
          }
        }
      }
    },
