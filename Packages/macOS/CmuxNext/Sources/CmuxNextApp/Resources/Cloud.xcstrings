        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud에서 채팅을 다시 가져올 수 있는 것은 사람뿐입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en person kan hente en chat tilbake fra Cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko człowiek może przywrócić czat z Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma pessoa pode trazer um chat de volta do Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть чат из Cloud может только человек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงคนเท่านั้นที่นำแชทกลับจาก Cloud ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sohbeti Cloud'dan yalnızca bir kişi geri getirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернути чат із Cloud може лише людина."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người dùng mới có thể đưa cuộc trò chuyện về từ Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有人才能将对话从 Cloud 带回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有人才能將對話從 Cloud 帶回。"
          }
        }
      }
    },
