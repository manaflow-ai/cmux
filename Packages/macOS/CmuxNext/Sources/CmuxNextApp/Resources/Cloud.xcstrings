          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tę maszynę w swoim kanale cmux i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
