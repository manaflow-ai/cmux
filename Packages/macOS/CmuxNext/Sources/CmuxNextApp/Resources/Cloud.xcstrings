    "cloud.access.alwaysHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share %@ with this chat, read-only, until it comes back"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاركة %@ مع هذه الدردشة للقراءة فقط حتى تعود"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeli %@ s ovim chatom, samo za čitanje, dok se ne vrati"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del %@ med denne chat, skrivebeskyttet, indtil den kommer tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schreibgeschützt mit diesem Chat teilen, bis er zurückkommt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir %@ con este chat, solo lectura, hasta que vuelva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager %@ avec cette discussion, en lecture seule, jusqu’à son retour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi %@ con questa chat, in sola lettura, finché non torna"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットが戻るまで、%@ を読み取り専用で共有します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចែករំលែក %@ ជាមួយការជជែកនេះ សម្រាប់តែអាន រហូតដល់វាត្រឡប់មកវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅이 돌아올 때까지 %@을(를) 읽기 전용으로 공유"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del %@ med denne chatten, skrivebeskyttet, til den kommer tilbake"
          }
        },
