        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l'identifiant du réseau avec --path <network-id> ; `cmux cloud network-list` affiche les identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa l'id della rete con --path <network-id>; `cmux cloud network-list` elenca gli id."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク ID を --path <network-id> で指定してください。`cmux cloud network-list` で ID の一覧を表示できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូនលេខសម្គាល់បណ្ដាញដោយប្រើ --path <network-id>; `cmux cloud network-list` បង្ហាញលេខសម្គាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--path <network-id>로 네트워크 ID를 전달하세요. `cmux cloud network-list`로 ID 목록을 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi nettverks-ID-en med --path <network-id>; `cmux cloud network-list` viser ID-ene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj identyfikator sieci w --path <network-id>; `cmux cloud network-list` wyświetla identyfikatory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o id da rede com --path <network-id>; `cmux cloud network-list` lista os ids."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте идентификатор сети через --path <network-id>; `cmux cloud network-list` показывает идентификаторы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
