    "cloud.prompt.killMachineBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine and every terminal on it are deleted. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンとその上のすべてのターミナルが削除されます。この操作は取り消せません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيُحذف الجهاز وكل الطرفيات عليه. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mašina i svi terminali na njoj bit će izbrisani. Ovo se ne može poništiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen og alle terminaler på den slettes. Handlingen kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Maschine und alle Terminals darauf werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se eliminarán la máquina y todos sus terminales. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La machine et tous ses terminaux seront supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La macchina e tutti i suoi terminali verranno eliminati. Questa operazione non può essere annullata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ម៉ាស៊ីន និង Terminal ទាំងអស់នៅលើវានឹងត្រូវលុប។ សកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기와 기기의 모든 터미널이 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maskinen og alle terminalene på den slettes. Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maszyna i wszystkie jej terminale zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A máquina e todos os seus terminais serão apagados. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машина и все терминалы на ней будут удалены. Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เครื่องและเทอร์มินัลทั้งหมดบนเครื่องจะถูกลบ ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Makine ve üzerindeki tüm terminaller silinir. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Машину й усі термінали на ній буде видалено. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Máy và mọi terminal trên máy sẽ bị xóa. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "机器及其上的所有终端都将被删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "機器及其上的所有終端機都會被刪除。此動作無法還原。"
          }
        }
      }
    },
