        "nb": {"stringUnit": {"state": "needs_review", "value": "Oppsettet stoppet på maskinen før det var ferdig. Se loggen i %@."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Konfiguracja zatrzymała się na maszynie przed zakończeniem. Zobacz dziennik w %@."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A configuração parou na máquina antes de terminar. Veja o log em %@."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Настройка остановилась на машине, не завершившись. Журнал: %@."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การตั้งค่าหยุดบนเครื่องก่อนเสร็จ ดูบันทึกที่ %@"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Kurulum makinede bitmeden durdu. Günlüğe bakın: %@."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Налаштування зупинилося на машині, не завершившись. Журнал: %@."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Quá trình thiết lập đã dừng trên máy trước khi xong. Xem nhật ký tại %@."}}
      }
    },
    "cloud.bootstrap.stillRunning": {
      "comment": "cmux stopped waiting for a new Cloud machine's setup, which still runs. %@ is the log's path on the machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The setup is still running on the machine; see the log at %@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セットアップはまだマシン上で実行中です。ログは %@ にあります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Die Einrichtung läuft noch auf der Maschine; siehe das Protokoll unter %@."}},
