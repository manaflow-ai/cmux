    "cloud.cli.bootstrapScriptRequired": {
      "comment": "cmux cloud new-machine: a bootstrap was asked for without its script file. Keep the flags as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A bootstrap needs its script: pass --bootstrap-script FILE with --bootstrap lane or none."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ブートストラップにはスクリプトが必要です。--bootstrap lane または none と一緒に --bootstrap-script FILE を指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Ein Bootstrap braucht sein Skript: Gib --bootstrap-script FILE zusammen mit --bootstrap lane oder none an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Un bootstrap a besoin de son script : passez --bootstrap-script FILE avec --bootstrap lane ou none."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Un bootstrap necesita su script: pasa --bootstrap-script FILE con --bootstrap lane o none."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يحتاج التمهيد إلى نصه البرمجي: مرّر ‎--bootstrap-script FILE مع ‎--bootstrap lane أو none."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "부트스트랩에는 스크립트가 필요합니다. --bootstrap lane 또는 none과 함께 --bootstrap-script FILE을 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "引导需要脚本：请将 --bootstrap-script FILE 与 --bootstrap lane 或 none 一起传入。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "引導需要腳本：請將 --bootstrap-script FILE 與 --bootstrap lane 或 none 一起傳入。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Početnom podešavanju treba skripta: proslijedi --bootstrap-script FILE uz --bootstrap lane ili none."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Et opstart kræver sit script: angiv --bootstrap-script FILE sammen med --bootstrap lane eller none."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Un avvio iniziale richiede il suo script: passa --bootstrap-script FILE con --bootstrap lane o none."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការរៀបចំដំបូងត្រូវការស្គ្រីបរបស់វា៖ បញ្ជូន --bootstrap-script FILE ជាមួយ --bootstrap lane ឬ none។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "En oppstart trenger skriptet sitt: oppgi --bootstrap-script FILE sammen med --bootstrap lane eller none."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Konfiguracja startowa wymaga skryptu: podaj --bootstrap-script FILE razem z --bootstrap lane lub none."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A inicialização precisa do seu script: passe --bootstrap-script FILE com --bootstrap lane ou none."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Для начальной настройки нужен скрипт: укажите --bootstrap-script FILE вместе с --bootstrap lane или none."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การตั้งค่าเริ่มต้นต้องมีสคริปต์: ส่ง --bootstrap-script FILE พร้อมกับ --bootstrap lane หรือ none"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "İlk kurulum için betiği gerekir: --bootstrap lane veya none ile birlikte --bootstrap-script FILE verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Для початкового налаштування потрібен скрипт: вкажіть --bootstrap-script FILE разом із --bootstrap lane або none."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Khởi tạo ban đầu cần tập lệnh của nó: truyền --bootstrap-script FILE cùng với --bootstrap lane hoặc none."}}
      }
    },
    "cloud.cli.bootstrapScriptUnreadable": {
      "comment": "cmux cloud new-machine: the bootstrap script file can't be used. %@ is its path.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't use the bootstrap script %@: it must be a readable file of at most 1 MB."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ブートストラップスクリプト %@ を使用できません。1 MB 以下の読み取り可能なファイルである必要があります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das Bootstrap-Skript %@ kann nicht verwendet werden: Es muss eine lesbare Datei von höchstens 1 MB sein."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible d’utiliser le script de bootstrap %@ : il doit s’agir d’un fichier lisible de 1 Mo au plus."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede usar el script de bootstrap %@: debe ser un archivo legible de 1 MB como máximo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّر استخدام نص التمهيد %@: يجب أن يكون ملفًا قابلًا للقراءة لا يزيد حجمه على 1 ميغابايت."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "부트스트랩 스크립트 %@을(를) 사용할 수 없습니다. 1MB 이하의 읽을 수 있는 파일이어야 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法使用引导脚本 %@：它必须是不超过 1 MB 的可读文件。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法使用引導腳本 %@：它必須是不超過 1 MB 的可讀檔案。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Nije moguće koristiti skriptu početnog podešavanja %@: mora biti čitljiva datoteka od najviše 1 MB."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Kan ikke bruge opstartsscriptet %@: det skal være en læsbar fil på højst 1 MB."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile usare lo script di avvio iniziale %@: deve essere un file leggibile di al massimo 1 MB."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចប្រើស្គ្រីបរៀបចំដំបូង %@ បានទេ៖ វាត្រូវតែជាឯកសារដែលអាចអានបាន និងមិនលើសពី 1 MB។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke bruke oppstartsskriptet %@: det må være en lesbar fil på høyst 1 MB."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można użyć skryptu konfiguracji startowej %@: musi to być czytelny plik o rozmiarze najwyżej 1 MB."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível usar o script de inicialização %@: ele precisa ser um arquivo legível de no máximo 1 MB."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Невозможно использовать скрипт начальной настройки %@: это должен быть читаемый файл размером не более 1 МБ."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ใช้สคริปต์ตั้งค่าเริ่มต้น %@ ไม่ได้: ต้องเป็นไฟล์ที่อ่านได้และมีขนาดไม่เกิน 1 MB"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ ilk kurulum betiği kullanılamıyor: en fazla 1 MB boyutunda okunabilir bir dosya olmalı."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Неможливо використати скрипт початкового налаштування %@: це має бути файл, доступний для читання, розміром не більше 1 МБ."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể dùng tập lệnh khởi tạo %@: tập lệnh phải là tệp đọc được, tối đa 1 MB."}}
      }
    },
    "cloud.cli.laneNeedsName": {
      "comment": "cmux cloud new-machine --bootstrap lane without --name. Keep the flag as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The lane bootstrap needs the machine's name: pass --name lane-vm-N."}},
        "ja": {"stringUnit": {"state": "translated", "value": "lane ブートストラップにはマシン名が必要です。--name lane-vm-N を指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Lane-Bootstrap braucht den Namen der Maschine: Gib --name lane-vm-N an."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le bootstrap lane a besoin du nom de la machine : passez --name lane-vm-N."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El bootstrap lane necesita el nombre de la máquina: pasa --name lane-vm-N."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يحتاج تمهيد lane إلى اسم الجهاز: مرّر ‎--name lane-vm-N."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "lane 부트스트랩에는 머신 이름이 필요합니다. --name lane-vm-N을 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "lane 引导需要机器名称：请传入 --name lane-vm-N。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "lane 引導需要機器名稱：請傳入 --name lane-vm-N。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Početnom podešavanju lane treba ime mašine: proslijedi --name lane-vm-N."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Lane-opstarten skal bruge maskinens navn: angiv --name lane-vm-N."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "L'avvio iniziale lane richiede il nome della macchina: passa --name lane-vm-N."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ការរៀបចំដំបូង lane ត្រូវការឈ្មោះម៉ាស៊ីន៖ បញ្ជូន --name lane-vm-N។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Lane-oppstarten trenger maskinens navn: oppgi --name lane-vm-N."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Konfiguracja startowa lane wymaga nazwy maszyny: podaj --name lane-vm-N."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "A inicialização lane precisa do nome da máquina: passe --name lane-vm-N."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Для начальной настройки lane нужно имя машины: укажите --name lane-vm-N."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "การตั้งค่าเริ่มต้นแบบ lane ต้องมีชื่อเครื่อง: ส่ง --name lane-vm-N"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "lane ilk kurulumu makinenin adına ihtiyaç duyar: --name lane-vm-N verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Для початкового налаштування lane потрібне ім'я машини: вкажіть --name lane-vm-N."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Khởi tạo lane cần tên của máy: truyền --name lane-vm-N."}}
      }
    },
    "cloud.cli.machineOptionsUnavailable": {
      "comment": "cmux cloud new-machine --size or --persistent on a backend that can't take them. Keep the command names as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Cloud backend can't create a machine with a size, idle pause, name or bootstrap yet. Create it without them, then use cloud resize-machine, cloud set-idle-pause and cloud rename-machine."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Cloud バックエンドでは、サイズ、アイドル時の一時停止、名前、ブートストラップを指定したマシンをまだ作成できません。これらを指定せずに作成してから、cloud resize-machine、cloud set-idle-pause、cloud rename-machine を使用してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dieses Cloud-Backend kann noch keine Maschine mit Größe, Pause bei Inaktivität, Namen oder Bootstrap erstellen. Erstelle sie ohne diese Angaben und verwende dann cloud resize-machine, cloud set-idle-pause und cloud rename-machine."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Ce backend Cloud ne peut pas encore créer de machine avec une taille, une pause en cas d’inactivité, un nom ou un bootstrap. Créez-la sans, puis utilisez cloud resize-machine, cloud set-idle-pause et cloud rename-machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Este backend de Cloud aún no puede crear una máquina con tamaño, pausa por inactividad, nombre o bootstrap. Créala sin ellos y luego usa cloud resize-machine, cloud set-idle-pause y cloud rename-machine."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا تستطيع خلفية Cloud هذه بعدُ إنشاء جهاز بحجم أو إيقاف مؤقت عند الخمول أو اسم أو تمهيد. أنشئه بدونها، ثم استخدم cloud resize-machine وcloud set-idle-pause وcloud rename-machine."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Cloud 백엔드는 아직 크기, 유휴 시 일시 정지, 이름, 부트스트랩을 지정해 머신을 만들 수 없습니다. 이 옵션 없이 만든 다음 cloud resize-machine, cloud set-idle-pause, cloud rename-machine을 사용하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "此 Cloud 后端暂时无法创建带有大小、空闲暂停、名称或引导的机器。请先不带这些选项创建，再使用 cloud resize-machine、cloud set-idle-pause 和 cloud rename-machine。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "此 Cloud 後端暫時無法建立帶有大小、閒置暫停、名稱或引導的機器。請先不帶這些選項建立，再使用 cloud resize-machine、cloud set-idle-pause 和 cloud rename-machine。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ovaj Cloud backend još ne može napraviti mašinu s veličinom, pauzom pri neaktivnosti, imenom ili početnim podešavanjem. Napravi je bez njih, pa koristi cloud resize-machine, cloud set-idle-pause i cloud rename-machine."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne Cloud-backend kan endnu ikke oprette en maskine med størrelse, pause ved inaktivitet, navn eller opstart. Opret den uden dem, og brug derefter cloud resize-machine, cloud set-idle-pause og cloud rename-machine."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questo backend Cloud non può ancora creare una macchina con dimensione, pausa per inattività, nome o avvio iniziale. Creala senza, poi usa cloud resize-machine, cloud set-idle-pause e cloud rename-machine."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ផ្នែកខាងក្រោយ Cloud នេះមិនទាន់អាចបង្កើតម៉ាស៊ីនដែលមានទំហំ ការផ្អាកពេលទំនេរ ឈ្មោះ ឬការរៀបចំដំបូងបានទេ។ សូមបង្កើតវាដោយគ្មានជម្រើសទាំងនោះ រួចប្រើ cloud resize-machine, cloud set-idle-pause និង cloud rename-machine។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne Cloud-backenden kan ennå ikke opprette en maskin med størrelse, pause ved inaktivitet, navn eller oppstart. Opprett den uten dem, og bruk deretter cloud resize-machine, cloud set-idle-pause og cloud rename-machine."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ten backend Cloud nie może jeszcze utworzyć maszyny z rozmiarem, wstrzymaniem przy bezczynności, nazwą ani konfiguracją startową. Utwórz ją bez nich, a potem użyj cloud resize-machine, cloud set-idle-pause i cloud rename-machine."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Este back-end do Cloud ainda não consegue criar uma máquina com tamanho, pausa por inatividade, nome ou inicialização. Crie-a sem eles e depois use cloud resize-machine, cloud set-idle-pause e cloud rename-machine."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Этот бэкенд Cloud пока не умеет создавать машину с размером, паузой при простое, именем или начальной настройкой. Создайте её без них, затем используйте cloud resize-machine, cloud set-idle-pause и cloud rename-machine."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "แบ็กเอนด์ Cloud นี้ยังสร้างเครื่องที่กำหนดขนาด การหยุดชั่วคราวเมื่อว่าง ชื่อ หรือการตั้งค่าเริ่มต้นไม่ได้ ให้สร้างโดยไม่ใส่ตัวเลือกเหล่านี้ แล้วใช้ cloud resize-machine, cloud set-idle-pause และ cloud rename-machine"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Cloud arka ucu henüz boyut, boşta duraklatma, ad veya ilk kurulumla makine oluşturamıyor. Bunlar olmadan oluşturun, ardından cloud resize-machine, cloud set-idle-pause ve cloud rename-machine kullanın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Цей бекенд Cloud поки не може створити машину з розміром, паузою під час простою, ім'ям або початковим налаштуванням. Створіть її без них, а потім використайте cloud resize-machine, cloud set-idle-pause і cloud rename-machine."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Phần phụ trợ Cloud này chưa thể tạo máy với kích thước, tạm dừng khi rảnh, tên hoặc khởi tạo ban đầu. Hãy tạo máy mà không dùng chúng, rồi dùng cloud resize-machine, cloud set-idle-pause và cloud rename-machine."}}
      }
    },
    "cloud.cli.machineNameInvalid": {
      "comment": "cmux cloud new-machine: the --name value is not a plain name. Keep lane-vm-1 as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The machine's name must be 1 to 64 letters, digits, dots, dashes or underscores, such as lane-vm-1."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシン名は英数字、ドット、ハイフン、アンダースコアの 1〜64 文字にしてください（例: lane-vm-1）。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Der Name der Maschine muss aus 1 bis 64 Buchstaben, Ziffern, Punkten, Bindestrichen oder Unterstrichen bestehen, etwa lane-vm-1."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le nom de la machine doit comporter de 1 à 64 lettres, chiffres, points, tirets ou traits de soulignement, par exemple lane-vm-1."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El nombre de la máquina debe tener de 1 a 64 letras, dígitos, puntos, guiones o guiones bajos, por ejemplo lane-vm-1."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يجب أن يتكوّن اسم الجهاز من 1 إلى 64 حرفًا أو رقمًا أو نقطة أو شرطة أو شرطة سفلية، مثل lane-vm-1."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신 이름은 영문자, 숫자, 점, 하이픈, 밑줄로 된 1~64자여야 합니다(예: lane-vm-1)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "机器名称必须是 1 到 64 个字母、数字、点、连字符或下划线，例如 lane-vm-1。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "機器名稱必須是 1 到 64 個字母、數字、點、連字號或底線，例如 lane-vm-1。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ime mašine mora imati od 1 do 64 slova, cifara, tačaka, crtica ili donjih crta, na primjer lane-vm-1."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Maskinens navn skal være 1 til 64 bogstaver, cifre, punktummer, bindestreger eller understreger, f.eks. lane-vm-1."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il nome della macchina deve avere da 1 a 64 lettere, cifre, punti, trattini o trattini bassi, ad esempio lane-vm-1."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ឈ្មោះម៉ាស៊ីនត្រូវមានពី 1 ដល់ 64 តួ ដែលជាអក្សរ លេខ ចំណុច សញ្ញាដក ឬសញ្ញាគូសក្រោម ឧទាហរណ៍ lane-vm-1។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Maskinens navn må være 1 til 64 bokstaver, sifre, punktum, bindestreker eller understreker, for eksempel lane-vm-1."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nazwa maszyny musi mieć od 1 do 64 liter, cyfr, kropek, myślników lub podkreśleń, np. lane-vm-1."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O nome da máquina precisa ter de 1 a 64 letras, dígitos, pontos, hífens ou sublinhados, como lane-vm-1."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Имя машины должно содержать от 1 до 64 букв, цифр, точек, дефисов или подчёркиваний, например lane-vm-1."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ชื่อเครื่องต้องมี 1 ถึง 64 อักขระที่เป็นตัวอักษร ตัวเลข จุด ขีดกลาง หรือขีดล่าง เช่น lane-vm-1"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Makinenin adı 1 ile 64 arasında harf, rakam, nokta, tire veya alt çizgiden oluşmalı, örneğin lane-vm-1."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ім'я машини має містити від 1 до 64 літер, цифр, крапок, дефісів або підкреслень, наприклад lane-vm-1."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Tên máy phải gồm 1 đến 64 chữ cái, chữ số, dấu chấm, dấu gạch ngang hoặc dấu gạch dưới, ví dụ lane-vm-1."}}
      }
    },
