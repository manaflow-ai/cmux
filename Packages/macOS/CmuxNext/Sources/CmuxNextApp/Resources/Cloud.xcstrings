    "cloud.access.secretAsk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent on %1$@ asks you for the secret %2$@. What you enter goes to this one request only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب وكيل على %1$@ منك السر %2$@. ما تدخله يذهب إلى هذا الطلب فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent na %1$@ traži od vas tajnu %2$@. Ono što unesete ide samo ovom zahtjevu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent på %1$@ beder dig om hemmeligheden %2$@. Det, du indtaster, går kun til denne ene anmodning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent auf %1$@ bittet dich um das Geheimnis %2$@. Was du eingibst, geht nur an diese eine Anfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente en %1$@ te pide el secreto %2$@. Lo que escribas va solo a esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent sur %1$@ vous demande le secret %2$@. Ce que vous saisissez va uniquement à cette demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente su %1$@ ti chiede il segreto %2$@. Ciò che inserisci va solo a questa richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のエージェントがシークレット %2$@ を求めています。入力した内容はこのリクエストにのみ送られます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្នាក់ងារនៅលើ %1$@ ស្នើសុំអាថ៌កំបាំង %2$@ ពីអ្នក។ អ្វីដែលអ្នកបញ្ចូលនឹងទៅកាន់សំណើនេះតែប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 에이전트가 비밀 %2$@을(를) 요청합니다. 입력한 내용은 이 요청에만 전달됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent på %1$@ ber deg om hemmeligheten %2$@. Det du skriver inn, går bare til denne ene forespørselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent na %1$@ prosi Cię o sekret %2$@. To, co wpiszesz, trafi tylko do tej jednej prośby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente em %1$@ pede a você o segredo %2$@. O que você digitar vai apenas para esta solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент на %1$@ запрашивает у вас секрет %2$@. Введённое уйдёт только в этот запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์บน %1$@ ขอข้อมูลลับ %2$@ จากคุณ สิ่งที่คุณป้อนจะส่งไปยังคำขอนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ üzerindeki bir ajan sizden %2$@ sırrını istiyor. Girdiğiniz yalnızca bu isteğe gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент на %1$@ просить у вас секрет %2$@. Введене піде лише в цей запит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tác tử trên %1$@ yêu cầu bạn cung cấp bí mật %2$@. Nội dung bạn nhập chỉ được gửi cho yêu cầu này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上的代理向你索要密钥 %2$@。你输入的内容只会发送给这一个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上的代理程式向你索取密鑰 %2$@。你輸入的內容只會傳送給這一個請求。"
          }
        }
      }
    },
