    "cloud.bringBack.askFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask first, then bring back"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب الإذن أولًا، ثم أعدها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo pitaj, pa vrati"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg først, og hent tilbage"
          }
        },
        "de": {
