    "cloud.move.alreadyRemote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat already runs on another machine."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل هذه المحادثة بالفعل على جهاز آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj chat već radi na drugoj mašini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chat kører allerede på en anden maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat läuft bereits auf einem anderen Rechner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat ya se ejecuta en otra máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion s’exécute déjà sur une autre machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chat è già in esecuzione su un’altra macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットはすでに別のマシンで実行されています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកនេះកំពុងដំណើរការលើម៉ាស៊ីនផ្សេងរួចហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅은 이미 다른 머신에서 실행 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne chatten kjører allerede på en annen maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten czat działa już na innej maszynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat já é executado em outra máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат уже работает на другой машине."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชทนี้ทำงานบนเครื่องอื่นอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet zaten başka bir makinede çalışıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей чат уже працює на іншій машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện này đã chạy trên một máy khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话已在另一台机器上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話已在另一台機器上執行。"
          }
        }
      }
    },
