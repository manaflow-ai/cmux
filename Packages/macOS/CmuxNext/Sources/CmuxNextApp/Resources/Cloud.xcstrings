    "cloud.network.ruleJSONRequired": {
      "comment": "cloud firewall-create got no valid rule. The --path '{…}' example is literal JSON the CLI takes; keep it exactly as it is, including the quotes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the rule as JSON with a source and a destination, for example --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر القاعدة بصيغة JSON مع مصدر ووجهة، مثلًا --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedite pravilo kao JSON s izvorom i odredištem, na primjer --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv reglen som JSON med en kilde og en destination, for eksempel --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Regel als JSON mit Quelle und Ziel an, zum Beispiel --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa la regla como JSON con un origen y un destino, por ejemplo --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la règle en JSON avec une source et une destination, par exemple --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa la regola come JSON con un'origine e una destinazione, per esempio --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは送信元と宛先を含む JSON で指定してください。例: --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូនច្បាប់ជា JSON ដែលមានប្រភព និងគោលដៅ ឧទាហរណ៍ --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발지와 목적지가 있는 JSON으로 규칙을 전달하세요. 예: --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi regelen som JSON med en kilde og et mål, for eksempel --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj regułę jako JSON ze źródłem i celem, na przykład --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe a regra como JSON com uma origem e um destino, por exemplo --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте правило в формате JSON с источником и назначением, например --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งกฎเป็น JSON ที่มีต้นทางและปลายทาง เช่น --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralı bir kaynak ve bir hedefle JSON olarak verin, örneğin --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте правило у форматі JSON із джерелом і призначенням, наприклад --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền quy tắc dưới dạng JSON có nguồn và đích, ví dụ --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以包含来源和目标的 JSON 传入规则，例如 --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以包含來源和目的地的 JSON 傳入規則，例如 --path '{\"source\":{\"vmId\":\"<machine-id>\"},\"destination\":{\"cidr\":\"10.0.0.0/24\",\"port\":443,\"protocol\":\"tcp\"}}'。"
          }
        }
      }
    },
