            "state": "translated",
            "value": "완료하려면 github.com/login/device에서 코드 %@를 입력하세요. 코드가 복사되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn koden %@ på github.com/login/device for å fullføre. Koden er kopiert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kod %@ na github.com/login/device, aby dokończyć. Kod został skopiowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código %@ em github.com/login/device para concluir. O código foi copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите код %@ на github.com/login/device, чтобы завершить. Код скопирован."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนรหัส %@ ที่ github.com/login/device เพื่อเสร็จสิ้น คัดลอกรหัสแล้ว"
