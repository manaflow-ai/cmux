    "cloud.github.confirmBody": {
      "comment": "Confirmation body; %1$@ is the git user.name and %2$@ the git user.email read from this Mac. Keep user.name and user.email untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets git user.name to “%1$@” and user.email to “%2$@” on the machine, then starts GitHub sign-in in your browser. Your GitHub token on this Mac is not copied."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط git user.name على “%1$@” وuser.email على “%2$@” على الجهاز، ثم يبدأ تسجيل الدخول إلى GitHub في متصفحك. لا يُنسخ رمز GitHub المميز الموجود على هذا الـMac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavlja git user.name na “%1$@” i user.email na “%2$@” na mašini, a zatim pokreće prijavu na GitHub u vašem pregledniku. Vaš GitHub token na ovom Macu se ne kopira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter git user.name til “%1$@” og user.email til “%2$@” på maskinen og starter derefter GitHub-login i din browser. Dit GitHub-token på denne Mac bliver ikke kopieret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt git user.name auf „%1$@“ und user.email auf „%2$@“ auf der Maschine und startet dann die GitHub-Anmeldung in deinem Browser. Dein GitHub-Token auf diesem Mac wird nicht kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece git user.name en “%1$@” y user.email en “%2$@” en la máquina y luego inicia el inicio de sesión de GitHub en tu navegador. Tu token de GitHub de este Mac no se copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit git user.name sur « %1$@ » et user.email sur « %2$@ » sur la machine, puis lance la connexion à GitHub dans votre navigateur. Votre jeton GitHub de ce Mac n’est pas copié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta git user.name su “%1$@” e user.email su “%2$@” sulla macchina, poi avvia l’accesso a GitHub nel tuo browser. Il tuo token GitHub su questo Mac non viene copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンの git user.name を「%1$@」、user.email を「%2$@」に設定し、ブラウザで GitHub へのサインインを開始します。この Mac の GitHub トークンはコピーされません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណត់ git user.name ទៅ “%1$@” និង user.email ទៅ “%2$@” នៅលើម៉ាស៊ីន បន្ទាប់មកចាប់ផ្តើមការចូល GitHub នៅក្នុងកម្មវិធីរុករករបស់អ្នក។ ថូខឹន GitHub របស់អ្នកនៅលើ Mac នេះមិនត្រូវបានចម្លងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신의 git user.name을 “%1$@”(으)로, user.email을 “%2$@”(으)로 설정한 다음 브라우저에서 GitHub 로그인을 시작합니다. 이 Mac의 GitHub 토큰은 복사되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter git user.name til «%1$@» og user.email til «%2$@» på maskinen, og starter deretter GitHub-pålogging i nettleseren din. GitHub-tokenet ditt på denne Macen blir ikke kopiert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia git user.name na „%1$@” i user.email na „%2$@” na maszynie, a następnie rozpoczyna logowanie do GitHub w przeglądarce. Twój token GitHub z tego Maca nie jest kopiowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define git user.name como “%1$@” e user.email como “%2$@” na máquina e depois inicia o login no GitHub no seu navegador. Seu token do GitHub neste Mac não é copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт на машине git user.name «%1$@» и user.email «%2$@», затем начинает вход в GitHub в вашем браузере. Ваш токен GitHub с этого Mac не копируется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่า git user.name เป็น “%1$@” และ user.email เป็น “%2$@” บนเครื่อง แล้วเริ่มลงชื่อเข้าใช้ GitHub ในเบราว์เซอร์ของคุณ โทเค็น GitHub บน Mac เครื่องนี้จะไม่ถูกคัดลอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinede git user.name değerini “%1$@”, user.email değerini “%2$@” yapar, ardından tarayıcınızda GitHub oturum açmayı başlatır. Bu Mac'teki GitHub belirteciniz kopyalanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює на машині git user.name «%1$@» і user.email «%2$@», а потім починає вхід у GitHub у вашому браузері. Ваш токен GitHub з цього Mac не копіюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt git user.name thành “%1$@” và user.email thành “%2$@” trên máy, rồi bắt đầu đăng nhập GitHub trong trình duyệt của bạn. Token GitHub trên máy Mac này không được sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在机器上将 git user.name 设为“%1$@”，user.email 设为“%2$@”，然后在你的浏览器中开始登录 GitHub。此 Mac 上的 GitHub 令牌不会被复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在機器上將 git user.name 設為「%1$@」，user.email 設為「%2$@」，然後在你的瀏覽器中開始登入 GitHub。此 Mac 上的 GitHub 權杖不會被複製。"
          }
        }
      }
    },
    "cloud.github.confirmNoIdentity": {
      "comment": "Confirmation body when this Mac has no global git identity. Keep user.name and user.email untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no global git user.name or user.email, so only GitHub sign-in starts, in your browser. Your GitHub token on this Mac is not copied."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الـMac على git user.name أو user.email عام، لذا يبدأ تسجيل الدخول إلى GitHub فقط، في متصفحك. لا يُنسخ رمز GitHub المميز الموجود على هذا الـMac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac nema globalni git user.name ni user.email, pa se pokreće samo prijava na GitHub, u vašem pregledniku. Vaš GitHub token na ovom Macu se ne kopira."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac har ingen global git user.name eller user.email, så kun GitHub-login starter i din browser. Dit GitHub-token på denne Mac bliver ikke kopieret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat kein globales git user.name oder user.email, daher startet nur die GitHub-Anmeldung in deinem Browser. Dein GitHub-Token auf diesem Mac wird nicht kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene git user.name ni user.email globales, así que solo se inicia el inicio de sesión de GitHub, en tu navegador. Tu token de GitHub de este Mac no se copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’a ni git user.name ni user.email globaux : seule la connexion à GitHub démarre, dans votre navigateur. Votre jeton GitHub de ce Mac n’est pas copié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non ha git user.name né user.email globali, quindi si avvia solo l’accesso a GitHub, nel tuo browser. Il tuo token GitHub su questo Mac non viene copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはグローバルな git user.name と user.email がないため、ブラウザでの GitHub へのサインインのみを開始します。この Mac の GitHub トークンはコピーされません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះមិនមាន git user.name ឬ user.email សកលទេ ដូច្នេះមានតែការចូល GitHub ប៉ុណ្ណោះដែលចាប់ផ្តើម នៅក្នុងកម្មវិធីរុករករបស់អ្នក។ ថូខឹន GitHub របស់អ្នកនៅលើ Mac នេះមិនត្រូវបានចម្លងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 전역 git user.name이나 user.email이 없으므로 브라우저에서 GitHub 로그인만 시작합니다. 이 Mac의 GitHub 토큰은 복사되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen har ingen global git user.name eller user.email, så bare GitHub-pålogging starter, i nettleseren din. GitHub-tokenet ditt på denne Macen blir ikke kopiert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie ma globalnych git user.name ani user.email, więc rozpocznie się tylko logowanie do GitHub w przeglądarce. Twój token GitHub z tego Maca nie jest kopiowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem git user.name nem user.email globais, então só o login no GitHub é iniciado, no seu navegador. Seu token do GitHub neste Mac não é copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac нет глобальных git user.name и user.email, поэтому начнётся только вход в GitHub в вашем браузере. Ваш токен GitHub с этого Mac не копируется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ไม่มี git user.name หรือ user.email ส่วนกลาง จึงเริ่มเฉพาะการลงชื่อเข้าใช้ GitHub ในเบราว์เซอร์ของคุณ โทเค็น GitHub บน Mac เครื่องนี้จะไม่ถูกคัดลอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te genel git user.name veya user.email yok, bu yüzden yalnızca tarayıcınızda GitHub oturum açma başlar. Bu Mac'teki GitHub belirteciniz kopyalanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому Mac немає глобальних git user.name і user.email, тому почнеться лише вхід у GitHub у вашому браузері. Ваш токен GitHub з цього Mac не копіюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này không có git user.name hoặc user.email toàn cục, nên chỉ bắt đầu đăng nhập GitHub, trong trình duyệt của bạn. Token GitHub trên máy Mac này không được sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 没有全局 git user.name 或 user.email，因此只会在你的浏览器中开始登录 GitHub。此 Mac 上的 GitHub 令牌不会被复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 沒有全域 git user.name 或 user.email，因此只會在你的瀏覽器中開始登入 GitHub。此 Mac 上的 GitHub 權杖不會被複製。"
          }
        }
      }
