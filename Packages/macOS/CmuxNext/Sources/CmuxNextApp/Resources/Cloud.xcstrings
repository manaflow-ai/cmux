          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ถามก่อน แล้วนำกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce sor, sonra geri getir"
          }
        },
        "uk": {
