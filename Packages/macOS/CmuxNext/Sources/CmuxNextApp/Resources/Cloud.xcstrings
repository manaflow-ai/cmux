        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть id ключа API через --key <key-id>; `cmux cloud api-key-list --path <publication>` показує id."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền id khóa API bằng --key <key-id>; `cmux cloud api-key-list --path <publication>` liệt kê các id."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 --key <key-id> 传入 API 密钥 id；`cmux cloud api-key-list --path <publication>` 会列出 id。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 --key <key-id> 傳入 API 金鑰 id；`cmux cloud api-key-list --path <publication>` 會列出 id。"
          }
        }
      }
    },
    "cloud.api.keyRevoked": {
      "comment": "Revoke Cloud API Key's answer; %@ is the key id.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoked API key %@. Requests with it are refused from now on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء مفتاح API %@. تُرفض الطلبات التي تستخدمه من الآن فصاعدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "API ključ %@ je opozvan. Zahtjevi s njim se od sada odbijaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøglen %@ er tilbagekaldt. Anmodninger med den afvises fra nu af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel %@ wurde widerrufen. Anfragen damit werden ab jetzt abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó la clave de API %@. A partir de ahora se rechazan las solicitudes que la usen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API %@ révoquée. Les requêtes qui l'utilisent sont désormais refusées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API %@ revocata. Da ora le richieste che la usano vengono rifiutate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キー %@ を取り消しました。今後このキーを使うリクエストは拒否されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានដកហូតសោ API %@។ សំណើដែលប្រើវានឹងត្រូវបដិសេធចាប់ពីពេលនេះតទៅ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키 %@을(를) 취소했습니다. 이제부터 이 키를 사용한 요청은 거부됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøkkelen %@ er tilbakekalt. Forespørsler med den avvises fra nå av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unieważniono klucz API %@. Żądania z nim są od teraz odrzucane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API %@ foi revogada. A partir de agora, as solicitações com ela são recusadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API %@ отозван. Запросы с ним теперь отклоняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิกถอนคีย์ API %@ แล้ว คำขอที่ใช้คีย์นี้จะถูกปฏิเสธนับจากนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API anahtarı iptal edildi. Bundan sonra bu anahtarla gelen istekler reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API %@ відкликано. Відтепер запити з ним відхиляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thu hồi khóa API %@. Từ giờ các yêu cầu dùng khóa này sẽ bị từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤销 API 密钥 %@。从现在起使用它的请求都会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷 API 金鑰 %@。從現在起使用它的請求都會被拒絕。"
          }
        }
      }
    },
    "cloud.cli.repoUnrecognized": {
      "comment": "cmux cloud new-machine --repo: not a GitHub repository. Keep the flag and the example forms as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "--repo takes a GitHub repository: OWNER/NAME, https://github.com/OWNER/NAME or git@github.com:OWNER/NAME.git, with an optional @REF."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo には GitHub リポジトリを指定します: OWNER/NAME、https://github.com/OWNER/NAME、または git@github.com:OWNER/NAME.git（末尾に @REF を付けられます）。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "--repo nimmt ein GitHub-Repository: OWNER/NAME, https://github.com/OWNER/NAME oder git@github.com:OWNER/NAME.git, optional mit @REF."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "--repo attend un dépôt GitHub : OWNER/NAME, https://github.com/OWNER/NAME ou git@github.com:OWNER/NAME.git, avec un @REF facultatif."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "--repo acepta un repositorio de GitHub: OWNER/NAME, https://github.com/OWNER/NAME o git@github.com:OWNER/NAME.git, con un @REF opcional."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يقبل ‎--repo مستودع GitHub: ‏OWNER/NAME أو https://github.com/OWNER/NAME أو git@github.com:OWNER/NAME.git، مع ‎@REF اختياري."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo에는 GitHub 저장소를 지정합니다: OWNER/NAME, https://github.com/OWNER/NAME 또는 git@github.com:OWNER/NAME.git(끝에 @REF를 붙일 수 있음)."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo 需要一个 GitHub 仓库：OWNER/NAME、https://github.com/OWNER/NAME 或 git@github.com:OWNER/NAME.git，可在末尾加 @REF。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo 需要一個 GitHub 儲存庫：OWNER/NAME、https://github.com/OWNER/NAME 或 git@github.com:OWNER/NAME.git，可在結尾加 @REF。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "--repo prima GitHub repozitorij: OWNER/NAME, https://github.com/OWNER/NAME ili git@github.com:OWNER/NAME.git, uz opcionalni @REF."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "--repo tager et GitHub-lager: OWNER/NAME, https://github.com/OWNER/NAME eller git@github.com:OWNER/NAME.git, med et valgfrit @REF."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "--repo accetta un repository GitHub: OWNER/NAME, https://github.com/OWNER/NAME o git@github.com:OWNER/NAME.git, con un @REF facoltativo."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "--repo ទទួលយកឃ្លាំង GitHub៖ OWNER/NAME, https://github.com/OWNER/NAME ឬ git@github.com:OWNER/NAME.git ដោយមាន @REF ជាជម្រើស។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "--repo tar et GitHub-lager: OWNER/NAME, https://github.com/OWNER/NAME eller git@github.com:OWNER/NAME.git, med valgfri @REF."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "--repo przyjmuje repozytorium GitHub: OWNER/NAME, https://github.com/OWNER/NAME lub git@github.com:OWNER/NAME.git, z opcjonalnym @REF."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "--repo aceita um repositório do GitHub: OWNER/NAME, https://github.com/OWNER/NAME ou git@github.com:OWNER/NAME.git, com um @REF opcional."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "--repo принимает репозиторий GitHub: OWNER/NAME, https://github.com/OWNER/NAME или git@github.com:OWNER/NAME.git, с необязательным @REF."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "--repo รับที่เก็บ GitHub: OWNER/NAME, https://github.com/OWNER/NAME หรือ git@github.com:OWNER/NAME.git โดยมี @REF หรือไม่ก็ได้"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo bir GitHub deposu alır: OWNER/NAME, https://github.com/OWNER/NAME veya git@github.com:OWNER/NAME.git, isteğe bağlı @REF ile."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "--repo приймає репозиторій GitHub: OWNER/NAME, https://github.com/OWNER/NAME або git@github.com:OWNER/NAME.git, з необов’язковим @REF."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "--repo nhận một kho GitHub: OWNER/NAME, https://github.com/OWNER/NAME hoặc git@github.com:OWNER/NAME.git, có thể kèm @REF."}}
      }
    },
    "cloud.cli.repoCredentialsInURL": {
      "comment": "cmux cloud new-machine --repo: the URL holds a token or password. Keep the flag as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "--repo carries credentials. Remove them: the machine uses the GitHub access it already has, and no token is written to it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo に認証情報が含まれています。削除してください。マシンは既存の GitHub アクセスを使い、トークンは書き込まれません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "--repo enthält Zugangsdaten. Entferne sie: Die Maschine nutzt ihren vorhandenen GitHub-Zugang, und es wird kein Token auf sie geschrieben."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "--repo contient des identifiants. Retirez-les : la machine utilise l’accès GitHub qu’elle a déjà, et aucun jeton n’y est écrit."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "--repo lleva credenciales. Quítalas: la máquina usa el acceso a GitHub que ya tiene y no se escribe ningún token en ella."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يحتوي ‎--repo على بيانات اعتماد. أزلها: يستخدم الجهاز وصول GitHub المتاح له، ولا يُكتب أي رمز عليه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo에 자격 증명이 들어 있습니다. 제거하세요. 머신은 이미 가진 GitHub 접근을 사용하며 토큰은 기록되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo 中带有凭据。请移除：机器使用它已有的 GitHub 访问权限，不会写入任何令牌。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo 中帶有憑證。請移除：機器使用它已有的 GitHub 存取權限，不會寫入任何權杖。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "--repo sadrži akreditive. Uklonite ih: mašina koristi GitHub pristup koji već ima i na nju se ne upisuje nijedan token."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "--repo indeholder legitimationsoplysninger. Fjern dem: maskinen bruger den GitHub-adgang, den allerede har, og der skrives intet token til den."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "--repo contiene credenziali. Rimuovile: la macchina usa l’accesso GitHub che ha già e non vi viene scritto alcun token."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "--repo មានព័ត៌មានផ្ទៀងផ្ទាត់។ សូមដកវាចេញ៖ ម៉ាស៊ីនប្រើការចូលដំណើរការ GitHub ដែលវាមានរួចហើយ ហើយគ្មាន token ត្រូវបានសរសេរទៅវាទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "--repo inneholder påloggingsinformasjon. Fjern den: maskinen bruker GitHub-tilgangen den allerede har, og ingen token skrives til den."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "--repo zawiera dane logowania. Usuń je: maszyna używa dostępu do GitHuba, który już ma, i nie zapisuje się na niej żaden token."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "--repo contém credenciais. Remova-as: a máquina usa o acesso ao GitHub que já tem, e nenhum token é gravado nela."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "--repo содержит учётные данные. Удалите их: машина использует уже имеющийся доступ к GitHub, и токен на неё не записывается."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "--repo มีข้อมูลรับรอง โปรดลบออก เครื่องจะใช้สิทธิ์เข้าถึง GitHub ที่มีอยู่แล้ว และไม่มีการเขียนโทเค็นลงในเครื่อง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo kimlik bilgisi içeriyor. Bunları kaldırın: makine zaten sahip olduğu GitHub erişimini kullanır ve ona hiçbir belirteç yazılmaz."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "--repo містить облікові дані. Видаліть їх: машина використовує наявний доступ до GitHub, і токен на неї не записується."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "--repo chứa thông tin xác thực. Hãy xóa chúng: máy dùng quyền truy cập GitHub sẵn có và không có token nào được ghi lên máy."}}
      }
    },
    "cloud.cli.repoInvalidRef": {
      "comment": "cmux cloud new-machine --repo OWNER/NAME@REF: REF is not usable. Keep the flag as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The @REF of --repo must be a branch, tag or commit of letters, digits, dots, dashes, underscores and slashes."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--repo の @REF は、英数字、ドット、ハイフン、アンダースコア、スラッシュからなるブランチ、タグ、またはコミットである必要があります。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Das @REF von --repo muss ein Branch, Tag oder Commit aus Buchstaben, Ziffern, Punkten, Bindestrichen, Unterstrichen und Schrägstrichen sein."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Le @REF de --repo doit être une branche, une étiquette ou un commit fait de lettres, chiffres, points, tirets, traits de soulignement et barres obliques."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "El @REF de --repo debe ser una rama, etiqueta o commit de letras, dígitos, puntos, guiones, guiones bajos y barras."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يجب أن يكون ‎@REF في ‎--repo فرعًا أو وسمًا أو إيداعًا من حروف وأرقام ونقاط وشرطات وشرطات سفلية وشرطات مائلة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "--repo의 @REF는 영문자, 숫자, 점, 하이픈, 밑줄, 슬래시로 된 브랜치, 태그 또는 커밋이어야 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "--repo 的 @REF 必须是由字母、数字、点、连字符、下划线和斜杠组成的分支、标签或提交。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "--repo 的 @REF 必須是由字母、數字、點、連字號、底線和斜線組成的分支、標籤或提交。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "@REF za --repo mora biti grana, oznaka ili commit od slova, cifara, tačaka, crtica, donjih crta i kosih crta."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "@REF i --repo skal være en gren, et tag eller et commit af bogstaver, cifre, punktummer, bindestreger, understreger og skråstreger."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il @REF di --repo deve essere un branch, un tag o un commit fatto di lettere, cifre, punti, trattini, trattini bassi e barre."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "@REF របស់ --repo ត្រូវតែជា branch, tag ឬ commit ដែលមានអក្សរ លេខ ចំណុច សញ្ញាដក សញ្ញាគូសក្រោម និងសញ្ញាទ្រេត។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "@REF i --repo må være en gren, en tagg eller en commit av bokstaver, sifre, punktum, bindestreker, understreker og skråstreker."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "@REF w --repo musi być gałęzią, tagiem lub commitem z liter, cyfr, kropek, łączników, podkreśleń i ukośników."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O @REF de --repo deve ser um branch, tag ou commit de letras, dígitos, pontos, hífens, sublinhados e barras."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "@REF в --repo должен быть веткой, тегом или коммитом из букв, цифр, точек, дефисов, подчёркиваний и косых черт."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "@REF ของ --repo ต้องเป็น branch, tag หรือ commit ที่ประกอบด้วยตัวอักษร ตัวเลข จุด ขีด ขีดล่าง และเครื่องหมายทับ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "--repo'nun @REF'i harf, rakam, nokta, tire, alt çizgi ve eğik çizgiden oluşan bir dal, etiket veya commit olmalıdır."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "@REF у --repo має бути гілкою, тегом або комітом із літер, цифр, крапок, дефісів, підкреслень і скісних рисок."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "@REF của --repo phải là một nhánh, thẻ hoặc commit gồm chữ cái, chữ số, dấu chấm, gạch ngang, gạch dưới và dấu gạch chéo."}}
      }
    },
    "cloud.bootstrap.needsGitHub": {
      "comment": "New Cloud Workspace from a repository: the machine's clone needs GitHub access it does not have. %@ is OWNER/NAME.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This machine has no GitHub access to %@, so it couldn't clone it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンには %@ への GitHub アクセスがないため、クローンできませんでした。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Maschine hat keinen GitHub-Zugriff auf %@ und konnte es daher nicht klonen."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette machine n'a pas accès à %@ sur GitHub ; elle n'a donc pas pu le cloner."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Esta máquina no tiene acceso de GitHub a %@, así que no pudo clonarlo."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يملك هذا الجهاز وصولًا إلى ‎%@ على GitHub، لذا تعذّر استنساخه."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신에는 %@에 대한 GitHub 접근 권한이 없어 복제하지 못했습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台机器没有 %@ 的 GitHub 访问权限，因此无法克隆它。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台機器沒有 %@ 的 GitHub 存取權限，因此無法複製它。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ova mašina nema GitHub pristup za %@, pa ga nije mogla klonirati."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne maskine har ingen GitHub-adgang til %@, så den kunne ikke klone det."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa macchina non ha accesso GitHub a %@, quindi non è riuscita a clonarlo."}},
