          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스냅샷 %@이(가) 준비되었습니다. 'Cloud 기기 복원'으로 복원할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
