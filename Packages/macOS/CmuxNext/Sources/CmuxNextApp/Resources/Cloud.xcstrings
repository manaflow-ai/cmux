    "cloud.cli.machineConfigNotApplied": {
      "comment": "cmux cloud deliver-secrets before the machine finished any machine config apply. Keep the command names as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This machine has no finished machine config yet. Run cmux cloud apply-machine-config first, then deliver the secrets."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンにはまだ完了したマシン構成がありません。先に cmux cloud apply-machine-config を実行してから、シークレットを配信してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Maschine hat noch keine abgeschlossene Maschinenkonfiguration. Führe zuerst cmux cloud apply-machine-config aus und übermittle dann die Geheimnisse."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette machine n’a pas encore de configuration de machine terminée. Lancez d’abord cmux cloud apply-machine-config, puis transmettez les secrets."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Esta máquina aún no tiene una configuración de máquina terminada. Ejecuta primero cmux cloud apply-machine-config y luego entrega los secretos."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "ليس لهذا الجهاز إعداد جهاز مكتمل بعد. شغّل cmux cloud apply-machine-config أولًا، ثم سلّم الأسرار."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신에는 아직 완료된 머신 구성이 없습니다. 먼저 cmux cloud apply-machine-config를 실행한 다음 비밀을 전달하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台机器还没有完成的机器配置。请先运行 cmux cloud apply-machine-config，再送达机密。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台機器還沒有完成的機器設定。請先執行 cmux cloud apply-machine-config，再送達機密。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ova mašina još nema završenu konfiguraciju. Prvo pokrenite cmux cloud apply-machine-config, a zatim isporučite tajne."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne maskine har endnu ingen færdig maskinkonfiguration. Kør først cmux cloud apply-machine-config, og lever derefter hemmelighederne."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa macchina non ha ancora una configurazione completata. Esegui prima cmux cloud apply-machine-config, poi consegna i segreti."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីននេះមិនទាន់មានការកំណត់ម៉ាស៊ីនដែលបានបញ្ចប់ទេ។ ដំណើរការ cmux cloud apply-machine-config ជាមុនសិន រួចបញ្ជូនអាថ៌កំបាំង។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne maskinen har ingen ferdig maskinkonfigurasjon ennå. Kjør cmux cloud apply-machine-config først, og lever deretter hemmelighetene."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ta maszyna nie ma jeszcze zakończonej konfiguracji. Najpierw uruchom cmux cloud apply-machine-config, a potem dostarcz sekrety."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Esta máquina ainda não tem uma configuração concluída. Execute primeiro cmux cloud apply-machine-config e depois entregue os segredos."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "У этой машины ещё нет завершённой конфигурации. Сначала выполните cmux cloud apply-machine-config, затем доставьте секреты."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่องนี้ยังไม่มีการกำหนดค่าเครื่องที่เสร็จสมบูรณ์ เรียกใช้ cmux cloud apply-machine-config ก่อน แล้วจึงส่งความลับ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makinenin henüz tamamlanmış bir makine yapılandırması yok. Önce cmux cloud apply-machine-config çalıştırın, ardından sırları teslim edin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ця машина ще не має завершеної конфігурації. Спочатку виконайте cmux cloud apply-machine-config, а потім доставте секрети."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy này chưa có cấu hình máy hoàn tất. Hãy chạy cmux cloud apply-machine-config trước, rồi gửi bí mật."}}
      }
    },
    "cloud.cli.secretsDeliveryRunning": {
      "comment": "cmux cloud deliver-secrets while another delivery to the same machine is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Secrets are already being delivered to this machine. Try again when that delivery finishes."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンにはすでにシークレットを配信中です。その配信が終わってから再試行してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "An diese Maschine werden bereits Geheimnisse übermittelt. Versuche es erneut, wenn diese Übermittlung fertig ist."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Des secrets sont déjà en cours de transmission à cette machine. Réessayez une fois cette transmission terminée."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Ya se están entregando secretos a esta máquina. Vuelve a intentarlo cuando termine esa entrega."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يجري بالفعل تسليم أسرار إلى هذا الجهاز. أعد المحاولة عند انتهاء ذلك التسليم."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신에 이미 비밀을 전달하는 중입니다. 그 전달이 끝나면 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "正在向这台机器送达机密。请在该次送达完成后重试。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "正在向這台機器送達機密。請在該次送達完成後重試。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Tajne se već isporučuju ovoj mašini. Pokušajte ponovo kada ta isporuka završi."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Der leveres allerede hemmeligheder til denne maskine. Prøv igen, når den levering er færdig."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Sono già in consegna dei segreti a questa macchina. Riprova al termine di quella consegna."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "កំពុងបញ្ជូនអាថ៌កំបាំងទៅម៉ាស៊ីននេះរួចហើយ។ សូមព្យាយាមម្ដងទៀតនៅពេលការបញ្ជូននោះបញ្ចប់។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Hemmeligheter leveres allerede til denne maskinen. Prøv igjen når den leveringen er ferdig."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Sekrety są już dostarczane do tej maszyny. Spróbuj ponownie, gdy to dostarczanie się zakończy."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Já há segredos sendo entregues a esta máquina. Tente de novo quando essa entrega terminar."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "На эту машину уже доставляются секреты. Повторите попытку, когда эта доставка завершится."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "กำลังส่งความลับไปยังเครื่องนี้อยู่แล้ว ลองอีกครั้งเมื่อการส่งนั้นเสร็จ"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makineye zaten sır teslim ediliyor. O teslim bittiğinde yeniden deneyin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "На цю машину вже доставляються секрети. Спробуйте ще раз, коли ця доставка завершиться."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Bí mật đang được gửi tới máy này. Hãy thử lại khi lần gửi đó hoàn tất."}}
      }
    },
    "cloud.cli.secretRepoNeeded": {
      "comment": "cmux cloud deliver-secrets without --repo, on a machine set up from a repository that has its own secret values. Both %@ are the repository (OWNER/NAME). Keep --repo as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This machine was set up from %1$@, which has its own secret values on this Mac. Pass --repo %2$@ to deliver them."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このマシンは %1$@ からセットアップされており、この Mac にはそのリポジトリ用のシークレット値があります。配信するには --repo %2$@ を指定してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Diese Maschine wurde aus %1$@ eingerichtet, für das es auf diesem Mac eigene Geheimniswerte gibt. Gib --repo %2$@ an, um sie zu übermitteln."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Cette machine a été configurée à partir de %1$@, qui a ses propres valeurs secrètes sur ce Mac. Passez --repo %2$@ pour les transmettre."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Esta máquina se configuró a partir de %1$@, que tiene sus propios valores secretos en este Mac. Pasa --repo %2$@ para entregarlos."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "أُعدّ هذا الجهاز من %1$@، وله قيم أسرار خاصة به على جهاز Mac هذا. مرّر ‎--repo %2$@ لتسليمها."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 머신은 %1$@에서 설정되었으며, 이 Mac에 해당 저장소 전용 비밀 값이 있습니다. 전달하려면 --repo %2$@을(를) 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台机器是从 %1$@ 设置的，这台 Mac 上有它专属的机密值。请传入 --repo %2$@ 来送达它们。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台機器是從 %1$@ 設定的，這台 Mac 上有它專屬的機密值。請傳入 --repo %2$@ 來送達它們。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ova mašina je postavljena iz %1$@, koji ima vlastite tajne vrijednosti na ovom Macu. Proslijedite --repo %2$@ da ih isporučite."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne maskine blev sat op fra %1$@, som har sine egne hemmelige værdier på denne Mac. Angiv --repo %2$@ for at levere dem."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questa macchina è stata configurata da %1$@, che ha valori segreti propri su questo Mac. Passa --repo %2$@ per consegnarli."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ម៉ាស៊ីននេះត្រូវបានរៀបចំពី %1$@ ដែលមានតម្លៃអាថ៌កំបាំងផ្ទាល់ខ្លួននៅលើ Mac នេះ។ ផ្ដល់ --repo %2$@ ដើម្បីបញ្ជូនវា។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne maskinen ble satt opp fra %1$@, som har egne hemmelige verdier på denne Macen. Angi --repo %2$@ for å levere dem."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ta maszyna została skonfigurowana z %1$@, które ma własne wartości sekretów na tym Macu. Podaj --repo %2$@, aby je dostarczyć."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Esta máquina foi configurada a partir de %1$@, que tem valores secretos próprios neste Mac. Passe --repo %2$@ para entregá-los."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Эта машина настроена из %1$@, у которого на этом Mac есть свои значения секретов. Укажите --repo %2$@, чтобы доставить их."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "เครื่องนี้ตั้งค่าจาก %1$@ ซึ่งมีค่าความลับของตัวเองบน Mac เครื่องนี้ ระบุ --repo %2$@ เพื่อส่งค่าเหล่านั้น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu makine, bu Mac'te kendi sır değerleri olan %1$@ deposundan kuruldu. Bunları teslim etmek için --repo %2$@ verin."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Цю машину налаштовано з %1$@, для якого на цьому Mac є власні значення секретів. Укажіть --repo %2$@, щоб доставити їх."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy này được thiết lập từ %1$@, kho có giá trị bí mật riêng trên máy Mac này. Hãy truyền --repo %2$@ để gửi chúng."}}
      }
    },
    "cloud.cli.secretIndexUnreadable": {
      "comment": "cmux cloud deliver-secrets: the local secrets index exists but cannot be read. %@ is its path. Keep the command as written.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Can't read %@, so nothing was delivered. Fix or remove it, then store the secrets again with cmux cloud secret set."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ を読み取れないため、何も配信しませんでした。修正するか削除してから、cmux cloud secret set でシークレットをもう一度保存してください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "%@ kann nicht gelesen werden, daher wurde nichts übermittelt. Repariere oder entferne die Datei und speichere die Geheimnisse dann mit cmux cloud secret set erneut."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Impossible de lire %@, rien n’a donc été transmis. Réparez-le ou supprimez-le, puis enregistrez à nouveau les secrets avec cmux cloud secret set."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "No se puede leer %@, así que no se entregó nada. Corrígelo o elimínalo y vuelve a guardar los secretos con cmux cloud secret set."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تعذّرت قراءة %@، لذا لم يُسلَّم شيء. أصلحه أو احذفه، ثم خزّن الأسرار مرة أخرى باستخدام cmux cloud secret set."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "%@을(를) 읽을 수 없어 아무것도 전달하지 않았습니다. 고치거나 삭제한 다음 cmux cloud secret set으로 비밀을 다시 저장하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "无法读取 %@，因此未送达任何内容。请修复或删除它，然后用 cmux cloud secret set 重新保存机密。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "無法讀取 %@，因此未送達任何內容。請修復或刪除它，然後用 cmux cloud secret set 重新儲存機密。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "%@ se ne može pročitati, pa ništa nije isporučeno. Popravite ga ili uklonite, a zatim ponovo sačuvajte tajne pomoću cmux cloud secret set."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "%@ kan ikke læses, så intet blev leveret. Ret eller fjern den, og gem derefter hemmelighederne igen med cmux cloud secret set."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Impossibile leggere %@, quindi non è stato consegnato nulla. Correggilo o rimuovilo, poi salva di nuovo i segreti con cmux cloud secret set."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "មិនអាចអាន %@ បានទេ ដូច្នេះគ្មានអ្វីត្រូវបានបញ្ជូនទេ។ ជួសជុល ឬលុបវា រួចរក្សាទុកអាថ៌កំបាំងម្ដងទៀតដោយ cmux cloud secret set។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Kan ikke lese %@, så ingenting ble levert. Reparer eller fjern den, og lagre deretter hemmelighetene på nytt med cmux cloud secret set."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Nie można odczytać %@, więc nic nie dostarczono. Napraw lub usuń plik, a potem zapisz sekrety ponownie poleceniem cmux cloud secret set."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Não é possível ler %@, então nada foi entregue. Corrija ou remova o arquivo e armazene os segredos de novo com cmux cloud secret set."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Не удаётся прочитать %@, поэтому ничего не доставлено. Исправьте или удалите файл, затем снова сохраните секреты командой cmux cloud secret set."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "อ่าน %@ ไม่ได้ จึงไม่ได้ส่งอะไรเลย แก้ไขหรือลบไฟล์นี้ แล้วจัดเก็บความลับอีกครั้งด้วย cmux cloud secret set"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "%@ okunamıyor, bu yüzden hiçbir şey teslim edilmedi. Düzeltin veya kaldırın, ardından sırları cmux cloud secret set ile yeniden saklayın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Не вдається прочитати %@, тому нічого не доставлено. Виправте або видаліть файл, потім знову збережіть секрети командою cmux cloud secret set."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Không thể đọc %@ nên chưa gửi gì. Hãy sửa hoặc xóa tệp, rồi lưu lại bí mật bằng cmux cloud secret set."}}
      }
    }
  },
  "version": "1.0"
}
