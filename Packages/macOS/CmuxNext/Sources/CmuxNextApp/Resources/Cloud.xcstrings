    "cloud.progress.failed": {
      "comment": "The sidebar progress card of a Cloud machine that failed to start; %@ is why (last, after “Reason:”). Retry and Copy Error are the card's buttons.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud machine did not start. Click Retry; Copy Error copies the details. Reason: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud マシンを起動できませんでした。［再試行］をクリックしてください。［エラーをコピー］で詳細をコピーできます。理由: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ الجهاز السحابي. انقر على إعادة المحاولة؛ ينسخ «نسخ الخطأ» التفاصيل. السبب: %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašina u oblaku se nije pokrenula. Kliknite Pokušaj ponovo; Kopiraj grešku kopira detalje. Razlog: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-maskinen startede ikke. Klik på Prøv igen. Kopiér fejl kopierer detaljerne. Årsag: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Maschine ist nicht gestartet. Klicke auf „Erneut versuchen“; „Fehler kopieren“ kopiert die Details. Grund: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina en la nube no se inició. Haz clic en Reintentar; Copiar error copia los detalles. Motivo: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine cloud n’a pas démarré. Cliquez sur Réessayer ; Copier l’erreur copie les détails. Raison : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina cloud non si è avviata. Fai clic su Riprova; Copia errore copia i dettagli. Motivo: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីនពពកមិនបានចាប់ផ្ដើម។ ចុច ព្យាយាមម្ដងទៀត។ ចម្លងកំហុស នឹងចម្លងព័ត៌មានលម្អិត។ មូលហេតុ៖ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 머신을 시작하지 못했습니다. 다시 시도를 클릭하세요. 오류 복사로 세부 정보를 복사할 수 있습니다. 이유: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skymaskinen startet ikke. Klikk Prøv igjen. Kopier feil kopierer detaljene. Årsak: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna w chmurze nie uruchomiła się. Kliknij Ponów; Kopiuj błąd kopiuje szczegóły. Powód: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina na nuvem não iniciou. Clique em Tentar novamente; Copiar erro copia os detalhes. Motivo: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачная машина не запустилась. Нажмите «Повторить»; «Скопировать ошибку» копирует подробности. Причина: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องคลาวด์ไม่เริ่มทำงาน คลิกลองอีกครั้ง ส่วนคัดลอกข้อผิดพลาดจะคัดลอกรายละเอียด สาเหตุ: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut makinesi başlamadı. Yeniden dene'ye tıklayın; Hatayı kopyala ayrıntıları kopyalar. Neden: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хмарна машина не запустилася. Натисніть «Повторити»; «Скопіювати помилку» копіює подробиці. Причина: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Cloud không khởi động được. Bấm Thử lại; Sao chép lỗi sẽ sao chép chi tiết. Lý do: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云机器未能启动。点按“重试”；“复制错误”会复制详细信息。原因：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端機器未能啟動。按一下「重試」；「拷貝錯誤」會拷貝詳細資訊。原因：%@"
          }
        }
      }
    },
