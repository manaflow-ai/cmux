          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zurückholen wurde nicht abgeschlossen, daher ist der Chat pausiert. Versuche es erneut, um es abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El regreso no terminó, así que el chat está en pausa. Vuelve a intentarlo para terminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour n’est pas terminé, la discussion est donc en pause. Réessayez pour le terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ritorno non è terminato, quindi la chat è in pausa. Riprova per completarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻す処理が完了しなかったため、チャットは一時停止しています。再試行して完了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនាំត្រឡប់មកវិញមិនទាន់បញ្ចប់ ដូច្នេះការជជែកត្រូវបានផ្អាក។ ព្យាយាមម្តងទៀតដើម្បីបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 가져오기가 끝나지 않아 채팅이 일시 중지되었습니다. 다시 시도하여 완료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttingen tilbake ble ikke fullført, så chatten er satt på pause. Prøv igjen for å fullføre den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie się nie zakończyło, więc czat jest wstrzymany. Ponów, aby je dokończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O retorno não terminou, então o chat está pausado. Tente novamente para concluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возврат не завершился, поэтому чат приостановлен. Повторите, чтобы завершить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำกลับยังไม่เสร็จ แชทจึงถูกหยุดชั่วคราว ลองอีกครั้งเพื่อให้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri getirme bitmedi, bu yüzden sohbet duraklatıldı. Tamamlamak için yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернення не завершилося, тому чат призупинено. Повторіть, щоб завершити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc đưa về chưa hoàn tất nên cuộc trò chuyện đang tạm dừng. Hãy thử lại để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带回尚未完成，因此对话已暂停。请重试以完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶回尚未完成，因此對話已暫停。請重試以完成。"
          }
        }
      }
    },
