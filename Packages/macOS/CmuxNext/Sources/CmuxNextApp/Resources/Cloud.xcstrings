    "cloud.api.provisioned": {
      "comment": "Provision API's answer. %1$@ is the https URL, %2$@ the API key, %3$@ the cookie (__Host-cmux-api-key=<key>). Keep the curl command, 'Cookie:' and the placeholders as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI key (shown once, keep it secret): %2$@\nClients send the key as a cookie, for example: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان: %1$@\nمفتاح API (يظهر مرة واحدة، احتفظ به سرًا): %2$@\nترسل العملاء المفتاح كملف تعريف ارتباط، مثلًا: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI ključ (prikazuje se jednom, čuvajte ga u tajnosti): %2$@\nKlijenti šalju ključ kao kolačić, na primjer: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI-nøgle (vises én gang, hold den hemmelig): %2$@\nKlienter sender nøglen som en cookie, for eksempel: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI-Schlüssel (wird nur einmal angezeigt, geheim halten): %2$@\nClients senden den Schlüssel als Cookie, zum Beispiel: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nClave de API (se muestra una vez, mantenla en secreto): %2$@\nLos clientes envían la clave como cookie, por ejemplo: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL : %1$@\nClé API (affichée une seule fois, gardez-la secrète) : %2$@\nLes clients envoient la clé dans un cookie, par exemple : curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nChiave API (mostrata una sola volta, tienila segreta): %2$@\nI client inviano la chiave come cookie, ad esempio: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI キー（一度だけ表示されます。秘密にしてください）: %2$@\nクライアントはキーを Cookie として送信します。例: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "URL៖ %1$@\nសោ API (បង្ហាញតែម្ដង សូមរក្សាជាការសម្ងាត់)៖ %2$@\nកម្មវិធីភ្ញៀវផ្ញើសោជា cookie ឧទាហរណ៍៖ curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI 키(한 번만 표시되니 비밀로 유지하세요): %2$@\n클라이언트는 키를 쿠키로 보냅니다. 예: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI-nøkkel (vises én gang, hold den hemmelig): %2$@\nKlienter sender nøkkelen som en informasjonskapsel, for eksempel: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nKlucz API (wyświetlany raz, zachowaj go w tajemnicy): %2$@\nKlienci wysyłają klucz jako plik cookie, na przykład: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nChave de API (exibida uma vez, mantenha em segredo): %2$@\nOs clientes enviam a chave como cookie, por exemplo: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nКлюч API (показывается один раз, храните его в секрете): %2$@\nКлиенты передают ключ в cookie, например: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nคีย์ API (แสดงเพียงครั้งเดียว โปรดเก็บเป็นความลับ): %2$@\nไคลเอนต์ส่งคีย์เป็นคุกกี้ เช่น: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nAPI anahtarı (yalnızca bir kez gösterilir, gizli tutun): %2$@\nİstemciler anahtarı çerez olarak gönderir, örneğin: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nКлюч API (показується один раз, тримайте його в таємниці): %2$@\nКлієнти передають ключ у cookie, наприклад: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL: %1$@\nKhóa API (chỉ hiển thị một lần, hãy giữ bí mật): %2$@\nỨng dụng khách gửi khóa dưới dạng cookie, ví dụ: curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL：%1$@\nAPI 密钥（仅显示一次，请妥善保密）：%2$@\n客户端以 Cookie 发送密钥，例如：curl -H 'Cookie: %3$@' %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "URL：%1$@\nAPI 金鑰（只顯示一次，請妥善保密）：%2$@\n用戶端以 Cookie 傳送金鑰，例如：curl -H 'Cookie: %3$@' %1$@"
          }
        }
      }
    },
    "cloud.api.publicationRequired": {
      "comment": "An API key action ran without a publication. --path <publication> is the CLI flag and `cmux cloud publication-list` a command; keep both as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the publication id or hostname with --path <publication>; `cmux cloud publication-list` lists them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر معرّف النشر أو اسم المضيف باستخدام --path <publication>؛ يعرضها `cmux cloud publication-list`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proslijedite id objave ili ime hosta pomoću --path <publication>; `cmux cloud publication-list` ih prikazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv publiceringens id eller værtsnavn med --path <publication>; `cmux cloud publication-list` viser dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die ID oder den Hostnamen der Veröffentlichung mit --path <publication> an; `cmux cloud publication-list` listet sie auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el id o el nombre de host de la publicación con --path <publication>; `cmux cloud publication-list` los muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l'identifiant ou le nom d'hôte de la publication avec --path <publication> ; `cmux cloud publication-list` les affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa l'id o il nome host della pubblicazione con --path <publication>; `cmux cloud publication-list` li elenca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開の ID またはホスト名を --path <publication> で指定してください。`cmux cloud publication-list` で一覧を確認できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូន id ឬឈ្មោះម៉ាស៊ីនរបស់ការបោះពុម្ពផ្សាយ ជាមួយ --path <publication>; `cmux cloud publication-list` បង្ហាញពួកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--path <publication>으로 게시 ID나 호스트 이름을 전달하세요. `cmux cloud publication-list`에서 목록을 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi publiseringens id eller vertsnavn med --path <publication>; `cmux cloud publication-list` viser dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj id lub nazwę hosta publikacji za pomocą --path <publication>; `cmux cloud publication-list` je wyświetla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o id ou o nome do host da publicação com --path <publication>; `cmux cloud publication-list` lista esses valores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите id или имя хоста публикации через --path <publication>; `cmux cloud publication-list` выводит их список."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุ id หรือชื่อโฮสต์ของการเผยแพร่ด้วย --path <publication>; `cmux cloud publication-list` จะแสดงรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın kimliğini veya ana bilgisayar adını --path <publication> ile verin; `cmux cloud publication-list` bunları listeler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть id або ім'я хоста публікації через --path <publication>; `cmux cloud publication-list` показує їх список."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền id hoặc tên máy chủ của bản xuất bản bằng --path <publication>; `cmux cloud publication-list` liệt kê chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 --path <publication> 传入发布的 id 或主机名；`cmux cloud publication-list` 会列出它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 --path <publication> 傳入發布的 id 或主機名稱；`cmux cloud publication-list` 會列出它們。"
          }
        }
      }
    },
    "cloud.api.keyRequired": {
      "comment": "Revoke Cloud API Key ran without a key id. --key <key-id>, --path <publication> and `cmux cloud api-key-list` are CLI text; keep them as they are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass the API key id with --key <key-id>; `cmux cloud api-key-list --path <publication>` lists ids."
          }
        },
