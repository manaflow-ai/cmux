    "cloud.moveAsk.notInChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an agent in a chat on this Mac can ask to move it to Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن طلب نقل محادثة إلى Cloud إلا من وكيل في محادثة على هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo agent u razgovoru na ovom Macu može tražiti da se on premjesti u Cloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en agent i en chat på denne Mac kan bede om at flytte den til Cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Agent in einem Chat auf diesem Mac kann darum bitten, ihn in die Cloud zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un agente en un chat de este Mac puede pedir moverlo a Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un agent dans un chat sur ce Mac peut demander à le déplacer vers Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un agente in una chat su questo Mac può chiedere di spostarla su Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud への移動を求められるのは、この Mac 上のチャットのエージェントだけです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែភ្នាក់ងារក្នុងការជជែកនៅលើ Mac នេះទេ ដែលអាចសុំផ្លាស់ទីវាទៅ Cloud។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 채팅에 있는 에이전트만 그 채팅을 Cloud로 옮기도록 요청할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en agent i en chat på denne Macen kan be om å flytte den til Cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko agent w czacie na tym Macu może poprosić o przeniesienie go do Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um agente em um chat neste Mac pode pedir para movê-lo para o Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросить перенести чат в Cloud может только агент в чате на этом Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงเอเจนต์ในแชทบน Mac เครื่องนี้เท่านั้นที่ขอย้ายแชทไปที่ Cloud ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu Mac'teki bir sohbetteki ajan onu Cloud'a taşımayı isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросити перенести чат у Cloud може лише агент у чаті на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tác tử trong một cuộc trò chuyện trên máy Mac này mới có thể yêu cầu chuyển nó lên Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此 Mac 上对话中的智能体才能请求将该对话移到 Cloud。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此 Mac 上對話中的代理程式才能請求將該對話移到 Cloud。"
          }
        }
      }
    },
    "cloud.moveAsk.onlyOwnChat": {
