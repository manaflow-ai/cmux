        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายโดยไม่ถามทุกครั้งที่เอเจนต์ใน %@ ขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki bir ajan istediğinde sormadan taşı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносити без запитання, коли про це просить агент у %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển mà không hỏi mỗi khi tác tử trong %@ yêu cầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 %@ 中的智能体请求时，不再询问直接移动"
          }
