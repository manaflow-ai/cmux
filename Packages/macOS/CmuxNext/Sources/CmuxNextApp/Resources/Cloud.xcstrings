          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør først, og hent tilbake"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw pytaj, potem przywróć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar antes e trazer de volta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
