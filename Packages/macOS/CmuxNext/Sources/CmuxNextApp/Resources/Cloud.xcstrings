    "cloud.github.enterCode": {
      "comment": "Toast after the machine started GitHub's device sign-in; %@ is the one-time code (like ABCD-1234). Keep github.com/login/device as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter code %@ at github.com/login/device to finish. The code is copied."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز %@ في github.com/login/device لإكمال العملية. تم نسخ الرمز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite kod %@ na github.com/login/device da završite. Kod je kopiran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast koden %@ på github.com/login/device for at afslutte. Koden er kopieret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code %@ auf github.com/login/device ein, um abzuschließen. Der Code ist kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código %@ en github.com/login/device para terminar. El código está copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code %@ sur github.com/login/device pour terminer. Le code est copié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice %@ su github.com/login/device per completare. Il codice è stato copiato."
