    "cloud.machineUpdate.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build of cmux can't update %@. A release build can."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا الإصدار من cmux تحديث %@. يمكن ذلك لإصدار رسمي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija cmux-a ne može ažurirati %@. Izdana verzija može."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne udgave af cmux kan ikke opdatere %@. En udgivet version kan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser cmux-Build kann %@ nicht aktualisieren. Ein Release-Build kann es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación de cmux no puede actualizar %@. Una versión publicada sí puede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de cmux ne peut pas mettre à jour %@. Une version publiée le peut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa build di cmux non può aggiornare %@. Una build di rilascio può farlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この cmux ビルドでは %@ をアップデートできません。リリースビルドならできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែ cmux នេះមិនអាចធ្វើបច្ចុប្បន្នភាព %@ បានទេ។ កំណែចេញផ្សាយអាចធ្វើបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 cmux 빌드는 %@을(를) 업데이트할 수 없습니다. 릴리스 빌드는 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen av cmux kan ikke oppdatere %@. En utgitt versjon kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kompilacja cmux nie może zaktualizować %@. Wersja wydana może."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do cmux não pode atualizar %@. Uma versão publicada pode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка cmux не может обновить %@. Релизная сборка может."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลด์ cmux นี้อัปเดต %@ ไม่ได้ บิลด์รุ่นเผยแพร่ทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cmux derlemesi %@ makinesini güncelleyemez. Yayın derlemesi güncelleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка cmux не може оновити %@. Релізна збірка може."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng cmux này không thể cập nhật %@. Bản phát hành thì có thể."
          }
        },
        "zh-Hans": {
