    "cloud.progress.next.pausedIdle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud paused this machine after it sat idle. Its disk and session are kept. Resume starts it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンはアイドル状態が続いたため、cmux Cloud が一時停止しました。ディスクとセッションは保持されています。「再開」で再び起動します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف cmux Cloud هذا الجهاز مؤقتًا بعد أن ظل خاملًا. يتم الاحتفاظ بقرصه وجلسته. يؤدي الاستئناف إلى تشغيله مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud je pauzirao ovu mašinu nakon što je bila neaktivna. Njen disk i sesija su sačuvani. Nastavi je ponovo pokreće."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud satte denne maskine på pause, efter at den havde været inaktiv. Dens disk og session bevares. Genoptag starter den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud hat diese Maschine pausiert, nachdem sie inaktiv war. Ihre Festplatte und Sitzung bleiben erhalten. „Fortsetzen“ startet sie wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud pausó esta máquina tras un tiempo inactiva. Se conservan su disco y su sesión. Reanudar la vuelve a iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud a mis cette machine en pause après une période d’inactivité. Son disque et sa session sont conservés. Reprendre la redémarre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ha messo in pausa questa macchina dopo un periodo di inattività. Il disco e la sessione sono conservati. Riprendi la avvia di nuovo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud បានផ្អាកម៉ាស៊ីននេះ បន្ទាប់ពីវាទំនេរ។ ថាស និងវគ្គរបស់វាត្រូវបានរក្សាទុក។ បន្ត នឹងចាប់ផ្ដើមវាម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신이 유휴 상태여서 cmux Cloud가 일시 정지했습니다. 디스크와 세션은 유지됩니다. 재개하면 다시 시작됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud satte denne maskinen på pause etter at den var inaktiv. Disken og økten beholdes. Gjenoppta starter den igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud wstrzymał tę maszynę po okresie bezczynności. Jej dysk i sesja są zachowane. Wznów uruchamia ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux Cloud pausou esta máquina depois que ela ficou ociosa. O disco e a sessão dela são mantidos. Retomar a inicia novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud приостановил эту машину после простоя. Её диск и сеанс сохранены. «Возобновить» снова запускает её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud หยุดเครื่องนี้ชั่วคราวหลังจากไม่มีการใช้งาน ดิสก์และเซสชันของเครื่องยังคงอยู่ ดำเนินการต่อจะเริ่มเครื่องอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud bu makineyi boşta kaldıktan sonra duraklattı. Diski ve oturumu korunur. Sürdür onu yeniden başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud призупинив цю машину після простою. Її диск і сеанс збережено. «Відновити» знову запускає її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud đã tạm dừng máy này sau khi nó không hoạt động. Ổ đĩa và phiên của máy được giữ lại. Tiếp tục sẽ khởi động lại máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该机器空闲一段时间后，cmux Cloud 已将其暂停。它的磁盘和会话均已保留。点按“恢复”可再次启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此機器閒置一段時間後，cmux Cloud 已將其暫停。它的磁碟和工作階段均已保留。按一下「繼續」即可再次啟動。"
          }
        }
      }
    },
