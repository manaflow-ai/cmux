    "cloud.progress.next.creating": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud is creating the VM. A new machine usually takes under a minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud が VM を作成しています。新しいマシンは通常 1 分以内に作成されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشئ cmux Cloud الجهاز الافتراضي. يستغرق الجهاز الجديد عادةً أقل من دقيقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud kreira VM. Nova mašina obično traje manje od minute."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud opretter VM’en. En ny maskine tager normalt under et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud erstellt die VM. Eine neue Maschine dauert meist weniger als eine Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud está creando la VM. Una máquina nueva suele tardar menos de un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud crée la VM. Une nouvelle machine prend en général moins d’une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sta creando la VM. Una nuova macchina di solito richiede meno di un minuto."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud កំពុងបង្កើត VM។ ម៉ាស៊ីនថ្មីជាធម្មតាចំណាយពេលតិចជាងមួយនាទី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 VM을 만드는 중입니다. 새 머신은 보통 1분 이내에 준비됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud oppretter VM-en. En ny maskin tar vanligvis under ett minutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud tworzy maszynę wirtualną. Nowa maszyna zwykle zajmuje mniej niż minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux Cloud está criando a VM. Uma máquina nova costuma levar menos de um minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud создаёт ВМ. Новая машина обычно готова меньше чем за минуту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud กำลังสร้าง VM โดยปกติเครื่องใหม่ใช้เวลาไม่ถึงหนึ่งนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud VM’yi oluşturuyor. Yeni bir makine genellikle bir dakikadan kısa sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud створює ВМ. Нова машина зазвичай готова менш ніж за хвилину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud đang tạo VM. Máy mới thường mất chưa đến một phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在创建虚拟机。新机器通常不到一分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在建立虛擬機器。新機器通常不到一分鐘。"
          }
        }
      }
    },
    "cloud.progress.next.booting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VM exists. This Mac is opening a link to it and waits for its cmux-tui to answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VM は作成済みです。この Mac が VM へのリンクを開き、cmux-tui の応答を待っています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز الافتراضي موجود. يفتح هذا الـ Mac رابطًا إليه وينتظر استجابة cmux-tui عليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "VM postoji. Ovaj Mac otvara vezu prema njemu i čeka da cmux-tui odgovori."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VM’en findes. Denne Mac åbner en forbindelse til den og venter på svar fra dens cmux-tui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die VM existiert. Dieser Mac öffnet eine Verbindung zu ihr und wartet auf die Antwort ihres cmux-tui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La VM ya existe. Este Mac abre un enlace con ella y espera la respuesta de su cmux-tui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La VM existe. Ce Mac ouvre une liaison vers elle et attend la réponse de son cmux-tui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La VM esiste. Questo Mac apre un collegamento e attende la risposta del suo cmux-tui."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "VM មានហើយ។ Mac នេះកំពុងបើកតំណទៅវា ហើយរង់ចាំ cmux-tui របស់វាឆ្លើយតប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VM이 만들어졌습니다. 이 Mac이 VM에 연결을 열고 cmux-tui의 응답을 기다리는 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VM-en finnes. Denne Macen åpner en kobling til den og venter på svar fra cmux-tui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna wirtualna istnieje. Ten Mac otwiera połączenie i czeka na odpowiedź jej cmux-tui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A VM já existe. Este Mac está abrindo um link para ela e aguarda a resposta do cmux-tui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВМ создана. Этот Mac открывает к ней канал и ждёт ответа её cmux-tui."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VM พร้อมแล้ว Mac เครื่องนี้กำลังเปิดลิงก์ไปยัง VM และรอให้ cmux-tui ตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VM oluşturuldu. Bu Mac ona bir bağlantı açıyor ve cmux-tui’nin yanıtını bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ВМ створено. Цей Mac відкриває до неї канал і чекає на відповідь її cmux-tui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VM đã có. Máy Mac này đang mở liên kết đến VM và chờ cmux-tui của nó phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟机已创建。此 Mac 正在打开到它的连接，等待其 cmux-tui 响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬機器已建立。這台 Mac 正在開啟連線，等待其 cmux-tui 回應。"
          }
        }
      }
    },
    "cloud.progress.next.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is up. Loading the machine’s workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクが確立しました。マシンのワークスペースを読み込んでいます。"
          }
        },
        "ar": {
          "stringUnit": {
