            "value": "Configurer GitHub sur %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurare GitHub su %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で GitHub を設定しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រៀបចំ GitHub នៅលើ %@ ឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 GitHub를 설정할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette opp GitHub på %@?"
          }
        },
        "pl": {
          "stringUnit": {
