    "cloud.bringBack.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files changed both here and on Cloud, so nothing came back: %@. Settle them, then Retry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت هذه الملفات هنا وعلى Cloud معًا، لذا لم يُعَد أي شيء: %@. سوِّها ثم أعد المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove datoteke su se promijenile i ovdje i na Cloudu, pa ništa nije vraćeno: %@. Usaglasi ih, pa pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filer er ændret både her og på Cloud, så intet blev hentet tilbage: %@. Afklar dem, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien wurden hier und in der Cloud geändert, daher kam nichts zurück: %@. Kläre sie und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos cambiaron aquí y en Cloud, así que no se trajo nada: %@. Resuélvelos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers ont changé ici et sur le Cloud, donc rien n’a été rapatrié : %@. Réglez-les, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi file sono cambiati sia qui sia su Cloud, quindi non è tornato nulla: %@. Sistemali, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルはこの Mac と Cloud の両方で変更されたため、何も戻されませんでした: %@。解決してから再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារទាំងនេះបានផ្លាស់ប្តូរទាំងនៅទីនេះ និងនៅលើ Cloud ដូច្នេះគ្មានអ្វីត្រូវបាននាំមកវិញទេ៖ %@។ ដោះស្រាយវា រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들이 여기와 Cloud 양쪽에서 변경되어 아무것도 가져오지 않았습니다: %@. 정리한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse filene er endret både her og på Cloud, så ingenting ble hentet tilbake: %@. Avklar dem, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pliki zmieniły się i tutaj, i w Cloud, więc nic nie wróciło: %@. Uzgodnij je, a potem ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes arquivos mudaram aqui e no Cloud, então nada voltou: %@. Resolva-os e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти файлы изменились и здесь, и в Cloud, поэтому ничего не вернулось: %@. Разберитесь с ними и повторите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เหล่านี้เปลี่ยนทั้งที่นี่และบน Cloud จึงไม่มีอะไรถูกนำกลับมา: %@ จัดการให้เรียบร้อยแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyalar hem burada hem Cloud'da değişti, bu yüzden hiçbir şey geri gelmedi: %@. Bunları çözün, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці файли змінилися і тут, і в Cloud, тому нічого не повернулося: %@. Розв’яжіть це й повторіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp này đã thay đổi cả ở đây và trên Cloud nên không có gì được đưa về: %@. Hãy xử lý chúng rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件在这里和 Cloud 上都有更改，因此没有带回任何内容：%@。处理好后再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案在這裡和 Cloud 上都有變更，因此沒有帶回任何內容：%@。處理好後再重試。"
          }
        }
      }
    },
    "cloud.bringBack.syncFailed": {
