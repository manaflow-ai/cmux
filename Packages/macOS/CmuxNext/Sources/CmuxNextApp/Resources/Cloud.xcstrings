            "value": "تعذّر نسخ المجلد مرة أخرى من %1$@: %2$@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa se nije mogla kopirati nazad s %1$@: %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
