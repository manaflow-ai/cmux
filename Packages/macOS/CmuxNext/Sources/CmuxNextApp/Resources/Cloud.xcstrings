            "value": "ตั้งค่า GitHub บน %@ ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinde GitHub kurulsun mu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштувати GitHub на %@?"
          }
        },
        "vi": {
          "stringUnit": {
