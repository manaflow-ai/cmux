    "cloud.create.confirm.agent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent or a script asked for a new Cloud machine. The machine counts against your Cloud plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントまたはスクリプトが新しい Cloud マシンを要求しました。このマシンは Cloud プランの使用量に含まれます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طلب وكيل أو برنامج نصي جهاز Cloud جديدًا. يُحتسب الجهاز ضمن خطة Cloud الخاصة بك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agent ili skripta je zatražio novu Cloud mašinu. Mašina se računa u vaš Cloud plan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En agent eller et script bad om en ny Cloud-maskine. Maskinen tæller med i din Cloud-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Agent oder ein Skript hat eine neue Cloud-Maschine angefordert. Die Maschine zählt zu deinem Cloud-Tarif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agente o un script pidió una nueva máquina de Cloud. La máquina cuenta en tu plan de Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agent ou un script a demandé une nouvelle machine Cloud. La machine compte dans votre forfait Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un agente o uno script ha chiesto una nuova macchina Cloud. La macchina conta nel tuo piano Cloud."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ភ្នាក់ងារ ឬស្គ្រីបបានស្នើម៉ាស៊ីន Cloud ថ្មី។ ម៉ាស៊ីននេះរាប់បញ្ចូលក្នុងគម្រោង Cloud របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "에이전트나 스크립트가 새 Cloud 머신을 요청했습니다. 이 머신은 Cloud 요금제 사용량에 포함됩니다."
          }
        },
        "nb": {
          "stringUnit": {
