    "cloud.cli.idlePauseMustBeOneOf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes must be one of: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分には次のいずれかを指定してください: %@。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون الدقائق واحدة من: %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minute moraju biti jedno od: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutter skal være en af: %@."
          }
        },
        "de": {
          "stringUnit": {
