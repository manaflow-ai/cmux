        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snapshot %@ ist bereit. Stellen Sie ihn mit „Cloud-Maschine wiederherstellen“ wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La instantánea %@ está lista. Restáurala con Restaurar máquina de Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’instantané %@ est prêt. Restaurez-le avec Restaurer la machine Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’istantanea %@ è pronta. Ripristinala con Ripristina macchina Cloud."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "រូបថតស្ថានភាព %@ រួចរាល់ហើយ។ ស្ដារវាដោយប្រើ ស្ដារម៉ាស៊ីន Cloud។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스냅샷 %@이(가) 준비되었습니다. 'Cloud 기기 복원'으로 복원할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Øyeblikksbildet %@ er klart. Gjenopprett det med Gjenopprett Cloud-maskin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Migawka %@ jest gotowa. Przywróć ją poleceniem Przywróć maszynę Cloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O snapshot %@ está pronto. Restaure-o com Restaurar Máquina Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Снимок %@ готов. Восстановите его командой «Восстановить машину Cloud»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สแนปช็อต %@ พร้อมแล้ว กู้คืนได้ด้วย “กู้คืนเครื่อง Cloud”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ anlık görüntüsü hazır. Cloud Makinesini Geri Yükle ile geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Знімок %@ готовий. Відновіть його командою «Відновити машину Cloud»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snapshot %@ đã sẵn sàng. Khôi phục bằng Khôi phục máy Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
