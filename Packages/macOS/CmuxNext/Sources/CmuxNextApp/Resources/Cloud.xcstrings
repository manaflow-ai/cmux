        "bs": {"stringUnit": {"state": "needs_review", "value": "Postavljanje je zaustavljeno na mašini prije završetka. Pogledajte log u %@."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Opsætningen stoppede på maskinen, før den var færdig. Se loggen i %@."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "La configurazione si è fermata sulla macchina prima di finire. Vedi il log in %@."}},
