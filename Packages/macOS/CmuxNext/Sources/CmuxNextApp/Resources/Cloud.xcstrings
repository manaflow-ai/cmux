    "cloud.moveAsk.noPage": {
      "comment": "Told to the agent whose Move to Cloud question could not be shown. Move to Cloud is the action's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't show the question in the chat, so nothing moved. Ask the person to run Move to Cloud on this chat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر عرض السؤال في المحادثة، لذا لم يُنقل شيء. اطلب من الشخص تشغيل «النقل إلى Cloud» على هذه المحادثة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitanje se nije moglo prikazati u razgovoru, pa ništa nije premješteno. Zamolite osobu da pokrene Premjesti u Cloud na ovom razgovoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørgsmålet kunne ikke vises i chatten, så intet blev flyttet. Bed personen om at køre Flyt til Cloud på denne chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frage konnte im Chat nicht angezeigt werden, daher wurde nichts verschoben. Bitte die Person, für diesen Chat „In die Cloud verschieben“ auszuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mostrar la pregunta en el chat, así que no se movió nada. Pide a la persona que ejecute Mover a Cloud en este chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’afficher la question dans le chat, rien n’a donc été déplacé. Demandez à la personne de lancer Déplacer vers le Cloud sur ce chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile mostrare la domanda nella chat, quindi non è stato spostato nulla. Chiedi alla persona di eseguire Sposta su Cloud su questa chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットに確認を表示できなかったため、何も移動していません。このチャットで［Cloud に移動］を実行するよう依頼してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចបង្ហាញសំណួរក្នុងការជជែកបានទេ ដូច្នេះគ្មានអ្វីត្រូវបានផ្លាស់ទីទេ។ សុំឱ្យមនុស្សនោះដំណើរការ ផ្លាស់ទីទៅ Cloud លើការជជែកនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에 질문을 표시하지 못해 아무것도 옮기지 않았습니다. 이 채팅에서 Cloud로 이동을 실행해 달라고 요청하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke vise spørsmålet i chatten, så ingenting ble flyttet. Be personen kjøre Flytt til Cloud på denne chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pokazać pytania w czacie, więc nic nie zostało przeniesione. Poproś osobę, aby uruchomiła Przenieś do Cloud w tym czacie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mostrar a pergunta no chat, então nada foi movido. Peça à pessoa para executar Mover para o Cloud neste chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось показать вопрос в чате, поэтому ничего не перенесено. Попросите человека выполнить «Перенести в Cloud» для этого чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำถามในแชทไม่ได้ จึงไม่มีการย้ายใดๆ ขอให้ผู้ใช้เรียกใช้ ย้ายไปยัง Cloud ในแชทนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soru sohbette gösterilemedi, bu yüzden hiçbir şey taşınmadı. Kişiden bu sohbette Cloud'a taşı'yı çalıştırmasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося показати запитання в чаті, тому нічого не перенесено. Попросіть людину виконати «Перенести в Cloud» для цього чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hiển thị câu hỏi trong cuộc trò chuyện nên không có gì được chuyển. Hãy nhờ người dùng chạy Chuyển lên Cloud cho cuộc trò chuyện này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在对话中显示该问题，因此没有移动任何内容。请让对方在此对话中运行“移至 Cloud”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在對話中顯示該問題，因此沒有移動任何內容。請對方在此對話中執行「移至 Cloud」。"
          }
        }
      }
    },
    "cloud.moveAsk.bringBackIsPersons": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a person can bring a chat back from Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلا لشخص إعادة محادثة من Cloud."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo osoba može vratiti razgovor iz Clouda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en person kan hente en chat tilbage fra Cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Person kann einen Chat aus der Cloud zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una persona puede traer un chat de vuelta desde Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une personne peut rapatrier un chat depuis Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una persona può riportare una chat da Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud からチャットを戻せるのは人だけです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែមនុស្សទេ ដែលអាចនាំការជជែកត្រឡប់ពី Cloud វិញបាន។"
