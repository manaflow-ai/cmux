    "cloud.progress.machinePaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine is paused. Resume it from its menu in the sidebar, then click Retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンは一時停止中です。サイドバーのメニューから再開してから、「再試行」をクリックしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز متوقف مؤقتًا. استأنفه من قائمته في الشريط الجانبي، ثم انقر على إعادة المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mašina je pauzirana. Nastavite je iz njenog menija u bočnoj traci, zatim kliknite Pokušaj ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen er sat på pause. Genoptag den fra dens menu i sidepanelet, og klik derefter på Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschine ist pausiert. Setze sie über ihr Menü in der Seitenleiste fort und klicke dann auf „Erneut versuchen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina está en pausa. Reanúdala desde su menú en la barra lateral y luego haz clic en Reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine est en pause. Reprenez-la depuis son menu dans la barre latérale, puis cliquez sur Réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina è in pausa. Riprendila dal suo menu nella barra laterale, poi fai clic su Riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីនកំពុងផ្អាក។ បន្តវាពីម៉ឺនុយរបស់វានៅរបារចំហៀង រួចចុច ព្យាយាមម្ដងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신이 일시 정지되었습니다. 사이드바의 메뉴에서 재개한 다음 다시 시도를 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen er satt på pause. Gjenoppta den fra menyen i sidefeltet, og klikk deretter Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maszyna jest wstrzymana. Wznów ją z jej menu na pasku bocznym, a potem kliknij Ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina está pausada. Retome-a pelo menu dela na barra lateral e clique em Tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина приостановлена. Возобновите её через меню на боковой панели, затем нажмите «Повторить»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องหยุดชั่วคราวอยู่ ให้เริ่มต่อจากเมนูของเครื่องในแถบด้านข้าง แล้วคลิกลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine duraklatıldı. Kenar çubuğundaki menüsünden sürdürün, ardından Yeniden dene’yi tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машину призупинено. Відновіть її через меню на бічній панелі, потім натисніть «Повторити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đang tạm dừng. Hãy tiếp tục máy từ menu của nó trong thanh bên, rồi nhấp Thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该机器已暂停。请从侧边栏中它的菜单恢复，然后点按“重试”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該機器已暫停。請從側邊欄中它的選單恢復，然後按一下「重試」。"
          }
        }
      }
    },
    "cloud.create.approveInFeed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
