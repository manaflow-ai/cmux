    "cloud.progress.typing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal opens here by itself when the machine is ready. Typing starts there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンの準備ができると、ここにターミナルが自動で開きます。入力はそこから始まります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الطرفية هنا تلقائيًا عندما يصبح الجهاز جاهزًا. تبدأ الكتابة فيها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal se ovdje otvara sam kada mašina bude spremna. Kucanje počinje tamo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen åbner her af sig selv, når maskinen er klar. Indtastning starter der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Terminal öffnet sich hier von selbst, sobald die Maschine bereit ist. Eingaben beginnen dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La terminal se abre aquí sola cuando la máquina está lista. Podrás escribir allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal s’ouvre ici tout seul quand la machine est prête. La saisie commence là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale si apre qui da solo quando la macchina è pronta. Potrai scrivere lì."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទែមីណាល់នឹងបើកនៅទីនេះដោយស្វ័យប្រវត្តិ ពេលម៉ាស៊ីនរួចរាល់។ ការវាយអក្សរចាប់ផ្ដើមនៅទីនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머신이 준비되면 여기에서 터미널이 자동으로 열립니다. 입력은 터미널에서 시작됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen åpnes her av seg selv når maskinen er klar. Skrivingen starter der."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal otworzy się tutaj sam, gdy maszyna będzie gotowa. Tam zaczniesz pisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal abre aqui sozinho quando a máquina estiver pronta. A digitação começa nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал откроется здесь сам, когда машина будет готова. Ввод начнётся в нём."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลจะเปิดที่นี่เองเมื่อเครื่องพร้อม แล้วจึงเริ่มพิมพ์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makine hazır olduğunda terminal burada kendiliğinden açılır. Yazmaya orada başlarsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал відкриється тут сам, коли машина буде готова. Введення почнеться в ньому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal sẽ tự mở tại đây khi máy sẵn sàng. Bạn sẽ gõ ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器就绪后，终端会在这里自动打开，届时即可输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器就緒後，終端機會在這裡自動開啟，屆時即可輸入。"
          }
        }
      }
    },
