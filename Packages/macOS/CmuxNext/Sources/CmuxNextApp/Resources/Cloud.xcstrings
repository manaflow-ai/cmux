    "cloud.upload.refused": {
      "comment": "A Cloud chat upload refused before sending: too big, too many, or not a regular file. %1$@ is the per-file limit and %2$@ the total limit, as sizes (e.g. “32 MB”).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac won't send that file to the Cloud machine: send regular files of up to %1$@ each, %2$@ in all."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يرسل هذا الـ Mac ذلك الملف إلى جهاز Cloud: أرسل ملفات عادية لا يتجاوز كل منها %1$@، و%2$@ إجمالًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Mac neće poslati tu datoteku na Cloud mašinu: šaljite obične datoteke do %1$@ svaka, ukupno do %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac sender ikke den fil til Cloud-maskinen: send almindelige filer på højst %1$@ hver og %2$@ i alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac sendet diese Datei nicht an die Cloud-Maschine: Sende normale Dateien bis %1$@ pro Datei und %2$@ insgesamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no enviará ese archivo a la máquina de Cloud: envía archivos normales de hasta %1$@ cada uno y %2$@ en total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’enverra pas ce fichier à la machine Cloud : envoyez des fichiers ordinaires de %1$@ maximum chacun, %2$@ au total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non invierà quel file alla macchina Cloud: invia file normali fino a %1$@ ciascuno, %2$@ in totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はそのファイルを Cloud マシンに送信しません。通常のファイルを 1 つあたり %1$@ まで、合計 %2$@ まで送信してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac នេះនឹងមិនផ្ញើឯកសារនោះទៅម៉ាស៊ីន Cloud ទេ៖ ផ្ញើឯកសារធម្មតាដែលមិនលើស %1$@ ក្នុងមួយឯកសារ និង %2$@ សរុប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 해당 파일을 Cloud 머신으로 보내지 않습니다. 일반 파일을 파일당 %1$@, 합계 %2$@까지 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen sender ikke den filen til Cloud-maskinen: send vanlige filer på opptil %1$@ hver, %2$@ totalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie wyśle tego pliku do maszyny Cloud: wysyłaj zwykłe pliki do %1$@ każdy, łącznie do %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não enviará esse arquivo para a máquina do Cloud: envie arquivos comuns de até %1$@ cada, %2$@ no total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не отправит этот файл на машину Cloud: отправляйте обычные файлы размером до %1$@ каждый, всего до %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้จะไม่ส่งไฟล์นั้นไปยังเครื่อง Cloud ส่งไฟล์ปกติได้ไฟล์ละไม่เกิน %1$@ รวมไม่เกิน %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac o dosyayı Cloud makinesine göndermeyecek: her biri en fazla %1$@, toplamda en fazla %2$@ olan normal dosyalar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не надішле цей файл на машину Cloud: надсилайте звичайні файли до %1$@ кожен, загалом до %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này sẽ không gửi tệp đó đến máy Cloud: hãy gửi tệp thông thường, tối đa %1$@ mỗi tệp và %2$@ tổng cộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不会将该文件发送到 Cloud 机器：请发送普通文件，每个不超过 %1$@，总计不超过 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 不會將該檔案傳送到 Cloud 機器：請傳送一般檔案，每個不超過 %1$@，總計不超過 %2$@。"
          }
        }
      }
    },
