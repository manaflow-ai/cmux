    "cloud.move.teamMachine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a team machine. Chats move only to a machine you own."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ جهاز فريق. تُنقل المحادثات فقط إلى جهاز تملكه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je timska mašina. Chatovi se premještaju samo na mašinu koju posjeduješ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er en teammaskine. Chats kan kun flyttes til en maskine, du ejer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein Team-Rechner. Chats lassen sich nur auf einen eigenen Rechner verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es una máquina de equipo. Los chats solo se mueven a una máquina tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une machine d’équipe. Les discussions ne se déplacent que vers une machine qui vous appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è una macchina del team. Le chat si spostano solo su una macchina di tua proprietà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はチームのマシンです。チャットは自分が所有するマシンにのみ移動できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ជាម៉ាស៊ីនក្រុម។ ការជជែកផ្លាស់ទីបានតែទៅម៉ាស៊ីនដែលអ្នកជាម្ចាស់ប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 팀 머신입니다. 채팅은 본인 소유의 머신으로만 옮길 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er en teammaskin. Chatter kan bare flyttes til en maskin du eier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to maszyna zespołu. Czaty można przenosić tylko na własną maszynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é uma máquina de equipe. Os chats só podem ser movidos para uma máquina sua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — машина команды. Чаты переносятся только на вашу собственную машину."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เป็นเครื่องของทีม แชทย้ายได้เฉพาะไปยังเครื่องที่คุณเป็นเจ้าของ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir ekip makinesi. Sohbetler yalnızca size ait bir makineye taşınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — машина команди. Чати переносяться лише на вашу власну машину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là máy của nhóm. Cuộc trò chuyện chỉ được chuyển sang máy bạn sở hữu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
