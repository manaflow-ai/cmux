        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុម័តម៉ាស៊ីននេះក្នុង feed cmux របស់អ្នក រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 피드에서 이 머신을 승인한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Godkjenn maskinen i cmux-feeden din, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zatwierdź tę maszynę w swoim kanale cmux i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove esta máquina no seu feed do cmux e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подтвердите эту машину в ленте cmux и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุมัติเครื่องนี้ในฟีด cmux ของคุณ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu makineyi cmux akışınızda onaylayın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Схваліть цю машину у стрічці cmux і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phê duyệt máy này trong nguồn cấp cmux của bạn, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在 cmux 动态中批准该机器,然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在 cmux 動態中核准此機器,然後再試一次。"
          }
        }
      }
