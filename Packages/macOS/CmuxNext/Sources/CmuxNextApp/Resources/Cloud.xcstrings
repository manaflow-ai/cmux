{
  "sourceLanguage": "en",
  "strings": {
    "cloud.github.confirmTitle": {
      "comment": "Confirmation title before Set Up GitHub runs; %@ is the Cloud machine's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up GitHub on %@?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعداد GitHub على %@؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postaviti GitHub na %@?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurer GitHub på %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub auf %@ einrichten?"
          }
        },
        "es": {
