          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud удаляет эту машину и её диск."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud กำลังลบเครื่องนี้และดิสก์ของเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud bu makineyi ve diskini siliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud видаляє цю машину та її диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud đang xóa máy này và ổ đĩa của máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在删除该机器及其磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在刪除此機器及其磁碟。"
          }
        }
      }
    },
