            "value": "Ingen Cloud-maskin har ID-en %@. `cmux cloud list-machines` viser ID-ene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna maszyna Cloud nie ma identyfikatora %@. `cmux cloud list-machines` wyświetla identyfikatory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
