    "cloud.progress.next.resuming": {
      "comment": "The progress card's line under a Cloud machine that cmux Cloud is starting again after a pause.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud is starting this machine again. It connects once it runs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم cmux Cloud بتشغيل هذا الجهاز مرة أخرى. يتصل بمجرد تشغيله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ponovo pokreće ovu mašinu. Povezaće se čim se pokrene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud starter denne maskine igen. Den forbinder, så snart den kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud startet diese Maschine wieder. Sie verbindet sich, sobald sie läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud está iniciando esta máquina de nuevo. Se conecta en cuanto esté en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud redémarre cette machine. Elle se connecte dès qu'elle tourne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud sta riavviando questa macchina. Si connette appena è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud がこのマシンを再び起動しています。起動するとすぐに接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud កំពុងចាប់ផ្ដើមម៉ាស៊ីននេះម្ដងទៀត។ វានឹងភ្ជាប់នៅពេលវាដំណើរការ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud가 이 머신을 다시 시작하고 있습니다. 실행되면 바로 연결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud starter denne maskinen igjen. Den kobler til så snart den kjører."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud ponownie uruchamia tę maszynę. Połączy się, gdy tylko zacznie działać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux Cloud está iniciando esta máquina novamente. Ela se conecta assim que estiver em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud снова запускает эту машину. Она подключится, как только заработает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud กำลังเริ่มเครื่องนี้อีกครั้ง เครื่องจะเชื่อมต่อทันทีที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud bu makineyi yeniden başlatıyor. Çalışır çalışmaz bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud знову запускає цю машину. Вона підключиться, щойно запрацює."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud đang khởi động lại máy này. Máy sẽ kết nối ngay khi chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在再次启动该机器。它运行后即会连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Cloud 正在再次啟動此機器。它執行後即會連線。"
          }
        }
      }
    },
