            "value": "ไม่สามารถตั้งค่าข้อมูลประจำตัว git บนเครื่องนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinede git kimliği ayarlanamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося встановити ідентичність git на цій машині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đặt danh tính git trên máy này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此机器上设置 git 身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此機器上設定 git 身分。"
          }
        }
      }
    },
    "cloud.github.identityUnsafe": {
      "comment": "Refusal when the Mac's git identity holds control characters or is too long. Keep user.name and user.email untranslated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your git user.name or user.email has control characters or is too long, so cmux won't pass it on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي git user.name أو user.email لديك على أحرف تحكم أو أنه طويل جدًا، لذا لن يمرره cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš git user.name ili user.email sadrži kontrolne znakove ili je predug, pa ga cmux neće proslijediti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din git user.name eller user.email indeholder kontroltegn eller er for lang, så cmux sender den ikke videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein git user.name oder user.email enthält Steuerzeichen oder ist zu lang, daher gibt cmux ihn nicht weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu git user.name o user.email tiene caracteres de control o es demasiado largo, así que cmux no lo transmitirá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre git user.name ou user.email contient des caractères de contrôle ou est trop long, cmux ne le transmettra donc pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo git user.name o user.email contiene caratteri di controllo o è troppo lungo, quindi cmux non lo trasmetterà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name または user.email に制御文字が含まれているか長すぎるため、cmux は渡しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name ឬ user.email របស់អ្នកមានតួអក្សរបញ្ជា ឬវែងពេក ដូច្នេះ cmux នឹងមិនបញ្ជូនវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name 또는 user.email에 제어 문자가 있거나 너무 길어서 cmux가 전달하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name eller user.email inneholder kontrolltegn eller er for lang, så cmux sender den ikke videre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój git user.name lub user.email zawiera znaki sterujące albo jest za długi, więc cmux go nie przekaże."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu git user.name ou user.email tem caracteres de controle ou é longo demais, então o cmux não vai repassá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш git user.name или user.email содержит управляющие символы или слишком длинный, поэтому cmux не будет его передавать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name หรือ user.email ของคุณมีอักขระควบคุมหรือยาวเกินไป cmux จึงจะไม่ส่งต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name veya user.email değeriniz denetim karakterleri içeriyor ya da çok uzun, bu yüzden cmux onu aktarmayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш git user.name або user.email містить керувальні символи чи надто довгий, тому cmux не передаватиме його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "git user.name hoặc user.email của bạn có ký tự điều khiển hoặc quá dài, nên cmux sẽ không chuyển tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 git user.name 或 user.email 含有控制字符或过长，因此 cmux 不会传递它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 git user.name 或 user.email 含有控制字元或過長，因此 cmux 不會傳遞它。"
          }
        }
      }
    },
    "cloud.github.appConfirmBody": {
      "comment": "Set Up GitHub confirm when the Cloud machine's git will use the cmux GitHub App. %1$@ is the git user.name, %2$@ the user.email.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Sets git user.name to “%1$@” and user.email to “%2$@” on the machine, and lets its git get a short-lived token for each repo from cmux's GitHub App. No GitHub token is stored on the machine."}},
        "ja": {"stringUnit": {"state": "translated", "value": "マシンの git user.name を「%1$@」、user.email を「%2$@」に設定し、その git が cmux の GitHub App からリポジトリごとに短時間有効なトークンを取得できるようにします。GitHub トークンはマシンに保存されません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Setzt git user.name auf „%1$@“ und user.email auf „%2$@“ auf der Maschine und lässt ihr git für jedes Repo ein kurzlebiges Token von der GitHub-App von cmux holen. Auf der Maschine wird kein GitHub-Token gespeichert."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Définit git user.name sur « %1$@ » et user.email sur « %2$@ » sur la machine, et laisse son git obtenir un jeton de courte durée pour chaque dépôt auprès de l'app GitHub de cmux. Aucun jeton GitHub n'est stocké sur la machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Establece git user.name en «%1$@» y user.email en «%2$@» en la máquina, y deja que su git obtenga un token de corta duración para cada repositorio desde la app de GitHub de cmux. No se guarda ningún token de GitHub en la máquina."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "يعيّن git user.name إلى «%1$@» وuser.email إلى «%2$@» على الآلة، ويتيح لـ git فيها الحصول على رمز قصير الأجل لكل مستودع من تطبيق GitHub الخاص بـ cmux. لا يُخزَّن أي رمز GitHub على الآلة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "머신의 git user.name을 “%1$@”, user.email을 “%2$@”(으)로 설정하고, 그 git이 cmux의 GitHub 앱에서 저장소마다 짧게 유효한 토큰을 받도록 합니다. 머신에는 GitHub 토큰이 저장되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "将机器上的 git user.name 设为“%1$@”、user.email 设为“%2$@”，并让它的 git 从 cmux 的 GitHub App 为每个仓库获取短期令牌。机器上不会存储 GitHub 令牌。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "將機器上的 git user.name 設為「%1$@」、user.email 設為「%2$@」，並讓它的 git 從 cmux 的 GitHub App 為每個儲存庫取得短期權杖。機器上不會儲存 GitHub 權杖。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Postavlja git user.name na „%1$@“ i user.email na „%2$@“ na mašini, i pušta njen git da za svaki repozitorij dobije kratkotrajni token od cmux GitHub aplikacije. Na mašini se ne čuva nijedan GitHub token."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Sætter git user.name til “%1$@” og user.email til “%2$@” på maskinen og lader dens git hente et kortlivet token for hvert repo fra cmux' GitHub-app. Der gemmes intet GitHub-token på maskinen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Imposta git user.name su “%1$@” e user.email su “%2$@” sulla macchina e permette al suo git di ottenere un token di breve durata per ogni repository dall'app GitHub di cmux. Sulla macchina non viene salvato alcun token GitHub."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "កំណត់ git user.name ទៅ “%1$@” និង user.email ទៅ “%2$@” នៅលើម៉ាស៊ីន ហើយឲ្យ git របស់វាទទួលបាន token រយៈពេលខ្លីសម្រាប់ repo នីមួយៗពី GitHub App របស់ cmux។ គ្មាន token GitHub ត្រូវបានរក្សាទុកនៅលើម៉ាស៊ីនទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Setter git user.name til «%1$@» og user.email til «%2$@» på maskinen, og lar git der hente et kortlivet token for hvert repo fra cmux sin GitHub-app. Ingen GitHub-token lagres på maskinen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ustawia git user.name na „%1$@” i user.email na „%2$@” na maszynie oraz pozwala jej gitowi pobierać krótkotrwały token dla każdego repozytorium z aplikacji GitHub cmux. Na maszynie nie jest zapisywany żaden token GitHub."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Define git user.name como “%1$@” e user.email como “%2$@” na máquina e deixa o git dela obter um token de curta duração para cada repositório no app do GitHub do cmux. Nenhum token do GitHub é guardado na máquina."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Задаёт git user.name «%1$@» и user.email «%2$@» на машине, и её git получает краткосрочный токен для каждого репозитория от GitHub-приложения cmux. Токен GitHub на машине не хранится."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ตั้ง git user.name เป็น “%1$@” และ user.email เป็น “%2$@” บนเครื่อง และให้ git ของเครื่องรับโทเค็นอายุสั้นสำหรับแต่ละรีโพจาก GitHub App ของ cmux ไม่มีการเก็บโทเค็น GitHub ไว้บนเครื่อง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Makinede git user.name'i “%1$@”, user.email'i “%2$@” yapar ve git'inin her depo için cmux'un GitHub uygulamasından kısa ömürlü bir belirteç almasını sağlar. Makinede hiçbir GitHub belirteci saklanmaz."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Встановлює git user.name «%1$@» і user.email «%2$@» на машині, і її git отримує короткочасний токен для кожного репозиторію від GitHub-застосунку cmux. Токен GitHub на машині не зберігається."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đặt git user.name thành “%1$@” và user.email thành “%2$@” trên máy, và cho git của máy lấy token ngắn hạn cho từng repo từ GitHub App của cmux. Không có token GitHub nào được lưu trên máy."}}
      }
    },
    "cloud.github.appConfirmNoIdentity": {
      "comment": "Set Up GitHub confirm when this Mac has no git identity and the machine's git will use the cmux GitHub App.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Mac has no global git user.name or user.email, so only GitHub is set up: the machine's git gets a short-lived token for each repo from cmux's GitHub App. No GitHub token is stored on the machine."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Mac にはグローバルな git user.name も user.email もないため、GitHub だけを設定します。マシンの git は cmux の GitHub App からリポジトリごとに短時間有効なトークンを取得します。GitHub トークンはマシンに保存されません。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dieser Mac hat kein globales git user.name oder user.email, daher wird nur GitHub eingerichtet: Das git der Maschine holt für jedes Repo ein kurzlebiges Token von der GitHub-App von cmux. Auf der Maschine wird kein GitHub-Token gespeichert."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Ce Mac n'a ni git user.name ni user.email globaux : seul GitHub est configuré. Le git de la machine obtient un jeton de courte durée pour chaque dépôt auprès de l'app GitHub de cmux. Aucun jeton GitHub n'est stocké sur la machine."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Este Mac no tiene git user.name ni user.email globales, así que solo se configura GitHub: el git de la máquina obtiene un token de corta duración para cada repositorio desde la app de GitHub de cmux. No se guarda ningún token de GitHub en la máquina."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لا يحتوي هذا الـ Mac على git user.name أو user.email عام، لذا يُعدّ GitHub فقط: يحصل git على الآلة على رمز قصير الأجل لكل مستودع من تطبيق GitHub الخاص بـ cmux. لا يُخزَّن أي رمز GitHub على الآلة."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 Mac에는 전역 git user.name이나 user.email이 없어 GitHub만 설정합니다. 머신의 git은 cmux의 GitHub 앱에서 저장소마다 짧게 유효한 토큰을 받습니다. 머신에는 GitHub 토큰이 저장되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "这台 Mac 没有全局 git user.name 或 user.email，因此只设置 GitHub：机器的 git 从 cmux 的 GitHub App 为每个仓库获取短期令牌。机器上不会存储 GitHub 令牌。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "這台 Mac 沒有全域 git user.name 或 user.email，因此只設定 GitHub：機器的 git 從 cmux 的 GitHub App 為每個儲存庫取得短期權杖。機器上不會儲存 GitHub 權杖。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Ovaj Mac nema globalni git user.name ni user.email, pa se postavlja samo GitHub: git mašine za svaki repozitorij dobija kratkotrajni token od cmux GitHub aplikacije. Na mašini se ne čuva nijedan GitHub token."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Denne Mac har ingen global git user.name eller user.email, så kun GitHub sættes op: maskinens git henter et kortlivet token for hvert repo fra cmux' GitHub-app. Der gemmes intet GitHub-token på maskinen."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Questo Mac non ha git user.name né user.email globali, quindi viene configurato solo GitHub: il git della macchina ottiene un token di breve durata per ogni repository dall'app GitHub di cmux. Sulla macchina non viene salvato alcun token GitHub."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "Mac នេះគ្មាន git user.name ឬ user.email សកលទេ ដូច្នេះមានតែ GitHub ប៉ុណ្ណោះដែលត្រូវបានរៀបចំ៖ git របស់ម៉ាស៊ីនទទួលបាន token រយៈពេលខ្លីសម្រាប់ repo នីមួយៗពី GitHub App របស់ cmux។ គ្មាន token GitHub ត្រូវបានរក្សាទុកនៅលើម៉ាស៊ីនទេ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Denne Macen har ingen global git user.name eller user.email, så bare GitHub settes opp: git på maskinen henter et kortlivet token for hvert repo fra cmux sin GitHub-app. Ingen GitHub-token lagres på maskinen."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Ten Mac nie ma globalnego git user.name ani user.email, więc konfigurowany jest tylko GitHub: git maszyny pobiera krótkotrwały token dla każdego repozytorium z aplikacji GitHub cmux. Na maszynie nie jest zapisywany żaden token GitHub."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Este Mac não tem git user.name nem user.email globais, então só o GitHub é configurado: o git da máquina obtém um token de curta duração para cada repositório no app do GitHub do cmux. Nenhum token do GitHub é guardado na máquina."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "На этом Mac нет глобальных git user.name и user.email, поэтому настраивается только GitHub: git машины получает краткосрочный токен для каждого репозитория от GitHub-приложения cmux. Токен GitHub на машине не хранится."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "Mac เครื่องนี้ไม่มี git user.name หรือ user.email ระดับระบบ จึงตั้งค่าเฉพาะ GitHub: git ของเครื่องจะรับโทเค็นอายุสั้นสำหรับแต่ละรีโพจาก GitHub App ของ cmux ไม่มีการเก็บโทเค็น GitHub ไว้บนเครื่อง"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Bu Mac'te genel git user.name veya user.email yok, bu yüzden yalnızca GitHub kurulur: makinenin git'i her depo için cmux'un GitHub uygulamasından kısa ömürlü bir belirteç alır. Makinede hiçbir GitHub belirteci saklanmaz."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "На цьому Mac немає глобальних git user.name і user.email, тому налаштовується лише GitHub: git машини отримує короткочасний токен для кожного репозиторію від GitHub-застосунку cmux. Токен GitHub на машині не зберігається."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Máy Mac này không có git user.name hay user.email toàn cục nên chỉ thiết lập GitHub: git của máy lấy token ngắn hạn cho từng repo từ GitHub App của cmux. Không có token GitHub nào được lưu trên máy."}}
      }
    },
    "cloud.github.appReady": {
      "comment": "Set Up GitHub result when the machine's git now uses the cmux GitHub App. Keep cmux github gh as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "GitHub is set up through cmux's GitHub App: git on this machine gets a short-lived token for each repo, and none is stored there. For the GitHub CLI, run cmux github gh."}},
        "ja": {"stringUnit": {"state": "translated", "value": "GitHub は cmux の GitHub App で設定されました。このマシンの git はリポジトリごとに短時間有効なトークンを取得し、トークンは保存されません。GitHub CLI には cmux github gh を使ってください。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "GitHub ist über die GitHub-App von cmux eingerichtet: git auf dieser Maschine holt für jedes Repo ein kurzlebiges Token, und keins wird dort gespeichert. Für die GitHub-CLI führe cmux github gh aus."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "GitHub est configuré via l'app GitHub de cmux : git sur cette machine obtient un jeton de courte durée pour chaque dépôt, et aucun n'y est stocké. Pour la CLI GitHub, lancez cmux github gh."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "GitHub está configurado con la app de GitHub de cmux: git en esta máquina obtiene un token de corta duración para cada repositorio y no se guarda ninguno. Para la CLI de GitHub, ejecuta cmux github gh."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "تم إعداد GitHub عبر تطبيق GitHub الخاص بـ cmux: يحصل git على هذه الآلة على رمز قصير الأجل لكل مستودع، ولا يُخزَّن أي رمز هناك. لواجهة GitHub CLI، شغّل cmux github gh."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "cmux의 GitHub 앱으로 GitHub를 설정했습니다. 이 머신의 git은 저장소마다 짧게 유효한 토큰을 받고, 토큰은 저장되지 않습니다. GitHub CLI는 cmux github gh로 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "已通过 cmux 的 GitHub App 设置 GitHub：这台机器上的 git 会为每个仓库获取短期令牌，且不在那里存储任何令牌。要使用 GitHub CLI，请运行 cmux github gh。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "已透過 cmux 的 GitHub App 設定 GitHub：這台機器上的 git 會為每個儲存庫取得短期權杖，且不在那裡儲存任何權杖。要使用 GitHub CLI，請執行 cmux github gh。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "GitHub je postavljen preko cmux GitHub aplikacije: git na ovoj mašini za svaki repozitorij dobija kratkotrajni token, a nijedan se tamo ne čuva. Za GitHub CLI pokreni cmux github gh."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "GitHub er sat op via cmux' GitHub-app: git på denne maskine henter et kortlivet token for hvert repo, og intet gemmes der. Til GitHub CLI skal du køre cmux github gh."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "GitHub è configurato tramite l'app GitHub di cmux: git su questa macchina ottiene un token di breve durata per ogni repository, e nessuno viene salvato lì. Per la CLI di GitHub, esegui cmux github gh."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "GitHub ត្រូវបានរៀបចំតាមរយៈ GitHub App របស់ cmux៖ git នៅលើម៉ាស៊ីននេះទទួលបាន token រយៈពេលខ្លីសម្រាប់ repo នីមួយៗ ហើយគ្មាន token ណាមួយត្រូវបានរក្សាទុកនៅទីនោះទេ។ សម្រាប់ GitHub CLI សូមដំណើរការ cmux github gh។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "GitHub er satt opp gjennom cmux sin GitHub-app: git på denne maskinen henter et kortlivet token for hvert repo, og ingen lagres der. For GitHub CLI, kjør cmux github gh."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "GitHub skonfigurowano przez aplikację GitHub cmux: git na tej maszynie pobiera krótkotrwały token dla każdego repozytorium i żaden nie jest tam zapisywany. Dla GitHub CLI uruchom cmux github gh."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "O GitHub foi configurado pelo app do GitHub do cmux: o git nesta máquina obtém um token de curta duração para cada repositório, e nenhum fica guardado lá. Para a CLI do GitHub, execute cmux github gh."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "GitHub настроен через GitHub-приложение cmux: git на этой машине получает краткосрочный токен для каждого репозитория, и ни один там не хранится. Для GitHub CLI запустите cmux github gh."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ตั้งค่า GitHub ผ่าน GitHub App ของ cmux แล้ว: git บนเครื่องนี้จะรับโทเค็นอายุสั้นสำหรับแต่ละรีโพ และไม่มีการเก็บโทเค็นไว้ที่นั่น สำหรับ GitHub CLI ให้รัน cmux github gh"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "GitHub, cmux'un GitHub uygulamasıyla kuruldu: bu makinedeki git her depo için kısa ömürlü bir belirteç alır ve orada hiçbiri saklanmaz. GitHub CLI için cmux github gh komutunu çalıştırın."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "GitHub налаштовано через GitHub-застосунок cmux: git на цій машині отримує короткочасний токен для кожного репозиторію, і жоден там не зберігається. Для GitHub CLI запустіть cmux github gh."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Đã thiết lập GitHub qua GitHub App của cmux: git trên máy này lấy token ngắn hạn cho từng repo và không lưu token nào ở đó. Với GitHub CLI, hãy chạy cmux github gh."}}
      }
    },
    "cloud.github.fallbackNotConnected": {
      "comment": "Set Up GitHub: why the Cloud machine signs in to GitHub itself (the device flow): the team has not connected the cmux GitHub App.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your team hasn't connected cmux's GitHub App, so this machine signs in to GitHub itself and keeps that token until you sign out there."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チームが cmux の GitHub App を接続していないため、このマシンは自分で GitHub にサインインし、そこでサインアウトするまでそのトークンを保持します。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Dein Team hat die GitHub-App von cmux nicht verbunden, daher meldet sich diese Maschine selbst bei GitHub an und behält dieses Token, bis du dich dort abmeldest."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Votre équipe n'a pas connecté l'app GitHub de cmux : cette machine se connecte donc elle-même à GitHub et garde ce jeton jusqu'à ce que vous vous y déconnectiez."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Tu equipo no ha conectado la app de GitHub de cmux, así que esta máquina inicia sesión en GitHub por sí misma y guarda ese token hasta que cierres sesión allí."}},
        "ar": {"stringUnit": {"state": "needs_review", "value": "لم يربط فريقك تطبيق GitHub الخاص بـ cmux، لذا تسجّل هذه الآلة الدخول إلى GitHub بنفسها وتحتفظ بذلك الرمز حتى تسجّل الخروج هناك."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "팀이 cmux의 GitHub 앱을 연결하지 않아 이 머신이 직접 GitHub에 로그인하며, 그곳에서 로그아웃할 때까지 그 토큰을 보관합니다."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "你的团队尚未连接 cmux 的 GitHub App，因此这台机器自行登录 GitHub，并保留该令牌，直到你在那里退出登录。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "你的團隊尚未連接 cmux 的 GitHub App，因此這台機器自行登入 GitHub，並保留該權杖，直到你在那裡登出。"}},
        "bs": {"stringUnit": {"state": "needs_review", "value": "Tvoj tim nije povezao cmux GitHub aplikaciju, pa se ova mašina sama prijavljuje na GitHub i čuva taj token dok se tamo ne odjaviš."}},
        "da": {"stringUnit": {"state": "needs_review", "value": "Dit team har ikke forbundet cmux' GitHub-app, så denne maskine logger selv ind på GitHub og beholder det token, til du logger ud der."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Il tuo team non ha collegato l'app GitHub di cmux, quindi questa macchina accede a GitHub da sola e conserva quel token finché non ti disconnetti lì."}},
        "km": {"stringUnit": {"state": "needs_review", "value": "ក្រុមរបស់អ្នកមិនទាន់ភ្ជាប់ GitHub App របស់ cmux ទេ ដូច្នេះម៉ាស៊ីននេះចូល GitHub ដោយខ្លួនឯង ហើយរក្សា token នោះរហូតដល់អ្នកចាកចេញនៅទីនោះ។"}},
        "nb": {"stringUnit": {"state": "needs_review", "value": "Teamet ditt har ikke koblet til cmux sin GitHub-app, så denne maskinen logger selv inn på GitHub og beholder det tokenet til du logger ut der."}},
        "pl": {"stringUnit": {"state": "needs_review", "value": "Twój zespół nie połączył aplikacji GitHub cmux, więc ta maszyna sama loguje się do GitHub i trzyma ten token, dopóki się tam nie wylogujesz."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Sua equipe não conectou o app do GitHub do cmux, então esta máquina entra no GitHub sozinha e guarda esse token até você sair da conta lá."}},
        "ru": {"stringUnit": {"state": "needs_review", "value": "Ваша команда не подключила GitHub-приложение cmux, поэтому эта машина сама входит в GitHub и хранит этот токен, пока вы там не выйдете."}},
        "th": {"stringUnit": {"state": "needs_review", "value": "ทีมของคุณยังไม่ได้เชื่อมต่อ GitHub App ของ cmux เครื่องนี้จึงลงชื่อเข้า GitHub เองและเก็บโทเค็นนั้นไว้จนกว่าคุณจะลงชื่อออกที่นั่น"}},
        "tr": {"stringUnit": {"state": "needs_review", "value": "Ekibiniz cmux'un GitHub uygulamasını bağlamadı, bu yüzden bu makine GitHub'a kendisi giriş yapar ve siz orada çıkış yapana kadar o belirteci tutar."}},
        "uk": {"stringUnit": {"state": "needs_review", "value": "Ваша команда не під’єднала GitHub-застосунок cmux, тому ця машина сама входить у GitHub і зберігає цей токен, доки ви там не вийдете."}},
        "vi": {"stringUnit": {"state": "needs_review", "value": "Nhóm của bạn chưa kết nối GitHub App của cmux nên máy này tự đăng nhập GitHub và giữ token đó cho đến khi bạn đăng xuất ở đó."}}
      }
    },
