        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La macchina e tutti i suoi terminali verranno eliminati. Questa operazione non può essere annullata."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
