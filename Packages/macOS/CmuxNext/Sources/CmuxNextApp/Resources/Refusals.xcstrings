          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa scheda mostra il localhost di una macchina cloud tramite il suo proxy, quindi resta in Chromium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブはクラウドマシンの localhost をプロキシ経由で表示しているため、Chromium のままです。"
          }
        },
        "km": {
          "stringUnit": {
