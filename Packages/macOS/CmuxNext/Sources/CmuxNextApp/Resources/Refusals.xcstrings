          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dịch vụ nền của cmux đã cũ. Hãy thoát và mở lại cmux để cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
