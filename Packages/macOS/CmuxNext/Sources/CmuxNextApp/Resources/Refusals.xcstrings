        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el chat de esta pestaña cambió en otro dispositivo: conservará ese chat tras reiniciar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la conversation de cet onglet a changé sur un autre appareil : elle conserve cette conversation après redémarrage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la chat in questa scheda è cambiata su un altro dispositivo: dopo il riavvio resta quella chat"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការជជែកក្នុងផ្ទាំងនេះបានផ្លាស់ប្តូរនៅលើឧបករណ៍ផ្សេង៖ វានឹងរក្សាការជជែកនោះបន្ទាប់ពីបើកឡើងវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 탭의 채팅이 다른 기기에서 변경됨: 다시 실행한 후에는 그 채팅이 유지됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "chatten i denne fanen ble endret på en annen enhet: den beholder den chatten etter omstart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "czat w tej karcie zmieniono na innym urządzeniu: po ponownym uruchomieniu pozostanie tamten czat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o chat desta aba mudou em outro dispositivo: ele mantém aquele chat após reiniciar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "чат в этой вкладке изменён на другом устройстве: после перезапуска останется тот чат"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แชทในแท็บนี้ถูกเปลี่ยนบนอุปกรณ์อื่น: หลังเปิดใหม่จะยังเป็นแชทนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bu sekmedeki sohbet başka bir cihazda değişti: yeniden başlatmadan sonra o sohbet kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "чат у цій вкладці змінено на іншому пристрої: після перезапуску залишиться той чат"
