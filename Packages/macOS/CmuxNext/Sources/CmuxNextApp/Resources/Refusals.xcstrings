            "value": "This tab shows a cloud machine's localhost through its proxy, so it stays in Chromium."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض علامة التبويب هذه localhost لجهاز سحابي عبر الوكيل الخاص به، لذا تبقى في Chromium."
          }
        },
        "bs": {
          "stringUnit": {
