        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タブまたはワークスペースがウインドウに表示されていないため、リソースカードを開けません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំង ឬកន្លែងធ្វើការមិនបង្ហាញក្នុងបង្អួចទេ ដូច្នេះមិនអាចបើកកាតធនធានបានទេ"
