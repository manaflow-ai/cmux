{
  "sourceLanguage": "en",
  "strings": {
    "handlers.refusal.audioMuteUnported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "needs audio mute support in the cmux-next browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next のブラウザで音声ミュートへの対応が必要です"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب دعم كتم الصوت في متصفح cmux-next"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "potrebna je podrška za utišavanje zvuka u cmux-next pregledniku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kræver understøttelse af lyd fra i cmux-next-browseren"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "erfordert Stummschaltung im cmux-next-Browser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "requiere silenciar audio en el navegador de cmux-next"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nécessite la coupure du son dans le navigateur cmux-next"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "richiede il supporto per disattivare l’audio nel browser di cmux-next"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រូវការការគាំទ្របិទសំឡេងក្នុងកម្មវិធីរុករក cmux-next"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-next 브라우저에서 오디오 음소거 지원이 필요함"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "krever støtte for å dempe lyd i cmux-next-nettleseren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wymaga obsługi wyciszania dźwięku w przeglądarce cmux-next"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "requer suporte a silenciar áudio no navegador do cmux-next"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нужна поддержка отключения звука в браузере cmux-next"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ต้องรองรับการปิดเสียงในเบราว์เซอร์ cmux-next"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux-next tarayıcısında ses kapatma desteği gerekiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "потрібна підтримка вимкнення звуку в браузері cmux-next"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cần hỗ trợ tắt tiếng trong trình duyệt cmux-next"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要 cmux-next 浏览器支持音频静音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要 cmux-next 瀏覽器支援音訊靜音"
          }
        }
      }
    },
    "handlers.refusal.browserFindClosesWithEscape": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the browser find bar closes with Escape"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザの検索バーは Escape で閉じます"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُغلق شريط البحث في المتصفح بمفتاح Esc"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "traka za pretragu preglednika zatvara se tipkom Escape"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "browserens søgelinje lukkes med Esc"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "die Suchleiste des Browsers wird mit Esc geschlossen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la barra de búsqueda del navegador se cierra con Esc"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la barre de recherche du navigateur se ferme avec Esc"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la barra di ricerca del browser si chiude con Esc"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "របារស្វែងរកកម្មវិធីរុករកបិទដោយ Escape"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 찾기 막대는 Esc로 닫힘"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nettleserens søkefelt lukkes med Esc"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "pasek wyszukiwania przeglądarki zamyka się klawiszem Esc"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "a barra de busca do navegador fecha com Esc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "панель поиска браузера закрывается клавишей Esc"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถบค้นหาของเบราว์เซอร์ปิดด้วย Esc"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tarayıcı bulma çubuğu Escape ile kapanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "панель пошуку браузера закривається клавішею Escape"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "thanh tìm kiếm của trình duyệt đóng bằng Escape"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浏览器查找栏可用 Esc 关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "瀏覽器尋找列可按 Escape 關閉"
          }
        }
      }
    },
    "handlers.refusal.browserReopenNeedsWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "browser tabs reopen only in a pane shown in a window"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザタブはウィンドウに表示中のペインでのみ再度開けます"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُعاد فتح علامات تبويب المتصفح إلا في جزء معروض في نافذة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tabovi preglednika se ponovo otvaraju samo u panelu prikazanom u prozoru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "browserfaner genåbnes kun i en rude, der vises i et vindue"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Browser-Tabs öffnen sich nur in einem Teilfenster, das in einem Fenster angezeigt wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "las pestañas del navegador solo se reabren en un panel visible en una ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "les onglets de navigateur ne se rouvrent que dans un volet affiché dans une fenêtre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "le schede browser si riaprono solo in un pannello mostrato in una finestra"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ថេបកម្មវិធីរុករកបើកឡើងវិញបានតែក្នុងផ្ទាំងដែលបង្ហាញក្នុងបង្អួចប៉ុណ្ណោះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "브라우저 탭은 윈도우에 표시된 분할 창에서만 다시 열 수 있음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nettleserfaner gjenåpnes bare i en rute som vises i et vindu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "karty przeglądarki otwierają się ponownie tylko w panelu widocznym w oknie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "abas do navegador só reabrem em um painel exibido em uma janela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "вкладки браузера открываются снова только в панели, показанной в окне"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แท็บเบราว์เซอร์จะเปิดอีกครั้งได้เฉพาะในบานหน้าต่างที่แสดงในหน้าต่างเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tarayıcı sekmeleri yalnızca bir pencerede gösterilen bölmede yeniden açılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "вкладки браузера можна знову відкрити лише в панелі, показаній у вікні"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "tab trình duyệt chỉ mở lại trong khung đang hiển thị trong cửa sổ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "浏览器标签页只能在窗口中显示的窗格里重新打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "瀏覽器標籤頁只能在視窗中顯示的窗格內重新開啟"
          }
        }
      }
    },
    "handlers.refusal.canvasUnported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "needs canvas layout, which cmux-next does not have yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスレイアウトが必要ですが、cmux-next にはまだありません"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب تخطيط اللوحة، وهو غير متوفر في cmux-next بعد"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "potreban je raspored platna, koji cmux-next još nema"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kræver lærredslayout, som cmux-next endnu ikke har"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "erfordert Canvas-Layout, das cmux-next noch nicht hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "requiere la disposición de lienzo, que cmux-next aún no tiene"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nécessite la disposition en canevas, absente de cmux-next pour l’instant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "richiede il layout canvas, non ancora presente in cmux-next"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រូវការប្លង់ Canvas ដែល cmux-next មិនទាន់មាន"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "캔버스 레이아웃이 필요하지만 cmux-next에는 아직 없음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "krever lerretoppsett, som cmux-next ikke har ennå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wymaga układu kanwy, którego cmux-next jeszcze nie ma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "requer layout de canvas, que o cmux-next ainda não tem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нужен макет холста, которого в cmux-next пока нет"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ต้องใช้เลย์เอาต์แคนวาส ซึ่ง cmux-next ยังไม่มี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kanvas yerleşimi gerekiyor; cmux-next’te henüz yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "потрібен макет полотна, якого cmux-next ще не має"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cần bố cục canvas, cmux-next chưa có"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要画布布局，但 cmux-next 尚不支持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要畫布佈局，但 cmux-next 尚未提供"
          }
        }
      }
    },
    "handlers.refusal.closedTabPaneGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the closed tab's pane is gone and no pane is focused"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたタブのペインがなくなっていて、フォーカス中のペインもありません"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جزء علامة التبويب المغلقة لم يعد موجودًا ولا يوجد جزء مركّز عليه"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "panel zatvorenog taba više ne postoji i nijedan panel nije fokusiran"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "den lukkede fanes rude findes ikke længere, og ingen rude har fokus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "das Teilfenster des geschlossenen Tabs existiert nicht mehr und kein Teilfenster ist fokussiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el panel de la pestaña cerrada ya no existe y no hay ningún panel enfocado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "le volet de l’onglet fermé n’existe plus et aucun volet n’est actif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "il pannello della scheda chiusa non esiste più e nessun pannello è attivo"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទាំងរបស់ថេបដែលបានបិទលែងមាន ហើយគ្មានផ្ទាំងកំពុងផ្ដោត"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "닫은 탭의 분할 창이 없고 포커스된 분할 창도 없음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ruten til den lukkede fanen finnes ikke, og ingen rute er fokusert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "panel zamkniętej karty już nie istnieje, a żaden panel nie jest aktywny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o painel da aba fechada não existe mais e nenhum painel está focado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "панели закрытой вкладки больше нет, и активной панели нет"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บานหน้าต่างของแท็บที่ปิดไปแล้วไม่มีอยู่ และไม่มีบานหน้าต่างที่โฟกัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kapatılan sekmenin bölmesi yok ve odakta bölme yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "панелі закритої вкладки вже немає, і жодна панель не активна"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "khung của tab đã đóng không còn và không có khung nào đang tập trung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已关闭标签页所在的窗格已不存在，且没有聚焦的窗格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已關閉標籤頁的窗格已不存在，且沒有聚焦的窗格"
          }
        }
      }
    },
    "handlers.refusal.cloudPaneUnported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "needs the Cloud panel as a pane (not in cmux-next yet)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインとしての Cloud パネルが必要です(cmux-next にはまだありません)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب لوحة Cloud كجزء (غير متوفرة في cmux-next بعد)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "potreban je Cloud panel kao panel (još nije u cmux-next)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kræver Cloud-panelet som rude (endnu ikke i cmux-next)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "erfordert das Cloud-Panel als Teilfenster (noch nicht in cmux-next)"
          }
