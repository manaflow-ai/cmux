    "handlers.refusal.agentTabSessionConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the chat in this tab changed on another device: it keeps that chat after relaunch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブのチャットは別のデバイスで変更されました: 再起動後はそのチャットが表示されます"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
