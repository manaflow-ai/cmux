    "handlers.refusal.pinnedTabKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned tabs stay open. Right-click the tab and choose Close Tab to close it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めしたタブは開いたままになります。閉じるには、タブを右クリックして「タブを閉じる」を選択してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى علامات التبويب المثبتة مفتوحة. انقر بزر الماوس الأيمن على علامة التبويب واختر إغلاق علامة التبويب لإغلاقها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikačene kartice ostaju otvorene. Desnom tipkom kliknite karticu i odaberite Zatvori karticu da je zatvorite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fastgjorte faner forbliver åbne. Højreklik på fanen, og vælg Luk fane for at lukke den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Angeheftete Tabs bleiben offen. Klicke mit der rechten Maustaste auf den Tab und wähle „Tab schließen“, um ihn zu schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pestañas fijadas permanecen abiertas. Haz clic derecho en la pestaña y elige Cerrar pestaña para cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les onglets épinglés restent ouverts. Cliquez avec le bouton droit sur l’onglet et choisissez Fermer l’onglet pour le fermer."
          }
