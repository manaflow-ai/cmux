    "handlers.refusal.markUnreadUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "needs daemon capability %@ (only marking read is supported)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デーモン機能 %@ が必要です(既読にする操作のみ対応しています)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب قدرة الخدمة %@ (التعليم كمقروء فقط مدعوم)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "potrebna je mogućnost daemona %@ (podržano je samo označavanje kao pročitano)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kræver dæmonfunktionen %@ (kun markering som læst understøttes)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "erfordert die Daemon-Fähigkeit %@ (nur „als gelesen markieren“ wird unterstützt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "requiere la capacidad del daemon %@ (solo se admite marcar como leída)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nécessite la capacité daemon %@ (seul le marquage comme lu est pris en charge)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "richiede la funzionalità del daemon %@ (è supportato solo segnare come letto)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ត្រូវការសមត្ថភាព daemon %@ (គាំទ្រតែការសម្គាល់ថាបានអានប៉ុណ្ណោះ)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "데몬 기능 %@이(가) 필요함(읽음으로 표시만 지원됨)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "krever daemonfunksjonen %@ (bare merking som lest støttes)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "wymaga funkcji demona %@ (obsługiwane jest tylko oznaczanie jako przeczytane)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "requer a capacidade do daemon %@ (só é possível marcar como lida)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нужна возможность демона %@ (поддерживается только отметка о прочтении)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ต้องใช้ความสามารถ daemon %@ (รองรับเฉพาะการทำเครื่องหมายว่าอ่านแล้ว)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "arka plan hizmeti yeteneği gerekiyor: %@ (yalnızca okundu işaretleme destekleniyor)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "потрібна можливість демона %@ (підтримується лише позначення прочитаним)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cần khả năng daemon %@ (chỉ hỗ trợ đánh dấu đã đọc)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要守护进程能力 %@（仅支持标记为已读）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要背景程式功能 %@（僅支援標記為已讀）"
          }
        }
      }
    },
