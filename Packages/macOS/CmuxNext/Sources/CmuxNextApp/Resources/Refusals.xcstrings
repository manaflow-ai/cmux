          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta karta pokazuje localhost maszyny w chmurze przez jej proxy, więc pozostaje w Chromium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta aba mostra o localhost de uma máquina na nuvem pelo proxy dela, então ela continua no Chromium."
          }
        },
        "ru": {
