        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segnare come non letto non è ancora disponibile. Si può solo segnare come letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読にする操作はまだ利用できません。既読にする操作のみ利用できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការសម្គាល់ថាមិនទាន់អានមិនទាន់មាននៅឡើយ។ មានតែការសម្គាល់ថាបានអានប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "읽지 않음으로 표시는 아직 사용할 수 없습니다. 읽음으로 표시만 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merking som ulest er ikke tilgjengelig ennå. Bare merking som lest er det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oznaczanie jako nieprzeczytane nie jest jeszcze dostępne. Można tylko oznaczyć jako przeczytane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Marcar como não lido ainda não está disponível. Só é possível marcar como lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пометка как непрочитанного пока недоступна. Доступна только пометка как прочитанного."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังทำเครื่องหมายว่ายังไม่อ่านไม่ได้ ทำได้เฉพาะทำเครื่องหมายว่าอ่านแล้ว"
