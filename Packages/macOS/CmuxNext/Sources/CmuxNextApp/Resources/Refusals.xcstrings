        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cuộc trò chuyện trong thẻ này đã thay đổi trên thiết bị khác: sau khi mở lại sẽ giữ cuộc trò chuyện đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此标签页中的聊天已在另一台设备上更改:重新启动后将保留那个聊天"
