    "handlers.refusal.restartToUpdateDaemon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’s background service is out of date. Quit and reopen cmux to update it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خدمة cmux في الخلفية قديمة. أغلق cmux وافتحه من جديد لتحديثها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozadinski servis za cmux je zastario. Zatvorite i ponovo otvorite cmux da ga ažurirate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux’ baggrundstjeneste er forældet. Afslut og åbn cmux igen for at opdatere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Hintergrunddienst von cmux ist veraltet. Beende cmux und öffne es erneut, um ihn zu aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El servicio en segundo plano de cmux está desactualizado. Cierra y vuelve a abrir cmux para actualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le service d’arrière-plan de cmux est obsolète. Quittez puis rouvrez cmux pour le mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il servizio in background di cmux non è aggiornato. Esci e riapri cmux per aggiornarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のバックグラウンドサービスが古くなっています。cmux を終了して再度開くと更新されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សេវាផ្ទៃខាងក្រោយរបស់ cmux ហួសសម័យ។ បិទ ហើយបើក cmux ម្តងទៀត ដើម្បីធ្វើបច្ចុប្បន្នភាពវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 백그라운드 서비스가 오래되었습니다. cmux를 종료한 후 다시 열면 업데이트됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bakgrunnstjenesten til cmux er utdatert. Avslutt og åpne cmux på nytt for å oppdatere den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usługa w tle cmux jest nieaktualna. Zamknij i ponownie otwórz cmux, aby ją zaktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O serviço em segundo plano do cmux está desatualizado. Feche e abra o cmux novamente para atualizá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фоновая служба cmux устарела. Закройте и снова откройте cmux, чтобы обновить её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บริการเบื้องหลังของ cmux ล้าสมัย ปิดแล้วเปิด cmux ใหม่เพื่ออัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux arka plan hizmeti güncel değil. Güncellemek için cmux’tan çıkıp yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
