            "value": "l’élément lié n’existe plus : il a été fermé ou supprimé, ou sa machine n’est pas connectée"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنصر المرتبط لم يعد موجودًا: أُغلق أو حُذف، أو أن جهازه غير متصل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el elemento enlazado ya no está: se cerró o se eliminó, o su máquina no está conectada"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結的項目已不存在:已關閉或刪除,或其機器未連線"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接的项目已不存在:已关闭或删除,或其机器未连接"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크된 항목이 없음: 닫혔거나 삭제되었거나 해당 머신이 연결되어 있지 않음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク先の項目がありません: 閉じられたか削除されたか、そのマシンが接続されていません"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "povezana stavka više ne postoji: zatvorena je ili obrisana, ili njen računar nije povezan"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "det linkede element findes ikke længere: det blev lukket eller slettet, eller dets maskine er ikke forbundet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "l'elemento collegato non esiste più: è stato chiuso o eliminato, oppure la sua macchina non è connessa"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ធាតុដែលបានភ្ជាប់មិនមានទៀតទេ៖ វាត្រូវបានបិទ ឬលុប ឬម៉ាស៊ីនរបស់វាមិនបានភ្ជាប់"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "det lenkede elementet finnes ikke lenger: det ble lukket eller slettet, eller maskinen er ikke tilkoblet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "połączony element zniknął: został zamknięty lub usunięty albo jego maszyna nie jest połączona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o item vinculado não existe mais: foi fechado ou excluído, ou a máquina dele não está conectada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "связанный элемент больше не существует: он закрыт или удалён, либо его машина не подключена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีรายการที่ลิงก์ไว้แล้ว: ถูกปิดหรือลบ หรือเครื่องของรายการนั้นไม่ได้เชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bağlantılı öğe artık yok: kapatıldı veya silindi ya da makinesi bağlı değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "пов’язаного елемента більше немає: його закрито чи видалено, або його машина не під’єднана"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "mục được liên kết không còn: đã bị đóng hoặc xóa, hoặc máy của nó chưa kết nối"
          }
        }
      }
    },
