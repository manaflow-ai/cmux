    "bookmarks.importBrowser.fullDiskAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: cmux needs Full Disk Access to read its bookmarks. Allow it in System Settings, or export them from %1$@ as an HTML file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: يحتاج cmux إلى الوصول الكامل إلى القرص لقراءة إشاراته المرجعية. اسمح بذلك في إعدادات النظام، أو صدّرها من %1$@ كملف HTML."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux treba potpuni pristup disku da pročita njegove oznake. Dozvolite to u postavkama sistema ili ih izvezite iz %1$@ kao HTML datoteku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux skal have fuld diskadgang for at læse bogmærkerne. Tillad det i Systemindstillinger, eller eksportér dem fra %1$@ som en HTML-fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux braucht Festplattenvollzugriff, um die Lesezeichen zu lesen. Erlaube ihn in den Systemeinstellungen oder exportiere sie aus %1$@ als HTML-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux necesita acceso total al disco para leer sus marcadores. Permítelo en Ajustes del Sistema o expórtalos desde %1$@ como archivo HTML."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ : cmux a besoin de l'accès complet au disque pour lire ses signets. Autorisez-le dans Réglages Système, ou exportez-les depuis %1$@ en fichier HTML."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux ha bisogno dell'accesso completo al disco per leggere i segnalibri. Consentilo in Impostazioni di Sistema oppure esportali da %1$@ come file HTML."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: ブックマークを読むには cmux にフルディスクアクセスが必要です。システム設定で許可するか、%1$@ からHTMLファイルとして書き出してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@៖ cmux ត្រូវការការចូលប្រើថាសពេញលេញ ដើម្បីអានចំណាំរបស់វា។ អនុញ្ញាតវានៅក្នុងការកំណត់ប្រព័ន្ធ ឬនាំចេញវាពី %1$@ ជាឯកសារ HTML។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: 북마크를 읽으려면 cmux에 전체 디스크 접근 권한이 필요합니다. 시스템 설정에서 허용하거나 %1$@에서 HTML 파일로 내보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux trenger full disktilgang for å lese bokmerkene. Tillat det i Systeminnstillinger, eller eksporter dem fra %1$@ som en HTML-fil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux potrzebuje pełnego dostępu do dysku, aby odczytać zakładki. Zezwól na to w Ustawieniach systemowych lub wyeksportuj je z %1$@ jako plik HTML."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: o cmux precisa de Acesso Total ao Disco para ler os favoritos. Permita nos Ajustes do Sistema ou exporte-os do %1$@ como arquivo HTML."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux нужен полный доступ к диску, чтобы прочитать закладки. Разрешите его в Системных настройках или экспортируйте их из %1$@ в HTML-файл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux ต้องมีสิทธิ์เข้าถึงดิสก์ทั้งหมดเพื่ออ่านบุ๊กมาร์ก อนุญาตในการตั้งค่าระบบ หรือส่งออกจาก %1$@ เป็นไฟล์ HTML"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux'un yer imlerini okuması için Tam Disk Erişimi gerekir. Sistem Ayarları'nda izin verin veya bunları %1$@ uygulamasından HTML dosyası olarak dışa aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux потрібен повний доступ до диска, щоб прочитати закладки. Дозвольте його в Системних параметрах або експортуйте їх із %1$@ як HTML-файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: cmux cần Quyền truy cập toàn bộ ổ đĩa để đọc dấu trang. Cho phép trong Cài đặt hệ thống, hoặc xuất chúng từ %1$@ thành tệp HTML."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@：cmux 需要“完全磁盘访问权限”才能读取其书签。请在系统设置中允许，或从 %1$@ 将书签导出为 HTML 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@：cmux 需要「完整磁碟取用權限」才能讀取其書籤。請在系統設定中允許，或從 %1$@ 將書籤匯出為 HTML 檔案。"
          }
        }
      }
    },
    "bookmarks.importBrowser.exportFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps bookmarks in its own format. Export them from %1$@ as an HTML file, then choose the file."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحفظ %1$@ الإشارات المرجعية بتنسيقه الخاص. صدّرها من %1$@ كملف HTML، ثم اختر الملف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ čuva oznake u vlastitom formatu. Izvezite ih iz %1$@ kao HTML datoteku, zatim odaberite datoteku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ gemmer bogmærker i sit eget format. Eksportér dem fra %1$@ som en HTML-fil, og vælg derefter filen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ speichert Lesezeichen in einem eigenen Format. Exportiere sie aus %1$@ als HTML-Datei und wähle dann die Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ guarda los marcadores en su propio formato. Expórtalos desde %1$@ como archivo HTML y luego elige el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ conserve les signets dans son propre format. Exportez-les depuis %1$@ en fichier HTML, puis choisissez le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ salva i segnalibri in un formato proprio. Esportali da %1$@ come file HTML, poi scegli il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ は独自の形式でブックマークを保存しています。%1$@ からHTMLファイルとして書き出し、そのファイルを選んでください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ រក្សាទុកចំណាំក្នុងទម្រង់ផ្ទាល់ខ្លួន។ នាំចេញវាពី %1$@ ជាឯកសារ HTML រួចជ្រើសឯកសារនោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@는 자체 형식으로 북마크를 저장합니다. %1$@에서 HTML 파일로 내보낸 다음 그 파일을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ lagrer bokmerker i sitt eget format. Eksporter dem fra %1$@ som en HTML-fil, og velg deretter filen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ przechowuje zakładki we własnym formacie. Wyeksportuj je z %1$@ jako plik HTML, a potem wybierz ten plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O %1$@ guarda os favoritos em formato próprio. Exporte-os do %1$@ como arquivo HTML e depois escolha o arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ хранит закладки в своём формате. Экспортируйте их из %1$@ в HTML-файл, затем выберите этот файл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ เก็บบุ๊กมาร์กในรูปแบบของตัวเอง ส่งออกจาก %1$@ เป็นไฟล์ HTML แล้วเลือกไฟล์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ yer imlerini kendi biçiminde saklar. Bunları %1$@ uygulamasından HTML dosyası olarak dışa aktarın, ardından dosyayı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ зберігає закладки у власному форматі. Експортуйте їх із %1$@ як HTML-файл, потім виберіть цей файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ lưu dấu trang theo định dạng riêng. Hãy xuất chúng từ %1$@ thành tệp HTML rồi chọn tệp đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 以自己的格式保存书签。请从 %1$@ 将书签导出为 HTML 文件，然后选择该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 以自己的格式儲存書籤。請從 %1$@ 將書籤匯出為 HTML 檔案，然後選擇該檔案。"
          }
        }
      }
    },
