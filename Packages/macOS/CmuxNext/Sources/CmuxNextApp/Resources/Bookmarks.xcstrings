    "bookmarks.refusal.cannotBookmark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page cannot be bookmarked"
          }
        },
        "ar": {
          "stringUnit": {
