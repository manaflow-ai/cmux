    "bookmarks.importBrowser.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the browser profiles to import. Each one goes into its own folder on the Bookmarks Bar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر ملفات تعريف المتصفح المراد استيرادها. يوضع كل منها في مجلد خاص به على شريط الإشارات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberite profile preglednika za uvoz. Svaki ide u vlastitu mapu na traci oznaka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg de browserprofiler, der skal importeres. Hver får sin egen mappe på bogmærkelinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle die Browserprofile zum Importieren. Jedes kommt in einen eigenen Ordner in der Lesezeichenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige los perfiles de navegador que quieres importar. Cada uno va a su propia carpeta en la barra de marcadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez les profils de navigateur à importer. Chacun va dans son propre dossier de la barre de signets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli i profili del browser da importare. Ognuno va in una propria cartella nella barra dei segnalibri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読み込むブラウザのプロファイルを選んでください。それぞれブックマークバーの専用フォルダに入ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ជ្រើសប្រវត្តិរូបកម្មវិធីរុករកដែលត្រូវនាំចូល។ នីមួយៗចូលទៅក្នុងថតផ្ទាល់ខ្លួននៅលើរបារចំណាំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져올 브라우저 프로필을 선택하세요. 각 프로필은 북마크 막대의 개별 폴더에 들어갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg nettleserprofilene som skal importeres. Hver havner i sin egen mappe på bokmerkelinjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz profile przeglądarki do zaimportowania. Każdy trafi do osobnego folderu na pasku zakładek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha os perfis de navegador para importar. Cada um vai para a própria pasta na barra de favoritos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите профили браузера для импорта. Каждый попадёт в свою папку на панели закладок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกโปรไฟล์เบราว์เซอร์ที่จะนำเข้า แต่ละโปรไฟล์จะอยู่ในโฟลเดอร์ของตัวเองบนแถบบุ๊กมาร์ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İçe aktarılacak tarayıcı profillerini seçin. Her biri yer imleri çubuğunda kendi klasörüne gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть профілі браузера для імпорту. Кожен потрапить у власну папку на панелі закладок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn các hồ sơ trình duyệt cần nhập. Mỗi hồ sơ vào một thư mục riêng trên thanh dấu trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择要导入的浏览器配置文件。每个配置文件放入书签栏上各自的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇要匯入的瀏覽器設定檔。每個設定檔放入書籤列上各自的資料夾。"
          }
        }
      }
    },
    "bookmarks.importBrowser.none": {
      "extractionState": "manual",
      "localizations": {
