    "components.acpmux.behind" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: runs %1$@, this app has %2$@. Update All restarts it; every agent keeps running."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: يعمل بالإصدار %1$@، وهذا التطبيق يتضمن %2$@. يعيد «تحديث الكل» تشغيله؛ ويستمر كل وكيل في العمل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: pokreće %1$@, ova aplikacija ima %2$@. „Ažuriraj sve“ ga ponovo pokreće; svi tác tửi nastavljaju raditi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: kører %1$@, denne app har %2$@. “Opdater alle” genstarter den; alle tác tửer kører videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: läuft mit %1$@, diese App enthält %2$@. „Alle aktualisieren“ startet es neu; alle Agents laufen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: ejecuta %1$@ y esta app incluye %2$@. «Actualizar todo» lo reinicia; todos los tác tửes siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux : exécute %1$@, cette app contient %2$@. « Tout mettre à jour » le redémarre ; tous les tác tửs continuent de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: esegue %1$@, questa app include %2$@. “Aggiorna tutto” lo riavvia; tutti gli tác tửi restano attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux：%1$@を実行中、このアプリには%2$@が含まれています。「すべてアップデート」で再起動します。すべてのエージェントは実行を続けます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux៖ កំពុងដំណើរការ %1$@ កម្មវិធីនេះមាន %2$@។ «ធ្វើបច្ចុប្បន្នភាពទាំងអស់» នឹងចាប់ផ្ដើមវាឡើងវិញ ហើយភ្នាក់ងារទាំងអស់នៅតែដំណើរការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: %1$@ 실행 중, 이 앱에는 %2$@이(가) 있습니다. '모두 업데이트'로 재시작하며, 모든 에이전트는 계속 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: kjører %1$@, denne appen har %2$@. «Oppdater alle» starter den på nytt; alle tác tửer fortsetter å kjøre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: działa w wersji %1$@, ta aplikacja ma %2$@. „Zaktualizuj wszystko” uruchamia go ponownie; wszyscy agenci działają dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: executa %1$@, este app tem %2$@. “Atualizar tudo” o reinicia; todos os tác tửes continuam em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: работает версия %1$@, в приложении — %2$@. «Обновить все» перезапустит его; все агенты продолжат работу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acpmux: ใช้ %1$@ อยู่ แอปนี้มี %2$@ “อัปเดตทั้งหมด” จะรีสตาร์ทโดยที่เอเจนต์ทั้งหมดยังทำงานต่อ"
