    "components.app.available" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: version %2$@ is available. Update All installs it and restarts cmux when no agent is busy."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: الإصدار %2$@ متاح. يثبّته «تحديث الكل» ويعيد تشغيل cmux عندما لا يكون أي وكيل مشغولًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: dostupna je verzija %2$@. „Ažuriraj sve“ je instalira i ponovo pokreće cmux kada nijedan tác tử nije zauzet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: version %2$@ er tilgængelig. “Opdater alle” installerer den og genstarter cmux, når ingen tác tử er optaget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: Version %2$@ ist verfügbar. „Alle aktualisieren“ installiert sie und startet cmux neu, sobald kein Agent beschäftigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: la versión %2$@ está disponible. «Actualizar todo» la instala y reinicia cmux cuando ningún tác tửe esté ocupado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@ : la version %2$@ est disponible. « Tout mettre à jour » l’installe et redémarre cmux dès qu’aucun tác tử n’est occupé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: è disponibile la versione %2$@. “Aggiorna tutto” la installa e riavvia cmux quando nessun tác tửe è occupato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@：バージョン%2$@が利用可能です。「すべてアップデート」でインストールし、ビジー状態のエージェントがないときにcmuxを再起動します。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@៖ មានកំណែ %2$@ ហើយ។ «ធ្វើបច្ចុប្បន្នភាពទាំងអស់» នឹងដំឡើងវា ហើយចាប់ផ្ដើម cmux ឡើងវិញនៅពេលគ្មានភ្នាក់ងារណាជាប់រវល់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: 버전 %2$@을(를) 사용할 수 있습니다. '모두 업데이트'를 누르면 설치하고, 작업 중인 에이전트가 없을 때 cmux를 재시작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: versjon %2$@ er tilgjengelig. «Oppdater alle» installerer den og starter cmux på nytt når ingen tác tử er opptatt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: dostępna jest wersja %2$@. „Zaktualizuj wszystko” instaluje ją i uruchamia ponownie cmux, gdy żaden tác tử nie jest zajęty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: a versão %2$@ está disponível. “Atualizar tudo” a instala e reinicia o cmux quando nenhum tác tửe estiver ocupado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: доступна версия %2$@. «Обновить все» установит её и перезапустит cmux, когда ни один агент не будет занят."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmux %1$@: มีเวอร์ชัน %2$@ พร้อมใช้งาน “อัปเดตทั้งหมด” จะติดตั้งและรีสตาร์ท cmux เมื่อไม่มีเอเจนต์ใดทำงานอยู่"
          }
        },
        "tr" : {
