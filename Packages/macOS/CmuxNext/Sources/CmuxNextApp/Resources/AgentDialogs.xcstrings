            "state": "needs_review",
            "value": "無法編碼答案"
          }
        }
      }
    },
    "agentDialogs.nameTheItem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This question has several items; give each selection as ITEM=CHOICE (the item's id, prompt or header)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この質問には複数の項目があります。各選択を ITEM=CHOICE（項目の ID、質問文、または見出し）の形で指定してください"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لهذا السؤال عدة عناصر؛ اكتب كل اختيار بالشكل ITEM=CHOICE (معرّف العنصر أو نصه أو عنوانه)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovo pitanje ima više stavki; navedite svaki izbor kao ITEM=CHOICE (ID, tekst ili naslov stavke)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette spørgsmål har flere punkter; angiv hvert valg som ITEM=CHOICE (punktets id, tekst eller overskrift)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Frage hat mehrere Punkte; gib jede Auswahl als ITEM=CHOICE an (ID, Text oder Überschrift des Punkts)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pregunta tiene varios elementos; indica cada selección como ITEM=CHOICE (el id, el texto o el encabezado del elemento)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette question comporte plusieurs éléments ; indiquez chaque choix sous la forme ITEM=CHOICE (id, texte ou titre de l’élément)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa domanda ha più elementi; indica ogni scelta come ITEM=CHOICE (id, testo o intestazione dell’elemento)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សំណួរនេះមានធាតុច្រើន; សូមផ្ដល់ជម្រើសនីមួយៗជា ITEM=CHOICE (id, អត្ថបទ ឬចំណងជើងរបស់ធាតុ)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 질문에는 항목이 여러 개 있습니다. 각 선택을 ITEM=CHOICE(항목의 ID, 질문문 또는 제목) 형식으로 지정하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette spørsmålet har flere punkter; oppgi hvert valg som ITEM=CHOICE (punktets id, tekst eller overskrift)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To pytanie ma kilka elementów; podaj każdy wybór jako ITEM=CHOICE (id, treść lub nagłówek elementu)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pergunta tem vários itens; informe cada seleção como ITEM=CHOICE (o id, o texto ou o cabeçalho do item)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этом вопросе несколько пунктов; укажите каждый выбор как ITEM=CHOICE (id, текст или заголовок пункта)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำถามนี้มีหลายรายการ ให้ระบุแต่ละตัวเลือกเป็น ITEM=CHOICE (id ข้อความ หรือหัวข้อของรายการ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sorunun birden çok öğesi var; her seçimi ITEM=CHOICE biçiminde verin (öğenin kimliği, metni veya başlığı)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У цьому запитанні кілька пунктів; вкажіть кожен вибір як ITEM=CHOICE (id, текст або заголовок пункту)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Câu hỏi này có nhiều mục; hãy ghi mỗi lựa chọn dạng ITEM=CHOICE (id, nội dung hoặc tiêu đề của mục)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此问题有多个条目；请将每个选择写成 ITEM=CHOICE（条目的 ID、问题文本或标题）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此問題有多個項目；請將每個選擇寫成 ITEM=CHOICE（項目的 ID、問題文字或標題）"
          }
        }
      }
    },
    "agentDialogs.noAcpmux": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent daemon (acpmux) answers in this app"
          }
        },
        "ja": {
