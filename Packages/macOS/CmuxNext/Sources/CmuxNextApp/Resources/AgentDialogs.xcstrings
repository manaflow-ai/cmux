    "agentDialogs.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pending dialog %@; it may have been answered or ended"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のダイアログ %@ はありません。すでに回答されたか終了した可能性があります"
