            "state": "needs_review",
            "value": "Die Antwort passt nicht zur Frage: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La respuesta no encaja con la pregunta: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La réponse ne correspond pas à la question : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La risposta non corrisponde alla domanda: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចម្លើយមិនត្រូវនឹងសំណួរ: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "답변이 질문에 맞지 않습니다: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaret passer ikke til spørsmålet: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odpowiedź nie pasuje do pytania: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A resposta não corresponde à pergunta: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ответ не подходит к вопросу: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำตอบไม่ตรงกับคำถาม: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yanıt soruya uymuyor: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відповідь не відповідає запитанню: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Câu trả lời không khớp với câu hỏi: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "答案与问题不符：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "答案與問題不符：%@"
          }
        }
      }
    },
    "agentDialogs.encodeFailed": {
      "extractionState": "manual",
      "localizations": {
