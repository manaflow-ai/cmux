{
  "sourceLanguage": "en",
  "strings": {
    "agentDialogs.allowRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a deny can be sent here; a person approves permissions in cmux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは拒否のみ送信できます。権限の許可は cmux で本人が行います"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن إرسال الرفض فقط هنا؛ يوافق الشخص على الأذونات في cmux"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovdje se može poslati samo odbijanje; osoba odobrava dozvole u cmux-u"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her kan kun et afslag sendes; en person godkender tilladelser i cmux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hier kann nur eine Ablehnung gesendet werden; Berechtigungen genehmigt eine Person in cmux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aquí solo se puede enviar una denegación; una persona aprueba los permisos en cmux"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seul un refus peut être envoyé ici ; une personne approuve les autorisations dans cmux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qui si può inviare solo un rifiuto; i permessi li approva una persona in cmux"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅទីនេះអាចផ្ញើបានតែការបដិសេធប៉ុណ្ណោះ; មនុស្សម្នាក់អនុម័តការអនុញ្ញាតនៅក្នុង cmux"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기서는 거부만 보낼 수 있습니다. 권한 승인은 사람이 cmux에서 합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Her kan bare et avslag sendes; en person godkjenner tillatelser i cmux"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutaj można wysłać tylko odmowę; uprawnienia zatwierdza osoba w cmux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aqui só é possível enviar uma negação; uma pessoa aprova as permissões no cmux"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Здесь можно отправить только отказ; разрешения одобряет человек в cmux"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ส่งได้เฉพาะการปฏิเสธที่นี่ การอนุมัติสิทธิ์ต้องทำโดยบุคคลใน cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Burada yalnızca ret gönderilebilir; izinleri cmux'ta bir kişi onaylar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тут можна надіслати лише відмову; дозволи схвалює людина в cmux"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ở đây chỉ có thể gửi từ chối; quyền do một người phê duyệt trong cmux"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处只能发送拒绝；权限需由本人在 cmux 中批准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此處只能傳送拒絕；權限需由本人在 cmux 中核准"
          }
        }
      }
    },
    "agentDialogs.badAnswer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer does not fit the question: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が質問に合いません: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الإجابة لا تناسب السؤال: %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odgovor ne odgovara pitanju: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svaret passer ikke til spørgsmålet: %@"
          }
        },
        "de": {
