        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen ventende dialog %@; den kan være besvart eller avsluttet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak oczekującego okna %@; mogło zostać już obsłużone lub zakończone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma caixa de diálogo pendente %@; ela pode ter sido respondida ou encerrada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет ожидающего диалога %@; возможно, на него уже ответили или он завершился"
