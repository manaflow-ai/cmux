          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر ترميز الإجابة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odgovor nije moguće kodirati"
          }
        },
        "da": {
