    "agentDialogs.notQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dialog is a permission, not a question; it can only be denied"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このダイアログは質問ではなく権限です。拒否のみできます"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مربع الحوار هذا إذن وليس سؤالًا؛ يمكن رفضه فقط"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj dijalog je dozvola, a ne pitanje; može se samo odbiti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne dialog er en tilladelse, ikke et spørgsmål; den kan kun afvises"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Dialog ist eine Berechtigung, keine Frage; er kann nur abgelehnt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este diálogo es un permiso, no una pregunta; solo se puede denegar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette boîte de dialogue est une autorisation, pas une question ; elle ne peut qu’être refusée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa finestra è un permesso, non una domanda; può solo essere rifiutata"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្រអប់នេះជាការអនុញ្ញាត មិនមែនជាសំណួរទេ; អាចបដិសេធបានតែប៉ុណ្ណោះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 대화 상자는 질문이 아니라 권한입니다. 거부만 할 수 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne dialogen er en tillatelse, ikke et spørsmål; den kan bare avslås"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To okno to uprawnienie, a nie pytanie; można je tylko odrzucić"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta caixa de diálogo é uma permissão, não uma pergunta; só pode ser negada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот диалог — разрешение, а не вопрос; его можно только отклонить"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กล่องโต้ตอบนี้เป็นสิทธิ์ ไม่ใช่คำถาม ปฏิเสธได้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu iletişim kutusu bir soru değil, izindir; yalnızca reddedilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей діалог — дозвіл, а не запитання; його можна лише відхилити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hộp thoại này là quyền, không phải câu hỏi; chỉ có thể từ chối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此对话框是权限而非问题；只能拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此對話框是權限而非問題；只能拒絕"
          }
        }
      }
    },
