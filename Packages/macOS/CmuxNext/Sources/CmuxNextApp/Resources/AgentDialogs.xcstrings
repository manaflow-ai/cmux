          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein ausstehender Dialog %@; er wurde vielleicht beantwortet oder beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay ningún diálogo pendiente %@; puede que se haya respondido o terminado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune boîte de dialogue en attente %@ ; elle a peut-être reçu une réponse ou pris fin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna finestra in attesa %@; potrebbe essere stata risposta o chiusa"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានប្រអប់កំពុងរង់ចាំ %@ ទេ; វាអាចត្រូវបានឆ្លើយ ឬបានបញ្ចប់"
