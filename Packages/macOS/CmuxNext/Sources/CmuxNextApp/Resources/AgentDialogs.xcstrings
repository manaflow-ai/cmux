          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen agentdemon (acpmux) svarer i denne appen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "W tej aplikacji nie odpowiada żaden demon agentów (acpmux)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum daemon de agentes (acpmux) responde neste app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этом приложении не отвечает ни один демон агентов (acpmux)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีเดมอนเอเจนต์ (acpmux) ตอบสนองในแอปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu uygulamada yanıt veren bir ajan arka plan programı (acpmux) yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У цьому застосунку не відповідає жоден демон агентів (acpmux)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có daemon tác nhân (acpmux) nào phản hồi trong ứng dụng này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此应用中没有响应的代理守护进程（acpmux）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 App 中沒有回應的代理常駐程式（acpmux）"
          }
        }
      }
    },
    "agentDialogs.noRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply needs `request_id`"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信には `request_id` が必要です"
          }
        },
        "ar": {
          "stringUnit": {
