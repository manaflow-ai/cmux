{
  "sourceLanguage": "en",
  "strings": {
    "extensions.failed.needsChromiumTab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus a Chromium tab first; extensions run in Chromium tabs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ركّز على علامة تبويب Chromium أولًا؛ تعمل الامتدادات في علامات تبويب Chromium."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo fokusirajte Chromium karticu; ekstenzije rade u Chromium karticama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokusér først en Chromium-fane; udvidelser kører i Chromium-faner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle zuerst einen Chromium-Tab; Erweiterungen laufen in Chromium-Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enfoca primero una pestaña de Chromium; las extensiones se ejecutan en pestañas de Chromium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez d’abord un onglet Chromium ; les extensions s’exécutent dans les onglets Chromium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metti prima a fuoco una scheda Chromium; le estensioni funzionano nelle schede Chromium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先に Chromium タブにフォーカスしてください。拡張機能は Chromium タブで動作します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សូមផ្ដោតលើផ្ទាំង Chromium ជាមុនសិន ផ្នែកបន្ថែមដំណើរការក្នុងផ្ទាំង Chromium។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 Chromium 탭에 포커스를 두세요. 확장 기능은 Chromium 탭에서 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokuser en Chromium-fane først; utvidelser kjører i Chromium-faner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw ustaw fokus na karcie Chromium; rozszerzenia działają w kartach Chromium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foque uma aba do Chromium primeiro; as extensões funcionam em abas do Chromium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала выберите вкладку Chromium: расширения работают во вкладках Chromium."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฟกัสแท็บ Chromium ก่อน ส่วนขยายทำงานในแท็บ Chromium"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce bir Chromium sekmesine odaklanın; uzantılar Chromium sekmelerinde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спочатку виберіть вкладку Chromium: розширення працюють у вкладках Chromium."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy chọn một thẻ Chromium trước; tiện ích mở rộng chạy trong thẻ Chromium."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先聚焦一个 Chromium 标签页；扩展程序在 Chromium 标签页中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先聚焦 Chromium 分頁；擴充功能會在 Chromium 分頁中執行。"
          }
        }
      }
    },
    "extensions.failed.needsFork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensions can't be changed from here. Use Manage Extensions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن تغيير الامتدادات من هنا. استخدم «إدارة الامتدادات»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekstenzije se ne mogu mijenjati odavde. Koristite Upravljaj ekstenzijama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udvidelser kan ikke ændres herfra. Brug Administrer udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erweiterungen lassen sich hier nicht ändern. Nutze „Erweiterungen verwalten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las extensiones no se pueden cambiar desde aquí. Usa Administrar extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les extensions ne peuvent pas être modifiées ici. Utilisez Gérer les extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le estensioni non si possono modificare da qui. Usa Gestisci estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ここでは拡張機能を変更できません。「拡張機能を管理」を使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចផ្លាស់ប្តូរផ្នែកបន្ថែមពីទីនេះបានទេ។ សូមប្រើ គ្រប់គ្រងផ្នែកបន្ថែម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "여기에서는 확장 기능을 변경할 수 없습니다. 확장 기능 관리를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utvidelser kan ikke endres herfra. Bruk Administrer utvidelser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozszerzeń nie można zmieniać tutaj. Użyj Zarządzaj rozszerzeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível alterar extensões aqui. Use Gerenciar extensões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Здесь нельзя изменить расширения. Используйте «Управление расширениями»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปลี่ยนส่วนขยายจากที่นี่ไม่ได้ ใช้ จัดการส่วนขยาย แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uzantılar buradan değiştirilemez. Uzantıları yönet’i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тут не можна змінити розширення. Скористайтеся «Керувати розширеннями»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể thay đổi tiện ích mở rộng ở đây. Hãy dùng Quản lý tiện ích mở rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法在此处更改扩展程序。请使用“管理扩展程序”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法在此處變更擴充功能。請使用「管理擴充功能」。"
          }
        }
      }
    },
    "extensions.failed.needsPane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a tab first, then try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر على علامة تبويب أولًا، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo kliknite karticu, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klik først på en fane, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klicke zuerst auf einen Tab und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haz clic primero en una pestaña y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cliquez d’abord sur un onglet, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fai prima clic su una scheda, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先にタブをクリックしてから、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ចុចផ្ទាំងមួយជាមុនសិន រួចសាកល្បងម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 탭을 클릭한 다음 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klikk på en fane først, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw kliknij kartę, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clique em uma aba primeiro e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала щёлкните вкладку, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลิกแท็บก่อน แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce bir sekmeye tıklayın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спершу клацніть вкладку, потім спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy bấm vào một thẻ trước, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先点按一个标签页，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先點按一個分頁，然後再試一次。"
          }
        }
      }
    },
