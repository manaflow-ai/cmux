{
  "sourceLanguage": "en",
  "strings": {
    "extensions.failed.needsChromiumTab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus a Chromium tab first; extensions run in Chromium tabs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ركّز على علامة تبويب Chromium أولًا؛ تعمل الامتدادات في علامات تبويب Chromium."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo fokusirajte Chromium karticu; ekstenzije rade u Chromium karticama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokusér først en Chromium-fane; udvidelser kører i Chromium-faner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle zuerst einen Chromium-Tab; Erweiterungen laufen in Chromium-Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enfoca primero una pestaña de Chromium; las extensiones se ejecutan en pestañas de Chromium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez d’abord un onglet Chromium ; les extensions s’exécutent dans les onglets Chromium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Metti prima a fuoco una scheda Chromium; le estensioni funzionano nelle schede Chromium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先に Chromium タブにフォーカスしてください。拡張機能は Chromium タブで動作します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សូមផ្ដោតលើផ្ទាំង Chromium ជាមុនសិន ផ្នែកបន្ថែមដំណើរការក្នុងផ្ទាំង Chromium។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 Chromium 탭에 포커스를 두세요. 확장 기능은 Chromium 탭에서 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokuser en Chromium-fane først; utvidelser kjører i Chromium-faner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw ustaw fokus na karcie Chromium; rozszerzenia działają w kartach Chromium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foque uma aba do Chromium primeiro; as extensões funcionam em abas do Chromium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала выберите вкладку Chromium: расширения работают во вкладках Chromium."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฟกัสแท็บ Chromium ก่อน ส่วนขยายทำงานในแท็บ Chromium"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce bir Chromium sekmesine odaklanın; uzantılar Chromium sekmelerinde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спочатку виберіть вкладку Chromium: розширення працюють у вкладках Chromium."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy chọn một thẻ Chromium trước; tiện ích mở rộng chạy trong thẻ Chromium."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先聚焦一个 Chromium 标签页；扩展程序在 Chromium 标签页中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先聚焦 Chromium 分頁；擴充功能會在 Chromium 分頁中執行。"
          }
        }
      }
    },
    "extensions.failed.needsFork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Chromium runtime cannot manage extensions; use Manage Extensions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن لبيئة Chromium هذه إدارة الامتدادات؛ استخدم «إدارة الامتدادات»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovo Chromium okruženje ne može upravljati ekstenzijama; koristite Upravljaj ekstenzijama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Chromium-runtime kan ikke administrere udvidelser; brug Administrer udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Chromium-Laufzeit kann keine Erweiterungen verwalten; nutze „Erweiterungen verwalten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este entorno de Chromium no puede administrar extensiones; usa Administrar extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet environnement Chromium ne peut pas gérer les extensions ; utilisez Gérer les extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo runtime Chromium non può gestire le estensioni; usa Gestisci estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Chromium ランタイムは拡張機能を管理できません。「拡張機能を管理」を使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ដំណើរការ Chromium នេះមិនអាចគ្រប់គ្រងផ្នែកបន្ថែមបានទេ សូមប្រើ គ្រប់គ្រងផ្នែកបន្ថែម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Chromium 런타임은 확장 기능을 관리할 수 없습니다. 확장 기능 관리를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne Chromium-kjøretiden kan ikke administrere utvidelser; bruk Administrer utvidelser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To środowisko Chromium nie może zarządzać rozszerzeniami; użyj Zarządzaj rozszerzeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este runtime do Chromium não pode gerenciar extensões; use Gerenciar extensões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта среда Chromium не может управлять расширениями; используйте «Управление расширениями»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รันไทม์ Chromium นี้จัดการส่วนขยายไม่ได้ ใช้ จัดการส่วนขยาย แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Chromium çalışma ortamı uzantıları yönetemez; Uzantıları yönet’i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Це середовище Chromium не може керувати розширеннями; скористайтеся «Керувати розширеннями»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Môi trường Chromium này không thể quản lý tiện ích mở rộng; hãy dùng Quản lý tiện ích mở rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Chromium 运行时无法管理扩展程序；请使用“管理扩展程序”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 Chromium 執行環境無法管理擴充功能；請使用「管理擴充功能」。"
          }
        }
      }
    },
