    "extensions.failed.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium refused the change (policy, or the extension cannot be changed)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفض Chromium التغيير (سياسة، أو لا يمكن تغيير الامتداد)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium je odbio promjenu (pravilo ili se ekstenzija ne može mijenjati)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chromium afviste ændringen (politik, eller udvidelsen kan ikke ændres)."
