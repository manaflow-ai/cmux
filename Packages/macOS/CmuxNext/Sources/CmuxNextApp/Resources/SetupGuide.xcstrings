{
  "sourceLanguage": "en",
  "strings": {
    "setupGuide.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Setup Guide"}},
        "de": {"stringUnit":{"state":"translated","value":"Einrichtungsanleitung"}},
        "fr": {"stringUnit":{"state":"translated","value":"Guide de configuration"}},
        "ar": {"stringUnit":{"state":"translated","value":"دليل الإعداد"}},
        "es": {"stringUnit":{"state":"translated","value":"Guía de configuración"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"設定指南"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"设置指南"}},
        "ko": {"stringUnit":{"state":"translated","value":"설정 안내"}},
        "ja": {"stringUnit":{"state":"translated","value":"セットアップガイド"}}
      }
    },
    "setupGuide.harness.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Start an agent on this Mac"}},
        "de": {"stringUnit":{"state":"translated","value":"Einen Agenten auf diesem Mac starten"}},
        "fr": {"stringUnit":{"state":"translated","value":"Démarrer un agent sur ce Mac"}},
        "ar": {"stringUnit":{"state":"translated","value":"بدء تشغيل وكيل على هذا الـ Mac"}},
        "es": {"stringUnit":{"state":"translated","value":"Iniciar un agente en este Mac"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"在這部 Mac 上啟動代理程式"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在此 Mac 上启动代理"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 Mac에서 에이전트 시작"}},
        "ja": {"stringUnit":{"state":"translated","value":"この Mac でエージェントを開始"}}
      }
    },
    "setupGuide.harness.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Open the model picker and choose + to see Harnesses. Install a provider, then use Sign In and finish its browser or terminal instructions."}},
        "de": {"stringUnit":{"state":"translated","value":"Öffne die Modellauswahl und wähle +, um die Harnesses zu sehen. Installiere einen Anbieter, wähle dann „Anmelden“ und folge den Anweisungen im Browser oder Terminal."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ouvrez le sélecteur de modèles et choisissez + pour afficher les harnesses. Installez un fournisseur, puis utilisez « Se connecter » et suivez ses instructions dans le navigateur ou le terminal."}},
        "ar": {"stringUnit":{"state":"translated","value":"افتح منتقي النماذج واختر + لعرض أدوات التشغيل. ثبّت موفّرًا، ثم استخدم «تسجيل الدخول» واتبع تعليماته في المتصفح أو الطرفية."}},
        "es": {"stringUnit":{"state":"translated","value":"Abre el selector de modelos y elige + para ver los harnesses. Instala un proveedor, usa «Iniciar sesión» y completa sus instrucciones en el navegador o el terminal."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"開啟模型選擇器並選取 + 以查看 Harness。安裝提供者，然後使用「登入」並完成瀏覽器或終端機中的指示。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"打开模型选择器并选择 + 以查看 Harness。安装一个提供方，然后选择“登录”，完成浏览器或终端中的说明。"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 선택기를 열고 +를 선택해 Harness를 확인하세요. 제공자를 설치한 다음 ‘로그인’을 사용하고 브라우저 또는 터미널의 안내를 완료하세요."}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルピッカーを開き、+ を選択して Harness を表示します。プロバイダーをインストールし、「サインイン」を使ってブラウザーまたはターミナルの指示を完了します。"}}
      }
    },
    "setupGuide.harness.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Run cmux setup harness to check the result. Follow the recovery it reports for that profile; unknown sign-in evidence does not confirm a working account."}},
        "de": {"stringUnit":{"state":"translated","value":"Führe cmux setup harness aus, um das Ergebnis zu prüfen. Folge der für dieses Profil gemeldeten Wiederherstellung; unbekannte Anmeldeinformationen bestätigen kein funktionierendes Konto."}},
        "fr": {"stringUnit":{"state":"translated","value":"Exécutez cmux setup harness pour vérifier le résultat. Suivez la récupération indiquée pour ce profil ; des informations de connexion inconnues ne confirment pas qu’un compte fonctionne."}},
        "ar": {"stringUnit":{"state":"translated","value":"شغّل cmux setup harness للتحقق من النتيجة. اتبع خطوات الاسترداد التي يذكرها ذلك الملف التعريفي؛ والدليل غير المعروف على تسجيل الدخول لا يؤكد أن الحساب يعمل."}},
        "es": {"stringUnit":{"state":"translated","value":"Ejecuta cmux setup harness para comprobar el resultado. Sigue la recuperación que indique para ese perfil; una autenticación desconocida no confirma que la cuenta funcione."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"執行 cmux setup harness 來檢查結果。按照該設定檔回報的復原步驟操作；未知的登入憑證不能證明帳戶可用。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"运行 cmux setup harness 检查结果。按照该配置文件报告的恢复步骤操作；未知的登录凭据不能证明账户可用。"}},
        "ko": {"stringUnit":{"state":"translated","value":"cmux setup harness를 실행해 결과를 확인하세요. 해당 프로필에서 보고한 복구 절차를 따르세요. 알 수 없는 로그인 증거만으로는 계정이 작동한다고 확인할 수 없습니다."}},
        "ja": {"stringUnit":{"state":"translated","value":"cmux setup harness を実行して結果を確認します。そのプロファイルが示す復旧手順に従ってください。サインインの証拠が不明な場合、アカウントが動作しているとは確認できません。"}}
      }
    },
    "setupGuide.accounts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Recover a sign-in"}},
        "de": {"stringUnit":{"state":"translated","value":"Eine Anmeldung wiederherstellen"}},
        "fr": {"stringUnit":{"state":"translated","value":"Récupérer une connexion"}},
        "ar": {"stringUnit":{"state":"translated","value":"استرداد تسجيل الدخول"}},
        "es": {"stringUnit":{"state":"translated","value":"Recuperar un inicio de sesión"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"復原登入"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"恢复登录"}},
        "ko": {"stringUnit":{"state":"translated","value":"로그인 복구"}},
        "ja": {"stringUnit":{"state":"translated","value":"サインインを復旧"}}
      }
    },
    "setupGuide.accounts.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Open Settings > Accounts. Use Sign In for a missing provider or Re-authenticate for an expired one, then check again."}},
        "de": {"stringUnit":{"state":"translated","value":"Öffne Einstellungen > Accounts. Verwende „Anmelden“ für einen fehlenden Anbieter oder „Erneut authentifizieren“ für einen abgelaufenen, und prüfe danach erneut."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ouvrez Réglages > Comptes. Utilisez « Se connecter » pour un fournisseur manquant ou « Réauthentifier » pour un fournisseur expiré, puis vérifiez à nouveau."}},
        "ar": {"stringUnit":{"state":"translated","value":"افتح الإعدادات > الحسابات. استخدم «تسجيل الدخول» لموفّر مفقود أو «إعادة المصادقة» لموفّر منتهٍ، ثم تحقّق مرة أخرى."}},
        "es": {"stringUnit":{"state":"translated","value":"Abre Ajustes > Cuentas. Usa «Iniciar sesión» para un proveedor que falte o «Volver a autenticar» para uno caducado y comprueba de nuevo."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"開啟「設定」>「帳號」。缺少提供者時使用「登入」，提供者過期時使用「重新驗證」，然後再次檢查。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"打开“设置”>“账户”。缺少提供方时使用“登录”，提供方过期时使用“重新认证”，然后再次检查。"}},
        "ko": {"stringUnit":{"state":"translated","value":"설정 > 계정을 여세요. 제공자가 없으면 ‘로그인’을, 만료되었으면 ‘다시 인증’을 사용한 뒤 다시 확인하세요."}},
        "ja": {"stringUnit":{"state":"translated","value":"設定 > アカウントを開きます。プロバイダーがない場合は「サインイン」、期限切れの場合は「再認証」を使い、その後もう一度確認します。"}}
      }
    },
    "setupGuide.accounts.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"For the wrong cmux account, use Switch Account and check the masked address. For a missing or unreadable saved key, use Add Key; never paste the secret into a chat."}},
        "de": {"stringUnit":{"state":"translated","value":"Wenn das falsche cmux-Konto ausgewählt ist, verwende „Konto wechseln“ und prüfe die maskierte Adresse. Für einen fehlenden oder nicht lesbaren gespeicherten Schlüssel verwende „Schlüssel hinzufügen“; füge das Geheimnis niemals in einen Chat ein."}},
        "fr": {"stringUnit":{"state":"translated","value":"Si le mauvais compte cmux est sélectionné, utilisez « Changer de compte » et vérifiez l’adresse masquée. Pour une clé enregistrée manquante ou illisible, utilisez « Ajouter une clé » ; ne collez jamais le secret dans un chat."}},
        "ar": {"stringUnit":{"state":"translated","value":"إذا اخترت حساب cmux الخطأ، فاستخدم «تبديل الحساب» وتحقّق من العنوان المقنّع. إذا كان مفتاح محفوظ مفقودًا أو يتعذّر قراءته، فاستخدم «إضافة مفتاح»؛ ولا تلصق السر في محادثة أبدًا."}},
        "es": {"stringUnit":{"state":"translated","value":"Si elegiste la cuenta de cmux equivocada, usa «Cambiar de cuenta» y comprueba la dirección enmascarada. Si falta una clave guardada o no se puede leer, usa «Añadir clave»; nunca pegues el secreto en un chat."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"如果選錯 cmux 帳戶，請使用「切換帳戶」並核對遮罩地址。如果儲存的金鑰遺失或無法讀取，請使用「加入金鑰」；絕不要將密鑰貼到聊天中。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"如果选错了 cmux 账户，请使用“切换账户”并核对掩码地址。如果保存的密钥缺失或无法读取，请使用“添加密钥”；绝不要把密钥粘贴到聊天中。"}},
        "ko": {"stringUnit":{"state":"translated","value":"잘못된 cmux 계정을 선택했다면 ‘계정 전환’을 사용하고 마스킹된 주소를 확인하세요. 저장된 키가 없거나 읽을 수 없으면 ‘키 추가’를 사용하세요. 비밀을 채팅에 붙여 넣지 마세요."}},
        "ja": {"stringUnit":{"state":"translated","value":"cmux アカウントを間違えて選んだ場合は「アカウントを切り替える」を使い、マスクされたアドレスを確認します。保存済みキーがない、または読み取れない場合は「キーを追加」を使い、秘密をチャットに貼り付けないでください。"}}
      }
    },
    "setupGuide.accounts.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"If the command or browser reports offline, reconnect before retrying. If Cloud is unavailable, retry when the service returns; local work can continue."}},
        "de": {"stringUnit":{"state":"translated","value":"Wenn der Befehl oder Browser „offline“ meldet, stelle die Verbindung wieder her, bevor du es erneut versuchst. Wenn Cloud nicht verfügbar ist, versuche es erneut, sobald der Dienst wieder erreichbar ist; lokale Arbeit kann fortgesetzt werden."}},
        "fr": {"stringUnit":{"state":"translated","value":"Si la commande ou le navigateur indique que vous êtes hors ligne, reconnectez-vous avant de réessayer. Si Cloud est indisponible, réessayez lorsque le service sera de nouveau disponible ; le travail local peut continuer."}},
        "ar": {"stringUnit":{"state":"translated","value":"إذا أبلغ الأمر أو المتصفح بأنك غير متصل، فأعد الاتصال قبل إعادة المحاولة. وإذا كانت Cloud غير متاحة، فأعد المحاولة عند عودة الخدمة؛ ويمكن متابعة العمل المحلي."}},
        "es": {"stringUnit":{"state":"translated","value":"Si el comando o el navegador indica que no hay conexión, vuelve a conectarte antes de reintentarlo. Si Cloud no está disponible, inténtalo de nuevo cuando el servicio vuelva; el trabajo local puede continuar."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"如果指令或瀏覽器回報離線，請重新連線後再重試。如果 Cloud 無法使用，請等服務恢復後重試；本機工作可以繼續。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"如果命令或浏览器报告离线，请重新连接后再重试。如果 Cloud 不可用，请在服务恢复后重试；本地工作可以继续。"}},
        "ko": {"stringUnit":{"state":"translated","value":"명령이나 브라우저에 오프라인이라고 표시되면 다시 연결한 후 재시도하세요. Cloud를 사용할 수 없으면 서비스가 복구된 뒤 다시 시도하세요. 로컬 작업은 계속할 수 있습니다."}},
        "ja": {"stringUnit":{"state":"translated","value":"コマンドまたはブラウザーがオフラインと報告した場合は、再接続してから再試行します。Cloud が利用できない場合は、サービスが復旧してから再試行してください。ローカル作業は続けられます。"}}
      }
    },
    "setupGuide.cloud_machine.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Use another machine"}},
        "de": {"stringUnit":{"state":"translated","value":"Eine andere Maschine verwenden"}},
        "fr": {"stringUnit":{"state":"translated","value":"Utiliser une autre machine"}},
        "ar": {"stringUnit":{"state":"translated","value":"استخدام جهاز آخر"}},
        "es": {"stringUnit":{"state":"translated","value":"Usar otra máquina"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"使用另一部機器"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"使用另一台机器"}},
        "ko": {"stringUnit":{"state":"translated","value":"다른 머신 사용"}},
        "ja": {"stringUnit":{"state":"translated","value":"別のマシンを使う"}}
      }
    },
    "setupGuide.cloud_machine.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"For a Cloud machine, sign in to cmux first, then run cmux setup cloud-machine --dry-run. Creating a machine costs money; confirm the card only when you want it."}},
        "de": {"stringUnit":{"state":"translated","value":"Für eine Cloud-Maschine melde dich zuerst bei cmux an und führe dann cmux setup cloud-machine --dry-run aus. Das Erstellen einer Maschine kostet Geld; bestätige die Karte nur, wenn du sie wirklich erstellen möchtest."}},
        "fr": {"stringUnit":{"state":"translated","value":"Pour une machine Cloud, connectez-vous d’abord à cmux, puis exécutez cmux setup cloud-machine --dry-run. La création d’une machine est payante ; ne confirmez la carte que lorsque vous souhaitez vraiment la créer."}},
        "ar": {"stringUnit":{"state":"translated","value":"بالنسبة إلى جهاز Cloud، سجّل الدخول إلى cmux أولًا، ثم شغّل cmux setup cloud-machine --dry-run. إنشاء جهاز يكلّف مالًا؛ أكّد البطاقة فقط عندما تريد إنشاءه."}},
        "es": {"stringUnit":{"state":"translated","value":"Para una máquina Cloud, inicia sesión en cmux y ejecuta cmux setup cloud-machine --dry-run. Crear una máquina cuesta dinero; confirma la tarjeta solo cuando quieras crearla."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"對於 Cloud 機器，請先登入 cmux，然後執行 cmux setup cloud-machine --dry-run。建立機器會產生費用；只有在確實想建立時才確認卡片。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"对于 Cloud 机器，请先登录 cmux，然后运行 cmux setup cloud-machine --dry-run。创建机器会产生费用；只有在确实要创建时才确认卡片。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Cloud 머신을 사용하려면 먼저 cmux에 로그인한 다음 cmux setup cloud-machine --dry-run을 실행하세요. 머신을 만들면 비용이 발생하므로, 정말 만들 때만 카드에서 확인하세요."}},
        "ja": {"stringUnit":{"state":"translated","value":"Cloud マシンを使うには、まず cmux にサインインしてから cmux setup cloud-machine --dry-run を実行します。マシンの作成には料金がかかるため、作成するときだけカードを確認します。"}}
      }
    },
    "setupGuide.cloud_machine.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"For an existing SSH machine, run cmux setup machine HOST. If the connection fails, use the SSH command it reports. Do not enter a password into an agent chat."}},
        "de": {"stringUnit":{"state":"translated","value":"Für eine vorhandene SSH-Maschine führe cmux setup machine HOST aus. Wenn die Verbindung fehlschlägt, verwende den gemeldeten SSH-Befehl. Gib niemals ein Passwort in einen Agenten-Chat ein."}},
        "fr": {"stringUnit":{"state":"translated","value":"Pour une machine SSH existante, exécutez cmux setup machine HOST. Si la connexion échoue, utilisez la commande SSH indiquée. N’entrez jamais un mot de passe dans un chat d’agent."}},
        "ar": {"stringUnit":{"state":"translated","value":"بالنسبة إلى جهاز SSH موجود، شغّل cmux setup machine HOST. إذا فشل الاتصال، فاستخدم أمر SSH الذي يذكره. لا تُدخل كلمة مرور في محادثة وكيل أبدًا."}},
        "es": {"stringUnit":{"state":"translated","value":"Para una máquina SSH existente, ejecuta cmux setup machine HOST. Si falla la conexión, usa el comando SSH indicado. No introduzcas nunca una contraseña en un chat de agente."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"對於現有 SSH 機器，請執行 cmux setup machine HOST。如果連線失敗，請使用它回報的 SSH 指令。絕不要在代理程式聊天中輸入密碼。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"对于现有 SSH 机器，请运行 cmux setup machine HOST。如果连接失败，请使用它报告的 SSH 命令。绝不要在代理聊天中输入密码。"}},
        "ko": {"stringUnit":{"state":"translated","value":"기존 SSH 머신을 사용하려면 cmux setup machine HOST를 실행하세요. 연결에 실패하면 안내된 SSH 명령을 사용하세요. 에이전트 채팅에 비밀번호를 입력하지 마세요."}},
        "ja": {"stringUnit":{"state":"translated","value":"既存の SSH マシンには cmux setup machine HOST を実行します。接続に失敗した場合は、報告された SSH コマンドを使ってください。エージェントチャットにパスワードを入力しないでください。"}}
      }
    },
    "setupGuide.cloud_machine.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit":{"state":"translated","value":"Run cmux setup status for the current checks and recovery steps. A detected credential is not proof that it is valid or belongs to the intended account."}},
        "de": {"stringUnit":{"state":"translated","value":"Führe cmux setup status für die aktuellen Prüfungen und Wiederherstellungsschritte aus. Erkannte Anmeldedaten sind kein Beweis dafür, dass sie gültig sind oder zum gewünschten Konto gehören."}},
        "fr": {"stringUnit":{"state":"translated","value":"Exécutez cmux setup status pour voir les vérifications et les étapes de récupération actuelles. Un identifiant détecté ne prouve pas qu’il est valide ni qu’il appartient au compte souhaité."}},
        "ar": {"stringUnit":{"state":"translated","value":"شغّل cmux setup status للتحقّق من الفحوصات الحالية وخطوات الاسترداد. اكتشاف بيانات اعتماد لا يثبت أنها صالحة أو أنها تخص الحساب المقصود."}},
        "es": {"stringUnit":{"state":"translated","value":"Ejecuta cmux setup status para ver las comprobaciones y los pasos de recuperación actuales. Detectar una credencial no demuestra que sea válida ni que pertenezca a la cuenta prevista."}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"執行 cmux setup status 以查看目前的檢查和復原步驟。偵測到憑證不代表它有效或屬於預期的帳戶。"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"运行 cmux setup status 查看当前检查和恢复步骤。检测到凭据并不能证明它有效或属于目标账户。"}},
        "ko": {"stringUnit":{"state":"translated","value":"cmux setup status를 실행해 현재 검사와 복구 단계를 확인하세요. 자격 증명이 감지되었다고 해서 유효하거나 의도한 계정에 속한다는 뜻은 아닙니다."}},
        "ja": {"stringUnit":{"state":"translated","value":"cmux setup status を実行して現在のチェックと復旧手順を確認します。認証情報が検出されたとしても、それが有効であることや目的のアカウントに属することは証明されません。"}}
      }
    }
  },
  "version": "1.0"
}
