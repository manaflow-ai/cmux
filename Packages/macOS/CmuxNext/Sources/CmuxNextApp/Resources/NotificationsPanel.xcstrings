    "browserPasskey.banner.body": {
      "comment": "Banner body: clicking brings the browser tab forward and starts the passkey prompt. %@ is the website's host name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: click to show the page and use Touch ID."
          }
        },
        "ar": {
          "stringUnit": {
