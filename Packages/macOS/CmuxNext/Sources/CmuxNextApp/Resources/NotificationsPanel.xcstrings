    "notificationsPanel.sourceClosed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab that posted this notification has closed."
          }
        },
        "ar": {
          "stringUnit": {
