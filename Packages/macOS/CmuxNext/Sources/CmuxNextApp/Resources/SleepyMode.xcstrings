{
  "sourceLanguage": "en",
  "strings": {
    "sleepy.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping this Mac awake. Press any key or click to wake."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبقى هذا الـ Mac مستيقظًا. اضغط أي مفتاح أو انقر للإيقاظ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj Mac ostaje budan. Pritisnite bilo koju tipku ili kliknite za buđenje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Holder denne Mac vågen. Tryk på en vilkårlig tast, eller klik for at vække."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Mac bleibt wach. Zum Aufwecken eine beliebige Taste drücken oder klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Manteniendo este Mac despierto. Pulsa cualquier tecla o haz clic para despertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce Mac reste éveillé. Appuyez sur une touche ou cliquez pour réveiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo Mac resta attivo. Premi un tasto o fai clic per riattivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac をスリープさせずに保っています。キーを押すかクリックすると解除します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំពុងរក្សា Mac នេះឱ្យភ្ញាក់។ ចុចគ្រាប់ចុចណាមួយ ឬចុចដើម្បីភ្ញាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac을 깨어 있는 상태로 유지하는 중입니다. 아무 키나 누르거나 클릭하면 해제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Holder denne Macen våken. Trykk på en tast eller klikk for å vekke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten Mac pozostaje wybudzony. Naciśnij dowolny klawisz lub kliknij, aby wybudzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantendo este Mac acordado. Pressione qualquer tecla ou clique para despertar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот Mac не уходит в сон. Нажмите любую клавишу или щёлкните, чтобы выйти."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังทำให้ Mac เครื่องนี้ไม่เข้าสู่โหมดพัก กดปุ่มใดก็ได้หรือคลิกเพื่อปลุก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu Mac uyanık tutuluyor. Uyandırmak için herhangi bir tuşa basın veya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей Mac не переходить у сон. Натисніть будь-яку клавішу або клацніть, щоб вийти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang giữ máy Mac này thức. Nhấn phím bất kỳ hoặc bấm để đánh thức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在让这台 Mac 保持唤醒。按任意键或点按即可唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在讓這台 Mac 保持喚醒。按任意鍵或按一下即可喚醒。"
          }
        }
      }
    },
