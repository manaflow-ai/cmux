          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekstern vertskap kunne ikke endres. Kontroller at det private nettverket ditt er tilkoblet på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można zmienić hostingu zdalnego. Sprawdź, czy Twoja sieć prywatna jest połączona na tym Macu."
