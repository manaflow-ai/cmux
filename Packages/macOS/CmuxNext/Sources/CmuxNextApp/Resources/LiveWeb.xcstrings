    "liveWeb.chooseCheckout" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a cmux checkout. cmux loads its web UI from it, and your saved edits show at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux のチェックアウトを選んでください。cmux はそこから Web UI を読み込み、保存した変更がすぐに反映されます。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر نسخة cmux. يحمّل cmux واجهة الويب منها، وتظهر تعديلاتك المحفوظة فورًا."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odaberi cmux checkout. cmux iz njega učitava web sučelje, a sačuvane izmjene se odmah vide."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg et cmux-checkout. cmux indlæser sin web-UI derfra, og dine gemte ændringer vises med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle einen cmux-Checkout. cmux lädt seine Web-UI daraus, und gespeicherte Änderungen erscheinen sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige un checkout de cmux. cmux carga su interfaz web desde él y tus cambios guardados se ven al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez un checkout cmux. cmux y charge son interface web, et vos modifications enregistrées s’affichent aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli un checkout di cmux. cmux ne carica l’interfaccia web e le modifiche salvate appaiono subito."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ជ្រើស checkout cmux។ cmux ផ្ទុក UI វេបពីវា ហើយការកែដែលបានរក្សាទុកបង្ហាញភ្លាមៗ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "cmux 체크아웃을 선택하세요. cmux가 여기서 웹 UI를 불러오고, 저장한 변경이 바로 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Velg en cmux-checkout. cmux laster nett-UI-et derfra, og lagrede endringer vises med en gang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz checkout cmux. cmux wczyta z niego interfejs WWW, a zapisane zmiany pojawią się od razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha um checkout do cmux. O cmux carrega a interface web dele, e suas edições salvas aparecem na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите checkout cmux. cmux загрузит из него веб-интерфейс, и сохранённые правки появятся сразу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เลือก checkout ของ cmux แล้ว cmux จะโหลด UI เว็บจากที่นั่น และการแก้ไขที่บันทึกจะแสดงทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir cmux checkout'u seçin. cmux web arayüzünü oradan yükler, kaydettiğiniz değişiklikler hemen görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
