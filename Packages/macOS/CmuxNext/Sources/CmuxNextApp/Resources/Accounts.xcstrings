    "accounts.refusal.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeRouter does not route this provider yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "CodeRouter はこのプロバイダにまだ対応していません。"
