    "coderouter.connect.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرسل cmux تسجيل الدخول هذا إلى CodeRouter. ويبقى خاصًا حتى تشاركه مع فريقك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux šalje ovu prijavu u CodeRouter. Ostaje privatna dok je ne podijelite s timom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sender dette login til CodeRouter. Det forbliver privat, indtil du deler det med dit team."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sendet diese Anmeldung an CodeRouter. Sie bleibt privat, bis du sie mit deinem Team teilst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux sends this sign-in to CodeRouter. It stays private until you share it with your team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux envía este inicio de sesión a CodeRouter. Sigue siendo privado hasta que lo compartas con tu equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux envoie cette connexion à CodeRouter. Elle reste privée jusqu’à ce que vous la partagiez avec votre équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux invia questo accesso a CodeRouter. Resta privato finché non lo condividi con il team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はこのサインインを CodeRouter に送信します。チームと共有するまで非公開のままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ផ្ញើការចូលនេះទៅ CodeRouter។ វានៅឯកជន រហូតដល់អ្នកចែករំលែកវាជាមួយក្រុម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux가 이 로그인을 CodeRouter로 보냅니다. 팀과 공유하기 전까지 비공개로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux sender denne innloggingen til CodeRouter. Den forblir privat til du deler den med teamet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux wyśle to logowanie do CodeRouter. Pozostanie prywatne, dopóki nie udostępnisz go zespołowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux envia este login ao CodeRouter. Ele fica privado até você compartilhá-lo com sua equipe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux отправит этот вход в CodeRouter. Он останется личным, пока вы не поделитесь им с командой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux จะส่งการลงชื่อเข้าใช้นี้ไปยัง CodeRouter และจะเป็นส่วนตัวจนกว่าคุณจะแชร์กับทีม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux bu oturumu CodeRouter'a gönderir. Ekibinizle paylaşana kadar özel kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux надішле цей вхід у CodeRouter. Він залишиться приватним, доки ви не поділитеся ним із командою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux gửi phiên đăng nhập này tới CodeRouter. Nó vẫn riêng tư cho đến khi bạn chia sẻ với nhóm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 会将此登录发送到 CodeRouter。在你与团队共享之前，它保持私有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 會將此登入傳送到 CodeRouter。在你與團隊共享之前，它保持私人。"
          }
        }
      }
    },
