{
  "sourceLanguage": "en",
  "strings": {
    "accounts.refusal.noWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a window first. The sign-in runs in a terminal tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先にウインドウを開いてください。サインインはターミナルタブで実行されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح نافذة أولًا. يجري تسجيل الدخول في علامة تبويب طرفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prvo otvorite prozor. Prijava se izvršava u kartici terminala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åbn et vindue først. Login kører i en terminalfane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne zuerst ein Fenster. Die Anmeldung läuft in einem Terminal-Tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre primero una ventana. El inicio de sesión se ejecuta en una pestaña de terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez d’abord une fenêtre. La connexion s’exécute dans un onglet de terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri prima una finestra. L’accesso viene eseguito in una scheda del terminale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "សូមបើកបង្អួចជាមុនសិន។ ការចូលដំណើរការក្នុងផ្ទាំងទែមីណាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 창을 여세요. 로그인은 터미널 탭에서 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Åpne et vindu først. Påloggingen kjører i en terminalfane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najpierw otwórz okno. Logowanie działa w karcie terminala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra uma janela primeiro. O login roda em uma aba de terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала откройте окно. Вход выполняется во вкладке терминала."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดหน้าต่างก่อน การลงชื่อเข้าใช้จะทำงานในแท็บเทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce bir pencere açın. Oturum açma bir terminal sekmesinde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спочатку відкрийте вікно. Вхід виконується у вкладці термінала."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy mở một cửa sổ trước. Việc đăng nhập chạy trong một tab terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先打开一个窗口。登录会在终端标签页中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請先開啟一個視窗。登入會在終端機分頁中執行。"
          }
        }
      }
    },
    "accounts.refusal.nothingToSignIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider has no sign-in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このプロバイダにはサインインがありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد تسجيل دخول لهذا المزود."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj provajder nema prijavu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne udbyder har ikke noget login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Anbieter hat keine Anmeldung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este proveedor no tiene inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fournisseur n’a pas de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo provider non prevede un accesso."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អ្នកផ្តល់សេវានេះគ្មានការចូលទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 제공업체에는 로그인이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne leverandøren har ingen pålogging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten dostawca nie ma logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este provedor não tem login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У этого провайдера нет входа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ผู้ให้บริการนี้ไม่มีการลงชื่อเข้าใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sağlayıcının oturum açma işlemi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей провайдер не має входу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhà cung cấp này không có đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此提供商没有登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此供應商沒有登入。"
          }
        }
      }
    },
