{
  "sourceLanguage": "en",
  "strings": {
  "access.key.title": {
    "comment": "Add API key sheet title (agent pane missing-access card); %@ is the provider (Anthropic API, OpenAI API)",
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "needs_review",
          "value": "أضف مفتاح %@ الخاص بك"
        }
      },
      "bs": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Dodajte svoj %@ ključ"
        }
      },
      "da": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Tilføj din %@-nøgle"
        }
      },
      "de": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Eigenen %@-Schlüssel hinzufügen"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Add your %@ key"
        }
      },
      "es": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Añade tu clave de %@"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ajoutez votre clé %@"
        }
      },
      "it": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Aggiungi la tua chiave %@"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "needs_review",
          "value": "%@ キーを追加"
        }
      },
      "km": {
        "stringUnit": {
          "state": "needs_review",
          "value": "បន្ថែម key %@ របស់អ្នក"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "needs_review",
          "value": "%@ 키 추가"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Legg til %@-nøkkelen din"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Dodaj swój klucz %@"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Adicione sua chave da %@"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Добавьте свой ключ %@"
        }
      },
      "th": {
        "stringUnit": {
          "state": "needs_review",
          "value": "เพิ่มคีย์ %@ ของคุณ"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "%@ anahtarınızı ekleyin"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Додайте свій ключ %@"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Thêm khóa %@ của bạn"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "needs_review",
          "value": "添加你的 %@ 密钥"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "needs_review",
          "value": "新增你的 %@ 金鑰"
        }
      }
    }
  },
  "access.key.message": {
    "comment": "Add API key sheet message; %@ is the provider",
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "needs_review",
          "value": "يبقى المفتاح في سلسلة مفاتيح هذا الـ Mac. يرسله cmux إلى %@ فقط، لمحادثات هذا الإطار."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ključ ostaje u Keychainu ovog Maca. cmux ga šalje samo na %@, za chatove ovog harnessa."
        }
      },
      "da": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Nøglen bliver i denne Macs nøglering. cmux sender den kun til %@, til denne harness' chats."
        }
      },
      "de": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Der Schlüssel bleibt im Schlüsselbund dieses Macs. cmux sendet ihn nur an %@, für die Chats dieses Harness."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The key stays in this Mac's Keychain. cmux sends it only to %@, for this harness's chats."
        }
      },
      "es": {
        "stringUnit": {
          "state": "needs_review",
          "value": "La clave se queda en el llavero de este Mac. cmux solo la envía a %@, para los chats de este harness."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "La clé reste dans le trousseau de ce Mac. cmux l’envoie uniquement à %@, pour les chats de ce harness."
        }
      },
      "it": {
        "stringUnit": {
          "state": "needs_review",
          "value": "La chiave resta nel portachiavi di questo Mac. cmux la invia solo a %@, per le chat di questo harness."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "needs_review",
          "value": "キーはこの Mac のキーチェーンに保存されます。cmux はこのハーネスのチャットのためにのみ %@ へ送信します。"
        }
      },
      "km": {
        "stringUnit": {
          "state": "needs_review",
          "value": "key នៅក្នុង Keychain របស់ Mac នេះ។ cmux ផ្ញើវាទៅ %@ តែប៉ុណ្ណោះ សម្រាប់ការជជែករបស់ harness នេះ។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "needs_review",
          "value": "키는 이 Mac의 키체인에 보관됩니다. cmux는 이 하네스의 채팅을 위해 %@에만 보냅니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Nøkkelen blir i nøkkelringen på denne Macen. cmux sender den bare til %@, for denne harnessens chatter."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Klucz zostaje w pęku kluczy tego Maca. cmux wysyła go tylko do %@, dla czatów tego harnessu."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "needs_review",
          "value": "A chave fica nas Chaves deste Mac. O cmux a envia apenas para %@, nos chats deste harness."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ключ хранится в связке ключей этого Mac. cmux отправляет его только в %@, для чатов этого harness."
        }
      },
      "th": {
        "stringUnit": {
          "state": "needs_review",
          "value": "คีย์จะอยู่ในพวงกุญแจของ Mac เครื่องนี้ cmux ส่งคีย์ไปที่ %@ เท่านั้น สำหรับแชตของ harness นี้"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Anahtar bu Mac’in Anahtar Zinciri’nde kalır. cmux onu yalnızca bu harness’ın sohbetleri için %@ hizmetine gönderir."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ключ зберігається у в’язці ключів цього Mac. cmux надсилає його лише до %@, для чатів цього harness."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Khóa được giữ trong Chuỗi khóa của máy Mac này. cmux chỉ gửi nó tới %@, cho các cuộc trò chuyện của harness này."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "needs_review",
          "value": "密钥保存在这台 Mac 的钥匙串中。cmux 只会为此 harness 的聊天将它发送给 %@。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "needs_review",
          "value": "金鑰保存在這台 Mac 的鑰匙圈中。cmux 只會為此 harness 的聊天將它傳送給 %@。"
        }
      }
    }
  },
