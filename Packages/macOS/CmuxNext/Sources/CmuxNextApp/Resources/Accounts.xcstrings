  "access.key.unsupported": {
    "comment": "Agent pane missing-access card: the chat's harness takes no API key from cmux",
    "extractionState": "manual",
    "localizations": {
      "ar": {
        "stringUnit": {
          "state": "needs_review",
          "value": "لا يقبل هذا الإطار مفتاح API من cmux. سجّل الدخول إليه أو استخدم أرصدة cmux."
        }
      },
      "bs": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ovaj harness ne prima API ključ iz cmuxa. Prijavite se u njega ili koristite cmux kredite."
        }
      },
      "da": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Denne harness tager ingen API-nøgle fra cmux. Log ind i den, eller brug cmux-kreditter."
        }
      },
      "de": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Dieser Harness nimmt keinen API-Schlüssel von cmux an. Melde dich darin an oder nutze cmux-Guthaben."
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This harness takes no API key from cmux. Sign in to it, or use cmux credits."
        }
      },
      "es": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Este harness no acepta claves de API de cmux. Inicia sesión en él o usa créditos de cmux."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ce harness n’accepte pas de clé d’API de cmux. Connectez-vous-y ou utilisez les crédits cmux."
        }
      },
      "it": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Questo harness non accetta chiavi API da cmux. Accedi oppure usa i crediti cmux."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "needs_review",
          "value": "このハーネスは cmux から API キーを受け取れません。サインインするか、cmux クレジットを使ってください。"
        }
      },
      "km": {
        "stringUnit": {
          "state": "needs_review",
          "value": "harness នេះមិនទទួល API key ពី cmux ទេ។ ចូលវា ឬប្រើ cmux credits។"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "needs_review",
          "value": "이 하네스는 cmux에서 API 키를 받지 않습니다. 로그인하거나 cmux 크레딧을 사용하세요."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Denne harnessen tar ingen API-nøkkel fra cmux. Logg inn i den, eller bruk cmux-kreditter."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Ten harness nie przyjmuje klucza API z cmux. Zaloguj się w nim lub użyj kredytów cmux."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Este harness não aceita chave de API do cmux. Entre nele ou use créditos cmux."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Этот harness не принимает ключ API от cmux. Войдите в него или используйте кредиты cmux."
        }
      },
      "th": {
        "stringUnit": {
          "state": "needs_review",
          "value": "harness นี้ไม่รับคีย์ API จาก cmux ให้ลงชื่อเข้าใช้หรือใช้เครดิต cmux"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Bu harness cmux’tan API anahtarı almaz. Oturum açın veya cmux kredisi kullanın."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Цей harness не приймає ключ API від cmux. Увійдіть у нього або скористайтеся кредитами cmux."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Harness này không nhận khóa API từ cmux. Hãy đăng nhập vào nó hoặc dùng tín dụng cmux."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "needs_review",
          "value": "此 harness 不接受来自 cmux 的 API 密钥。请登录它，或使用 cmux 额度。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
