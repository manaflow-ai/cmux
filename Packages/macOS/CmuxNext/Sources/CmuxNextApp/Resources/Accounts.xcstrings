          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เชื่อมต่อ %@ กับ CodeRouter หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ CodeRouter'a bağlansın mı?"
          }
        },
        "uk": {
          "stringUnit": {
