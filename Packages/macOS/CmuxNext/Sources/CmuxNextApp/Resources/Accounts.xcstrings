            "value": "Підключити %@ до CodeRouter?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối %@ với CodeRouter?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将 %@ 连接到 CodeRouter？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將 %@ 連接到 CodeRouter？"
          }
        }
      }
