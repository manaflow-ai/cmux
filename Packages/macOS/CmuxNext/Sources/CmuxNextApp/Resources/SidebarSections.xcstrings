{
  "sourceLanguage": "en",
  "strings": {
    "sidebarSections.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the sidebar layout refused this change (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サイドバーのレイアウトがこの変更を拒否しました（%@）"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفض تخطيط الشريط الجانبي هذا التغيير (%@)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "raspored bočne trake je odbio ovu promjenu (%@)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "sidepanelets layout afviste ændringen (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "das Seitenleistenlayout hat diese Änderung abgelehnt (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "el diseño de la barra lateral rechazó este cambio (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "la disposition de la barre latérale a refusé ce changement (%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "il layout della barra laterale ha rifiutato questa modifica (%@)"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ប្លង់របារចំហៀងបានបដិសេធការផ្លាស់ប្តូរនេះ (%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사이드바 레이아웃이 이 변경을 거부했습니다(%@)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "sidepanelets oppsett avviste endringen (%@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "układ paska bocznego odrzucił tę zmianę (%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "o layout da barra lateral recusou esta alteração (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "макет боковой панели отклонил это изменение (%@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลย์เอาต์แถบด้านข้างปฏิเสธการเปลี่ยนแปลงนี้ (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kenar çubuğu düzeni bu değişikliği reddetti (%@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "макет бічної панелі відхилив цю зміну (%@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "bố cục thanh bên đã từ chối thay đổi này (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "边栏布局拒绝了此更改（%@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "側邊欄佈局拒絕了此變更（%@）"
          }
        }
      }
    },
    "sidebarSections.noSuchSection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no such sidebar section"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "該当するサイドバーのセクションがありません"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد قسم كهذا في الشريط الجانبي"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "nema takvog odjeljka bočne trake"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ingen sådan sektion i sidepanelet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "kein solcher Seitenleistenabschnitt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "no existe esa sección de la barra lateral"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "section de barre latérale introuvable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "sezione della barra laterale inesistente"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានផ្នែករបារចំហៀងបែបនេះទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "해당 사이드바 섹션이 없습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ingen slik seksjon i sidepanelet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "brak takiej sekcji paska bocznego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "seção da barra lateral inexistente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "нет такого раздела боковой панели"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีส่วนนี้ในแถบด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "böyle bir kenar çubuğu bölümü yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "немає такого розділу бічної панелі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "không có mục thanh bên này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有此边栏分区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有此側邊欄區段"
          }
        }
      }
    },
