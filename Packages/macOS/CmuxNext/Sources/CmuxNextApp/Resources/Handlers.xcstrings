    "confirm.remoteLocalhost.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this workspace's localhost?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تغيير localhost لمساحة العمل هذه؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijeniti localhost ovog radnog prostora?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du ændre dette arbejdsområdes localhost?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Localhost dieses Arbeitsbereichs ändern?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar el localhost de este espacio de trabajo?"
          }
        },
        "fr": {
