    "confirm.closeWorkspaces.noUndoIncognito": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No window stays open to undo this. Incognito workspaces cannot be reopened."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すためのウィンドウは残りません。シークレットのワークスペースは再度開けません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن تبقى أي نافذة مفتوحة للتراجع عن ذلك. لا يمكن إعادة فتح مساحات العمل المتخفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedan prozor neće ostati otvoren za poništavanje. Anonimni radni prostori ne mogu se ponovo otvoriti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet vindue forbliver åbent til at fortryde dette. Inkognito-arbejdsområder kan ikke genåbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Fenster bleibt offen, um dies rückgängig zu machen. Inkognito-Arbeitsbereiche lassen sich nicht wieder öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No queda ninguna ventana abierta para deshacerlo. Los espacios de trabajo de incógnito no se pueden reabrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune fenêtre ne reste ouverte pour annuler. Les espaces de travail de navigation privée ne peuvent pas être rouverts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna finestra resta aperta per annullare. Le aree di lavoro in incognito non si possono riaprire."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានបង្អួចណានៅបើកដើម្បីមិនធ្វើវិញទេ។ កន្លែងធ្វើការអនាមិកមិនអាចបើកឡើងវិញបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업을 실행 취소할 윈도우가 남지 않습니다. 시크릿 작업 공간은 다시 열 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen vinduer forblir åpne for å angre dette. Inkognito-arbeidsområder kan ikke åpnes på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadne okno nie zostanie otwarte, aby to cofnąć. Przestrzeni roboczych incognito nie można ponownie otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma janela fica aberta para desfazer isso. Áreas de trabalho anônimas não podem ser reabertas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не останется окна, чтобы отменить это. Рабочие пространства в режиме инкогнито нельзя открыть снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จะไม่มีหน้าต่างเปิดค้างไว้ให้เลิกทำ เวิร์กสเปซแบบไม่ระบุตัวตนเปิดใหม่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu geri almak için açık pencere kalmaz. Gizli çalışma alanları yeniden açılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не залишиться вікна, щоб скасувати це. Робочі області інкогніто не можна відкрити знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không còn cửa sổ nào mở để hoàn tác. Không thể mở lại không gian làm việc ẩn danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不会留下可撤销此操作的窗口。无痕工作区无法重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不會留下可復原此操作的視窗。無痕工作區無法重新開啟。"
          }
        }
      }
    },
