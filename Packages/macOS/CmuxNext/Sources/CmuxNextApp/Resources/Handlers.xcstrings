        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Densidade “%@” criada e aplicada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Плотность «%@» создана и включена"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สร้างความหนาแน่น “%@” และสลับไปใช้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” yoğunluğu oluşturuldu ve kullanılıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
