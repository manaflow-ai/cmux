    "confirm.closeWorkspace.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still running: %@. Closing the workspace ends these processes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中: %@。ワークスペースを閉じるとこれらのプロセスは終了します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يزال قيد التشغيل: %@. يؤدي إغلاق مساحة العمل إلى إنهاء هذه العمليات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još se izvršava: %@. Zatvaranjem radnog prostora ovi procesi se završavaju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kører stadig: %@. Lukning af arbejdsområdet afslutter disse processer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Läuft noch: %@. Beim Schließen des Arbeitsbereichs werden diese Prozesse beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún en ejecución: %@. Al cerrar el espacio de trabajo se terminarán estos procesos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours en cours : %@. Fermer l’espace de travail met fin à ces processus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ancora in esecuzione: %@. La chiusura dell’area di lavoro termina questi processi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅកំពុងដំណើរការ៖ %@។ ការបិទកន្លែងធ្វើការនឹងបញ្ចប់ដំណើរការទាំងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 중: %@. 작업 공간을 닫으면 이 프로세스가 종료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjører fortsatt: %@. Når arbeidsområdet lukkes, avsluttes disse prosessene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadal działa: %@. Zamknięcie przestrzeni roboczej zakończy te procesy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda em execução: %@. Fechar a área de trabalho encerra esses processos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Еще работают: %@. Закрытие рабочего пространства завершит эти процессы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังทำงานอยู่: %@ การปิดเวิร์กสเปซจะยุติโปรเซสเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hâlâ çalışıyor: %@. Çalışma alanını kapatmak bu işlemleri sonlandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ще виконуються: %@. Закриття робочої області завершить ці процеси."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vẫn đang chạy: %@. Đóng không gian làm việc sẽ kết thúc các tiến trình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍在运行：%@。关闭工作区会结束这些进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍在執行：%@。關閉工作區會結束這些程序。"
          }
        }
      }
    },
