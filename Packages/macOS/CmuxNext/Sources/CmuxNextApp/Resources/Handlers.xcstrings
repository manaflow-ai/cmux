          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija acpmux nema ograničenje podagenata. Ažurirajte cmux da ga postavite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne version af acpmux har ingen grænse for underagenter. Opdater cmux for at angive en."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di acpmux non ha un limite di subagenti. Aggiorna cmux per impostarne uno."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែ acpmux នេះគ្មានដែនកំណត់ភ្នាក់ងាររងទេ។ ធ្វើបច្ចុប្បន្នភាព cmux ដើម្បីកំណត់វា។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen av acpmux har ingen grense for underagenter. Oppdater cmux for å angi en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja acpmux nie ma limitu podagentów. Zaktualizuj cmux, aby go ustawić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do acpmux não tem limite de subagentes. Atualize o cmux para definir um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии acpmux нет лимита субагентов. Обновите cmux, чтобы задать его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "acpmux รุ่นนี้ไม่มีขีดจำกัดเอเจนต์ย่อย อัปเดต cmux เพื่อตั้งค่า"
