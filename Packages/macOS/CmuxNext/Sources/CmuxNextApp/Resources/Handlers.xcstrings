    "confirm.closeWorkspaces.noUndo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No window stays open to undo this. Reopen Closed Workspace and History bring them back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すためのウィンドウは残りません。「閉じたワークスペースを再度開く」と履歴から戻せます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن تبقى أي نافذة مفتوحة للتراجع عن ذلك. يمكنك استعادتها من «إعادة فتح مساحة العمل المغلقة» ومن السجل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedan prozor neće ostati otvoren za poništavanje. Vratite ih pomoću Ponovo otvori zatvoreni radni prostor i Historije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet vindue forbliver åbent til at fortryde dette. Genåbn lukket arbejdsområde og Historik bringer dem tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Fenster bleibt offen, um dies rückgängig zu machen. „Geschlossenen Arbeitsbereich wieder öffnen“ und der Verlauf holen sie zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No queda ninguna ventana abierta para deshacerlo. Reabrir espacio de trabajo cerrado y el Historial los recuperan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune fenêtre ne reste ouverte pour annuler. Rouvrir l’espace de travail fermé et l’historique les restaurent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna finestra resta aperta per annullare. Riapri area di lavoro chiusa e la Cronologia le riportano indietro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានបង្អួចណានៅបើកដើម្បីមិនធ្វើវិញទេ។ បើកកន្លែងធ្វើការដែលបានបិទឡើងវិញ និងប្រវត្តិ នាំវាត្រឡប់មកវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업을 실행 취소할 윈도우가 남지 않습니다. 닫은 작업 공간 다시 열기와 기록에서 되돌릴 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen vinduer forblir åpne for å angre dette. Åpne lukket arbeidsområde på nytt og Historikk henter dem tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadne okno nie zostanie otwarte, aby to cofnąć. Przywrócisz je przez Otwórz ponownie zamkniętą przestrzeń roboczą i Historię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma janela fica aberta para desfazer isso. Reabrir Área de Trabalho Fechada e o Histórico as trazem de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не останется окна, чтобы отменить это. Их вернут «Открыть закрытое рабочее пространство» и История."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จะไม่มีหน้าต่างเปิดค้างไว้ให้เลิกทำ เปิดเวิร์กสเปซที่ปิดอีกครั้งและประวัติจะนำกลับมาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bunu geri almak için açık pencere kalmaz. Kapatılan Çalışma Alanını Yeniden Aç ve Geçmiş onları geri getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не залишиться вікна, щоб скасувати це. Їх повернуть «Знову відкрити закриту робочу область» та Історія."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không còn cửa sổ nào mở để hoàn tác. Mở lại không gian làm việc đã đóng và Lịch sử sẽ đưa chúng trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不会留下可撤销此操作的窗口。“重新打开已关闭的工作区”和历史记录可以恢复它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不會留下可復原此操作的視窗。「重新開啟已關閉的工作區」和歷史記錄可以恢復它們。"
          }
        }
      }
    },
