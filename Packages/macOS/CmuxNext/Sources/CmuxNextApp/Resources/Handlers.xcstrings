            "value": "Modifier le localhost de cet espace de travail ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare il localhost di quest’area di lavoro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースの localhost を変更しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
