    "confirm.closeWorkspace.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を閉じますか？"
          }
        }
      }
    },
    "confirm.closeWorkspace.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still running: %@. Closing the workspace ends these processes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中: %@。ワークスペースを閉じるとこれらのプロセスは終了します。"
          }
        }
      }
    },
