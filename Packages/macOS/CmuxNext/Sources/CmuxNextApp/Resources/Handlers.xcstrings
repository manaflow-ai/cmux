    "pins.workspaceCannotPin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace cannot be pinned: its machine has no shared workspace ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースはピン留めできません。そのマシンには共有ワークスペース ID がありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن تثبيت مساحة العمل هذه: جهازها لا يملك معرّف مساحة عمل مشتركًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj radni prostor se ne može zakačiti: njegova mašina nema zajednički ID radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette arbejdsområde kan ikke fastgøres: dets maskine har intet delt arbejdsområde-id."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Arbeitsbereich kann nicht angeheftet werden: Sein Rechner hat keine gemeinsame Arbeitsbereich-ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede fijar este espacio de trabajo: su máquina no tiene un ID de espacio de trabajo compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d'épingler cet espace de travail : sa machine n'a pas d'identifiant d'espace de travail partagé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile fissare questo spazio di lavoro: la sua macchina non ha un ID condiviso."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនអាចខ្ទាស់កន្លែងធ្វើការនេះបានទេ៖ ម៉ាស៊ីនរបស់វាគ្មាន ID កន្លែងធ្វើការរួម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 작업 공간은 고정할 수 없습니다. 해당 머신에 공유 작업 공간 ID가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette arbeidsområdet kan ikke festes: maskinen har ingen delt arbeidsområde-ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można przypiąć tego obszaru roboczego: jego maszyna nie ma wspólnego identyfikatora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível fixar este espaço de trabalho: a máquina dele não tem um ID compartilhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это рабочее пространство нельзя закрепить: у его машины нет общего ID рабочего пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปักหมุดพื้นที่ทำงานนี้ไม่ได้: เครื่องของมันไม่มี ID พื้นที่ทำงานที่แชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu çalışma alanı sabitlenemez: makinesinin paylaşılan çalışma alanı kimliği yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей робочий простір не можна закріпити: його машина не має спільного ID робочого простору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể ghim không gian làm việc này: máy của nó không có ID không gian làm việc dùng chung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法固定此工作区：其所在机器没有共享的工作区 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法釘選此工作區：其所在機器沒有共享的工作區 ID。"
          }
        }
      }
    },
