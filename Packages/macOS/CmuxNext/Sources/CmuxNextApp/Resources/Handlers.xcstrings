          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du endre localhost for dette arbeidsområdet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienić localhost tego obszaru roboczego?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o localhost deste espaço de trabalho?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить localhost этого рабочего пространства?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยน localhost ของพื้นที่ทำงานนี้ใช่ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
