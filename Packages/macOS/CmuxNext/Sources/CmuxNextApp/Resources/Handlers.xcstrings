    "density.created": {
      "comment": "Toast after making a custom density. %@ is its name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made density “%@” and switched to it"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم إنشاء الكثافة «%@» والتبديل إليها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napravljena je gustoća „%@” i uključena"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tætheden “%@” er oprettet og taget i brug"
