        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密度「%@」を作成して切り替えました"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានបង្កើតដង់ស៊ីតេ “%@” ហើយប្តូរទៅវា"
