{
  "sourceLanguage": "en",
  "strings": {
    "handlers.failed.appNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app named %@ was found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ という名前のアプリが見つかりません。"
          }
        }
      }
    },
    "handlers.failed.daemonOffline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux-tui daemon is not connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui デーモンに接続されていません。"
          }
        }
      }
    },
    "handlers.failed.forkClaudeOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forking is supported for Claude sessions only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォークは Claude のセッションでのみ使えます。"
          }
        }
      }
    },
    "handlers.failed.frontendBrowserTabs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daemon does not support app-rendered browser tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デーモンはアプリ描画のブラウザタブに対応していません。"
          }
        }
      }
    },
    "handlers.failed.hardReloadEngine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This browser engine cannot bypass the cache; use Reload Page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブラウザエンジンはキャッシュを無視できません。「ページを再読み込み」を使ってください。"
          }
        }
      }
    },
    "handlers.failed.markUnread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daemon cannot mark a notification unread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デーモンは通知を未読に戻せません。"
          }
        }
      }
    },
    "handlers.failed.noAgentSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The focused terminal has no agent session to fork."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたターミナルにはフォークできるエージェントセッションがありません。"
          }
        }
      }
    },
    "handlers.failed.noBrowser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No browser tab is focused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたブラウザタブがありません。"
          }
        }
      }
    },
    "handlers.failed.noFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No file is focused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたファイルがありません。"
          }
        }
      }
    },
    "handlers.failed.noPageURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page has no URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページには URL がありません。"
          }
        }
      }
    },
    "handlers.failed.noPane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pane is focused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたペインがありません。"
          }
        }
      }
    },
    "handlers.failed.noTerminal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No terminal tab is focused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたターミナルタブがありません。"
          }
        }
      }
    },
    "handlers.failed.noUnread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no unread notifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読の通知はありません。"
          }
        }
      }
    },
    "handlers.failed.noWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No window is open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているウインドウがありません。"
          }
        }
      }
    },
    "handlers.failed.notificationAck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected cmux-tui daemon does not support notification acknowledgement (notification-ack-v1)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中の cmux-tui デーモンは通知の既読処理 (notification-ack-v1) に対応していません。"
          }
        }
      }
    },
    "handlers.unavailable.agentChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent chat views are not ported to cmux-next yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントチャット表示はまだ cmux-next に移植されていません。"
          }
        }
      }
    },
    "handlers.unavailable.agentTeams": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Claude and Codex Teams launcher is not ported to cmux-next yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude / Codex Teams の起動はまだ cmux-next に移植されていません。"
          }
        }
      }
    },
    "handlers.unavailable.browserFocusMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser focus mode is not built yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのフォーカスモードはまだ実装されていません。"
          }
        }
      }
    },
    "handlers.unavailable.browserHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next keeps no browser history store yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next にはまだブラウザ履歴の保存先がありません。"
          }
        }
      }
    },
    "handlers.unavailable.browserImport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing browser data is not ported yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザデータの読み込みはまだ移植されていません。"
          }
        }
      }
    },
    "handlers.unavailable.browserProfiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser profile management is not built yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザプロファイルの管理はまだ実装されていません。"
          }
        }
      }
    },
    "handlers.unavailable.browserToggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux browser is always on in cmux-next; there is no setting to turn it off yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-next ではブラウザは常に有効です。無効にする設定はまだありません。"
          }
        }
      }
    },
    "handlers.unavailable.clearLedger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daemon has no command to clear the notification ledger; use Mark All Notifications as Read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デーモンには通知履歴を消去するコマンドがありません。「すべての通知を既読にする」を使ってください。"
          }
        }
      }
    },
    "handlers.unavailable.cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud actions arrive with the Cloud wave; cmux-next has no Cloud client yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド操作はクラウド対応のフェーズで追加されます。cmux-next にはまだクラウドクライアントがありません。"
          }
        }
      }
    },
    "handlers.unavailable.computerUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use integration is not ported to cmux-next yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 連携はまだ cmux-next に移植されていません。"
          }
        }
      }
    },
