    "subagentLimit.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of acpmux has no subagent limit. Update cmux to set one."
          }
        },
        "de": {
          "stringUnit": {
