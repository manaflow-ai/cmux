    "confirm.incognito.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still running: %@. Closing ends these processes and deletes the incognito browser data."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يزال قيد التشغيل: %@. يؤدي الإغلاق إلى إنهاء هذه العمليات وحذف بيانات التصفح المتخفي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Još se izvršava: %@. Zatvaranje završava ove procese i briše anonimne podatke preglednika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kører stadig: %@. Lukning afslutter disse processer og sletter inkognitobrowserdata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Läuft noch: %@. Schließen beendet diese Prozesse und löscht die Inkognito-Browserdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún en ejecución: %@. Al cerrar se terminan estos procesos y se eliminan los datos de navegación de incógnito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toujours en cours : %@. La fermeture arrête ces processus et supprime les données de navigation privée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ancora in esecuzione: %@. La chiusura termina questi processi ed elimina i dati di navigazione in incognito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実行中: %@。閉じるとこれらのプロセスは終了し、シークレットのブラウザデータは削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នៅតែដំណើរការ: %@។ ការបិទនឹងបញ្ចប់ដំណើរការទាំងនេះ ហើយលុបទិន្នន័យកម្មវិធីរុករកអនាមិក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아직 실행 중: %@. 닫으면 이 프로세스가 종료되고 시크릿 브라우저 데이터가 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kjører fortsatt: %@. Lukking avslutter disse prosessene og sletter inkognitonettleserdataene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadal działa: %@. Zamknięcie kończy te procesy i usuwa dane przeglądania incognito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda em execução: %@. Fechar encerra esses processos e exclui os dados de navegação anônima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ещё работает: %@. Закрытие завершит эти процессы и удалит данные браузера в режиме инкогнито."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังทำงานอยู่: %@ การปิดจะหยุดกระบวนการเหล่านี้และลบข้อมูลเบราว์เซอร์แบบไม่ระบุตัวตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hâlâ çalışıyor: %@. Kapatmak bu işlemleri sonlandırır ve gizli tarayıcı verilerini siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ще працює: %@. Закриття завершить ці процеси й видалить дані анонімного перегляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vẫn đang chạy: %@. Đóng sẽ kết thúc các tiến trình này và xóa dữ liệu duyệt ẩn danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍在运行：%@。关闭会结束这些进程并删除无痕浏览数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍在執行：%@。關閉會結束這些程序並刪除無痕瀏覽資料。"
          }
        }
      }
    },
