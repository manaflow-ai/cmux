          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre maximal de sous-agents que ce chat exécute en même temps. Les autres attendent leur tour et démarrent quand ceux en cours se terminent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقصى عدد من الوكلاء الفرعيين الذين تشغّلهم هذه المحادثة في الوقت نفسه. ينتظر الآخرون دورهم ويبدؤون عندما ينتهي العاملون."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número máximo de subagentes que este chat ejecuta a la vez. Los demás esperan su turno y empiezan cuando terminan los que están en ejecución."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天同時執行的子代理數量上限。超出的子代理排隊等候，在執行中的子代理結束後開始。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天同时运行的子代理数量上限。超出的子代理排队等待，在运行中的子代理结束后开始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅이 동시에 실행하는 하위 에이전트의 최대 개수입니다. 나머지는 차례를 기다렸다가 실행 중인 에이전트가 끝나면 시작됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットが同時に実行するサブエージェントの最大数です。それ以上は順番を待ち、実行中のものが終わると開始します。"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najveći broj podagenata koje ovaj razgovor pokreće u isto vrijeme. Ostali čekaju na red i pokreću se kad pokrenuti završe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det største antal underagenter, denne chat kører på samme tid. Flere venter på tur og starter, når kørende afslutter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero massimo di subagenti che questa chat esegue contemporaneamente. Gli altri aspettano il loro turno e partono quando quelli in esecuzione finiscono."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំនួនភ្នាក់ងាររងច្រើនបំផុតដែលការជជែកនេះដំណើរការក្នុងពេលតែមួយ។ ភ្នាក់ងារផ្សេងទៀតរង់ចាំវេន ហើយចាប់ផ្ដើមនៅពេលភ្នាក់ងារដែលកំពុងដំណើរការបញ្ចប់។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det største antallet underagenter denne chatten kjører samtidig. Flere venter på tur og starter når kjørende blir ferdige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największa liczba podagentów, które ten czat uruchamia jednocześnie. Kolejni czekają na swoją kolej i startują, gdy działający skończą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número máximo de subagentes que este chat executa ao mesmo tempo. Os demais aguardam a vez e começam quando os em execução terminam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наибольшее число субагентов, которых этот чат выполняет одновременно. Остальные ждут своей очереди и запускаются, когда работающие завершатся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเอเจนต์ย่อยสูงสุดที่แชทนี้ทำงานพร้อมกัน ส่วนที่เกินจะรอคิวและเริ่มเมื่อเอเจนต์ที่ทำงานอยู่เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbetin aynı anda çalıştırdığı en fazla alt ajan sayısı. Fazlası sırasını bekler ve çalışanlar bittikçe başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найбільша кількість субагентів, яких цей чат виконує одночасно. Решта чекають своєї черги й запускаються, коли запущені завершаться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tác tử phụ tối đa mà cuộc trò chuyện này chạy cùng lúc. Các tác tử khác chờ đến lượt và bắt đầu khi tác tử đang chạy kết thúc."
          }
        }
      }
    },
