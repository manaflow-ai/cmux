    "fileTree.noFolder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا التبويب على مجلد. افتح «الملفات» من رأس المحادثة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova kartica nema mapu. Ponovo otvorite Datoteke iz zaglavlja razgovora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fane har ingen mappe. Åbn Filer fra chattens overskrift igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tab hat keinen Ordner. Öffne „Dateien“ erneut über die Kopfzeile des Chats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tab has no folder. Open Files from the chat's header again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pestaña no tiene carpeta. Vuelve a abrir Archivos desde la cabecera del chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet onglet n’a pas de dossier. Rouvrez Fichiers depuis l’en-tête de la conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scheda non ha una cartella. Riapri File dall’intestazione della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブにはフォルダがありません。チャットのヘッダーから「ファイル」をもう一度開いてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងនេះគ្មានថតទេ។ បើក ឯកសារ ពីក្បាលការជជែកម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 탭에는 폴더가 없습니다. 채팅 헤더에서 파일을 다시 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne fanen har ingen mappe. Åpne Filer fra chattens topptekst igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta karta nie ma folderu. Otwórz ponownie Pliki z nagłówka czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aba não tem pasta. Abra Arquivos novamente pelo cabeçalho do chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой вкладки нет папки. Снова откройте «Файлы» из заголовка чата."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บนี้ไม่มีโฟลเดอร์ เปิด ไฟล์ จากส่วนหัวของแชทอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sekmenin klasörü yok. Dosyalar’ı sohbetin başlığından yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця вкладка не має папки. Знову відкрийте «Файли» із заголовка чату."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ này không có thư mục. Hãy mở lại Tệp từ phần đầu cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签页没有文件夹。请从聊天标题栏重新打开“文件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此標籤頁沒有檔案夾。請從聊天標題列重新打開「檔案」。"
          }
        }
      }
    },
    "fileTree.notRepository": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض «الملفات» المجلدات الموجودة في مستودع git. هذا المجلد ليس في مستودع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke prikazuju mape u git repozitoriju. Ova mapa nije u njemu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer viser mapper i et git-repository. Denne mappe er ikke i et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dateien“ zeigt Ordner in einem Git-Repository. Dieser Ordner liegt in keinem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files shows folders in a git repository. This folder is not in one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos muestra carpetas de un repositorio git. Esta carpeta no está en ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers affiche les dossiers d’un dépôt git. Ce dossier n’en fait pas partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File mostra le cartelle di un repository git. Questa cartella non è in un repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」は git リポジトリ内のフォルダを表示します。このフォルダはリポジトリ内にありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារ បង្ហាញថតនៅក្នុងឃ្លាំង git។ ថតនេះមិននៅក្នុងឃ្លាំងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 git 저장소의 폴더를 표시합니다. 이 폴더는 저장소에 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer viser mapper i et git-depot. Denne mappen er ikke i et."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki pokazują foldery w repozytorium git. Ten folder nie jest w żadnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos mostra pastas em um repositório git. Esta pasta não está em um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Файлы» показывает папки в репозитории git. Эта папка не находится в репозитории."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ แสดงโฟลเดอร์ในที่เก็บ git โฟลเดอร์นี้ไม่ได้อยู่ในที่เก็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar, git deposundaki klasörleri gösterir. Bu klasör bir depoda değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Файли» показує папки в репозиторії git. Ця папка не в репозиторії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp hiển thị các thư mục trong kho git. Thư mục này không nằm trong kho nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“文件”显示 git 仓库中的文件夹。此文件夹不在仓库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「檔案」顯示 git 儲存庫中的檔案夾。此檔案夾不在儲存庫中。"
          }
        }
      }
    },
    "fileTree.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر عرض الملفات. اختر «تحديث» من قائمة النقر بزر الماوس الأيمن للمحاولة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke nije moguće prikazati. Odaberite Osvježi iz menija desnog klika da pokušate ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerne kunne ikke vises. Vælg Opdater i højrekliksmenuen for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien konnten nicht aufgelistet werden. Wähle „Aktualisieren“ im Kontextmenü, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files could not be listed. Choose Refresh from the right-click menu to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron listar los archivos. Elige Actualizar en el menú contextual para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lister les fichiers. Choisissez Actualiser dans le menu contextuel pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elencare i file. Scegli Aggiorna dal menu contestuale per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを一覧表示できませんでした。右クリックメニューの「更新」を選んでもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចរាយឯកសារបានទេ។ ជ្រើស ផ្ទុកឡើងវិញ ពីម៉ឺនុយចុចខាងស្តាំ ដើម្បីព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 목록을 가져올 수 없습니다. 다시 시도하려면 오른쪽 클릭 메뉴에서 새로 고침을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filene kunne ikke vises. Velg Oppdater i høyreklikkmenyen for å prøve igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyświetlić plików. Wybierz Odśwież z menu kontekstowego, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível listar os arquivos. Escolha Atualizar no menu de contexto para tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось показать файлы. Выберите «Обновить» в контекстном меню, чтобы повторить попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแสดงรายการไฟล์ได้ เลือก รีเฟรช จากเมนูคลิกขวาเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar listelenemedi. Yeniden denemek için sağ tık menüsünden Yenile’yi seçin."
