    "confirm.allowAgent.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل تريد السماح للوكلاء في علامة التبويب هذه؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dozvoliti agente u ovoj kartici?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad agenter i denne fane?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agenten in diesem Tab erlauben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow agents in this tab?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Permitir agentes en esta pestaña?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriser les agents dans cet onglet ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consentire agenti in questa scheda?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブでエージェントを許可しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "អនុញ្ញាតភ្នាក់ងារក្នុងផ្ទាំងនេះ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 탭에서 에이전트를 허용할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillate agenter i denne fanen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwolić agentom w tej karcie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir agentes nesta aba?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешить агентов в этой вкладке?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "อนุญาตเอเจนต์ในแท็บนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu sekmede ajanlara izin verilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозволити агентів у цій вкладці?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cho phép tác tử trong thẻ này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允许此标签页中的代理？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "允許此分頁中的代理程式？"
          }
        }
      }
    },
    "confirm.allowAgent.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لـ %@ قراءة هذه الصفحة وملؤها. قد يقرأ الوكيل الذي يتحكم في علامة التبويب هذه كلمة مرور تملؤها هذه الإضافات. يستمر ذلك حتى إغلاق علامة التبويب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ može čitati i popunjavati ovu stranicu. Agent koji upravlja ovom karticom mogao bi pročitati lozinku koju ova proširenja popune. Ovo traje dok se kartica ne zatvori."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kan læse og udfylde denne side. En agent, der styrer denne fane, kan læse en adgangskode, som disse udvidelser udfylder. Det gælder, indtil fanen lukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kann diese Seite lesen und ausfüllen. Ein Agent, der diesen Tab steuert, könnte ein Passwort lesen, das diese Erweiterungen ausfüllen. Das gilt, bis der Tab geschlossen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can read and fill this page. An agent that drives this tab could read a password that these extensions fill. This lasts until the tab closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ puede leer y rellenar esta página. Un agente que controle esta pestaña podría leer una contraseña que rellenen estas extensiones. Dura hasta que se cierre la pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ peut lire et remplir cette page. Un agent qui pilote cet onglet pourrait lire un mot de passe rempli par ces extensions. Cela dure jusqu’à la fermeture de l’onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ può leggere e compilare questa pagina. Un agente che controlla questa scheda potrebbe leggere una password compilata da queste estensioni. Vale fino alla chiusura della scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのページを読み取り、入力できます。このタブを操作するエージェントは、これらの拡張機能が入力したパスワードを読み取れる可能性があります。この設定はタブを閉じるまで続きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ អាចអាន និងបំពេញទំព័រនេះ។ ភ្នាក់ងារដែលគ្រប់គ្រងផ្ទាំងនេះអាចអានពាក្យសម្ងាត់ដែលផ្នែកបន្ថែមទាំងនេះបំពេញ។ វានៅបន្តរហូតដល់បិទផ្ទាំង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@은(는) 이 페이지를 읽고 채울 수 있습니다. 이 탭을 조작하는 에이전트가 이 확장 프로그램이 채운 암호를 읽을 수 있습니다. 탭을 닫을 때까지 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ kan lese og fylle ut denne siden. En agent som styrer denne fanen, kan lese et passord som disse utvidelsene fyller ut. Dette varer til fanen lukkes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ może czytać i wypełniać tę stronę. Agent sterujący tą kartą mógłby odczytać hasło wypełnione przez te rozszerzenia. Obowiązuje do zamknięcia karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ pode ler e preencher esta página. Um agente que controla esta aba poderia ler uma senha preenchida por essas extensões. Vale até a aba ser fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ может читать и заполнять эту страницу. Агент, управляющий этой вкладкой, может прочитать пароль, который заполнят эти расширения. Действует до закрытия вкладки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ อ่านและกรอกหน้านี้ได้ เอเจนต์ที่ควบคุมแท็บนี้อาจอ่านรหัสผ่านที่ส่วนขยายเหล่านี้กรอก ใช้จนกว่าจะปิดแท็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ bu sayfayı okuyabilir ve doldurabilir. Bu sekmeyi yöneten bir ajan, bu uzantıların doldurduğu bir parolayı okuyabilir. Sekme kapanana kadar geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ може читати й заповнювати цю сторінку. Агент, що керує цією вкладкою, може прочитати пароль, який заповнять ці розширення. Діє до закриття вкладки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ có thể đọc và điền trang này. Tác tử điều khiển thẻ này có thể đọc mật khẩu mà các tiện ích này điền. Hiệu lực đến khi đóng thẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 可以读取并填写此页面。操控此标签页的代理可能读取这些扩展填写的密码。此设置持续到标签页关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 可以讀取並填寫此頁面。操控此分頁的代理程式可能讀取這些延伸功能填寫的密碼。此設定持續到分頁關閉。"
          }
        }
      }
    },
    "confirm.allowAgent.bodyNone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا توجد إضافة مفعّلة يمكنها قراءة هذه الصفحة الآن. إذا فُعّلت إضافة لاحقًا، يظل بإمكان الوكلاء التحكم في علامة التبويب حتى إغلاقها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nijedno omogućeno proširenje sada ne može čitati ovu stranicu. Ako se neko omogući kasnije, agenti i dalje mogu upravljati ovom karticom dok se ne zatvori."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen aktiveret udvidelse kan læse denne side nu. Hvis en aktiveres senere, kan agenter stadig styre fanen, indtil den lukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine aktivierte Erweiterung kann diese Seite jetzt lesen. Wird später eine aktiviert, können Agenten den Tab trotzdem steuern, bis er geschlossen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No enabled extension can read this page now. If one is enabled later, agents can still drive this tab until it closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ninguna extensión activa puede leer esta página ahora. Si se activa una más tarde, los agentes podrán seguir controlando la pestaña hasta que se cierre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune extension activée ne peut lire cette page pour l’instant. Si une est activée plus tard, les agents pourront toujours piloter l’onglet jusqu’à sa fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna estensione attiva può leggere questa pagina ora. Se ne viene attivata una in seguito, gli agenti potranno comunque controllare la scheda fino alla chiusura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、このページを読み取れる有効な拡張機能はありません。後で有効にしても、タブを閉じるまでエージェントはこのタブを操作できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បច្ចុប្បន្នគ្មានផ្នែកបន្ថែមដែលបានបើកអាចអានទំព័រនេះទេ។ ប្រសិនបើបើកមួយនៅពេលក្រោយ ភ្នាក់ងារនៅតែអាចគ្រប់គ្រងផ្ទាំងនេះរហូតដល់បិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금은 이 페이지를 읽을 수 있는 활성 확장 프로그램이 없습니다. 나중에 활성화되어도 탭을 닫을 때까지 에이전트가 이 탭을 조작할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen aktivert utvidelse kan lese denne siden nå. Hvis en aktiveres senere, kan agenter fortsatt styre fanen til den lukkes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Żadne włączone rozszerzenie nie może teraz czytać tej strony. Jeśli któreś zostanie włączone później, agenci nadal mogą sterować kartą do jej zamknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma extensão ativada pode ler esta página agora. Se uma for ativada depois, os agentes ainda poderão controlar a aba até ela ser fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сейчас ни одно включённое расширение не может читать эту страницу. Если расширение включат позже, агенты всё равно смогут управлять вкладкой до её закрытия."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขณะนี้ไม่มีส่วนขยายที่เปิดใช้อ่านหน้านี้ได้ หากเปิดใช้ภายหลัง เอเจนต์ยังควบคุมแท็บนี้ได้จนกว่าจะปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şu anda bu sayfayı okuyabilen etkin bir uzantı yok. Daha sonra biri etkinleştirilirse ajanlar sekme kapanana kadar onu yönetmeye devam edebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Зараз жодне ввімкнене розширення не може читати цю сторінку. Якщо розширення ввімкнуть пізніше, агенти все одно зможуть керувати вкладкою до її закриття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiện không có tiện ích đã bật nào đọc được trang này. Nếu bật một tiện ích sau đó, tác tử vẫn có thể điều khiển thẻ đến khi đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前没有已启用的扩展可以读取此页面。如果之后启用了扩展，代理仍可操控此标签页，直到它关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前沒有已啟用的延伸功能可以讀取此頁面。如果之後啟用了延伸功能，代理程式仍可操控此分頁，直到它關閉。"
          }
        }
      }
    },
