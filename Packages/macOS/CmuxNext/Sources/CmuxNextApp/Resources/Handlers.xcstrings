          "stringUnit": {
            "state": "needs_review",
            "value": "밀도 “%@”을(를) 만들고 전환했습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tettheten «%@» er laget og tatt i bruk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utworzono gęstość „%@” i ją włączono"
