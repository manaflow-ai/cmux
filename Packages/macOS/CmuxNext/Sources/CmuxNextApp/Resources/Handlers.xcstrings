    "confirm.userOnlySetting.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يطلب أمر تعيين %1$@ إلى %2$@. يمكنك وحدك تغيير هذا الإعداد، لذا يسألك cmux أولاً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naredba traži da se %1$@ postavi na %2$@. Samo vi možete promijeniti ovu postavku, pa vas cmux prvo pita."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En kommando vil sætte %1$@ til %2$@. Kun du kan ændre denne indstilling, så cmux spørger dig først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Befehl möchte %1$@ auf %2$@ setzen. Nur du kannst diese Einstellung ändern, daher fragt cmux zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A command asks to set %1$@ to %2$@. Only you can change this setting, so cmux asks you first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un comando pide poner %1$@ en %2$@. Solo tú puedes cambiar este ajuste, así que cmux te pregunta primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une commande demande de régler %1$@ sur %2$@. Vous seul pouvez modifier ce réglage, cmux vous le demande donc d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un comando chiede di impostare %1$@ su %2$@. Solo tu puoi modificare questa impostazione, quindi cmux te lo chiede prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドが %1$@ を %2$@ に設定しようとしています。この設定はあなただけが変更できるため、cmux が先に確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ពាក្យបញ្ជាមួយស្នើកំណត់ %1$@ ទៅ %2$@។ មានតែអ្នកទេដែលអាចប្ដូរការកំណត់នេះ ដូច្នេះ cmux សួរអ្នកជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "명령이 %1$@을(를) %2$@(으)로 설정하려고 합니다. 이 설정은 사용자만 변경할 수 있으므로 cmux가 먼저 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En kommando vil sette %1$@ til %2$@. Bare du kan endre denne innstillingen, så cmux spør deg først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Polecenie chce ustawić %1$@ na %2$@. Tylko Ty możesz zmienić to ustawienie, więc cmux najpierw pyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um comando pede para definir %1$@ como %2$@. Só você pode alterar este ajuste, então o cmux pergunta antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Команда хочет установить %1$@ в значение %2$@. Эту настройку можете изменить только вы, поэтому cmux сначала спрашивает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คำสั่งหนึ่งขอตั้งค่า %1$@ เป็น %2$@ มีเพียงคุณที่เปลี่ยนการตั้งค่านี้ได้ cmux จึงถามคุณก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir komut %1$@ ayarını %2$@ yapmak istiyor. Bu ayarı yalnızca siz değiştirebilirsiniz, bu yüzden cmux önce size soruyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Команда хоче встановити %1$@ у значення %2$@. Це налаштування можете змінити лише ви, тому cmux спершу питає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Một lệnh yêu cầu đặt %1$@ thành %2$@. Chỉ bạn mới có thể thay đổi cài đặt này, nên cmux hỏi bạn trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有命令请求将 %1$@ 设为 %2$@。此设置只能由你更改，因此 cmux 会先询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有指令要求將 %1$@ 設為 %2$@。此設定只能由你變更，因此 cmux 會先詢問你。"
          }
        }
      }
    },
