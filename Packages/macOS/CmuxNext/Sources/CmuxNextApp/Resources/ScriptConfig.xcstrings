            "value": "設定スクリプトを再読み込み"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ផ្ទុកស្គ្រីបកំណត់រចនាសម្ព័ន្ធឡើងវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정 스크립트 다시 불러오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Last inn konfigurasjonsskript på nytt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wczytaj ponownie skrypty konfiguracji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recarregar scripts de configuração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перезагрузить скрипты конфигурации"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โหลดสคริปต์การตั้งค่าใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yapılandırma betiklerini yeniden yükle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перезавантажити скрипти конфігурації"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tải lại script cấu hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新载入配置脚本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "重新載入設定腳本"
          }
        }
      }
    },
    "scriptConfig.notServed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يشغّل cmux هذا سكربتات الإعداد بعد. أعد تشغيل cmux لتحديثه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj cmux još ne pokreće konfiguracijske skripte. Ponovo pokrenite cmux da ga ažurirate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne cmux kører endnu ikke konfigurationsscripts. Genstart cmux for at opdatere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses cmux führt noch keine Konfigurationsskripte aus. Starte cmux neu, um es zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cmux does not run config scripts yet. Restart cmux to update it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este cmux aún no ejecuta scripts de configuración. Reinicia cmux para actualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce cmux n’exécute pas encore les scripts de configuration. Redémarrez cmux pour le mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo cmux non esegue ancora gli script di configurazione. Riavvia cmux per aggiornarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この cmux はまだ設定スクリプトを実行できません。cmux を再起動して更新してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux នេះមិនទាន់ដំណើរការស្គ្រីបកំណត់រចនាសម្ព័ន្ធនៅឡើយ។ ចាប់ផ្ដើម cmux ឡើងវិញដើម្បីធ្វើបច្ចុប្បន្នភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 cmux는 아직 설정 스크립트를 실행하지 않습니다. cmux를 다시 시작해 업데이트하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne cmux kjører ikke konfigurasjonsskript ennå. Start cmux på nytt for å oppdatere den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ten cmux nie uruchamia jeszcze skryptów konfiguracji. Uruchom ponownie cmux, aby go zaktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este cmux ainda não executa scripts de configuração. Reinicie o cmux para atualizá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот cmux пока не запускает скрипты конфигурации. Перезапустите cmux, чтобы обновить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux นี้ยังไม่รันสคริปต์การตั้งค่า รีสตาร์ต cmux เพื่ออัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu cmux henüz yapılandırma betiklerini çalıştırmıyor. Güncellemek için cmux’u yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цей cmux ще не запускає скрипти конфігурації. Перезапустіть cmux, щоб оновити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux này chưa chạy script cấu hình. Khởi động lại cmux để cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 cmux 尚不能运行配置脚本。请重启 cmux 以更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 cmux 尚無法執行設定腳本。請重新啟動 cmux 以更新。"
          }
        }
      }
    },
