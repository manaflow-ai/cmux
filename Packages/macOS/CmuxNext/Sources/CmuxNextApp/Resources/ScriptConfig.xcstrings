            "value": "Ponovo učitaj konfiguracijske skripte"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Genindlæs konfigurationsscripts"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konfigurationsskripte neu laden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload Config Scripts"
          }
        },
        "es": {
          "stringUnit": {
