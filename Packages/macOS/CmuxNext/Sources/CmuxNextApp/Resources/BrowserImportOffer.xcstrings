        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Daha Gösterme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше не показувати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không hiển thị lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再显示"
          }
        },
