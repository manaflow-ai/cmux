{
  "sourceLanguage": "en",
  "strings": {
    "browserImportOffer.syncStopped": {
      "comment": "Toast when keeping cookies in sync stops because the source browser's cookies can no longer be read (its Keychain key was denied or its profile is gone). %@: the browser's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped keeping cookies in sync with %@: cmux could not read them. Import again to turn it back on."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف إبقاء ملفات تعريف الارتباط متزامنة مع %@: تعذّر على cmux قراءتها. استورد مرة أخرى لإعادة تشغيله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Usklađivanje kolačića s %@ je zaustavljeno: cmux ih nije mogao pročitati. Uvezite ponovo da ga ponovo uključite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder ikke længere cookies synkroniseret med %@: cmux kunne ikke læse dem. Importér igen for at slå det til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies werden nicht mehr mit %@ synchron gehalten: cmux konnte sie nicht lesen. Importiere erneut, um es wieder einzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó de sincronizar las cookies con %@: cmux no pudo leerlas. Vuelve a importar para activarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cookies ne sont plus synchronisés avec %@ : cmux n’a pas pu les lire. Importez à nouveau pour le réactiver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione dei cookie con %@ interrotta: cmux non è riuscito a leggerli. Importa di nuovo per riattivarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ との Cookie の同期を停止しました：cmux が読み取れませんでした。もう一度インポートすると再開します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានឈប់ធ្វើសមកាលកម្មខូគីជាមួយ %@៖ cmux មិនអាចអានវាបានទេ។ នាំចូលម្ដងទៀតដើម្បីបើកវាឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와(과)의 쿠키 동기화를 중지했습니다. cmux가 쿠키를 읽을 수 없습니다. 다시 켜려면 다시 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutter å holde informasjonskapsler synkronisert med %@: cmux kunne ikke lese dem. Importer på nytt for å slå det på igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano synchronizację plików cookie z %@: cmux nie mógł ich odczytać. Zaimportuj ponownie, aby ją włączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização de cookies com %@ parou: o cmux não conseguiu lê-los. Importe novamente para reativá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация файлов cookie с %@ остановлена: cmux не смог их прочитать. Импортируйте снова, чтобы включить её."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดซิงค์คุกกี้กับ %@ แล้ว: cmux อ่านคุกกี้ไม่ได้ นำเข้าอีกครั้งเพื่อเปิดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerezler artık %@ ile eşitlenmiyor: cmux onları okuyamadı. Yeniden açmak için tekrar içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію файлів cookie з %@ зупинено: cmux не зміг їх прочитати. Імпортуйте знову, щоб увімкнути її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngừng đồng bộ cookie với %@: cmux không đọc được chúng. Hãy nhập lại để bật lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止与 %@ 同步 Cookie：cmux 无法读取它们。再次导入即可重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止與 %@ 同步 Cookie：cmux 無法讀取它們。再次匯入即可重新開啟。"
          }
        }
      }
    },
    "browserImportOffer.turnedOff": {
      "comment": "Refusal shown when an Import from Browser action runs while browser.import.enabled is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from Browser is turned off in Settings > Browser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستيراد من المتصفح متوقف في الإعدادات > المتصفح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz iz preglednika je isključen u Postavke > Preglednik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importér fra browser er slået fra i Indstillinger > Browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus Browser importieren“ ist in Einstellungen > Browser ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar desde el navegador está desactivado en Ajustes > Navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer depuis le navigateur est désactivé dans Réglages > Navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa da browser è disattivato in Impostazioni > Browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ブラウザから読み込む」は 設定 > ブラウザ でオフになっています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាំចូលពីកម្មវិធីរុករក ត្រូវបានបិទនៅក្នុង ការកំណត់ > កម្មវិធីរុករក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'브라우저에서 가져오기'가 설정 > 브라우저에서 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer fra nettleser er slått av i Innstillinger > Nettleser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj z przeglądarki jest wyłączone w Ustawienia > Przeglądarka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar do navegador está desativado em Ajustes > Navegador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Импорт из браузера» выключен в разделе Настройки > Браузер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าจากเบราว์เซอร์ ถูกปิดอยู่ใน การตั้งค่า > เบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıdan İçe Aktar, Ayarlar > Tarayıcı bölümünde kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Імпорт з браузера» вимкнено в Налаштування > Браузер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập từ trình duyệt đang tắt trong Cài đặt > Trình duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“从浏览器导入”已在“设置 > 浏览器”中关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「從瀏覽器匯入」已在「設定 > 瀏覽器」中關閉。"
          }
        }
      }
    },
