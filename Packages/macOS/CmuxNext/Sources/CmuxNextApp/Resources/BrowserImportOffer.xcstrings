            "value": "Importa i cookie da %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から Cookie を読み込む"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាំចូលខូគីពី %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 쿠키 가져오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer informasjonskapsler fra %@"
          }
        },
        "pl": {
