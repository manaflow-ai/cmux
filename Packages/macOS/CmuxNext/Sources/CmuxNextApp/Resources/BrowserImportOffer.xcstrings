          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "가져오기…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importer …"
          }
        },
        "pl": {
          "stringUnit": {
