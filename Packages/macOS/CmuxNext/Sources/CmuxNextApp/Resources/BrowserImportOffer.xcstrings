          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импортировать…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำเข้า…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İçe Aktar…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Імпортувати…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导入…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "匯入…"
          }
        }
      }
    },
    "browserImportOffer.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ليس الآن"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne sada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht jetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahora no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plus tard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non ora"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនមែនឥឡូវ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나중에"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke nå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie teraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agora Não"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не сейчас"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไว้ทีหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şimdi Değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не зараз"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以后再说"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "稍後再說"
          }
        }
      },
      "comment": "Browser-data import offer: closes it for good on this channel."
    },
    "browserImport.access.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Access"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli pristup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti accesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតការចូលប្រើ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişime İzin Ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити доступ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用"
          }
        }
      }
    },
    "browserImport.access.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select “Allow Access” to let cmux read your %@ data."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر “السماح بالوصول” للسماح لـ cmux بقراءة بيانات %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite „Dozvoli pristup“ da cmux može čitati vaše podatke iz %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg “Giv adgang” for at lade cmux læse dine data fra %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Zugriff erlauben“, damit cmux deine %@-Daten lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona «Permitir acceso» para que cmux lea tus datos de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez « Autoriser l’accès » pour que cmux lise vos données %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona «Consenti accesso» per permettere a cmux di leggere i tuoi dati di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクセスを許可」を選択すると、cmux が %@ のデータを読み取れるようになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើស «អនុញ្ញាតការចូលប្រើ» ដើម្បីឱ្យ cmux អានទិន្នន័យ %@ របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘접근 허용’을 선택하면 cmux가 %@ 데이터를 읽을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg «Gi tilgang» for å la cmux lese dataene dine fra %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Zezwól na dostęp”, aby cmux mógł odczytać dane z %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione “Permitir acesso” para que o cmux leia seus dados do %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Разрешить доступ», чтобы cmux мог прочитать ваши данные %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก “อนุญาตการเข้าถึง” เพื่อให้ cmux อ่านข้อมูล %@ ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’un %@ verilerinizi okuyabilmesi için “Erişime İzin Ver”i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Дозволити доступ», щоб cmux міг читати ваші дані %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn “Cho phép truy cập” để cmux đọc dữ liệu %@ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“允许访问”以让 cmux 读取你的 %@ 数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「允許取用」以讓 cmux 讀取你的 %@ 資料。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
