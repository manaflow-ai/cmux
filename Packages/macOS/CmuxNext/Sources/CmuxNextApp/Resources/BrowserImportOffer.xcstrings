    "browserImportOffer.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ليس الآن"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne sada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht jetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahora no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plus tard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non ora"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនមែនឥឡូវ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나중에"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke nå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie teraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
