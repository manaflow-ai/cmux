            "state": "translated",
            "value": "Importuj pliki cookie z %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar cookies do %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировать файлы cookie из %@"
          }
        },
        "th": {
