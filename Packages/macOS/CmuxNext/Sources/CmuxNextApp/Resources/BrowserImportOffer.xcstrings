{
  "sourceLanguage": "en",
  "strings": {
    "browserImportOffer.title": {
      "comment": "Browser-data import offer on the first browser tab: title. %@ is the detected browser, for example Google Chrome.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import bookmarks, history and passwords from %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استيراد الإشارات المرجعية والسجل وكلمات المرور من %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uvezi oznake, historiju i lozinke iz %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importér bogmærker, historik og adgangskoder fra %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lesezeichen, Verlauf und Passwörter aus %@ importieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importar marcadores, historial y contraseñas de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importer les signets, l’historique et les mots de passe de %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importa segnalibri, cronologia e password da %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からブックマーク、履歴、パスワードを読み込む"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "នាំចូលចំណាំ ប្រវត្តិ និងពាក្យសម្ងាត់ពី %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에서 북마크, 방문 기록, 암호 가져오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importer bokmerker, logg og passord fra %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importuj zakładki, historię i hasła z %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importar favoritos, histórico e senhas do %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импортировать закладки, историю и пароли из %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "นำเข้าบุ๊กมาร์ก ประวัติ และรหัสผ่านจาก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ uygulamasından yer imlerini, geçmişi ve parolaları içe aktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Імпортувати закладки, історію та паролі з %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhập dấu trang, lịch sử và mật khẩu từ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从 %@ 导入书签、历史记录和密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "從 %@ 匯入書籤、瀏覽記錄和密碼"
          }
        }
      }
    },
    "browserImportOffer.detail": {
      "comment": "Browser-data import offer: one line under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يغادر أي شيء جهاز Mac هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ništa ne napušta ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intet forlader denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nichts verlässt diesen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niente lascia questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはこの Mac から出ません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានអ្វីចេញពី Mac នេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어떤 데이터도 이 Mac 밖으로 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingenting forlater denne Mac-en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada sai deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ничто не покидает этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiçbir şey bu Mac’ten çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ніщо не залишає цей Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có gì rời khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有数据都不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有資料都不會離開這台 Mac。"
          }
        }
      }
    },
