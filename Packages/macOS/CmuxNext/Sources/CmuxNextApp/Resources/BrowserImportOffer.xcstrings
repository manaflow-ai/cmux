    "browserImportOffer.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ليس الآن"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne sada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nicht jetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahora no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plus tard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non ora"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "មិនមែនឥឡូវ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나중에"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikke nå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie teraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agora Não"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не сейчас"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไว้ทีหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şimdi Değil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не зараз"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以后再说"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "稍後再說"
          }
        }
      },
      "comment": "Browser-data import offer: closes it for good on this channel."
    },
    "browserImportOffer.cookies.title": {
      "comment": "Cookie import banner in browser tabs: title. %@ is the detected browser, for example Google Chrome.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import cookies from %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد ملفات تعريف الارتباط من %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvezi kolačiće iz %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importér cookies fra %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies aus %@ importieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar cookies de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer les cookies de %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa i cookie da %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から Cookie を読み込む"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នាំចូលខូគីពី %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 쿠키 가져오기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer informasjonskapsler fra %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj pliki cookie z %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar cookies do %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировать файлы cookie из %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าคุกกี้จาก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerezleri %@ uygulamasından içe aktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортувати файли cookie з %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập cookie từ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 导入 Cookie"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 %@ 匯入 Cookie"
          }
        }
      }
    },
    "browserImportOffer.cookies.detail": {
      "comment": "Cookie import banner in browser tabs: the line under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay signed in to your sites. Nothing leaves this Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابقَ مسجّل الدخول إلى مواقعك. لا شيء يغادر جهاز Mac هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostanite prijavljeni na svoje stranice. Ništa ne napušta ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbliv logget ind på dine websteder. Intet forlader denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib bei deinen Websites angemeldet. Nichts verlässt diesen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la sesión iniciada en tus sitios. Nada sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez connecté à vos sites. Rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta connesso ai tuoi siti. Nulla lascia questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトにサインインしたままにできます。データはこの Mac の外に出ません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្តចូលគណនីគេហទំព័ររបស់អ្នក។ គ្មានអ្វីចាកចេញពី Mac នេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트에 로그인된 상태를 유지합니다. 이 Mac 밖으로 나가는 것은 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbli logget på nettstedene dine. Ingenting forlater denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostań zalogowany w swoich witrynach. Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue conectado aos seus sites. Nada sai deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставайтесь в своих учётных записях на сайтах. Ничто не покидает этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้เว็บไซต์ของคุณต่อไป ไม่มีข้อมูลใดออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitelerinizde oturumunuz açık kalsın. Hiçbir şey bu Mac'ten çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишайтеся в обліковому записі на своїх сайтах. Ніщо не залишає цей Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn đăng nhập vào các trang của bạn. Không có gì rời khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持网站的登录状态。所有数据都不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持網站的登入狀態。所有資料都不會離開這台 Mac。"
          }
        }
      }
    },
    "browserImportOffer.dontShowAgain": {
      "comment": "Cookie import banner in browser tabs: the quiet link that stops the banner for good (Settings turns it back on).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Show Again"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم الإظهار مرة أخرى"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prikazuj ponovo"
          }
        },
        "da": {
          "stringUnit": {
