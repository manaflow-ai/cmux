            "state": "translated",
            "value": "นำเข้าคุกกี้จาก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerezleri %@ uygulamasından içe aktar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортувати файли cookie з %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập cookie từ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 导入 Cookie"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 %@ 匯入 Cookie"
          }
        }
      }
    },
    "browserImportOffer.dontShowAgain": {
      "comment": "Cookie import banner in browser tabs: the quiet link that stops the banner for good (Settings turns it back on).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Show Again"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم الإظهار مرة أخرى"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prikazuj ponovo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis ikke igen"
          }
        },
        "de": {
          "stringUnit": {
