    "workspaceNaming.nameFromActivity.noAgents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name from Activity needs the agent service, which is not running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティからの命名にはエージェントサービスが必要ですが、実行されていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Aktivität benennen benötigt den Agentendienst, der nicht läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommer d’après l’activité nécessite le service d’agents, qui n’est pas en cours d’exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب التسمية من النشاط خدمة الوكلاء، وهي لا تعمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombrar según la actividad necesita el servicio de agentes, que no se está ejecutando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依活動命名需要代理服務，但它未在執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据活动命名需要代理服务，但它未在运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동으로 이름 짓기에는 에이전트 서비스가 필요하지만 실행 중이 아닙니다."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imenovanje prema aktivnosti treba servis agenata, koji nije pokrenut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Navngiv ud fra aktivitet kræver agenttjenesten, som ikke kører."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nomina dall'attività richiede il servizio agenti, che non è in esecuzione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការដាក់ឈ្មោះតាមសកម្មភាពត្រូវការសេវាភ្នាក់ងារ ដែលមិនកំពុងដំណើរការ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gi navn etter aktivitet trenger agenttjenesten, som ikke kjører."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nazwanie według aktywności wymaga usługi agentów, która nie działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nomear pela atividade precisa do serviço de agentes, que não está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для названия по активности нужна служба агентов, но она не запущена."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การตั้งชื่อจากกิจกรรมต้องใช้บริการเอเจนต์ ซึ่งไม่ได้ทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etkinliğe göre adlandırma, çalışmayan ajan hizmetini gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для назви за активністю потрібна служба агентів, але вона не запущена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt tên theo hoạt động cần dịch vụ tác tử, nhưng dịch vụ này không chạy."
          }
        }
      }
    },
