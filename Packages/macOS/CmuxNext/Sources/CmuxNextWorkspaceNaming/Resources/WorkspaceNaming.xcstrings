{
  "sourceLanguage": "en",
  "strings": {
    "workspaceNaming.nameFromActivity.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not name the workspace: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースに名前を付けられませんでした: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich konnte nicht benannt werden: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de nommer l’espace de travail : %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت تسمية مساحة العمل: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo nombrar el espacio de trabajo: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法為工作區命名：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为工作区命名：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 이름을 지을 수 없습니다: %@"
          }
        }
      }
    },
    "workspaceNaming.nameFromActivity.noAgents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name from Activity needs the agent service, which is not running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティからの命名にはエージェントサービスが必要ですが、実行されていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Aktivität benennen benötigt den Agentendienst, der nicht läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommer d’après l’activité nécessite le service d’agents, qui n’est pas en cours d’exécution."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب التسمية من النشاط خدمة الوكلاء، وهي لا تعمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombrar según la actividad necesita el servicio de agentes, que no se está ejecutando."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依活動命名需要代理服務，但它未在執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据活动命名需要代理服务，但它未在运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동으로 이름 짓기에는 에이전트 서비스가 필요하지만 실행 중이 아닙니다."
          }
        }
      }
    },
    "workspaceNaming.nameFromActivity.noName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model did not suggest a name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは名前を提案しませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat keinen Namen vorgeschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’a proposé aucun nom."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقترح النموذج اسمًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no sugirió ningún nombre."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型沒有建議名稱。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型没有建议名称。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 이름을 제안하지 않았습니다."
          }
        }
      }
    },
    "workspaceNaming.nameFromActivity.noWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No workspace to name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を付けるワークスペースがありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Arbeitsbereich zum Benennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun espace de travail à nommer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة عمل لتسميتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún espacio de trabajo que nombrar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可命名的工作區。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可命名的工作区。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 지을 작업 공간이 없습니다."
          }
        }
      }
    },
    "workspaceNaming.nameFromActivity.nothing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace has no activity to name it from."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースには名前の元になるアクティビティがありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich hat keine Aktivität, nach der er benannt werden kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail n’a aucune activité d’après laquelle le nommer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي مساحة العمل هذه على نشاط لتسميتها منه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo no tiene actividad de la que tomar un nombre."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作區沒有可用來命名的活動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区没有可用于命名的活动。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간에는 이름을 지을 활동이 없습니다."
          }
        }
      }
    },
    "workspaceNaming.nameFromActivity.oldDaemon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace's machine runs an older cmux that cannot protect a rename made meanwhile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースのマシンは古い cmux を実行しており、その間に行われた名前変更を保護できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rechner dieses Arbeitsbereichs nutzt eine ältere cmux-Version, die eine zwischenzeitliche Umbenennung nicht schützen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine de cet espace de travail exécute une ancienne version de cmux qui ne peut pas protéger un renommage effectué entre-temps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل جهاز مساحة العمل هذه إصدارًا أقدم من cmux لا يمكنه حماية إعادة تسمية تمت في هذه الأثناء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina de este espacio de trabajo ejecuta una versión antigua de cmux que no puede proteger un cambio de nombre hecho mientras tanto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作區的機器執行較舊版本的 cmux，無法保護期間所做的重新命名。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区的机器运行较旧版本的 cmux，无法保护期间所做的重命名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간의 컴퓨터는 그 사이에 바꾼 이름을 보호할 수 없는 이전 cmux를 실행합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
