          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano de cmux se detuvo y no pudo volver a iniciarse. cmux sigue intentándolo."
          }
        },
        "fr": {
          "stringUnit": {
