    "daemon.recovery.failed": {
      "comment": "Status line after Restart cmux-tui did not work; Retry Now stays next to it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service could not be restarted. Try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドサービスを再起動できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إعادة تشغيل خدمة الخلفية. حاول مرة أخرى بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinsku uslugu nije moguće ponovo pokrenuti. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundstjenesten kunne ikke genstartes. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst konnte nicht neu gestartet werden. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar el servicio en segundo plano. Vuelve a intentarlo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redémarrer le service d’arrière-plan. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riavviare il servizio in background. Riprova tra un momento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចចាប់ផ្ដើមសេវាផ្ទៃខាងក្រោយឡើងវិញបានទេ។ សូមព្យាយាមម្ដងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
