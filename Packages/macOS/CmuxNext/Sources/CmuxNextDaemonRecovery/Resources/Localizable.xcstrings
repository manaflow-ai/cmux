    "daemon.recovery.diskFull": {
      "comment": "Why cmux-tui is not running: its start failed. %@ is the reason (refusal.daemon.diskFull: the disk is full). Launch window and the window notice beside Restart cmux-tui.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui could not start: %@. Free some space and cmux starts it again by itself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل cmux-tui: %@. حرّر بعض المساحة وسيعيد cmux تشغيله تلقائيًا."
          }
        },
        "bs": {
