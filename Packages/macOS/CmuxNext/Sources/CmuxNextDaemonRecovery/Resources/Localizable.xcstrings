{
  "sourceLanguage": "en",
  "strings": {
    "daemon.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to cmux’s background service…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のバックグラウンドサービスに接続しています…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال بخدمة الخلفية في cmux…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje s pozadinskom uslugom cmuxa…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opretter forbindelse til cmux’ baggrundstjeneste …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung mit dem Hintergrunddienst von cmux …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con el servicio en segundo plano de cmux…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion au service d’arrière-plan de cmux…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione al servizio in background di cmux…"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំពុងភ្ជាប់ទៅសេវាផ្ទៃខាងក្រោយរបស់ cmux…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux의 백그라운드 서비스에 연결하는 중…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobler til bakgrunnstjenesten til cmux …"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie z usługą w tle cmux…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando ao serviço em segundo plano do cmux…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к фоновой службе cmux…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเชื่อมต่อกับบริการเบื้องหลังของ cmux…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’un arka plan hizmetine bağlanılıyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключення до фонової служби cmux…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kết nối với dịch vụ nền của cmux…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接到 cmux 的后台服务…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連線到 cmux 的背景服務…"
          }
        }
      }
    },
    "daemon.serviceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux couldn’t start its background service."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はバックグラウンドサービスを起動できませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على cmux تشغيل خدمته في الخلفية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nije mogao pokrenuti svoj pozadinski servis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke starte sin baggrundstjeneste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte seinen Hintergrunddienst nicht starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo iniciar su servicio en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu démarrer son service d’arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux non è riuscito ad avviare il suo servizio in background."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux មិនអាចចាប់ផ្តើមសេវាផ្ទៃខាងក្រោយរបស់វាបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 백그라운드 서비스를 시작하지 못했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kunne ikke starte bakgrunnstjenesten sin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nie mógł uruchomić swojej usługi w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cmux não conseguiu iniciar seu serviço em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не удалось запустить фоновую службу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ไม่สามารถเริ่มบริการเบื้องหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux arka plan hizmetini başlatamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux не вдалося запустити фонову службу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux không thể khởi động dịch vụ nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法启动其后台服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 無法啟動其背景服務。"
          }
        }
      }
    },
    "daemon.reinstall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstall cmux to fix this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux を再インストールすると解決します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تثبيت cmux لإصلاح ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovo instalirajte cmux da biste ovo popravili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Geninstaller cmux for at løse det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere cmux neu, um das zu beheben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstala cmux para solucionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstallez cmux pour corriger ce problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalla cmux per risolvere il problema."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំឡើង cmux ឡើងវិញ ដើម្បីដោះស្រាយបញ្ហានេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux를 다시 설치하면 해결됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer cmux på nytt for å løse dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj cmux ponownie, aby to naprawić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstale o cmux para corrigir isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановите cmux, чтобы это исправить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง cmux ใหม่เพื่อแก้ไขปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu düzeltmek için cmux’u yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевстановіть cmux, щоб це виправити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cài đặt lại cmux để khắc phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装 cmux 即可解决。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安裝 cmux 即可解決。"
          }
        }
      }
    },
