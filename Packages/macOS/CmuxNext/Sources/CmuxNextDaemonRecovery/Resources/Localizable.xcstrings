    "daemon.recovery.failed": {
      "comment": "Status line after Restart cmux-tui did not work; Retry Now stays next to it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't restart the background service. Try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドサービスを再起動できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إعادة تشغيل الخدمة في الخلفية. حاول مرة أخرى بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinski servis nije moguće ponovo pokrenuti. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundstjenesten kunne ikke genstartes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst konnte nicht neu gestartet werden. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar el servicio en segundo plano. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redémarrer le service d’arrière-plan. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riavviare il servizio in background. Riprova tra poco."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចចាប់ផ្តើមសេវាផ្ទៃខាងក្រោយឡើងវិញបានទេ។ សូមព្យាយាមម្តងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 서비스를 재시작하지 못했습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke starte bakgrunnstjenesten på nytt. Prøv igjen om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ponownie uruchomić usługi w tle. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reiniciar o serviço em segundo plano. Tente de novo em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перезапустить фоновую службу. Повторите попытку чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีสตาร์ตบริการเบื้องหลังไม่ได้ ลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan hizmeti yeniden başlatılamadı. Birazdan yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перезапустити фонову службу. Спробуйте ще раз за мить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khởi động lại dịch vụ nền. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重启后台服务。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新啟動背景服務。請稍後再試。"
          }
        }
      }
    },
    "daemon.recovery.diskFull": {
      "comment": "Why cmux-tui is not running: its start failed. %@ is the reason (refusal.daemon.diskFull: the disk is full). Launch window and the window notice beside Restart cmux-tui.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux's background service couldn't start: %@. Free some space and cmux starts it again by itself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل خدمة cmux في الخلفية: %@. حرّر بعض المساحة وسيعيد cmux تشغيلها تلقائيًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinski servis cmuxa nije mogao pokrenuti: %@. Oslobodite malo prostora i cmux će ga sam ponovo pokrenuti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’ baggrundstjeneste kunne ikke starte: %@. Frigør noget plads, så starter cmux den igen af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von cmux konnte nicht starten: %@. Gib etwas Speicherplatz frei, dann startet cmux ihn von selbst neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano de cmux no pudo iniciarse: %@. Libera algo de espacio y cmux lo iniciará de nuevo por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’arrière-plan de cmux n’a pas pu démarrer : %@. Libérez de l’espace et cmux le relancera tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio in background di cmux non è riuscito ad avviarsi: %@. Libera un po’ di spazio e cmux lo riavvierà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のバックグラウンドサービスを起動できませんでした: %@。空き容量を確保すると、cmux が自動的に再起動します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេវាផ្ទៃខាងក្រោយរបស់ cmux មិនអាចចាប់ផ្តើមបានទេ៖ %@។ បង្កើតទំហំទំនេរខ្លះ ហើយ cmux នឹងចាប់ផ្តើមវាឡើងវិញដោយខ្លួនឯង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 백그라운드 서비스를 시작하지 못했습니다: %@. 공간을 확보하면 cmux가 자동으로 다시 시작합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnstjenesten til cmux kunne ikke starte: %@. Frigjør litt plass, så starter cmux den igjen av seg selv."
          }
        },
        "pl": {
          "stringUnit": {
