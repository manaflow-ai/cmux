    "daemon.recovery.stopped": {
      "comment": "Why cmux-tui is not running when its start failed for a reason other than a full disk. Shown in the window notice beside Restart cmux-tui.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux's background service stopped and couldn't start again. cmux keeps trying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux のバックグラウンドサービスが停止し、再起動できませんでした。cmux は再試行を続けます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت خدمة cmux في الخلفية ولم تتمكن من البدء مجددًا. يواصل cmux المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadinski servis cmuxa je zaustavljen i nije se mogao ponovo pokrenuti. cmux nastavlja pokušavati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’ baggrundstjeneste stoppede og kunne ikke starte igen. cmux bliver ved med at prøve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
