    "daemon.recovery.failed": {
      "comment": "Status line after Restart cmux-tui did not work; Retry Now stays next to it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui could not be restarted. Try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui を再起動できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إعادة تشغيل cmux-tui. حاول مرة أخرى بعد قليل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui nije moguće ponovo pokrenuti. Pokušajte ponovo za trenutak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui kunne ikke genstartes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-tui konnte nicht neu gestartet werden. Versuche es gleich noch einmal."
          }
        },
        "es": {
