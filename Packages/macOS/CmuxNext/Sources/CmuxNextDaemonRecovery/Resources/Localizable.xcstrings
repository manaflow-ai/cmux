            "state": "translated",
            "value": "No se pudo reiniciar cmux-tui. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redémarrer cmux-tui. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riavviare cmux-tui. Riprova tra un momento."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចចាប់ផ្ដើម cmux-tui ឡើងវិញបានទេ។ សូមព្យាយាមម្ដងទៀតបន្តិចទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
