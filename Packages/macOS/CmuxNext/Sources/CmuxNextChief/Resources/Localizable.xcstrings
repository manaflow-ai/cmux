    "chief.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chief is not configured. Add %@ with the Worker URL and token."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم إعداد Chief. أضف %@ مع عنوان URL الخاص بـ Worker والرمز المميز."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief nije podešen. Dodajte %@ s URL-om i tokenom Workera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief er ikke konfigureret. Tilføj %@ med Worker-URL og token."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ist nicht eingerichtet. Lege %@ mit der Worker-URL und dem Token an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief no está configurado. Añade %@ con la URL y el token del Worker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief n'est pas configuré. Ajoutez %@ avec l'URL et le jeton du Worker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief non è configurato. Aggiungi %@ con l'URL e il token del Worker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief が設定されていません。Worker の URL とトークンを含む %@ を追加してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief មិនទាន់បានកំណត់ទេ។ បន្ថែម %@ ជាមួយ URL និង token របស់ Worker។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief가 설정되지 않았습니다. Worker URL과 토큰이 포함된 %@ 파일을 추가하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief er ikke konfigurert. Legg til %@ med Worker-URL og token."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief nie jest skonfigurowany. Dodaj %@ z adresem URL i tokenem Workera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Chief não está configurado. Adicione %@ com a URL e o token do Worker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief не настроен. Добавьте %@ с URL и токеном Worker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ยังไม่ได้ตั้งค่า Chief เพิ่ม %@ พร้อม URL และโทเค็นของ Worker"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief yapılandırılmamış. Worker URL'si ve belirteciyle %@ dosyasını ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief не налаштовано. Додайте %@ з URL і токеном Worker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief chưa được cấu hình. Thêm %@ với URL và token của Worker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 尚未配置。请添加包含 Worker URL 和令牌的 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 尚未設定。請加入含有 Worker URL 和權杖的 %@。"
          }
        }
      }
    }
