<dict>
	<key>Recommended</key>
	<dict>
		<key>DefaultSearchProviderSearchURL</key>
		<string>https://search.example.com/search?q={searchTerms}</string>
		<key>URLBlocklist</key>
		<array>
			<string>facebook.com</string>
		</array>
	</dict>
</dict>
</plist>
