    "macScreen.approval.alwaysFull": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح دائمًا بالتحكم الكامل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvijek dozvoli punu kontrolu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad altid Fuld kontrol"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer „Volle Kontrolle“ erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow Full Control"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir siempre control total"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours autoriser le contrôle total"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti sempre controllo completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルコントロールを常に許可"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតការគ្រប់គ្រងពេញលេញជានិច្ច"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 전체 제어 허용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat alltid full kontroll"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze pozwalaj na pełną kontrolę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre Permitir Controle Total"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда разрешать полный контроль"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตควบคุมทั้งหมดเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Zaman Tam Denetime İzin Ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди дозволяти повний контроль"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn cho phép Toàn quyền điều khiển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终允许完全控制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠允許完全控制"
          }
        }
      }
    },
