            "state": "translated",
            "value": "撤销此设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷此裝置"
          }
        }
      }
    },
    "action.macScreen.stopSharing": {
