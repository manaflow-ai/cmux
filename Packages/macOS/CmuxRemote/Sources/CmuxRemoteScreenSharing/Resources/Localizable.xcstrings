  "strings": {
    "action.macScreen.revokeViewer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء وصول هذا الجهاز"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozovi ovaj uređaj"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbagekald denne enhed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät sperren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke This Device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoca questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを取り消す"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដកហូតឧបករណ៍នេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 권한 철회"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakekall denne enheten"
