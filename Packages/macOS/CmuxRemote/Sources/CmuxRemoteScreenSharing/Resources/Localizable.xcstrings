        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar Este Dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать доступ устройства"
