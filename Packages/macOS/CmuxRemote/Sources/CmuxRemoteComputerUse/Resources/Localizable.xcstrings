    "computerUse.approval.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه رؤية نوافذ هذا التطبيق والنقر والكتابة فيها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Može vidjeti prozore ove aplikacije i klikati i tipkati u njima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan se appens vinduer og klikke og skrive i dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kann die Fenster dieser App sehen und darin klicken und tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can see this app's windows and click and type in them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ver las ventanas de esta app y hacer clic y escribir en ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut voir les fenêtres de cette app, y cliquer et y saisir du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può vedere le finestre di questa app e fare clic e digitare al loro interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのウインドウを表示し、クリックや入力ができます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាអាចមើលឃើញផ្ទាំងវីនដូរបស់កម្មវិធីនេះ ហើយចុច និងវាយបញ្ចូលក្នុងវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 윈도우를 보고 클릭하고 입력할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan se appens vinduer og klikke og skrive i dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może widzieć okna tej aplikacji oraz klikać i pisać w nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode ver as janelas deste app e clicar e digitar nelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он сможет видеть окна этого приложения, нажимать и печатать в них."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถเห็นหน้าต่างของแอปนี้ รวมถึงคลิกและพิมพ์ในหน้าต่างได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın pencerelerini görebilir, içlerinde tıklayıp yazabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він бачитиме вікна цієї програми та зможе клацати й друкувати в них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó có thể thấy cửa sổ của ứng dụng này, nhấp và gõ trong đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以看到此应用的窗口，并在其中点按和输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以看到此 App 的視窗，並在其中點按和輸入。"
          }
        }
      }
    },
    "computerUse.approval.detailRemember": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه رؤية نوافذ هذا التطبيق والنقر والكتابة فيها. يمكنك تغيير ذلك لاحقًا في الإعدادات، استخدام الحاسوب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Može vidjeti prozore ove aplikacije i klikati i tipkati u njima. Ovo kasnije možete promijeniti u Postavkama, Upotreba računara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan se appens vinduer og klikke og skrive i dem. Du kan ændre det senere under Indstillinger, Computerbrug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kann die Fenster dieser App sehen und darin klicken und tippen. Du kannst das später unter Einstellungen, Computer Use ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can see this app's windows and click and type in them. You can change this later in Settings, Computer Use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ver las ventanas de esta app y hacer clic y escribir en ellas. Puedes cambiarlo más tarde en Ajustes, Uso del ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut voir les fenêtres de cette app, y cliquer et y saisir du texte. Vous pourrez modifier cela plus tard dans Réglages, Utilisation de l'ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può vedere le finestre di questa app e fare clic e digitare al loro interno. Puoi cambiarlo in seguito in Impostazioni, Uso del computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのウインドウを表示し、クリックや入力ができます。あとで「設定」の「コンピュータの使用」で変更できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាអាចមើលឃើញផ្ទាំងវីនដូរបស់កម្មវិធីនេះ ហើយចុច និងវាយបញ្ចូលក្នុងវា។ អ្នកអាចប្ដូរវានៅពេលក្រោយក្នុងការកំណត់ ការប្រើកុំព្យូទ័រ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 윈도우를 보고 클릭하고 입력할 수 있습니다. 나중에 설정의 컴퓨터 사용에서 변경할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan se appens vinduer og klikke og skrive i dem. Du kan endre dette senere i Innstillinger, Datamaskinbruk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może widzieć okna tej aplikacji oraz klikać i pisać w nich. Możesz to później zmienić w Ustawieniach, Używanie komputera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode ver as janelas deste app e clicar e digitar nelas. Você pode mudar isso depois em Ajustes, Uso do Computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он сможет видеть окна этого приложения, нажимать и печатать в них. Это можно изменить позже в настройках, «Управление компьютером»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถเห็นหน้าต่างของแอปนี้ รวมถึงคลิกและพิมพ์ในหน้าต่างได้ คุณเปลี่ยนได้ภายหลังในการตั้งค่า การใช้คอมพิวเตอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın pencerelerini görebilir, içlerinde tıklayıp yazabilir. Bunu daha sonra Ayarlar, Bilgisayar Kullanımı'ndan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він бачитиме вікна цієї програми та зможе клацати й друкувати в них. Це можна змінити пізніше в Параметрах, «Керування комп'ютером»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó có thể thấy cửa sổ của ứng dụng này, nhấp và gõ trong đó. Bạn có thể đổi sau trong Cài đặt, Sử dụng máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以看到此应用的窗口，并在其中点按和输入。你稍后可以在“设置”的“电脑操控”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以看到此 App 的視窗，並在其中點按和輸入。你稍後可以在「設定」的「電腦操控」中更改。"
          }
        }
      }
    },
