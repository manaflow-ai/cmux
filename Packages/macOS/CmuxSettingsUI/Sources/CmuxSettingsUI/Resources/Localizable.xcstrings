    "settings.customSidebars.examples.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy a shipped example into your sidebars folder and open it for editing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱の例をサイドバーフォルダにコピーし、編集用に開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将随附示例复制到侧边栏文件夹并打开编辑。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie ein mitgeliefertes Beispiel in Ihren Sidebar-Ordner und öffnen Sie es zum Bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez un exemple fourni dans votre dossier de barres latérales et ouvrez-le pour le modifier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ مثالًا مرفقًا إلى مجلد الأشرطة الجانبية وافتحه للتحرير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie un ejemplo incluido en la carpeta de barras laterales y ábralo para editarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將隨附範例複製到側邊欄資料夾並開啟編輯。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포함된 예제를 사이드바 폴더에 복사하고 편집용으로 엽니다."
          }
        }
      }
    },
    "settings.customSidebars.folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebars Folder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーフォルダ"
          }
        },
        "zh-Hans": {
