        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwałość lokalnych sesji jest niedostępna w tym hoście ustawień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A persistência de sessões locais não está disponível neste host de ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение локальных сеансов недоступно в этом хосте настроек."
