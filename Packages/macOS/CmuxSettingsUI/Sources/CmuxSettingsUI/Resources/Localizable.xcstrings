            "value": "Kjører den søkbare cmux-temavelgeren i en ny terminalfane."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia wyszukiwarkę motywów cmux w nowej karcie terminala."
