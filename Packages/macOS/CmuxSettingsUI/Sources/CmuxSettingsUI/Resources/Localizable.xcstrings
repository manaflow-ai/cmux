            "value": "Сохранять локальные сеансы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงเซสชันภายในเครื่องไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel oturumları canlı tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
