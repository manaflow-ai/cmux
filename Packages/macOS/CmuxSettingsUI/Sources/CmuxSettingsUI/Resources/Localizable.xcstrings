  "strings": {
    "settings.terminal.localTmux.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Local Sessions Alive"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Sitzungen aktiv halten"
          }
        },
        "fr": {
