            "value": "Zadrži lokalne sesije aktivnim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold lokale sessioner i live"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សាសម័យមូលដ្ឋានឱ្យដំណើរការ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold lokale økter i live"
          }
        },
        "pl": {
