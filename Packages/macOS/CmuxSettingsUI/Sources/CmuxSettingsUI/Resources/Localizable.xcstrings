    "settings.terminal.localTmux.start.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a named local-tmux session in the selected workspace directory and attaches it to cmux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt im Verzeichnis des ausgewählten Arbeitsbereichs eine benannte local-tmux-Sitzung und verbindet sie mit cmux."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une session local-tmux nommée dans le dossier de l’espace de travail sélectionné et l’attache à cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sesión local-tmux con nombre en el directorio del espacio de trabajo seleccionado y la adjunta a cmux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sessione local-tmux con nome nella directory dell’area di lavoro selezionata e la collega a cmux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中のワークスペースのディレクトリに名前付き local-tmux セッションを作成し、cmux に接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 작업 공간 디렉터리에 이름이 지정된 local-tmux 세션을 만들고 cmux에 연결합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选工作区目录中创建命名的 local-tmux 会话并将其附加到 cmux。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所選工作區目錄中建立具名 local-tmux 工作階段，並將其附加至 cmux。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ جلسة local-tmux مسماة في مجلد مساحة العمل المحددة ويربطها بـ cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreira imenovanu local-tmux sesiju u direktoriju odabranog radnog prostora i povezuje je s cmux-om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opretter en navngiven local-tmux-session i den valgte arbejdsområdemappe og knytter den til cmux."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្កើតសម័យ local-tmux ដែលមានឈ្មោះក្នុងថតកន្លែងធ្វើការដែលបានជ្រើស ហើយភ្ជាប់វាទៅ cmux។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppretter en navngitt local-tmux-økt i mappen til det valgte arbeidsområdet og kobler den til cmux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy nazwaną sesję local-tmux w katalogu wybranego obszaru roboczego i dołącza ją do cmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria uma sessão local-tmux nomeada no diretório do espaço de trabalho selecionado e a anexa ao cmux."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт именованный сеанс local-tmux в каталоге выбранной рабочей области и подключает его к cmux."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างเซสชัน local-tmux ที่ตั้งชื่อในไดเรกทอรีเวิร์กสเปซที่เลือกและแนบเข้ากับ cmux"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
