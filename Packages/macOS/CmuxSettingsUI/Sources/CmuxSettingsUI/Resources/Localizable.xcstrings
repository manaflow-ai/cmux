    "settings.terminal.localTmux.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local session persistence is unavailable in this settings host."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Sitzungspersistenz ist in diesem Einstellungs-Host nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
