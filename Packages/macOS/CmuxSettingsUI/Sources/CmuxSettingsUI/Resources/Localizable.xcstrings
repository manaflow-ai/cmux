    "settings.terminal.themeGallery.openInTerminal.help": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue il selettore di temi cmux con ricerca in una nuova scheda del terminale."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće pretraživi birač tema cmux u novoj kartici terminala."
          }
