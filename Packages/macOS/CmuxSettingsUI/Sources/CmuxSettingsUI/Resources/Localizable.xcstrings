    "settings.terminal.themeGallery.truncated": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono altri temi corrispondenti. Continua a digitare per restringere l’elenco."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postoji još tema koje odgovaraju. Nastavite kucati da suzite listu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere temaer matcher. Skriv videre for at indsnævre listen."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានស្បែកផ្សេងទៀតដែលត្រូវគ្នា។ បន្តវាយដើម្បីបង្រួមបញ្ជី។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere temaer samsvarer. Skriv videre for å snevre inn listen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasuje więcej motywów. Pisz dalej, aby zawęzić listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais temas correspondem. Continue digitando para refinar a lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходят и другие темы. Продолжайте вводить, чтобы сузить список."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีธีมที่ตรงกันอีก พิมพ์ต่อเพื่อจำกัดรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen başka temalar da var. Listeyi daraltmak için yazmaya devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є й інші відповідні теми. Продовжуйте вводити, щоб звузити список."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More themes match. Keep typing to narrow the list."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك سمات أخرى مطابقة. تابع الكتابة لتضييق القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt weitere Treffer. Tippe weiter, um die Liste einzugrenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay más temas que coinciden. Sigue escribiendo para acotar la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres thèmes correspondent. Continuez à taper pour affiner la liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかにも一致するテーマがあります。入力を続けて絞り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
