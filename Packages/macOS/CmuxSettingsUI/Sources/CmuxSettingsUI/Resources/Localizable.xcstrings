    "settings.automation.rules.error": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل ملف قواعد الأتمتة. حرّر ملف JSON ثم أعد التحميل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteku pravila automatizacije nije moguće učitati. Uredite JSON datoteku i ponovo učitajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiseringsregelfilen kunne ikke indlæses. Rediger JSON-filen, og genindlæs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei mit den Automatisierungsregeln konnte nicht geladen werden. Bearbeite die JSON-Datei und lade sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automation rules file could not be loaded. Edit the JSON file and reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el archivo de reglas de automatización. Edita el archivo JSON y vuelve a cargarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le fichier de règles d’automatisation. Modifiez le fichier JSON puis rechargez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il file delle regole di automazione. Modifica il file JSON e ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動化ルールファイルを読み込めませんでした。JSON ファイルを編集して再読み込みしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកឯកសារច្បាប់ស្វ័យប្រវត្តិកម្មបានទេ។ កែសម្រួលឯកសារ JSON ហើយផ្ទុកឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화 규칙 파일을 불러올 수 없습니다. JSON 파일을 편집한 후 다시 로드하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen med automatiseringsregler kunne ikke lastes inn. Rediger JSON-filen og last inn på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać pliku reguł automatyzacji. Edytuj plik JSON i przeładuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o arquivo de regras de automação. Edite o arquivo JSON e recarregue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить файл правил автоматизации. Отредактируйте JSON-файл и перезагрузите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดไฟล์กฎการทำงานอัตโนมัติได้ แก้ไขไฟล์ JSON แล้วโหลดใหม่"
          }
        },
        "tr": {
