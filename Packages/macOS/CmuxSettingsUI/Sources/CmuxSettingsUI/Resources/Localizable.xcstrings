    "settings.terminal.localTmux.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a workspace and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne einen Arbeitsbereich und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un espace de travail et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un espacio de trabajo e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri uno spazio di lavoro e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 열고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开一个工作区，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟工作區，然後重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مساحة عمل وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite radni prostor i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn et arbejdsområde, og prøv igen."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកកន្លែងធ្វើការ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne et arbeidsområde og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz obszar roboczy i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um espaço de trabalho e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте рабочую область и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดพื้นที่ทำงานแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çalışma alanı açıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте робочу область і спробуйте ще раз."
          }
        }
      }
    },
    "settings.terminal.localTmux.invalidResponse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update saved sessions. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Sitzungen konnten nicht aktualisiert werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour les sessions enregistrées. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar las sesiones guardadas. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare le sessioni salvate. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みセッションを更新できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 세션을 업데이트하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新已保存的会话。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新已儲存的工作階段。請重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديث الجلسات المحفوظة. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće ažurirati sačuvane sesije. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemte sessioner kunne ikke opdateres. Prøv igen."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចធ្វើបច្ចុប្បន្នភាពសម័យដែលបានរក្សាទុកទេ។ ព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke oppdatere lagrede økter. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaktualizować zapisanych sesji. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar as sessões salvas. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить сохранённые сеансы. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตเซสชันที่บันทึกไว้ไม่ได้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen oturumlar güncellenemedi. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити збережені сеанси. Спробуйте ще раз."
          }
        }
      }
    },
    "settings.terminal.localTmux.cliMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session persistence is unavailable. Reinstall cmux and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungen können nicht dauerhaft gespeichert werden. Installiere cmux neu und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La persistance des sessions est indisponible. Réinstallez cmux et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persistencia de sesiones no está disponible. Reinstala cmux e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persistenza delle sessioni non è disponibile. Reinstalla cmux e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの永続化を利用できません。cmux を再インストールして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 유지를 사용할 수 없습니다. cmux를 다시 설치하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话持久化不可用。请重新安装 cmux，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段持續保存功能無法使用。請重新安裝 cmux，然後重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بالجلسات غير متاح. أعد تثبيت cmux وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno čuvanje sesija nije dostupno. Ponovo instalirajte cmux i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevaring af sessioner er ikke tilgængelig. Geninstaller cmux, og prøv igen."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចប្រើមុខងាររក្សាទុកសម័យបានទេ។ ដំឡើង cmux ឡើងវិញ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagring av vedvarende økter er utilgjengelig. Installer cmux på nytt og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowywanie sesji jest niedostępne. Zainstaluj ponownie cmux i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A persistência de sessões está indisponível. Reinstale o cmux e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение сеансов недоступно. Переустановите cmux и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถใช้การเก็บรักษาเซสชันได้ โปรดติดตั้ง cmux ใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum kalıcılığı kullanılamıyor. cmux uygulamasını yeniden yükleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збереження сеансів недоступне. Перевстановіть cmux і спробуйте ще раз."
          }
        }
      }
    },
