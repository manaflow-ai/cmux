            "state": "translated",
            "value": "Mantener activas las sesiones locales"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni attive le sessioni locali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルセッションを維持"
          }
        },
        "ko": {
