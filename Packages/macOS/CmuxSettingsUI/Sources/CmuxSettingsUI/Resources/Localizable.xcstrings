{
  "sourceLanguage": "en",
  "strings": {
    "settings.customSidebars.create": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Sidebar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーを作成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建侧边栏"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar erstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une barre latérale"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء شريط جانبي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear barra lateral"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立側邊欄"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바 만들기"
          }
        }
      }
    },
    "settings.customSidebars.create.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들기…"
          }
        }
      }
    },
    "settings.customSidebars.create.dialogMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file name. cmux saves the starter in ~/.config/cmux/sidebars/ and opens it in your preferred editor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名を選択します。cmux はスターターを ~/.config/cmux/sidebars/ に保存し、優先エディタで開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件名。cmux 会将入门文件保存到 ~/.config/cmux/sidebars/，并在首选编辑器中打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Dateinamen. cmux speichert den Starter unter ~/.config/cmux/sidebars/ und öffnet ihn in Ihrem bevorzugten Editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nom de fichier. cmux enregistre le fichier de démarrage dans ~/.config/cmux/sidebars/ et l’ouvre dans votre éditeur préféré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسم ملف. يحفظ cmux ملف البداية في ~/.config/cmux/sidebars/ ويفتحه في محررك المفضل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un nombre de archivo. cmux guarda el archivo inicial en ~/.config/cmux/sidebars/ y lo abre en su editor preferido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇檔名。cmux 會將起始檔儲存到 ~/.config/cmux/sidebars/，並在偏好的編輯器中開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 이름을 선택하세요. cmux가 시작 파일을 ~/.config/cmux/sidebars/에 저장하고 기본 편집기에서 엽니다."
          }
        }
      }
    },
    "settings.customSidebars.create.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a small working sidebar and open it in your preferred editor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな動作確認済みのサイドバーから始め、優先エディタで開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一个小型可用的侧边栏开始，并在首选编辑器中打开它。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit einer kleinen funktionsfähigen Sidebar und öffnen Sie sie in Ihrem bevorzugten Editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec une petite barre latérale fonctionnelle et ouvrez-la dans votre éditeur préféré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بشريط جانبي صغير وجاهز للعمل وافتحه في محررك المفضل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empiece con una barra lateral pequeña y funcional y ábrala en su editor preferido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從一個小型可用的側邊欄開始，並在偏好的編輯器中開啟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작동하는 작은 사이드바로 시작하고 기본 편집기에서 엽니다."
          }
        }
      }
    },
    "settings.customSidebars.documentation.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View the authoring guide, live data bindings, actions, and validation commands."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成ガイド、ライブデータバインディング、アクション、検証コマンドを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看编写指南、实时数据绑定、操作和验证命令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie den Autorenleitfaden, Live-Datenbindungen, Aktionen und Validierungsbefehle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez le guide de création, les liaisons de données en direct, les actions et les commandes de validation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض دليل التأليف وروابط البيانات الحية والإجراءات وأوامر التحقق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte la guía de creación, los enlaces de datos en vivo, las acciones y los comandos de validación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看編寫指南、即時資料繫結、動作和驗證指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 가이드, 실시간 데이터 바인딩, 작업 및 검증 명령을 봅니다."
          }
        }
      }
    },
    "settings.customSidebars.error.alreadyExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sidebar with that name already exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のサイドバーはすでに存在します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名侧边栏。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sidebar mit diesem Namen ist bereits vorhanden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre latérale portant ce nom existe déjà."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد بالفعل شريط جانبي بهذا الاسم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una barra lateral con ese nombre."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名側邊欄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 사이드바가 이미 있습니다."
          }
        }
      }
    },
    "settings.customSidebars.error.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a simple file name without slashes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スラッシュを含まないシンプルなファイル名を使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用不含斜杠的简单文件名。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen einfachen Dateinamen ohne Schrägstriche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un nom de fichier simple, sans barre oblique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اسم ملف بسيطًا من دون شرطات مائلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use un nombre de archivo sencillo sin barras."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用不含斜線的簡單檔名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬래시가 없는 간단한 파일 이름을 사용하세요."
          }
        }
      }
    },
    "settings.customSidebars.error.templateUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled sidebar template failed to load or validate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱のサイドバーテンプレートの読み込みまたは検証に失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随附侧边栏模板加载或验证失败。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden oder Validieren der mitgelieferten Sidebar-Vorlage ist fehlgeschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chargement ou la validation du modèle de barre latérale fourni a échoué."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحميل قالب الشريط الجانبي المرفق أو التحقق منه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la carga o validación de la plantilla de barra lateral incluida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨附側邊欄範本載入或驗證失敗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포함된 사이드바 템플릿을 불러오거나 검증하지 못했습니다."
          }
        }
      }
    },
    "settings.customSidebars.error.writeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux failed to write the sidebar file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux がサイドバーファイルの書き込みに失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 写入侧边栏文件失败。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux konnte die Sidebar-Datei nicht schreiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux n’a pas pu écrire le fichier de barre latérale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل cmux في كتابة ملف الشريط الجانبي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no pudo escribir el archivo de barra lateral."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 寫入側邊欄檔案失敗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 사이드바 파일 쓰기에 실패했습니다."
          }
        }
      }
    },
