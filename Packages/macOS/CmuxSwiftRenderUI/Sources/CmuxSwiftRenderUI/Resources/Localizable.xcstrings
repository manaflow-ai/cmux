    "sidebar.custom.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar file is empty or missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルが空か見つかりません。"
