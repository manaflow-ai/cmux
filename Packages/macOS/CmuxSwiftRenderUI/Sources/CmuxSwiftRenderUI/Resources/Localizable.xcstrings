            "value": "Sidebar error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーエラー"
          }
        }
      }
    },
    "sidebar.custom.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar file is empty or missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルが空か見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.noView": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported SwiftUI view found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するSwiftUIビューが見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.render.invalidSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render width and height must be between 1 and %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダーの幅と高さは 1 から %d の範囲である必要があります。"
          }
        }
      }
    },
    "sidebar.custom.render.fileMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar file is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルが見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.render.unsupportedFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar file has an unsupported format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルの形式に対応していません。"
          }
        }
      }
    },
    "sidebar.custom.render.noView": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported SwiftUI view found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するSwiftUIビューが見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.render.readFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the sidebar file. Check its permissions and format, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルを読み込めませんでした。権限と形式を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "sidebar.custom.render.mountFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sidebar could not be mounted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーをマウントできませんでした。"
          }
        }
      }
    },
    "sidebar.custom.render.bitmapFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mounted sidebar could not produce a PNG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウントしたサイドバーからPNGを生成できませんでした。"
          }
        }
      }
    },
    "sidebar.custom.render.blankOutput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mounted sidebar produced no visible pixels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウントしたサイドバーに表示可能なピクセルがありません。"
          }
        }
      }
    },
    "sidebar.custom.render.writeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the render artifact. Check the output path and permissions, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダーアーティファクトを書き込めませんでした。出力パスと権限を確認して、もう一度お試しください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
