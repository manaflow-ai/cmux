    "sidebar.custom.noView": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported SwiftUI view found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するSwiftUIビューが見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.render.invalidSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render width and height must be between 1 and 4096."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダーの幅と高さは 1 から 4096 の範囲である必要があります。"
          }
        }
      }
    },
    "sidebar.custom.render.fileMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar file is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルが見つかりません。"
          }
        }
      }
    },
    "sidebar.custom.render.unsupportedFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar file has an unsupported format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーファイルの形式に対応していません。"
