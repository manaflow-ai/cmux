{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#1e1e2e",
    "darkFg": "#cdd6f4",
    "darkBlack": "#45475a",
    "darkRed": "#f38ba8",
    "darkGreen": "#a6e3a1",
    "darkYellow": "#f9e2af",
    "darkBlue": "#89b4fa",
    "darkMagenta": "#f5c2e7",
    "darkCyan": "#94e2d5",
    "darkWhite": "#a6adc8",
    "darkBrightBlack": "#585b70",
    "darkBrightRed": "#f37799",
    "darkBrightGreen": "#89d88b",
    "darkBrightYellow": "#ebd391",
    "darkBrightBlue": "#74a8fc",
    "darkBrightMagenta": "#f2aede",
    "darkBrightCyan": "#6bd7ca",
    "darkBrightWhite": "#bac2de",
    "lightBg": "#eff1f5",
    "lightFg": "#4c4f69",
    "lightBlack": "#5c5f77",
    "lightRed": "#d20f39",
    "lightGreen": "#40a02b",
    "lightYellow": "#df8e1d",
    "lightBlue": "#1e66f5",
    "lightMagenta": "#ea76cb",
    "lightCyan": "#179299",
    "lightWhite": "#acb0be",
    "lightBrightBlack": "#6c6f85",
    "lightBrightRed": "#de293e",
    "lightBrightGreen": "#49af3d",
    "lightBrightYellow": "#eea02d",
    "lightBrightBlue": "#456eff",
    "lightBrightMagenta": "#fe85d8",
    "lightBrightCyan": "#2d9fa8",
    "lightBrightWhite": "#bcc0cc"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightBlue" },
    "secondary": { "dark": "darkMagenta", "light": "lightMagenta" },
    "accent": { "dark": "darkBrightMagenta", "light": "lightBrightMagenta" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkYellow", "light": "lightYellow" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkCyan", "light": "lightCyan" },
    "text": { "dark": "darkFg", "light": "lightFg" },
    "textMuted": { "dark": "#7e839b", "light": "#9598a8" },
    "selectedListItemText": { "dark": "darkBg", "light": "lightBg" },
    "background": "none",
    "backgroundPanel": { "dark": "#272738", "light": "#e7e9ee" },
    "backgroundElement": { "dark": "#2e2f40", "light": "#e0e2e8" },
    "backgroundMenu": "backgroundElement",
    "border": { "dark": "#4a4c60", "light": "#c6c9d2" },
    "borderActive": { "dark": "#6d7187", "light": "#a6a8b6" },
    "borderSubtle": { "dark": "#383a4c", "light": "#d7d9e0" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": "textMuted",
    "diffHunkHeader": { "dark": "darkCyan", "light": "lightCyan" },
    "diffHighlightAdded": { "dark": "darkBrightGreen", "light": "lightBrightGreen" },
    "diffHighlightRemoved": { "dark": "darkBrightRed", "light": "lightBrightRed" },
    "diffAddedBg": { "dark": "#3c4947", "light": "#d7e6d9" },
    "diffRemovedBg": { "dark": "#4d3649", "light": "#ebd1db" },
    "diffContextBg": "backgroundPanel",
    "diffLineNumber": "textMuted",
    "diffAddedLineNumberBg": { "dark": "#43504f", "light": "#d0dfd3" },
    "diffRemovedLineNumberBg": { "dark": "#543d51", "light": "#e4cad5" },
    "markdownText": { "dark": "darkFg", "light": "lightFg" },
    "markdownHeading": { "dark": "darkMagenta", "light": "lightMagenta" },
    "markdownLink": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownLinkText": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownCode": { "dark": "darkGreen", "light": "lightGreen" },
    "markdownBlockQuote": { "dark": "darkYellow", "light": "lightYellow" },
    "markdownEmph": { "dark": "darkYellow", "light": "lightYellow" },
    "markdownStrong": { "dark": "darkFg", "light": "lightFg" },
    "markdownHorizontalRule": "border",
    "markdownListItem": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownListEnumeration": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownImage": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownImageText": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownCodeBlock": { "dark": "darkFg", "light": "lightFg" },
    "syntaxComment": "textMuted",
    "syntaxKeyword": { "dark": "darkMagenta", "light": "lightMagenta" },
    "syntaxFunction": { "dark": "darkBlue", "light": "lightBlue" },
    "syntaxVariable": { "dark": "darkFg", "light": "lightFg" },
    "syntaxString": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxNumber": { "dark": "darkYellow", "light": "lightYellow" },
    "syntaxType": { "dark": "darkCyan", "light": "lightCyan" },
    "syntaxOperator": { "dark": "darkCyan", "light": "lightCyan" },
    "syntaxPunctuation": { "dark": "darkFg", "light": "lightFg" }
  }
}
