    "config.settingChange.unknownPath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' isn't a cmux setting. Run `cmux docs settings` to list them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist keine cmux-Einstellung. Führe `cmux docs settings` aus, um alle aufzulisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n'est pas un réglage cmux. Exécutez `cmux docs settings` pour les lister."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ليس إعدادًا في cmux. شغّل `cmux docs settings` لعرض الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' no es un ajuste de cmux. Ejecuta `cmux docs settings` para ver la lista."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是 cmux 設定。執行 `cmux docs settings` 可列出所有設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是 cmux 设置。运行 `cmux docs settings` 可列出所有设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) cmux 설정이 아닙니다. `cmux docs settings`를 실행해 목록을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は cmux の設定ではありません。`cmux docs settings` を実行すると一覧を表示できます。"
          }
        }
      }
    },
    "config.settingChange.notASetting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' isn't a setting. Edit that section of cmux.json directly."
          }
        },
        "de": {
          "stringUnit": {
