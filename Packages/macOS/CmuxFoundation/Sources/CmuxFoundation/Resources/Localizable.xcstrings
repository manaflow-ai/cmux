          "stringUnit": {
            "state": "translated",
            "value": "최대 %lld개의 항목을 포함해야 합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個以下の項目である必要があります"
          }
        }
      }
    },
