    "config.validation.array.max": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "must contain at most %lld item(s)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "darf höchstens %lld Element(e) enthalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "doit contenir au plus %lld élément(s)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا يتجاوز %lld عنصرًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "debe contener como máximo %lld elemento(s)"
          }
        },
        "zh-Hant": {
