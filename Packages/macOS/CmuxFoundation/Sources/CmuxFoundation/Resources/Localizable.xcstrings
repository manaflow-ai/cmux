    "config.validation.cli.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validate JSONC syntax and cmux config semantics."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONC-Syntax und cmux-Konfigurationssemantik prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valider la syntaxe JSONC et la sémantique de configuration cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من صياغة JSONC ودلالات إعداد cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valida la sintaxis JSONC y la semántica de configuración de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證 JSONC 語法與 cmux 設定語意。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证 JSONC 语法和 cmux 配置语义。"
          }
