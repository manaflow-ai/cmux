    "delete.confirm.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذفها من جهاز Mac هذا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bit će izbrisana s ovog Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den slettes fra denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird von diesem Mac gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is deleted from this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera supprimé de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eliminato da questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacから削除されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វានឹងត្រូវលុបចេញពី Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den slettes fra denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięta z tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela será apagada deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно будет удалено с этого Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความจะถูกลบออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'ten silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його буде видалено з цього Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn sẽ bị xóa khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从这台 Mac 上删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將從這部 Mac 上刪除。"
          }
        }
      }
    },
