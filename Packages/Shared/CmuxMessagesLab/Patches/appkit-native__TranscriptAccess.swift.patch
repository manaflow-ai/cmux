+    static func highlightRects(_ sel: NSRange, body: CGRect, geometry g: RowTextGeometry, visible: ClosedRange<CGFloat>) -> [CGRect] {
+        let v0 = visible.lowerBound - body.minY, v1 = visible.upperBound - body.minY
