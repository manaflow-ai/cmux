+    static func balloon(drawn: CGRect, frameSize: CGSize, row p: PartRow) -> UIBezierPath {
+        make(body: drawn, outgoing: p.outgoing, tail: p.tail, cornersOf: frameSize, circularEnds: RowDraw.circularEnds(p))
     }
