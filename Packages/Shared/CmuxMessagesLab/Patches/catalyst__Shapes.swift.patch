+    static func balloon(frame: CGRect, row p: PartRow, scale: CGFloat = Fixture.renderScale) -> UIBezierPath {
+        balloon(drawn: RowDraw.balloon(frame, row: p, scale: scale), frameSize: frame.size, row: p)
+    }
