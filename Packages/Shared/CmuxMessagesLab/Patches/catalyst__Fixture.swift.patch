+    static func color(in s: [(CGFloat, UIColor)], atPx px: CGFloat) -> UIColor {
+        guard s.count > 1 else { return s.first?.1 ?? outgoing }
+        var i = 1
+        while i < s.count - 1, s[i].0 < px { i += 1 }
+        let a = s[i - 1], b = s[i]
