{
  "info": {
    "title": "cmux API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "openapi": "3.1.1",
  "paths": {
    "/account/me": {
      "get": {
        "operationId": "account.me",
        "summary": "Get the authenticated account and plan",
        "description": "Returns the signed-in user's id, primary email, and resolved billing plan (free or pro).",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "planId": {
                      "enum": [
                        "free",
                        "pro"
                      ],
                      "type": "string"
                    },
                    "isPro": {
                      "type": "boolean"
                    },
                    "billingManagement": {
                      "enum": [
                        "stripe",
                        "external",
                        "none"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "userId",
                    "email",
                    "planId",
                    "isPro",
                    "billingManagement"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sr/device/start": {
      "post": {
        "operationId": "sr.device.start",
        "summary": "Begin a device-code login",
        "description": "Issues a device code for the CLI and a short user code for the human to approve in a browser. Grants no access until approved.",
        "tags": [
          "Subrouter"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userCode": {
                      "type": "string"
                    },
                    "deviceCode": {
                      "type": "string"
                    },
                    "verificationUri": {
                      "type": "string"
                    },
                    "expiresInSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "exclusiveMinimum": 0
                    },
                    "intervalSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "userCode",
                    "deviceCode",
                    "verificationUri",
                    "expiresInSeconds",
                    "intervalSeconds"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sr/device/poll": {
      "post": {
        "operationId": "sr.device.poll",
        "summary": "Poll a pending device-code login",
        "description": "Returns pending until a signed-in human approves the matching user code, then returns the approved team once.",
        "tags": [
          "Subrouter"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deviceCode": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "deviceCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "pending",
                        "approved",
                        "expired"
                      ],
                      "type": "string"
                    },
                    "teamId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "userId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "teamId",
                    "userId"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sr/accounts/push": {
      "post": {
        "operationId": "sr.accounts.push",
        "summary": "Upload Subrouter credentials to the team vault",
        "description": "Seals one or more provider credentials and stores them for the caller's team. Existing accounts are updated in place rather than duplicated.",
        "tags": [
          "Subrouter"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accounts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "enum": [
                            "codex",
                            "claude",
                            "gemini",
                            "apikey"
                          ],
                          "type": "string"
                        },
                        "accountLabel": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 320
                        },
                        "credential": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64000
                        }
                      },
                      "required": [
                        "provider",
                        "accountLabel",
                        "credential"
                      ]
                    }
                  }
                },
                "required": [
                  "accounts"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "teamId": {
                      "type": "string"
                    },
                    "uploaded": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "updated": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "teamId",
                    "uploaded",
                    "updated"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sr/accounts": {
      "get": {
        "operationId": "sr.accounts.list",
        "summary": "List Subrouter accounts available to the team",
        "description": "Returns account identities only. Credential material is never returned by this endpoint.",
        "tags": [
          "Subrouter"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "teamId": {
                      "type": "string"
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "provider": {
                            "enum": [
                              "codex",
                              "claude",
                              "gemini",
                              "apikey"
                            ],
                            "type": "string"
                          },
                          "accountLabel": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 320
                          },
                          "updatedAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "provider",
                          "accountLabel",
                          "updatedAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "teamId",
                    "accounts"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
