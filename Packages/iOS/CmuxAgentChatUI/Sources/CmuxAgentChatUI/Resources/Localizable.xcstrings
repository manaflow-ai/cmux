    "chat.artifact.failure.secure_connection.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This route can't securely transfer Mac files. Reconnect using a paired secure route."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この経路ではMacのファイルを安全に転送できません。ペアリング済みの安全な経路で再接続してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Route können Mac-Dateien nicht sicher übertragen werden. Stellen Sie die Verbindung über eine gekoppelte sichere Route wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet itinéraire ne permet pas de transférer en toute sécurité des fichiers Mac. Reconnectez-vous en utilisant une route sécurisée couplée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا المسار نقل ملفات Mac بشكل آمن. أعد الاتصال باستخدام طريق آمن مقترن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ruta no puede transferir archivos Mac de forma segura. Vuelva a conectarse utilizando una ruta segura emparejada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此路由無法安全地傳輸 Mac 檔案。使用配對的安全路由重新連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此路由无法安全地传输 Mac 文件。使用配对的安全路由重新连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 경로는 Mac 파일을 안전하게 전송할 수 없습니다. 페어링된 보안 경로를 사용하여 다시 연결하세요."
          }
        }
      }
    },
