    "chat.artifact.failure.unknown.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac reported an error this app doesn't recognize. Update cmux on both devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがこのアプリで認識できないエラーを返しました。両方のデバイスでcmuxをアップデートしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac reported an error this app doesn't recognize. Aktualisieren Sie cmux auf beiden Geräten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a signalé une erreur que cette application ne reconnaît pas. Mettez à jour cmux sur les deux appareils."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغ جهاز Mac عن خطأ لم يتعرف عليه هذا التطبيق. قم بتحديث cmux على كلا الجهازين."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac informó un error que esta aplicación no reconoce. Actualice cmux en ambos dispositivos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 報告了此應用程式無法識別的錯誤。更新兩台裝置上的 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 报告了此应用无法识别的错误。更新两台设备上的 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이 앱이 인식하지 못하는 오류를 보고했습니다. 두 장치 모두에서 cmux를 업데이트합니다."
          }
        }
      }
    },
