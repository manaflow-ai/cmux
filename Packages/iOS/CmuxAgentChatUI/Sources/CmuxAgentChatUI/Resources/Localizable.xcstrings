    "chat.artifact.failure.transfer_interrupted.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file transfer stopped before all bytes arrived. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータが届く前にファイル転送が停止しました。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
