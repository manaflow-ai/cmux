    "markdown.web.remoteImageConsentMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux will not contact this image URL until you load this image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を読み込むまで、cmux はこの画像 URL に接続しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux kontaktiert diese Bild-URL erst, wenn Sie dieses Bild laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ne contactera pas l'URL de cette image tant que vous n'aurez pas chargé cette image."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتصل cmux بعنوان URL للصورة حتى تقوم بتحميل هذه الصورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux no se comunicará con la URL de esta imagen hasta que la cargue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您載入此圖像之前，cmux 不會聯絡此圖像 URL。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您加载此图像之前，cmux 不会联系此图像 URL。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 이 이미지를 로드할 때까지 이 이미지 URL에 접속하지 않습니다."
          }
        }
