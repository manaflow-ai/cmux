          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已更改"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 변경됨"
          }
        }
      }
    },
    "chat.artifact.failure.forbidden.workspace_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is no longer part of the workspace changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはワークスペースの変更に含まれなくなりました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist nicht mehr Teil der Arbeitsbereichsänderungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne fait plus partie des modifications de l'espace de travail."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الملف جزءًا من تغييرات مساحة العمل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ya no forma parte de los cambios en el espacio de trabajo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該文件不再是工作區變更的一部分。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不再是工作区更改的一部分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 더 이상 작업공간 변경사항의 일부가 아닙니다."
          }
        }
      }
    },
    "chat.artifact.failure.invalid_request.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file request was invalid. Update cmux on both devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルリクエストが無効です。両方のデバイスでcmuxをアップデートしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateianforderung war ungültig. Aktualisieren Sie cmux auf beiden Geräten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande de fichier n'était pas valide. Mettez à jour cmux sur les deux appareils."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب الملف غير صالح. قم بتحديث cmux على كلا الجهازين."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de archivo no era válida. Actualice cmux en ambos dispositivos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件請求無效。更新兩台裝置上的 cmux。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件请求无效。更新两台设备上的 cmux。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 요청이 잘못되었습니다. 두 장치 모두에서 cmux를 업데이트합니다."
          }
        }
      }
    },
    "chat.artifact.failure.invalid_request.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
