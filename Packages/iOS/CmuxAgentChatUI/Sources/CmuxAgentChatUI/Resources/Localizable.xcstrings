          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud de archivo no válida"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件請求無效"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件请求无效"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 파일 요청"
          }
        }
      }
    },
    "chat.artifact.failure.invalid_response.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac sent inconsistent file data. Try again, then update cmux if it continues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macから整合性のないファイルデータが送信されました。もう一度試し、続く場合はcmuxをアップデートしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac hat inkonsistente Dateidaten gesendet. Versuchen Sie es erneut und aktualisieren Sie dann cmux, wenn das Problem weiterhin besteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac a envoyé des données de fichier incohérentes. Réessayez, puis mettez à jour cmux si cela continue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل جهاز Mac بيانات ملف غير متناسقة. حاول مرة أخرى، ثم قم بتحديث cmux إذا استمر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac envió datos de archivos inconsistentes. Inténtelo de nuevo y luego actualice cmux si continúa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
