    "chat.artifact.reconnecting.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's connection to the Mac dropped and is coming back. Retry in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneとMacの接続が切断され、再接続中です。しばらくしてからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung dieses Telefons zum Mac wurde unterbrochen und wird wiederhergestellt. Versuchen Sie es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de ce téléphone au Mac a été interrompue et revient. Réessayez dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع اتصال هذا الهاتف بجهاز Mac وسيعود مرة أخرى. أعد المحاولة بعد قليل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de este teléfono con Mac se interrumpió y se está recuperando. Vuelva a intentarlo en un momento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這款手機與 Mac 的連線已斷開，但正在恢復。稍後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机与 Mac 的连接已断开，但正在恢复。稍后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰과 Mac의 연결이 끊어졌고 다시 돌아오고 있습니다. 잠시 후 다시 시도하세요."
          }
        }
      }
    },
