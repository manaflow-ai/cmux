          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert de fichiers s'est arrêté avant l'arrivée de tous les octets. Essayer à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
