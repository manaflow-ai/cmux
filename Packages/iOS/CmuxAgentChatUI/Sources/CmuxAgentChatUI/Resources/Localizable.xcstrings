    "chat.artifact.failure.permission.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux found the file, but the Mac doesn't allow cmux to read it. Check the file's permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは見つかりましたが、Macでcmuxに読み取りが許可されていません。ファイルのアクセス権を確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux hat die Datei gefunden, aber der Mac erlaubt cmux nicht, sie zu lesen. Überprüfen Sie die Berechtigungen der Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a trouvé le fichier, mais le Mac ne permet pas à cmux de le lire. Vérifiez les autorisations du fichier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عثر cmux على الملف، لكن نظام Mac لا يسمح لـ cmux بقراءته. تحقق من أذونات الملف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux encontró el archivo, pero Mac no permite que cmux lo lea. Verifique los permisos del archivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 找到了該文件，但 Mac 不允許 cmux 讀取它。檢查檔案的權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 找到了该文件，但 Mac 不允许 cmux 读取它。检查文件的权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 파일을 찾았지만 Mac에서는 cmux가 파일을 읽는 것을 허용하지 않습니다. 파일의 권한을 확인하세요."
          }
        }
      }
    },
