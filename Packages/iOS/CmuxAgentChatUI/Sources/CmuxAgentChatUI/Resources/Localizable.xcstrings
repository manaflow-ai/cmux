    "chat.artifact.failure.restart.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection cleanup is stuck. Restart cmux on this device, reconnect, and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続のクリーンアップが停止しています。このデバイスでcmuxを再起動し、再接続してからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindungsbereinigung bleibt hängen. Starten Sie cmux auf diesem Gerät neu, stellen Sie die Verbindung wieder her und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la connexion est bloqué. Redémarrez cmux sur cet appareil, reconnectez-vous et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية تنظيف الاتصال عالقة. أعد تشغيل cmux على هذا الجهاز، وأعد الاتصال وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza de la conexión está bloqueada. Reinicie cmux en este dispositivo, vuelva a conectarse y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接清理被卡住。在此裝置上重新啟動 cmux，重新連接，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接清理被卡住。在此设备上重新启动 cmux，重新连接，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정리가 중단되었습니다. 이 장치에서 cmux를 다시 시작하고 다시 연결한 후 다시 시도하십시오."
          }
        }
      }
    },
