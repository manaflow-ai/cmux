{
  "sourceLanguage": "en",
  "strings": {
    "chat.artifact.failure.account_mismatch.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device and the Mac are signed in to different cmux accounts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとMacは異なるcmuxアカウントにサインインしています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät und der Mac sind bei unterschiedlichen cmux-Konten angemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil et le Mac sont connectés à des comptes cmux différents."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل دخول هذا الجهاز وجهاز Mac إلى حسابات cmux مختلفة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo y la Mac han iniciado sesión en diferentes cuentas cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置和 Mac 登入不同的 cmux 帳戶。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备和 Mac 登录到不同的 cmux 帐户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치와 Mac은 서로 다른 cmux 계정에 로그인되어 있습니다."
          }
        }
      }
    },
    "chat.artifact.failure.account_mismatch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account mismatch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが一致しません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontokonflikt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incompatibilité de compte"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم تطابق الحساب"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No coincide la cuenta"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶不符"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户不匹配"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 불일치"
          }
        }
      }
    },
    "chat.artifact.failure.authentication_expired.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to the Mac to refresh authentication, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macに再接続して認証を更新してから、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie erneut eine Verbindung zum Mac her, um die Authentifizierung zu aktualisieren, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous au Mac pour actualiser l'authentification, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد الاتصال بجهاز Mac لتحديث المصادقة، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a conectarse a la Mac para actualizar la autenticación y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連線到 Mac 以刷新身份驗證，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接到 Mac 以刷新身份验证，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 다시 연결하여 인증을 새로 고친 후 다시 시도하세요."
          }
        }
      }
    },
    "chat.artifact.failure.authentication_expired.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing expired"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングの有効期限が切れました"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplung ist abgelaufen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couplage expiré"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الاقتران"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejamiento caducado"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對已過期"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已过期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링이 만료되었습니다."
          }
        }
      }
    },
    "chat.artifact.failure.authorization.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device isn't authorized to read files from the Mac. Pair it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはMac上のファイルを読み取る権限がありません。もう一度ペアリングしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist nicht berechtigt, Dateien vom Mac zu lesen. Koppeln Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'est pas autorisé à lire les fichiers du Mac. Associez-le à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز غير مصرح له بقراءة الملفات من جهاز Mac. إقرانه مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no está autorizado para leer archivos desde Mac. Vuelve a emparejarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該裝置無權從 Mac 讀取檔案。再次配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备无权从 Mac 读取文件。再次配对。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치는 Mac에서 파일을 읽을 수 있는 권한이 없습니다. 다시 페어링하세요."
          }
        }
      }
    },
    "chat.artifact.failure.authorization.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection not authorized"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が承認されていません"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung nicht autorisiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion non autorisée"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال غير مصرح به"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión no autorizada"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線未授權"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接未授权"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 승인되지 않았습니다."
          }
        }
      }
    },
    "chat.artifact.failure.corrupt_media.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file type is supported, but its media data couldn't be decoded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応しているファイル形式ですが、メディアデータをデコードできませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateityp wird unterstützt, seine Mediendaten konnten jedoch nicht dekodiert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type de fichier est pris en charge, mais ses données multimédias n'ont pas pu être décodées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نوع الملف مدعوم، لكن لا يمكن فك تشفير بيانات الوسائط الخاصة به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de archivo es compatible, pero sus datos multimedia no se pudieron decodificar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援該文件類型，但無法解碼其媒體資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持该文件类型，但无法解码其媒体数据。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 형식이 지원되지만 해당 미디어 데이터를 디코딩할 수 없습니다."
          }
        }
      }
    },
    "chat.artifact.failure.corrupt_media.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File is damaged"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが破損しています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist beschädigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est endommagé"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف تالف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo está dañado"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已損壞"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已损坏"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 손상되었습니다"
          }
        }
      }
    },
    "chat.artifact.failure.file_changed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed while it was loading. Try again to load the latest version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中にファイルが変更されました。最新の内容を読み込むには、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde beim Laden geändert. Versuchen Sie erneut, die neueste Version zu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé pendant son chargement. Essayez à nouveau de charger la dernière version."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير الملف أثناء التحميل. حاول مرة أخرى تحميل الإصدار الأحدث."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió mientras se cargaba. Intente nuevamente cargar la última versión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在載入時發生了變化。再次嘗試載入最新版本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在加载时发生了变化。再次尝试加载最新版本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로드하는 동안 파일이 변경되었습니다. 최신 버전을 다시 로드해 보세요."
          }
        }
      }
    },
    "chat.artifact.failure.file_changed.title": {
      "extractionState": "manual",
      "localizations": {
