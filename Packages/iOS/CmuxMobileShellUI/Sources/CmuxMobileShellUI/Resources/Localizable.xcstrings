    "mobile.settings.hapticFeedbackFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, cmux does not vibrate for actions, confirmations, warnings, or errors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、操作、確認、警告、エラーでcmuxが振動しなくなります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option deaktiviert ist, vibriert cmux nicht bei Aktionen, Bestätigungen, Warnungen oder Fehlern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est désactivé, cmux ne vibre pas pour les actions, confirmations, avertissements ou erreurs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف التشغيل، لا يهتز cmux عند اتخاذ إجراءات أو تأكيدات أو تحذيرات أو أخطاء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está apagado, cmux no vibra para acciones, confirmaciones, advertencias o errores."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，cmux 不會因操作、確認、警告或錯誤而振動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，cmux 不会因操作、确认、警告或错误而振动。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있으면 cmux는 작업, 확인, 경고 또는 오류가 발생해도 진동하지 않습니다."
          }
        }
      }
    },
