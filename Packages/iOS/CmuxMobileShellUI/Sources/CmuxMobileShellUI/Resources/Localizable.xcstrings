    "mobile.iroh.diagnostics.clear.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the app, networking, verbose, and connection logs stored on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されたアプリ、ネットワーク、詳細、接続ログを完全に削除します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die auf diesem Gerät gespeicherten App-, Netzwerk-, ausführlichen und Verbindungsprotokolle dauerhaft entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les journaux d’app, réseau, détaillés et de connexion stockés sur cet appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة سجلات التطبيق والشبكة والسجلات المطولة والاتصال المخزنة على هذا الجهاز بشكل دائم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente los registros de la aplicación, la red, los detalles y la conexión almacenados en este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除儲存在該裝置上的應用程式、網路、詳細和連線日誌。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除存储在该设备上的应用程序、网络、详细和连接日志。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 앱, 네트워크, 상세 및 연결 로그가 영구적으로 제거됩니다."
          }
        }
      }
    },
