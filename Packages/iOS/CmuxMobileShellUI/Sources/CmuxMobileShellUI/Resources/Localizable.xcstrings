    "mobile.settings.debugReplyTest.scheduled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled: lock the phone; the notification fires in 5 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約しました。iPhoneをロックしてください。5秒後に通知が届きます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplant: Telefon sperren; Die Benachrichtigung wird in 5 Sekunden ausgelöst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmé : verrouiller le téléphone ; la notification se déclenche dans 5 secondes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقرر: قفل الهاتف؛ يتم تشغيل الإشعار خلال 5 ثوانٍ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programado: bloquear el teléfono; la notificación se activa en 5 segundos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預定：鎖定手機；通知將在 5 秒後觸發。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预定：锁定手机；通知将在 5 秒后触发。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약됨: 전화를 잠급니다. 알림은 5초 후에 실행됩니다."
          }
        }
      }
    },
    "mobile.settings.debugReplyTest.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't schedule: open a workspace and select a terminal first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約できませんでした。先にワークスペースを開いてターミナルを選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planung konnte nicht durchgeführt werden: Öffnen Sie einen Arbeitsbereich und wählen Sie zuerst ein Terminal aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de planifier : ouvrez un espace de travail et sélectionnez d'abord un terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت الجدولة: افتح مساحة عمل وحدد محطة طرفية أولاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo programar: abra un espacio de trabajo y seleccione una terminal primero."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安排：先開啟工作區並選擇終端。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安排：首先打开工作区并选择终端。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약할 수 없습니다. 작업 공간을 열고 먼저 터미널을 선택하세요."
          }
        }
      }
    },
    "mobile.workspace.customize.description.tooLong": {
      "extractionState": "manual",
