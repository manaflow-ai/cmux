    "mobile.iroh.diagnostics.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This report remains available while disconnected. It excludes terminal content, account and endpoint identities, network addresses, relay URLs, credentials, and raw errors. Nothing leaves this device until you share it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このレポートは接続が切れていても利用できます。ターミナルの内容、アカウントおよびエンドポイントの識別情報、ネットワークアドレス、リレー URL、認証情報、生のエラーは含まれません。共有するまで、このデバイスから送信されることはありません。" } },
        "zh-Hans" : {"stringUnit" : {"state" : "translated", "value" : "即使连接已断开，这份报告也依然可用。报告不含终端内容、账户与端点身份、网络地址、中继 URL、凭据和原始错误信息。在你共享之前，不会有任何内容离开这台设备。"}}
      }
    },
