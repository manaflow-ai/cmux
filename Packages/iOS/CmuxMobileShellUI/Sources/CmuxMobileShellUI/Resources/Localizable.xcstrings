    "agent.chat.max_attachments_reached": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can attach up to 10 attachments."}},"ja":{"stringUnit":{"state":"translated","value":"添付ファイルは最大 10 件まで追加できます。"}},"de":{"stringUnit":{"state":"translated","value":"Sie können bis zu 10 Anhänge hinzufügen."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez joindre jusqu’à 10 pièces jointes."}},"ar":{"stringUnit":{"state":"translated","value":"يمكنك إرفاق ما يصل إلى 10 مرفقات."}},"es":{"stringUnit":{"state":"translated","value":"Puedes adjuntar hasta 10 archivos."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最多可加入 10 個附件。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最多可添加 10 个附件。"}},"ko":{"stringUnit":{"state":"translated","value":"첨부 파일은 최대 10개까지 추가할 수 있습니다."}}}},
    "agent.chat.file_too_large_to_send": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"That file is too large to send."}},"ja":{"stringUnit":{"state":"translated","value":"そのファイルは大きすぎて送信できません。"}},"de":{"stringUnit":{"state":"translated","value":"Diese Datei ist zu groß zum Senden."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fichier est trop volumineux pour être envoyé."}},"ar":{"stringUnit":{"state":"translated","value":"هذا الملف كبير جدًا بحيث يتعذر إرساله."}},"es":{"stringUnit":{"state":"translated","value":"Ese archivo es demasiado grande para enviarlo."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此檔案太大，無法傳送。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此文件太大，无法发送。"}},"ko":{"stringUnit":{"state":"translated","value":"파일이 너무 커서 보낼 수 없습니다."}}}},
    "agent.chat.image_too_large_to_send": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"That image is too large to send."}},"ja":{"stringUnit":{"state":"translated","value":"その画像は大きすぎて送信できません。"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Bild ist zu groß zum Senden."}},"fr":{"stringUnit":{"state":"translated","value":"Cette image est trop volumineuse pour être envoyée."}},"ar":{"stringUnit":{"state":"translated","value":"هذه الصورة كبيرة جدًا بحيث يتعذر إرسالها."}},"es":{"stringUnit":{"state":"translated","value":"Esa imagen es demasiado grande para enviarla."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此影像太大，無法傳送。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此图片太大，无法发送。"}},"ko":{"stringUnit":{"state":"translated","value":"이미지가 너무 커서 보낼 수 없습니다."}}}},
    "agent.chat.attachments_total_limit": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Attachments can use up to 64 MB in total."}},"ja":{"stringUnit":{"state":"translated","value":"添付ファイルの合計サイズは 64 MB までです。"}},"de":{"stringUnit":{"state":"translated","value":"Anhänge dürfen insgesamt bis zu 64 MB umfassen."}},"fr":{"stringUnit":{"state":"translated","value":"La taille totale des pièces jointes est limitée à 64 Mo."}},"ar":{"stringUnit":{"state":"translated","value":"يمكن أن يصل إجمالي حجم المرفقات إلى 64 ميجابايت."}},"es":{"stringUnit":{"state":"translated","value":"Los archivos adjuntos pueden ocupar hasta 64 MB en total."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"附件總大小最多可為 64 MB。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"附件总大小最多为 64 MB。"}},"ko":{"stringUnit":{"state":"translated","value":"첨부 파일은 총 64MB까지 사용할 수 있습니다."}}}},
