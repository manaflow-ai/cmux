          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita el acceso saliente HTTPS y WebSocket a estos orígenes de retransmisión cmux:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許對這些 cmux 中繼來源的出站 HTTPS 和 WebSocket 存取："
          }
        },
        "zh-Hans": {
          "stringUnit": {
