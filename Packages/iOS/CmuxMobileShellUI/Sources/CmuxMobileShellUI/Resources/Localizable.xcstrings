    "mobile.v2.connections.direct.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter each address with its port. These routes stay on this iPhone. The encrypted connection verifies the Mac’s identity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib jede Adresse mit ihrem Port ein. Diese Routen bleiben auf diesem iPhone. Die verschlüsselte Verbindung überprüft die Identität des Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez chaque adresse avec son port. Ces routes restent sur cet iPhone. La connexion chiffrée vérifie l’identité du Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كل عنوان مع منفذه. تبقى هذه المسارات على هذا الـ iPhone. يتحقق الاتصال المشفّر من هوية جهاز Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce cada dirección con su puerto. Estas rutas se guardan solo en este iPhone. La conexión cifrada verifica la identidad del Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入每個位址及其連接埠。這些路徑只會儲存在這部 iPhone 上。加密連線會驗證 Mac 的身分。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入每个地址及其端口。这些路径只会保存在这台 iPhone 上。加密连接会验证 Mac 的身份。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 주소와 포트를 입력하세요. 이 경로는 이 iPhone에만 저장됩니다. 암호화된 연결이 Mac의 신원을 확인합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アドレスをポートとともに入力してください。これらの経路はこのiPhoneにのみ保存されます。暗号化された接続がMacの識別情報を検証します。"
          }
        }
      }
    },
    "mobile.v2.connections.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, turn on Enable iOS pairing in cmux Settings. Select the same team on both devices and keep cmux running. Only Macs you own or have permission to connect to appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere auf deinem Mac „iOS-Kopplung aktivieren“ in den cmux-Einstellungen. Wähle auf beiden Geräten dasselbe Team und lasse cmux geöffnet. Hier erscheinen nur deine Macs oder Macs, für die du eine Verbindungsberechtigung hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, activez « Activer le jumelage iOS » dans les réglages de cmux. Sélectionnez la même équipe sur les deux appareils et laissez cmux ouvert. Seuls vos Mac et ceux auxquels vous avez le droit de vous connecter apparaissent ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز Mac، شغّل «تمكين الاقتران مع iOS» في إعدادات cmux. اختر الفريق نفسه على الجهازين وأبقِ cmux قيد التشغيل. تظهر هنا فقط أجهزة Mac التي تملكها أو لديك إذن بالاتصال بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, activa «Activar enlace con iOS» en los ajustes de cmux. Selecciona el mismo equipo en ambos dispositivos y mantén cmux abierto. Aquí solo aparecen los Mac que te pertenecen o a los que tienes permiso para conectarte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的 cmux 設定中開啟「啟用 iOS 配對」。在兩部裝置上選擇相同的團隊，並保持 cmux 運行。這裡只會顯示你擁有或獲准連線的 Mac。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的 cmux 设置中打开“启用 iOS 配对”。在两台设备上选择相同的团队，并保持 cmux 运行。这里只会显示你拥有或获准连接的 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 cmux 설정에서 ‘iOS 페어링 활성화’를 켜세요. 두 기기에서 같은 팀을 선택하고 cmux를 계속 실행해 두세요. 소유하거나 연결 권한이 있는 Mac만 여기에 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのcmux設定で「iOSペアリングを有効にする」をオンにしてください。両方のデバイスで同じチームを選び、cmuxを起動したままにしてください。所有するMacまたは接続を許可されたMacのみが表示されます。"
          }
        }
      }
    },
    "mobile.pairing.enableOnMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before pairing, open cmux Settings > Mobile on the Mac and turn on Enable iOS pairing. This Mac stays hidden from iOS while it is off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングする前に、Mac の cmux で「設定」>「Mobile」を開き、「iOS ペアリングを有効にする」をオンにしてください。オフの間、この Mac は iOS から非表示になります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie vor dem Koppeln auf dem Mac in cmux „Einstellungen“ > „Mobile“ und aktivieren Sie „iOS-Kopplung aktivieren“. Solange die Option deaktiviert ist, bleibt dieser Mac für iOS unsichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant le jumelage, ouvrez « Réglages » > « Mobile » dans cmux sur le Mac et activez « Activer le jumelage iOS ». Ce Mac reste masqué pour iOS tant que l’option est désactivée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل الاقتران، افتح في cmux على الـ Mac «الإعدادات» > «الهاتف المحمول» وفعّل «تمكين اقتران iOS». يظل هذا الـ Mac مخفيًا عن iOS أثناء إيقاف الخيار."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de enlazar, abre en cmux del Mac «Ajustes» > «Móvil» y activa «Activar el enlace con iOS». Este Mac permanece oculto para iOS mientras la opción esté desactivada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對前，請在 Mac 上的 cmux 開啟「設定」>「行動裝置」，並啟用「啟用 iOS 配對」。關閉此選項時，iOS 不會顯示這部 Mac。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对前，请在 Mac 上的 cmux 打开“设置”>“移动”，并启用“启用 iOS 配对”。关闭此选项时，iOS 不会显示这台 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링하기 전에 Mac의 cmux에서 “설정” > “모바일”을 열고 “iOS 페어링 활성화”를 켜세요. 이 옵션이 꺼져 있으면 이 Mac은 iOS에 표시되지 않습니다."
          }
        }
      }
    },
    "mobile.pairing.enableOnMac.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable iOS pairing in cmux Settings > Mobile on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
