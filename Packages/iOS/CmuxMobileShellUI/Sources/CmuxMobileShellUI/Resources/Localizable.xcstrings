    "mobile.settings.resetLocalData.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be signed out, and saved computers, keys, settings, and caches will be removed from this device. This can’t be undone. Nothing is deleted from your cmux account or from cmux servers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst abgemeldet, und gespeicherte Computer, Schlüssel, Einstellungen und Caches werden von diesem Gerät entfernt. Dies kann nicht rückgängig gemacht werden. Aus deinem cmux-Konto und von den cmux-Servern wird nichts gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté, et les ordinateurs enregistrés, les clés, les réglages et les caches seront supprimés de cet appareil. Cette action est irréversible. Rien n’est supprimé de votre compte cmux ni des serveurs cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تسجيل خروجك، وستُزال أجهزة الكمبيوتر المحفوظة والمفاتيح والإعدادات وذاكرات التخزين المؤقت من هذا الجهاز. لا يمكن التراجع عن ذلك. لا يُحذف أي شيء من حسابك في cmux أو من خوادم cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión y se eliminarán de este dispositivo los ordenadores guardados, las claves, los ajustes y las cachés. Esta acción no se puede deshacer. No se elimina nada de tu cuenta de cmux ni de los servidores de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將會登出，已儲存的電腦、金鑰、設定與快取將從此裝置移除。此操作無法復原。你的 cmux 帳號與 cmux 伺服器上的資料不會被刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将退出登录，已保存的电脑、密钥、设置和缓存将从此设备移除。此操作无法撤销。你的 cmux 账户和 cmux 服务器上的数据不会被删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃되며 저장된 컴퓨터, 키, 설정, 캐시가 이 기기에서 제거됩니다. 이 작업은 되돌릴 수 없습니다. cmux 계정이나 cmux 서버에서는 아무것도 삭제되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトされ、保存済みのコンピュータ、キー、設定、キャッシュがこのデバイスから削除されます。この操作は取り消せません。cmux アカウントや cmux サーバからは何も削除されません。"
          }
        }
      }
    },
    "mobile.localDataReset.erasing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erasing cmux data on this device…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-Daten auf diesem Gerät werden gelöscht …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
