    "mobile.iroh.check.action.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry. If this continues, share the safe report with cmux support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してください。問題が続く場合は、安全なレポートを cmux サポートと共有してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen. Wenn dies weiterhin der Fall ist, teilen Sie den sicheren Bericht mit dem cmux-Support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si cela continue, partagez le rapport sécurisé avec le support cmux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة. إذا استمر هذا الأمر، قم بمشاركة التقرير الآمن مع دعم cmux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rever. Si esto continúa, comparta el informe seguro con el soporte de cmux."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試。如果這種情況持續存在，請與 cmux 支援人員共用安全性報告。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试。如果这种情况持续存在，请与 cmux 支持人员共享安全报告。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 해 보다. 이 문제가 계속되면 cmux 지원팀과 안전 보고서를 공유하세요."
          }
        }
      }
    },
    "mobile.iroh.check.action.internet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this iPhone to the internet, then run the check again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone をインターネットに接続してから、もう一度確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie dieses iPhone mit dem Internet und führen Sie die Prüfung erneut durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez cet iPhone à Internet, puis relancez la vérification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوصيل هذا الـ iPhone بالإنترنت، ثم قم بإجراء الفحص مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte este iPhone a Internet y luego ejecute la verificación nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此 iPhone 連接到互聯網，然後再次運行檢查。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此 iPhone 连接到互联网，然后再次运行检查。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone을 인터넷에 연결한 다음 확인을 다시 실행하세요."
          }
        }
      }
    },
    "mobile.iroh.check.action.mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open cmux on your Mac and confirm both apps use the same account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で cmux を開き、両方のアプリが同じアカウントを使用していることを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie cmux auf Ihrem Mac und bestätigen Sie, dass beide Apps dasselbe Konto verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez cmux sur votre Mac et confirmez que les deux applications utilisent le même compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح cmux على جهاز Mac الخاص بك وتأكد من أن كلا التطبيقين يستخدمان نفس الحساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra cmux en su Mac y confirme que ambas aplicaciones usan la misma cuenta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上開啟 cmux 並確認兩個應用程式使用相同帳戶。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 cmux 并确认两个应用程序使用同一帐户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 cmux를 열고 두 앱이 동일한 계정을 사용하는지 확인하세요."
          }
        }
      }
    },
    "mobile.iroh.check.action.relay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your network may block relay traffic. Ask IT to allow HTTPS and WebSocket access to your configured cmux relay domains, or add an approved custom relay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークがリレートラフィックを遮断している可能性があります。設定済みの cmux リレードメインへの HTTPS と WebSocket アクセスを許可するよう IT 部門に依頼するか、承認済みのカスタムリレーを追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Netzwerk blockiert möglicherweise den Relay-Verkehr. Bitten Sie die IT, HTTPS- und WebSocket-Zugriff auf Ihre konfigurierten cmux-Relay-Domänen zuzulassen, oder fügen Sie ein genehmigtes benutzerdefiniertes Relay hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réseau peut bloquer le trafic de relais. Demandez au service informatique d'autoriser l'accès HTTPS et WebSocket à vos domaines de relais cmux configurés, ou ajoutez un relais personnalisé approuvé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تقوم شبكتك بحظر حركة مرور الترحيل. اطلب من قسم تكنولوجيا المعلومات السماح بوصول HTTPS وWebSocket إلى مجالات ترحيل cmux التي تم تكوينها، أو إضافة ترحيل مخصص معتمد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su red puede bloquear el tráfico de retransmisión. Pídale a TI que permita el acceso HTTPS y WebSocket a sus dominios de retransmisión cmux configurados, o agregue una retransmisión personalizada aprobada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的網路可能會阻止中繼流量。請求 IT 允許 HTTPS 和 WebSocket 存取您配置的 cmux 中繼域，或新增經批准的自訂中繼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的网络可能会阻止中继流量。请求 IT 允许 HTTPS 和 WebSocket 访问您配置的 cmux 中继域，或添加批准的自定义中继。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에서 릴레이 트래픽을 차단할 수 있습니다. 구성된 cmux 릴레이 도메인에 대한 HTTPS 및 WebSocket 액세스를 허용하도록 IT에 요청하거나 승인된 사용자 지정 릴레이를 추가하세요."
          }
        }
      }
    },
    "mobile.iroh.check.action.account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you are signed in, then reopen cmux and run the check again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを確認し、cmux を開き直してからもう一度確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie, dass Sie angemeldet sind, öffnen Sie dann cmux erneut und führen Sie die Prüfung erneut durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que vous êtes connecté, puis rouvrez cmux et réexécutez la vérification."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تسجيل الدخول، ثم أعد فتح cmux وقم بتشغيل التحقق مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que ha iniciado sesión, luego vuelva a abrir cmux y ejecute la verificación nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認您已登錄，然後重新開啟 cmux 並再次執行檢查。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认您已登录，然后重新打开 cmux 并再次运行检查。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인되었는지 확인한 다음 cmux를 다시 열고 확인을 다시 실행하세요."
          }
        }
      }
    },
    "mobile.iroh.check.action.settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Automatic relay selection, or fix the selected custom relay and its device secret."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー選択を「自動」にするか、選択したカスタムリレーとデバイスシークレットを修正してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie „Automatische Relay-Auswahl“ oder korrigieren Sie das ausgewählte benutzerdefinierte Relay und sein Gerätegeheimnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Sélection automatique du relais ou corrigez le relais personnalisé sélectionné et son secret de périphérique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تحديد التتابع التلقائي، أو أصلح المرحل المخصص المحدد وسر الجهاز الخاص به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija Selección automática de relé o corrija el relé personalizado seleccionado y su secreto de dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇自動繼電器選擇，或修復選定的自訂繼電器及其設備密碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择自动继电器选择，或修复选定的自定义继电器及其设备密码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 릴레이 선택을 선택하거나 선택한 사용자 지정 릴레이 및 해당 장치 비밀을 수정합니다."
          }
        }
      }
    },
    "mobile.iroh.check.action.repair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update cmux on both devices. If needed, remove and pair the Mac again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスで cmux を更新してください。必要に応じて Mac を削除し、再度ペアリングしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie cmux auf beiden Geräten. Entfernen Sie bei Bedarf den Mac und koppeln Sie ihn erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour cmux sur les deux appareils. Si nécessaire, retirez et associez à nouveau le Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث cmux على كلا الجهازين. إذا لزم الأمر، قم بإزالة جهاز Mac وإقرانه مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice cmux en ambos dispositivos. Si es necesario, retira y empareja la Mac nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新兩台裝置上的 cmux。如果需要，請移除 Mac 並再次配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新两台设备上的 cmux。如果需要，请移除 Mac 并再次配对。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치 모두에서 cmux를 업데이트합니다. 필요한 경우 Mac을 제거하고 다시 페어링하십시오."
          }
        }
      }
    },
