    "mobile.computers.forget.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed from all your devices. If it's still online, it reappears the next time it connects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスから削除されます。オンラインのままの場合は、次回接続時に再表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde von allen Ihren Geräten entfernt. Wenn es noch online ist, wird es bei der nächsten Verbindung wieder angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est supprimé de tous vos appareils. S'il est toujours en ligne, il réapparaîtra lors de sa prochaine connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالته من جميع أجهزتك. إذا كان لا يزال متصلاً بالإنترنت، فسيظهر مرة أخرى في المرة التالية التي يتصل فيها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de todos tus dispositivos. Si todavía está en línea, reaparece la próxima vez que se conecte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它已從您的所有設備中刪除。如果它仍然在線，它會在下次連接時重新出現。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已从您的所有设备中删除。如果它仍然在线，它会在下次连接时重新出现。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 삭제됩니다. 아직 온라인 상태라면 다음에 연결할 때 다시 나타납니다."
          }
