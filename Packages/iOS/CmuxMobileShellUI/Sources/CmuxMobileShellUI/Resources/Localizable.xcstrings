    "mobile.iroh.private.custom.addresses.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one IPv4 or IPv6 address per line, without a port. cmux combines it with the Mac's current broker-authenticated Iroh UDP port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPv4またはIPv6アドレスをポートなしで1行に1つ入力してください。cmuxはそのアドレスを、ブローカーが認証したMacの現在のIroh UDPポートと組み合わせます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie pro Zeile eine IPv4- oder IPv6-Adresse ohne Port ein. cmux kombiniert es mit dem aktuellen, vom Broker authentifizierten Iroh-UDP-Port des Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse IPv4 ou IPv6 par ligne, sans port. cmux le combine avec le port UDP Iroh authentifié par le courtier actuel du Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان IPv4 أو IPv6 واحدًا في كل سطر، بدون منفذ. يقوم cmux بدمجه مع منفذ Iroh UDP الحالي المعتمد من قبل الوسيط في نظام Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese una dirección IPv4 o IPv6 por línea, sin puerto. cmux lo combina con el actual puerto UDP Iroh autenticado por broker de Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行輸入一個 IPv4 或 IPv6 位址，無需連接埠。 cmux 將其與 Mac 目前經過代理驗證的 Iroh UDP 連接埠結合。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行输入一个 IPv4 或 IPv6 地址，无需端口。 cmux 将其与 Mac 当前经过代理验证的 Iroh UDP 端口相结合。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 없이 한 줄에 IPv4 또는 IPv6 주소를 하나씩 입력하세요. cmux는 이를 Mac의 현재 브로커 인증 Iroh UDP 포트와 결합합니다."
          }
        }
      }
    },
