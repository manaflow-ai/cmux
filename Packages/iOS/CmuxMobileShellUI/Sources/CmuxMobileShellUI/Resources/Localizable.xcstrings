    "mobile.iroh.saveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous networking configuration is still active. Check the values, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のネットワーク設定は引き続き有効です。入力内容を確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre vorherige Netzwerkkonfiguration ist noch aktiv. Überprüfen Sie die Werte und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration réseau précédente est toujours active. Vérifiez les valeurs, puis réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال تكوين الشبكة السابق نشطًا. تحقق من القيم، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración de red anterior todavía está activa. Verifique los valores y vuelva a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您之前的網路配置仍然有效。檢查這些值，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您之前的网络配置仍然有效。检查这些值，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 네트워킹 구성이 여전히 활성 상태입니다. 값을 확인한 후 다시 시도하세요."
          }
        }
      }
    },
