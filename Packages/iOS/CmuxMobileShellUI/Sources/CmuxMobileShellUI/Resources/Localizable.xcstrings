        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام عناصر تحكم Liquid Glass وشريط شفاف في مهمة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa controles Liquid Glass y una barra transparente en Nueva tarea."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「新增任務」中使用 Liquid Glass 控制項和透明橫條。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“新建任务”中使用 Liquid Glass 控件和透明横条。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업에서 Liquid Glass 컨트롤과 투명한 막대를 사용합니다."
          }
        }
