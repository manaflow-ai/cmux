    "mobile.iroh.check.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux automatically uses direct internet, LAN, or any VPN route available to iOS, then falls back to an allowed relay. Every route remains end-to-end encrypted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux は iOS で利用可能なインターネット、LAN、または任意の VPN 経路を自動的に使用し、必要に応じて許可されたリレーへ切り替えます。すべての経路でエンドツーエンド暗号化が維持されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux nutzt automatisch direktes Internet, LAN oder eine beliebige für iOS verfügbare VPN-Route und greift dann auf ein zulässiges Relay zurück. Jede Route bleibt Ende-zu-Ende verschlüsselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux utilise automatiquement Internet direct, LAN ou toute route VPN disponible pour iOS, puis revient à un relais autorisé. Chaque itinéraire reste crypté de bout en bout."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم cmux تلقائيًا الإنترنت المباشر أو شبكة LAN أو أي مسار VPN متاح لنظام iOS، ثم يعود إلى الترحيل المسموح به. يظل كل مسار مشفرًا من طرف إلى طرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux utiliza automáticamente Internet directo, LAN o cualquier ruta VPN disponible para iOS y luego recurre a una retransmisión permitida. Cada ruta permanece cifrada de extremo a extremo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 會自動使用直接網際網路、LAN 或 iOS 可用的任何 VPN 路由，然後回退到允許的中繼。每條路由都保持端對端加密。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 自动使用直接互联网、LAN 或 iOS 可用的任何 VPN 路由，然后回退到允许的中继。每条路由都保持端到端加密。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux는 자동으로 직접 인터넷, LAN 또는 iOS에서 사용할 수 있는 모든 VPN 경로를 사용한 다음 허용된 릴레이로 대체합니다. 모든 경로는 종단 간 암호화된 상태로 유지됩니다."
          }
        }
      }
    },
