    "agent.chat.send_instruction_guidance": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose whether to queue the instruction or steer the current turn"}},"ja":{"stringUnit":{"state":"translated","value":"指示をキューに追加するか、現在のターンを誘導するか選択します"}},"de":{"stringUnit":{"state":"translated","value":"Wählen Sie, ob die Anweisung eingereiht oder der aktuelle Durchlauf gesteuert werden soll."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez de mettre l’instruction en file ou de guider le tour actuel."}},"ar":{"stringUnit":{"state":"translated","value":"اختر ما إذا كنت تريد وضع التعليمات في قائمة الانتظار أو توجيه الدور الحالي."}},"es":{"stringUnit":{"state":"translated","value":"Elige si quieres poner la instrucción en cola o dirigir el turno actual."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇要將指示排入佇列，或引導目前回合。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择将指令排队，或引导当前回合。"}},"ko":{"stringUnit":{"state":"translated","value":"지침을 대기열에 추가할지 현재 턴을 조정할지 선택하세요"}}}},
    "agent.chat.read_only_session": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This agent session has ended and is read only."}},"ja":{"stringUnit":{"state":"translated","value":"このエージェントセッションは終了しており、読み取り専用です。"}},"de":{"stringUnit":{"state":"translated","value":"Diese Agentensitzung ist beendet und schreibgeschützt."}},"fr":{"stringUnit":{"state":"translated","value":"Cette session d’agent est terminée et en lecture seule."}},"ar":{"stringUnit":{"state":"translated","value":"انتهت جلسة الوكيل هذه وهي للقراءة فقط."}},"es":{"stringUnit":{"state":"translated","value":"Esta sesión de agente ha terminado y es de solo lectura."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此代理程式工作階段已結束，且為唯讀。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此代理会话已结束，只能读取。"}},"ko":{"stringUnit":{"state":"translated","value":"이 에이전트 세션은 종료되었으며 읽기 전용입니다."}}}},
