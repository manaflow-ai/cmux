    "mobile.onboarding.pairing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, open cmux Settings > Mobile and turn on Enable iOS pairing. Your Mac stays hidden until you do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で cmux の「設定」>「Mobile」を開き、「iOS ペアリングを有効にする」をオンにしてください。オンにするまで Mac は非表示です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf dem Mac cmux > Einstellungen > Mobile und aktivieren Sie die iOS-Kopplung. Bis dahin bleibt der Mac verborgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, ouvrez cmux > Réglages > Mobile et activez le jumelage iOS. Le Mac reste masqué jusque-là."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز Mac، افتح cmux > الإعدادات > الهاتف المحمول وفعّل اقتران iOS. سيظل Mac مخفيًا حتى تفعل ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, abre cmux > Ajustes > Móvil y activa el enlace con iOS. El Mac permanece oculto hasta entonces."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Mac 上開啟 cmux「設定」>「行動裝置」，並啟用 iOS 配對。在啟用前，Mac 會保持隱藏。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Mac 上打开 cmux“设置”>“移动”，并启用 iOS 配对。在启用前，Mac 会保持隐藏。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 cmux에서 설정 > 모바일을 열고 iOS 페어링을 켜세요. 켜기 전에는 Mac이 숨겨집니다."
          }
        }
      }
    },
