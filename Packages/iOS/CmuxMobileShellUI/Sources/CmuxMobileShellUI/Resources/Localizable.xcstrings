    "mobile.iroh.reset.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay and path preferences will return to Automatic. Saved custom relays and private addresses will remain, but private addresses will be disabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーと経路の設定は「自動」に戻ります。保存済みのカスタムリレーとプライベートアドレスは残りますが、プライベートアドレスは無効になります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Relais- und Pfadeinstellungen werden auf „Automatisch“ zurückgesetzt. Gespeicherte benutzerdefinierte Relays und private Adressen bleiben erhalten, private Adressen werden jedoch deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préférences de relais et de chemin reviendront à Automatique. Les relais personnalisés et les adresses privées enregistrés resteront, mais les adresses privées seront désactivées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعود تفضيلات التتابع والمسار إلى الوضع التلقائي. ستظل المرحلات المخصصة والعناوين الخاصة محفوظة، ولكن سيتم تعطيل العناوين الخاصة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preferencias de retransmisión y ruta volverán a Automático. Las retransmisiones personalizadas y las direcciones privadas guardadas permanecerán, pero las direcciones privadas se desactivarán."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼和路徑首選項將恢復為“自動”。保存的自訂中繼和私有位址將保留，但私人位址將被停用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继和路径首选项将恢复为“自动”。保存的自定义中继和私有地址将保留，但私有地址将被禁用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이 및 경로 기본 설정은 자동으로 돌아갑니다. 저장된 사용자 지정 릴레이 및 개인 주소는 유지되지만 개인 주소는 비활성화됩니다."
          }
        }
      }
    },
