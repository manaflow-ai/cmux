    "mobile.iroh.diagnostics.verboseLog.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records detailed connection activity to a file on this device for troubleshooting. Terminal contents and credentials are never written."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラブルシューティングのため、接続の詳細な動作をこのデバイス上のファイルに記録します。ターミナルの内容や認証情報は書き込まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet zur Fehlerbehebung detaillierte Verbindungsaktivitäten in einer Datei auf diesem Gerät auf. Terminalinhalte und Anmeldeinformationen werden niemals geschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre l'activité de connexion détaillée à un fichier sur cet appareil à des fins de dépannage. Le contenu du terminal et les informations d'identification ne sont jamais écrits."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل نشاط الاتصال التفصيلي بملف على هذا الجهاز لاستكشاف الأخطاء وإصلاحها. لا تتم كتابة محتويات المحطة وبيانات الاعتماد أبدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la actividad de conexión detallada en un archivo en este dispositivo para solucionar problemas. El contenido y las credenciales del terminal nunca se escriben."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將詳細的連接活動記錄到該裝置上的檔案中以進行故障排除。終端內容和憑證永遠不會被寫入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将详细的连接活动记录到该设备上的文件中以进行故障排除。终端内容和凭据永远不会被写入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 해결을 위해 자세한 연결 활동을 이 장치의 파일에 기록합니다. 터미널 내용과 자격 증명은 기록되지 않습니다."
          }
        }
      }
    },
