          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ مسح بيانات cmux على هذا الجهاز…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrando los datos de cmux de este dispositivo…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在清除此裝置上的 cmux 資料…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在清除此设备上的 cmux 数据…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 cmux 데이터를 지우는 중…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの cmux データを消去しています…"
          }
        }
      }
    },
    "mobile.localDataReset.finished.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux Was Reset"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux wurde zurückgesetzt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux a été réinitialisé"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة تعيين cmux"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux se ha restablecido"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 已重置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 已重置"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux가 재설정됨"
          }
