          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le jumelage iOS dans cmux, sous « Réglages » > « Mobile » sur le Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل اقتران iOS في cmux على الـ Mac من «الإعدادات» > «الهاتف المحمول»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el enlace con iOS en cmux, en «Ajustes» > «Móvil» del Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Mac 上的 cmux「設定」>「行動裝置」中啟用 iOS 配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
