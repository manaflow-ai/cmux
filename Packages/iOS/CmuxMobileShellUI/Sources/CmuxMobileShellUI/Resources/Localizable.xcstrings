    "mobile.localDataReset.finished.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All cmux data on this device was erased. Your cmux account and server data were not changed. Close cmux from the App Switcher, then open it again to start fresh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle cmux-Daten auf diesem Gerät wurden gelöscht. Dein cmux-Konto und die Serverdaten wurden nicht geändert. Schließe cmux im App-Umschalter und öffne es erneut, um neu zu beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données cmux de cet appareil ont été effacées. Votre compte cmux et les données des serveurs n’ont pas été modifiés. Fermez cmux depuis le sélecteur d’apps, puis rouvrez-le pour repartir de zéro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم مسح جميع بيانات cmux على هذا الجهاز. لم يتغير حسابك في cmux ولا بيانات الخادم. أغلق cmux من مبدّل التطبيقات، ثم افتحه مرة أخرى للبدء من جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borraron todos los datos de cmux de este dispositivo. Tu cuenta de cmux y los datos del servidor no se modificaron. Cierra cmux desde el selector de apps y vuelve a abrirlo para empezar de cero."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的所有 cmux 資料已清除。你的 cmux 帳號與伺服器資料未被變更。請從 App 切換器關閉 cmux，再重新開啟以全新開始。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的所有 cmux 数据已清除。你的 cmux 账户和服务器数据未被更改。请从 App 切换器关闭 cmux，然后重新打开以全新开始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 모든 cmux 데이터가 지워졌습니다. cmux 계정과 서버 데이터는 변경되지 않았습니다. 앱 전환기에서 cmux를 닫은 다음 다시 열어 새로 시작하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのすべての cmux データを消去しました。cmux アカウントとサーバのデータは変更されていません。App スイッチャーで cmux を閉じてから、もう一度開くと最初から始まります。"
          }
        }
      }
    },
    "mobile.workspaces.empty.retryTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The connection is taking longer than expected. Try again or check the setup guide."}},
        "ja": {"stringUnit": {"state": "translated", "value": "接続に時間がかかっています。もう一度試すか、設定ガイドを確認してください。"}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Verbindung dauert länger als erwartet. Versuchen Sie es erneut oder prüfen Sie die Einrichtungsanleitung."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La connexion prend plus de temps que prévu. Réessayez ou consultez le guide de configuration."}},
        "ar": {"stringUnit": {"state": "translated", "value": "يستغرق الاتصال وقتًا أطول من المتوقع. حاول مرة أخرى أو راجع دليل الإعداد."}},
        "es": {"stringUnit": {"state": "translated", "value": "La conexión está tardando más de lo esperado. Inténtalo de nuevo o consulta la guía de configuración."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "連線時間比預期長。請再試一次，或查看設定指南。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "连接时间比预期长。请重试，或查看设置指南。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "연결에 예상보다 오래 걸리고 있습니다. 다시 시도하거나 설정 가이드를 확인하세요."}}
      }
    },
