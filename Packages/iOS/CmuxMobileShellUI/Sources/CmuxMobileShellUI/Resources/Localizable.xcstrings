    "mobile.push.reply.failure.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reply didn’t reach your Mac. Open cmux to send it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信はMacに届きませんでした。cmuxを開いてもう一度送信してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Antwort hat Ihren Mac nicht erreicht. Öffnen Sie cmux, um es erneut zu senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse n'est pas parvenue sur votre Mac. Ouvrez cmux pour le renvoyer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل ردك إلى جهاز Mac الخاص بك. افتح cmux لإرساله مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta no llegó a tu Mac. Abra cmux para enviarlo nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的回覆未到達您的 Mac。打開 cmux 再次發送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的回复未到达您的 Mac。打开 cmux 再次发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장이 Mac에 전달되지 않았습니다. cmux를 열어 다시 보내세요."
          }
        }
      }
    },
