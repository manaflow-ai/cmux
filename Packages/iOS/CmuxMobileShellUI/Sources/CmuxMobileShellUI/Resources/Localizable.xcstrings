    "agent.chat.image_could_not_be_prepared_for_paste": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"That image couldn’t be prepared. Choose another image."}},"ja":{"stringUnit":{"state":"translated","value":"その画像を準備できませんでした。別の画像を選択してください。"}},"de":{"stringUnit":{"state":"translated","value":"Dieses Bild konnte nicht vorbereitet werden. Wählen Sie ein anderes Bild."}},"fr":{"stringUnit":{"state":"translated","value":"Cette image n’a pas pu être préparée. Choisissez une autre image."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تجهيز هذه الصورة. اختر صورة أخرى."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo preparar esa imagen. Elige otra imagen."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法準備此影像。請選擇其他影像。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备该图片。请选择其他图片。"}},"ko":{"stringUnit":{"state":"translated","value":"이미지를 준비할 수 없습니다. 다른 이미지를 선택하세요."}}}},
