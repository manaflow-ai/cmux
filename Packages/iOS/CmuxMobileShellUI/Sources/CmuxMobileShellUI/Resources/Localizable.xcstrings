    "agent.chat.preview_unavailable_for_file_type": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview is unavailable for this file type."}},"ja":{"stringUnit":{"state":"translated","value":"このファイル形式ではプレビューを利用できません。"}},"de":{"stringUnit":{"state":"translated","value":"Für diesen Dateityp ist keine Vorschau verfügbar."}},"fr":{"stringUnit":{"state":"translated","value":"L’aperçu n’est pas disponible pour ce type de fichier."}},"ar":{"stringUnit":{"state":"translated","value":"المعاينة غير متاحة لنوع الملف هذا."}},"es":{"stringUnit":{"state":"translated","value":"La vista previa no está disponible para este tipo de archivo."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法預覽此檔案類型。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此文件类型无法预览。"}},"ko":{"stringUnit":{"state":"translated","value":"이 파일 형식에서는 미리보기를 사용할 수 없습니다."}}}},
    "agent.chat.microphone_permission_guidance": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow microphone and speech recognition to dictate."}},"ja":{"stringUnit":{"state":"translated","value":"許可 マイク と 音声 認識 に 音声入力."}},"de":{"stringUnit":{"state":"translated","value":"Erlauben Mikrofon und Sprache Erkennung zu diktieren."}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser microphone et parole reconnaissance pour dicter."}},"ar":{"stringUnit":{"state":"translated","value":"السماح الميكروفون و الكلام التعرف إلى الإملاء."}},"es":{"stringUnit":{"state":"translated","value":"Permitir micrófono y voz reconocimiento para dictar."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"允許 麥克風 與 語音 辨識 至 聽寫."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许 麦克风 和 语音 识别 到 听写."}},"ko":{"stringUnit":{"state":"translated","value":"허용 마이크 및 음성 인식 으로 받아쓰기."}}}},
