            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시도"
          }
        }
      }
    },
    "mobile.terminal.outputRecovery.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal paused"
          }
        },
        "ja": {
