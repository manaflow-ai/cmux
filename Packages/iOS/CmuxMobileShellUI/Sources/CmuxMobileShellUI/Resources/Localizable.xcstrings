    "mobile.settings.resetLocalData.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out and removes all cmux data stored on this device, including saved computers, keys, settings, and caches, so cmux starts like a new install. Your cmux account and the data stored in cmux, cmux Cloud, and on your computers are not deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich ab und entfernt alle auf diesem Gerät gespeicherten cmux-Daten, einschließlich gespeicherter Computer, Schlüssel, Einstellungen und Caches, sodass cmux wie nach einer Neuinstallation startet. Dein cmux-Konto und die in cmux, cmux Cloud und auf deinen Computern gespeicherten Daten werden nicht gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous déconnecte et supprime toutes les données cmux stockées sur cet appareil, y compris les ordinateurs enregistrés, les clés, les réglages et les caches, pour que cmux démarre comme une nouvelle installation. Votre compte cmux et les données stockées dans cmux, cmux Cloud et sur vos ordinateurs ne sont pas supprimés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل خروجك ويزيل جميع بيانات cmux المخزنة على هذا الجهاز، بما في ذلك أجهزة الكمبيوتر المحفوظة والمفاتيح والإعدادات وذاكرات التخزين المؤقت، ليبدأ cmux كأنه تثبيت جديد. لا يتم حذف حسابك في cmux ولا البيانات المخزنة في cmux وcmux Cloud وعلى أجهزة الكمبيوتر الخاصة بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión y elimina todos los datos de cmux guardados en este dispositivo, incluidos los ordenadores guardados, las claves, los ajustes y las cachés, para que cmux se inicie como una instalación nueva. Tu cuenta de cmux y los datos guardados en cmux, cmux Cloud y en tus ordenadores no se eliminan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出並移除此裝置上儲存的所有 cmux 資料，包括已儲存的電腦、金鑰、設定與快取，讓 cmux 如同全新安裝般啟動。你的 cmux 帳號以及儲存在 cmux、cmux Cloud 和你電腦上的資料不會被刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录并移除此设备上存储的所有 cmux 数据，包括已保存的电脑、密钥、设置和缓存，让 cmux 像全新安装一样启动。你的 cmux 账户以及存储在 cmux、cmux Cloud 和你电脑上的数据不会被删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하고 저장된 컴퓨터, 키, 설정, 캐시를 포함해 이 기기에 저장된 모든 cmux 데이터를 제거하여 cmux가 새로 설치한 것처럼 시작됩니다. cmux 계정과 cmux, cmux Cloud 및 컴퓨터에 저장된 데이터는 삭제되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトし、保存済みのコンピュータ、キー、設定、キャッシュを含む、このデバイスに保存されたすべての cmux データを削除して、cmux を新規インストール時の状態で起動します。cmux アカウントと、cmux、cmux Cloud、コンピュータに保存されたデータは削除されません。"
          }
        }
      }
    },
