    "agent.chat.max_images_reached": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can attach up to 10 images."}},"ja":{"stringUnit":{"state":"translated","value":"画像は最大 10 枚まで追加できます。"}},"de":{"stringUnit":{"state":"translated","value":"Sie können bis zu 10 Bilder hinzufügen."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez joindre jusqu’à 10 images."}},"ar":{"stringUnit":{"state":"translated","value":"يمكنك إرفاق ما يصل إلى 10 صور."}},"es":{"stringUnit":{"state":"translated","value":"Puedes adjuntar hasta 10 imágenes."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最多可加入 10 張影像。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最多可添加 10 张图片。"}},"ko":{"stringUnit":{"state":"translated","value":"이미지는 최대 10개까지 첨부할 수 있습니다."}}}},
