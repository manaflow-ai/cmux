    "agent.chat.file_could_not_be_attached": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"That file could not be attached. Files must be 32 MB or smaller."}},"ja":{"stringUnit":{"state":"translated","value":"その ファイル できませんでした ない する 添付. ファイル 必要 する 32 MB または 以下."}},"de":{"stringUnit":{"state":"translated","value":"Diese Datei konnte nicht sein angehängt. Dateien müssen sein 32 MB oder kleiner."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fichier pourrait ne être joint. Fichiers doivent être 32 MB ou inférieurs."}},"ar":{"stringUnit":{"state":"translated","value":"ذلك ملف يتعذر لا يكون إرفاقه. ملفات يجب يكون 32 MB أو أصغر."}},"es":{"stringUnit":{"state":"translated","value":"Ese archivo podría no ser adjunto. Archivos deben ser 32 MB o menores."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此 檔案 無法 不 被 附加. 檔案 必須 被 32 MB 或 小於."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 文件 无法 不 被 附加. 文件 必须 被 32 MB 或 小于."}},"ko":{"stringUnit":{"state":"translated","value":"해당 파일 할 수 없음 않음 됨 첨부됨. 파일 이어야 함 됨 32 MB 또는 작은."}}}},
