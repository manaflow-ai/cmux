{
  "sourceLanguage": "en",
  "strings": {
    "mobile.signIn.billingRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already paid? Recover your account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払い済みですか？アカウントを復旧する"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits bezahlt? Stellen Sie Ihr Konto wieder her"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà payé ? Récupérez votre compte"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفعت بالفعل؟ استرداد حسابك"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya pagó? Recupera tu cuenta"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已经付款了？恢復您的帳戶"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经付款了？恢复您的帐户"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 지불하셨나요? 계정을 복구하세요"
          }
        }
      }
    },
    "mobile.signIn.billingRecoverySent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request accepted. If you do not receive an email, try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを受け付けました。メールが届かない場合は、しばらくしてからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfrage angenommen. Wenn Sie keine E-Mail erhalten, versuchen Sie es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande acceptée. Si vous ne recevez pas d'e-mail, réessayez plus tard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قبول الطلب. إذا لم تتلق بريدًا إلكترونيًا، حاول مرة أخرى لاحقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud aceptada. Si no recibe un correo electrónico, vuelva a intentarlo más tarde."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求已接受。如果您沒有收到電子郵件，請稍後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求已接受。如果您没有收到电子邮件，请稍后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 승인되었습니다. 이메일을 받지 못한 경우 나중에 다시 시도하세요."
          }
        }
      }
    },
    "mobile.terminal.outputRecovery.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückweisen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeter"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despedir"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解僱"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解雇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해고하다"
          }
        }
      }
    },
    "mobile.terminal.outputRecovery.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal output stopped unexpectedly. Retry to reconnect this terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル出力が予期せず停止しました。再試行してこのターミナルに再接続してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Terminalausgabe wurde unerwartet gestoppt. Versuchen Sie erneut, dieses Terminal erneut zu verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie du terminal s'est arrêtée de manière inattendue. Réessayez de reconnecter ce terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الإخراج الطرفي بشكل غير متوقع. أعد محاولة إعادة توصيل هذه المحطة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida del terminal se detuvo inesperadamente. Vuelva a intentar conectar este terminal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端輸出意外停止。重試重新連接該終端。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端输出意外停止。重试重新连接该终端。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 출력이 예기치 않게 중지되었습니다. 이 터미널을 다시 연결해 보세요."
          }
        }
      }
    },
    "mobile.terminal.outputRecovery.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
