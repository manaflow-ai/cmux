    "terminal.artifact.gallery.action_failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the connection to your Mac and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macへの接続を確認して、もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Verbindung zu Ihrem Mac und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la connexion à votre Mac et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاتصال بجهاز Mac وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la conexión a su Mac e inténtelo nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查與 Mac 的連接，然後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查与 Mac 的连接，然后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 연결을 확인하고 다시 시도하십시오."
          }
        }
      }
    },
