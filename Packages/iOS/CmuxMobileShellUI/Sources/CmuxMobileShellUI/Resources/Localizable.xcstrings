    "mobile.settings.legacyTerminalSizing.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let apps like Vim extend beneath the keyboard and toolbars."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vimなどのアプリをキーボードやツールバーの下まで表示します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps wie Vim dürfen sich hinter Tastatur und Symbolleisten erstrecken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettre aux apps comme Vim de s’étendre sous le clavier et les barres d’outils."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح لتطبيقات مثل Vim بالامتداد خلف لوحة المفاتيح وأشرطة الأدوات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que apps como Vim se extiendan bajo el teclado y las barras de herramientas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Vim 等 App 延伸至鍵盤和工具列下方。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Vim 等 App 延伸至键盘和工具栏下方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vim 같은 앱을 키보드와 도구 막대 아래까지 확장합니다."
          }
        }
      }
    },
    "mobile.settings.handoffTerminalSizing": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Hand Off Terminal Sizing When Inactive"}},
        "ja": {"stringUnit": {"state": "translated", "value": "非アクティブ時にターミナルサイズを引き継ぐ"}},
        "de": {"stringUnit": {"state": "translated", "value": "Terminalgröße bei Inaktivität übergeben"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Transférer le dimensionnement du terminal en cas d’inactivité"}},
        "ar": {"stringUnit": {"state": "translated", "value": "تسليم تحجيم الطرفية عند عدم النشاط"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ceder el dimensionamiento del terminal cuando está inactivo"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "非使用中時交接終端機大小"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "不活跃时移交终端大小"}},
        "ko": {"stringUnit": {"state": "translated", "value": "비활성 상태일 때 터미널 크기 넘기기"}}
      }
    },
    "mobile.settings.handoffTerminalSizing.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Let the Mac choose the terminal size while this app is in the background."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このアプリがバックグラウンドにある間は、Macにターミナルサイズを任せます。"}},
        "de": {"stringUnit": {"state": "translated", "value": "Der Mac wählt die Terminalgröße, während diese App im Hintergrund ist."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Laisser le Mac choisir la taille du terminal lorsque l’app est en arrière-plan."}},
        "ar": {"stringUnit": {"state": "translated", "value": "السماح لجهاز Mac باختيار حجم الطرفية عندما يكون هذا التطبيق في الخلفية."}},
        "es": {"stringUnit": {"state": "translated", "value": "Dejar que el Mac elija el tamaño del terminal mientras esta app está en segundo plano."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此 App 在背景執行時，讓 Mac 選擇終端機大小。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 App 在后台运行时，让 Mac 选择终端大小。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 앱이 백그라운드에 있을 때 Mac이 터미널 크기를 선택하도록 합니다."}}
      }
    },
