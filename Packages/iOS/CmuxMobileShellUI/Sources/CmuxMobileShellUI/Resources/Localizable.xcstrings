        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reply didn’t reach your Mac. Open cmux to send it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信はMacに届きませんでした。cmuxを開いてもう一度送信してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Antwort hat Ihren Mac nicht erreicht. Öffnen Sie cmux, um es erneut zu senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse n'est pas parvenue sur votre Mac. Ouvrez cmux pour le renvoyer."
