    "mobile.iroh.diagnostics.clear.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the connection timeline stored on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存された接続タイムラインを完全に削除します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die auf diesem Gerät gespeicherte Verbindungszeitleiste dauerhaft entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement la chronologie de connexion stockée sur cet appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة المخطط الزمني للاتصال المخزن على هذا الجهاز بشكل دائم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente la línea de tiempo de conexión almacenada en este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久刪除儲存在該裝置上的連接時間軸。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除存储在该设备上的连接时间线。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에 저장된 연결 타임라인이 영구적으로 제거됩니다."
          }
        }
      }
    },
    "mobile.iroh.diagnostics.eventCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded Events"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済みイベント"
          }
        },
        "de": {
