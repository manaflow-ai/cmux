    "mobile.iroh.check.allowlist.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow outbound HTTPS and WebSocket access to these cmux relay origins:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の cmux リレーオリジンへの送信 HTTPS および WebSocket アクセスを許可してください:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie ausgehenden HTTPS- und WebSocket-Zugriff auf diese cmux-Relay-Ursprünge:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'accès HTTPS et WebSocket sortant à ces origines de relais cmux :"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
