        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿使用繼電器"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿使用继电器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이를 절대 사용하지 마세요"
          }
        }
      }
    },
    "mobile.iroh.pathPreference.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, cmux requires a reachable direct, local-network, or private-network path and will not fall back to a relay. Applies on the next reconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、cmuxは到達可能な直接経路、ローカルネットワーク経路、またはプライベートネットワーク経路を必要とし、リレーにはフォールバックしません。次回の再接続時に適用されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, erfordert cmux einen erreichbaren direkten, lokalen Netzwerk- oder privaten Netzwerkpfad und greift nicht auf ein Relay zurück. Gilt bei der nächsten erneuten Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est activé, cmux nécessite un chemin d'accès direct, local ou privé et ne reviendra pas à un relais. S'applique à la prochaine reconnexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التمكين، يتطلب cmux مسارًا مباشرًا أو شبكة محلية أو شبكة خاصة يمكن الوصول إليه ولن يتراجع إلى الترحيل. ينطبق على إعادة الاتصال القادمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, cmux requiere una ruta directa accesible, de red local o de red privada y no recurrirá a un relé. Aplica en la próxima reconexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，cmux 需要可存取的直接、本地網路或專用網路路徑，並且不會回退到中繼。適用於下次重新連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，cmux 需要可访问的直接、本地网络或专用网络路径，并且不会回退到中继。适用于下次重新连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화되면 cmux는 연결 가능한 직접, 로컬 네트워크 또는 개인 네트워크 경로가 필요하며 릴레이로 대체되지 않습니다. 다음 재접속 시 적용됩니다."
          }
        }
      }
    },
