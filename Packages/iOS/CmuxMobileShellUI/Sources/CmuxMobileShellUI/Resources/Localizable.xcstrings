    "mobile.iroh.diagnostics.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report remains available while disconnected. It excludes terminal content, account and endpoint identities, network addresses, relay URLs, credentials, and raw errors. Nothing leaves this device until you share it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートは接続が切れていても利用できます。ターミナルの内容、アカウントおよびエンドポイントの識別情報、ネットワークアドレス、リレー URL、認証情報、生のエラーは含まれません。共有するまで、このデバイスから送信されることはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht bleibt auch bei getrennter Verbindung verfügbar. Ausgenommen sind Terminalinhalte, Konto- und Endpunktidentitäten, Netzwerkadressen, Relay-URLs, Anmeldeinformationen und Rohfehler. Nichts verlässt dieses Gerät, bis Sie es teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rapport reste disponible même lorsque vous êtes déconnecté. Il exclut le contenu du terminal, les identités de compte et de point de terminaison, les adresses réseau, les URL de relais, les informations d'identification et les erreurs brutes. Rien ne quitte cet appareil tant que vous ne le partagez pas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل هذا التقرير متاحًا أثناء قطع الاتصال. وهو يستثني المحتوى الطرفي وهويات الحساب ونقطة النهاية وعناوين الشبكة وعناوين URL للترحيل وبيانات الاعتماد والأخطاء الأولية. لا شيء يترك هذا الجهاز حتى تشاركه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe permanece disponible mientras esté desconectado. Excluye contenido de terminal, identidades de cuentas y puntos finales, direcciones de red, URL de retransmisión, credenciales y errores sin procesar. Nada sale de este dispositivo hasta que lo compartes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該報告在斷開​​連接時仍然可用。它不包括終端內容、帳戶和端點身分、網路位址、中繼 URL、憑證和原始錯誤。在您共用該裝置之前，任何內容都不會離開該裝置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该报告在断开连接时仍然可用。它不包括终端内容、帐户和端点身份、网络地址、中继 URL、凭据和原始错误。在您共享该设备之前，任何内容都不会离开该设备。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보고서는 연결이 끊어진 동안에도 계속 사용할 수 있습니다. 터미널 콘텐츠, 계정 및 엔드포인트 ID, 네트워크 주소, 릴레이 URL, 자격 증명 및 원시 오류는 제외됩니다. 공유하기 전까지는 이 기기에서 아무 것도 남지 않습니다."
          }
        }
      }
    },
