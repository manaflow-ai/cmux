    "mobile.workspace.customize.description.truncated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac description is longer than iPhone can edit. Change it on Mac to avoid losing text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの説明はiPhoneで編集できる長さを超えています。テキストを失わないようMacで変更してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mac-Beschreibung ist länger, als das iPhone bearbeiten kann. Ändern Sie es auf dem Mac, um Textverluste zu vermeiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette description Mac est plus longue que ce que l’iPhone peut modifier. Modifiez-le sur Mac pour éviter de perdre du texte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصف Mac هذا أطول مما يستطيع iPhone تحريره. قم بتغييره على نظام Mac لتجنب فقدان النص."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta descripción de Mac es más larga de lo que el iPhone puede editar. Cámbielo en Mac para evitar perder texto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 描述的長度超出了 iPhone 可以編輯的長度。在 Mac 上更改它以避免丟失文字。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 描述的长度超出了 iPhone 可以编辑的长度。在 Mac 上更改它以避免丢失文本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac 설명은 iPhone이 편집할 수 있는 것보다 깁니다. 텍스트 손실을 방지하려면 Mac에서 변경하세요."
          }
        }
      }
    },
    "mobile.workspace.customize.concurrentChange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace changed on your Mac. Review the latest values and save again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースはMacで変更されました。最新の値を確認して、もう一度保存してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich hat sich auf Ihrem Mac geändert. Überprüfen Sie die neuesten Werte und speichern Sie sie erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail a changé sur votre Mac. Vérifiez les dernières valeurs et enregistrez à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير مساحة العمل هذه على جهاز Mac الخاص بك. راجع أحدث القيم واحفظها مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo cambió en tu Mac. Revise los valores más recientes y guárdelos nuevamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作區在您的 Mac 上發生了變化。查看最新值並再次儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区在您的 Mac 上发生了变化。查看最新值并再次保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이 작업 공간이 변경되었습니다. 최신 값을 검토하고 다시 저장하세요."
          }
        }
      }
    },
    "mobile.workspace.customize.workspaceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace is no longer available. Reopen the workspace list and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースは利用できなくなりました。ワークスペース一覧を開き直して、もう一度試してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich ist nicht mehr verfügbar. Öffnen Sie die Arbeitsbereichsliste erneut und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail n'est plus disponible. Rouvrez la liste des espaces de travail et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة العمل هذه لم تعد متوفرة. أعد فتح قائمة مساحات العمل وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo ya no está disponible. Vuelva a abrir la lista de espacios de trabajo e inténtelo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該工作區不再可用。重新開啟工作區清單並重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该工作区不再可用。重新打开工作区列表并重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업공간은 더 이상 사용할 수 없습니다. 작업공간 목록을 다시 열고 다시 시도하세요."
          }
        }
      }
    },
