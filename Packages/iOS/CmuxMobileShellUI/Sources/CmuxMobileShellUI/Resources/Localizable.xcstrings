    "mobile.localDataReset.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some cmux data on this device could not be erased. Try again. Your cmux account and server data were not changed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige cmux-Daten auf diesem Gerät konnten nicht gelöscht werden. Versuche es erneut. Dein cmux-Konto und die Serverdaten wurden nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données cmux de cet appareil n’ont pas pu être effacées. Réessayez. Votre compte cmux et les données des serveurs n’ont pas été modifiés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر مسح بعض بيانات cmux على هذا الجهاز. حاول مرة أخرى. لم يتغير حسابك في cmux ولا بيانات الخادم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron borrar algunos datos de cmux de este dispositivo. Inténtalo de nuevo. Tu cuenta de cmux y los datos del servidor no se modificaron."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的部分 cmux 資料無法清除。請再試一次。你的 cmux 帳號與伺服器資料未被變更。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的部分 cmux 数据无法清除。请重试。你的 cmux 账户和服务器数据未被更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 일부 cmux 데이터를 지울 수 없습니다. 다시 시도하세요. cmux 계정과 서버 데이터는 변경되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの一部の cmux データを消去できませんでした。もう一度お試しください。cmux アカウントとサーバのデータは変更されていません。"
          }
        }
      }
    },
