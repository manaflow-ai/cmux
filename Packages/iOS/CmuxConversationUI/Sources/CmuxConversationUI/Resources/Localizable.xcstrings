    "conversation.archive.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the task from the remote task list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird die Aufgabe aus der Remote-Aufgabenliste entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime la tâche de la liste des tâches distantes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى إزالة المهمة من قائمة المهام البعيدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la tarea de la lista de tareas remotas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從遠端工作列表中移除工作。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从远程任务列表中移除任务。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 작업 목록에서 작업이 제거됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートタスク一覧からタスクが削除されます。"
          }
        }
      }
    },
