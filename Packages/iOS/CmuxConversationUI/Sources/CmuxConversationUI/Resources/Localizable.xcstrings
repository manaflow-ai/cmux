    "conversation.capabilities": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These controls follow the capabilities advertised by the connected provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Steuerelemente folgen den vom verbundenen Anbieter gemeldeten Fähigkeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces commandes suivent les capacités annoncées par le fournisseur connecté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع عناصر التحكم هذه الإمكانات التي يعلنها المزوّد المتصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos controles siguen las capacidades anunciadas por el proveedor conectado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些控制項會依照已連線提供者所宣告的功能運作。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些控件遵循已连接提供方公布的功能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제어 항목은 연결된 제공자가 알린 기능을 따릅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのコントロールは接続中のプロバイダが示す機能に従います。"
          }
        }
      }
    },
