    "conversation.error.artifact_chunk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The artifact transfer returned an invalid chunk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Artefaktübertragung hat einen ungültigen Teil zurückgegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert de l’artefact a renvoyé un fragment invalide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد نقل العنصر جزءًا غير صالح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia del artefacto devolvió un fragmento no válido."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "構件傳輸傳回了無效區塊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工件传输返回了无效分块。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아티팩트 전송에서 잘못된 조각을 반환했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーティファクト転送から無効なチャンクが返されました。"
          }
        }
      }
    },
    "conversation.error.artifact_hash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded artifact failed its integrity check."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heruntergeladene Artefakt hat die Integritätsprüfung nicht bestanden."
          }
