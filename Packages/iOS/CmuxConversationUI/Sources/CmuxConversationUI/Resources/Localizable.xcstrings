          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供方工作时无法接受后续消息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제공자는 작업 중에 후속 요청을 받을 수 없습니다."
