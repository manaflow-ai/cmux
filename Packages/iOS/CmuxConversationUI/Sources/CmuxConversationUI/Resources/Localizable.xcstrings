    "conversation.error.command_uncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command outcome is unknown. Check the task before retrying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis des Befehls ist unbekannt. Prüfe die Aufgabe, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la commande est inconnu. Vérifiez la tâche avant de réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة الأمر غير معروفة. تحقق من المهمة قبل إعادة المحاولة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desconoce el resultado del comando. Comprueba la tarea antes de volver a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令結果不明。請先檢查工作再重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令结果未知。请先检查任务再重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 결과를 알 수 없습니다. 다시 시도하기 전에 작업을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの結果は不明です。再試行する前にタスクを確認してください。"
          }
        }
      }
    },
    "conversation.error.event_overflow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event stream changed too quickly. Reopen the task to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ereignisstrom hat sich zu schnell geändert. Öffne die Aufgabe erneut, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux d’événements a changé trop rapidement. Rouvrez la tâche pour continuer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر تدفق الأحداث بسرعة كبيرة. أعد فتح المهمة للمتابعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo de eventos cambió demasiado rápido. Vuelve a abrir la tarea para continuar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "事件串流變更過快。請重新開啟工作以繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件流变化过快。请重新打开任务以继续。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 스트림이 너무 빠르게 변경되었습니다. 계속하려면 작업을 다시 여세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントストリームの変化が速すぎます。続行するにはタスクを開き直してください。"
          }
        }
      }
    },
    "conversation.error.followup_unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider cannot accept a follow-up while it is working."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter kann während der Arbeit keine Folgeanfrage annehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur ne peut pas accepter de suivi pendant son activité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
