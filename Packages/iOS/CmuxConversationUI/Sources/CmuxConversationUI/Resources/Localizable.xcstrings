    "conversation.welcome.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an instruction to start a task. You can queue follow-ups, review tool work, and answer requests here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende eine Anweisung, um eine Aufgabe zu starten. Hier kannst du Folgeanfragen einreihen, Tool-Arbeit prüfen und Anfragen beantworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une instruction pour commencer une tâche. Vous pouvez mettre des suivis en file, examiner le travail des outils et répondre aux demandes ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل تعليمات لبدء مهمة. يمكنك وضع المتابعات في قائمة الانتظار ومراجعة عمل الأدوات والإجابة عن الطلبات هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una instrucción para iniciar una tarea. Aquí puedes poner seguimientos en cola, revisar el trabajo de las herramientas y responder solicitudes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送指示以開始工作。你可以在這裡將後續訊息加入佇列、檢閱工具工作並回應要求。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送指令以开始任务。你可以在这里将后续消息加入队列、查看工具工作并回复请求。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 시작하려면 지시를 보내세요. 여기에서 후속 요청을 대기열에 넣고 도구 작업을 검토하며 요청에 답할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示を送信してタスクを開始します。ここでフォローアップをキューに入れ、ツールの作業を確認し、リクエストに回答できます。"
          }
        }
      }
    },
