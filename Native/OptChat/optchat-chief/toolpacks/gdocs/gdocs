G.fetchBasic=(id,rid)=>{G.r[rid]=null;fetch(G.base()+'/d/'+id+'/mobilebasic',{credentials:'include',cache:'no-store'})
 .then(r=>r.text().then(t=>{G.r[rid]={ok:r.ok,status:r.status,url:r.url,html:t}}))
 .catch(e=>{G.r[rid]={ok:false,error:String(e)}})};
return 'ok'})()
"""


import hashlib  # noqa: E402

# The page library's version: its own hash, so a tab holding an older copy loads this one.
EDITOR_V = hashlib.sha256(EDITOR_JS.encode()).hexdigest()[:12]
EDITOR_JS = EDITOR_JS.replace("@V@", EDITOR_V)


class Browser:
    """One cmux browser tab, driven with `cmux browser TAB eval|wait|...`."""

    def __init__(self, tab, agent, cmux="cmux"):
        self.tab = tab
        self.agent = agent
        self.cmux = cmux

    def run(self, *args, check=True):
        cmd = [self.cmux, "--json", "browser", self.tab, *args]
        p = subprocess.run(cmd, capture_output=True, text=True)
        if check and p.returncode != 0:
            raise GdocsError("browser", f"{' '.join(cmd[:5])}: {(p.stderr or p.stdout).strip()[:400]}")
        try:
            return json.loads(p.stdout) if p.stdout.strip() else {}
        except json.JSONDecodeError:
            return {"raw": p.stdout}

    def eval(self, js):
        out = self.run("eval", js)
        if "code" in out and "message" in out:
            raise GdocsError("js_error", out["message"])
        return out.get("value")

    def wait_fn(self, js, timeout_ms=20000):
        self.run("wait", "--function", js, "--timeout-ms", str(timeout_ms))

    def url(self):
        return self.eval("location.href")

    def ensure_lib(self):
        if self.eval(f"!!(window.__cmuxGdocs&&window.__cmuxGdocs.v==='{EDITOR_V}')") is not True:
            self.eval(EDITOR_JS)

    def call(self, expr):
        self.ensure_lib()
        return self.eval(f"(()=>{{const G=window.__cmuxGdocs;return {expr}}})()")

    def open_doc(self, did, edit):
        """Puts the tab on the doc (edit view when `edit`)."""
        href = self.url() or ""
        if did not in href or "/mobilebasic" in href:
            self.run("navigate", f"https://docs.google.com/document/d/{did}/edit")
            href = ""
        if edit:
            self.wait_fn("!!document.querySelector('iframe.docs-texteventtarget-iframe')", 30000)
        elif "docs.google.com" not in (href or self.url() or ""):
            self.run("navigate", f"https://docs.google.com/document/d/{did}/edit")
            self.run("wait", "--load-state", "interactive", "--timeout-ms", "30000")

    def mobilebasic(self, did):
        rid = uuid.uuid4().hex[:12]
        self.call(f"(G.fetchBasic({json.dumps(did)},{json.dumps(rid)}),1)")
        self.wait_fn(f"!!(window.__cmuxGdocs&&window.__cmuxGdocs.r[{json.dumps(rid)}])", 30000)
        r = self.eval(f"(()=>{{const R=window.__cmuxGdocs.r;const v=R[{json.dumps(rid)}];delete R[{json.dumps(rid)}];return v}})()")
        if not r or not r.get("ok"):
            raise GdocsError("read_failed", f"mobilebasic: {r and (r.get('error') or r.get('status'))}")
        if "accounts.google.com" in (r.get("url") or "") or 'class="doc-content"' not in r["html"]:
            raise GdocsError("signed_out", "the tab's Google session cannot open this doc (sign in, or pick the account)")
        return r["html"]


def open_tab(url, cmux="cmux"):
    p = subprocess.run([cmux, "--json", "open", url], capture_output=True, text=True)
    if p.returncode != 0:
        raise GdocsError("browser", f"cmux open: {p.stderr.strip()[:300]}")
    tab = json.loads(p.stdout).get("tab_id")
    if not tab:
        raise GdocsError("browser", f"cmux open gave no tab: {p.stdout[:300]}")
    print(f"gdocs: opened {tab} (pass --tab {tab} next time)", file=sys.stderr)
    return tab


# ------------------------------------------------------------------- API

class Api:
    """Drive v3 with an OAuth access token (GDOCS_TOKEN). GDOCS_API_BASE
    points it at a test server."""

    def __init__(self, token, base=None):
        self.token = token
        self.base = (base or "https://www.googleapis.com").rstrip("/")

    def req(self, method, path, body=None, ctype=None):
        r = urllib.request.Request(self.base + path, data=body, method=method)
        r.add_header("Authorization", f"Bearer {self.token}")
        if ctype:
            r.add_header("Content-Type", ctype)
        try:
            with urllib.request.urlopen(r, timeout=60) as resp:
                return resp.read().decode("utf-8")
        except urllib.error.HTTPError as e:
            raise GdocsError(f"api_{e.code}", f"{method} {path}: {e.read().decode('utf-8', 'replace')[:300]}")

    def export_html(self, did):
        return self.req("GET", f"/drive/v3/files/{did}/export?mimeType=text%2Fhtml")

    def replace_html(self, did, body):
        doc = f"<html><head><meta charset=\"utf-8\"></head><body>{body}</body></html>"
        return self.req("PATCH", f"/upload/drive/v3/files/{did}?uploadType=media",
                        doc.encode("utf-8"), "text/html; charset=utf-8")

    def comment(self, did, text, quoted):
        body = {"content": text}
        if quoted:
            body["quotedFileContent"] = {"mimeType": "text/plain", "value": quoted}
        return self.req("POST", f"/drive/v3/files/{did}/comments?fields=id",
                        json.dumps(body).encode(), "application/json")


# ------------------------------------------------------------- commands

def read_md_arg(a):
    if a.md == "-":
        return sys.stdin.read()
    if a.md is not None:
        with open(a.md, encoding="utf-8") as f:
            return f.read()
    if getattr(a, "text", None) is not None:
        return a.text
    raise GdocsError("usage", "give --md FILE|- or --text TEXT")


class Ctx:
    def __init__(self, a):
        self.a = a
        self.did = doc_id(a.doc) if getattr(a, "doc", None) else None
        token = os.environ.get("GDOCS_TOKEN", "").strip()
        route = getattr(a, "via", "auto")
        if route == "api" and not token:
            raise GdocsError("no_token", "--via api needs GDOCS_TOKEN (an OAuth token with a Drive scope)")
        self.api = Api(token, os.environ.get("GDOCS_API_BASE")) if token and route != "browser" else None
        self._browser = None

    def browser(self):
        if self._browser is None:
            tab = self.a.tab or os.environ.get("GDOCS_TAB") or open_tab(
                f"https://docs.google.com/document/d/{self.did}/edit", self.a.cmux)
            agent = os.environ.get("CMUX_AGENT_NAME") or "gdocs"
            self._browser = Browser(tab, agent, self.a.cmux)
        return self._browser

    def doc_html(self):
        if self.api:
            return self.api.export_html(self.did)
        b = self.browser()
        b.open_doc(self.did, edit=False)
        return b.mobilebasic(self.did)

    def read(self):
        return parse_doc_html(self.doc_html())

    def verify(self, expected_md, mode, deadline_s):
        """Reads the doc until it matches or the deadline passes (Docs saves
        a paste a moment after it lands; there is no save event to wait on
        from outside the page)."""
        expected = md_outline(expected_md)
        end = time.monotonic() + deadline_s
        delay = 0.5
        while True:
            doc = self.read()
            r = compare(expected, doc_outline(doc["blocks"]), mode)
            if r["ok"] or time.monotonic() >= end:
                return r
            time.sleep(delay)  # bounded retry against a remote save, not a local signal
            delay = min(delay * 1.6, 3.0)


def emit(obj, as_json):
    if as_json:
        print(json.dumps(obj, ensure_ascii=False, indent=1))
    elif isinstance(obj, str):
        sys.stdout.write(obj)
    else:
        print(json.dumps(obj, ensure_ascii=False, indent=1))


def cmd_read(a):
    c = Ctx(a)
    doc = c.read()
    if a.format == "json":
        emit(doc, True)
    elif a.format == "html":
        sys.stdout.write(c.doc_html())
    else:
        out = blocks_md(doc["blocks"])
        if doc["comments"] and not a.no_comments:
            out += "\n<!-- comments -->\n" + "".join(f"- [{x['ref']}] {x['text']}\n" for x in doc["comments"])
        sys.stdout.write(out)
    return 0


NO_MATCH = "\u2063cmux-gdocs-none\u2063"


def find(b, text):
    """Docs find (Cmd+F): puts the selection on the first match; answers
    Docs' count ("1 of 3"), or "" for no match."""
    b.call("G.openFind()")
    b.wait_fn("!!(window.__cmuxGdocs&&window.__cmuxGdocs.findBox())", 10000)
    # Docs searches a moment after the query changes, and its count line
    # ("1 of 3") is the only signal; a query that cannot match first resets
    # it, so the old query's count is never read as this one's.
    b.call(f"G.findSet({json.dumps(NO_MATCH)})")
    b.wait_fn("!!(window.__cmuxGdocs&&/^0 of 0$/.test(window.__cmuxGdocs.findCount()))", 5000)
    b.call(f"G.findSet({json.dumps(text)})")
    try:
        b.wait_fn("!!(window.__cmuxGdocs&&/^[1-9]\\d* of \\d+$/.test(window.__cmuxGdocs.findCount()))", 4000)
    except GdocsError:
        b.call("G.findGo()")  # closes the bar
        return ""
    return b.call("G.findGo()")


def browser_write(c, html_body, plain_text, at, suggest):
    b = c.browser()
    b.open_doc(c.did, edit=True)
    b.ensure_lib()
    mode = b.call("G.mode()")
    if mode == "viewing":
        raise GdocsError("read_only", "the doc opens in Viewing mode for this account: no edit access")
    if suggest:
        if b.call("G.setMode('suggesting')") != "suggesting":
            raise GdocsError("mode", "could not switch to Suggesting mode")
        try:
            place_and_paste(b, html_body, plain_text, at)
        finally:
            b.call("G.setMode('editing')")
        return
    if mode == "suggesting":
        if b.call("G.setMode('editing')") != "editing":
            raise GdocsError("mode", "could not switch to Editing mode")
    place_and_paste(b, html_body, plain_text, at)


def place_and_paste(b, html_body, plain_text, at):
    if at == "all":
        b.call("(G.selectAll(),1)")
    elif at == "start":
        b.call("(G.toStart(),1)")
    elif at == "end":
        b.call("(G.toEnd(),1)")
    elif at.startswith("after:"):
        count = find(b, at[6:])
        if not re.match(r"^1 of \d+", count or ""):
            raise GdocsError("not_found", f"find {at[6:]!r}: {count or 'no match'}")
        b.call("(G.right(),1)")
    b.call(f"(G.paste({json.dumps(html_body)},{json.dumps(plain_text)}),1)")


def cmd_replace(a):
    c = Ctx(a)
    md = read_md_arg(a)
    body = md_to_html(md)
    t0 = time.monotonic()
    if c.api:
        c.api.replace_html(c.did, body)
        route = "api"
    else:
        browser_write(c, body, "\n".join(t for _, _, t in md_outline(md)), "all", a.suggest)
        route = "browser"
    r = {"route": route, "write_s": round(time.monotonic() - t0, 2)}
    if not a.no_verify and not a.suggest:
        r["verify"] = c.verify(md, "exact", a.verify_timeout)
    r["total_s"] = round(time.monotonic() - t0, 2)
    emit(r, True)
    return 0 if r.get("verify", {"ok": True})["ok"] else 1


def cmd_insert(a):
    c = Ctx(a)
    md = read_md_arg(a)
    inline = a.inline
    if inline:
        md = md.rstrip("\n")
    body = keep_edge_spaces(inline_html(md)) if inline else md_to_html(md)
    if c.api:
        raise GdocsError("unsupported", "insert runs in the browser route; unset GDOCS_TOKEN or pass --via browser")
    at = f"after:{a.after}" if a.after else a.at
    t0 = time.monotonic()
    browser_write(c, body, plain(md) if inline else plain(md.strip()), at, a.suggest)
    r = {"route": "browser", "at": at, "write_s": round(time.monotonic() - t0, 2)}
    if a.suggest and not a.no_verify:
        r["verify"] = verify_suggestion(c.browser(), plain(md).strip(), a.verify_timeout)
    elif not a.no_verify:
        if inline:
            needle = norm(plain((a.after or "") + md))
            r["verify"] = verify_text(c, needle, a.verify_timeout)
        else:
            r["verify"] = c.verify(md, "contains", a.verify_timeout)
    emit(r, True)
    return 0 if r.get("verify", {"ok": True})["ok"] else 1


def verify_suggestion(b, text, deadline_s):
    """A suggestion shows as a card ("Add: “TEXT”") in the page, not in the
    saved doc's text."""
    want = norm(text)
    end = time.monotonic() + deadline_s
    while True:
        cards = [norm(t) for t in (b.call("G.suggestions()") or [])]
        ok = any(want in t for t in cards)
        if ok or time.monotonic() >= end:
            return {"ok": ok, "mode": "suggestion", "cards": len(cards)}
        time.sleep(1.0)  # bounded retry: the card appears after Docs saves


def verify_text(c, needle, deadline_s):
    end = time.monotonic() + deadline_s
    while True:
        doc = c.read()
        hay = " \n".join(b["text"] for b in doc["blocks"])
        if needle in hay or time.monotonic() >= end:
            return {"ok": needle in hay, "mode": "text", "needle": needle}
        time.sleep(1.0)  # bounded retry against a remote save


def cmd_comment(a):
    c = Ctx(a)
    if c.api:
        cid = json.loads(c.api.comment(c.did, a.text, a.on))
        emit({"route": "api", "comment": cid, "note": "Drive API comments are not anchored to text in the Docs UI"}, True)
        return 0
    b = c.browser()
    b.open_doc(c.did, edit=True)
    count = find(b, a.on)
    if not re.match(r"^1 of \d+", count or ""):
        raise GdocsError("not_found", f"find {a.on!r}: {count or 'no match'}")
    b.call(f"G.comment({json.dumps(a.text)})")
    r = {"route": "browser", "on": a.on, "matches": count}
    if not a.no_verify:
        end = time.monotonic() + a.verify_timeout
        while True:
            texts = [x["text"] for x in c.read()["comments"]]
            ok = norm(a.text) in texts
            if ok or time.monotonic() >= end:
                break
            time.sleep(1.0)  # bounded retry against a remote save
        r["verify"] = {"ok": ok, "comments": len(texts)}
    emit(r, True)
    return 0 if r.get("verify", {"ok": True})["ok"] else 1


def cmd_verify(a):
    md = read_md_arg(a)
    expected = md_outline(md)
    if a.html:
        with open(a.html, encoding="utf-8") as f:
            actual = doc_outline(parse_doc_html(f.read())["blocks"])
        r = compare(expected, actual, a.mode)
    else:
        c = Ctx(a)
        r = c.verify(md, a.mode, a.verify_timeout)
    emit(r, True)
    return 0 if r["ok"] else 1


def cmd_md2html(a):
    sys.stdout.write(md_to_html(read_md_arg(a)) + "\n")
    return 0


def cmd_parse_html(a):
    with open(a.html, encoding="utf-8") as f:
        doc = parse_doc_html(f.read())
    if a.format == "json":
        emit(doc, True)
    else:
        sys.stdout.write(blocks_md(doc["blocks"]))
    return 0


def cmd_open(a):
    did = doc_id(a.doc)
    tab = a.tab or open_tab(f"https://docs.google.com/document/d/{did}/edit", a.cmux)
    Browser(tab, "gdocs", a.cmux).open_doc(did, edit=True)
    emit({"tab": tab, "doc": did}, True)
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="gdocs", description="Read, edit and verify Google Docs (tool pack gdocs).")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(s, doc=True):
        if doc:
            s.add_argument("doc", help="a Docs URL or document id")
        s.add_argument("--tab", help="your own cmux browser tab (tab_…); default $GDOCS_TAB, else a new tab")
        s.add_argument("--via", choices=["auto", "api", "browser"], default="auto",
                       help="auto: the API when GDOCS_TOKEN is set, else the browser")
        s.add_argument("--cmux", default=os.environ.get("GDOCS_CMUX", "cmux"), help=argparse.SUPPRESS)
        s.add_argument("--verify-timeout", type=float, default=20.0, help="seconds to wait for the saved doc to match")

    s = sub.add_parser("read", help="the doc as Markdown (headings, nested lists, tables, bold, links, comments)")
    common(s)
    s.add_argument("--format", choices=["md", "json", "html"], default="md")
    s.add_argument("--no-comments", action="store_true")
    s.set_defaults(fn=cmd_read)

    s = sub.add_parser("replace-outline", help="replace the whole body with Markdown, then verify")
    common(s)
    s.add_argument("--md", help="Markdown file, or - for stdin")
    s.add_argument("--text", help=argparse.SUPPRESS)
    s.add_argument("--suggest", action="store_true", help="as suggestions (no verify)")
    s.add_argument("--no-verify", action="store_true")
    s.set_defaults(fn=cmd_replace)

    s = sub.add_parser("insert", help="insert Markdown at the start, the end, or after a text")
    common(s)
    s.add_argument("--md", help="Markdown file, or - for stdin")
    s.add_argument("--text", help="Markdown text instead of --md")
    s.add_argument("--at", choices=["start", "end"], default="end")
    s.add_argument("--after", help="insert right after the first match of this text")
    s.add_argument("--inline", action="store_true", help="inline text in the paragraph, not new blocks")
    s.add_argument("--suggest", action="store_true", help="as a suggestion")
    s.add_argument("--no-verify", action="store_true")
    s.set_defaults(fn=cmd_insert)

    s = sub.add_parser("comment", help="comment on the first match of a text")
    common(s)
    s.add_argument("--on", required=True, help="the text the comment anchors to")
    s.add_argument("--text", required=True, help="the comment")
    s.add_argument("--no-verify", action="store_true")
    s.set_defaults(fn=cmd_comment)

    s = sub.add_parser("verify", help="compare the doc's outline with Markdown")
    s.add_argument("doc", nargs="?", help="a Docs URL or id (omit with --html)")
    s.add_argument("--tab")
    s.add_argument("--via", choices=["auto", "api", "browser"], default="auto")
    s.add_argument("--cmux", default=os.environ.get("GDOCS_CMUX", "cmux"), help=argparse.SUPPRESS)
    s.add_argument("--verify-timeout", type=float, default=0.0)
    s.add_argument("--md", required=True)
    s.add_argument("--text", help=argparse.SUPPRESS)
    s.add_argument("--html", help="offline: a saved Docs HTML file instead of the live doc")
    s.add_argument("--mode", choices=["exact", "contains"], default="exact")
    s.set_defaults(fn=cmd_verify)

    s = sub.add_parser("open", help="open the doc in edit view in your own tab; prints the tab")
    s.add_argument("doc")
    s.add_argument("--tab")
    s.add_argument("--cmux", default=os.environ.get("GDOCS_CMUX", "cmux"), help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_open)

    s = sub.add_parser("md2html", help="offline: Markdown as the HTML the paste uses")
    s.add_argument("--md", default="-")
    s.add_argument("--text", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_md2html)

    s = sub.add_parser("parse-html", help="offline: a saved Docs HTML file as Markdown or JSON")
    s.add_argument("html")
    s.add_argument("--format", choices=["md", "json"], default="md")
    s.set_defaults(fn=cmd_parse_html)

    a = p.parse_args(argv)
    try:
        return a.fn(a)
    except GdocsError as e:
        print(json.dumps({"ok": False, "error": e.code, "message": str(e)}), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
