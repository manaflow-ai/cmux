DOC_ID_RE = re.compile(r"/document/(?:u/\d+/)?d/([A-Za-z0-9_-]{20,})")


class GdocsError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def doc_id(text):
    m = DOC_ID_RE.search(text or "")
    if m:
        return m.group(1)
    if re.fullmatch(r"[A-Za-z0-9_-]{20,}", text or ""):
        return text
    raise GdocsError("bad_doc", f"not a Google Docs URL or id: {text!r}")


# ---------------------------------------------------------------- Markdown in

LIST_RE = re.compile(r"^(\s*)([-*+]|\d+[.)])\s+(.*)$")
HEAD_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
TABLE_SEP_RE = re.compile(r"^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$")


def md_blocks(text):
    """Markdown as blocks: (kind, level, ordered, inline-markdown text).

    kind: h1..h6, p, li, row (a table row; text is cells joined by " | "),
    hr, code. A list item's level counts its indent steps (a tab, or the
    smallest indent seen, usually 2 or 4 spaces)."""
    lines = text.replace("\r\n", "\n").expandtabs(4).split("\n")
    blocks = []
    para = []
    indents = []  # open list indents, outermost first
    in_code = False

    def flush():
        if para:
            blocks.append(("p", 0, False, " ".join(s.strip() for s in para)))
            para.clear()

    i = 0
    while i < len(lines):
        line = lines[i]
        if line.strip().startswith("```"):
            flush()
            indents.clear()
            in_code = not in_code
            i += 1
            continue
        if in_code:
            blocks.append(("code", 0, False, line))
            i += 1
            continue
        if not line.strip():
            flush()
            i += 1
            continue
        h = HEAD_RE.match(line)
        if h:
            flush()
            indents.clear()
            blocks.append((f"h{len(h.group(1))}", 0, False, h.group(2)))
            i += 1
            continue
        if re.fullmatch(r"\s*(-{3,}|\*{3,}|_{3,})\s*", line):
            flush()
            indents.clear()
            blocks.append(("hr", 0, False, ""))
            i += 1
            continue
        li = LIST_RE.match(line)
        if li:
            flush()
            ind = len(li.group(1))
            while indents and indents[-1] > ind:
                indents.pop()
            if not indents or indents[-1] < ind:
                indents.append(ind)
            ordered = li.group(2)[0].isdigit()
            blocks.append(("li", len(indents) - 1, ordered, li.group(3).strip()))
            i += 1
            continue
        if line.lstrip().startswith("|") and i + 1 < len(lines) and TABLE_SEP_RE.match(lines[i + 1]):
            flush()
            indents.clear()
            rows = [line]
            i += 2
            while i < len(lines) and lines[i].lstrip().startswith("|"):
                rows.append(lines[i])
                i += 1
            for n, r in enumerate(rows):
                cells = [c.strip() for c in r.strip().strip("|").split("|")]
                blocks.append(("row", 0 if n else 1, False, " | ".join(cells)))
            blocks.append(("endtable", 0, False, ""))
            continue
        if indents and line.startswith(" ") and blocks and blocks[-1][0] == "li":
            k, lv, o, t = blocks[-1]
            blocks[-1] = (k, lv, o, t + " " + line.strip())
            i += 1
            continue
        indents.clear()
        para.append(line)
        i += 1
    flush()
    return blocks


INLINE_RE = re.compile(
    r"(\*\*(?P<b>.+?)\*\*)|(__(?P<b2>.+?)__)|(\*(?P<i>[^*\s][^*]*?)\*)|"
    r"(?<![A-Za-z0-9])_(?P<i2>[^_\s][^_]*?)_(?![A-Za-z0-9])|(`(?P<c>[^`]+)`)|"
    r"(\[(?P<lt>[^\]]+)\]\((?P<lu>[^)\s]+)\))"
)


def inline_html(text):
    out = []
    pos = 0
    for m in INLINE_RE.finditer(text):
        out.append(html.escape(text[pos:m.start()], quote=False))
        g = m.groupdict()
        if g["b"] or g["b2"]:
            out.append(f"<b>{inline_html(g['b'] or g['b2'])}</b>")
        elif g["i"] or g["i2"]:
            out.append(f"<i>{inline_html(g['i'] or g['i2'])}</i>")
        elif g["c"]:
            out.append(f'<span style="font-family:\'Courier New\'">{html.escape(g["c"], quote=False)}</span>')
        else:
            url = g["lu"]
            if not re.match(r"^(https?:|mailto:)", url):
                url = "#"
            out.append(f'<a href="{html.escape(url)}">{inline_html(g["lt"])}</a>')
        pos = m.end()
    out.append(html.escape(text[pos:], quote=False))
    return "".join(out)


def plain(text):
    """Inline Markdown without its marks (what the doc shows)."""
    text = re.sub(r"\[([^\]]+)\]\([^)\s]+\)", r"\1", text)
    text = re.sub(r"\*\*(.+?)\*\*|__(.+?)__", lambda m: m.group(1) or m.group(2), text)
    text = re.sub(r"\*([^*\s][^*]*?)\*", r"\1", text)
    text = re.sub(r"(?<![A-Za-z0-9])_([^_\s][^_]*?)_(?![A-Za-z0-9])", r"\1", text)
    text = re.sub(r"`([^`]+)`", r"\1", text)
    return text


def md_to_html(text):
    """Markdown as the HTML a Docs paste (or a Drive HTML upload) turns into
    headings, nested bullet and number lists, tables and inline styles."""
    out = []
    stack = []  # open list tags, one per level

    def close_lists(to):
        while len(stack) > to:
            out.append(f"</li></{stack.pop()}>")

    table = []
    for kind, level, ordered, t in md_blocks(text):
        if kind != "li":
            close_lists(0)
        if kind not in ("row", "endtable") and table:
            table = []
        if kind.startswith("h"):
            if kind == "hr":
                out.append("<hr>")
            else:
                out.append(f"<{kind}>{inline_html(t)}</{kind}>")
        elif kind == "p":
            out.append(f"<p>{inline_html(t)}</p>")
        elif kind == "code":
            out.append(f'<p><span style="font-family:\'Courier New\'">{html.escape(t, quote=False) or "&nbsp;"}</span></p>')
        elif kind == "li":
            tag = "ol" if ordered else "ul"
            if len(stack) > level + 1:
                close_lists(level + 1)
            if len(stack) == level + 1:
                if stack[-1] != tag:
                    close_lists(level)
                else:
                    out.append("</li>")
            while len(stack) < level + 1:
                out.append(f"<{tag}>")
                stack.append(tag)
            out.append(f"<li>{inline_html(t)}")
        elif kind == "row":
            if not table:
                out.append("<table><tbody>")
                table = [1]
            cell = "th" if level else "td"
            cells = "".join(f"<{cell}>{inline_html(c)}</{cell}>" for c in t.split(" | "))
            out.append(f"<tr>{cells}</tr>")
        elif kind == "endtable":
            out.append("</tbody></table>")
            table = []
    close_lists(0)
    return "".join(out)


def keep_edge_spaces(h):
    """An HTML paste drops leading and trailing spaces (white-space:pre runs
    too); no-break spaces stay. verify reads them as spaces."""
    lead = len(h) - len(h.lstrip(" "))
    trail = len(h) - len(h.rstrip(" "))
    core = h.strip(" ")
    return "\u00a0" * lead + core + "\u00a0" * trail


def md_outline(text):
    """The outline verify compares: (kind, level, plain text) per block."""
    out = []
    for kind, level, _ordered, t in md_blocks(text):
        if kind in ("endtable", "hr"):
            continue
        if kind == "row":
            out.append(("row", 0, plain(t)))
        elif kind == "code":
            if t.strip():
                out.append(("p", 0, t))
        else:
            out.append((kind, level if kind == "li" else 0, plain(t)))
    return [(k, lv, norm(t)) for k, lv, t in out if norm(t) or k == "row"]


# ------------------------------------------------------------ Docs HTML out

LIST_LEVEL_RE = re.compile(r"lst-kix_[A-Za-z0-9_]+-(\d+)")
CSS_RULE_RE = re.compile(r"\.(c\d+)\{([^}]*)\}")


class DocParser(HTMLParser):
    """Docs HTML (mobilebasic, or Drive's HTML export) as blocks.

    Blocks: {"kind": "title"|"subtitle"|"h1".."h6"|"p"|"li"|"row",
    "level": n, "ordered": bool, "md": inline Markdown, "text": plain}, and
    comments [{"ref": "a", "text": ...}] from the trailing comment notes."""

    def __init__(self, classes):
        super().__init__(convert_charrefs=True)
        self.classes = classes
        self.blocks = []
        self.comments = []
        self.depth_content = None  # tag depth of .doc-content (mobilebasic)
        self.depth = 0
        self.list_level = 0
        self.list_ordered = False
        self.lists = []  # open (tag, level): nested lists without Docs' level classes
        self.cur = None  # current block being filled
        self.spans = []  # (bold, italic) stack per span
        self.link = None
        self.in_ref = False
        self.in_comment = False
        self.comment_ref = None
        self.skip = 0  # inside <style>/<script>/<head>
        self.row = None
        self.cell = None

    def _style(self, attrs):
        a = dict(attrs)
        style = a.get("style") or ""
        for c in (a.get("class") or "").split():
            style += ";" + self.classes.get(c, "")
        return a, style

    def handle_starttag(self, tag, attrs):
        self.depth += 1
        a, style = self._style(attrs)
        if tag in ("style", "script", "head", "title"):
            self.skip += 1
            return
        if self.skip:
            return
        cls = a.get("class") or ""
        if tag == "div" and "doc-content" in cls.split():
            self.depth_content = self.depth
        if tag in ("ul", "ol"):
            self._finish()
            m = LIST_LEVEL_RE.search(cls)
            level = int(m.group(1)) if m else len(self.lists)
            self.lists.append((tag, level))
            self.list_level = level
            self.list_ordered = tag == "ol"
        elif tag == "sup":
            pass
        elif tag == "a":
            href = a.get("href") or ""
            if re.match(r"#cmnt\d+$", href) and a.get("id", "").startswith("cmnt_ref"):
                self.in_ref = True
            elif re.match(r"#cmnt_ref\d+$", href):
                self.in_comment = True
                self.in_ref = True
                self.cur = None
                self.comments.append({"ref": "", "text": ""})
            else:
                self.link = self._link_target(href)
                if self.cur is not None:
                    self.cur["md"] += "["
        elif tag in ("h1", "h2", "h3", "h4", "h5", "h6", "p", "li"):
            if self.in_comment:
                return
            kind = tag
            if tag == "p" and "title" in cls.split():
                kind = "title"
            elif tag == "p" and "subtitle" in cls.split():
                kind = "subtitle"
            if self.cell is not None:
                if self.cell["text"]:
                    self.cell["text"] += " "
                return
            self._finish()
            self.cur = {"kind": kind, "level": self.list_level if tag == "li" else 0,
                        "ordered": self.list_ordered if tag == "li" else False, "md": "", "text": ""}
        elif tag in ("span", "b", "strong", "i", "em"):
            bold = tag in ("b", "strong") or bool(re.search(r"font-weight:\s*(700|bold)", style))
            italic = tag in ("i", "em") or "font-style:italic" in style.replace(" ", "")
            self.spans.append((bold, italic))
            if self.cur is not None and not self.in_ref:
                self.cur["md"] += ("**" if bold else "") + ("*" if italic else "")
        elif tag == "tr":
            self.row = []
        elif tag in ("td", "th"):
            self.cell = {"text": ""}

    @staticmethod
    def _link_target(href):
        if href.startswith("https://www.google.com/url?"):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(href).query).get("q")
            if q:
                return q[0]
        return href

    def _finish(self):
        b = self.cur
        if b is None:
            return
        b["md"] = merge_links(b["md"].replace("****", "").replace("\u00a0", " ")).strip()
        if b["kind"] not in ("p", "li"):
            b["md"] = norm(b["text"])
        b["text"] = norm(b["text"])
        self.blocks.append(b)
        self.cur = None

    def handle_endtag(self, tag):
        self.depth -= 1
        if tag in ("style", "script", "head", "title"):
            self.skip = max(0, self.skip - 1)
            return
        if self.skip:
            return
        if tag == "a":
            if self.in_ref:
                self.in_ref = False
            elif self.link is not None:
                if self.cur is not None:
                    self.cur["md"] += f"]({self.link})"
                self.link = None
        elif tag in ("span", "b", "strong", "i", "em"):
            bold, italic = self.spans.pop() if self.spans else (False, False)
            if self.cur is not None and not self.in_ref:
                self.cur["md"] += ("*" if italic else "") + ("**" if bold else "")
        elif tag in ("h1", "h2", "h3", "h4", "h5", "h6", "p", "li"):
            if self.in_comment and tag == "p":
                self.in_comment = False
                return
            if self.cell is None:
                self._finish()
        elif tag in ("ul", "ol"):
            self._finish()
            if self.lists:
                self.lists.pop()
            if self.lists:
                self.list_ordered = self.lists[-1][0] == "ol"
                self.list_level = self.lists[-1][1]
        elif tag in ("td", "th"):
            if self.row is not None and self.cell is not None:
                self.row.append(norm(self.cell["text"]))
            self.cell = None
        elif tag == "tr":
            if self.row is not None:
                t = " | ".join(self.row)
                self.blocks.append({"kind": "row", "level": 0, "ordered": False, "md": t, "text": norm(t)})
            self.row = None

    def handle_data(self, data):
        if self.skip:
            return
        if self.in_comment:
            if self.in_ref:
                self.comments[-1]["ref"] += data.strip("[]")
            else:
                self.comments[-1]["text"] += data
            return
        if self.in_ref:
            return
        if self.cell is not None:
            self.cell["text"] += data
            return
        if self.cur is not None:
            self.cur["md"] += data
            self.cur["text"] += data


def merge_links(md):
    """Docs splits one link into runs (`[ ](u)[the tracker](u)`): one link,
    with edge spaces moved outside."""
    prev = None
    while prev != md:
        prev = md
        md = re.sub(r"\[([^\]]*)\]\(([^)\s]+)\)\[([^\]]*)\]\(\2\)", r"[\1\3](\2)", md)
    return re.sub(r"\[(\s*)([^\]]*?)(\s*)\]\(([^)\s]+)\)",
                  lambda m: f"{m.group(1)}[{m.group(2)}]({m.group(4)}){m.group(3)}" if m.group(2) else m.group(1) + m.group(3), md)


def parse_doc_html(text):
    classes = {m.group(1): m.group(2) for m in CSS_RULE_RE.finditer(text)}
    # mobilebasic: the doc is the .doc-content div; Drive export: the body.
    start = text.find('class="doc-content"')
    if start >= 0:
        text = text[text.rfind("<", 0, start):]
    p = DocParser(classes)
    p.feed(text)
    p.close()
    blocks = [b for b in p.blocks if b["text"] or b["kind"] == "row"]
    for c in p.comments:
        c["text"] = norm(c["text"])
    return {"blocks": blocks, "comments": p.comments}


def blocks_md(blocks):
    out = []
    prev = None
    for b in blocks:
        k = b["kind"]
        if k == "li":
            if prev not in (None, "li"):
                out.append("")
            out.append("  " * b["level"] + ("1. " if b["ordered"] else "- ") + b["md"])
        elif k == "row":
            if prev != "row":
                out.append("")
                cells = b["md"].split(" | ")
                out.append("| " + b["md"] + " |")
                out.append("|" + "---|" * len(cells))
            else:
                out.append("| " + b["md"] + " |")
        else:
            if prev is not None:
                out.append("")
            prefix = {"title": "# ", "subtitle": "", "p": ""}.get(k)
            if prefix is None:
                prefix = "#" * int(k[1]) + " "
            out.append(prefix + b["md"])
        prev = k
    return "\n".join(out).strip() + "\n"


def doc_outline(blocks):
    out = []
    for b in blocks:
        k = b["kind"]
        if k == "title":
            k = "h1"
        elif k == "subtitle":
            k = "p"
        out.append((k, b["level"] if k == "li" else 0, norm(b["text"])))
    return out


# --------------------------------------------------------------- compare

QUOTES = str.maketrans({"‘": "'", "’": "'", "“": '"', "”": '"', " ": " ",
                        "–": "-", "—": "-", "​": ""})


def norm(text):
    text = unicodedata.normalize("NFKC", text or "").translate(QUOTES)
    return re.sub(r"\s+", " ", text).strip()


def line(o):
    k, lv, t = o
    return f"{k}{'.' + str(lv) if k == 'li' else ''}: {t}"


def compare(expected, actual, mode="exact"):
    """mode exact: the doc is the expected outline. mode contains: the
    expected outline is a contiguous run in the doc."""
    if mode == "exact":
        ok = expected == actual
        at = 0 if ok else None
    else:
        at = next((i for i in range(len(actual) - len(expected) + 1)
                   if actual[i:i + len(expected)] == expected), None)
        ok = at is not None
    first = None
    if not ok and mode == "exact":
        for i in range(max(len(expected), len(actual))):
            e = expected[i] if i < len(expected) else None
            a = actual[i] if i < len(actual) else None
            if e != a:
                first = {"index": i, "expected": e and line(e), "actual": a and line(a)}
                break
    return {"ok": ok, "mode": mode, "expected_blocks": len(expected), "actual_blocks": len(actual),
            "at": at, "first_difference": first}


