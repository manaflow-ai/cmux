// cmux-mobile-api: signaling, presence, WireGuard relay and device registry for the cmux-next-ios app
// (cmux-next-ios/PROTOCOL.md). Top level is local/test only (no database: tests use the memory store).
// Secrets per env (wrangler secret put --env <env>): TURN_KEY_ID, TURN_KEY_API_TOKEN, and optionally
// STACK_SECRET_SERVER_KEY. The database URL lives only in the Hyperdrive config.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cmux-mobile-api-local",
  // Local only: a deploy of this top-level config never gets a public URL (its store is memory).
  "workers_dev": false,
  "main": "src/index.ts",
  "account_id": "0c1675e0def6de1ab3a50a4e17dc5656",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "local",
    "API_VERSION": "0.14.0",
    "APNS_TOPICS": "dev.cmux.mobile,dev.cmux.mobile.prod",
    // Stack projects whose users are accepted, primary first (src/auth.ts StackProject).
    "STACK_PROJECTS": "[{\"id\":\"454ecd03-1db2-4050-845e-4ce5b0cd9895\",\"label\":\"dev\",\"publishableClientKey\":\"pck_xb63160bwe9699vtxfzfj6emmxpafg5mkjrtp6ehzxv5g\",\"inviteCallbackUrl\":\"http://localhost:8102/handler/team-invitation\"},{\"id\":\"9790718f-14cd-4f7e-824d-eaf527a82b82\",\"label\":\"prod\",\"publishableClientKey\":\"\",\"inviteCallbackUrl\":\"https://cmux.com/handler/team-invitation\"}]"
  },
  "durable_objects": { "bindings": [{ "name": "TEAM_HUB", "class_name": "TeamHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamHub"] }],
  "env": {
    "dev": {
      "name": "cmux-mobile-api-dev",
      "workers_dev": true,
      // Query strings can carry nothing secret here, but redact anyway; invocation logs would record the
      // Sec-WebSocket-Protocol bearer, so they stay off.
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "vars": {
        "ENVIRONMENT": "dev",
        "API_VERSION": "0.14.0",
        // Bundle ids phones may register push tokens for: Debug/Demo, Production and the TestFlight app.
        "APNS_TOPICS": "dev.cmux.mobile,dev.cmux.mobile.demo,dev.cmux.mobile.prod,dev.cmux.app.internal",
        // Dev (primary) and production Stack users: production mobile builds use this dev Worker too.
        "STACK_PROJECTS": "[{\"id\":\"454ecd03-1db2-4050-845e-4ce5b0cd9895\",\"label\":\"dev\",\"publishableClientKey\":\"pck_xb63160bwe9699vtxfzfj6emmxpafg5mkjrtp6ehzxv5g\",\"inviteCallbackUrl\":\"http://localhost:8102/handler/team-invitation\"},{\"id\":\"9790718f-14cd-4f7e-824d-eaf527a82b82\",\"label\":\"prod\",\"publishableClientKey\":\"\",\"inviteCallbackUrl\":\"https://cmux.com/handler/team-invitation\"}]"
      },
      "durable_objects": { "bindings": [{ "name": "TEAM_HUB", "class_name": "TeamHub" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamHub"] }],
      // Retires the old per-team hubs every minute (src/index.ts retireAllTeamHubs, the 0.10.0 migration).
      "triggers": { "crons": ["* * * * *"] },
      // Hyperdrive configs here have
      // query caching disabled (`wrangler hyperdrive update <id> --caching-disabled true`): with the default
      // 60 s cache a newly registered Mac stayed missing from /macs and /me/macs. Do the same for prod.
      // Per-user limits (PROTOCOL.md): keyed by the caller's owner key, the Mac for notify.
      "ratelimits": [
        { "name": "USER_LIMIT", "namespace_id": "4101", "simple": { "limit": 300, "period": 60 } },
        { "name": "ICE_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
        { "name": "INVITE_LIMIT", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } },
        { "name": "NOTIFY_LIMIT", "namespace_id": "4104", "simple": { "limit": 60, "period": 60 } },
        { "name": "TEAM_LIMIT", "namespace_id": "4105", "simple": { "limit": 3, "period": 60 } },
        { "name": "MAILBOX_LIMIT", "namespace_id": "4106", "simple": { "limit": 60, "period": 60 } }
      ],
      // PS_MYSQL: cmux-next-vitess development (readwriter) through Hyperdrive cmux-next-vitess-development, tables
      // mobile_* (backend/db/drizzle-mysql/0002_mobile). The old Postgres cmux-mobile-dev is no longer bound
      // (kept read-only until its deletion is approved; vitess-migration-DESIGN.md 2.3).
      "hyperdrive": [{ "binding": "PS_MYSQL", "id": "60893ba4eaef437a91a77da71730ea9b" }]
    },
    "prod": {
      // Production: production Stack project only, its own PlanetScale database cmux/cmux-mobile-prod (branch main,
      // role cmux-mobile-api) behind Hyperdrive cmux-mobile-prod (query caching disabled), custom domain on cmux.dev.
      "name": "cmux-mobile-api-prod",
      "workers_dev": true,
      "routes": [{ "pattern": "mobile-api.cmux.dev", "custom_domain": true }],
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "vars": {
        "ENVIRONMENT": "prod",
        "API_VERSION": "0.14.0",
        "APNS_TOPICS": "dev.cmux.mobile.prod,dev.cmux.app.internal",
        "STACK_PROJECTS": "[{\"id\":\"9790718f-14cd-4f7e-824d-eaf527a82b82\",\"label\":\"prod\",\"publishableClientKey\":\"\",\"inviteCallbackUrl\":\"https://cmux.com/handler/team-invitation\"}]"
      },
      "durable_objects": { "bindings": [{ "name": "TEAM_HUB", "class_name": "TeamHub" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamHub"] }],
      // Retires the old per-team hubs every minute (src/index.ts retireAllTeamHubs, the 0.10.0 migration).
      "triggers": { "crons": ["* * * * *"] },
      "ratelimits": [
        { "name": "USER_LIMIT", "namespace_id": "4201", "simple": { "limit": 300, "period": 60 } },
        { "name": "ICE_LIMIT", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } },
        { "name": "INVITE_LIMIT", "namespace_id": "4203", "simple": { "limit": 10, "period": 60 } },
        { "name": "NOTIFY_LIMIT", "namespace_id": "4204", "simple": { "limit": 60, "period": 60 } },
        { "name": "TEAM_LIMIT", "namespace_id": "4205", "simple": { "limit": 3, "period": 60 } },
        { "name": "MAILBOX_LIMIT", "namespace_id": "4206", "simple": { "limit": 60, "period": 60 } }
      ],
      // PS_MYSQL: cmux-next-vitess main (readwriter) through Hyperdrive cmux-next-vitess-production, tables mobile_*.
      // The old Postgres cmux-mobile-prod is no longer bound (kept read-only until its deletion is approved).
      "hyperdrive": [{ "binding": "PS_MYSQL", "id": "0533eedddc1e4195adf0d42a4c325fce" }]
    }
  }
}
