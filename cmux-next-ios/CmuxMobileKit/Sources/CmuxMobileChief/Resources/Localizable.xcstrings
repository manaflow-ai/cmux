    "mobile.auto.noRecent": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A new chat starts in a repository of one of your Auto chats. Turn on Auto for a chat on your Mac first."}},
        "de": {"stringUnit": {"state": "translated", "value": "Ein neuer Chat startet in einem Repository deiner automatischen Chats. Schalte zuerst auf deinem Mac Automatisch für einen Chat ein."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une nouvelle discussion démarre dans un dépôt de l’une de vos discussions automatiques. Activez d’abord Automatique pour une discussion sur votre Mac."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تبدأ المحادثة الجديدة في مستودع إحدى محادثاتك التلقائية. شغّل الوضع التلقائي لمحادثة على الـ Mac أولاً."}},
        "es": {"stringUnit": {"state": "translated", "value": "Un chat nuevo empieza en un repositorio de uno de tus chats automáticos. Activa primero Automático para un chat en tu Mac."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "新聊天會在你某個自動聊天的儲存庫中開始。請先在 Mac 上為聊天開啟自動。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "新聊天会在你某个自动聊天的仓库中开始。请先在 Mac 上为聊天开启自动。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "새 채팅은 자동 채팅 중 하나의 저장소에서 시작됩니다. 먼저 Mac에서 채팅의 자동을 켜세요."}},
        "ja": {"stringUnit": {"state": "translated", "value": "新規チャットは、自動チャットのいずれかのリポジトリで開始されます。まず Mac でチャットの自動をオンにしてください。"}}
      }
    },
    "mobile.auto.startFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't start the chat. Try again."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der Chat konnte nicht gestartet werden. Versuche es erneut."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de démarrer la discussion. Réessayez."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر بدء المحادثة. حاول مرة أخرى."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo iniciar el chat. Inténtalo de nuevo."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法開始聊天。請再試一次。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法开始聊天。请重试。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "채팅을 시작할 수 없습니다. 다시 시도하세요."}},
        "ja": {"stringUnit": {"state": "translated", "value": "チャットを開始できませんでした。もう一度お試しください。"}}
      }
    },
    "mobile.auto.notSent": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't send. Try again."}},
        "de": {"stringUnit": {"state": "translated", "value": "Senden fehlgeschlagen. Versuche es erneut."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Échec de l’envoi. Réessayez."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر الإرسال. حاول مرة أخرى."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo enviar. Inténtalo de nuevo."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法傳送。請再試一次。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法发送。请重试。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보낼 수 없습니다. 다시 시도하세요."}},
        "ja": {"stringUnit": {"state": "translated", "value": "送信できませんでした。もう一度お試しください。"}}
      }
    },
    "mobile.auto.textOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "From iPhone, an Auto chat takes text messages only."}},
        "de": {"stringUnit": {"state": "translated", "value": "Vom iPhone nimmt ein automatischer Chat nur Textnachrichten an."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Depuis l’iPhone, une discussion automatique n’accepte que des messages texte."}},
        "ar": {"stringUnit": {"state": "translated", "value": "من iPhone، تقبل المحادثة التلقائية الرسائل النصية فقط."}},
        "es": {"stringUnit": {"state": "translated", "value": "Desde el iPhone, un chat automático solo acepta mensajes de texto."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動聊天只接受來自 iPhone 的文字訊息。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动聊天只接受来自 iPhone 的文字消息。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "iPhone에서는 자동 채팅에 텍스트 메시지만 보낼 수 있습니다."}},
        "ja": {"stringUnit": {"state": "translated", "value": "iPhone からは、自動チャットにテキストメッセージのみ送信できます。"}}
      }
    },
    "mobile.auto.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This chat can't be opened."}},
        "de": {"stringUnit": {"state": "translated", "value": "Dieser Chat kann nicht geöffnet werden."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’ouvrir cette discussion."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر فتح هذه المحادثة."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se puede abrir este chat."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法開啟此聊天。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法打开此聊天。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 채팅을 열 수 없습니다."}},
