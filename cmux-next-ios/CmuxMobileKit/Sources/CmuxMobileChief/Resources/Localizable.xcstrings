    },
    "mobile.chief.notificationsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "These settings apply to this iPhone."}},
        "de": {"stringUnit": {"state": "translated", "value": "Diese Einstellungen gelten für dieses iPhone."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ces réglages s’appliquent à cet iPhone."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تنطبق هذه الإعدادات على هذا الـ iPhone."}},
        "es": {"stringUnit": {"state": "translated", "value": "Estos ajustes se aplican a este iPhone."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這些設定適用於此 iPhone。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这些设置适用于此 iPhone。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 설정은 이 iPhone에 적용됩니다."}},
        "ja": {"stringUnit": {"state": "translated", "value": "これらの設定はこの iPhone に適用されます。"}}
      }
    },
    "mobile.chief.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Chief is busy. Try again."}},
        "de": {"stringUnit": {"state": "translated", "value": "Chief ist ausgelastet. Versuche es erneut."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chief est occupé. Réessayez."}},
        "ar": {"stringUnit": {"state": "translated", "value": "Chief مشغول. حاول مجددًا."}},
        "es": {"stringUnit": {"state": "translated", "value": "Chief está ocupado. Inténtalo de nuevo."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "Chief 忙碌中。請再試一次。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Chief 正忙。请重试。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "Chief가 사용 중입니다. 다시 시도하세요."}},
        "ja": {"stringUnit": {"state": "translated", "value": "Chief はビジー状態です。もう一度お試しください。"}}
      }
    },
    "mobile.chief.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't save the change. Try again."}},
        "de": {"stringUnit": {"state": "translated", "value": "Änderung konnte nicht gespeichert werden. Versuche es erneut."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’enregistrer la modification. Réessayez."}},
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر حفظ التغيير. حاول مجددًا."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo guardar el cambio. Inténtalo de nuevo."}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法儲存變更。請再試一次。"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存更改。请重试。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "변경 사항을 저장하지 못했습니다. 다시 시도하세요."}},
        "ja": {"stringUnit": {"state": "translated", "value": "変更を保存できませんでした。もう一度お試しください。"}}
      }
    },
    "mobile.chief.stopFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Couldn't stop Chief. Try again."}},
        "de": {"stringUnit": {"state": "translated", "value": "Chief konnte nicht gestoppt werden. Versuche es erneut."}},
