// The uniffi C module for the Linux build of CmuxMobileLinkFFI (RFD 0051 route 2). On Apple
// platforms the same module comes from Frameworks/CmuxMobileLinkFFI.xcframework.
// rust/scripts/build-linux-ffi.sh generates the header beside this file and passes the directory
// holding libcmux_mobile_link_ffi.a with -Xlinker -L. Package.swift uses this directory only when
// CMUX_SWIFTPM_TARGET_LINUX=1 and CMUX_MOBILE_LINK_FFI_LINUX=1 are both set.
module CmuxMobileLinkFFIFFI {
    header "CmuxMobileLinkFFIFFI.h"
    link "cmux_mobile_link_ffi"
    link "m"
    link "dl"
    link "pthread"
    export *
}
