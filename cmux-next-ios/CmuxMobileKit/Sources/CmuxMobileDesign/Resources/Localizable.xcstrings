    "pairRequest.asks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” wants to connect to %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ möchte sich mit %2$@ verbinden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » veut se connecter à %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد ”%1$@“ الاتصال بـ %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” quiere conectarse a %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」想要連線到 %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”想要连接到 %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”이(가) %2$@에 연결하려고 합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”が%2$@に接続しようとしています"
          }
        }
      }
    },
