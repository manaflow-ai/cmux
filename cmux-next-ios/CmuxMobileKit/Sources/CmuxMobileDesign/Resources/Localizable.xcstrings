    "pairRequest.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac didn’t take the answer. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac hat die Antwort nicht angenommen. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac n’a pas pris en compte la réponse. Réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل جهاز Mac الإجابة. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac no aceptó la respuesta. Inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 未接受此回覆。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 未接受此回复。请重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 응답을 받지 않았습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac が応答を受け付けませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "pairRequest.fingerprint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check it shows the same code:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie, ob dort derselbe Code steht:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez qu’il affiche le même code :"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أنه يعرض الرمز نفسه:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que muestra el mismo código:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認它顯示相同的代碼："
          }
        },
        "zh-Hans": {
          "stringUnit": {
