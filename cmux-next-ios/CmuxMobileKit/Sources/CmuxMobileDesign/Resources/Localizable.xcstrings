        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入这台 Mac 的主页。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 홈을 불러올 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのホームを読み込めませんでした。"
          }
        }
      }
    },
