    "recovery.home": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load this Mac's Home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Startseite dieses Macs konnte nicht geladen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger l’accueil de ce Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الصفحة الرئيسية لهذا الـ Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el inicio de este Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入這部 Mac 的首頁。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入这台 Mac 的主页。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 홈을 불러올 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのホームを読み込めませんでした。"
          }
        }
      }
    },
