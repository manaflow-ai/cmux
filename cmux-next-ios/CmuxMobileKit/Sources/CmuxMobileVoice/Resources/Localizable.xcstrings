    "chiefLive.fail.droppedDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فُقد الاتصال بـ OpenAI. حاول مجددًا عندما يكون اتصالك أفضل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veza s OpenAI-jem je izgubljena. Pokušajte ponovo kada imate bolju vezu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelsen til OpenAI blev tabt. Prøv igen, når du har en bedre forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Verbindung zu OpenAI wurde unterbrochen. Versuche es erneut, wenn du eine bessere Verbindung hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to OpenAI was lost. Try again when you have a better connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se perdió la conexión con OpenAI. Inténtalo de nuevo cuando tengas mejor conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connexion à OpenAI a été perdue. Réessayez quand vous aurez une meilleure connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La connessione a OpenAI è stata persa. Riprova quando avrai una connessione migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OpenAI との接続が失われました。接続状態の良い場所でもう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការតភ្ជាប់ទៅ OpenAI បានបាត់។ សូមព្យាយាមម្តងទៀតពេលអ្នកមានការតភ្ជាប់ល្អជាងនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OpenAI와의 연결이 끊어졌습니다. 연결 상태가 좋을 때 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Forbindelsen til OpenAI ble brutt. Prøv igjen når du har bedre forbindelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utracono połączenie z OpenAI. Spróbuj ponownie, gdy będziesz mieć lepsze połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A conexão com a OpenAI foi perdida. Tente novamente quando tiver uma conexão melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соединение с OpenAI потеряно. Повторите попытку при более стабильном соединении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อกับ OpenAI ขาดหาย ลองอีกครั้งเมื่อมีการเชื่อมต่อที่ดีกว่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OpenAI bağlantısı kesildi. Daha iyi bir bağlantınız olduğunda tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "З’єднання з OpenAI втрачено. Спробуйте ще раз, коли з’єднання буде кращим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối với OpenAI đã bị mất. Hãy thử lại khi có kết nối tốt hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "与 OpenAI 的连接已断开。请在网络更好时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "與 OpenAI 的連線已中斷。請在連線較佳時重試。"
          }
        }
      }
    },
    "chiefLive.fail.keyDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
