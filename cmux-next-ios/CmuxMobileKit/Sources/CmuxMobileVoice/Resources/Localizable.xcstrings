          }
        }
      }
    },
    "chiefCall.status.recording": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جارٍ التسجيل. سيتلقى Chief هذا عند إنهاء المكالمة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snimanje. Vaš Chief ovo dobija kada prekinete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optager. Din Chief får det, når du lægger på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aufnahme läuft. Dein Chief erhält sie, wenn du auflegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording. Your Chief gets this when you hang up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grabando. Tu Chief lo recibe cuando cuelgues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrement. Votre Chief le reçoit quand vous raccrochez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registrazione in corso. Il tuo Chief la riceve quando riattacchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中。通話を終えると Chief に届きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "កំពុងថត។ Chief របស់អ្នកនឹងទទួលបាននៅពេលអ្នកបញ្ចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "녹음 중. 통화를 끝내면 Chief에게 전달됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tar opp. Chief får dette når du legger på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nagrywanie. Chief otrzyma to po rozłączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gravando. Seu Chief recebe quando você desligar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Идёт запись. Chief получит её, когда вы завершите звонок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังบันทึก Chief จะได้รับเมื่อคุณวางสาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaydediliyor. Kapattığınızda Chief’iniz alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запис. Chief отримає його, коли ви завершите дзвінок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang ghi âm. Chief sẽ nhận khi bạn kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在录音。挂断后 Chief 会收到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在錄音。掛斷後 Chief 會收到。"
          }
        }
      }
    },
    "chiefCall.status.savedForLater": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم الحفظ. سيُرسل عندما يكون Chief متاحًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spremljeno. Poslat će se kada Chief bude dostupan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gemt. Den sendes, når din Chief kan nås."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesichert. Wird gesendet, sobald dein Chief erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. It sends when your Chief is reachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guardado. Se enviará cuando tu Chief esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistré. L’envoi se fera quand votre Chief sera joignable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvato. Verrà inviato quando il tuo Chief sarà raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。Chief に接続できたら送信します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "បានរក្សាទុក។ វានឹងផ្ញើនៅពេល Chief អាចទាក់ទងបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장했습니다. Chief에 연결되면 보냅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lagret. Den sendes når Chief kan nås."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisano. Zostanie wysłane, gdy Chief będzie dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvo. Será enviado quando seu Chief estiver acessível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сохранено. Отправится, когда Chief будет доступен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บันทึกแล้ว จะส่งเมื่อติดต่อ Chief ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaydedildi. Chief’inize ulaşılabildiğinde gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Збережено. Надішлеться, коли Chief буде доступний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đã lưu. Sẽ gửi khi Chief có thể liên lạc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已保存。Chief 可连接时会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "已儲存。Chief 可連線時會傳送。"
          }
        }
      }
    },
