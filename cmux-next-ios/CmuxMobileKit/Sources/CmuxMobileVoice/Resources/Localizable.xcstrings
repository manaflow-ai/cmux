        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le chiamate Chief usano la tua chiave API OpenAI. Aggiungila o sostituiscila in Impostazioni → Chiamate Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief の通話にはご自身の OpenAI API キーを使用します。設定 → Chief 通話で追加または置き換えてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ការហៅ Chief ប្រើកូនសោ OpenAI APIផ្ទាល់ខ្លួនរបស់អ្នក។ បន្ថែម ឬជំនួសវានៅក្នុងការកំណត់ → ការហៅ Chief។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief 통화는 본인의 OpenAI API 키를 사용합니다. 설정 → Chief 통화에서 추가하거나 교체하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief-samtaler bruker din egen OpenAI API-nøkkel. Legg den til eller bytt den i Innstillinger → Chief-samtaler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmowy z Chiefem używają Twojego własnego klucza API OpenAI. Dodaj go lub zamień w Ustawienia → Rozmowy z Chiefem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As chamadas do Chief usam sua própria chave de API da OpenAI. Adicione ou substitua em Ajustes → Chamadas do Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Звонки Chief используют ваш собственный ключ API OpenAI. Добавьте или замените его в Настройки → Звонки Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การโทร Chief ใช้คีย์ OpenAI API ของคุณเอง เพิ่มหรือเปลี่ยนได้ที่ ตั้งค่า → การโทร Chief"
