    "chiefLive.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحدّث مع Chief كما تتحدث مع زميل. اسأله عمّا تفعله وكلاؤك، أو اطلب من Chief بدء عمل على أجهزة Mac لديك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Razgovarajte s Chiefom kao s kolegom. Pitajte šta rade vaši agenti ili neka Chief pokrene posao na vašim Macovima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tal med Chief som med en kollega. Spørg, hvad dine agenter laver, eller bed Chief starte arbejde på dine Mac’er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprich mit Chief wie mit einem Kollegen. Frag, was deine Agenten gerade tun, oder lass Chief Arbeit auf deinen Macs starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to Chief like a colleague. Ask what your agents are doing, or have Chief start work on your Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Habla con Chief como con un colega. Pregunta qué están haciendo tus agentes o pide a Chief que inicie trabajo en tus Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parlez à Chief comme à un collègue. Demandez ce que font vos agents ou faites lancer des tâches à Chief sur vos Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Parla con Chief come con un collega. Chiedi cosa stanno facendo i tuoi agenti o fai avviare a Chief dei lavori sui tuoi Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同僚と話すように Chief と話しましょう。エージェントの状況を尋ねたり、Mac での作業を Chief に開始させたりできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "និយាយជាមួយ Chief ដូចមិត្តរួមការងារ។ សួរអំពីអ្វីដែលភ្នាក់ងាររបស់អ្នកកំពុងធ្វើ ឬឱ្យ Chief ចាប់ផ្តើមការងារលើ Mac របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동료와 이야기하듯 Chief와 대화하세요. 에이전트가 무엇을 하는지 묻거나 Chief에게 Mac에서 작업을 시작하게 하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snakk med Chief som med en kollega. Spør hva agentene dine gjør, eller be Chief starte arbeid på Mac-ene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmawiaj z Chiefem jak ze współpracownikiem. Zapytaj, co robią Twoi agenci, albo poproś Chiefa o rozpoczęcie pracy na Twoich Macach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Converse com o Chief como com um colega. Pergunte o que seus agentes estão fazendo ou peça ao Chief para iniciar trabalhos nos seus Macs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Общайтесь с Chief как с коллегой. Спросите, чем заняты ваши агенты, или попросите Chief запустить работу на ваших Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุยกับ Chief เหมือนเพื่อนร่วมงาน ถามได้ว่าเอเจนต์ของคุณกำลังทำอะไร หรือให้ Chief เริ่มงานบน Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chief ile bir iş arkadaşınızla konuşur gibi konuşun. Ajanlarınızın ne yaptığını sorun ya da Chief’ten Mac’lerinizde iş başlatmasını isteyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спілкуйтеся з Chief, як із колегою. Запитайте, чим зайняті ваші агенти, або попросіть Chief запустити роботу на ваших Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trò chuyện với Chief như với đồng nghiệp. Hỏi các tác nhân của bạn đang làm gì, hoặc nhờ Chief bắt đầu công việc trên các máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "像和同事交谈一样与 Chief 对话。询问你的智能体在做什么，或让 Chief 在你的 Mac 上开始工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "像和同事交談一樣與 Chief 對話。詢問你的代理在做什麼，或讓 Chief 在你的 Mac 上開始工作。"
          }
        }
      }
    },
