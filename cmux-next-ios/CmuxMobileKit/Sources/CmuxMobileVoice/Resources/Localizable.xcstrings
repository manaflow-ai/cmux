    "chiefCall.status.microphoneDenied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن لـ cmux استخدام الميكروفون. اسمح به في الإعدادات للتحدث إلى Chief."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ne može koristiti mikrofon. Dozvolite ga u Postavkama da razgovarate sa svojim Chiefom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kan ikke bruge mikrofonen. Tillad den i Indstillinger for at tale med din Chief."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kann das Mikrofon nicht verwenden. Erlaube es in den Einstellungen, um mit deinem Chief zu sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux can’t use the microphone. Allow it in Settings to talk to your Chief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux no puede usar el micrófono. Permítelo en Ajustes para hablar con tu Chief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ne peut pas utiliser le micro. Autorisez-le dans Réglages pour parler à votre Chief."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux non può usare il microfono. Consentilo in Impostazioni per parlare con il tuo Chief."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux はマイクを使用できません。Chief と話すには設定で許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux មិនអាចប្រើមីក្រូហ្វូនបានទេ។ អនុញ្ញាតវានៅក្នុងការកំណត់ ដើម្បីនិយាយជាមួយ Chief របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux에서 마이크를 사용할 수 없습니다. Chief와 대화하려면 설정에서 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux kan ikke bruke mikrofonen. Tillat den i Innstillinger for å snakke med Chief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux nie może użyć mikrofonu. Zezwól na to w Ustawieniach, aby rozmawiać z Chiefem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O cmux não pode usar o microfone. Permita em Ajustes para falar com seu Chief."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не может использовать микрофон. Разрешите доступ в Настройках, чтобы говорить с Chief."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux ใช้ไมโครโฟนไม่ได้ อนุญาตในการตั้งค่าเพื่อคุยกับ Chief ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux mikrofonu kullanamıyor. Chief’inizle konuşmak için Ayarlar’dan izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux не може використовувати мікрофон. Дозвольте доступ у Параметрах, щоб говорити з Chief."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux không thể dùng micrô. Hãy cho phép trong Cài đặt để nói chuyện với Chief."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "cmux 无法使用麦克风。请在“设置”中允许，以便与 Chief 通话。"
