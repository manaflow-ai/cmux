    "mobile.agentChat.whoElse.looking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for who else works on these files…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche, wer noch an diesen Dateien arbeitet…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des autres sessions sur ces fichiers…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ البحث عمّن يعمل على هذه الملفات…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando quién más trabaja en estos archivos…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找還有誰在處理這些檔案…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找还有谁在处理这些文件…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 작업 중인 다른 세션을 찾는 중…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルで作業中の他のセッションを検索中…"
          }
        }
      }
    },
