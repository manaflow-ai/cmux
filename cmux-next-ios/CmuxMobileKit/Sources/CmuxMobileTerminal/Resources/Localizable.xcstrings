{
  "sourceLanguage": "en",
  "strings": {
    "terminal.photos.deadline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos took too long to provide this item."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laden dieses Objekts aus „Fotos“ hat zu lange gedauert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos a mis trop de temps à fournir cet élément."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تحميل هذا العنصر من تطبيق «الصور» وقتًا طويلاً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos ha tardado demasiado en cargar este elemento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「照片」載入此項目的時間過長。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“照片”载入此项目的时间过长。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에서 이 항목을 불러오는 데 시간이 너무 오래 걸렸습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」からこの項目を読み込むのに時間がかかりすぎました。"
          }
        }
      }
    },
    "terminal.photos.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos could not provide this item."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt konnte nicht aus „Fotos“ geladen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos n’a pas pu fournir cet élément."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل هذا العنصر من تطبيق «الصور»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos no ha podido cargar este elemento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「照片」無法載入此項目。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“照片”无法载入此项目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에서 이 항목을 불러올 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」からこの項目を読み込めませんでした。"
          }
        }
      }
    },
    "terminal.photos.loadFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load %1$@ from Photos: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht aus „Fotos“ geladen werden: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger %1$@ depuis Photos : %2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل %1$@ من تطبيق «الصور»: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar %1$@ desde Fotos: %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從「照片」載入 %1$@：%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从“照片”载入 %1$@：%2$@"
