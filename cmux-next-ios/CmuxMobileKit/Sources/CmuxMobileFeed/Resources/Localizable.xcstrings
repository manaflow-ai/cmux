{
  "sourceLanguage": "en",
  "strings": {
    "mobile.feed.connecting": {
      "comment": "Feed: shown with a spinner while no Mac has answered yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to your Mac…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال بجهاز Mac…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung mit deinem Mac wird hergestellt …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con tu Mac…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à votre Mac…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に接続中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 연결하는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接你的 Mac…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連線到你的 Mac…"
          }
        }
      }
    },
    "mobile.feed.offline.title": {
      "comment": "Feed: title when no Mac answered within the connect deadline; Retry sits below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Macs are offline"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجهزة Mac لديك غير متصلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Macs sind offline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus Mac están sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos Mac sont hors ligne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac がオフラインです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 오프라인 상태입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 处于离线状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 已離線"
          }
        }
      }
    },
    "mobile.feed.offline.body": {
      "comment": "Feed: what to do when no Mac answered within the connect deadline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open cmux on your Mac and make sure it's online."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح cmux على جهاز Mac وتأكد من أنه متصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne cmux auf deinem Mac und prüfe, ob er online ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cmux en tu Mac y asegúrate de que esté conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez cmux sur votre Mac et vérifiez qu’il est en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で cmux を開き、オンラインであることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 cmux를 열고 온라인 상태인지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上打开 cmux，并确保它已联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上打開 cmux，並確認它已連線。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
