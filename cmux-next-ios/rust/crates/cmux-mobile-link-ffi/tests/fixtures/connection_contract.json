    {"name": "WG_REACH_VERSION", "value": 2, "old_peer": "A peer below 2 gets relay frames and the three-second relay rule.", "guards": [["cmux-mobile-link/tests/https_relay.rs", "an_older_peer_keeps_the_three_second_relay_rule"], ["cmux-mobile-link/tests/https_relay.rs", "an_older_phone_against_a_new_mac_keeps_the_three_second_relay_rule"]]},
