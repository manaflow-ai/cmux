{
  "about": "The phone's connection contract at the FFI boundary (cmux-next-ios/contract/README.md). Rust reads it in cmux-mobile-link-ffi/tests/connection_contract.rs; Swift reads the same file in CmuxMobileLinkFFILinuxTests/ConnectionContractTests.swift (through the real binding), CmuxMobileLiveTests/ConnectionContractScenarioTests.swift (LinkMachine) and CmuxMobileModelTests/ConnectionContractCopyTests.swift (the Mac view's words). A Rust change to an event, a resolution or a protocol version fails the Rust test until this file says what changed; the file's change then fails the Swift tests until iOS handles it.",
  "link_event_variants": ["Connecting", "Connected", "PathChanged", "Rtt", "Media", "Disconnected", "Suspect"],
  "media_state_variants": ["Off", "Connecting", "Up", "Failed"],
  "reachability_kinds": ["Connected", "Connecting", "NotConnected", "Slow", "Offline", "NoAnswer", "ServiceDown", "AuthRequired", "NotAllowed", "PhoneOffline"],
  "reachability": [
    {"name": "mock mode, listed online", "input": {"is_online": true, "live": false}, "expect": {"kind": "Connected"}, "action": null, "status_text": "Online"},
    {"name": "mock mode, listed offline", "input": {"is_online": false, "live": false}, "expect": {"kind": "Offline"}, "action": "Retry"},
    {"name": "Mac asleep: listed offline, never dialed", "input": {"is_online": false}, "expect": {"kind": "Offline"}, "action": "Retry"},
    {"name": "Mac asleep: listed offline, the dial got no answer", "input": {"is_online": false, "connection": "Failed", "failure": "HostUnreachable"}, "expect": {"kind": "Offline"}, "action": "Retry"},
    {"name": "listed online, the dial got no answer", "input": {"is_online": true, "connection": "Failed", "failure": "HostUnreachable"}, "expect": {"kind": "NoAnswer", "listed_online": true}, "action": "Retry", "status_text": "Online · Not responding"},
    {"name": "listed online, a redial in flight after no answer", "input": {"is_online": true, "connection": "Connecting", "failure": "HostUnreachable"}, "expect": {"kind": "Connecting"}, "action": null, "status_text": "Connecting…"},
    {"name": "linked, a stale no-answer kept", "input": {"is_online": true, "connection": "Connected", "failure": "HostUnreachable"}, "expect": {"kind": "Connected"}, "action": null, "status_text": "Online"},
    {"name": "listed online, the link failed without a failure kind", "input": {"is_online": true, "connection": "Failed"}, "expect": {"kind": "NoAnswer", "listed_online": true}, "action": "Retry"},
    {"name": "listed online, heartbeat quiet 40 s", "input": {"is_online": true, "quiet_ms": 40000}, "expect": {"kind": "Slow", "quiet_seconds": 40}, "action": "Retry", "status_text": "Not responding · heard 40 s ago"},
    {"name": "listed online, another Mac linked", "input": {"is_online": true}, "expect": {"kind": "NotConnected"}, "action": null, "status_text": "Online · Not connected"},
    {"name": "phone offline, not linked", "input": {"is_online": true, "phone_offline": true}, "expect": {"kind": "PhoneOffline"}, "action": "Retry", "status_text": "This iPhone is offline"},
    {"name": "phone offline, link still up (a path change in flight)", "input": {"is_online": true, "phone_offline": true, "connection": "Connected"}, "expect": {"kind": "Connected"}, "action": null, "status_text": "Online"},
    {"name": "session refused", "input": {"is_online": true, "connection": "Failed", "failure": "AuthRequired"}, "expect": {"kind": "AuthRequired"}, "action": "SignIn", "status_text": "Signed out"},
    {"name": "the Mac refused this iPhone", "input": {"is_online": true, "connection": "Failed", "failure": "NotAllowed"}, "expect": {"kind": "NotAllowed"}, "action": "Retry", "status_text": "Didn't allow this iPhone"},
    {"name": "reached, cmux on the Mac silent", "input": {"is_online": true, "connection": "Connected", "failure": "ServiceDown"}, "expect": {"kind": "ServiceDown"}, "action": "Retry", "status_text": "Reached · cmux not answering"},
    {"name": "connecting", "input": {"is_online": true, "connection": "Connecting"}, "expect": {"kind": "Connecting"}, "action": null}
  ],
