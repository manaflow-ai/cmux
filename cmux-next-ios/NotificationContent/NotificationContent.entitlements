<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's push key and the Macs' trust record (public keys): the long look
	     opens a sealed push again from its box before it shows rows or buttons
	     (PushTrustGate, verify/notifications-trust.md). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(CMUX_MOBILE_APP_BUNDLE_ID).push</string>
	</array>
</dict>
</plist>
