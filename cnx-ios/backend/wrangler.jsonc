// cnx-ios-api: signaling, presence, WireGuard relay and device registry for the cnx-ios app
// (cnx-ios/PROTOCOL.md). Top level is local/test only (no database: tests use the memory store).
// Secrets per env (wrangler secret put --env <env>): TURN_KEY_ID, TURN_KEY_API_TOKEN, and optionally
// STACK_SECRET_SERVER_KEY. The database URL lives only in the Hyperdrive config.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cnx-ios-api-local",
  "main": "src/index.ts",
  "account_id": "0c1675e0def6de1ab3a50a4e17dc5656",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "local",
    "API_VERSION": "0.4.0",
    // Stack projects whose users are accepted, primary first (src/auth.ts StackProject).
    "STACK_PROJECTS": "[{\"id\":\"454ecd03-1db2-4050-845e-4ce5b0cd9895\",\"label\":\"dev\",\"publishableClientKey\":\"pck_xb63160bwe9699vtxfzfj6emmxpafg5mkjrtp6ehzxv5g\",\"inviteCallbackUrl\":\"http://localhost:8102/handler/team-invitation\"},{\"id\":\"9790718f-14cd-4f7e-824d-eaf527a82b82\",\"label\":\"prod\",\"publishableClientKey\":\"\",\"inviteCallbackUrl\":\"https://cmux.com/handler/team-invitation\"}]"
  },
  "durable_objects": { "bindings": [{ "name": "TEAM_HUB", "class_name": "TeamHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamHub"] }],
  "env": {
    "dev": {
      "name": "cnx-ios-api-dev",
      "workers_dev": true,
      // Query strings can carry nothing secret here, but redact anyway; invocation logs would record the
      // Sec-WebSocket-Protocol bearer, so they stay off.
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "vars": {
        "ENVIRONMENT": "dev",
        "API_VERSION": "0.4.0",
        // Dev (primary) and production Stack users: production cnx builds use this dev Worker too.
        "STACK_PROJECTS": "[{\"id\":\"454ecd03-1db2-4050-845e-4ce5b0cd9895\",\"label\":\"dev\",\"publishableClientKey\":\"pck_xb63160bwe9699vtxfzfj6emmxpafg5mkjrtp6ehzxv5g\",\"inviteCallbackUrl\":\"http://localhost:8102/handler/team-invitation\"},{\"id\":\"9790718f-14cd-4f7e-824d-eaf527a82b82\",\"label\":\"prod\",\"publishableClientKey\":\"\",\"inviteCallbackUrl\":\"https://cmux.com/handler/team-invitation\"}]"
      },
      "durable_objects": { "bindings": [{ "name": "TEAM_HUB", "class_name": "TeamHub" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamHub"] }],
      // PlanetScale Postgres cnx-ios (org cmux), branch main, role cnx-ios-dev.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "e4fd2e88cfcd4f00841ddc5b49c3ee06" }]
    },
    "prod": {
      // Configured, not deployed. Before the first deploy: check the prod inviteCallbackUrl in STACK_PROJECTS is a trusted domain of the prod Stack project, create a prod
      // PlanetScale branch/role and its Hyperdrive config, then replace the placeholders below.
      "name": "cnx-ios-api-prod",
      "workers_dev": true,
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "vars": {
        "ENVIRONMENT": "prod",
        "API_VERSION": "0.4.0",
        "STACK_PROJECTS": "[{\"id\":\"9790718f-14cd-4f7e-824d-eaf527a82b82\",\"label\":\"prod\",\"publishableClientKey\":\"\",\"inviteCallbackUrl\":\"https://cmux.com/handler/team-invitation\"}]"
      },
      "durable_objects": { "bindings": [{ "name": "TEAM_HUB", "class_name": "TeamHub" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamHub"] }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_PROD_HYPERDRIVE_ID" }]
    }
  }
}
