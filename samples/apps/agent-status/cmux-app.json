{
  "$schema": "https://cmux.dev/schemas/cmux-app/1.json",
  "manifestVersion": 1,
  "id": "cmux/agent-status",
  "name": { "en": "Agent Status", "ja": "エージェントの状態" },
  "version": "1.0.0",
  "description": "A small status item: how many agents are working and how many wait for you.",
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": { "symbol": "gauge.with.dots.needle.33percent" },
  "categories": ["agents", "monitoring"],
  "engines": { "cmux": "^1.0" },
  "main": "dist/main.js",
  "scopes": {
    "agent:read": "Count the agents running in your terminals.",
    "terminal:read": "Find the tab of an agent's terminal.",
    "workspace:write": "Show an agent's tab from the menu."
  },
  "contributes": {
    "statusItems": [{ "id": "status", "title": { "en": "Agent Status", "ja": "エージェントの状態" }, "symbol": "gauge.with.dots.needle.33percent", "placement": "titlebar", "render": "renderStatus" }]
  },
  "files": ["dist/"]
}
