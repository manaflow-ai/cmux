{
  "$schema": "https://cmux.dev/schemas/cmux-app/2.json",
  "manifestVersion": 2,
  "id": "cmux/github-prs",
  "name": { "en": "GitHub PRs", "ja": "GitHub PR" },
  "version": "1.0.0",
  "description": "Your open pull requests as a sidebar section: review state, drafts, and one click to open.",
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "categories": ["sidebar", "git", "samples"],
  "engines": { "cmux": "^2.0" },
  "runtime": { "main": "dist/main.js" },
  "catalog": "catalog.json",
  "implements": {
    "cmux.section/1": {
      "export": "renderPRs",
      "title": { "en": "Pull Requests", "ja": "プルリクエスト" },
      "symbol": "arrow.triangle.pull",
      "options": { "defaultRegion": "middle", "maxRows": 10 }
    }
  },
  "scopes": {
    "net:api.github.com": "Read your open pull requests from GitHub.",
    "actions:run": "Open a pull request in a browser tab when you click it."
  },
  "optionalScopes": {
    "integration:github:read": "Use your connected GitHub account (private repositories) without seeing its token."
  },
  "settings": {
    "type": "object",
    "properties": {
      "login": { "type": "string", "title": "GitHub login", "default": "" },
      "showDrafts": { "type": "boolean", "title": "Show drafts", "default": true }
    }
  },
  "activation": ["onInterface:cmux.section/1", "onOp:github_prs.refresh"],
  "files": ["dist/", "assets/", "catalog.json"]
}
