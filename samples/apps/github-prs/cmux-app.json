{
  "$schema": "https://cmux.dev/schemas/cmux-app/1.json",
  "manifestVersion": 1,
  "id": "cmux/github-prs",
  "name": { "en": "GitHub PRs", "ja": "GitHub PR" },
  "version": "1.0.0",
  "description": "Your pull requests as sidebar sections: review state, recent activity, drafts, and one click to open.",
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.svg",
  "categories": ["sidebar", "git"],
  "engines": { "cmux": "^1.0" },
  "main": "dist/main.js",
  "scopes": {
    "net:api.github.com": "Read your open pull requests from GitHub.",
    "actions:run": "Open a pull request in a browser tab when you click it."
  },
  "optionalScopes": {
    "integration:github:read": "Use your connected GitHub account (private repositories) without seeing its token."
  },
  "contributes": {
    "sidebarSections": [
      { "id": "prs", "title": { "en": "Pull Requests", "ja": "プルリクエスト" }, "symbol": "arrow.triangle.pull", "defaultRegion": "middle", "render": "renderPRs", "maxRows": 10 },
      { "id": "recent", "title": { "en": "PRs · last 24h", "ja": "PR · 過去24時間" }, "symbol": "clock.arrow.circlepath", "defaultRegion": "bottom", "render": "renderRecentPRs", "maxRows": 10 }
    ],
    "commands": [{ "id": "refresh", "title": { "en": "Refresh Pull Requests", "ja": "プルリクエストを更新" }, "run": "refresh", "keywords": ["github", "pr"], "contexts": ["palette", "sidebarSection:prs"] }],
    "settings": {
      "type": "object",
      "properties": {
        "login": { "type": "string", "title": "GitHub login", "default": "" },
        "showDrafts": { "type": "boolean", "title": "Show drafts", "default": true }
      }
    }
  },
  "activation": ["onSidebarSection:prs", "onSidebarSection:recent", "onCommand:refresh"],
  "files": ["dist/", "assets/"]
}
