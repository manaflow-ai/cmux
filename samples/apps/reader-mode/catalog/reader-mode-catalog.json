{
  "family": "reader_mode",
  "owner": "app:cmux/reader-mode",
  "operations": [
    {
      "name": "reader_mode.open",
      "owner": "app:cmux/reader-mode",
      "class": "mutation",
      "risk": "mutate-own",
      "idempotency": "required",
      "focuses": true,
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tab": { "type": "string", "description": "The browser tab to read; default the focused one." }
        },
        "required": []
      },
      "cli": { "path": "open", "visible": true },
      "mcp": { "expose": "never" },
      "palette": { "title": { "en": "Reader mode", "ja": "リーダーモード" } },
      "docs": "Read the article of the focused browser tab (or tab) and show it in the Reader pane.",
      "since": "reader_mode/1",
      "export": "open"
    }
  ]
}
