{
  "$schema": "https://cmux.dev/schemas/cmux-app/1.json",
  "manifestVersion": 1,
  "id": "cmux/priority-view",
  "name": { "en": "Priority View", "ja": "優先ビュー" },
  "version": "0.1.0",
  "description": "Your agent chats ranked by what needs you: waiting on you, finished, failed, CI failing, working, then idle; pinned first in each. Click one to open it.",
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.svg",
  "categories": ["sidebar", "agents"],
  "engines": { "cmux": "^1.0" },
  "main": "dist/main.js",
  "scopes": {
    "chat:read": "List your agent chats on every machine.",
    "chat:write": "Mark a chat read or pin it when you click.",
    "workspace:write": "Show a chat's workspace when you click it."
  },
  "contributes": {
    "sidebarSections": [{ "id": "priority", "title": { "en": "Priority", "ja": "優先" }, "symbol": "bell", "defaultRegion": "top", "render": "renderPriority", "maxRows": 12 }],
    "settings": { "type": "object", "properties": { "showIdle": { "type": "boolean", "default": false, "title": "Show idle chats" } } }
  },
  "activation": ["onSidebarSection:priority"],
  "files": ["dist/", "assets/"]
}
