{
  "$schema": "https://cmux.dev/schemas/cmux-app/1.json",
  "manifestVersion": 1,
  "id": "cmux/priority-view",
  "name": { "en": "Priority View", "ja": "優先ビュー" },
  "version": "0.1.0",
  "description": "Your agents ranked by what needs you: waiting on you, finished, working, then idle. Click one to jump to its terminal.",
  "publisher": { "name": "cmux", "url": "https://cmux.dev" },
  "repository": "https://github.com/manaflow-ai/cmux",
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.svg",
  "categories": ["sidebar", "agents"],
  "engines": { "cmux": "^1.0" },
  "main": "dist/main.js",
  "scopes": {
    "agent:read": "List the agents running in your terminals.",
    "terminal:read": "Find the tab of an agent's terminal.",
    "workspace:write": "Show an agent's tab when you click it."
  },
  "contributes": {
    "sidebarSections": [{ "id": "priority", "title": { "en": "Priority", "ja": "優先" }, "symbol": "bell", "defaultRegion": "top", "render": "renderPriority", "maxRows": 12 }],
    "settings": { "type": "object", "properties": { "showIdle": { "type": "boolean", "default": false, "title": "Show idle agents" } } }
  },
  "activation": ["onSidebarSection:priority"],
  "files": ["dist/", "assets/"]
}
