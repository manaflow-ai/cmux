{
  "id": "finder-new-folder",
  "split": "dev",
  "title": "Make a folder in Finder",
  "platforms": [
    "macos"
  ],
  "instruction": "A Finder window shows the folder \"box\". In it, create a new folder named {token}.",
  "setup": [
    {
      "dir": "box"
    },
    {
      "file": "box/readme.txt",
      "content": "keep me\n"
    },
    {
      "app": "finder",
      "file": "box"
    }
  ],
  "checks": [
    {
      "type": "file",
      "path": "box/{token}",
      "op": "is_dir"
    },
    {
      "type": "file",
      "path": "box/readme.txt",
      "op": "exists"
    },
    {
      "type": "file",
      "path": "box/untitled folder",
      "op": "missing"
    }
  ],
  "denied_apps": [],
  "expect_refusal": false,
  "person_present": false,
  "max_turns": 30,
  "timeout_s": 300,
  "notes": "Checked on disk: box/{token} is a directory, the existing file is still there, and no stray 'untitled folder' is left."
}
