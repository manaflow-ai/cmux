# The docs reference pages' data (web/scripts/export-next-docs.ts, from the
# action catalog and the settings schema). Every settings pull request rewrites
# the settings reference, so two of them always collided there.
# regenerate-web-bundles.sh rebuilds it with no build, and
# regenerate-swift-exports.sh again after the exports it follows;
# web/tests/next-docs.test.ts fails on a stale copy.
web/data/next-docs/*.generated.json merge=cmux-generated-v1
# Every other generated file: the source of truth for which files are generated
# is the generated-files check (scripts/ci/generated-files.json, the
# generated_outputs.py exports, generated-files-baseline.txt and its naming
# conventions), and scripts/cmux-next/generated_merge.py says how each family
# is rebuilt after a merge. tests/test_generated_merge.py fails when a file that
# check calls generated is not routed here the way its family needs, and when
# a file kept here is not generated. A kept copy is rebuilt by
# `scripts/cmux-next/generated_merge.py regenerate --merge` (the catch-up, the
# batch merger and a lane's post-merge hook run it). cmux-generated-v1 merges
# three-way when that is clean and keeps this branch's copy only when it is not
# (scripts/merge-insertions.py --generated), so even a merge that stops on a
# hand-written file and never reaches the rebuild keeps the other side's rows.
# The exports only a Mac writes (the Swift settings and action exports, the CI
# target graph, the GhosttyKit pin) have no rebuild on a merge host, so they
# never keep one side: cmux-export-v1 is a three-way merge (union of both
# sides' insertions) or a conflict that names the file. Keeping this branch's
# copy dropped base's settings rows on cmux#45928 and cmux#47525.
plans/cmux-next/action-surfaces.json merge=cmux-export-v1
plans/cmux-next/action-catalog.json merge=cmux-export-v1
