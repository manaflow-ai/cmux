    "rd.state.connecting.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to %@…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ に接続中…"
          }
        }
      }
    },
    "rd.state.consent.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone at %1$@ must allow this session. It ends in %2$lld s without an answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ にいる人がこのセッションを許可する必要があります。応答がなければ %2$lld 秒で終了します。"
          }
        }
      }
    },
    "rd.state.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for consent on %@…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ での許可を待っています…"
          }
        }
      }
    },
    "rd.state.kicked.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ended your session on %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ が %2$@ でのセッションを終了しました。"
          }
