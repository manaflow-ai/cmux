    },
    "rd.state.latency.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ms, %2$@. Control turns off above %3$lld ms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$lld ms、%2$@。%3$lld ms を超えると操作はオフになります。"
          }
        }
      }
    },
    "rd.state.latency.title": {
      "extractionState": "manual",
      "localizations": {
