        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "表示のみ: 遅延が大きい"
          }
        }
      }
    },
    "rd.state.stopped.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ turned off Remote Desktop. The last frame is shown."
