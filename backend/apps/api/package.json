    "@cmux/protocol": "workspace:*",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@upstash/qstash": "2.12.1",
    "@upstash/workflow": "1.4.0",
    "agents": "0.28.1",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5",
    "jose": "6.2.12",
    "mysql2": "3.23.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
