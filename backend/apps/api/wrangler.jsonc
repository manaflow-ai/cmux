      "r2_buckets": [{ "binding": "HOME_ATTACHMENTS", "bucket_name": "cmux-home-attachments-development" }],
      // PS_MYSQL/PS_MYSQL_RO: PlanetScale MySQL cmux-next-vitess development (readwriter / reader), the dual-write shadow (state-placement.md 4.5).
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "395af91311c0494a91da6876b0df6d49" }, { "binding": "HYPERDRIVE_RO", "id": "cb712d90da9d42fb84ac975275e0b6c8" }, { "binding": "PS_MYSQL", "id": "60893ba4eaef437a91a77da71730ea9b" }, { "binding": "PS_MYSQL_RO", "id": "fe1e9fd2a3844fbfabcb12110832c394" }],
      // The platform cutover (src/platform-forward.ts; cmux-platform docs/port-cloud-worker.md 3.1, 3.3): PLATFORM_SURFACES
      // above names the surfaces cmux-platform-development serves over this binding. cmux-platform-development owns
      // CloudDO here, so CLOUD_DO above is its class (script_name): this Worker's own callers (PlatformMachines, owner
      // outboxes, the socket route, crons) reach the same objects the forwarded requests do. The class export and its
      // migration stay in this Worker (no deleted_classes yet). Rollback: drop the var and CLOUD_DO's script_name.
      "services": [{ "binding": "PLATFORM", "service": "cmux-platform-development" }]
    },
    "staging": {
      "name": "cmux-api-staging",
      // user_8c851c7da76e8c031db9 in CHIEF_BRAIN_CLAUDE_OWNERS and CHIEF_CREDITS_DOGFOOD: the throwaway staging e2e account
      // (~/.secrets/cmux-next-e2e-cloudchief-staging.env) that backend/scripts/chief-durable-evals.ts runs the Chief evals as.
      // CHIEF_DURABLE_*: Cloud Chief D (chief-durable/, plans/cmux-next/cloud-chief-durable-DESIGN.md), staging and development only until it passes the staging evals.
      // Secret CHIEF_BRAIN_CLAUDE_STACK_AUTH (staging only): the Cloud Chiefs' sign-in for the metered Claude route
      // (Lawrence's personal chatmux session for now; replace with a scoped service token). Set with `wrangler secret put` from stdin.
      // Since 2026-10-18 staging runs the production route: CHIEF_BRAIN_CLAUDE_AUTH service-key (secret CHIEF_BRAIN_CLAUDE_SERVICE_KEY),
      // effort and thinking.display in the body, three Claude models, Haiku fallback and compactor (charged), so staging rehearses production.
      // Logs also go to Axiom (dataset cmux-api-staging-logs, monitor cmux-api-staging-kms-fallback); query strings
      // (SSO codes, emails) are removed first. Workers Logs stay on (persist).
      // invocation_logs off (cx-dgsp): invocation logs record every request header but Authorization. The API no
      // longer reads the legacy `bearer.` subprotocol, but a client built before the retirement still sends its
      // token there and the log would record it. Turn it on again once those clients have aged out.
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false, "persist": true, "destinations": ["axiom-cmux-api-staging"] } },
      // 23 * * * *: feed text sweep; */15: the Postgres/MySQL projection compare during the dual write;
      // */5: the Cloud Home health probe and its Sentry Cron check-in (home-health.ts, secret SENTRY_DSN);
      // 7 * * * *: the full read-only Postgres/MySQL verify of every projected row (projection-compare-full-cron.ts).
      "triggers": { "crons": ["23 * * * *", "*/15 * * * *", "*/5 * * * *", "7 * * * *"] },
      "workers_dev": true,
      // INFERENCE_ALLOWED_TEAMS: team_6b6623866a52063af515 is the staging e2e account's personal team (paid-plan.md §8 per-provider turns).
      // CLOUD_ALLOWED_TEAMS "*" and PLATFORM_MACHINES: as on development. Creates still need CLOUD_FREESTYLE_SNAPSHOT (a cmuxnp-stg-vmimg- image) and the CLOUD_FREESTYLE_API_KEY secret.
      // CHIEF_CC_* (chief-brain-cc/, Lawrence 2026-10-20, personal use): owners on CHIEF_CC_OWNERS (also paid-model owners) run each turn as
      // Claude Code in a Freestyle VM (snapshot from backend/chief-cc/bake.sh) through the sr2 gateway on the tailnet;
      // secrets CHIEF_CC_FREESTYLE_API_KEY and CHIEF_CC_TS_OAUTH turn it on. Not charged to Cloud credits; counted in the daily paid-turn cap.
      "vars": { "ENVIRONMENT": "staging", "INFERENCE_MODEL_ALLOWLIST": "deepseek/deepseek-v4.1-flash-1017,deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro", "INFERENCE_PRIMARY_PROVIDER": "vercel", "INFERENCE_CF_GATEWAY_ID": "cmux-ai-proxy", "INFERENCE_AZURE_ENDPOINT": "https://lawrence-1614-resource.services.ai.azure.com", "INFERENCE_VERCEL_RELAY_URL": "https://console-staging.cmux.dev/api/ai-gateway/chat/completions", "CHIEF_DURABLE_ENABLED": "1", "CHIEF_CC_ENABLED": "1", "CHIEF_CC_OWNERS": "user_57873416b63e10546f1f,user_96d0a614fd5318d0c23a", "CHIEF_CC_SNAPSHOT": "sh-e4d3df6380b547e4b59b9d59b6439911", "HANDS_ENABLED": "1", "CHIEF_BRAIN_PRUNE_PI": "1", "CHIEF_BRAIN_CLAUDE_DAILY_TURNS": "400", "CHIEF_BRAIN_CLAUDE_DAILY_TURNS_TOTAL": "3000", "HAND_RELEASE_TREE": "53de377aadcd85bc42945099abdc5cf91795a645", "HAND_SANDBOX_SNAPSHOT": "cmuxnp-stg-hand-v4", "HAND_CLASSIFIER_MODEL": "claude-opus-5-5", "HANDS_MAC_ENABLED": "1", "HANDS_MAC_OWNERS": "user_57873416b63e10546f1f,user_96d0a614fd5318d0c23a", "CHIEF_OPENCODE_ENABLED": "1", "CHIEF_OPENCODE_CONTAINER": "1", "CREDITS_MIRROR": "mysql", "CHIEF_CREDITS_DOGFOOD": "user_8c851c7da76e8c031db9,team_f77575bdfd932388f2e3,user_57873416b63e10546f1f,user_58710c448611ed7f626b,user_eaa1fa2dc5c7f4b575ce,user_6187a0141219db26bf26,user_96d0a614fd5318d0c23a", "CHIEF_CREDITS_DOGFOOD_USD": "500", "CHIEF_BRAIN_ENABLED": "1", "CHIEF_BRAIN_MODEL": "claude-opus-5-5", "CHIEF_BRAIN_CLAUDE_OWNERS": "user_8c851c7da76e8c031db9,user_57873416b63e10546f1f,user_58710c448611ed7f626b,user_eaa1fa2dc5c7f4b575ce,user_6187a0141219db26bf26,user_9bb642ce1958563c64f3,user_96d0a614fd5318d0c23a", "CHIEF_BRAIN_CLAUDE_AUTH": "service-key", "CHIEF_BRAIN_CLAUDE_MODELS": "claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5", "CHIEF_BRAIN_FALLBACK_MODEL": "claude-haiku-5-5", "CHIEF_BRAIN_COMPACTOR_MODEL": "claude-haiku-5-5", "INFERENCE_ENABLED": "1", "INFERENCE_ALLOWED_TEAMS": "team_f77575bdfd932388f2e3,team_6b6623866a52063af515", "INFER