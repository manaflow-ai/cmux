          { "name": "ADDRESS_DO", "class_name": "AddressDO" },
          { "name": "DOMAIN_DO", "class_name": "DomainDO" },
          { "name": "PAIRING_DO", "class_name": "PairingDO" }, { "name": "HOST_DO", "class_name": "HostDO" }, { "name": "HAND_DO", "class_name": "HandDO" }, { "name": "USAGE_METER_DO", "class_name": "UsageMeterDO" }, { "name": "SPEND_GUARD_DO", "class_name": "SpendGuardDO" }, { "name": "FREE_DEVICE_DO", "class_name": "FreeDeviceDO" }, { "name": "TEAM_VM_DO", "class_name": "TeamVmDO" }, { "name": "CLOUD_DO", "class_name": "CloudDO", "script_name": "cmux-platform-development" }, { "name": "TRAJECTORY_DO", "class_name": "TrajectoryDO" }, { "name": "WIRE_TICKET_DO", "class_name": "WireTicketDO" }, { "name": "CHIEF_BRAIN_DO", "class_name": "ChiefBrainDO" }, { "name": "CHIEF_DURABLE_DO", "class_name": "ChiefDurableDO" }, { "name": "HANDOFF_DO", "class_name": "HandoffDO" }, { "name": "HANDOFF_INDEX_DO", "class_name": "HandoffIndexDO" }
        ]
