      "workflows": [{ "name": "cmux-automation-run-staging", "binding": "AUTOMATION_RUN", "class_name": "AutomationRunWorkflow" }],
      "worker_loaders": [{ "binding": "LOADER" }],
      // Workers AI for the model router (src/inference): billed to this account, capped by SpendGuardDO.
      "ai": { "binding": "AI" },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "TeamDO"] }, { "tag": "v2", "new_sqlite_classes": ["SchedulerDO"] }, { "tag": "v3", "new_sqlite_classes": ["ConnectionDO", "AccountIndexDO"] }, { "tag": "v4", "new_sqlite_classes": ["FeedDO"] }, { "tag": "v5", "new_sqlite_classes": ["DomainDO"] }, { "tag": "v6", "new_sqlite_classes": ["ConversationDO", "MuxDO", "AddressDO"] }, { "tag": "v7", "new_sqlite_classes": ["PairingDO"] }, { "tag": "v8", "new_sqlite_classes": ["HostDO"] }, { "tag": "v9", "new_sqlite_classes": ["UsageMeterDO"] }, { "tag": "v10", "new_sqlite_classes": ["TeamVmDO"] }, { "tag": "v11", "new_sqlite_classes": ["CloudDO"] }, { "tag": "v12", "new_sqlite_classes": ["SpendGuardDO"] }, { "tag": "v13", "new_sqlite_classes": ["FreeDeviceDO"] }, { "tag": "v14", "new_sqlite_classes": ["WireTicketDO"] }, { "tag": "v15", "new_sqlite_classes": ["ChiefBrainDO"] }, { "tag": "v16", "new_sqlite_classes": ["HandDO"] }, { "tag": "v17", "new_sqlite_classes": ["OpencodeBrainDO"] }, { "tag": "v18", "new_sqlite_classes": ["HandoffDO", "HandoffIndexDO"] }, { "tag": "v19", "new_sqlite_classes": ["ChiefDurableDO"] }, { "tag": "v20", "new_sqlite_classes": ["TrajectoryDO"] }],
      // The Cloud Chief brain O (chief-brain-opencode/): one container per Chief that runs O, slept when idle.
      "containers": [{ "class_name": "OpencodeBrainDO", "image": "../../chief-opencode/image/Dockerfile", "image_build_context": "../../chief-opencode", "max_instances": 20, "instance_type": "standard-1" }],
      "ratelimits": [{ "name": "SSO_DISCOVER_LIMIT", "namespace_id": "1102", "simple": { "limit": 30, "period": 60 } }, { "name": "PAIR_BEGIN_LIMIT", "namespace_id": "1112", "simple": { "limit": 10, "period": 60 } }, { "name": "GOOGLE_HOOK_FAIL_LIMIT", "namespace_id": "1132", "simple": { "limit": 60, "period": 60 } }, { "name": "HOME_ATTACHMENT_LIMIT", "namespace_id": "1142", "simple": { "limit": 60, "period": 60 } }, { "name": "CLOUD_MUTATION_LIMIT", "namespace_id": "1152", "simple": { "limit": 30, "period": 60 } }, { "name": "CLOUD_KEYSET_LIMIT", "namespace_id": "1162", "simple": { "limit": 60, "period": 60 } }, { "name": "WIRE_TICKET_LIMIT", "namespace_id": "1192", "simple": { "limit": 60, "period": 60 } }, { "name": "STACK_READ_LIMIT", "namespace_id": "1202", "simple": { "limit": 4, "period": 60 } }, { "name": "STACK_READ_LOW_LIMIT", "namespace_id": "1212", "simple": { "limit": 2, "period": 60 } }, { "name": "INFERENCE_FREE_IP_LIMIT", "namespace_id": "1172", "simple": { "limit": 60, "period": 60 } }, { "name": "INFERENCE_FREE_GRANT_LIMIT", "namespace_id": "1182", "simple": { "limit": 2, "period": 60 } }],
      // Home attachments: private bucket (no public access, no custom domain); the Worker hashes uploads and signs downloads.
      "r2_buckets": [{ "binding": "HOME_ATTACHMENTS", "bucket_name": "cmux-home-attachments-staging" }],
      // PS_MYSQL/PS_MYSQL_RO: PlanetScale MySQL cmux-next-vitess staging (readwriter / reader), the dual-write shadow (state-placement.md 4.5).
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9761093781aa4d6f8a1ad00848663266" }, { "binding": "HYPERDRIVE_RO", "id": "10bbf30d021f40db9a52eae8d0deb523" }, { "binding": "PS_MYSQL", "id": "7262c6189a304aa691bb10a88732f65c" }, { "binding": "PS_MYSQL_RO", "id": "5127d85285c7461f8e6a8f799646fbd5" }],
      "routes": [{ "pattern": "cloud-api-staging.cmux.dev", "custom_domain": true }]
    },
    "production": {
      "name": "cmux-api",
      // Logs also go to Axiom (dataset cmux-api-prod-logs, monitor cmux-api-production-kms-fallback); query strings removed first.
      // invocation_logs off (cx-dgsp), as staging: clients built before the retirement still send `bearer.<token>`.
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false, "persist": true, "destinations": ["axiom-cmux-api-production"] } },
      // 23 */6: feed text sweep; */5: the Cloud Home health probe and its Sentry Cron check-in (home-health.ts, secret SENTRY_DSN);
      // */15: the Postgres/MySQL projection compare during the dual write (projection-compare-cron.ts), as on staging:
      // counts and per-row hashes, a lasting MySQL gap repaired from Postgres while Postgres is primary. The usage sync
      // on the same cron stays off in production until its live switch (index.ts). The hourly full verify ("7 * * * *",
      // projection-compare-full-cron.ts) runs on staging only; production adds it when the cutover runbook asks.
      "triggers": { "crons": ["23 */6 * * *", "*/15 * * * *", "*/5 * * * *"] },
      "workers_dev": true,
      // Inference (Lawrence, 2026-10-12): paid teams on, 20 USD per provider per UTC day; the free tier stays OFF
      // (INFERENCE_FREE_ENABLED "0") until device attestation is live (cx-ds09i). Invite links open the production
      // console (HOME_INVITE_ORIGIN, a plain var). Invites on (Lawrence, 2026-10-13): HOME_INVITES_SEND "on"; deploy-worker.sh
      // refuses a production deploy until the HOME_INVITE_FROM secret exists (prod-promote.ts config). Email only
      // (Lawrence, 2026-10-13): HOME_INVITES_TEXT "off" keeps the SendBlue secrets idle.
      // No CHIEF_BRAIN_CLAUDE_DAILY_TURNS_TOTAL in production (decision 2026-10-16): prepaid credits (reserve per call), the
      // per-owner daily limit and the chatmux service sub-cap (5k USD) bound spend; a deployment counter would put every turn through one object.
      // CHIEF_CC_*: as on staging (chief-brain-cc/; on only once both CHIEF_CC_ secrets are set). Snapshot cmuxnp-chiefcc-v7
      // (msg 8200: gh, chief-vm, chief-agents, cmux/mac through the Mac gate, hub, cmux-ci, cached clones). CHIEF_CC_TS_TAG:
      // turn nodes are tag:lawrence-chief (Lawrence's Chief only; its CHIEF_CC_TS_OAUTH client owns that tag), which reaches
      // sr2, the controller, the hub and the Mac gate (hq acl.manaflow.hujson). Secrets CHIEF_CC_TURN_FILES (Mac gate and
      // hub tokens) and CHIEF_CC_GITHUB_TOKEN are production only.
      "vars": { "ENVIRONMENT": "production", "INFERENCE_MODEL_ALLOWLIST": "deepseek/deepseek-v4.1-flash-1017,deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro", "INFERENCE_PRIMARY_PROVIDER": "vercel", "INFERENCE_CF_GATEWAY_ID": "cmux-ai-proxy", "INFERENCE_AZURE_ENDPOINT": "https://lawrence-1614-resource.services.ai.azure.com", "INFERENCE_VERCEL_RELAY_URL": "https://console.cmux.dev/api/ai-gateway/chat/completions", "CHIEF_CC_ENABLED": "1", "CHIEF_CC_OWNERS": "team_2fcc617e7ba8be229bcb", "CHIEF_CC_TS_TAG": "tag:lawrence-chief", "CHIEF_CC_SNAPSHOT": "sh-e4d3df6380b547e4b59b9d59b6439911", "CHIEF_BRAIN_ENABLED": "1", "CHIEF_BRAIN_MODEL": "claude-opus-5-5", "CHIEF_BRAIN_CLAUDE_AUTH": "service-key", "CHIEF_BRAIN_CLAUDE_MODELS": "claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5", "CHIEF_BRAIN_CLAUDE_OWNERS": "team_2fcc617e7ba8be229bcb,team_6197db2f4b9d28c7115a,team_7648bed712529f7a64fa,team_760c83ddd31c6360c927", "CHIEF_BRAIN_FALLBACK_MODEL": "claude-haiku-5-5", "CHIEF_BRAIN_COMPACTOR_MODEL": "claude-haiku-5-5", "CHIEF_RUN_TOKEN_CAP_USD": "5", "HOME_INVITE_ORIGIN": "https://console.cmux.dev", "HOME_INVITES_SEND": "on", "HOME_INVITES_TEXT": "off", "INFERENCE_ENABLED": "1", "INFERENCE_FREE_ENABLED": "0", "INFERENCE_DAILY_CAP_USD": "20", "INFERENCE_FREE_DAILY_CAP_USD": "10", "CLOUD_API_ORIGIN": "https://cloud-api.cmux.dev", "PLATFORM_MACHINES": "on", "CLOUD_NAME_PREFIX": "cmuxnp-prod-cld-", "WORKER_NAME": "cmux-api", "TEAM_VM_SLUG_PREFIX": "cmux-tvm-", "DASHBOARD_ORIGIN": "https://console.cmux.dev", "API_VERSION": "0.1.0", "IOS_APP_ID": "7WLXT3NR37.com.cmux.app", "STACK_PROJECT_ID": "9790718f-14cd-4f7e-824d-eaf527a82b82", "PROJECTION_SHADOW": "mysql", "PROJECTION_READS": "shadow" },
      "durable_objects": {
        "bindings": [
          { "name": "USER_DO", "class_name": "UserDO" },
          { "name": "TEAM_DO", "class_name": "TeamDO" },
          { "name": "SCHEDULER_DO", "class_name": "SchedulerDO" },
