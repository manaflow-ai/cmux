          { "name": "ADDRESS_DO", "class_name": "AddressDO" },
          { "name": "DOMAIN_DO", "class_name": "DomainDO" },
          { "name": "PAIRING_DO", "class_name": "PairingDO" }, { "name": "HOST_DO", "class_name": "HostDO" }, { "name": "HAND_DO", "class_name": "HandDO" }, { "name": "USAGE_METER_DO", "class_name": "UsageMeterDO" }, { "name": "SPEND_GUARD_DO", "class_name": "SpendGuardDO" }, { "name": "FREE_DEVICE_DO", "class_name": "FreeDeviceDO" }, { "name": "TEAM_VM_DO", "class_name": "TeamVmDO" }, { "name": "CLOUD_DO", "class_name": "CloudDO" }, { "name": "TRAJECTORY_DO", "class_name": "TrajectoryDO" }, { "name": "WIRE_TICKET_DO", "class_name": "WireTicketDO" }, { "name": "CHIEF_BRAIN_DO", "class_name": "ChiefBrainDO" }
        ]
      },
      "workflows": [{ "name": "cmux-automation-run-production", "binding": "AUTOMATION_RUN", "class_name": "AutomationRunWorkflow" }],
      "worker_loaders": [{ "binding": "LOADER" }],
      // Workers AI for the model router (src/inference): billed to this account, capped by SpendGuardDO.
      "ai": { "binding": "AI" },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "TeamDO"] }, { "tag": "v2", "new_sqlite_classes": ["SchedulerDO"] }, { "tag": "v3", "new_sqlite_classes": ["ConnectionDO", "AccountIndexDO"] }, { "tag": "v4", "new_sqlite_classes": ["FeedDO"] }, { "tag": "v5", "new_sqlite_classes": ["DomainDO"] }, { "tag": "v6", "new_sqlite_classes": ["ConversationDO", "MuxDO", "AddressDO"] }, { "tag": "v7", "new_sqlite_classes": ["PairingDO"] }, { "tag": "v8", "new_sqlite_classes": ["HostDO"] }, { "tag": "v9", "new_sqlite_classes": ["UsageMeterDO"] }, { "tag": "v10", "new_sqlite_classes": ["TeamVmDO"] }, { "tag": "v11", "new_sqlite_classes": ["CloudDO"] }, { "tag": "v12", "new_sqlite_classes": ["SpendGuardDO"] }, { "tag": "v13", "new_sqlite_classes": ["FreeDeviceDO"] }, { "tag": "v14", "new_sqlite_classes": ["WireTicketDO"] }, { "tag": "v15", "new_sqlite_classes": ["ChiefBrainDO"] }, { "tag": "v16", "new_sqlite_classes": ["HandDO"] }, { "tag": "v20", "new_sqlite_classes": ["TrajectoryDO"] }],
      "ratelimits": [{ "name": "SSO_DISCOVER_LIMIT", "namespace_id": "1103", "simple": { "limit": 30, "period": 60 } }, { "name": "PAIR_BEGIN_LIMIT", "namespace_id": "1113", "simple": { "limit": 10, "period": 60 } }, { "name": "GOOGLE_HOOK_FAIL_LIMIT", "namespace_id": "1133", "simple": { "limit": 60, "period": 60 } }, { "name": "HOME_ATTACHMENT_LIMIT", "namespace_id": "1143", "simple": { "limit": 60, "period": 60 } }, { "name": "CLOUD_MUTATION_LIMIT", "namespace_id": "1153", "simple": { "limit": 30, "period": 60 } }, { "name": "CLOUD_KEYSET_LIMIT", "namespace_id": "1163", "simple": { "limit": 60, "period": 60 } }, { "name": "WIRE_TICKET_LIMIT", "namespace_id": "1193", "simple": { "limit": 60, "period": 60 } }, { "name": "STACK_READ_LIMIT", "namespace_id": "1203", "simple": { "limit": 4, "period": 60 } }, { "name": "STACK_READ_LOW_LIMIT", "namespace_id": "1213", "simple": { "limit": 2, "period": 60 } }, { "name": "INFERENCE_FREE_IP_LIMIT", "namespace_id": "1173", "simple": { "limit": 60, "period": 60 } }, { "name": "INFERENCE_FREE_GRANT_LIMIT", "namespace_id": "1183", "simple": { "limit": 2, "period": 60 } }],
      // Home attachments: private bucket (no public access, no custom domain); the Worker hashes uploads and signs downloads.
      "r2_buckets": [{ "binding": "HOME_ATTACHMENTS", "bucket_name": "cmux-home-attachments" }],
      // PS_MYSQL/PS_MYSQL_RO: PlanetScale MySQL cmux-next-vitess main (readwriter / reader passwords cmux-next-prod-rw/ro-20261028),
