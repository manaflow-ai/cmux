      "worker_loaders": [{ "binding": "LOADER" }],
      // Workers AI for the model router (src/inference): billed to this account, capped by SpendGuardDO.
      "ai": { "binding": "AI" },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "TeamDO"] }, { "tag": "v2", "new_sqlite_classes": ["SchedulerDO"] }, { "tag": "v3", "new_sqlite_classes": ["ConnectionDO", "AccountIndexDO"] }, { "tag": "v4", "new_sqlite_classes": ["FeedDO"] }, { "tag": "v5", "new_sqlite_classes": ["DomainDO"] }, { "tag": "v6", "new_sqlite_classes": ["ConversationDO", "MuxDO", "AddressDO"] }, { "tag": "v7", "new_sqlite_classes": ["PairingDO"] }, { "tag": "v8", "new_sqlite_classes": ["HostDO"] }, { "tag": "v9", "new_sqlite_classes": ["UsageMeterDO"] }, { "tag": "v10", "new_sqlite_classes": ["TeamVmDO"] }, { "tag": "v11", "new_sqlite_classes": ["CloudDO"] }, { "tag": "v12", "new_sqlite_classes": ["SpendGuardDO"] }, { "tag": "v13", "new_sqlite_classes": ["FreeDeviceDO"] }, { "tag": "v14", "new_sqlite_classes": ["WireTicketDO"] }, { "tag": "v15", "new_sqlite_classes": ["ChiefBrainDO"] }, { "tag": "v16", "new_sqlite_classes": ["HandDO"] }, { "tag": "v18", "new_sqlite_classes": ["HandoffDO", "HandoffIndexDO"] }, { "tag": "v19", "new_sqlite_classes": ["ChiefDurableDO"] }, { "tag": "v20", "new_sqlite_classes": ["TrajectoryDO"] }],
