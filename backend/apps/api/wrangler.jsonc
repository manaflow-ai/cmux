      { "name": "FEED_DO", "class_name": "FeedDO" },
          { "name": "CONVERSATION_DO", "class_name": "ConversationDO" },
          { "name": "MUX_DO", "class_name": "MuxDO" },
          { "name": "ADDRESS_DO", "class_name": "AddressDO" },
          { "name": "DOMAIN_DO", "class_name": "DomainDO" },
          { "name": "PAIRING_DO", "class_name": "PairingDO" }, { "name": "HOST_DO", "class_name": "HostDO" }, { "name": "HAND_DO", "class_name": "HandDO" }, { "name": "USAGE_METER_DO", "class_name": "UsageMeterDO" }, { "name": "SPEND_GUARD_DO", "class_name": "SpendGuardDO" }, { "name": "FREE_DEVICE_DO", "class_name": "FreeDeviceDO" }, { "name": "TEAM_VM_DO", "class_name": "TeamVmDO" }, { "name": "CLOUD_DO", "class_name": "CloudDO" }, { "name": "TRAJECTORY_DO", "class_name": "TrajectoryDO" }, { "name": "WIRE_TICKET_DO", "class_name": "WireTicketDO" }, { "name": "CHIEF_BRAIN_DO", "class_name": "ChiefBrainDO" }, { "name": "CHIEF_DURABLE_DO", "class_name": "ChiefDurableDO" }, { "name": "OPENCODE_BRAIN_DO", "class_name": "OpencodeBrainDO" }, { "name": "HANDOFF_DO", "class_name": "HandoffDO" }, { "name": "HANDOFF_INDEX_DO", "class_name": "HandoffIndexDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO", "TeamDO"] }, { "tag": "v2", "new_sqlite_classes": ["SchedulerDO"] }, { "tag": "v3", "new_sqlite_classes": ["ConnectionDO", "AccountIndexDO"] }, { "tag": "v4", "new_sqlite_classes": ["FeedDO"] }, { "tag": "v5", "new_sqlite_classes": ["DomainDO"] }, { "tag": "v6", "new_sqlite_classes": ["ConversationDO", "MuxDO", "AddressDO"] }, { "tag": "v7", "new_sqlite_classes": ["PairingDO"] }, { "tag": "v8", "new_sqlite_classes": ["HostDO"] }, { "tag": "v9", "new_sqlite_classes": ["UsageMeterDO"] }, { "tag": "v10", "new_sqlite_classes": ["TeamVmDO"] }, { "tag": "v11", "new_sqlite_classes": ["CloudDO"] }, { "tag": "v12", "new_sqlite_classes": ["SpendGuardDO"] }, { "tag": "v13", "new_sqlite_classes": ["FreeDeviceDO"] }, { "tag": "v14", "new_sqlite_classes": ["WireTicketDO"] }, { "tag": "v15", "new_sqlite_classes": ["ChiefBrainDO"] }, { "tag": "v16", "new_sqlite_classes": ["HandDO"] }, { "tag": "v17", "new_sqlite_classes": ["OpencodeBrainDO"] }, { "tag": "v18", "new_sqlite_classes": ["HandoffDO", "HandoffIndexDO"] }, { "tag": "v19", "new_sqlite_classes": ["ChiefDurableDO"] }, { "tag": "v20", "new_sqlite_classes": ["TrajectoryDO"] }],
  "ratelimits": [{ "name": "SSO_DISCOVER_LIMIT", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } }, { "name": "PAIR_BEGIN_LIMIT", "namespace_id": "1111", "simple": { "limit": 10, "period": 60 } }, { "name": "GOOGLE_HOOK_FAIL_LIMIT", "namespace_id": "1131", "simple": { "limit": 60, "period": 60 } }, { "name": "HOME_ATTACHMENT_LIMIT", "namespace_id": "1141", "simple": { "limit": 60, "period": 60 } }, { "name": "CLOUD_MUTATION_LIMIT", "namespace_id": "1151", "simple": { "limit": 30, "period": 60 } }, { "name": "CLOUD_KEYSET_LIMIT", "namespace_id": "1161", "simple": { "limit": 60, "period": 60 } }, { "name": "WIRE_TICKET_LIMIT", "namespace_id": "1191", "simple": { "limit": 60, "period": 60 } }, { "name": "STACK_READ_LIMIT", "namespace_id": "1201", "simple": { "limit": 1000, "period": 60 } }, { "name": "STACK_READ_LOW_LIMIT", "namespace_id": "1211", "simple": { "limit": 1000, "period": 60 } }, { "name": "INFERENCE_FREE_IP_LIMIT", "namespace_id": "1171", "simple": { "limit": 60, "period": 60 } }, { "name": "INFERENCE_FREE_GRANT_LIMIT", "namespace_id": "1181", "simple": { "limit": 2, "period": 60 } }],
  // Home attachments: private bucket (no public access, no custom domain); the Worker hashes uploads and signs downloads.
  "r2_buckets": [{ "binding": "HOME_ATTACHMENTS", "bucket_name": "cmux-home-attachments-local" }],
  "workflows": [{ "name": "cmux-automation-run-local", "binding": "AUTOMATION_RUN", "class_name": "AutomationRunWorkflow" }],
      "worker_loaders": [{ "binding": "LOADER" }],
  "env": {
    "development": {
      "name": "cmux-api-development",
      // */15: the Postgres/MySQL projection compare during the dual write (projection-compare-cron.ts);
      // */5: the Cloud Home health probe and its Sentry Cron check-in (home-health.ts, secret SENTRY_DSN).
      "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *"] },
      // PLATFORM_MACHINES: the platform Worker's environment setups reach Cloud machines (platform-machines.ts).
      // CLOUD_ALLOWED_TEAMS "*": every team gets the stub plan (cloud-plan.ts STUB_PLAN_ENVIRONMENTS; never production).
      "vars": { "ENVIRONMENT": "development", "PLATFORM_SURFACES": "cloud", "CLOUD_TRAJECTORIES_ENABLED": "1", "CHIEF_DURABLE_ENABLED": "1", "HANDS_ENABLED": "1", "CHIEF_FAULT_HOOKS": "1", "CHIEF_CREDITS_DOGFOOD": "team_f77575bdfd932388f2e3,team_6774f37212cb1152d2a9,team_34bccc85e7a38258be69", "CHIEF_CREDITS_DOGFOOD_USD": "500", "CHIEF_BRAIN_ENABLED": "1", "CHIEF_BRAIN_MODEL": "@cf/moonshotai/kimi-k2.7-code", "BILLING_USAGE_PRICE_SET": "e2e", "USAGE_HARD_STOP_UNBILLED": "1", "INFERENCE_ENABLED": "1", "INFERENCE_ALLOWED_TEAMS": "team_f77575bdfd932388f2e3,team_6774f37212cb1152d2a9,team_34bccc85e7a38258be69,team_6b6623866a52063af515", "INFERENCE_DAILY_CAP_USD": "5", "INFERENCE_FREE_DAILY_CAP_USD": "2", "INFERENCE_FREE_ENABLED": "1", "INFERENCE_FREE_APP_IDS": "7WLXT3NR37.com.cmuxterm.app.nightly.cmux-next,7WLXT3NR37.com.cmuxterm.app.debug.next,7WLXT3NR37.com.cmuxterm.app.debug.hq39fa1,7WLXT3NR37.com.cmuxterm.attestprobe", "INFERENCE_DEVICECHECK_DEVELOPMENT": "true", "APPLE_TEAM_ID": "7WLXT3NR37", "CLOUD_FREESTYLE_SNAPSHOT": "cmuxnp-dev-vmimg-ci-41198930272-1", "CLOUD_API_ORIGIN": "https://cmux-api-development.debussy.workers.dev", "CLOUD_ALLOWED_TEAMS": "*", "CLOUD_PLAN_ENTITLEMENTS": "on", "PLATFORM_MACHINES": "on", "PLATFORM_AGENT_GATEWAY": "on", "CLOUD_NAME_PREFIX": "cmuxnp-dev-cld-", "CLOUD_VM_API_ORIGIN": "https://vm-staging.cmux.dev", "CLOUD_CODEROUTER_EDGE_HOST": "cmux-staging.vercel.app", "WORKER_NAME": "cmux-api-development", "PROJECTION_SHADOW": "mysql", "PROJECTION_READS": "shadow", "TEAM_VM_SLUG_PREFIX": "cmuxnp-dev-tvm-", "TEAM_VM_BIND_ENABLED": "1", "TEAM_VM_SNAPSHOT": "cmuxnp-dev-vmimg-ci-team-39709951013-1", "AUTOMATION_CAP_CEILING_USD": "25", "DASHBOARD_ORIGIN": "http://localhost:3010", "API_VERSION": "0.1.0", "IOS_APP_ID": "7WLXT3NR37.dev.cmux.ios", "IOS_APP_ATTEST_DEVELOPMENT": "true", "STACK_PROJECT_ID": "454ecd03-1db2-4050-845e-4ce5b0cd9895" },

      "durable_objects": {
        "bindings": [
          { "name": "USER_DO", "class_name": "UserDO" },
          { "name": "TEAM_DO", "class_name": "TeamDO" },
          { "name": "SCHEDULER_DO", "class_name": "SchedulerDO" },
          { "name": "CONNECTION_DO", "class_name": "ConnectionDO" },
          { "name": "ACCOUNT_INDEX_DO", "class_name": "AccountIndexDO" },
