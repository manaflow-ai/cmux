{
  "name": "cmux-cloud-backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "db"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "catalog:export": "bun run --cwd packages/protocol catalog:export",
    "catalog:check": "bun run --cwd packages/protocol catalog:check",
    "db:migrate": "bun run --cwd db migrate",
    "e2e:staging": "bun run --cwd db e2e --env staging",
    "e2e:development": "bun run --cwd db e2e --env development"
  }
}
