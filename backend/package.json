{
  "name": "cmux-cloud-backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "db",
    "../clients/ts/*",
    "../workers/cmux-vm/sdk"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "catalog:export": "bun run --cwd packages/protocol catalog:export",
    "catalog:check": "bun run --cwd packages/protocol catalog:check && bun run --cwd packages/protocol catalog:client:check && bun run --cwd packages/protocol catalog:rust:check && bun run --cwd packages/ownership mirror:check",
    "db:migrate": "bun run --cwd db migrate",
    "e2e:staging": "bun run --cwd db e2e --env staging",
    "e2e:development": "bun run --cwd db e2e --env development",
    "catalog:client": "bun run --cwd packages/protocol catalog:client",
    "catalog:rust": "bun run --cwd packages/protocol catalog:rust",
    "lint:size": "bun scripts/check-file-size.ts"
  },
  "overrides": {
    "fflate": "0.7.5",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  }
}
