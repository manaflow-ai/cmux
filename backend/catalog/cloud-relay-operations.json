{
  "$schema": "./cloud-operations.schema.json",
  "schema_version": 1,
  "protocol": "cmux.cloud/1",
  "operations": {
    "vm.list": { "class": "read", "target": "vm", "transport": { "http": { "method": "GET", "path": "/api/vm" } } },
    "vm.get": { "class": "read", "target": "vm", "transport": { "http": { "method": "GET", "path": "/api/vm/:vm_id" } } },
    "vm.create": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm" } } },
    "vm.update": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "PATCH", "path": "/api/vm/:vm_id" } } },
    "vm.start": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/resume" } } },
    "vm.resume": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/resume" } } },
    "vm.pause": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/pause" } } },
    "vm.resize": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/resize" } } },
    "vm.delete": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "DELETE", "path": "/api/vm/:vm_id" } } },
    "vm.snapshot.list": { "class": "read", "target": "vm", "transport": { "http": { "method": "GET", "path": "/api/vm/:vm_id/snapshots" } } },
    "vm.snapshot.create": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/snapshot" } } },
    "vm.snapshot.restore": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/restore" } } },
    "vm.snapshot.delete": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "DELETE", "path": "/api/vm/:vm_id/snapshots/:snapshot_id" } } },
    "vm.exec": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/exec" } } },
    "vm.fs.list": { "class": "read", "target": "vm", "transport": { "http": { "method": "GET", "path": "/api/vm/:vm_id/fs/dir" } } },
    "vm.fs.read": { "class": "read", "target": "vm", "transport": { "http": { "method": "GET", "path": "/api/vm/:vm_id/fs/read" } } },
    "vm.fs.write": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/fs/write" } } },
    "vm.fs.mkdir": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/:vm_id/fs/mkdir" } } },
    "vm.fs.remove": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "DELETE", "path": "/api/vm/:vm_id/fs/remove" } } },
    "vm.fs.stat": { "class": "read", "target": "vm", "transport": { "http": { "method": "GET", "path": "/api/vm/:vm_id/fs/stat" } } },
    "vm.domain.list": { "class": "read", "target": "vm", "cli": { "path": "cloud domain-list", "visible": true }, "mcp": { "expose": "default", "group": "cloud" }, "transport": { "http": { "method": "GET", "path": "/api/vm/domains" } } },
    "vm.domain.verify": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/domains/:name/verify" } } },
    "vm.publication.list": { "class": "read", "target": "vm", "cli": { "path": "cloud publication-list", "visible": true }, "mcp": { "expose": "default", "group": "cloud" }, "transport": { "http": { "method": "GET", "path": "/api/vm/publications" } } },
    "vm.publication.create": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/publications" } } },
    "vm.publication.update": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "PATCH", "path": "/api/vm/publications/:id" } } },
    "vm.publication.delete": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "DELETE", "path": "/api/vm/publications/:id" } } },
    "vm.publication.verify": { "class": "mutation", "target": "vm", "transport": { "http": { "method": "POST", "path": "/api/vm/publications/:id/verify" } } },
    "network.list": { "class": "read", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/read" } } },
    "tunnel.attach": { "class": "mutation", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/ops" } } },
    "tunnel.detach": { "class": "mutation", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/ops" } } },
    "tunnel.rotate-key": { "class": "mutation", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/ops" } } },
    "firewall.list": { "class": "read", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/read" } } },
    "firewall.get": { "class": "read", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/read" } } },
    "firewall.create": { "class": "mutation", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/ops" } } },
    "firewall.delete": { "class": "mutation", "target": "team", "transport": { "http": { "method": "POST", "path": "/v1/ops" } } }
  }
}
